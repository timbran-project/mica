// Seven microtheory-scoped sample facts. Load 00_schema.mica first.
make_identity(:cyc/fido)
make_identity(:cyc/alice)
make_identity(:cyc/bob)
make_identity(:cyc/charlie)
make_identity(:cyc/dog)
make_identity(:cyc/animal)
make_identity(:cyc/dentist)
make_identity(:cyc/person)
make_identity(:cyc/base_kb)
make_identity(:cyc/people_data_mt)

assert Cyc/Isa(#cyc/fido, #cyc/dog, #cyc/base_kb)
assert Cyc/Isa(#cyc/fido, #cyc/animal, #cyc/base_kb)
assert Cyc/Isa(#cyc/alice, #cyc/dentist, #cyc/people_data_mt)
assert Cyc/Isa(#cyc/bob, #cyc/dentist, #cyc/people_data_mt)
assert Cyc/Isa(#cyc/charlie, #cyc/person, #cyc/people_data_mt)
assert Cyc/Genls(#cyc/dentist, #cyc/person, #cyc/people_data_mt)
assert Cyc/Genls(#cyc/person, #cyc/animal, #cyc/base_kb)
