// Mica compiler backend for the Rust register-program assembly interface.
// AST lookup routines derive from omica bfb368c.

verb sort_ast_rows(rows)
  return sort(rows)
end

// The first row index whose node id is `node_id`, or the insertion point when
// absent. Rows must be sorted by node id. Mica integer division is exact, so
// the midpoint forces an even numerator rather than writing `(low + high) / 2`.
verb lower_bound(rows, node_id)
  let low = 0
  let high = len(rows)
  while low < high
    let sum = low + high
    let mid = (sum - (sum % 2)) / 2
    if rows[mid][0] < node_id
      low = mid + 1
    else
      high = mid
    end
  end
  return low
end

// The :kind target of a node, or :Unknown.
verb ast_kind(rows, node_id)
  let index = lower_bound(rows, node_id)
  while index < len(rows) && rows[index][0] == node_id
    if rows[index][1] == :kind
      return rows[index][2]
    end
    index = index + 1
  end
  return :Unknown
end

// The first target for (node, role) as [found, target].
verb ast_attr(rows, node_id, role)
  let index = lower_bound(rows, node_id)
  while index < len(rows) && rows[index][0] == node_id
    if rows[index][1] == role
      return [true, rows[index][2]]
    end
    index = index + 1
  end
  return [false, 0]
end

// Every target for (node, role), ordered by ordinal. The node's block is
// small, so scanning it once per ordinal is cheap.
verb ast_children(rows, node_id, role)
  let start = lower_bound(rows, node_id)
  let finish = start
  while finish < len(rows) && rows[finish][0] == node_id
    finish = finish + 1
  end
  let count = 0
  let index = start
  while index < finish
    if rows[index][1] == role
      count = count + 1
    end
    index = index + 1
  end
  let targets = []
  let ordinal = 0
  while ordinal < count
    index = start
    while index < finish
      if rows[index][1] == role && rows[index][3] == ordinal
        targets = [@targets, rows[index][2]]
        break
      end
      index = index + 1
    end
    ordinal = ordinal + 1
  end
  return targets
end

verb emit_source(source) -> map
  let parsed = parse_rows(source)
  if len(parsed[:errors]) > 0
    return {:ok -> false, :errors -> parsed[:errors]}
  end
  let module = emit_program(parsed[:rows], parsed[:root])
  if len(module[:errors]) > 0
    return {:ok -> false, :errors -> module[:errors]}
  end
  let methods = []
  for definition in module[:methods]
    let compiled = definition
    compiled[:program] = assemble(definition[:program])
    methods = [@methods, compiled]
  end
  return {:ok -> true, :entry -> assemble(module[:entry]), :methods -> methods, :errors -> []}
end

verb emit_state(relations, node_kinds, field_relations)
  return {:code -> [], :next -> 0, :scopes -> [{}], :loops -> [], :errors -> [], :result_annotation -> "", :binding_types -> {}, :relations -> relations, :node_kinds -> node_kinds, :field_relations -> field_relations, :self_name -> ""}
end

verb emit_program(raw_rows, root) -> map
  let rows = sort_ast_rows(raw_rows)
  let node_kinds = {}
  let needs_fields = false
  for row in rows
    if row[1] == :kind
      node_kinds[row[0]] = row[2]
      needs_fields = needs_fields || row[2] == :Field
    end
  end
  let relations = {}
  for entry in RelationName(?relation, ?name)
    relations[entry[:name]] = entry[:relation]
  end
  let field_relations = {}
  if needs_fields
    let binary = {}
    for entry in Arity(?relation, 2)
      binary[entry[:relation]] = true
    end
    let keys = {}
    for entry in FunctionalKey(?relation, ?slot, ?position)
      let target = entry[:relation]
      let info = index_or(keys, target, [0, true])
      keys[target] = [info[0] + 1, info[1] && entry[:slot] == 0 && entry[:position] == 0]
    end
    for target, info in keys
      if info == [1, true] && index_or(binary, target, false)
        field_relations[target] = true
      end
    end
  end
  let entry_nodes = []
  let methods = []
  let errors = []
  for item in ast_children(rows, root, :item)
    let kind = ast_kind(rows, item)
    if kind == :ExprItem
      let [_, expr] = ast_attr(rows, item, :expr)
      entry_nodes = [@entry_nodes, expr]
    elseif kind == :VerbItem
      let [_, selector] = ast_attr(rows, item, :name)
      let state = emit_state(relations, node_kinds, field_relations)
      let [has_result, result_annotation] = ast_attr(rows, item, :result)
      if has_result
        state[:result_annotation] = result_annotation
      end
      let parameters = []
      for param in ast_children(rows, item, :param)
        let [_, name_text] = ast_attr(rows, param, :name)
        let [_, mode] = ast_attr(rows, param, :mode)
        if mode != :req
          state = emit_diagnostic(state, "verb default and rest parameters need an argument wrapper")
        end
        let [restricted, _] = ast_attr(rows, param, :restrict)
        if restricted
          state = emit_diagnostic(state, "prototype-restricted verbs require installation metadata")
        end
        let [reg, allocated] = emit_register(state)
        state = emit_declare(allocated, name_text, reg, true)
        let [annotated, annotation] = ast_attr(rows, param, :annotation)
        if annotated
          state = emit_annotation(state, reg, annotation, :Parameter, name_text)
        end
        parameters = [@parameters, to_symbol(name_text)]
      end
      let [result, emitted] = emit_block(rows, ast_children(rows, item, :body), state)
      state = emit_finish(emitted, result)
      methods = [@methods, {:selector -> to_symbol(selector), :parameters -> parameters, :program -> emit_description(state)}]
      errors = [@errors, @state[:errors]]
    else
      errors = [@errors, string_concat("unsupported program item: ", to_literal(kind))]
    end
  end
  let [result, entry] = emit_block(rows, entry_nodes, emit_state(relations, node_kinds, field_relations))
  entry = emit_append(entry, [:Return, [:Register, result]])
  return {:entry -> emit_description(entry), :methods -> methods, :errors -> [@errors, @entry[:errors]]}
end

verb emit_description(state)
  return {:registers -> state[:next], :code -> state[:code]}
end

verb emit_register(input_state)
  let state = input_state
  let reg = state[:next]
  state[:next] = reg + 1
  return [reg, state]
end

verb emit_append(input_state, instruction)
  let state = input_state
  state[:code] = [@state[:code], instruction]
  return state
end

verb emit_constant(input_state, constant_value)
  let [reg, state] = emit_register(input_state)
  state = emit_append(state, [:Load, reg, constant_value])
  return [reg, state]
end

verb emit_diagnostic(input_state, message)
  let state = input_state
  state[:errors] = [@state[:errors], message]
  return state
end

verb emit_error(state, message)
  return emit_constant(emit_diagnostic(state, message), none)
end

verb emit_scope(input_state)
  let state = input_state
  state[:scopes] = [@state[:scopes], {}]
  return state
end

verb emit_unscope(input_state)
  let state = input_state
  let scopes = []
  let index = 0
  while index + 1 < len(state[:scopes])
    scopes = [@scopes, state[:scopes][index]]
    index = index + 1
  end
  state[:scopes] = scopes
  return state
end

verb emit_declare(input_state, name_text, reg, immutable)
  let state = input_state
  let scopes = state[:scopes]
  let last = len(scopes) - 1
  let locals = scopes[last]
  if index_or(locals, name_text, none) != none
    return emit_diagnostic(state, string_concat("duplicate binding: ", name_text))
  end
  locals[name_text] = [reg, immutable]
  scopes[last] = locals
  state[:scopes] = scopes
  return state
end

verb emit_local(state, name_text)
  let scopes = state[:scopes]
  let index = len(scopes)
  while index > 0
    index = index - 1
    let binding = index_or(scopes[index], name_text, none)
    if binding != none
      return [true, binding[0], binding[1]]
    end
  end
  return [false, 0, false]
end

verb emit_patch(input_state, position, instruction)
  let state = input_state
  let code = state[:code]
  code[position] = instruction
  state[:code] = code
  return state
end

verb emit_block(rows, nodes, input_state)
  let [result, state] = emit_constant(input_state, [] {[]})
  for node in nodes
    let [value_reg, after_value] = emit_expr(rows, node, state)
    state = after_value
    result = value_reg
  end
  return [result, state]
end

verb emit_expr(rows, node, input_state)
  let state = input_state
  let kind = ast_kind(rows, node)
  if kind == :Int_Literal || kind == :Float_Literal || kind == :String_Literal || kind == :Bytes_Literal || kind == :Error_Code_Literal
    let [_, text] = ast_attr(rows, node, :text)
    let parsed = from_literal(text)
    if parsed[0][:case] != :ok
      return emit_error(state, string_concat("invalid literal: ", text))
    end
    return emit_constant(state, parsed[0][:value])
  end
  if kind == :Bool_Literal
    let [_, flag] = ast_attr(rows, node, :value)
    return emit_constant(state, flag)
  end
  if kind == :Symbol_Literal || kind == :Identity_Literal
    let [_, text] = ast_attr(rows, node, :name)
    let prefix = ":"
    if kind == :Identity_Literal
      prefix = "#"
    end
    let parsed = from_literal(string_concat(prefix, text))
    if parsed[0][:case] != :ok
      return emit_error(state, string_concat("unresolved literal: ", prefix, text))
    end
    return emit_constant(state, parsed[0][:value])
  end
  if kind == :Name
    let name_text = string_join(ast_children(rows, node, :part), "/")
    if name_text == "none"
      return emit_constant(state, none)
    end
    let [found, reg, _] = emit_local(state, name_text)
    if !found
      return emit_error(state, string_concat("unbound name: ", name_text))
    end
    let [copy, allocated] = emit_register(state)
    return [copy, emit_append(allocated, [:Move, copy, reg])]
  end
  if kind == :Unary
    let [_, child] = ast_attr(rows, node, :operand)
    let [_, op_symbol] = ast_attr(rows, node, :op)
    let [src, emitted] = emit_expr(rows, child, state)
    let [dst, allocated] = emit_register(emitted)
    let operation = :Not
    if op_symbol == :neg
      operation = :Neg
    end
    return [dst, emit_append(allocated, [:Unary, dst, operation, src])]
  end
  if kind == :Binary
    return emit_binary(rows, node, state)
  end
  if kind == :Range_Literal
    let [_, start_node] = ast_attr(rows, node, :start)
    let [start, after_start] = emit_expr(rows, start_node, state)
    state = after_start
    let finish = none
    let [bounded, end_node] = ast_attr(rows, node, :range_end)
    if bounded
      let [end_reg, after_end] = emit_expr(rows, end_node, state)
      state = after_end
      finish = [:Register, end_reg]
    end
    let [dst, allocated] = emit_register(state)
    return [dst, emit_append(allocated, [:BuildRange, dst, [:Register, start], finish])]
  end
  if kind == :List_Literal || kind == :Relation_Literal
    return emit_collection(rows, node, state)
  end
  if kind == :Map_Literal
    let entries = []
    for entry in ast_children(rows, node, :entry)
      let [_, key_node] = ast_attr(rows, entry, :key)
      let [_, value_node] = ast_attr(rows, entry, :value)
      let [key_reg, after_key] = emit_expr(rows, key_node, state)
      let [value_reg, after_value] = emit_expr(rows, value_node, after_key)
      state = after_value
      entries = [@entries, [[:Register, key_reg], [:Register, value_reg]]]
    end
    let [dst, allocated] = emit_register(state)
    return [dst, emit_append(allocated, [:BuildMap, dst, entries])]
  end
  if kind == :Dom_Element || kind == :Dom_Text
    return emit_dom(rows, node, state)
  end
  if kind == :Structural_Literal
    return emit_frob(rows, node, state)
  end
  if kind == :Index
    let [_, collection_node] = ast_attr(rows, node, :collection)
    let [_, key_node] = ast_attr(rows, node, :key)
    let [collection, after_collection] = emit_expr(rows, collection_node, state)
    let [key, after_key] = emit_expr(rows, key_node, after_collection)
    let [dst, allocated] = emit_register(after_key)
    return [dst, emit_append(allocated, [:Index, dst, collection, [:Register, key]])]
  end
  if kind == :Field
    let [_, name_text] = ast_attr(rows, node, :name)
    let fields = {"code" -> :Code, "message" -> :Message, "value" -> :Value}
    let field_name = index_or(fields, name_text, none)
    if field_name == none
      return emit_field_read(rows, node, name_text, state)
    end
    let [_, receiver] = ast_attr(rows, node, :receiver)
    let [error_reg, emitted] = emit_expr(rows, receiver, state)
    let [dst, allocated] = emit_register(emitted)
    return [dst, emit_append(allocated, [:ErrorField, dst, error_reg, field_name])]
  end
  if kind == :Binding
    let [_, pattern] = ast_attr(rows, node, :pattern)
    let [found, value_node] = ast_attr(rows, node, :value)
    let reg = 0
    if found
      let [emitted, after_value] = emit_expr(rows, value_node, state)
      state = after_value
      reg = emitted
    else
      let initial = [] {}
      if ast_kind(rows, pattern) == :List_Pattern
        initial = []
      end
      let [emitted, after_value] = emit_constant(state, initial)
      state = after_value
      reg = emitted
    end
    let [annotated, annotation_text] = ast_attr(rows, node, :annotation)
    let annotation = ""
    if annotated
      annotation = annotation_text
      state = emit_annotation(state, reg, annotation, :Binding, "binding")
    end
    let [exact, _] = ast_attr(rows, node, :is_exactly)
    let [constant, _] = ast_attr(rows, node, :is_const)
    if exact
      if !found || ast_kind(rows, pattern) != :Map_Pattern
        return emit_error(state, "exact bindings require a row pattern and initializer")
      end
      return emit_row_binding(rows, pattern, reg, 0, true, constant, state)
    end
    return emit_pattern(rows, pattern, reg, constant, annotation, state)
  end
  if kind == :Assignment
    return emit_assignment(rows, node, state)
  end
  if kind == :Fn
    return emit_function(rows, node, state)
  end
  if kind == :Call
    return emit_call(rows, node, state)
  end
  if kind == :Receiver_Call
    return emit_dispatch(rows, node, false, 0, state)
  end
  if kind == :Spawn
    let [_, target] = ast_attr(rows, node, :call)
    let [delayed, delay_node] = ast_attr(rows, node, :delay)
    if !delayed
      delay_node = 0
    end
    return emit_dispatch(rows, target, true, delay_node, state)
  end
  if kind == :Assert || kind == :Retract
    let [_, atom] = ast_attr(rows, node, :atom)
    let [has_callee, callee] = ast_attr(rows, atom, :callee)
    if !has_callee || ast_kind(rows, callee) != :Name
      return emit_error(state, "fact changes require a named relation call")
    end
    let name_text = string_join(ast_children(rows, callee, :part), "/")
    let target = index_or(state[:relations], to_symbol(name_text), none)
    if target == none
      return emit_error(state, string_concat("relation is not declared: ", name_text))
    end
    let operation = :AssertDynamic
    if kind == :Retract
      operation = :RetractDynamic
    end
    return emit_relation_call(rows, atom, target, operation, state)
  end
  if kind == :Return
    let [found, child] = ast_attr(rows, node, :value)
    if !found
      let [reg, emitted] = emit_constant(state, [] {[]})
      return [reg, emit_finish(emitted, reg)]
    end
    let [reg, emitted] = emit_expr(rows, child, state)
    return [reg, emit_finish(emitted, reg)]
  end
  if kind == :Require
    let [_, condition_node] = ast_attr(rows, node, :condition)
    let [condition, emitted] = emit_expr(rows, condition_node, state)
    state = emitted
    let branch = len(state[:code])
    state = emit_append(state, [:Branch, condition, branch + 2, branch + 1])
    state = emit_append(state, [:Abort, [:Constant, "require failed"]])
    return emit_constant(state, true)
  end
  if kind == :If
    return emit_if(rows, node, state)
  end
  if kind == :Match
    return emit_match(rows, node, state)
  end
  if kind == :Try
    return emit_try(rows, node, state)
  end
  if kind == :Raise
    let parts = ast_children(rows, node, :part)
    if len(parts) < 1 || len(parts) > 3
      return emit_error(state, "raise expects an error and optional message and value")
    end
    let operands = []
    for part in parts
      let [reg, emitted] = emit_expr(rows, part, state)
      state = emitted
      operands = [@operands, [:Register, reg]]
    end
    while len(operands) < 3
      operands = [@operands, none]
    end
    state = emit_append(state, [:Raise, operands[0], operands[1], operands[2]])
    return emit_constant(state, [] {[]})
  end
  if kind == :While || kind == :For || kind == :Comprehension
    return emit_loop(rows, node, state)
  end
  if kind == :Break || kind == :Continue
    return emit_loop_exit(kind, state)
  end
  if kind == :Begin
    let [reg, emitted] = emit_block(rows, ast_children(rows, node, :body), emit_scope(state))
    return [reg, emit_unscope(emitted)]
  end
  return emit_error(state, string_concat("unsupported expression: ", to_literal(kind)))
end

verb emit_match_test(condition, failures, input_state)
  let branch = len(input_state[:code])
  return [[@failures, branch], emit_append(input_state, [:Branch, condition, branch + 1, 0])]
end

verb emit_match(rows, node, input_state)
  let [_, value_node] = ast_attr(rows, node, :value)
  let [subject, emitted] = emit_expr(rows, value_node, input_state)
  let [result, state] = emit_constant(emitted, [] {[]})
  let endings = []
  let cases = ast_children(rows, node, :case)
  if len(cases) == 0
    return emit_error(state, "match requires at least one case")
  end
  for case_node in cases
    state = emit_scope(state)
    let [_, pattern] = ast_attr(rows, case_node, :pattern)
    let [failures, after_pattern] = emit_match_pattern(rows, pattern, subject, [], state)
    state = after_pattern
    let [guarded, guard_node] = ast_attr(rows, case_node, :guard)
    if guarded
      let [guard, after_guard] = emit_expr(rows, guard_node, state)
      let [branches, after_test] = emit_match_test(guard, failures, after_guard)
      failures = branches
      state = after_test
    end
    let [body, after_body] = emit_block(rows, ast_children(rows, case_node, :body), state)
    state = emit_append(emit_unscope(after_body), [:Move, result, body])
    endings = [@endings, len(state[:code])]
    state = emit_append(state, [:Jump, 0])
    for branch in failures
      let instruction = state[:code][branch]
      state = emit_patch(state, branch, [:Branch, instruction[1], instruction[2], len(state[:code])])
    end
  end
  state = emit_append(state, [:Raise, [:Constant, E_MATCH], [:Constant, "non-exhaustive relation match"], [:Register, subject]])
  for jump in endings
    state = emit_patch(state, jump, [:Jump, len(state[:code])])
  end
  return [result, state]
end

verb emit_match_pattern(rows, node, subject, input_failures, input_state)
  let state = input_state
  let failures = input_failures
  let kind = ast_kind(rows, node)
  if kind == :Wildcard_Pattern
    return [failures, state]
  end
  if kind == :Binding_Pattern
    let [_, name_text] = ast_attr(rows, node, :name)
    if name_text == "none"
      let [matched, allocated] = emit_register(state)
      state = emit_append(allocated, [:RelationPattern, matched, subject, [:value], 0, []])
      return emit_match_test(matched, failures, state)
    end
    let [_, declared] = emit_pattern(rows, node, subject, false, "", state)
    return [failures, declared]
  end
  if kind == :Literal_Pattern
    let [_, value_node] = ast_attr(rows, node, :value)
    let [value, emitted] = emit_expr(rows, value_node, state)
    let [matched, allocated] = emit_register(emitted)
    state = emit_append(allocated, [:Binary, matched, :Eq, subject, value])
    return emit_match_test(matched, failures, state)
  end
  if kind == :Call_Pattern
    let [_, name_text] = ast_attr(rows, node, :name)
    let args = ast_children(rows, node, :arg)
    if (name_text != "some" && name_text != "ok" && name_text != "err") || len(args) > 1
      return [failures, emit_diagnostic(state, "match constructors are some, ok, or err with at most one pattern")]
    end
    let heading = [:value]
    let equalities = []
    if name_text != "some"
      heading = [:case, :value]
      let case_name = :ok
      if name_text == "err"
        case_name = :error
      end
      equalities = [[:case, case_name]]
    end
    let [matched, allocated] = emit_register(state)
    state = emit_append(allocated, [:RelationPattern, matched, subject, sort(heading), 1, equalities])
    let [branches, tested] = emit_match_test(matched, failures, state)
    if len(args) == 0
      return [branches, tested]
    end
    let [value, after_value] = emit_register(tested)
    state = emit_append(after_value, [:RelationCell, value, subject, :value])
    return emit_match_pattern(rows, args[0], value, branches, state)
  end
  if kind == :List_Pattern
    return emit_match_list(rows, node, subject, failures, state)
  end
  if kind == :Map_Pattern
    return emit_match_map(rows, node, subject, failures, state)
  end
  return [failures, emit_diagnostic(state, "unsupported match pattern")]
end

verb emit_match_list(rows, node, subject, input_failures, input_state)
  let [matched, allocated] = emit_register(input_state)
  let state = emit_append(allocated, [:BuiltinCall, matched, :is_kind, [[:Register, subject], [:Constant, :list]]])
  let [failures, tested] = emit_match_test(matched, input_failures, state)
  let [length, after_length] = emit_register(tested)
  state = emit_append(after_length, [:CollectionLen, length, subject])
  let elements = ast_children(rows, node, :element)
  let rest = -1
  let index = 0
  for element in elements
    if ast_kind(rows, element) == :Rest_Pattern
      if rest != -1
        return [failures, emit_diagnostic(state, "a list pattern supports only one rest binding")]
      end
      rest = index
    end
    index = index + 1
  end
  let fixed = len(elements)
  let operation = :Eq
  if rest != -1
    fixed = fixed - 1
    operation = :Ge
  end
  let [count, after_count] = emit_constant(state, fixed)
  state = emit_append(after_count, [:Binary, matched, operation, length, count])
  let [branches, after_test] = emit_match_test(matched, failures, state)
  failures = branches
  state = after_test
  index = 0
  for element in elements
    let position = [:Constant, index]
    if rest != -1 && index >= rest
      let trailing = len(elements) - index
      if index == rest
        trailing = trailing - 1
      end
      let [offset, loaded] = emit_constant(state, trailing)
      let [end_reg, after_end] = emit_register(loaded)
      state = emit_append(after_end, [:Binary, end_reg, :Sub, length, offset])
      position = [:Register, end_reg]
      if index == rest
        let [value, sliced] = emit_match_rest(subject, rest, end_reg, state)
        let [_, declared] = emit_pattern(rows, element, value, false, "", sliced)
        state = declared
        index = index + 1
        continue
      end
    end
    let [value, after_value] = emit_register(state)
    state = emit_append(after_value, [:Index, value, subject, position])
    let [branches, emitted] = emit_match_pattern(rows, element, value, failures, state)
    failures = branches
    state = emitted
    index = index + 1
  end
  return [failures, state]
end

verb emit_match_rest(subject, start, finish, input_state)
  let [value, state] = emit_constant(input_state, [])
  let [start_reg, after_start] = emit_constant(state, start)
  let [nonempty, allocated] = emit_register(after_start)
  state = emit_append(allocated, [:Binary, nonempty, :Lt, start_reg, finish])
  let branch = len(state[:code])
  state = emit_append(state, [:Branch, nonempty, branch + 1, 0])
  let [one, after_one] = emit_constant(state, 1)
  let [end_reg, after_end] = emit_register(after_one)
  state = emit_append(after_end, [:Binary, end_reg, :Sub, finish, one])
  let [range_reg, after_range] = emit_register(state)
  state = emit_append(after_range, [:BuildRange, range_reg, [:Register, start_reg], [:Register, end_reg]])
  state = emit_append(state, [:Index, value, subject, [:Register, range_reg]])
  return [value, emit_patch(state, branch, [:Branch, nonempty, branch + 1, len(state[:code])])]
end

verb emit_match_map(rows, node, subject, input_failures, input_state)
  let state = input_state
  let columns = []
  let fields = []
  let seen = {}
  for entry in ast_children(rows, node, :entry)
    let [_, key] = ast_attr(rows, entry, :key)
    let [_, spelling] = ast_attr(rows, key, :name)
    let parsed = from_literal(string_concat(":", spelling))
    if parsed[0][:case] != :ok
      return [input_failures, emit_diagnostic(state, "invalid pattern column")]
    end
    let column = parsed[0][:value]
    if index_or(seen, column, false)
      return [input_failures, emit_diagnostic(state, "relation patterns cannot repeat a column")]
    end
    seen[column] = true
    columns = [@columns, column]
    let [_, pattern] = ast_attr(rows, entry, :pattern)
    fields = [@fields, [column, pattern]]
  end
  let [map_reg, after_map] = emit_register(state)
  let [matched, allocated] = emit_register(after_map)
  state = emit_append(allocated, [:BuiltinCall, matched, :is_kind, [[:Register, subject], [:Constant, :map]]])
  let branch = len(state[:code])
  state = emit_append(state, [:Branch, matched, branch + 1, 0])
  state = emit_append(state, [:Move, map_reg, subject])
  let jump = len(state[:code])
  state = emit_append(state, [:Jump, 0])
  state = emit_patch(state, branch, [:Branch, matched, branch + 1, len(state[:code])])
  state = emit_append(state, [:RelationPattern, matched, subject, sort(columns), 1, []])
  let [failures, tested] = emit_match_test(matched, input_failures, state)
  state = emit_append(tested, [:Index, map_reg, subject, [:Constant, 0]])
  state = emit_patch(state, jump, [:Jump, len(state[:code])])
  for field in fields
    state = emit_append(state, [:BuiltinCall, matched, :map_contains_key, [[:Register, map_reg], [:Constant, field[0]]]])
    let [branches, after_test] = emit_match_test(matched, failures, state)
    let [value, after_value] = emit_register(after_test)
    state = emit_append(after_value, [:Index, value, map_reg, [:Constant, field[0]]])
    let [nested_branches, emitted] = emit_match_pattern(rows, field[1], value, branches, state)
    failures = nested_branches
    state = emitted
  end
  return [failures, state]
end

verb emit_try(rows, node, input_state)
  let [result, state] = emit_constant(input_state, [] {[]})
  let enter = len(state[:code])
  state = emit_append(state, [:EnterTry, [], none, 0])
  let [body_reg, emitted] = emit_block(rows, ast_children(rows, node, :body), emit_scope(state))
  state = emit_append(emit_unscope(emitted), [:Move, result, body_reg])
  state = emit_append(state, [:ExitTry])
  let [has_finally, _] = ast_attr(rows, node, :has_finally)
  let handlers = []
  let exits = []
  for clause in ast_children(rows, node, :catch_clause)
    let code = none
    let [has_code, code_text] = ast_attr(rows, clause, :code)
    if has_code
      code = error_code(to_symbol(code_text))
    end
    let binding = none
    state = emit_scope(state)
    let [has_name, name_text] = ast_attr(rows, clause, :name)
    if has_name
      let [reg, allocated] = emit_register(state)
      state = emit_declare(allocated, name_text, reg, true)
      binding = reg
    end
    handlers = [@handlers, [code, binding, len(state[:code])]]
    let [catch_reg, after_catch] = emit_block(rows, ast_children(rows, clause, :body), state)
    state = emit_append(emit_unscope(after_catch), [:Move, result, catch_reg])
    if has_finally
      state = emit_append(state, [:ExitTry])
    else
      exits = [@exits, len(state[:code])]
      state = emit_append(state, [:Jump, 0])
    end
  end
  let finally_target = none
  if has_finally
    finally_target = len(state[:code])
    let [_, after_finally] = emit_block(rows, ast_children(rows, node, :finally_body), emit_scope(state))
    state = emit_append(emit_unscope(after_finally), [:EndFinally])
  end
  let finish = len(state[:code])
  for position in exits
    state = emit_patch(state, position, [:Jump, finish])
  end
  state = emit_patch(state, enter, [:EnterTry, handlers, finally_target, finish])
  return [result, state]
end

verb emit_binary(rows, node, input_state)
  let [_, left_node] = ast_attr(rows, node, :left)
  let [_, right_node] = ast_attr(rows, node, :right)
  let [_, operation] = ast_attr(rows, node, :op)
  let [left, state] = emit_expr(rows, left_node, input_state)
  let [dst, allocated] = emit_register(state)
  state = allocated
  if operation == :and || operation == :or
    let branch = len(state[:code])
    state = emit_append(state, [:Branch, left, 0, 0])
    let right_start = len(state[:code])
    let [right, after_right] = emit_expr(rows, right_node, state)
    state = emit_append(after_right, [:Move, dst, right])
    let jump = len(state[:code])
    state = emit_append(state, [:Jump, 0])
    let short_start = len(state[:code])
    state = emit_append(state, [:Load, dst, operation == :or])
    let finish = len(state[:code])
    state = emit_patch(state, jump, [:Jump, finish])
    if operation == :and
      state = emit_patch(state, branch, [:Branch, left, right_start, short_start])
    else
      state = emit_patch(state, branch, [:Branch, left, short_start, right_start])
    end
    return [dst, state]
  end
  let operations = {:add -> :Add, :sub -> :Sub, :mul -> :Mul, :div -> :Div, :rem -> :Rem,
                    :eq -> :Eq, :ne -> :Ne, :lt -> :Lt, :le -> :Le, :gt -> :Gt, :ge -> :Ge}
  let op_symbol = index_or(operations, operation, none)
  if op_symbol == none
    return emit_error(state, string_concat("unsupported binary operation: ", to_literal(operation)))
  end
  let [right, after_right] = emit_expr(rows, right_node, state)
  return [dst, emit_append(after_right, [:Binary, dst, op_symbol, left, right])]
end

verb emit_items(rows, nodes, input_state)
  let state = input_state
  let items = []
  for child in nodes
    let spliced = ast_kind(rows, child) == :Splice
    let value_node = child
    if spliced
      let [_, inner] = ast_attr(rows, child, :value)
      value_node = inner
    end
    let [reg, after_value] = emit_expr(rows, value_node, state)
    state = after_value
    let operand = [:Register, reg]
    if spliced
      operand = [:Splice, operand]
    end
    items = [@items, operand]
  end
  return [items, state]
end

verb emit_collection(rows, node, input_state)
  if ast_kind(rows, node) == :List_Literal
    let [items, state] = emit_items(rows, ast_children(rows, node, :element), input_state)
    let [dst, allocated] = emit_register(state)
    return [dst, emit_append(allocated, [:BuildList, dst, items])]
  end
  let [heading, state] = emit_items(rows, ast_children(rows, node, :heading), input_state)
  let [heading_reg, after_heading_reg] = emit_register(state)
  state = emit_append(after_heading_reg, [:BuildList, heading_reg, heading])
  let [row_items, after_rows] = emit_items(rows, ast_children(rows, node, :row), state)
  let [rows_reg, after_rows_reg] = emit_register(after_rows)
  state = emit_append(after_rows_reg, [:BuildList, rows_reg, row_items])
  let [dst, allocated] = emit_register(state)
  return [dst, emit_append(allocated, [:BuiltinCall, dst, :relation_from_rows, [[:Register, heading_reg], [:Register, rows_reg]]])]
end

verb emit_pattern(rows, node, source_reg, immutable, annotation, input_state)
  let state = input_state
  let kind = ast_kind(rows, node)
  if kind == :Wildcard_Pattern
    return [source_reg, state]
  end
  if kind == :Binding_Pattern || kind == :Optional_Pattern || kind == :Rest_Pattern
    let [_, name_text] = ast_attr(rows, node, :name)
    let [reg, allocated] = emit_register(state)
    state = emit_append(allocated, [:Move, reg, source_reg])
    let types = state[:binding_types]
    types[reg] = annotation
    state[:binding_types] = types
    return [reg, emit_declare(state, name_text, reg, immutable)]
  end
  if kind == :List_Pattern
    let [result, initialized] = emit_constant(state, [] {})
    let [length, allocated] = emit_register(initialized)
    state = emit_append(allocated, [:CollectionLen, length, source_reg])
    let index = 0
    let saw_rest = false
    for element in ast_children(rows, node, :element)
      let element_kind = ast_kind(rows, element)
      if element_kind == :Rest_Pattern
        if saw_rest
          return emit_error(state, "a list pattern supports only one rest binding")
        end
        saw_rest = true
      end
      let [reg, after_slot] = emit_collection_slot(rows, element, element_kind, source_reg, index, length, state)
      state = after_slot
      let [bound, after_pattern] = emit_pattern(rows, element, reg, immutable, "", state)
      result = bound
      state = after_pattern
      if element_kind != :Rest_Pattern
        index = index + 1
      end
    end
    return [result, state]
  end
  return emit_error(state, string_concat("unsupported binding pattern: ", to_literal(kind)))
end

// Relation rows require an exact heading; maps in an iteration may have extra keys.
verb emit_row_binding(rows, node, source_reg, index_reg, exact, immutable, input_state)
  let state = input_state
  let heading = []
  let fields = []
  let seen = {}
  for entry in ast_children(rows, node, :entry)
    let [_, key] = ast_attr(rows, entry, :key)
    let [_, name_text] = ast_attr(rows, key, :name)
    let parsed = from_literal(string_concat(":", name_text))
    if parsed[0][:case] != :ok
      return emit_error(state, "invalid row column symbol")
    end
    let column = parsed[0][:value]
    if index_or(seen, column, false)
      return emit_error(state, "row patterns cannot repeat a column")
    end
    seen[column] = true
    let [_, pattern] = ast_attr(rows, entry, :pattern)
    if ast_kind(rows, pattern) != :Binding_Pattern
      return emit_error(state, "row fields require named bindings")
    end
    heading = [@heading, column]
    fields = [@fields, [column, pattern]]
  end
  heading = sort(heading)
  if exact
    let [matched, allocated] = emit_register(state)
    state = emit_append(allocated, [:RelationPattern, matched, source_reg, heading, 1, []])
    let branch = len(state[:code])
    state = emit_append(state, [:Branch, matched, branch + 2, branch + 1])
    state = emit_append(state, [:Raise, [:Constant, E_CARDINALITY], [:Constant, "exact row binding requires one row with the stated heading"], [:Register, source_reg]])
  end
  for field in fields
    let [reg, allocated] = emit_register(state)
    if exact
      state = emit_append(allocated, [:RelationCell, reg, source_reg, field[0]])
    else
      state = emit_append(allocated, [:CollectionFieldAt, reg, source_reg, index_reg, heading, field[0]])
    end
    let [_, bound] = emit_pattern(rows, field[1], reg, immutable, "", state)
    state = bound
  end
  return [source_reg, state]
end

verb emit_iteration_bindings(rows, node, collection, index_reg, input_state)
  let state = input_state
  let [has_pattern, pattern] = ast_attr(rows, node, :pattern)
  if has_pattern && ast_kind(rows, pattern) == :Map_Pattern
    let [_, bound] = emit_row_binding(rows, pattern, collection, index_reg, false, true, state)
    return bound
  end
  let [item_reg, allocated] = emit_register(state)
  state = emit_append(allocated, [:CollectionValueAt, item_reg, collection, index_reg])
  if has_pattern
    let [_, bound] = emit_pattern(rows, pattern, item_reg, true, "", state)
    return bound
  end
  let names = ast_children(rows, node, :name)
  if len(names) == 1
    return emit_loop_binding(rows, names[0], item_reg, state)
  end
  if len(names) == 2
    let [key_reg, after_key] = emit_register(state)
    state = emit_append(after_key, [:CollectionKeyAt, key_reg, collection, index_reg])
    state = emit_loop_binding(rows, names[0], key_reg, state)
    return emit_loop_binding(rows, names[1], item_reg, state)
  end
  return emit_diagnostic(state, "iteration expects one or two bindings")
end

verb emit_field_relation(name_text, state)
  let leaf = 0
  let index = 0
  while index < len(name_text)
    if name_text[index] == 47
      leaf = index + 1
    end
    index = index + 1
  end
  let first = name_text[leaf]
  let relation_name = name_text
  if first >= 97 && first <= 122
    relation_name = string_concat(string_slice(name_text, 0, leaf), string_slice("ABCDEFGHIJKLMNOPQRSTUVWXYZ", first - 97, first - 96), string_slice(name_text, leaf + 1, len(name_text)))
  end
  let target = index_or(state[:relations], to_symbol(relation_name), none)
  if !index_or(state[:field_relations], target, false)
    return none
  end
  return target
end

verb emit_field_read(rows, node, name_text, input_state)
  let target = emit_field_relation(name_text, input_state)
  if target == none
    return emit_error(input_state, "dot read requires a binary relation functional on position 0")
  end
  let [_, receiver] = ast_attr(rows, node, :receiver)
  let [key, state] = emit_expr(rows, receiver, input_state)
  let [query, allocated] = emit_register(state)
  let column = to_symbol(name_text)
  state = emit_append(allocated, [:ScanDynamic, query, target, [[:Register, key], [:Query, column]]])
  let [matched, after_match] = emit_register(state)
  state = emit_append(after_match, [:RelationPattern, matched, query, [column], 1, []])
  let branch = len(state[:code])
  state = emit_append(state, [:Branch, matched, branch + 2, branch + 1])
  state = emit_append(state, [:Raise, [:Constant, E_CARDINALITY], [:Constant, "functional dot read requires exactly one fact"], [:Register, query]])
  let [dst, after_dst] = emit_register(state)
  return [dst, emit_append(after_dst, [:RelationCell, dst, query, column])]
end

verb emit_assignment(rows, node, input_state)
  let [_, target] = ast_attr(rows, node, :target)
  let [_, rhs] = ast_attr(rows, node, :value)
  let target_kind = ast_kind(rows, target)
  if target_kind == :Field
    let [_, name_text] = ast_attr(rows, target, :name)
    let relation = emit_field_relation(name_text, input_state)
    if relation == none
      return emit_error(input_state, "dot assignment requires a binary relation functional on position 0")
    end
    let [value, after_value] = emit_expr(rows, rhs, input_state)
    let [_, receiver] = ast_attr(rows, target, :receiver)
    let [key, emitted] = emit_expr(rows, receiver, after_value)
    return [value, emit_append(emitted, [:ReplaceFunctional, relation, [[:Register, key], [:Register, value]]])]
  end
  let root = target
  if target_kind == :Index
    let [_, collection_node] = ast_attr(rows, target, :collection)
    root = collection_node
  end
  if ast_kind(rows, root) != :Name
    return emit_error(input_state, "assignment requires a local name or one indexed local")
  end
  let name_text = string_join(ast_children(rows, root, :part), "/")
  let [found, dst, immutable] = emit_local(input_state, name_text)
  if !found || immutable
    return emit_error(input_state, string_concat("assignment requires a mutable local: ", name_text))
  end
  let [value_reg, after_value] = emit_expr(rows, rhs, input_state)
  let state = after_value
  let collection_reg = dst
  let key_reg = 0
  if target_kind == :Index
    let [copy, allocated] = emit_register(state)
    state = emit_append(allocated, [:Move, copy, dst])
    collection_reg = copy
    let [_, key_node] = ast_attr(rows, target, :key)
    let [key, after_key] = emit_expr(rows, key_node, state)
    state = after_key
    key_reg = key
  end
  if target_kind == :Index
    state = emit_append(state, [:SetIndex, dst, collection_reg, [:Register, key_reg], [:Register, value_reg]])
    let [result, allocated] = emit_register(state)
    return [result, emit_append(allocated, [:Move, result, dst])]
  else
    let annotation = index_or(state[:binding_types], dst, "")
    state = emit_annotation(state, value_reg, annotation, :Binding, name_text)
    state = emit_append(state, [:Move, dst, value_reg])
  end
  return [value_reg, state]
end

verb emit_collection_slot(rows, node, kind, source_reg, position, length, input_state)
  let [dst, state] = emit_register(input_state)
  if kind != :Optional_Pattern && kind != :Rest_Pattern
    return [dst, emit_append(state, [:Index, dst, source_reg, [:Constant, position]])]
  end
  let [index_reg, after_index] = emit_constant(state, position)
  let [condition, allocated] = emit_register(after_index)
  let operation = :Lt
  if kind == :Rest_Pattern
    operation = :Le
  end
  state = emit_append(allocated, [:Binary, condition, operation, index_reg, length])
  let branch = len(state[:code])
  state = emit_append(state, [:Branch, condition, branch + 1, 0])
  let key_reg = index_reg
  if kind == :Rest_Pattern
    let [range_reg, after_range] = emit_register(state)
    state = emit_append(after_range, [:BuildRange, range_reg, [:Register, index_reg], none])
    key_reg = range_reg
  end
  state = emit_append(state, [:Index, dst, source_reg, [:Register, key_reg]])
  let jump = len(state[:code])
  state = emit_append(state, [:Jump, 0])
  let absent = len(state[:code])
  let [has_default, default_node] = ast_attr(rows, node, :default)
  if has_default
    let [value_reg, after_value] = emit_expr(rows, default_node, state)
    state = emit_append(after_value, [:Move, dst, value_reg])
  elseif kind == :Rest_Pattern
    state = emit_append(state, [:Load, dst, []])
  else
    state = emit_append(state, [:Load, dst, [] {}])
  end
  state = emit_patch(state, branch, [:Branch, condition, branch + 1, absent])
  state = emit_patch(state, jump, [:Jump, len(state[:code])])
  return [dst, state]
end

verb emit_call(rows, node, input_state)
  let [_, callee] = ast_attr(rows, node, :callee)
  let callee_kind = ast_kind(rows, callee)
  if callee_kind == :Symbol_Literal || callee_kind == :Selector_Expr
    return emit_dispatch(rows, node, false, 0, input_state)
  end
  let name_text = ""
  if callee_kind == :Name
    name_text = string_join(ast_children(rows, callee, :part), "/")
  end
  let state = input_state
  let callee_reg = 0
  let is_function = false
  let builtin = false
  if callee_kind == :Name
    let [found, reg, _] = emit_local(state, name_text)
    if found
      is_function = true
      let [copy, allocated] = emit_register(state)
      state = emit_append(allocated, [:Move, copy, reg])
      callee_reg = copy
    end
  else
    let [reg, after_callee] = emit_expr(rows, callee, state)
    state = after_callee
    is_function = true
    callee_reg = reg
  end
  if callee_kind == :Name && !is_function
    if name_text == state[:self_name]
      return emit_error(state, "self-recursive local functions are not supported")
    end
    let target = index_or(state[:relations], to_symbol(name_text), none)
    if target != none
      return emit_relation_call(rows, node, target, :ScanDynamic, state)
    end
    builtin = is_builtin(to_symbol(name_text))
    if !builtin && name_text != "commit" && name_text != "suspend" && name_text != "invoke" && name_text != "mailbox_recv" && name_text != "some" && name_text != "ok" && name_text != "err"
      return emit_dispatch_arguments(rows, node, none, [:Constant, to_symbol(name_text)], false, 0, state)
    end
  end
  let args = []
  for arg in ast_children(rows, node, :arg)
    let [_, value_node] = ast_attr(rows, arg, :expr)
    let [items, after_value] = emit_items(rows, [value_node], state)
    state = after_value
    let [named, _] = ast_attr(rows, arg, :role)
    if named
      return emit_error(state, "ordinary call arguments must be positional")
    end
    args = [@args, items[0]]
  end
  let [dst, allocated] = emit_register(state)
  state = allocated
  if is_function
    return [dst, emit_append(state, [:CallValue, dst, [:Register, callee_reg], args])]
  end
  if name_text == "invoke" || name_text == "mailbox_recv"
    return emit_special_call(name_text, dst, args, state)
  end
  if name_text == "some" || name_text == "ok" || name_text == "err"
    if len(args) != 1 || args[0][0] == :Splice
      return emit_error(state, "option and result constructors require one positional argument")
    end
    if name_text == "some"
      return [dst, emit_append(state, [:BuildRelation, dst, [:value], args, 1])]
    end
    let case_name = :ok
    if name_text == "err"
      case_name = :error
      state = emit_append(state, [:CheckKind, args[0][1], :error, :Builtin, :err])
    end
    return [dst, emit_append(state, [:BuildRelation, dst, [:case, :value], [[:Constant, case_name], args[0]], 1])]
  end
  if callee_kind == :Name && name_text == "commit"
    if len(args) != 0
      return emit_error(state, "commit expects no arguments")
    end
    return [dst, emit_append(state, [:CommitValue, dst])]
  end
  if callee_kind == :Name && name_text == "suspend"
    if len(args) > 1
      return emit_error(state, "suspend expects at most one argument")
    end
    let duration = none
    if len(args) == 1
      duration = args[0]
    end
    return [dst, emit_append(state, [:SuspendValue, dst, duration])]
  end
  if callee_kind == :Name && builtin
    return [dst, emit_append(state, [:BuiltinCall, dst, to_symbol(name_text), args])]
  end
  return [dst, emit_append(state, [:PositionalDispatch, dst, [:Constant, to_symbol(name_text)], args])]
end

verb emit_special_instruction(name, dst, args, input_state)
  if name == "invoke"
    return emit_append(input_state, [:DynamicDispatch, dst, args[0], args[1]])
  end
  let timeout = none
  if len(args) == 2
    timeout = args[1]
  end
  return emit_append(input_state, [:MailboxRecv, dst, args[0], timeout])
end

verb emit_special_call(name, dst, args, input_state)
  let minimum = 1
  let message = "mailbox_recv expects a receive-cap list and optional timeout"
  if name == "invoke"
    minimum = 2
    message = "invoke expects selector and role map"
  end
  let spliced = false
  for arg in args
    spliced = spliced || arg[0] == :Splice
  end
  if !spliced
    if len(args) < minimum || len(args) > 2
      return emit_error(input_state, message)
    end
    return [dst, emit_special_instruction(name, dst, args, input_state)]
  end
  let [actuals, allocated] = emit_register(input_state)
  let state = emit_append(allocated, [:BuildList, actuals, args])
  let [length, after_length] = emit_register(state)
  state = emit_append(after_length, [:CollectionLen, length, actuals])
  for boundary in [[:Lt, minimum], [:Gt, 2]]
    let [limit, loaded] = emit_constant(state, boundary[1])
    let [invalid, after_invalid] = emit_register(loaded)
    state = emit_append(after_invalid, [:Binary, invalid, boundary[0], length, limit])
    let position = len(state[:code])
    state = emit_append(state, [:Branch, invalid, position + 1, position + 2])
    state = emit_append(state, [:Abort, [:Constant, message]])
  end
  let operands = []
  let index = 0
  while index < minimum
    let [reg, after_reg] = emit_register(state)
    state = emit_append(after_reg, [:Index, reg, actuals, [:Constant, index]])
    operands = [@operands, [:Register, reg]]
    index = index + 1
  end
  if minimum == 2
    return [dst, emit_special_instruction(name, dst, operands, state)]
  end
  let [one, loaded] = emit_constant(state, 1)
  let [omitted, after_omitted] = emit_register(loaded)
  state = emit_append(after_omitted, [:Binary, omitted, :Eq, length, one])
  let branch = len(state[:code])
  state = emit_append(state, [:Branch, omitted, 0, 0])
  state = emit_special_instruction(name, dst, operands, state)
  let jump = len(state[:code])
  state = emit_append(state, [:Jump, 0])
  let supplied = len(state[:code])
  let [timeout, after_timeout] = emit_register(state)
  state = emit_append(after_timeout, [:Index, timeout, actuals, [:Constant, 1]])
  state = emit_special_instruction(name, dst, [@operands, [:Register, timeout]], state)
  state = emit_patch(state, branch, [:Branch, omitted, branch + 1, supplied])
  state = emit_patch(state, jump, [:Jump, len(state[:code])])
  return [dst, state]
end

verb emit_dom(rows, node, input_state)
  let state = input_state
  if ast_kind(rows, node) == :Dom_Text
    let [_, text] = ast_attr(rows, node, :text)
    let [dst, allocated] = emit_register(state)
    return [dst, emit_append(allocated, [:BuiltinCall, dst, :dom_text, [[:Constant, text]]])]
  end
  let [_, tag] = ast_attr(rows, node, :tag)
  let attributes = []
  for attribute in ast_children(rows, node, :attribute)
    let [_, name] = ast_attr(rows, attribute, :name)
    let [has_value, value_node] = ast_attr(rows, attribute, :value)
    let value = [:Constant, true]
    if has_value
      let [reg, emitted] = emit_expr(rows, value_node, state)
      state = emitted
      value = [:Register, reg]
    end
    attributes = [@attributes, [[:Constant, name], value]]
  end
  let [attrs, after_attrs] = emit_register(state)
  state = emit_append(after_attrs, [:BuildMap, attrs, attributes])
  let [children, emitted] = emit_items(rows, ast_children(rows, node, :child), state)
  let [items, after_items] = emit_register(emitted)
  state = emit_append(after_items, [:BuildList, items, children])
  let [dst, allocated] = emit_register(state)
  return [dst, emit_append(allocated, [:BuiltinCall, dst, :dom_element, [[:Constant, tag], [:Register, attrs], [:Register, items]]])]
end

verb emit_frob(rows, node, input_state)
  let [_, head] = ast_attr(rows, node, :head)
  if ast_kind(rows, head) != :Identity_Literal
    return emit_error(input_state, "a structural literal head must be an identity")
  end
  let [delegate, state] = emit_expr(rows, head, input_state)
  let cells = ast_children(rows, node, :cell)
  let [named, _] = ast_attr(rows, node, :named)
  let [listed, _] = ast_attr(rows, node, :list)
  let values = []
  for cell in cells
    let [_, value_node] = ast_attr(rows, cell, :value)
    values = [@values, value_node]
  end
  let payload = 0
  if named
    let entries = []
    for cell in cells
      let [_, name_node] = ast_attr(rows, cell, :name)
      let [_, value_node] = ast_attr(rows, cell, :value)
      let [key, after_key] = emit_expr(rows, name_node, state)
      let [value, after_value] = emit_expr(rows, value_node, after_key)
      state = after_value
      entries = [@entries, [[:Register, key], [:Register, value]]]
    end
    let [reg, allocated] = emit_register(state)
    payload = reg
    state = emit_append(allocated, [:BuildMap, payload, entries])
  elseif !listed && len(values) == 1
    let [reg, emitted] = emit_expr(rows, values[0], state)
    payload = reg
    state = emitted
  else
    let [items, emitted] = emit_items(rows, values, state)
    let [reg, allocated] = emit_register(emitted)
    payload = reg
    state = emit_append(allocated, [:BuildList, payload, items])
  end
  let [dst, allocated] = emit_register(state)
  return [dst, emit_append(allocated, [:BuiltinCall, dst, :frob, [[:Register, delegate], [:Register, payload]]])]
end

verb emit_dispatch(rows, node, spawning, delay_node, input_state)
  let state = input_state
  let receiver = none
  let selector = none
  let kind = ast_kind(rows, node)
  if kind == :Receiver_Call
    let [_, receiver_node] = ast_attr(rows, node, :receiver)
    let [reg, emitted] = emit_expr(rows, receiver_node, state)
    state = emitted
    receiver = [:Register, reg]
    let [dynamic, expr] = ast_attr(rows, node, :selector_expr)
    if dynamic
      let [reg, emitted] = emit_expr(rows, expr, state)
      state = emitted
      selector = [:Register, reg]
    else
      let [_, spelling] = ast_attr(rows, node, :selector)
      let parsed = from_literal(string_concat(":", spelling))
      if parsed[0][:case] != :ok
        return emit_error(state, "invalid receiver selector")
      end
      selector = [:Constant, parsed[0][:value]]
    end
  elseif kind == :Call
    let [_, callee] = ast_attr(rows, node, :callee)
    let callee_kind = ast_kind(rows, callee)
    let value_node = callee
    if callee_kind == :Selector_Expr
      let [_, expr] = ast_attr(rows, callee, :value)
      value_node = expr
    elseif callee_kind != :Symbol_Literal
      return emit_error(state, "spawn requires a selector or receiver call")
    end
    let [reg, emitted] = emit_expr(rows, value_node, state)
    state = emitted
    selector = [:Register, reg]
  else
    return emit_error(state, "spawn requires a selector or receiver call")
  end
  return emit_dispatch_arguments(rows, node, receiver, selector, spawning, delay_node, state)
end

verb emit_dispatch_arguments(rows, node, receiver, selector, spawning, delay_node, input_state)
  let state = input_state
  let arguments = ast_children(rows, node, :arg)
  let named = false
  let ordinary = false
  if !spawning && receiver == none
    let [has_callee, callee] = ast_attr(rows, node, :callee)
    if has_callee
      ordinary = ast_kind(rows, callee) == :Name
      named = !ordinary
    end
  end
  let dynamic_roles = false
  for arg in arguments
    let [has_role, _] = ast_attr(rows, arg, :role)
    if ordinary && has_role
      return emit_error(state, "ordinary call arguments must be positional")
    end
    named = named || has_role
    let [_, value_node] = ast_attr(rows, arg, :expr)
    dynamic_roles = dynamic_roles || ast_kind(rows, value_node) == :Splice
  end
  let items = []
  if receiver != none
    if named
      let role = :receiver
      if dynamic_roles
        role = [:Constant, role]
      end
      items = [[role, receiver]]
    else
      items = [receiver]
    end
  end
  for arg in arguments
    let [_, value_node] = ast_attr(rows, arg, :expr)
    let [has_role, role] = ast_attr(rows, arg, :role)
    let spliced = ast_kind(rows, value_node) == :Splice
    if named && ((!has_role && !spliced) || (has_role && spliced))
      return emit_error(state, "named dispatch requires role values or spliced role maps")
    end
    let [emitted_items, emitted] = emit_items(rows, [value_node], state)
    state = emitted
    if named && has_role
      let key = to_symbol(role)
      if dynamic_roles
        key = [:Constant, key]
      end
      items = [@items, [key, emitted_items[0]]]
    else
      items = [@items, emitted_items[0]]
    end
  end
  let roles = none
  if named && dynamic_roles
    let [reg, allocated] = emit_register(state)
    state = emit_append(allocated, [:BuildMap, reg, items])
    roles = [:Register, reg]
  end
  let delay = none
  if delay_node != 0
    let [reg, emitted] = emit_expr(rows, delay_node, state)
    state = emitted
    delay = [:Register, reg]
  end
  let [dst, allocated] = emit_register(state)
  state = allocated
  if spawning
    if named
      if dynamic_roles
        return [dst, emit_append(state, [:SpawnDispatchDynamic, dst, selector, roles, delay])]
      end
      return [dst, emit_append(state, [:SpawnDispatch, dst, selector, items, delay])]
    end
    return [dst, emit_append(state, [:SpawnPositionalDispatch, dst, selector, items, delay])]
  end
  if named
    if dynamic_roles
      return [dst, emit_append(state, [:DynamicDispatch, dst, selector, roles])]
    end
    return [dst, emit_append(state, [:Dispatch, dst, selector, items])]
  end
  return [dst, emit_append(state, [:PositionalDispatch, dst, selector, items])]
end

// Collect references through AST edges. Shadowed names can add harmless
// captures, but unrelated locals never enter the function environment.
verb emit_referenced_names(rows, node, node_kinds)
  let names = {}
  let visited = {}
  let pending = [node]
  while len(pending) > 0
    let last = len(pending) - 1
    let current = pending[last]
    if last == 0
      pending = []
    else
      pending = pending[0..(last - 1)]
    end
    if index_or(visited, current, false)
      continue
    end
    visited[current] = true
    if index_or(node_kinds, current, :Unknown) == :Name
      names[string_join(ast_children(rows, current, :part), "/")] = true
    end
    let position = lower_bound(rows, current)
    while position < len(rows) && rows[position][0] == current
      let target = rows[position][2]
      if index_or(node_kinds, target, none) != none
        pending = [@pending, target]
      end
      position = position + 1
    end
  end
  return names
end

verb emit_function(rows, node, input_state)
  let state = input_state
  let nested = emit_state(state[:relations], state[:node_kinds], state[:field_relations])
  let [has_name, name_text] = ast_attr(rows, node, :name)
  if has_name
    nested[:self_name] = name_text
  end
  let [has_result, result_text] = ast_attr(rows, node, :result)
  if has_result
    nested[:result_annotation] = result_text
  end
  let captures = []
  for name, referenced in emit_referenced_names(rows, node, state[:node_kinds])
    let [found, outer_reg, immutable] = emit_local(state, name)
    if found
      let [reg, allocated] = emit_register(nested)
      nested = emit_declare(allocated, name, reg, immutable)
      let types = nested[:binding_types]
      types[reg] = index_or(state[:binding_types], outer_reg, "")
      nested[:binding_types] = types
      captures = [@captures, [:Register, outer_reg]]
    end
  end
  let [actuals, after_actuals] = emit_register(nested)
  let [length, after_length] = emit_register(after_actuals)
  nested = emit_scope(emit_append(after_length, [:CollectionLen, length, actuals]))
  let minimum = 0
  let position = 0
  let saw_optional = false
  let saw_rest = false
  for param in ast_children(rows, node, :param)
    let [_, param_name] = ast_attr(rows, param, :name)
    let [_, mode] = ast_attr(rows, param, :mode)
    let [restricted, _] = ast_attr(rows, param, :restrict)
    if restricted
      nested = emit_diagnostic(nested, "local function parameters do not dispatch on prototypes")
    end
    let slot_kind = :Binding_Pattern
    if mode == :req
      if saw_optional || saw_rest
        nested = emit_diagnostic(nested, "required parameters must precede optional and rest parameters")
      end
      minimum = minimum + 1
    elseif mode == :opt
      if saw_rest
        nested = emit_diagnostic(nested, "optional parameters must precede a rest parameter")
      end
      saw_optional = true
      slot_kind = :Optional_Pattern
      let [has_default, _] = ast_attr(rows, param, :default)
      if !has_default
        nested = emit_diagnostic(nested, "optional function parameters require a default")
      end
    elseif mode == :rest
      if saw_rest
        nested = emit_diagnostic(nested, "a function supports only one rest parameter")
      end
      saw_rest = true
      slot_kind = :Rest_Pattern
    end
    let [reg, emitted] = emit_collection_slot(rows, param, slot_kind, actuals, position, length, nested)
    nested = emit_declare(emitted, param_name, reg, true)
    let [annotated, annotation] = ast_attr(rows, param, :annotation)
    if annotated
      if mode == :rest && annotation != "list" && annotation != "any"
        nested = emit_diagnostic(nested, "a rest parameter must accept a list")
      end
      nested = emit_annotation(nested, reg, annotation, :Parameter, param_name)
    end
    if mode != :rest
      position = position + 1
    end
  end
  let [expression, expression_node] = ast_attr(rows, node, :expression_body)
  let result = 0
  if expression
    let [reg, emitted] = emit_expr(rows, expression_node, nested)
    result = reg
    nested = emitted
  else
    let [reg, emitted] = emit_block(rows, ast_children(rows, node, :body), nested)
    result = reg
    nested = emitted
  end
  nested = emit_finish(nested, result)
  state[:errors] = [@state[:errors], @nested[:errors]]
  let maximum = position
  if saw_rest
    maximum = 65535
  end
  let [dst, allocated] = emit_register(state)
  return [dst, emit_append(allocated, [:LoadFunction, dst, emit_description(nested), captures, minimum, maximum])]
end

verb emit_relation_call(rows, node, target, operation, input_state)
  let state = input_state
  let args = []
  for arg in ast_children(rows, node, :arg)
    let [named, _] = ast_attr(rows, arg, :role)
    if named
      return emit_error(state, "relation arguments are positional")
    end
    let [_, expr] = ast_attr(rows, arg, :expr)
    let kind = ast_kind(rows, expr)
    if kind == :Query_Variable
      if operation != :ScanDynamic
        return emit_error(state, "fact changes do not bind query variables")
      end
      let [_, name_text] = ast_attr(rows, expr, :name)
      args = [@args, [:Query, to_symbol(name_text)]]
    elseif kind == :Wildcard
      if operation == :AssertDynamic
        return emit_error(state, "assertions require a value at every position")
      end
      args = [@args, [:Hole]]
    else
      let [items, emitted] = emit_items(rows, [expr], state)
      state = emitted
      args = [@args, items[0]]
    end
  end
  if operation == :ScanDynamic
    let [dst, allocated] = emit_register(state)
    return [dst, emit_append(allocated, [:ScanDynamic, dst, target, args])]
  end
  state = emit_append(state, [operation, target, args])
  return emit_constant(state, [] {[]})
end

verb emit_if(rows, node, input_state)
  let [result, state] = emit_constant(input_state, [] {[]})
  let exits = []
  for branch_node in ast_children(rows, node, :branch)
    let [_, condition_node] = ast_attr(rows, branch_node, :condition)
    let [condition, after_condition] = emit_expr(rows, condition_node, state)
    state = after_condition
    let position = len(state[:code])
    state = emit_append(state, [:Branch, condition, position + 1, 0])
    let [body_reg, after_body] = emit_block(rows, ast_children(rows, branch_node, :body), emit_scope(state))
    state = emit_unscope(after_body)
    state = emit_append(state, [:Move, result, body_reg])
    exits = [@exits, len(state[:code])]
    state = emit_append(state, [:Jump, 0])
    state = emit_patch(state, position, [:Branch, condition, position + 1, len(state[:code])])
  end
  let [has_else, _] = ast_attr(rows, node, :has_else)
  if has_else
    let [body_reg, after_body] = emit_block(rows, ast_children(rows, node, :else_body), emit_scope(state))
    state = emit_append(emit_unscope(after_body), [:Move, result, body_reg])
  end
  for position in exits
    state = emit_patch(state, position, [:Jump, len(state[:code])])
  end
  return [result, state]
end

verb emit_loop(rows, node, input_state)
  let is_comprehension = ast_kind(rows, node) == :Comprehension
  let initial = [] {[]}
  if is_comprehension
    initial = []
  end
  let [result, state] = emit_constant(emit_scope(input_state), initial)
  let is_for = ast_kind(rows, node) == :For || is_comprehension
  let collection = 0
  let index_reg = 0
  let one_reg = 0
  let length_reg = 0
  if is_for
    let [_, iterable] = ast_attr(rows, node, :iterable)
    let [reg, after_collection] = emit_expr(rows, iterable, state)
    state = after_collection
    collection = reg
    let [index, after_index] = emit_constant(state, 0)
    let [one, after_one] = emit_constant(after_index, 1)
    let [length, after_length] = emit_register(after_one)
    state = emit_append(after_length, [:CollectionLen, length, collection])
    index_reg = index
    one_reg = one
    length_reg = length
  end
  let start = len(state[:code])
  let condition = 0
  if is_for
    let [reg, allocated] = emit_register(state)
    state = emit_append(allocated, [:Binary, reg, :Lt, index_reg, length_reg])
    condition = reg
  else
    let [_, condition_node] = ast_attr(rows, node, :condition)
    let [reg, after_condition] = emit_expr(rows, condition_node, state)
    state = after_condition
    condition = reg
  end
  let branch = len(state[:code])
  state = emit_append(state, [:Branch, condition, branch + 1, 0])
  if is_for
    state = emit_iteration_bindings(rows, node, collection, index_reg, state)
  end
  state[:loops] = [@state[:loops], {:breaks -> [], :continues -> []}]
  if is_comprehension
    state = emit_comprehension_item(rows, node, result, state)
  else
    let [_, after_body] = emit_block(rows, ast_children(rows, node, :body), state)
    state = after_body
  end
  let continue_target = start
  if is_for
    continue_target = len(state[:code])
    state = emit_append(state, [:Binary, index_reg, :Add, index_reg, one_reg])
  end
  state = emit_append(state, [:Jump, start])
  let finish = len(state[:code])
  state = emit_patch(state, branch, [:Branch, condition, branch + 1, finish])
  let loops = state[:loops]
  let loop_info = loops[len(loops) - 1]
  for position in loop_info[:breaks]
    state = emit_patch(state, position, [:Jump, finish])
  end
  for position in loop_info[:continues]
    state = emit_patch(state, position, [:Jump, continue_target])
  end
  let retained = []
  let index = 0
  while index + 1 < len(loops)
    retained = [@retained, loops[index]]
    index = index + 1
  end
  state[:loops] = retained
  if is_comprehension
    let [bare_sort, _] = ast_attr(rows, node, :sort_bare)
    let [keyed, _] = ast_attr(rows, node, :key)
    if bare_sort || keyed
      state = emit_append(state, [:BuiltinCall, result, :sort, [[:Register, result]]])
    end
    if keyed
      let [projected, after_projection] = emit_sorted_values(result, state)
      return [projected, emit_unscope(after_projection)]
    end
  end
  return [result, emit_unscope(state)]
end

verb emit_comprehension_item(rows, node, result, input_state)
  let state = input_state
  let [filtered, condition_node] = ast_attr(rows, node, :condition)
  let branch = 0
  let condition = 0
  if filtered
    let [reg, emitted] = emit_expr(rows, condition_node, state)
    state = emitted
    condition = reg
    branch = len(state[:code])
    state = emit_append(state, [:Branch, condition, branch + 1, 0])
  end
  // Rust evaluates the sort key before the body, after the filter succeeds.
  let [keyed, key_node] = ast_attr(rows, node, :key)
  let key = 0
  if keyed
    let [reg, emitted] = emit_expr(rows, key_node, state)
    state = emitted
    key = reg
  end
  let [_, body] = ast_attr(rows, node, :body)
  let [value, emitted] = emit_expr(rows, body, state)
  state = emitted
  if keyed
    let [pair, allocated] = emit_register(state)
    state = emit_append(allocated, [:BuildList, pair, [[:Register, key], [:Register, value]]])
    value = pair
  end
  state = emit_append(state, [:BuildList, result, [[:Splice, [:Register, result]], [:Register, value]]])
  if filtered
    state = emit_patch(state, branch, [:Branch, condition, branch + 1, len(state[:code])])
  end
  return state
end

verb emit_sorted_values(collection, input_state)
  let [result, state] = emit_constant(input_state, [])
  let [index, after_index] = emit_constant(state, 0)
  let [one, after_one] = emit_constant(after_index, 1)
  let [length, after_length] = emit_register(after_one)
  let [condition, after_condition] = emit_register(after_length)
  let [pair, after_pair] = emit_register(after_condition)
  let [value, allocated] = emit_register(after_pair)
  state = emit_append(allocated, [:CollectionLen, length, collection])
  let start = len(state[:code])
  state = emit_append(state, [:Binary, condition, :Lt, index, length])
  let branch = len(state[:code])
  state = emit_append(state, [:Branch, condition, branch + 1, 0])
  state = emit_append(state, [:CollectionValueAt, pair, collection, index])
  state = emit_append(state, [:Index, value, pair, [:Constant, 1]])
  state = emit_append(state, [:BuildList, result, [[:Splice, [:Register, result]], [:Register, value]]])
  state = emit_append(state, [:Binary, index, :Add, index, one])
  state = emit_append(state, [:Jump, start])
  state = emit_patch(state, branch, [:Branch, condition, branch + 1, len(state[:code])])
  return [result, state]
end

verb emit_loop_exit(kind, input_state)
  let state = input_state
  let loops = state[:loops]
  if len(loops) == 0
    return emit_error(state, "break and continue require a loop")
  end
  let last = len(loops) - 1
  let loop_info = loops[last]
  let key = :breaks
  if kind == :Continue
    key = :continues
  end
  loop_info[key] = [@loop_info[key], len(state[:code])]
  loops[last] = loop_info
  state[:loops] = loops
  state = emit_append(state, [:Jump, 0])
  return emit_constant(state, [] {[]})
end

verb emit_annotation(state, reg, annotation, site, subject)
  if annotation == "" || annotation == "any"
    return state
  end
  let kinds = ["bool", "int", "float", "identity", "symbol", "error_code", "string", "bytes", "list", "map", "range", "error", "capability", "frob", "function", "relation"]
  let found = false
  for spelling in kinds
    if spelling == annotation
      found = true
      break
    end
  end
  if !found
    return emit_diagnostic(state, string_concat("unsupported type annotation: ", annotation))
  end
  return emit_append(state, [:CheckKind, reg, to_symbol(annotation), site, to_symbol(subject)])
end

verb emit_finish(state, reg)
  let checked = emit_annotation(state, reg, state[:result_annotation], :Binding, "result")
  return emit_append(checked, [:Return, [:Register, reg]])
end

verb emit_loop_binding(rows, node, reg, input_state)
  let [_, name_text] = ast_attr(rows, node, :name)
  let state = input_state
  if name_text != "_"
    state = emit_declare(state, name_text, reg, true)
  end
  let [annotated, annotation] = ast_attr(rows, node, :annotation)
  if annotated
    state = emit_annotation(state, reg, annotation, :Binding, name_text)
  end
  return state
end
