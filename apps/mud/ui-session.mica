verb ui/actor_name(obj)
  if is_frob(obj) && frob_delegate(obj) == #passage
    let current = ui/current_actor()
    if current != none
      return ui/passage_name(current, obj)
    end
    return "passage"
  end

  let names = Name(obj, ?name)
  if not names
    return to_literal(obj)
  end
  let exactly {:name -> name} = names
  return name
end

verb ui/direction_text(direction)
  if direction == none
    return ""
  end

  if direction == "north"
    return "north"
  elseif direction == "south"
    return "south"
  elseif direction == "up"
    return "up"
  elseif direction == "down"
    return "down"
  end

  if direction == :north
    return "north"
  elseif direction == :south
    return "south"
  elseif direction == :up
    return "up"
  elseif direction == :down
    return "down"
  end

  return direction
end

verb ui/can_build(actor @ #player)
  return Builder(actor) || Delegates(actor, #builder, ?builder_depth)
end

verb ui/current_actor()
  if let some(current) = actor()
    if Delegates(current, #player, 0)
      return current
    end
  end

  return none
end

verb ui/ensure_actor_location(actor @ #player)
  let room = actor.locatedIn
  if room == none
    actor.locatedIn = #first_room
    return #first_room
  end

  return room
end

verb ui/entity_from_literal(text)
  if text == none
    return none
  end

  return match from_literal(text)
  case ok(value)
    some(value)
  case err(problem)
    none
  end
end

verb ui/passage_visible_from(actor @ #player, passage)
  let room = actor.locatedIn
  if room == none
    return false
  end

  return PassageSide(passage, room, ?destination)
end

verb ui/passage_room_for(actor @ #player, passage)
  let room = actor.locatedIn
  if room != none && PassageSide(passage, room, ?destination)
    return room
  end

  return none
end

verb ui/passage_name(actor @ #player, passage)
  let room = ui/passage_room_for(actor, passage)
  if room == none
    return "passage"
  end

  return passage/label_for(passage, room)
end

verb ui/description_text(actor @ #player, entity)
  if is_frob(entity) && frob_delegate(entity) == #passage
    let room = ui/passage_room_for(actor, entity)
    if room == none
      return ""
    end
    return passage/describe_from(entity, room)
  end

  let exactly {:description -> description} = Description(entity, ?description)
  return description
end

verb ui/can_inspect_entity(actor @ #player, entity)
  if entity == none
    return false
  end

  if CanSee(actor, entity)
    return true
  end

  if ui/can_build(actor) && Delegates(entity, #room, 0) && entity.roomInArea == builder/current_area(actor)
    return true
  end

  return is_frob(entity) && frob_delegate(entity) == #passage && ui/passage_visible_from(actor, entity)
end

verb ui/can_program(actor @ #player)
  return Delegates(actor, #programmer, 0)
end

verb ui/narrative_cutoff()
  let current = ui/current_actor()
  if current == none
    return 0
  end

  let revision = 1
  for found in event/Delivery(current, ?event)
    let seq = found[:event].event/seq
    if seq > revision || seq == revision
      revision = seq + 1
    end
  end
  return revision
end

verb ui/view_dependency(relation, bindings)
  return {:subject -> :relation, :relation -> relation, :bindings -> bindings}
end

verb ui/fact_dependency(relation, bindings)
  return {:subject -> :facts, :relation -> relation, :bindings -> bindings}
end

verb sync_view_dependencies(view)
  let endpoint = endpoint()
  let current = ui/current_actor()
  let current_binding = none
  if current != none
    current_binding = some(current)
  end
  let dependencies = []
  dependencies = [@dependencies, ui/fact_dependency(:ui/View, [some(view)])]
  dependencies = [@dependencies, ui/fact_dependency(:session/Actor, [some(endpoint), none])]
  dependencies = [@dependencies, ui/fact_dependency(:session/Inspect, [some(endpoint), none])]
  dependencies = [@dependencies, ui/fact_dependency(:session/InspectPulse, [some(endpoint), none])]
  dependencies = [@dependencies, ui/fact_dependency(:session/NarrativeLimit, [some(endpoint), none])]
  dependencies = [@dependencies, ui/fact_dependency(:session/CommandDraft, [some(endpoint), none])]
  dependencies = [@dependencies, ui/fact_dependency(:session/CommandSuggest, [some(endpoint), none])]
  dependencies = [@dependencies, ui/fact_dependency(:session/CommandSuggestIndex, [some(endpoint), none])]
  dependencies = [@dependencies, ui/fact_dependency(:session/ObjectBrowserQuery, [some(endpoint), none])]
  dependencies = [@dependencies, ui/fact_dependency(:session/RetrievalPlan, [some(endpoint), none])]
  dependencies = [@dependencies, ui/view_dependency(:Delegates, [none, none, none])]
  dependencies = [@dependencies, ui/view_dependency(:Name, [none, none])]
  dependencies = [@dependencies, ui/view_dependency(:Description, [none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:LocatedIn, [none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:RoomInArea, [none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:Portable, [none])]
  dependencies = [@dependencies, ui/fact_dependency(:PassageInArea, [none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:PassageSide, [none, none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:PassageLabel, [none, none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:PassageAlias, [none, none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:PassageDescription, [none, none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:PassageAmbient, [none, none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:PassageOpen, [none, none])]
  dependencies = [@dependencies, ui/view_dependency(:Exit, [none, none, none])]
  dependencies = [@dependencies, ui/view_dependency(:ReachableRoom, [none, none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:Builder, [none])]
  dependencies = [@dependencies, ui/view_dependency(:CanSee, [none, none])]
  dependencies = [@dependencies, ui/view_dependency(:Carrying, [none, none])]
  dependencies = [@dependencies, ui/view_dependency(:PresentActor, [none, none])]
  dependencies = [@dependencies, ui/view_dependency(:event/NarrativeEntry, [current_binding, none, none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:ContextForPlan, [none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:ContextSubject, [none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:ContextScore, [none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:ContextReason, [none, none])]
  dependencies = [@dependencies, ui/fact_dependency(:IndexEntryStatus, [none, none, none, none])]
  if current != none && ui/can_program(current)
    dependencies = [@dependencies, ui/fact_dependency(:ui/MicaInspect, [some(endpoint), none])]
    dependencies = [@dependencies, ui/fact_dependency(:ui/MicaInspectBack, [some(endpoint), none])]
    dependencies = [@dependencies, ui/fact_dependency(:ui/MicaInspectLayout, [some(endpoint), none])]
    dependencies = [@dependencies, ui/fact_dependency(:ui/MicaMethodMode, [some(endpoint), none])]
    dependencies = [@dependencies, ui/fact_dependency(:ui/MicaMethodLimit, [some(endpoint), none])]
    dependencies = [@dependencies, ui/fact_dependency(:ui/MicaBrowserQuery, [some(endpoint), none])]
    dependencies = [@dependencies, ui/view_dependency(:Relation, [none])]
  end
  return dependencies
end

verb sync_view_tree(view)
  let current = ui/current_actor()
  if ui/View(view) == false || current == none
    return ui/auth_required_node()
  end
  ui/ensure_actor_location(current)

  let limit = 40
  let limits = session/NarrativeLimit(endpoint(), ?limit)
  if limits
    let exactly {:limit -> configured_limit} = limits
    limit = configured_limit
  end
  let revision = ui/narrative_cutoff()
  return ui/world_view_node(current, revision, limit)
end
