// Compiled program graphs are process-local managed objects. The kernel owns
// their transactional visibility and retention, without knowing their entry ABI.
// Invocation checks belong to the resolver; catalogue writes check ownership.
verb native_programs/index_specs() -> list
  return [["program_index", "ProgramIndex", "Program"], ["program_change_index", "ProgramChangeIndex", "ProgramChange"]]
end
verb native_programs/schemas() -> list
  let program: list = native_kernel/pointer("Program")
  let change: list = native_kernel/pointer("ProgramChange")
  let schemas: list = [
    ["Program", [["id", :U64], ["tenant", native_value/word()], ["body", native_memory/pointer(:U8)]]],
    ["ProgramChange", [["next", change], ["id", :U64], ["before", program], ["after", program]]]]
  for spec in native_programs/index_specs()
    let node: list = native_kernel/pointer(spec[1])
    schemas = [@schemas, [spec[1], [["left", node], ["right", node], ["entry", native_kernel/pointer(spec[2])], ["height", :U64]]]]
  end
  return schemas
end
verb native_programs/result_schemas() -> list
  let results: list = [
    ["KernelProgramResult", [["status", :U64], ["program", native_kernel/pointer("Program")]]],
    ["KernelProgramTreeResult", [["status", :U64], ["programs", native_kernel/pointer("ProgramIndex")]]]]
  for spec in native_programs/index_specs()
    results = [@results, [string_concat("Kernel", spec[1], "Result"), [["ok", :Bool], ["node", native_kernel/pointer(spec[1])]]]]
  end
  return results
end
verb native_programs/transaction(module: map, name: string) -> list
  let builder: map = native_gen/context(module, string_concat("kernel_program_", name))
  let [work: map, opened: map] = native_kernel/open_transaction(builder, fn(failed) => native_rules/error(failed, "closed"))
  builder = native_roots/open_scope(opened, fn(failed, reason) => native_rules/error(failed, reason))
  let [rooted: map, ready: map] = native_roots/retain(builder, "work", work)
  builder = native_execution/local_budget(ready, native_kernel/load_field(ready, rooted, "rule_limit"))
  builder = native_roots/poll(builder)
  return [rooted, builder]
end
verb native_programs/lookup(builder: map, tree: map, id: map) -> map
  let result: map = native_gen/call(builder, "kernel_program_index_lookup", [tree, id])
  return result
end
verb native_programs/tree_result(builder: map, tree: map) -> map
  let result: map = native_roots/return_value(builder, native_gen/record(builder, builder[:result], {
    "status" -> native_gen/ref(builder, "kernel_ok"), "programs" -> tree}))
  return result
end

// Remember the base definition once. A missing base is also a write observation,
// so two transactions cannot independently install the same program ID.
verb native_programs/change_body(module: map) -> map
  let builder: map = native_gen/context(module, "kernel_program_change")
  let work: map = native_gen/ref(builder, "work")
  let id: map = native_gen/ref(builder, "id")
  let [found: map, searched: map] = native_gen/bind(builder, "found", native_gen/call(builder, "kernel_program_change_index_lookup", [native_kernel/load_field(builder, work, "program_observations"), id]))
  builder = native_gen/unless(searched, native_kernel/absent(found), fn(present) => native_gen/return_value(present, found))
  let base: map = native_kernel/load_field(builder, work, "base")
  let [before: map, observed: map] = native_gen/bind(builder, "before", native_programs/lookup(builder, native_kernel/load_field(builder, base, "programs"), id))
  let [change: map, allocated: map] = native_gen/bind(observed, "change", native_kernel/allocate_record(observed, native_gen/ref(observed, "worker"), "ProgramChange", {
    "next" -> native_kernel/load_field(observed, work, "program_changes"), "id" -> id, "before" -> before, "after" -> before}))
  builder = native_gen/when(allocated, native_kernel/absent(change), fn(failed) => native_gen/return_value(failed, change))
  let [indexed: map, with_index: map] = native_gen/checked_bind(builder, "indexed", native_gen/call(builder, "kernel_program_change_index_put", [native_gen/ref(builder, "worker"), native_kernel/load_field(builder, work, "program_observations"), id, change]), "ok",
    fn(failed) => native_gen/return_zero(failed))
  builder = native_kernel/store_field(with_index, work, "program_observations", native_gen/field(with_index, indexed, "node"))
  builder = native_kernel/store_field(builder, work, "program_changes", change)
  let result: map = native_gen/finish(module, native_gen/return_value(builder, change))
  return result
end

verb native_programs/stage_body(module: map, remove: bool) -> map
  let name: string = "put"
  if remove
    name = "remove"
  end
  let [work: map, opened: map] = native_programs/transaction(module, name)
  let builder: map = native_authority/check_permission(opened, work, "catalogue")
  let id: map = native_gen/ref(builder, "id")
  builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(id)), "schema")
  let [existing: map, found: map] = native_gen/bind(builder, "existing", native_programs/lookup(builder, native_kernel/load_field(builder, work, "programs"), id))
  builder = native_gen/unless(found, native_kernel/absent(existing), fn(present)
    return native_authority/require_tenant(present, work, native_kernel/load_field(present, existing, "tenant"))
  end)
  if remove
    builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(existing)), "unknown")
  else
    builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(native_roots/ref(builder, "body"))), "schema")
    builder = native_rules/check(builder, native_gen/call(builder, "value_is_persistable", [native_roots/ref(builder, "tenant")]), "nonpersistent")
    builder = native_authority/require_tenant(builder, work, native_roots/ref(builder, "tenant"))
    builder = native_gen/unless(builder, native_kernel/absent(existing), fn(present)
      return native_gen/when(present, native_gen/equal(native_kernel/load_field(present, existing, "body"), native_roots/ref(present, "body")), fn(same_body)
        let [equal: map, compared: map] = native_gen/checked_bind(same_body, "tenant_equal", native_gen/call(same_body, "value_equal", [native_kernel/load_field(same_body, existing, "tenant"), native_roots/ref(same_body, "tenant")]), "ok", fn(invalid) => native_rules/error(invalid, "schema"))
        return native_gen/when(compared, native_gen/field(compared, equal, "value"), fn(unchanged) => native_rules/error(unchanged, "ok"))
      end)
    end)
  end
  let [change: map, observed: map] = native_gen/bind(builder, "change", native_gen/call(builder, "kernel_program_change", [native_roots/worker(builder), work, id]))
  builder = native_rules/check(observed, native_gen/negate(native_kernel/absent(change)), "oom")
  let entry: map = native_gen/zero(native_kernel/pointer("Program"))
  if !remove
    let [created: map, allocated: map] = native_rules/allocate(builder, "Program", {
      "id" -> id, "tenant" -> native_roots/ref(builder, "tenant"), "body" -> native_roots/ref(builder, "body")})
    builder = allocated
    entry = created
  end
  let [indexed: map, updated: map] = native_gen/checked_bind(builder, "indexed", native_gen/call(builder, "kernel_program_index_put", [native_roots/worker(builder), native_kernel/load_field(builder, work, "programs"), id, entry]), "ok", fn(failed) => native_rules/error(failed, "oom"))
  // Both indexes and the candidate entry exist before changing the visible draft.
  builder = native_kernel/store_field(updated, work, "programs", native_gen/field(updated, indexed, "node"))
  builder = native_kernel/store_field(builder, change, "after", entry)
  let result: map = native_gen/finish(module, native_rules/error(builder, "ok"))
  return result
end

verb native_programs/rebase_body(module: map) -> map
  let builder: map = native_rules/context(module, "program_rebase")
  builder = native_execution/control_scope(builder, native_roots/worker(builder), native_roots/ref(builder, "budget"))
  let work: map = native_roots/ref(builder, "work")
  let current: map = native_kernel/load_field(builder, work, "checked")
  let [programs: map, rooted: map] = native_roots/retain(builder, "programs", native_kernel/load_field(builder, current, "programs"))
  builder = native_rules/each(rooted, "change", native_kernel/load_field(rooted, work, "program_changes"), fn(visit, change)
    let id: map = native_kernel/load_field(visit, change, "id")
    let before: map = native_kernel/load_field(visit, change, "before")
    let proposed: map = native_kernel/load_field(visit, change, "after")
    // Failed staging and create-then-remove leave no net write.
    let ready: map = native_gen/unless(visit, native_gen/equal(before, proposed), fn(written)
      let found: map = native_programs/lookup(written, programs, id)
      let checked: map = native_gen/unless(written, native_gen/equal(found, before), fn(conflict)
        let failed: map = native_kernel/store_field(conflict, work, "conflict_program", id)
        return native_rules/error(failed, "conflict")
      end)
      let [indexed: map, applied: map] = native_gen/checked_bind(checked, "indexed", native_gen/call(checked, "kernel_program_index_put", [native_roots/worker(checked), programs, id, proposed]), "ok", fn(failed) => native_rules/error(failed, "oom"))
      return native_roots/store(applied, programs, native_gen/field(applied, indexed, "node"))
    end)
    return ready
  end)
  let result: map = native_gen/finish(module, native_programs/tree_result(builder, programs))
  return result
end

verb native_programs/program(input: map) -> map
  let module: map = input
  let transaction: list = ["transaction", native_kernel/pointer("Transaction"), :Borrow]
  let worker: list = ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]
  let work: list = ["work", native_kernel/pointer("Work"), :Gc]
  let id: list = ["id", :U64, :Value]
  for spec in [
    ["program_get", [:Record, "KernelProgramResult"], [transaction, id], true],
    ["program_put", :U64, [transaction, id, ["tenant", native_value/word(), :Gc], ["body", native_memory/pointer(:U8), :Gc]], true],
    ["program_remove", :U64, [transaction, id], true],
    ["program_change", native_kernel/pointer("ProgramChange"), [worker, work, id], false],
    ["program_rebase", [:Record, "KernelProgramTreeResult"], [worker, work, ["budget", native_kernel/pointer("Budget"), :Borrow]], true]]
    module = native_kernel/declare(module, spec[0], spec[1], spec[2], spec[3])
  end
  let [work_value: map, opened: map] = native_programs/transaction(module, "get")
  let [program: map, found: map] = native_gen/bind(opened, "program", native_programs/lookup(opened, native_kernel/load_field(opened, work_value, "programs"), native_gen/ref(opened, "id")))
  let builder: map = native_rules/check(found, native_gen/negate(native_kernel/absent(program)), "unknown")
  builder = native_roots/return_value(builder, native_gen/record(builder, [:Record, "KernelProgramResult"], {"status" -> native_gen/ref(builder, "kernel_ok"), "program" -> program}))
  module = native_gen/finish(module, builder)
  module = native_programs/change_body(module)
  module = native_programs/stage_body(module, false)
  module = native_programs/stage_body(module, true)
  let result: map = native_programs/rebase_body(module)
  return result
end
