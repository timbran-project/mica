// Each index is a persistent AVL tree. Rows are immutable Mica lists; rotations
// allocate path nodes and retain unchanged subtrees through managed pointers.

// An index orders selected columns first, then the remaining columns. A
// projection compares only selected columns, for keys and scan bounds.
verb native_kernel/tuple_order(mask) -> map
  return {:mask -> mask, :mode -> :Total}
end

verb native_kernel/tuple_projection(mask) -> map
  return {:mask -> mask, :mode -> :Projection}
end

verb native_kernel/compare_rows(builder: map, left: map, right: map, order: map) -> map
  let projection = native_gen/ref(builder, "false")
  if order[:mode] == :Projection
    projection = native_gen/ref(builder, "true")
  end
  let result: map = native_gen/call(builder, "kernel_compare", [left, right, order[:mask], projection])
  return result
end

verb native_kernel/find_row(builder: map, relation: map, row: map, order: map) -> map
  let tree = native_gen/call(builder, "kernel_index", [relation, order[:mask]])
  let projection = native_gen/ref(builder, "false")
  if order[:mode] == :Projection
    projection = native_gen/ref(builder, "true")
  end
  let result: map = native_gen/call(builder, "kernel_find", [tree, row, order[:mask], projection])
  return result
end

// The position and its mask bit advance together, including unselected columns.
verb native_kernel/columns(builder: map, width: map, body) -> map
  let [extent, bounded] = native_gen/bind(builder, "columns", width)
  let [position, started] = native_gen/bind(bounded, "position", native_gen/ref(bounded, "zero"))
  let [bit, ready] = native_gen/bind(started, "bit", native_gen/ref(started, "one"))
  let result: map = native_gen/while_loop(ready, native_gen/less(position, extent),
    fn(iteration) => native_kernel/column_step(iteration, position, bit, body))
  return result
end

verb native_kernel/column_step(builder: map, position: map, bit: map, body) -> map
  let result: map = body(builder, position, bit)
  if result[:closed]
    return result
  end
  result = native_gen/assign(result, position, native_gen/add(position, native_gen/ref(result, "one")))
  let completed: map = native_gen/assign(result, bit, native_gen/shift_left(bit, native_gen/ref(result, "one")))
  return completed
end

verb native_kernel/column_is_bound(mask: map, bit: map) -> map
  let result: map = native_gen/not_equal(native_gen/bit_and(mask, bit), native_gen/zero(:U64))
  return result
end

verb native_kernel/covers_columns(bound: map, required: map) -> map
  let result: map = native_gen/equal(native_gen/bit_and(required, bound), required)
  return result
end

verb native_kernel/compare_column(builder: map, left: map, right: map, position: map) -> map
  let compared = native_gen/call(builder, "value_compare", [
    native_gen/call(builder, "kernel_cell", [left, position]),
    native_gen/call(builder, "kernel_cell", [right, position])])
  let [result, ready] = native_gen/bind(builder, "comparison", compared)
  let number = native_gen/field(ready, result, "number")
  let completed: map = native_gen/unless(ready, native_gen/equal(number, native_gen/ref(ready, "int_zero")),
    fn(arm) => native_gen/return_value(arm, number))
  return completed
end

verb native_kernel/compare_columns(builder: map, left: map, right: map, width: map, mask: map, selected: bool) -> map
  let result: map = native_kernel/columns(builder, width, fn(iteration, position, bit) => native_kernel/compare_selected_column(iteration, left, right, position, mask, bit, selected))
  return result
end

verb native_kernel/compare_selected_column(builder: map, left: map, right: map, position: map, mask: map, bit: map, selected: bool) -> map
  let included = native_kernel/column_is_bound(mask, bit)
  if !selected
    included = native_gen/negate(included)
  end
  let result: map = native_gen/when(builder, included, fn(arm) => native_kernel/compare_column(arm, left, right, position))
  return result
end

verb native_kernel/compare_body(module: map) -> map
  let builder = native_gen/context(module, "kernel_compare")
  let left = native_gen/ref(builder, "left")
  let right = native_gen/ref(builder, "right")
  let mask = native_gen/ref(builder, "mask")
  let [width, ready] = native_gen/bind(builder, "width", native_gen/call(builder, "kernel_width", [left]))
  builder = native_kernel/compare_columns(ready, left, right, width, mask, true)
  builder = native_gen/when(builder, native_gen/ref(builder, "prefix"),
    fn(arm) => native_gen/return_value(arm, native_gen/ref(arm, "int_zero")))
  builder = native_kernel/compare_columns(builder, left, right, width, mask, false)
  builder = native_gen/return_value(builder, native_gen/ref(builder, "int_zero"))
  let result: map = native_gen/finish(module, builder)
  return result
end

// A mirrored rotation changes only the meaning of heavy/light children.
verb native_kernel/orientation(heavy: string) -> map
  let light = "right"
  if heavy == "right"
    light = "left"
  end
  return {:heavy -> heavy, :light -> light}
end

verb native_kernel/rebuild_tree(builder: map, children: map, row: map, present: map) -> map
  let result: map = native_gen/call(builder, "kernel_make", [native_gen/ref(builder, "worker"), children["left"], children["right"], row, present])
  return result
end

verb native_kernel/oriented_children(direction: map, heavy: map, light: map) -> map
  return {direction[:heavy] -> heavy, direction[:light] -> light}
end

verb native_kernel/require_node(builder: map, node: map) -> map
  let result: map = native_gen/when(builder, native_gen/equal(node, native_gen/zero(native_gen/type(node))),
    fn(arm) => native_gen/return_value(arm, native_gen/zero(native_kernel/pointer("Node"))))
  return result
end

verb native_kernel/double_rotation(builder: map, direction: map, pivot: map) -> map
  let heavy = direction[:heavy]
  let light = direction[:light]
  let [middle, ready] = native_gen/bind(builder, "middle", native_kernel/load_field(builder, pivot, light))
  let outer = native_kernel/oriented_children(direction,
    native_kernel/load_field(ready, pivot, heavy), native_kernel/load_field(ready, middle, heavy))
  let [a, with_a] = native_gen/bind(ready, "outer_child", native_kernel/rebuild_tree(ready, outer,
    native_kernel/load_field(ready, pivot, "row"), native_kernel/load_field(ready, pivot, "present")))
  let checked = native_kernel/require_node(with_a, a)
  let inner = native_kernel/oriented_children(direction, native_kernel/load_field(checked, middle, light), native_gen/ref(checked, light))
  let [b, with_b] = native_gen/bind(checked, "inner_child", native_kernel/rebuild_tree(checked, inner,
    native_gen/ref(checked, "row"), native_gen/ref(checked, "present")))
  checked = native_kernel/require_node(with_b, b)
  let result: map = native_gen/return_value(checked, native_kernel/rebuild_tree(checked, native_kernel/oriented_children(direction, a, b),
    native_kernel/load_field(checked, middle, "row"), native_kernel/load_field(checked, middle, "present")))
  return result
end

verb native_kernel/single_rotation(builder: map, direction: map, pivot: map) -> map
  let inner = native_kernel/oriented_children(direction,
    native_kernel/load_field(builder, pivot, direction[:light]), native_gen/ref(builder, direction[:light]))
  let [child, ready] = native_gen/bind(builder, "child", native_kernel/rebuild_tree(builder, inner,
    native_gen/ref(builder, "row"), native_gen/ref(builder, "present")))
  ready = native_kernel/require_node(ready, child)
  let outer = native_kernel/oriented_children(direction, native_kernel/load_field(ready, pivot, direction[:heavy]), child)
  let result: map = native_gen/return_value(ready, native_kernel/rebuild_tree(ready, outer,
    native_kernel/load_field(ready, pivot, "row"), native_kernel/load_field(ready, pivot, "present")))
  return result
end

verb native_kernel/rotate(builder: map, direction: map) -> map
  let [pivot, ready] = native_gen/bind(builder, "pivot", native_gen/ref(builder, direction[:heavy]))
  let outer_height = native_gen/call(ready, "kernel_height", [native_kernel/load_field(ready, pivot, direction[:heavy])])
  let inner_height = native_gen/call(ready, "kernel_height", [native_kernel/load_field(ready, pivot, direction[:light])])
  let result: map = native_gen/branch(ready, native_gen/less(outer_height, inner_height),
    fn(arm) => native_kernel/double_rotation(arm, direction, pivot),
    fn(arm) => native_kernel/single_rotation(arm, direction, pivot))
  return result
end

verb native_kernel/balance_body(module: map) -> map
  let builder = native_gen/context(module, "kernel_balance")
  for side in ["left", "right"]
    let direction = native_kernel/orientation(side)
    let heavy_height = native_gen/call(builder, "kernel_height", [native_gen/ref(builder, direction[:heavy])])
    let light_height = native_gen/call(builder, "kernel_height", [native_gen/ref(builder, direction[:light])])
    let imbalanced = native_gen/less(native_gen/add(light_height, native_gen/ref(builder, "one")), heavy_height)
    builder = native_gen/when(builder, imbalanced, fn(arm) => native_kernel/rotate(arm, direction))
  end
  let children = {"left" -> native_gen/ref(builder, "left"), "right" -> native_gen/ref(builder, "right")}
  builder = native_gen/return_value(builder, native_kernel/rebuild_tree(builder, children, native_gen/ref(builder, "row"), native_gen/ref(builder, "present")))
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/indexes(input: map) -> map
  let context: map = input
  let node: list = native_kernel/pointer("Node")
  let word: list = native_value/word()
  let worker: list = ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]
  let result: list = [:Record, "KernelNodeResult"]
  for spec in [
    ["cell", word, [["row", word, :Gc], ["position", :U64, :Value]]],
    ["width", :U64, [["row", word, :Gc]]],
    ["compare", :I64, [["left", word, :Gc], ["right", word, :Gc], ["mask", :U64, :Value], ["prefix", :Bool, :Value]]],
    ["height", :U64, [["node", node, :Gc]]],
    ["make", node, [worker, ["left", node, :Gc], ["right", node, :Gc], ["row", word, :Gc], ["present", :Bool, :Value]]],
    ["balance", node, [worker, ["left", node, :Gc], ["right", node, :Gc], ["row", word, :Gc], ["present", :Bool, :Value]]],
    ["set", result, [worker, ["node", node, :Gc], ["row", word, :Gc], ["mask", :U64, :Value], ["remove", :Bool, :Value], ["present", :Bool, :Value]]],
    ["find", node, [["node", node, :Gc], ["row", word, :Gc], ["mask", :U64, :Value], ["prefix", :Bool, :Value]]]]
    context = native_kernel/declare(context, spec[0], spec[1], spec[2])
  end
  let header: list = [:Pointer, [:Record, "HeapList"], :Const]
  context = native_kernel/define(context, "width", [
    native/let_statement("header", header, native/unary_expression(:UnpackPointer, "row")),
    native/let_load("view", [:Record, "HeapList"], "header"),
    native/return_value(native/typed_field(:U64, "view", "length"))])
  context = native_kernel/define(context, "cell", [
    native/let_statement("header", header, native/unary_expression(:UnpackPointer, "row")),
    native/let_load("view", [:Record, "HeapList"], "header"),
    native/let_field("data", native_memory/pointer(word), "view", "data"),
    native/return_value(native/typed_load(word, native/typed_expression(native_memory/pointer(word), native/offset_expression("data", "position"))))])
  context = native_kernel/compare_body(context)
  context = native_kernel/define(context, "height", [
    native/when_statement(native_kernel/is_null("Node", "node"), [native/return_value("zero")]),
    native/return_value(native_kernel/read("Node", "node", "height"))])
  context = native_kernel/define(context, "make", [
    native/let_call("height", :U64, "kernel_height", ["left"]),
    native/let_call("other", :U64, "kernel_height", ["right"]),
    native/when_statement(native_kernel/binary(:Less, "height", "other"), [native/set_statement("height", "other")]),
    native/return_value(native_kernel/construct("Node", {"left" -> "left", "right" -> "right", "row" -> "row", "height" -> native_kernel/binary(:Add, "height", "one"), "present" -> "present"}))])
  context = native_kernel/balance_body(context)
  context = native_kernel/define(context, "find", [
    native/let_statement("cursor", node, "node"),
    native/while_statement("true", [
      native/when_statement(native_kernel/is_null("Node", "cursor"), [native/return_value("cursor")]),
      native/let_call("order", :I64, "kernel_compare", ["row", native_kernel/read("Node", "cursor", "row"), "mask", "prefix"]),
      native/when_statement(native_kernel/binary(:Equal, "order", "int_zero"), [native/return_value("cursor")]),
      native/if_statement(native_kernel/binary(:Less, "order", "int_zero"),
        [native/set_statement("cursor", native_kernel/read("Node", "cursor", "left"))],
        [native/set_statement("cursor", native_kernel/read("Node", "cursor", "right"))])]), native/return_value(native_kernel/null("Node"))])
  let failed: list = [native/return_zero()]
  context = native_kernel/define(context, "set", [
    native/when_statement(native_kernel/is_null("Node", "node"), [
      native/when_statement("remove", [native/return_record(["true", native_kernel/null("Node")])]),
      native/let_call("leaf", node, "kernel_make", ["worker", native_kernel/null("Node"), native_kernel/null("Node"), "row", "present"]),
      native/return_record([native/typed_expression(:Bool, native_kernel/negate(native_kernel/is_null("Node", "leaf"))), "leaf"])]),
    native/let_statement("left", node, native_kernel/read("Node", "node", "left")),
    native/let_statement("right", node, native_kernel/read("Node", "node", "right")),
    native/let_statement("item", word, native_kernel/read("Node", "node", "row")),
    native/let_statement("flag", :Bool, native_kernel/read("Node", "node", "present")),
    native/let_call("order", :I64, "kernel_compare", ["row", "item", "mask", "false"]),
    native/if_statement(native_kernel/binary(:Equal, "order", "int_zero"), [
      native/if_statement("remove", [
        native/when_statement(native_kernel/is_null("Node", "left"), [native/return_record(["true", "right"])]),
        native/when_statement(native_kernel/is_null("Node", "right"), [native/return_record(["true", "left"])]),
        native/let_statement("successor", node, "right"),
        native/while_statement("true", [
          native/let_statement("next", node, native_kernel/read("Node", "successor", "left")),
          native/when_statement(native_kernel/is_null("Node", "next"), [native/break_statement()]),
          native/set_statement("successor", "next")]),
        native/set_statement("item", native_kernel/read("Node", "successor", "row")),
        native/set_statement("flag", native_kernel/read("Node", "successor", "present")),
        @native/try_call("deleted", result, "kernel_set", ["worker", "right", "item", "mask", "true", "false"], failed),
        native/set_statement("right", native/field_expression("deleted", "node"))],
        [native/set_statement("item", "row"), native/set_statement("flag", "present")])], [
      native/if_statement(native_kernel/binary(:Less, "order", "int_zero"), [
        @native/try_call("changed_left", result, "kernel_set", ["worker", "left", "row", "mask", "remove", "present"], failed),
        native/set_statement("left", native/field_expression("changed_left", "node"))], [
        @native/try_call("changed_right", result, "kernel_set", ["worker", "right", "row", "mask", "remove", "present"], failed),
        native/set_statement("right", native/field_expression("changed_right", "node"))])]),
    native/let_call("balanced", node, "kernel_balance", ["worker", "left", "right", "item", "flag"]),
    native/return_record([native/typed_expression(:Bool, native_kernel/negate(native_kernel/is_null("Node", "balanced"))), "balanced"])])
  return context
end
