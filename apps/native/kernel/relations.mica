// Prefer a bound prefix of natural tuple order. Only when that prefix is
// empty, use the first secondary index whose complete key is bound.
verb native_kernel/scan_plan(builder: map, relation: map, bound: map) -> list
  let [tree, with_tree] = native_gen/bind(builder, "tree", native_gen/call(builder, "kernel_index", [relation, native_gen/ref(builder, "zero")]))
  let [ordering, with_order] = native_gen/bind(with_tree, "ordering", native_gen/ref(with_tree, "zero"))
  let [prefix, ready] = native_gen/bind(with_order, "prefix", native_gen/ref(with_order, "zero"))
  ready = native_kernel/columns(ready, native_kernel/load_field(ready, relation, "arity"),
    fn(iteration, position, bit) => native_kernel/extend_prefix(iteration, prefix, bound, bit))
  ready = native_gen/when(ready, native_kernel/absent(prefix),
    fn(arm) => native_kernel/choose_covered_index(arm, relation, bound, tree, ordering, prefix))
  return [tree, ordering, prefix, ready]
end

verb native_kernel/extend_prefix(builder: map, prefix: map, bound: map, bit: map) -> map
  let ready = native_gen/unless(builder, native_kernel/column_is_bound(bound, bit), fn(arm) => native_gen/break_loop(arm))
  let result: map = native_gen/assign(ready, prefix, native_gen/bit_or(prefix, bit))
  return result
end

verb native_kernel/choose_covered_index(builder: map, relation: map, bound: map, tree: map, ordering: map, prefix: map) -> map
  let [index, ready] = native_gen/bind(builder, "index", native_kernel/load_field(builder, relation, "indexes"))
  let result: map = native_gen/while_loop(ready, native_gen/ref(ready, "true"),
    fn(iteration) => native_kernel/consider_index(iteration, index, bound, tree, ordering, prefix))
  return result
end

verb native_kernel/consider_index(builder: map, index: map, bound: map, tree: map, ordering: map, prefix: map) -> map
  let ready = native_gen/when(builder, native_kernel/absent(index), fn(arm) => native_gen/break_loop(arm))
  let [key, with_key] = native_gen/bind(ready, "key", native_kernel/load_field(ready, index, "mask"))
  ready = native_gen/unless(with_key, native_kernel/absent(key),
    fn(arm) => native_gen/when(arm, native_kernel/covers_columns(bound, key),
      fn(selected) => native_kernel/select_index(selected, index, key, tree, ordering, prefix)))
  let result: map = native_gen/assign(ready, index, native_kernel/load_field(ready, index, "next"))
  return result
end

verb native_kernel/select_index(builder: map, index: map, key: map, tree: map, ordering: map, prefix: map) -> map
  let ready = native_gen/assign(builder, prefix, key)
  ready = native_gen/assign(ready, ordering, key)
  ready = native_gen/assign(ready, tree, native_kernel/load_field(ready, index, "tree"))
  let result: map = native_gen/break_loop(ready)
  return result
end

// Capacity exhaustion means there is another matching row. Merely filling
// the buffer does not establish that, including when capacity is zero.
verb native_kernel/scan_full(builder: map, scan: map) -> map
  let ready = native_kernel/store_field(builder, scan, "more", native_gen/ref(builder, "true"))
  let result: map = native_kernel/status(ready, "kernel_ok")
  return result
end

verb native_kernel/scan_offer(builder: map, scan: map, row: map) -> map
  let [count, ready] = native_gen/bind(builder, "count", native_kernel/load_field(builder, scan, "count"))
  ready = native_gen/when(ready, native_gen/equal(count, native_kernel/load_field(ready, scan, "capacity")),
    fn(arm) => native_kernel/scan_full(arm, scan))
  let [appended: map, with_rows: map] = native_query/value(ready, "kernel_query_append", [native_roots/worker(ready), native_kernel/load_field(ready, scan, "rows"), row])
  ready = native_kernel/store_field(with_rows, scan, "rows", appended)
  let result: map = native_kernel/store_field(ready, scan, "count", native_gen/add(count, native_gen/ref(ready, "one")))
  return result
end

verb native_kernel/scan_compare(builder: map, row: map, scan: map, mask_field: string, projection: bool, target: string) -> map
  let mask = native_kernel/load_field(builder, scan, mask_field)
  let order = native_kernel/tuple_order(mask)
  if projection
    order = native_kernel/tuple_projection(mask)
  end
  let result: map = native_kernel/compare_rows(builder, row, native_gen/root_read(native_gen/field(builder, scan, target)), order)
  return result
end

verb native_kernel/update_index(builder: map, index: map, tail: map) -> map
  let call = native_gen/call(builder, "kernel_set", [native_gen/ref(builder, "worker"),
    native_kernel/load_field(builder, index, "tree"), native_gen/ref(builder, "row"),
    native_kernel/load_field(builder, index, "mask"), native_gen/negate(native_gen/ref(builder, "asserted")), native_gen/ref(builder, "true")])
  let [updated, ready] = native_gen/checked_bind(builder, "updated", call, "ok",
    fn(arm) => native_gen/return_value(arm, native_gen/zero(native_kernel/pointer("Index"))))
  let result: map = native_gen/return_value(ready, native_kernel/replace_record(ready, native_gen/ref(ready, "worker"), "Index", index,
    {"next" -> tail, "tree" -> native_gen/field(ready, updated, "node")}))
  return result
end

verb native_kernel/index_update_body(module: map) -> map
  let builder = native_gen/context(module, "kernel_index_update")
  builder = native_kernel/copy_chain(builder, "Index", native_gen/ref(builder, "index"), "index_update",
    [native_gen/ref(builder, "row"), native_gen/ref(builder, "asserted")],
    fn(ready, index, tail) => native_kernel/update_index(ready, index, tail))
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/apply_body(module: map) -> map
  let builder = native_gen/context(module, "kernel_apply")
  let relation = native_gen/ref(builder, "relation")
  let row = native_gen/ref(builder, "row")
  let asserted = native_gen/ref(builder, "asserted")
  let [existing, ready] = native_gen/bind(builder, "existing", native_kernel/find_row(builder, relation, row,
    native_kernel/tuple_order(native_gen/ref(builder, "zero"))))
  builder = native_gen/when(ready, native_gen/equal(native_kernel/absent(existing), native_gen/negate(asserted)),
    fn(arm) => native_gen/return_value(arm, relation))
  let [indexes, with_indexes] = native_gen/bind(builder, "indexes", native_gen/call(builder, "kernel_index_update",
    [native_gen/ref(builder, "worker"), native_kernel/load_field(builder, relation, "indexes"), row, asserted]))
  builder = native_gen/when(with_indexes, native_kernel/absent(indexes),
    fn(arm) => native_gen/return_value(arm, native_gen/zero(native_kernel/pointer("Relation"))))
  builder = native_gen/return_value(builder, native_kernel/replace_record(builder, native_gen/ref(builder, "worker"), "Relation", relation, {"indexes" -> indexes}))
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/offer_matching_row(builder: map, scan: map, row: map, past: map) -> map
  let [matched, ready] = native_gen/bind(builder, "match", native_kernel/scan_compare(builder, row, scan, "mask", true, "pattern"))
  let [matches, with_matches] = native_gen/bind(ready, "matches", native_kernel/absent(matched))
  ready = native_gen/unless(with_matches, native_gen/less(native_gen/ref(with_matches, "int_zero"), past),
    fn(arm) => native_gen/assign(arm, matches, native_gen/ref(arm, "false")))
  let completed: map = native_gen/when(ready, matches, fn(arm) => native_kernel/scan_offer(arm, scan, row))
  return completed
end

// Prefix comparison prunes the chosen index. Remaining bindings are filters;
// capacity bounds the result buffer and traversal stops at the next match.
verb native_kernel/scan_tree_body(module: map) -> map
  let builder = native_query/context(module, "kernel_scan_tree")
  let node = native_roots/ref(builder, "node")
  let scan = native_roots/ref(builder, "scan")
  builder = native_gen/when(builder, native_kernel/absent(node), fn(arm) => native_kernel/status(arm, "kernel_ok"))
  builder = native_gen/when(builder, native_kernel/load_field(builder, scan, "more"), fn(arm) => native_kernel/status(arm, "kernel_ok"))
  builder = native_query/poll_interval(builder, native_kernel/load_field(builder, scan, "visited"))
  builder = native_kernel/store_field(builder, scan, "visited", native_gen/add(native_kernel/load_field(builder, scan, "visited"), native_gen/ref(builder, "one")))
  let row: map = native_kernel/load_field(builder, node, "row")
  let with_row: map = builder
  let [past, with_past] = native_gen/bind(with_row, "past", native_gen/ref(with_row, "int_one"))
  let [updated, ready] = native_gen/bind(with_past, "after", native_gen/root_read(native_gen/field(with_past, scan, "after")))
  builder = native_gen/unless(ready, native_kernel/absent(updated),
    fn(arm) => native_gen/assign(arm, past, native_kernel/compare_rows(arm, row, updated,
      native_kernel/tuple_order(native_kernel/load_field(arm, scan, "order")))))
  let [order, with_order] = native_gen/bind(builder, "order", native_kernel/scan_compare(builder, row, scan, "prefix", true, "pattern"))
  builder = native_gen/unless(with_order, native_gen/less(order, native_gen/ref(with_order, "int_zero")),
    fn(arm) => native_gen/when(arm, native_gen/less(native_gen/ref(arm, "int_zero"), past),
      fn(before) => native_query/status_call(before, "kernel_scan_tree", [native_roots/worker(before), native_kernel/load_field(before, node, "left"), scan])))
  builder = native_gen/when(builder, native_kernel/load_field(builder, scan, "more"), fn(arm) => native_kernel/status(arm, "kernel_ok"))
  builder = native_gen/when(builder, native_kernel/absent(order), fn(arm) => native_kernel/offer_matching_row(arm, scan, row, past))
  builder = native_gen/unless(builder, native_gen/less(native_gen/ref(builder, "int_zero"), order),
    fn(arm) => native_query/status_call(arm, "kernel_scan_tree", [native_roots/worker(arm), native_kernel/load_field(arm, node, "right"), scan]))
  builder = native_kernel/status(builder, "kernel_ok")
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/scan_error(builder: map, status: string) -> map
  let result: map = native_roots/return_value(builder, native_gen/record(builder, [:Record, "KernelScanResult"],
    {"status" -> native_gen/ref(builder, status), "count" -> native_gen/ref(builder, "zero"),
      "visited" -> native_gen/ref(builder, "zero"), "more" -> native_gen/ref(builder, "false")}))
  return result
end

verb native_kernel/check_scan_mask(builder: map, relation: map, mask: map) -> map
  let arity = native_kernel/load_field(builder, relation, "arity")
  let result: map = native_kernel/check_column_mask(builder, arity, mask,
    fn(failed) => native_kernel/scan_error(failed, "kernel_schema"))
  return result
end

verb native_kernel/relation_scan_body(module: map) -> map
  let builder = native_query/context(module, "kernel_relation_scan")
  let relation = native_roots/ref(builder, "relation")
  let pattern = native_roots/ref(builder, "pattern")
  let updated = native_roots/ref(builder, "after")
  let mask = native_roots/ref(builder, "mask")
  let output = native_roots/ref(builder, "output")
  let capacity = native_roots/ref(builder, "capacity")
  builder = native_gen/when(builder, native_kernel/absent(relation), fn(arm) => native_kernel/scan_error(arm, "kernel_unknown"))
  builder = native_kernel/check_tuple(builder, pattern, relation, fn(arm) => native_kernel/scan_error(arm, "kernel_arity"))
  builder = native_gen/unless(builder, native_kernel/absent(updated),
    fn(arm) => native_kernel/check_tuple(arm, updated, relation, fn(failed) => native_kernel/scan_error(failed, "kernel_arity")))
  builder = native_kernel/check_scan_mask(builder, relation, mask)
  builder = native_gen/unless(builder, native_kernel/absent(capacity),
    fn(arm) => native_gen/when(arm, native_kernel/absent(output), fn(failed) => native_kernel/scan_error(failed, "kernel_schema")))
  let [tree, ordering, prefix, ready] = native_kernel/scan_plan(builder, relation, mask)
  let [rooted_tree: map, with_tree: map] = native_roots/retain(ready, "scan_tree", tree)
  let [empty: map, with_empty: map] = native_query/build_row(with_tree, native_roots/ref(with_tree, "zero"), fn(step, position) => native_gen/zero(native_value/word()))
  let [state: map, with_state: map] = native_rules/allocate(with_empty, "Scan",
    {"pattern" -> pattern, "after" -> updated, "order" -> ordering, "mask" -> mask, "prefix" -> prefix,
      "rows" -> empty, "capacity" -> capacity})
  let [scan: map, with_scan: map] = native_roots/retain(with_state, "scan_page", state)
  builder = native_query/status_call(with_scan, "kernel_scan_tree", [native_roots/worker(with_scan), rooted_tree, scan])
  let count: map = native_kernel/load_field(builder, scan, "count")
  // Charge and check cancellation before touching caller storage. No poll or
  // fallible operation occurs while copying the successful, rooted page.
  builder = native_query/charge(builder, count, native_roots/ref(builder, "zero"))
  builder = native_gen/for_range(builder, "output_index", native_roots/ref(builder, "zero"), count, fn(copy, index) => native_gen/root_write(copy, native_gen/location(native_gen/offset(output, index)), native_query/cell(copy, native_kernel/load_field(copy, scan, "rows"), index)))
  builder = native_roots/return_value(builder, native_gen/record(builder, [:Record, "KernelScanResult"],
    {"status" -> native_roots/ref(builder, "kernel_ok"), "count" -> count,
      "visited" -> native_kernel/load_field(builder, scan, "visited"), "more" -> native_kernel/load_field(builder, scan, "more")}))
  let result: map = native_gen/finish(module, builder)
  return result
end

// Copy only the prefix before the replacement. The private prefix is mutable
// until return; the untouched suffix remains shared with the source snapshot.
verb native_kernel/catalog_put_body(module: map) -> map
  let builder: map = native_rules/context(module, "catalog_put")
  let entry: map = native_roots/ref(builder, "entry")
  let [cursor: map, with_cursor: map] = native_roots/retain(builder, "cursor", native_roots/ref(builder, "head"))
  let [head: map, with_head: map] = native_roots/retain(with_cursor, "prefix", native_gen/zero(native_kernel/pointer("Relation")))
  let [tail: map, ready: map] = native_roots/retain(with_head, "tail", native_gen/zero(native_kernel/pointer("Relation")))
  builder = native_gen/while_loop(ready, native_gen/negate(native_kernel/absent(cursor)), fn(step)
    let checked: map = native_rules/tick(step)
    checked = native_gen/unless(checked, native_gen/less(native_kernel/load_field(checked, cursor, "id"), native_kernel/load_field(checked, entry, "id")), fn(done) => native_gen/break_loop(done))
    let [copy: map, copied: map] = native_gen/bind(checked, "copy", native_kernel/replace_record(checked, native_roots/worker(checked), "Relation", cursor, {"next" -> native_gen/zero(native_kernel/pointer("Relation"))}))
    checked = native_rules/check(copied, native_gen/negate(native_kernel/absent(copy)), "oom")
    checked = native_gen/branch(checked, native_kernel/absent(head),
      fn(first) => native_roots/store(first, head, copy),
      fn(next) => native_kernel/store_field(next, tail, "next", copy))
    checked = native_roots/store(checked, tail, copy)
    return native_roots/store(checked, cursor, native_kernel/load_field(checked, cursor, "next"))
  end)
  builder = native_gen/unless(builder, native_kernel/absent(cursor), fn(present)
    return native_gen/when(present, native_gen/equal(native_kernel/load_field(present, cursor, "id"), native_kernel/load_field(present, entry, "id")), fn(replaced) => native_roots/store(replaced, cursor, native_kernel/load_field(replaced, cursor, "next")))
  end)
  builder = native_rules/tick(builder)
  let [inserted: map, allocated: map] = native_gen/bind(builder, "inserted", native_kernel/replace_record(builder, native_roots/worker(builder), "Relation", entry, {"next" -> cursor}))
  builder = native_rules/check(allocated, native_gen/negate(native_kernel/absent(inserted)), "oom")
  builder = native_gen/branch(builder, native_kernel/absent(head), fn(first) => native_roots/store(first, head, inserted), fn(last) => native_kernel/store_field(last, tail, "next", inserted))
  builder = native_rules/result(builder, native_roots/ref(builder, "kernel_ok"), {"relation" -> head})
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/relations(input: map) -> map
  let context: map = input
  let relation: list = native_kernel/pointer("Relation")
  let index: list = native_kernel/pointer("Index")
  let node: list = native_kernel/pointer("Node")
  let word: list = native_value/word()
  let worker: list = ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]
  let scan: list = native_kernel/pointer("Scan")
  for spec in [
    ["relation", relation, [["head", relation, :Gc], ["id", :U64, :Value]]],
    ["named", relation, [["head", relation, :Gc], ["name", :U64, :Value]]],
    ["catalog_put", [:Record, "KernelRelationResult"], [worker, ["head", relation, :Gc], ["entry", relation, :Gc], ["budget", native_kernel/pointer("Budget"), :Borrow]]],
    ["index", node, [["relation", relation, :Gc], ["mask", :U64, :Value]]],
    ["index_update", index, [worker, ["index", index, :Gc], ["row", word, :Gc], ["asserted", :Bool, :Value]]],
    ["apply", relation, [worker, ["relation", relation, :Gc], ["row", word, :Gc], ["asserted", :Bool, :Value]]],
    ["scan_tree", :U64, [worker, ["node", node, :Gc], ["scan", scan, :Gc], ["budget", native_kernel/pointer("Budget"), :Borrow]]],
    ["relation_scan", [:Record, "KernelScanResult"], [worker, ["relation", relation, :Gc], ["pattern", word, :Gc],
      ["mask", :U64, :Value], ["after", word, :Gc], ["output", native_memory/pointer(word), :Borrow], ["capacity", :U64, :Value], ["budget", native_kernel/pointer("Budget"), :Borrow]]]]
    context = native_kernel/declare(context, spec[0], spec[1], spec[2], native/contains(["scan_tree", "relation_scan", "catalog_put"], spec[0]))
  end
  for field in ["id", "name"]
    let name: string = "relation"
    if field == "name"
      name = "named"
    end
    context = native_kernel/define(context, name, [
      @native_kernel/walk("Relation", "cursor", "head", [
        native/when_statement(native_kernel/binary(:Equal, native_kernel/read("Relation", "cursor", field), field), [native/return_value("cursor")])],
        [native/return_value("cursor")]), native/return_value(native_kernel/null("Relation"))])
  end
  context = native_kernel/catalog_put_body(context)
  context = native_kernel/define(context, "index", [
    native/when_statement(native_kernel/is_null("Relation", "relation"), [native/return_value(native_kernel/null("Node"))]),
    @native_kernel/walk("Index", "cursor", native_kernel/read("Relation", "relation", "indexes"), [
      native/when_statement(native_kernel/binary(:Equal, native_kernel/read("Index", "cursor", "mask"), "mask"), [native/return_value(native_kernel/read("Index", "cursor", "tree"))])],
      [native/return_value(native_kernel/null("Node"))]), native/return_value(native_kernel/null("Node"))])
  context = native_kernel/index_update_body(context)
  context = native_kernel/apply_body(context)
  context = native_kernel/scan_tree_body(context)
  context = native_kernel/relation_scan_body(context)
  return context
end
