verb native_kernel/shared_root() -> list
  let result: list = native/typed_expression(native_memory/record_pointer("MemoryRoot"), native/field_pointer_expression("kernel", "current"))
  return result
end

verb native_kernel/empty_indexes_body(module: map) -> map
  let builder: map = native_gen/context(module, "kernel_empty_indexes")
  builder = native_kernel/copy_chain(builder, "Index", native_gen/ref(builder, "index"), "empty_indexes", [],
    fn(ready, index, tail) => native_gen/return_value(ready, native_kernel/replace_record(ready,
      native_gen/ref(ready, "worker"), "Index", index, {"next" -> tail, "tree" -> native_gen/zero(native_kernel/pointer("Node"))})))
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/snapshot_slot(builder: map, kernel: map) -> map
  let root: map = native_gen/field(builder, kernel, "current")
  let result: map = native_gen/field(builder, root[:pointer], "pointer")
  return result
end

verb native_kernel/reload_work(builder: map, transaction: map, work: map) -> map
  let result: map = native_gen/assign(builder, work, native_gen/call(builder, "kernel_work", [transaction]))
  return result
end

verb native_kernel/discard_candidate(builder: map, work: map) -> map
  let ready: map = native_kernel/store_field(builder, work, "candidate", native_gen/zero(native_kernel/pointer("Snapshot")))
  let result: map = native_kernel/store_field(ready, work, "deltas", native_gen/zero(native_kernel/pointer("Delta")))
  return result
end

verb native_kernel/unlock_kernel(builder: map, kernel: map) -> map
  let result: map = native_gen/do_call(builder, "memory_unlock", [native_kernel/load_field(builder, kernel, "mutex")])
  return result
end

verb native_kernel/commit_oom(builder: map, work: map) -> map
  let ready: map = native_kernel/discard_candidate(builder, work)
  ready = native_kernel/store_field(ready, work, "status", native_gen/ref(ready, "kernel_oom"))
  let result: map = native_kernel/status(ready, "kernel_oom")
  return result
end

verb native_kernel/commit_collision(builder: map, work: map, id: map) -> map
  let ready: map = native_kernel/store_field(builder, work, "status", native_gen/ref(builder, "kernel_conflict"))
  ready = native_kernel/store_field(ready, work, "conflict_relation", id)
  ready = native_kernel/store_field(ready, work, "deltas", native_gen/zero(native_kernel/pointer("Delta")))
  let result: map = native_kernel/status(ready, "kernel_conflict")
  return result
end

verb native_kernel/commit_unchanged(builder: map, kernel: map, work: map, current: map) -> map
  let ready: map = native_kernel/store_field(builder, work, "candidate", current)
  ready = native_kernel/store_field(ready, work, "done", native_gen/ref(ready, "true"))
  ready = native_kernel/unlock_kernel(ready, kernel)
  let result: map = native_kernel/status(ready, "kernel_ok")
  return result
end

verb native_kernel/commit_new_relation(builder: map, worker: map, work: map, catalog: map, updated: map, id: map, entry: map) -> map
  let ready: map = native_gen/unless(builder, native_kernel/absent(entry), fn(arm) => native_kernel/commit_collision(arm, work, id))
  ready = native_gen/unless(ready, native_kernel/absent(native_gen/call(ready, "kernel_named",
    [catalog, native_kernel/load_field(ready, updated, "name")])), fn(arm) => native_kernel/commit_collision(arm, work, id))
  let [empty: map, with_empty: map] = native_gen/bind(ready, "empty", native_gen/call(ready, "kernel_empty_indexes",
    [worker, native_kernel/load_field(ready, updated, "indexes")]))
  ready = native_gen/when(with_empty, native_kernel/absent(empty), fn(arm) => native_kernel/commit_oom(arm, work))
  ready = native_gen/assign(ready, entry, native_kernel/replace_record(ready, worker, "Relation", updated,
    {"next" -> native_gen/zero(native_kernel/pointer("Relation")), "id" -> id, "indexes" -> empty}))
  let result: map = native_gen/when(ready, native_kernel/absent(entry), fn(arm) => native_kernel/commit_oom(arm, work))
  return result
end

verb native_kernel/commit_validation_failed(builder: map, work: map) -> map
  let ready: map = native_kernel/store_field(builder, work, "deltas", native_gen/zero(native_kernel/pointer("Delta")))
  let result: map = native_kernel/status(ready, "kernel_conflict")
  return result
end

verb native_kernel/commit_change(builder: map, worker: map, work: map, catalog: map, change: map) -> map
  let ready: map = native_gen/when(builder, native_kernel/absent(change), fn(arm) => native_gen/break_loop(arm))
  let [before: map, with_before: map] = native_gen/bind(ready, "before", native_kernel/load_field(ready, change, "before"))
  let [updated: map, with_after: map] = native_gen/bind(with_before, "after", native_kernel/load_field(with_before, change, "after"))
  let [id: map, with_id: map] = native_gen/bind(with_after, "id", native_kernel/load_field(with_after, updated, "id"))
  let [entry: map, with_entry: map] = native_gen/bind(with_id, "entry", native_gen/call(with_id, "kernel_relation", [catalog, id]))
  ready = native_gen/branch(with_entry, native_kernel/absent(before),
    fn(arm) => native_kernel/commit_new_relation(arm, worker, work, catalog, updated, id, entry),
    fn(arm) => native_gen/unless(arm, native_gen/call(arm, "kernel_validate",
      [work, native_kernel/load_field(arm, change, "writes"), before, entry]),
      fn(failed) => native_kernel/commit_validation_failed(failed, work)))
  ready = native_kernel/apply_write_phases(ready, worker, work, entry, native_kernel/load_field(ready, change, "writes"), before,
    fn(failed) => native_kernel/commit_oom(failed, work))
  ready = native_gen/assign(ready, catalog, native_gen/call(ready, "kernel_catalog_put", [worker, catalog, entry]))
  ready = native_gen/when(ready, native_kernel/absent(catalog), fn(arm) => native_kernel/commit_oom(arm, work))
  let result: map = native_gen/assign(ready, change, native_kernel/load_field(ready, change, "next"))
  return result
end

// Preparation reads a rooted snapshot and builds private persistent paths.
// Repeating it against a winner revalidates the original transaction policies
// and reconstructs net deltas without dropping unrelated committed writes.
verb native_kernel/prepare_body(module: map) -> map
  let builder: map = native_gen/context(module, "kernel_prepare")
  let transaction: map = native_gen/ref(builder, "transaction")
  let [work: map, opened: map] = native_kernel/open_transaction(builder, fn(arm) => native_kernel/status(arm, "kernel_closed"))
  let [worker: map, with_worker: map] = native_gen/bind(opened, "worker", native_kernel/load_field(opened, transaction, "worker"))
  builder = native_kernel/store_field(with_worker, work, "status", native_gen/ref(with_worker, "kernel_ok"))
  builder = native_kernel/store_field(builder, work, "conflict_relation", native_gen/ref(builder, "zero"))
  builder = native_kernel/store_field(builder, work, "conflict_tuple", native_gen/zero(native_value/word()))
  builder = native_kernel/discard_candidate(builder, work)
  let [current: map, with_current: map] = native_gen/bind(builder, "current", native_kernel/load_field(builder, work, "checked"))
  let [change: map, with_change: map] = native_gen/bind(with_current, "change", native_kernel/load_field(with_current, work, "changes"))
  let [catalog: map, with_catalog: map] = native_gen/bind(with_change, "catalog", native_kernel/load_field(with_change, current, "relations"))
  builder = native_gen/while_loop(with_catalog, native_gen/ref(with_catalog, "true"),
    fn(iteration) => native_kernel/commit_change(iteration, worker, work, catalog, change))
  let [candidate: map, with_candidate: map] = native_gen/bind(builder, "candidate", native_kernel/allocate_record(builder, worker, "Snapshot",
    {"version" -> native_gen/add(native_kernel/load_field(builder, current, "version"), native_gen/ref(builder, "one")), "relations" -> catalog}))
  builder = native_gen/when(with_candidate, native_kernel/absent(candidate), fn(arm) => native_kernel/commit_oom(arm, work))
  builder = native_kernel/store_field(builder, work, "candidate", candidate)
  builder = native_kernel/status(builder, "kernel_ok")
  let result: map = native_gen/finish(module, builder)
  return result
end

// A safepoint or a wait for the kernel lock can relocate the transaction.
// Reload work through its registered root before reading managed fields.
verb native_kernel/poll_commit(builder: map, transaction: map, worker: map, work: map) -> map
  let [polled: map, with_poll: map] = native_gen/bind(builder, "polled", native_gen/call(builder, "memory_safepoint", [worker, native_gen/ref(builder, "false")]))
  let ready: map = native_kernel/reload_work(with_poll, transaction, work)
  ready = native_gen/unless(ready, polled, fn(arm) => native_kernel/commit_oom(arm, work))
  return ready
end

// Retain the current snapshot under the lock, then release the lock before preparation.
verb native_kernel/capture_commit_snapshot(builder: map, transaction: map, worker: map, kernel: map, work: map) -> map
  let ready: map = native_gen/unless(builder, native_gen/call(builder, "kernel_lock", [kernel, worker]), fn(arm) => native_kernel/status(arm, "kernel_closed"))
  ready = native_kernel/reload_work(ready, transaction, work)
  let [raw: map, with_raw: map] = native_gen/bind(ready, "raw", native_gen/root_read(native_kernel/snapshot_slot(ready, kernel)))
  let [current: map, with_current: map] = native_gen/bind(with_raw, "current", native_gen/cast(native_kernel/pointer("Snapshot"), raw))
  ready = native_kernel/store_field(with_current, work, "checked", current)
  ready = native_gen/when(ready, native_kernel/absent(native_kernel/load_field(ready, work, "changes")),
    fn(arm) => native_kernel/commit_unchanged(arm, kernel, work, current))
  ready = native_kernel/unlock_kernel(ready, kernel)
  return ready
end

verb native_kernel/prepare_commit_candidate(builder: map, transaction: map, worker: map, work: map) -> map
  let [status: map, with_status: map] = native_gen/bind(builder, "status", native_gen/call(builder, "kernel_prepare", [transaction]))
  let ready: map = native_gen/unless(with_status, native_gen/equal(status, native_gen/ref(with_status, "kernel_ok")),
    fn(failed) => native_gen/return_value(failed, status))
  let [prepared: map, with_prepared: map] = native_gen/bind(ready, "prepared", native_gen/call(ready, "memory_share",
    [worker, native_gen/cast(native_memory/pointer(:U8), native_kernel/load_field(ready, work, "candidate"))]))
  ready = native_gen/when(with_prepared, native_kernel/absent(prepared), fn(arm) => native_kernel/commit_oom(arm, work))
  ready = native_kernel/store_field(ready, work, "candidate", native_gen/cast(native_kernel/pointer("Snapshot"), prepared))
  return ready
end

verb native_kernel/publish_commit_candidate(builder: map, transaction: map, work: map) -> map
  let [published: map, with_published: map] = native_gen/bind(builder, "published", native_gen/call(builder, "kernel_try_publish", [transaction]))
  let ready: map = native_kernel/reload_work(with_published, transaction, work)
  ready = native_gen/when(ready, published, fn(winner) => native_kernel/status(winner, "kernel_ok"))
  let result: map = native_kernel/discard_candidate(ready, work)
  return result
end

// These builders emit one attempt. A lost publication falls through to the next
// attempt; success, conflict, and allocation failure return from the generated commit.
verb native_kernel/commit_attempt(builder: map, transaction: map, worker: map, kernel: map, work: map) -> map
  let ready: map = native_kernel/poll_commit(builder, transaction, worker, work)
  ready = native_kernel/capture_commit_snapshot(ready, transaction, worker, kernel, work)
  ready = native_kernel/prepare_commit_candidate(ready, transaction, worker, work)
  let result: map = native_kernel/publish_commit_candidate(ready, transaction, work)
  return result
end

verb native_kernel/try_publish_body(module: map) -> map
  let builder: map = native_gen/context(module, "kernel_try_publish")
  let transaction: map = native_gen/ref(builder, "transaction")
  let [worker: map, with_worker: map] = native_gen/bind(builder, "worker", native_kernel/load_field(builder, transaction, "worker"))
  let [kernel: map, with_kernel: map] = native_gen/bind(with_worker, "kernel", native_kernel/load_field(with_worker, transaction, "kernel"))
  builder = native_gen/unless(with_kernel, native_gen/call(with_kernel, "kernel_lock", [kernel, worker]),
    fn(closed) => native_gen/return_value(closed, native_gen/ref(closed, "false")))
  let [work: map, with_work: map] = native_gen/bind(builder, "work", native_gen/call(builder, "kernel_work", [transaction]))
  let [raw: map, with_raw: map] = native_gen/bind(with_work, "raw", native_gen/root_read(native_kernel/snapshot_slot(with_work, kernel)))
  let current: map = native_gen/cast(native_kernel/pointer("Snapshot"), raw)
  builder = native_gen/unless(with_raw, native_gen/equal(current, native_kernel/load_field(with_raw, work, "checked")), fn(lost)
    let unlocked = native_kernel/unlock_kernel(lost, kernel)
    return native_gen/return_value(unlocked, native_gen/ref(unlocked, "false"))
  end)
  let [heap: map, with_heap: map] = native_gen/bind(builder, "heap", native_kernel/load_field(builder, kernel, "heap"))
  let [mutex: map, with_mutex: map] = native_gen/bind(with_heap, "heap_mutex", native_kernel/load_field(with_heap, heap, "mutex"))
  builder = native_gen/do_call(with_mutex, "memory_lock", [mutex])
  builder = native_gen/root_write(builder, native_kernel/snapshot_slot(builder, kernel),
    native_gen/cast(native_memory/pointer(:U8), native_kernel/load_field(builder, work, "candidate")))
  builder = native_gen/do_call(builder, "memory_unlock", [mutex])
  builder = native_kernel/store_field(builder, work, "done", native_gen/ref(builder, "true"))
  builder = native_kernel/unlock_kernel(builder, kernel)
  builder = native_gen/return_value(builder, native_gen/ref(builder, "true"))
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/commit_body(module: map) -> map
  let builder: map = native_gen/context(module, "kernel_commit")
  let transaction: map = native_gen/ref(builder, "transaction")
  let [work: map, opened: map] = native_kernel/open_transaction(builder, fn(arm) => native_kernel/status(arm, "kernel_closed"))
  let [worker: map, with_worker: map] = native_gen/bind(opened, "worker", native_kernel/load_field(opened, transaction, "worker"))
  let [kernel: map, with_kernel: map] = native_gen/bind(with_worker, "kernel", native_kernel/load_field(with_worker, transaction, "kernel"))
  builder = native_gen/for_range(with_kernel, "attempt", native_gen/ref(with_kernel, "zero"), native_gen/ref(with_kernel, "kernel_64"),
    fn(body, attempt) => native_kernel/commit_attempt(body, transaction, worker, kernel, work))
  builder = native_kernel/store_field(builder, work, "status", native_gen/ref(builder, "kernel_conflict"))
  builder = native_kernel/status(builder, "kernel_conflict")
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/lifecycle(input: map) -> map
  let context: map = input
  let kernel: list = native_memory/record_pointer("Kernel")
  let worker: list = native_memory/record_pointer("MemoryWorker")
  let heap: list = native_memory/record_pointer("MemoryHeap")
  let root: list = native_memory/record_pointer("MemoryRoot")
  let bytes: list = native_memory/pointer(:U8)
  let tx: list = native_kernel/pointer("Transaction")
  let work: list = native_kernel/pointer("Work")
  let snapshot: list = native_kernel/pointer("Snapshot")
  let relation: list = native_kernel/pointer("Relation")
  let change: list = native_kernel/pointer("Change")
  let index: list = native_kernel/pointer("Index")
  let word: list = native_value/word()
  for spec in [
    ["heap_init", :Bool, [["heap", heap, :Borrow]], false],
    ["lock", :Bool, [["kernel", kernel, :Borrow], ["worker", worker, :Borrow]], true],
    ["init", :Bool, [["kernel", kernel, :Borrow], ["worker", worker, :Borrow]], true],
    ["release", :Bool, [["kernel", kernel, :Borrow], ["worker", worker, :Borrow]], false],
    ["begin", :U64, [["kernel", kernel, :Borrow], ["worker", worker, :Borrow], ["transaction", tx, :Borrow]], true],
    ["end", :Bool, [["transaction", tx, :Borrow]], false],
    ["commit", :U64, [["transaction", tx, :Borrow]], true],
    ["prepare", :U64, [["transaction", tx, :Borrow]], false],
    ["try_publish", :Bool, [["transaction", tx, :Borrow]], true],
    ["empty_indexes", index, [["worker", worker, :Borrow], ["index", index, :Gc]], false]]
    context = native_kernel/declare(context, spec[0], spec[1], spec[2], spec[3])
  end
  context = native_kernel/define(context, "heap_init", [
    native/return_value(native/call_expression("memory_heap_init", ["heap", native/typed_expression([:FunctionPointer, "MemoryTrace"], native/function_address_expression("kernel_trace"))]))])
  context = native_kernel/define(context, "lock", [
    native/unless_statement(native/call_expression("memory_leave", ["worker"]), [native/return_value("false")]),
    native_memory/call("memory_lock", [native_memory/field(bytes, "kernel", "mutex")]),
    native/return_value(native/call_expression("memory_enter", ["worker"]))])
  let unlock: list = [native_memory/call("memory_unlock", [native_memory/field(bytes, "kernel", "mutex")])]
  context = native_kernel/define(context, "init", [
    native/unless_statement(native_kernel/binary(:Equal, native_memory/field(bytes, "kernel", "mutex"), "null_bytes"), [native/return_value("false")]),
    native/let_call("mutex", bytes, "memory_sync_create", []),
    native/when_statement(native_kernel/binary(:Equal, "mutex", "null_bytes"), [native/return_value("false")]),
    native/let_statement("slot", native_memory/pointer(bytes), native/field_pointer_expression("kernel", "mutex")),
    native/let_statement("adopted", bytes, native/binary_expression(:Adopt, "slot", "mutex")),
    native_memory/store_root(heap, "kernel", "heap", native/typed_expression(heap, native/manage_expression(native_memory/field(heap, "worker", "heap")))),
    native/let_statement("snapshot", snapshot, native_kernel/construct("Snapshot", {"version" -> "zero", "relations" -> native_kernel/null("Relation")})),
    native/when_statement(native_kernel/is_null("Snapshot", "snapshot"), [
      native_memory/call("memory_sync_destroy", ["mutex"]), native_memory/store(bytes, "kernel", "mutex", "null_bytes"), native/return_value("false")]),
    native/let_statement("storage", [:Record, "MemoryRoot"], native/zero_expression()),
    native/let_statement("source", root, native/unary_expression(:Address, "storage")),
    native_memory/store_root(bytes, "source", "pointer", native/typed_expression(bytes, native/unary_expression(:PointerCast, "snapshot"))),
    native/let_call("pushed", :Bool, "memory_root_push", ["worker", "source"]),
    native/let_call("ok", :Bool, "memory_publish", ["worker", "source", native_kernel/shared_root()]),
    native/let_call("popped", :Bool, "memory_root_pop", ["worker", "source"]),
    native/unless_statement("ok", [native_memory/call("memory_sync_destroy", ["mutex"]), native_memory/store(bytes, "kernel", "mutex", "null_bytes")]),
    native/return_value("ok")])
  // Release requires exclusive ownership of the control object. Transactions
  // must be ended first; snapshots remain managed and are reclaimed by GC.
  context = native_kernel/define(context, "release", [
    native/unless_statement(native/call_expression("memory_unpublish", ["worker", native_kernel/shared_root()]), [native/return_value("false")]),
    native_memory/call("memory_sync_destroy", [native_memory/field(bytes, "kernel", "mutex")]),
    native/store_statement("kernel", native/typed_zero([:Record, "Kernel"])), native/return_value("true")])
  context = native_kernel/define(context, "begin", [
    native/unless_statement(native_kernel/binary(:Equal, native_memory/field(:U64, native_kernel/transaction_root(), "registration"), "zero"), [native/return_value("kernel_closed")]),
    native/unless_statement(native_kernel/binary(:Equal, native_memory/field(heap, "worker", "heap"), native_memory/field(heap, "kernel", "heap")), [native/return_value("kernel_schema")]),
    native/unless_statement(native/call_expression("kernel_lock", ["kernel", "worker"]), [native/return_value("kernel_closed")]),
    native/let_statement("current", bytes, native_memory/root(bytes, native_kernel/shared_root(), "pointer")),
    native/let_statement("base", snapshot, native/unary_expression(:PointerCast, "current")),
    @unlock,
    native/let_statement("work", work, native_kernel/construct("Work", {"base" -> "base", "checked" -> "base", "changes" -> native_kernel/null("Change"), "candidate" -> native_kernel/null("Snapshot"), "deltas" -> native_kernel/null("Delta"), "status" -> "kernel_ok", "conflict_relation" -> "zero", "conflict_tuple" -> native/typed_zero(word), "done" -> "false"})),
    native/when_statement(native_kernel/is_null("Work", "work"), [native/return_value("kernel_oom")]),
    native_memory/store_root(kernel, "transaction", "kernel", native/typed_expression(kernel, native/manage_expression("kernel"))), native_memory/store_root(worker, "transaction", "worker", native/typed_expression(worker, native/manage_expression("worker"))),
    native_memory/store_root(bytes, native_kernel/transaction_root(), "pointer", native/typed_expression(bytes, native/unary_expression(:PointerCast, "work"))),
    native/let_call("pushed", :Bool, "memory_root_push", ["worker", native_kernel/transaction_root()]),
    native/return_value("kernel_ok")])
  context = native_kernel/define(context, "end", [
    native/let_statement("worker", worker, native_memory/field(worker, "transaction", "worker")),
    native/when_statement(native_kernel/binary(:Equal, "worker", "memory_null_worker"), [native/return_value("false")]),
    native/unless_statement(native/call_expression("memory_root_pop", ["worker", native_kernel/transaction_root()]), [native/return_value("false")]),
    native/store_statement("transaction", native/typed_zero([:Record, "KernelTransaction"])), native/return_value("true")])
  context = native_kernel/empty_indexes_body(context)
  context = native_kernel/prepare_body(context)
  context = native_kernel/try_publish_body(context)
  context = native_kernel/commit_body(context)
  return context
end
