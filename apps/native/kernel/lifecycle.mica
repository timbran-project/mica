verb native_kernel/shared_root() -> list
  let result: list = native/typed_expression(native_memory/record_pointer("MemoryRoot"), native/field_pointer_expression("kernel", "current"))
  return result
end

verb native_kernel/empty_indexes_body(module: map) -> map
  let builder: map = native_gen/context(module, "kernel_empty_indexes")
  builder = native_kernel/copy_chain(builder, "Index", native_gen/ref(builder, "index"), "empty_indexes", [],
    fn(ready, index, tail) => native_gen/return_value(ready, native_kernel/replace_record(ready,
      native_gen/ref(ready, "worker"), "Index", index, {"next" -> tail, "tree" -> native_gen/zero(native_kernel/pointer("Node"))})))
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/snapshot_slot(builder: map, kernel: map) -> map
  let root: map = native_gen/field(builder, kernel, "current")
  let result: map = native_gen/field(builder, root[:pointer], "pointer")
  return result
end

verb native_kernel/reload_work(builder: map, transaction: map, work: map) -> map
  let result: map = native_gen/assign(builder, work, native_gen/call(builder, "kernel_work", [transaction]))
  return result
end

verb native_kernel/discard_candidate(builder: map, work: map) -> map
  let ready: map = native_kernel/store_field(builder, work, "candidate", native_gen/zero(native_kernel/pointer("Snapshot")))
  let result: map = native_kernel/store_field(ready, work, "deltas", native_gen/zero(native_kernel/pointer("Delta")))
  return result
end

verb native_kernel/unlock_kernel(builder: map, kernel: map) -> map
  let result: map = native_gen/do_call(builder, "memory_unlock", [native_kernel/load_field(builder, kernel, "mutex")])
  return result
end

verb native_kernel/commit_oom(builder: map, work: map) -> map
  let ready: map = native_kernel/discard_candidate(builder, work)
  ready = native_kernel/store_field(ready, work, "status", native_gen/ref(ready, "kernel_oom"))
  let result: map = native_kernel/status(ready, "kernel_oom")
  return result
end

verb native_kernel/commit_unchanged(builder: map, kernel: map, work: map, current: map) -> map
  let signal: map = native_kernel/load_field(builder, native_gen/ref(builder, "transaction"), "signal")
  let claimed: map = native_gen/call(builder, "memory_atomic_compare_exchange", [signal, native_gen/ref(builder, "zero"), native_gen/ref(builder, "two")])
  let checked: map = native_gen/unless(builder, claimed, fn(cancelled)
    let failed: map = native_kernel/store_field(cancelled, work, "status", native_gen/ref(cancelled, "kernel_cancelled"))
    return native_kernel/status(native_kernel/unlock_kernel(failed, kernel), "kernel_cancelled")
  end)
  let ready: map = native_kernel/store_field(checked, work, "candidate", current)
  ready = native_kernel/store_field(ready, work, "done", native_gen/ref(ready, "true"))
  ready = native_kernel/unlock_kernel(ready, kernel)
  let result: map = native_kernel/status(ready, "kernel_ok")
  return result
end

verb native_kernel/prepare_relation(builder: map, worker: map, work: map, updated: map, id: map, entry: map) -> map
  let [empty: map, with_empty: map] = native_gen/bind(builder, "empty", native_gen/call(builder, "kernel_empty_indexes",
    [worker, native_kernel/load_field(builder, updated, "indexes")]))
  let ready: map = native_rules/check(with_empty, native_gen/negate(native_kernel/absent(empty)), "oom")
  ready = native_roots/store(ready, entry, native_kernel/replace_record(ready, worker, "Relation", updated,
    {"next" -> native_gen/zero(native_kernel/pointer("Relation")), "id" -> id, "schema_revision" -> native_gen/add(native_kernel/load_field(ready, native_kernel/load_field(ready, work, "checked"), "version"), native_gen/ref(ready, "one")), "indexes" -> empty}))
  let result: map = native_rules/check(ready, native_gen/negate(native_kernel/absent(entry)), "oom")
  return result
end

// Locate the target and validate new names in one interruptible catalogue walk.
verb native_kernel/prepare_lookup(builder: map, work: map, catalog: map, before: map, updated: map, entry: map) -> map
  let id: map = native_kernel/load_field(builder, updated, "id")
  let result: map = native_rules/each(builder, "relation", catalog, fn(step, relation)
    let ready: map = native_gen/when(step, native_gen/equal(native_kernel/load_field(step, relation, "id"), id), fn(found) => native_roots/store(found, entry, relation))
    ready = native_gen/when(ready, native_kernel/absent(before), fn(declaration)
      let checked: map = native_gen/unless(declaration, native_kernel/absent(entry), fn(duplicate)
        let failed: map = native_kernel/store_field(duplicate, work, "conflict_relation", id)
        return native_rules/error(failed, "conflict")
      end)
      return native_gen/when(checked, native_gen/equal(native_kernel/load_field(checked, relation, "name"), native_kernel/load_field(checked, updated, "name")), fn(duplicate)
        let failed: map = native_kernel/store_field(duplicate, work, "conflict_relation", id)
        return native_rules/error(failed, "conflict")
      end)
    end)
    return native_gen/unless(ready, native_kernel/absent(entry), fn(found) => native_gen/break_loop(found))
  end)
  return result
end

verb native_kernel/prepare_change(builder: map, worker: map, work: map, catalog: map, change: map) -> map
  let before: map = native_kernel/load_field(builder, change, "before")
  let updated: map = native_kernel/load_field(builder, change, "after")
  let [entry: map, ready: map] = native_roots/retain(builder, "entry", native_gen/zero(native_kernel/pointer("Relation")))
  ready = native_kernel/prepare_lookup(ready, work, catalog, before, updated, entry)
  ready = native_gen/branch(ready, native_kernel/absent(before),
    fn(declaration) => native_kernel/prepare_relation(declaration, worker, work, updated, native_kernel/load_field(declaration, updated, "id"), entry),
    fn(existing) => native_rules/status_call(existing, "validate", [worker, work, native_kernel/load_field(existing, change, "writes"), before, entry, native_roots/ref(existing, "budget")]))
  ready = native_kernel/apply_write_phases(ready, worker, work, entry, native_kernel/load_field(ready, change, "writes"), before)
  let [updated_catalog: map, replaced: map] = native_rules/checked_call(ready, "catalog_put", [worker, catalog, entry, native_roots/ref(ready, "budget")], "relation")
  ready = native_roots/store(replaced, catalog, updated_catalog)
  let result: map = native_rules/release_root(ready, entry)
  return result
end

verb native_kernel/prepare_catalog_body(module: map) -> map
  let builder: map = native_rules/context(module, "prepare_catalog")
  let work: map = native_roots/ref(builder, "work")
  let [catalog: map, ready: map] = native_roots/retain(builder, "catalog", native_kernel/load_field(builder, native_roots/ref(builder, "current"), "relations"))
  builder = native_rules/each(ready, "change", native_kernel/load_field(ready, work, "changes"), fn(step, change)
    return native_kernel/prepare_change(step, native_roots/worker(step), work, catalog, change)
  end)
  builder = native_rules/result(builder, native_roots/ref(builder, "kernel_ok"), {"relation" -> catalog})
  let result: map = native_gen/finish(module, builder)
  return result
end

// Every failed preparation drops all private publication state together.
verb native_kernel/prepare_failed(builder: map, work: map, status: map) -> map
  let ready: map = native_kernel/discard_candidate(builder, work)
  ready = native_kernel/store_field(ready, work, "status", status)
  let result: map = native_roots/return_value(ready, status)
  return result
end

// Preparation reads a rooted snapshot and builds private persistent paths.
// Repeating it against a winner revalidates the original transaction policies
// and reconstructs net deltas without dropping unrelated committed writes.
verb native_kernel/prepare_body(module: map) -> map
  let builder: map = native_gen/context(module, "kernel_prepare")
  let transaction: map = native_gen/ref(builder, "transaction")
  let [unrooted_work: map, opened: map] = native_kernel/open_transaction(builder, fn(arm) => native_kernel/status(arm, "kernel_closed"))
  let scoped: map = native_roots/open_scope(opened, fn(failed, reason) => native_kernel/status(failed, string_concat("kernel_", reason)))
  let [work: map, with_worker: map] = native_roots/retain(scoped, "work", unrooted_work)
  let worker: map = native_roots/worker(with_worker)
  builder = native_kernel/store_field(with_worker, work, "status", native_gen/ref(with_worker, "kernel_ok"))
  builder = native_kernel/store_field(builder, work, "conflict_rule", native_gen/ref(builder, "zero"))
  builder = native_kernel/store_field(builder, work, "conflict_relation", native_gen/ref(builder, "zero"))
  builder = native_kernel/store_field(builder, work, "conflict_tuple", native_gen/zero(native_value/word()))
  builder = native_kernel/discard_candidate(builder, work)
  builder = native_execution/charge(builder, native_gen/ref(builder, "zero"), native_gen/ref(builder, "zero"), native_gen/ref(builder, "zero"), fn(failed, status)
    let ready: map = native_kernel/store_field(failed, work, "status", status)
    return native_roots/return_value(ready, status)
  end)
  let [current: map, with_current: map] = native_roots/retain(builder, "current", native_kernel/load_field(builder, work, "checked"))
  let [prepared: map, with_prepared: map] = native_gen/bind(with_current, "catalog_result", native_gen/call(with_current, "kernel_prepare_catalog", [worker, work, current, native_roots/ref(with_current, "budget")]))
  builder = native_gen/unless(with_prepared, native_kernel/absent(native_gen/field(with_prepared, prepared, "status")), fn(failed) => native_kernel/prepare_failed(failed, work, native_gen/field(failed, prepared, "status")))
  let [catalog: map, with_catalog: map] = native_roots/retain(builder, "catalog", native_gen/field(builder, prepared, "relation"))
  builder = with_catalog
  let [rules_result: map, with_rules: map] = native_gen/bind(builder, "rules_result",
    native_gen/call(builder, "kernel_rules_rebase", [worker, work, catalog, native_gen/ref(builder, "budget")]))
  builder = native_gen/unless(with_rules, native_kernel/absent(native_gen/field(with_rules, rules_result, "status")), fn(failed)
    let status = native_gen/field(failed, rules_result, "status")
    let ready = native_kernel/discard_candidate(failed, work)
    ready = native_kernel/store_field(ready, work, "status", status)
    return native_roots/return_value(ready, status)
  end)
  let candidate_rules = native_gen/field(builder, rules_result, "rule")
  let [policy: map, with_policy: map] = native_roots/retain(builder, "policy", native_kernel/load_field(builder, work, "policy"))
  builder = native_gen/when(with_policy, native_gen/equal(policy, native_kernel/load_field(with_policy, native_kernel/load_field(with_policy, work, "base"), "policy")),
    fn(unstaged) => native_roots/store(unstaged, policy, native_kernel/load_field(unstaged, current, "policy")))
  builder = native_gen/when(builder, native_gen/equal(catalog, native_kernel/load_field(builder, current, "relations")),
    fn(same_catalog) => native_gen/when(same_catalog, native_gen/equal(candidate_rules, native_kernel/load_field(same_catalog, current, "rules")), fn(same_rules) => native_gen/when(same_rules, native_gen/equal(policy, native_kernel/load_field(same_rules, current, "policy")), fn(unchanged)
      let ready = native_kernel/store_field(unchanged, work, "candidate", current)
      return native_kernel/status(ready, "kernel_ok")
    end)))
  // Root every managed field returned by catalogue preparation before derivation polls.
  let [rooted_rules: map, rooted_catalogue: map] = native_roots/retain(builder, "rules", candidate_rules)
  let [schemas: map, with_schemas: map] = native_roots/retain(rooted_catalogue, "schemas", native_gen/field(rooted_catalogue, rules_result, "schemas"))
  let [heads: map, with_heads: map] = native_roots/retain(with_schemas, "heads", native_gen/field(with_schemas, rules_result, "heads"))
  let [plan: map, with_plan: map] = native_roots/retain(with_heads, "plan", native_gen/field(with_heads, rules_result, "plan"))
  let [maintained: map, with_maintained: map] = native_gen/bind(with_plan, "maintained", native_gen/call(with_plan, "kernel_rule_maintain", [worker, catalog, native_gen/zero(native_kernel/pointer("Change")), plan, native_kernel/load_field(with_plan, current, "evaluation"), native_gen/ref(with_plan, "budget")]))
  builder = native_gen/unless(with_maintained, native_kernel/absent(native_gen/field(with_maintained, maintained, "status")), fn(failed)
    let status: map = native_gen/field(failed, maintained, "status")
    let cleared: map = native_kernel/discard_candidate(failed, work)
    cleared = native_kernel/store_field(cleared, work, "status", status)
    let result: map = native_roots/return_value(cleared, status)
    return result
  end)
  let [evaluation: map, rooted_evaluation: map] = native_roots/retain(builder, "evaluation", native_gen/field(builder, maintained, "evaluation"))
  let [views: map, with_views: map] = native_authority/prepare_views(rooted_evaluation, native_kernel/load_field(rooted_evaluation, current, "owner"), policy, evaluation, plan,
    native_kernel/load_field(rooted_evaluation, current, "policy_views"), native_kernel/load_field(rooted_evaluation, current, "rule_plan"))
  let authorized: map = native_rules/status_call(with_views, "authority_changes", [worker, native_kernel/load_field(with_views, current, "owner"), views, native_kernel/load_field(with_views, work, "rule_changes"), native_roots/ref(with_views, "budget")])
  let [policy_revision: map, with_revision: map] = native_gen/bind(authorized, "policy_revision", native_kernel/load_field(with_views, current, "policy_revision"))
  builder = native_gen/unless(with_revision, native_gen/equal(views, native_kernel/load_field(with_revision, current, "policy_views")),
    fn(changed) => native_gen/assign(changed, policy_revision, native_gen/add(native_kernel/load_field(changed, current, "version"), native_gen/ref(changed, "one"))))
  let [candidate: map, with_candidate: map] = native_gen/bind(builder, "candidate", native_kernel/allocate_record(builder, worker, "Snapshot",
    {"owner" -> native_kernel/load_field(builder, current, "owner"), "policy" -> policy, "policy_views" -> views, "policy_revision" -> policy_revision, "version" -> native_gen/add(native_kernel/load_field(builder, current, "version"), native_gen/ref(builder, "one")), "relations" -> catalog, "rules" -> rooted_rules, "schemas" -> schemas, "rule_heads" -> heads, "rule_plan" -> plan, "evaluation" -> evaluation}))
  builder = native_gen/when(with_candidate, native_kernel/absent(candidate), fn(arm) => native_kernel/commit_oom(arm, work))
  builder = native_kernel/store_field(builder, work, "candidate", candidate)
  builder = native_kernel/status(builder, "kernel_ok")
  let result: map = native_gen/finish(module, builder)
  return result
end

// A safepoint or a wait for the kernel lock can relocate the transaction.
// Reload work through its registered root before reading managed fields.
verb native_kernel/poll_commit(builder: map, transaction: map, worker: map, work: map) -> map
  let [polled: map, with_poll: map] = native_gen/bind(builder, "polled", native_gen/call(builder, "memory_safepoint", [worker, native_gen/ref(builder, "false")]))
  let ready: map = native_kernel/reload_work(with_poll, transaction, work)
  ready = native_gen/unless(ready, polled, fn(arm) => native_kernel/commit_oom(arm, work))
  return ready
end

// Retain the current snapshot under the lock, then release the lock before preparation.
verb native_kernel/capture_commit_snapshot(builder: map, transaction: map, worker: map, kernel: map, work: map) -> map
  let ready: map = native_gen/unless(builder, native_gen/call(builder, "kernel_lock", [kernel, worker]), fn(arm) => native_kernel/status(arm, "kernel_closed"))
  ready = native_kernel/reload_work(ready, transaction, work)
  let [raw: map, with_raw: map] = native_gen/bind(ready, "raw", native_gen/root_read(native_kernel/snapshot_slot(ready, kernel)))
  let [current: map, with_current: map] = native_gen/bind(with_raw, "current", native_gen/cast(native_kernel/pointer("Snapshot"), raw))
  ready = native_kernel/store_field(with_current, work, "checked", current)
  ready = native_gen/when(ready, native_kernel/load_field(ready, work, "policy_used"), fn(observed)
    let base: map = native_kernel/load_field(observed, work, "base")
    return native_gen/unless(observed, native_gen/equal(native_kernel/load_field(observed, base, "policy_revision"), native_kernel/load_field(observed, current, "policy_revision")), fn(conflict)
      let failed: map = native_kernel/store_field(conflict, work, "status", native_gen/ref(conflict, "kernel_conflict"))
      return native_kernel/status(native_kernel/unlock_kernel(failed, kernel), "kernel_conflict")
    end)
  end)
  ready = native_gen/when(ready, native_kernel/absent(native_kernel/load_field(ready, work, "changes")),
    fn(arm) => native_gen/when(arm, native_kernel/absent(native_kernel/load_field(arm, work, "rule_changes")),
      fn(still_rule_free) => native_gen/unless(still_rule_free, native_kernel/load_field(still_rule_free, work, "rules_read"),
        fn(unread) => native_gen/when(unread, native_kernel/absent(native_kernel/load_field(unread, work, "rule_dependencies")),
          fn(independent) => native_gen/when(independent, native_gen/equal(native_kernel/load_field(independent, work, "policy"), native_kernel/load_field(independent, native_kernel/load_field(independent, work, "base"), "policy")),
            fn(unchanged) => native_kernel/commit_unchanged(unchanged, kernel, work, current))))))
  ready = native_kernel/unlock_kernel(ready, kernel)
  return ready
end

verb native_kernel/prepare_commit_candidate(builder: map, transaction: map, worker: map, work: map, budget: map) -> map
  let [status: map, with_status: map] = native_gen/bind(builder, "status", native_gen/call(builder, "kernel_prepare", [transaction, budget]))
  let reloaded: map = native_kernel/reload_work(with_status, transaction, work)
  let ready: map = native_gen/unless(reloaded, native_gen/equal(status, native_gen/ref(reloaded, "kernel_ok")),
    fn(failed) => native_kernel/prepare_failed(failed, work, status))
  let [prepared: map, with_prepared: map] = native_gen/bind(ready, "prepared", native_gen/call(ready, "memory_share",
    [worker, native_gen/cast(native_memory/pointer(:U8), native_kernel/load_field(ready, work, "candidate"))]))
  ready = native_gen/when(with_prepared, native_kernel/absent(prepared), fn(arm) => native_kernel/commit_oom(arm, work))
  ready = native_kernel/store_field(ready, work, "candidate", native_gen/cast(native_kernel/pointer("Snapshot"), prepared))
  return ready
end

verb native_kernel/publish_commit_candidate(builder: map, transaction: map, work: map) -> map
  let [published: map, with_published: map] = native_gen/bind(builder, "published", native_gen/call(builder, "kernel_try_publish", [transaction]))
  let ready: map = native_kernel/reload_work(with_published, transaction, work)
  ready = native_gen/when(ready, published, fn(winner) => native_kernel/status(winner, "kernel_ok"))
  let cleared: map = native_kernel/discard_candidate(ready, work)
  let result: map = native_gen/when(cleared, native_gen/equal(native_kernel/load_field(cleared, work, "status"), native_gen/ref(cleared, "kernel_cancelled")), fn(cancelled) => native_kernel/status(cancelled, "kernel_cancelled"))
  return result
end

// These builders emit one attempt. A lost publication falls through to the next
// attempt; success, conflict, and allocation failure return from the generated commit.
verb native_kernel/commit_attempt(builder: map, transaction: map, worker: map, kernel: map, work: map, budget: map) -> map
  let [status: map, checked: map] = native_gen/bind(builder, "execution_status", native_gen/call(builder, "kernel_budget_check", [budget, native_gen/ref(builder, "zero"), native_gen/ref(builder, "zero"), native_gen/ref(builder, "zero")]))
  let validated: map = native_gen/unless(checked, native_kernel/absent(status), fn(failed)
    let recorded: map = native_kernel/store_field(failed, work, "status", status)
    return native_gen/return_value(recorded, status)
  end)
  let ready: map = native_kernel/poll_commit(validated, transaction, worker, work)
  ready = native_kernel/capture_commit_snapshot(ready, transaction, worker, kernel, work)
  ready = native_kernel/prepare_commit_candidate(ready, transaction, worker, work, budget)
  let result: map = native_kernel/publish_commit_candidate(ready, transaction, work)
  return result
end

verb native_kernel/try_publish_body(module: map) -> map
  let builder: map = native_gen/context(module, "kernel_try_publish")
  let transaction: map = native_gen/ref(builder, "transaction")
  let [worker: map, with_worker: map] = native_gen/bind(builder, "worker", native_kernel/load_field(builder, transaction, "worker"))
  let [kernel: map, with_kernel: map] = native_gen/bind(with_worker, "kernel", native_kernel/load_field(with_worker, transaction, "kernel"))
  builder = native_gen/unless(with_kernel, native_gen/call(with_kernel, "kernel_lock", [kernel, worker]),
    fn(closed) => native_gen/return_value(closed, native_gen/ref(closed, "false")))
  let [work: map, with_work: map] = native_gen/bind(builder, "work", native_gen/call(builder, "kernel_work", [transaction]))
  let [raw: map, with_raw: map] = native_gen/bind(with_work, "raw", native_gen/root_read(native_kernel/snapshot_slot(with_work, kernel)))
  let current: map = native_gen/cast(native_kernel/pointer("Snapshot"), raw)
  builder = native_gen/unless(with_raw, native_gen/equal(current, native_kernel/load_field(with_raw, work, "checked")), fn(lost)
    let unlocked = native_kernel/unlock_kernel(lost, kernel)
    return native_gen/return_value(unlocked, native_gen/ref(unlocked, "false"))
  end)
  let [heap: map, with_heap: map] = native_gen/bind(builder, "heap", native_kernel/load_field(builder, kernel, "heap"))
  let [mutex: map, with_mutex: map] = native_gen/bind(with_heap, "heap_mutex", native_kernel/load_field(with_heap, heap, "mutex"))
  let signal: map = native_kernel/load_field(with_mutex, transaction, "signal")
  let claimed: map = native_gen/call(with_mutex, "memory_atomic_compare_exchange", [signal, native_gen/ref(with_mutex, "zero"), native_gen/ref(with_mutex, "two")])
  builder = native_gen/unless(with_mutex, claimed, fn(cancelled)
    let failed: map = native_kernel/store_field(cancelled, work, "status", native_gen/ref(cancelled, "kernel_cancelled"))
    return native_gen/return_value(native_kernel/unlock_kernel(failed, kernel), native_gen/ref(failed, "false"))
  end)
  builder = native_gen/do_call(builder, "memory_lock", [mutex])
  builder = native_gen/root_write(builder, native_kernel/snapshot_slot(builder, kernel),
    native_gen/cast(native_memory/pointer(:U8), native_kernel/load_field(builder, work, "candidate")))
  builder = native_gen/do_call(builder, "memory_unlock", [mutex])
  builder = native_kernel/store_field(builder, work, "done", native_gen/ref(builder, "true"))
  builder = native_kernel/unlock_kernel(builder, kernel)
  builder = native_gen/return_value(builder, native_gen/ref(builder, "true"))
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/commit_body(module: map) -> map
  let builder: map = native_gen/context(module, "kernel_commit")
  let transaction: map = native_gen/ref(builder, "transaction")
  let [work: map, opened: map] = native_kernel/open_transaction(builder, fn(arm) => native_kernel/status(arm, "kernel_closed"))
  let [worker: map, with_worker: map] = native_gen/bind(opened, "worker", native_kernel/load_field(opened, transaction, "worker"))
  let [kernel: map, with_kernel: map] = native_gen/bind(with_worker, "kernel", native_kernel/load_field(with_worker, transaction, "kernel"))
  // Lost publication attempts share the same allowance within this commit.
  let with_budget: map = native_execution/local_budget(with_kernel, native_kernel/load_field(with_kernel, work, "rule_limit"))
  builder = native_gen/for_range(with_budget, "attempt", native_gen/ref(with_budget, "zero"), native_gen/ref(with_budget, "kernel_64"),
    fn(body, attempt) => native_kernel/commit_attempt(body, transaction, worker, kernel, work, native_roots/ref(body, "budget")))
  builder = native_kernel/store_field(builder, work, "status", native_gen/ref(builder, "kernel_conflict"))
  builder = native_kernel/status(builder, "kernel_conflict")
  let result: map = native_gen/finish(module, builder)
  return result
end

// A transaction retains no snapshot until admission succeeds. Build and root
// its empty workspace first; only capture and handle accounting use the lock.
verb native_kernel/initial_work(builder: map) -> map
  let fields: map = {}
  for field in native_kernel/schema("Work")[1]
    fields[field[0]] = native_gen/zero(field[1])
  end
  fields["tenant"] = native_roots/ref(builder, "tenant")
  fields["rule_limit"] = native_gen/ref(builder, "rule_default_limit")
  fields["bytes_limit"] = native_gen/ref(builder, "rule_default_bytes")
  fields["rows_limit"] = native_gen/ref(builder, "kernel_unlimited")
  fields["rounds_limit"] = native_gen/ref(builder, "kernel_unlimited")
  return fields
end

verb native_kernel/clear_transaction(builder: map, transaction: map) -> map
  let body: map = native_gen/do_call(builder, "memory_atomic_destroy", [native_kernel/load_field(builder, transaction, "signal")])
  let result: map = native_gen/store(body, transaction, native_gen/zero([:Record, "KernelTransaction"]))
  return result
end

verb native_kernel/begin_body(module: map) -> map
  let builder: map = native_gen/context(module, "kernel_begin")
  let kernel: map = native_gen/ref(builder, "kernel")
  let worker: map = native_gen/ref(builder, "worker")
  let transaction: map = native_gen/ref(builder, "transaction")
  let root: map = native_gen/field(builder, transaction, "root")[:pointer]
  builder = native_gen/unless(builder, native_kernel/absent(native_kernel/load_field(builder, root, "registration")), fn(busy) => native_kernel/status(busy, "kernel_closed"))
  builder = native_gen/when(builder, native_kernel/absent(native_kernel/load_field(builder, kernel, "mutex")), fn(closed) => native_kernel/status(closed, "kernel_closed"))
  builder = native_gen/unless(builder, native_gen/equal(native_kernel/load_field(builder, worker, "heap"), native_kernel/load_field(builder, kernel, "heap")), fn(wrong) => native_kernel/status(wrong, "kernel_schema"))
  builder = native_roots/open_scope(builder, fn(failed, reason) => native_kernel/status(failed, string_concat("kernel_", reason)))
  builder = native_rules/check(builder, native_gen/call(builder, "value_is_persistable", [native_roots/ref(builder, "tenant")]), "nonpersistent")
  builder = native_execution/budget_scope(builder, worker, {
    "steps" -> native_gen/ref(builder, "rule_default_limit"), "rows" -> native_gen/ref(builder, "kernel_unlimited"),
    "rounds" -> native_gen/ref(builder, "kernel_unlimited"), "bytes" -> native_gen/ref(builder, "rule_default_bytes"),
    "status" -> native_gen/ref(builder, "kernel_ok"), "signal" -> native_gen/zero(native_memory/pointer(:U8))})
  builder = native_gen/unless(builder, native_gen/call(builder, "memory_safepoint", [worker, native_gen/ref(builder, "false")]), fn(failed) => native_kernel/status(failed, "kernel_oom"))
  let [work: map, allocated: map] = native_gen/bind(builder, "work", native_kernel/allocate_record(builder, worker, "Work", native_kernel/initial_work(builder)))
  builder = native_gen/when(allocated, native_kernel/absent(work), fn(failed) => native_kernel/status(failed, "kernel_oom"))
  let [signal: map, with_signal: map] = native_gen/bind(builder, "signal", native_gen/call(builder, "memory_atomic_create", [native_gen/ref(builder, "zero")]))
  builder = native_gen/when(with_signal, native_kernel/absent(signal), fn(failed) => native_kernel/status(failed, "kernel_oom"))
  for field, value in {"signal" -> signal, "worker" -> worker, "kernel" -> kernel}
    builder = native_gen/root_write(builder, native_gen/field(builder, transaction, field), native_gen/manage(value))
  end
  // Work now owns the tenant. Replace the temporary argument roots with the
  // transaction's persistent root before any further safepoint.
  builder = native_gen/root_write(builder, native_gen/field(builder, worker, "roots"), native_gen/manage(builder[:scope_parent]))
  builder[:scope_roots] = []
  builder = native_gen/root_write(builder, native_gen/field(builder, root, "pointer"), native_gen/cast(native_memory/pointer(:U8), work))
  builder = native_gen/unless(builder, native_gen/call(builder, "memory_root_push", [worker, root]), fn(failed) => native_kernel/status(native_kernel/clear_transaction(failed, transaction), "kernel_closed"))
  let [admitted: map, tracked: map] = native_gen/bind(builder, "admitted", native_gen/ref(builder, "false"))
  builder = native_gen/on_return(tracked, fn(leaving, result)
    return native_gen/unless(leaving, native_kernel/absent(result), fn(failed) => native_gen/branch(failed, admitted,
      fn(retained)
        let [ended: map, released: map] = native_gen/bind(retained, "ended", native_gen/call(retained, "kernel_end", [transaction]))
        return released
      end,
      fn(unretained)
        let [popped: map, with_pop: map] = native_gen/bind(unretained, "popped", native_gen/call(unretained, "memory_root_pop", [worker, root]))
        return native_kernel/clear_transaction(with_pop, transaction)
      end))
  end)
  builder = native_gen/unless(builder, native_gen/call(builder, "kernel_lock", [kernel, worker]), fn(closed) => native_kernel/status(closed, "kernel_closed"))
  let retained: map = native_kernel/load_field(builder, kernel, "retained_transactions")
  builder = native_gen/unless(builder, native_gen/less(retained, native_kernel/load_field(builder, kernel, "retention_limit")), fn(full) => native_kernel/status(native_kernel/unlock_kernel(full, kernel), "kernel_limit"))
  let [base: map, captured: map] = native_gen/bind(builder, "base", native_gen/cast(native_kernel/pointer("Snapshot"), native_gen/root_read(native_kernel/snapshot_slot(builder, kernel))))
  let [current_work: map, reloaded: map] = native_gen/bind(captured, "current_work", native_gen/call(captured, "kernel_work", [transaction]))
  builder = reloaded
  for field in ["base", "checked"]
    builder = native_kernel/store_field(builder, current_work, field, base)
  end
  for field, source in {"evaluation" -> "evaluation", "rule_index" -> "rules", "rule_plan" -> "rule_plan", "policy" -> "policy", "authorized_views" -> "policy_views", "authorized_plan" -> "rule_plan"}
    builder = native_kernel/store_field(builder, current_work, field, native_kernel/load_field(builder, base, source))
  end
  builder = native_kernel/store_field(builder, kernel, "retained_transactions", native_gen/add(retained, native_gen/ref(builder, "one")))
  builder = native_gen/assign(builder, admitted, native_gen/ref(builder, "true"))
  builder = native_kernel/unlock_kernel(builder, kernel)
  builder = native_rules/status_call(builder, "authority_begin", [transaction, native_roots/ref(builder, "budget")])
  builder = native_kernel/status(builder, "kernel_ok")
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/retention_body(module: map) -> map
  let builder: map = native_gen/context(module, "kernel_set_retention_limit")
  let kernel: map = native_gen/ref(builder, "kernel")
  let worker: map = native_gen/ref(builder, "worker")
  builder = native_gen/when(builder, native_kernel/absent(native_kernel/load_field(builder, kernel, "mutex")), fn(closed) => native_kernel/status(closed, "kernel_closed"))
  builder = native_gen/unless(builder, native_gen/equal(native_kernel/load_field(builder, kernel, "heap"), native_kernel/load_field(builder, worker, "heap")), fn(wrong) => native_kernel/status(wrong, "kernel_schema"))
  builder = native_gen/unless(builder, native_gen/call(builder, "kernel_lock", [kernel, worker]), fn(closed) => native_kernel/status(closed, "kernel_closed"))
  builder = native_gen/when(builder, native_gen/less(native_gen/ref(builder, "limit"), native_kernel/load_field(builder, kernel, "retained_transactions")), fn(full) => native_kernel/status(native_kernel/unlock_kernel(full, kernel), "kernel_limit"))
  builder = native_kernel/store_field(builder, kernel, "retention_limit", native_gen/ref(builder, "limit"))
  builder = native_kernel/status(native_kernel/unlock_kernel(builder, kernel), "kernel_ok")
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/lifecycle(input: map) -> map
  let context: map = input
  let kernel: list = native_memory/record_pointer("Kernel")
  let worker: list = native_memory/record_pointer("MemoryWorker")
  let heap: list = native_memory/record_pointer("MemoryHeap")
  let root: list = native_memory/record_pointer("MemoryRoot")
  let bytes: list = native_memory/pointer(:U8)
  let tx: list = native_kernel/pointer("Transaction")
  let work: list = native_kernel/pointer("Work")
  let snapshot: list = native_kernel/pointer("Snapshot")
  let relation: list = native_kernel/pointer("Relation")
  let change: list = native_kernel/pointer("Change")
  let index: list = native_kernel/pointer("Index")
  let word: list = native_value/word()
  for spec in [
    ["heap_init", :Bool, [["heap", heap, :Borrow]], false],
    ["lock", :Bool, [["kernel", kernel, :Borrow], ["worker", worker, :Borrow]], true],
    ["init", :Bool, [["kernel", kernel, :Borrow], ["worker", worker, :Borrow], ["owner", word, :Gc]], true],
    ["release", :Bool, [["kernel", kernel, :Borrow], ["worker", worker, :Borrow]], false],
    ["begin", :U64, [["kernel", kernel, :Borrow], ["worker", worker, :Borrow], ["transaction", tx, :Borrow], ["tenant", word, :Gc]], true],
    ["end", :Bool, [["transaction", tx, :Borrow]], true],
    ["set_retention_limit", :U64, [["kernel", kernel, :Borrow], ["worker", worker, :Borrow], ["limit", :U64, :Value]], true],
    ["commit", :U64, [["transaction", tx, :Borrow]], true],
    ["prepare_catalog", [:Record, "KernelRelationResult"], [["worker", worker, :Borrow], ["work", native_kernel/pointer("Work"), :Gc], ["current", native_kernel/pointer("Snapshot"), :Gc], ["budget", native_kernel/pointer("Budget"), :Borrow]], true],
    ["prepare", :U64, [["transaction", tx, :Borrow], ["budget", native_kernel/pointer("Budget"), :Borrow]], true],
    ["try_publish", :Bool, [["transaction", tx, :Borrow]], true],
    ["empty_indexes", index, [["worker", worker, :Borrow], ["index", index, :Gc]], false]]
    context = native_kernel/declare(context, spec[0], spec[1], spec[2], spec[3])
  end
  context = native_kernel/define(context, "heap_init", [
    native/return_value(native/call_expression("memory_heap_init", ["heap", native/typed_expression([:FunctionPointer, "MemoryTrace"], native/function_address_expression("kernel_trace"))]))])
  context = native_kernel/define(context, "lock", [
    native/unless_statement(native/call_expression("memory_leave", ["worker"]), [native/return_value("false")]),
    native_memory/call("memory_lock", [native_memory/field(bytes, "kernel", "mutex")]),
    native/return_value(native/call_expression("memory_enter", ["worker"]))])
  let unlock: list = [native_memory/call("memory_unlock", [native_memory/field(bytes, "kernel", "mutex")])]
  context = native_kernel/define(context, "init", [
    native/unless_statement(native/call_expression("value_is_persistable", ["owner"]), [native/return_value("false")]),
    native/unless_statement(native_kernel/binary(:Equal, native_memory/field(bytes, "kernel", "mutex"), "null_bytes"), [native/return_value("false")]),
    native/let_call("mutex", bytes, "memory_sync_create", []),
    native/when_statement(native_kernel/binary(:Equal, "mutex", "null_bytes"), [native/return_value("false")]),
    native/let_statement("slot", native_memory/pointer(bytes), native/field_pointer_expression("kernel", "mutex")),
    native/let_statement("adopted", bytes, native/binary_expression(:Adopt, "slot", "mutex")),
    native_memory/store_root(heap, "kernel", "heap", native/typed_expression(heap, native/manage_expression(native_memory/field(heap, "worker", "heap")))),
    native_memory/store(:U64, "kernel", "retention_limit", "kernel_default_retention"),
    native_memory/store(:U64, "kernel", "retained_transactions", "zero"),
    native/let_statement("snapshot", snapshot, native_kernel/construct("Snapshot", {"owner" -> "owner", "policy" -> native_kernel/null("AuthorityPolicy"), "policy_views" -> native_kernel/null("AuthorityViews"), "policy_revision" -> "zero", "evaluation" -> native_kernel/null("RuleEvaluation"), "version" -> "zero", "relations" -> native_kernel/null("Relation"), "rules" -> native_kernel/null("RuleIndex"), "schemas" -> native_kernel/null("RuleSchemaIndex"), "rule_heads" -> native_kernel/null("RuleGenerationIndex"), "rule_plan" -> native_kernel/null("RulePlan")})),
    native/when_statement(native_kernel/is_null("Snapshot", "snapshot"), [
      native_memory/call("memory_sync_destroy", ["mutex"]), native_memory/store(bytes, "kernel", "mutex", "null_bytes"), native/return_value("false")]),
    native/let_statement("storage", [:Record, "MemoryRoot"], native/zero_expression()),
    native/let_statement("source", root, native/unary_expression(:Address, "storage")),
    native_memory/store_root(bytes, "source", "pointer", native/typed_expression(bytes, native/unary_expression(:PointerCast, "snapshot"))),
    native/let_call("pushed", :Bool, "memory_root_push", ["worker", "source"]),
    native/let_call("ok", :Bool, "memory_publish", ["worker", "source", native_kernel/shared_root()]),
    native/let_call("popped", :Bool, "memory_root_pop", ["worker", "source"]),
    native/unless_statement("ok", [native_memory/call("memory_sync_destroy", ["mutex"]), native_memory/store(bytes, "kernel", "mutex", "null_bytes")]),
    native/return_value("ok")])
  // Release requires exclusive ownership of the control object. Transactions
  // must be ended first; snapshots remain managed and are reclaimed by GC.
  context = native_kernel/define(context, "release", [
    native/unless_statement(native_kernel/binary(:Equal, native_memory/field(:U64, "kernel", "retained_transactions"), "zero"), [native/return_value("false")]),
    native/unless_statement(native/call_expression("memory_unpublish", ["worker", native_kernel/shared_root()]), [native/return_value("false")]),
    native_memory/call("memory_sync_destroy", [native_memory/field(bytes, "kernel", "mutex")]),
    native/store_statement("kernel", native/typed_zero([:Record, "Kernel"])), native/return_value("true")])
  context = native_kernel/begin_body(context)
  context = native_kernel/retention_body(context)
  context = native_kernel/define(context, "end", [
    native/let_statement("worker", worker, native_memory/field(worker, "transaction", "worker")),
    native/when_statement(native_kernel/binary(:Equal, "worker", "memory_null_worker"), [native/return_value("false")]),
    native/let_statement("kernel", kernel, native_memory/field(kernel, "transaction", "kernel")),
    native/unless_statement(native/call_expression("kernel_lock", ["kernel", "worker"]), [native/return_value("false")]),
    native/unless_statement(native/call_expression("memory_root_pop", ["worker", native_kernel/transaction_root()]), [@unlock, native/return_value("false")]),
    native_memory/store(:U64, "kernel", "retained_transactions", native/typed_expression(:U64, native/binary_expression(:Subtract, native_memory/field(:U64, "kernel", "retained_transactions"), "one"))),
    @unlock,
    native_memory/call("memory_atomic_destroy", [native_memory/field(bytes, "transaction", "signal")]),
    native/store_statement("transaction", native/typed_zero([:Record, "KernelTransaction"])), native/return_value("true")])
  context = native_kernel/empty_indexes_body(context)
  context = native_kernel/prepare_catalog_body(context)
  context = native_kernel/prepare_body(context)
  context = native_kernel/try_publish_body(context)
  context = native_kernel/commit_body(context)
  return context
end
