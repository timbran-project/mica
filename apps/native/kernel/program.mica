verb native_kernel/pointer(name: string) -> list
  let output: list = native_memory/record_pointer(string_concat("Kernel", name))
  return output
end

verb native_kernel/check_column_mask(builder: map, arity: map, mask: map, failure) -> map
  let result: map = native_gen/when(builder, native_gen/less(arity, native_gen/ref(builder, "kernel_64")),
    fn(arm) => native_gen/unless(arm, native_kernel/absent(native_gen/shift_right(mask, arity)), failure))
  return result
end

verb native_kernel/schemas() -> list
  let node: list = native_kernel/pointer("Node")
  let relation: list = native_kernel/pointer("Relation")
  let word: list = native_value/word()
  let rule: list = native_kernel/pointer("Rule")
  let rule_change: list = native_kernel/pointer("RuleChange")
  let indexes: list = []
  for spec in native_rules/index_specs()
    let pointer: list = native_kernel/pointer(spec[1])
    indexes = [@indexes, [spec[1], [["left", pointer], ["right", pointer], ["entry", native_kernel/pointer(spec[2])], ["height", :U64]]]]
  end
  return [@native_rules/schemas(), @indexes,
    ["Node", [["left", node], ["right", node], ["row", word], ["height", :U64], ["present", :Bool]]],
    ["Index", [["next", native_kernel/pointer("Index")], ["mask", :U64], ["tree", node]]],
    ["Relation", [["next", relation], ["id", :U64], ["name", :U64], ["arity", :U64],
      ["policy", :U64], ["keys", :U64], ["schema_revision", :U64], ["indexes", native_kernel/pointer("Index")]]],
    ["Snapshot", [["evaluation", native_kernel/pointer("RuleEvaluation")], ["version", :U64], ["relations", relation], ["rules", native_kernel/pointer("RuleIndex")], ["schemas", native_kernel/pointer("RuleSchemaIndex")], ["rule_heads", native_kernel/pointer("RuleGenerationIndex")], ["rule_plan", native_kernel/pointer("RulePlan")]]],
    ["Rule", [["next", rule], ["id", :U64], ["head", :U64], ["arity", :U64], ["active", :Bool], ["revision", :U64], ["definition", native_kernel/pointer("RuleDef")]]],
    ["RuleIndex", [["left", native_kernel/pointer("RuleIndex")], ["right", native_kernel/pointer("RuleIndex")], ["entry", rule], ["height", :U64]]],
    ["RuleObservationIndex", [["left", native_kernel/pointer("RuleObservationIndex")], ["right", native_kernel/pointer("RuleObservationIndex")], ["entry", rule_change], ["height", :U64]]],
    ["RuleChange", [["next", rule_change], ["id", :U64], ["before", rule], ["after", rule], ["written", :Bool]]],
    ["Change", [["next", native_kernel/pointer("Change")], ["before", relation], ["after", relation], ["writes", node]]],
    ["Delta", [["next", native_kernel/pointer("Delta")], ["relation", :U64], ["row", word], ["asserted", :Bool]]],
    ["Query", [["kind", :U64], ["relation", :U64], ["pattern", word], ["mask", :U64],
      ["left", native_kernel/pointer("Query")], ["right", native_kernel/pointer("Query")],
      ["positions", word], ["right_positions", word], ["input", word]]],
    ["Work", [["evaluation", native_kernel/pointer("RuleEvaluation")], ["dirty", :Bool], ["base", native_kernel/pointer("Snapshot")], ["changes", native_kernel/pointer("Change")],
      ["rule_changes", rule_change], ["rule_observations", native_kernel/pointer("RuleObservationIndex")],
      ["rule_index", native_kernel/pointer("RuleIndex")], ["rules", rule], ["rules_cached", :Bool], ["rules_read", :Bool], ["rule_plan", native_kernel/pointer("RulePlan")],
      ["rule_dependencies", native_kernel/pointer("RuleDependency")], ["rule_dependency_index", native_kernel/pointer("RuleDependencyIndex")], ["rule_limit", :U64], ["rows_limit", :U64], ["rounds_limit", :U64],
      ["checked", native_kernel/pointer("Snapshot")], ["candidate", native_kernel/pointer("Snapshot")], ["deltas", native_kernel/pointer("Delta")],
      ["status", :U64], ["conflict_rule", :U64], ["conflict_relation", :U64], ["conflict_tuple", word], ["done", :Bool]]]]
end

verb native_kernel/schema(record: string) -> list
  for spec in native_kernel/schemas()
    if spec[0] == record
      return [string_concat("Kernel", record), spec[1]]
    end
  end
  native/ensure(false, string_concat("unknown kernel record ", record))
  return []
end

verb native_kernel/read(record: string, object, field: string) -> list
  let output: list = native/member(native_kernel/schema(record), object, field)
  return output
end

verb native_kernel/write(record: string, object, field: string, value) -> list
  let output: list = native/set_member(native_kernel/schema(record), object, field, value)
  return output
end

// Named construction and path copying use the same schema as layout and GC.
verb native_kernel/construct(record: string, fields: map) -> list
  let arguments: list = native/record_arguments(native_kernel/schema(record), fields)
  let output: list = native_kernel/call(native_kernel/pointer(record), string_concat("new_", record), ["worker", @arguments])
  return output
end

verb native_kernel/copy_record(record: string, source: string, changes: map) -> list
  let arguments: list = native/record_copy_arguments(native_kernel/schema(record), source, changes)
  let output: list = native_kernel/call(native_kernel/pointer(record), string_concat("new_", record), ["worker", @arguments])
  return output
end

verb native_kernel/walk(record: string, cursor: string, first, body: list, exhausted: list) -> list
  let result: list = native/walk_chain(cursor, native_kernel/pointer(record), first,
    native_kernel/read(record, cursor, "next"), body, exhausted)
  return result
end

// Rebuild the suffix before transforming this element. A null input is empty;
// a null result for a nonempty suffix means allocation failed.
verb native_kernel/copy_chain(builder: map, record: string, cursor: map, recurse: string, arguments: list, transform) -> map
  let absent = native_gen/zero(native_kernel/pointer(record))
  let ready = native_gen/when(builder, native_gen/equal(cursor, absent),
    fn(arm) => native_gen/return_value(arm, absent))
  let [next, with_next] = native_gen/bind(ready, "next", native_kernel/load_field(ready, cursor, "next"))
  let [tail, with_tail] = native_gen/bind(with_next, "tail", absent)
  ready = native_gen/unless(with_tail, native_gen/equal(next, absent),
    fn(arm) => native_kernel/copy_suffix(arm, record, recurse, next, tail, arguments))
  let result: map = transform(ready, cursor, tail)
  return result
end

verb native_kernel/copy_suffix(builder: map, record: string, recurse: string, next: map, tail: map, arguments: list) -> map
  let ready = native_gen/assign(builder, tail, native_gen/call(builder, string_concat("kernel_", recurse),
    [native_gen/ref(builder, "worker"), next, @arguments]))
  let result: map = native_gen/when(ready, native_gen/equal(tail, native_gen/zero(native_kernel/pointer(record))),
    fn(arm) => native_gen/return_value(arm, tail))
  return result
end

verb native_kernel/check_tuple(builder: map, row: map, relation: map, failure) -> map
  let list_kind = native_gen/equal(native_gen/expression(:U8, :Tag, [row]), native_gen/ref(builder, "tag_list"))
  let ready = native_gen/unless(builder, list_kind, failure)
  let result: map = native_gen/unless(ready, native_gen/equal(native_gen/call(ready, "kernel_width", [row]),
    native_kernel/load_field(ready, relation, "arity")), failure)
  return result
end

verb native_kernel/absent(value: map) -> map
  let result: map = native_gen/equal(value, native_gen/zero(native_gen/type(value)))
  return result
end

verb native_kernel/store_field(builder: map, object: map, field: string, value: map) -> map
  let result: map = native_gen/write(builder, native_gen/field(builder, object, field), value)
  return result
end

verb native_kernel/binary(op: symbol, left, right) -> list
  let kind: symbol = :U64
  if native/contains([:Equal, :Less, :LessEqual, :NotEqual], op)
    kind = :Bool
  end
  let output: list = native/typed_expression(kind, native/binary_expression(op, left, right))
  return output
end

verb native_kernel/negate(value) -> list
  let output: list = native/binary_expression(:Equal, value, "false")
  return output
end

verb native_kernel/null(name: string) -> list
  let output: list = native/typed_zero(native_kernel/pointer(name))
  return output
end

verb native_kernel/is_null(name: string, value) -> list
  let output: list = native_kernel/binary(:Equal, value, native_kernel/null(name))
  return output
end

verb native_kernel/call(type_id, name: string, args: list) -> list
  let output: list = native/typed_call(type_id, string_concat("kernel_", name), args)
  return output
end

verb native_kernel/declare(context: map, name: string, result, parameters: list, ?relocates: bool = false) -> map
  let effects: list = [:ReadMemory, :WriteMemory, :Allocate, :Release]
  if relocates
    effects = [@effects, :Relocate]
  end
  let mode: symbol = :Value
  if native/is_pointer(result) || result == native_value/word() || native/contains([[:Record, "KernelRuleResult"], [:Record, "KernelRuleTreeResult"], [:Record, "KernelRuleIndexResult"], [:Record, "KernelRuleObservationIndexResult"]], result) || native/contains(native_rules/result_types(), result) || result == [:Record, "KernelNodeResult"] || result == [:Record, "KernelQueryResult"] || result == [:Record, "ValueResult"]
    mode = :Gc
  end
  let output: map = native_memory/declare(context, string_concat("kernel_", name), result, parameters, effects, mode, "")
  return output
end

verb native_kernel/define(context: map, name: string, body: list) -> map
  let output: map = native/define_function(context, string_concat("kernel_", name), body)
  return output
end

verb native_kernel/load_field(builder: map, object: map, field: string) -> map
  let result: map = native_gen/read(native_gen/field(builder, object, field))
  return result
end

verb native_kernel/allocate_record(builder: map, worker: map, record: string, fields: map) -> map
  let arguments = native/record_arguments(native_kernel/schema(record), fields)
  let result: map = native_gen/call(builder, string_concat("kernel_new_", record), [worker, @arguments])
  return result
end

verb native_kernel/replace_record(builder: map, worker: map, record: string, source: map, changes: map) -> map
  let fields = changes
  for field in native_kernel/schema(record)[1]
    if !map_contains_key(fields, field[0])
      fields[field[0]] = native_kernel/load_field(builder, source, field[0])
    end
  end
  let result: map = native_kernel/allocate_record(builder, worker, record, fields)
  return result
end

verb native_kernel/types(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let root: list = [:Record, "MemoryRoot"]
  let worker: list = native_memory/record_pointer("MemoryWorker")
  let bytes: list = native_memory/pointer(:U8)
  let state: map = context[:state]
  let constants: list = [
    ["kernel_ok", :U64, native_value/hex(0)], ["kernel_unknown", :U64, native_value/hex(1)],
    ["kernel_arity", :U64, native_value/hex(2)], ["kernel_nonpersistent", :U64, native_value/hex(3)],
    ["kernel_key", :U64, native_value/hex(4)], ["kernel_conflict", :U64, native_value/hex(5)],
    ["kernel_name", :U64, native_value/hex(6)], ["kernel_schema", :U64, native_value/hex(7)],
    ["kernel_unlimited", :U64, "ffffffffffffffff"], ["kernel_cancelled", :U64, native_value/hex(11)], ["kernel_limit", :U64, native_value/hex(10)], ["rule_default_limit", :U64, native_value/hex(16777216)],
    ["kernel_oom", :U64, native_value/hex(8)], ["kernel_closed", :U64, native_value/hex(9)],
    ["kernel_policy_set", :U64, native_value/hex(0)], ["kernel_policy_functional", :U64, native_value/hex(1)],
    ["kernel_policy_event", :U64, native_value/hex(2)], ["kernel_64", :U64, native_value/hex(64)]]
  let layout: int = 100
  for spec in native_kernel/schemas()
    state = native/record_type(state, string_concat("Kernel", spec[0]), spec[1])[1]
    constants = [@constants, [string_concat("kernel_layout_", spec[0]), :U64, native_value/hex(layout)]]
    layout = layout + 1
  end
  for spec in [
    ["Kernel", [["heap", native_memory/record_pointer("MemoryHeap")], ["mutex", bytes], ["current", root]]],
    ["KernelBudget", [["steps", :U64], ["rows", :U64], ["rounds", :U64], ["status", :U64], ["signal", bytes]]],
    ["KernelTransaction", [["signal", bytes], ["kernel", native_memory/record_pointer("Kernel")], ["worker", worker], ["root", root]]],
    ["KernelQueryResult", [["status", :U64], ["arity", :U64], ["rows", word]]],
    ["KernelRuleIndexResult", [["ok", :Bool], ["node", native_kernel/pointer("RuleIndex")]]],
    ["KernelRuleObservationIndexResult", [["ok", :Bool], ["node", native_kernel/pointer("RuleObservationIndex")]]],
    ["KernelRuleTreeResult", [["status", :U64], ["rule", native_kernel/pointer("RuleIndex")], ["heads", native_kernel/pointer("RuleGenerationIndex")], ["plan", native_kernel/pointer("RulePlan")], ["schemas", native_kernel/pointer("RuleSchemaIndex")]]],
    ["KernelRuleResult", [["status", :U64], ["rule", native_kernel/pointer("Rule")]]],
    @native_rules/result_schemas(),
    ["KernelNodeResult", [["ok", :Bool], ["node", native_kernel/pointer("Node")]]],
    ["KernelScan", [["pattern", word], ["after", word], ["order", :U64], ["mask", :U64], ["prefix", :U64],
      ["output", native_memory/pointer(word)], ["capacity", :U64], ["count", :U64], ["visited", :U64], ["more", :Bool]]],
    ["KernelScanResult", [["status", :U64], ["count", :U64], ["visited", :U64], ["more", :Bool]]]]
    state = native/record_type(state, spec[0], spec[1])[1]
  end
  let [bindings, declared] = native/constants(state, constants)
  context[:state] = declared
  let merged: map = context[:constants]
  for name, id in bindings
    merged[name] = id
  end
  context[:constants] = merged
  for spec in native_kernel/schemas()
    let fields: list = []
    for field in spec[1]
      let mode: symbol = :Value
      if native/is_pointer(field[1]) || field[1] == word
        mode = :Gc
      end
      fields = [@fields, [field[0], field[1], mode]]
    end
    context = native_memory/record_constructor(context, string_concat("kernel_new_", spec[0]),
      [string_concat("Kernel", spec[0]), fields], string_concat("kernel_layout_", spec[0]), "null_bytes")
  end
  return context
end

verb native_kernel/trace_record(builder: map, schema: list, collection: map, payload: map) -> map
  let [header: map, with_header: map] = native_gen/bind(builder, "header", native_gen/cast(native_kernel/pointer(schema[0]), payload))
  let current: map = with_header
  for field in schema[1]
    if native/is_pointer(field[1])
      current = native_value/trace_external(current, header, field[0], collection)
    elseif field[1] == native_value/word()
      current = native_value/trace_word_field(current, header, field[0], collection)
    end
  end
  current = native_gen/return_void(current)
  return current
end

verb native_kernel/tracing(input: map) -> map
  let context: map = native_kernel/declare(input, "trace", :Void,
    [["collection", native_memory/record_pointer("MemoryCollection"), :Borrow],
      ["object", native_memory/record_pointer("MemoryObject"), :Gc]])
  let builder: map = native_gen/context(context, "kernel_trace")
  let collection: map = native_gen/ref(builder, "collection")
  let object: map = native_gen/ref(builder, "object")
  let [layout: map, with_layout: map] = native_gen/bind(builder, "layout", native_gen/read(native_gen/field(builder, object, "layout")))
  let [payload: map, with_payload: map] = native_gen/bind(with_layout, "payload", native_gen/call(with_layout, "memory_payload", [object]))
  let cases: list = []
  for schema in native_kernel/schemas()
    cases = [@cases, [native_gen/ref(with_payload, string_concat("kernel_layout_", schema[0])),
      fn(body) => native_kernel/trace_record(body, schema, collection, payload)]]
  end
  builder = native_gen/switch(with_payload, layout, cases, fn(fallback)
    let current: map = native_gen/do_call(fallback, "value_trace", [collection, object])
    return native_gen/return_void(current)
  end)
  let result: map = native_gen/finish(context, builder)
  return result
end

verb native_kernel/program() -> map
  let context: map = native_value/definitions()
  context = native_kernel/types(context)
  context = native_execution/declarations(context)
  context = native_execution/program(context)
  context = native_rules/maintenance_declarations(context)
  context = native_kernel/tracing(context)
  context = native_kernel/indexes(context)
  context = native_kernel/relations(context)
  context = native_kernel/transactions(context)
  context = native_rules/declarations(context)
  context = native_kernel/rules(context)
  context = native_rules/program(context)
  context = native_kernel/lifecycle(context)
  context = native_query/program(context)
  context = native_rules/evaluation_program(context)
  context = native_rules/maintenance_program(context)
  let state: map = context[:state]
  return state
end
