verb native_kernel/pointer(name: string) -> list
  let output: list = native_memory/record_pointer(string_concat("Kernel", name))
  return output
end

verb native_kernel/schemas() -> list
  let node: list = native_kernel/pointer("Node")
  let relation: list = native_kernel/pointer("Relation")
  let word: list = native_value/word()
  return [
    ["Node", [["left", node], ["right", node], ["row", word], ["height", :U64], ["present", :Bool]]],
    ["Index", [["next", native_kernel/pointer("Index")], ["mask", :U64], ["tree", node]]],
    ["Relation", [["next", relation], ["id", :U64], ["name", :U64], ["arity", :U64],
      ["policy", :U64], ["keys", :U64], ["indexes", native_kernel/pointer("Index")]]],
    ["Snapshot", [["version", :U64], ["relations", relation]]],
    ["Change", [["next", native_kernel/pointer("Change")], ["before", relation], ["after", relation], ["writes", node]]],
    ["Delta", [["next", native_kernel/pointer("Delta")], ["relation", :U64], ["row", word], ["asserted", :Bool]]],
    ["Work", [["base", native_kernel/pointer("Snapshot")], ["changes", native_kernel/pointer("Change")],
      ["candidate", native_kernel/pointer("Snapshot")], ["deltas", native_kernel/pointer("Delta")],
      ["status", :U64], ["conflict_relation", :U64], ["conflict_tuple", word], ["done", :Bool]]]]
end

verb native_kernel/schema(record: string) -> list
  for spec in native_kernel/schemas()
    if spec[0] == record
      return [string_concat("Kernel", record), spec[1]]
    end
  end
  native/ensure(false, string_concat("unknown kernel record ", record))
  return []
end

verb native_kernel/read(record: string, object, field: string) -> list
  let output: list = native/member(native_kernel/schema(record), object, field)
  return output
end

verb native_kernel/write(record: string, object, field: string, value) -> list
  let output: list = native/set_member(native_kernel/schema(record), object, field, value)
  return output
end

// Named construction and path copying use the same schema as layout and GC.
verb native_kernel/construct(record: string, fields: map) -> list
  let arguments: list = native/record_arguments(native_kernel/schema(record), fields)
  let output: list = native_kernel/call(native_kernel/pointer(record), string_concat("new_", record), ["worker", @arguments])
  return output
end

verb native_kernel/copy_record(record: string, source: string, changes: map) -> list
  let arguments: list = native/record_copy_arguments(native_kernel/schema(record), source, changes)
  let output: list = native_kernel/call(native_kernel/pointer(record), string_concat("new_", record), ["worker", @arguments])
  return output
end

verb native_kernel/walk(record: string, cursor: string, first, body: list, exhausted: list) -> list
  let result: list = native/walk_chain(cursor, native_kernel/pointer(record), first,
    native_kernel/read(record, cursor, "next"), body, exhausted)
  return result
end

verb native_kernel/require_tuple(row, relation, failure: list) -> list
  return [native_value/require_kind(row, "list", failure),
    native/unless_statement(native_kernel/binary(:Equal,
      native_kernel/call(:U64, "width", [row]), native_kernel/read("Relation", relation, "arity")), failure)]
end

verb native_kernel/binary(op: symbol, left, right) -> list
  let kind: symbol = :U64
  if native/contains([:Equal, :Less, :LessEqual, :NotEqual], op)
    kind = :Bool
  end
  let output: list = native/typed_expression(kind, native/binary_expression(op, left, right))
  return output
end

verb native_kernel/negate(value) -> list
  let output: list = native/binary_expression(:Equal, value, "false")
  return output
end

verb native_kernel/null(name: string) -> list
  let output: list = native/typed_zero(native_kernel/pointer(name))
  return output
end

verb native_kernel/is_null(name: string, value) -> list
  let output: list = native_kernel/binary(:Equal, value, native_kernel/null(name))
  return output
end

verb native_kernel/call(type_id, name: string, args: list) -> list
  let output: list = native/typed_call(type_id, string_concat("kernel_", name), args)
  return output
end

verb native_kernel/declare(context: map, name: string, result, parameters: list, ?relocates: bool = false) -> map
  let effects: list = [:ReadMemory, :WriteMemory, :Allocate, :Release]
  if relocates
    effects = [@effects, :Relocate]
  end
  let mode: symbol = :Value
  if native/is_pointer(result) || result == native_value/word() || result == [:Record, "KernelNodeResult"]
    mode = :Gc
  end
  let output: map = native_memory/declare(context, string_concat("kernel_", name), result, parameters, effects, mode, "")
  return output
end

verb native_kernel/define(context: map, name: string, body: list) -> map
  let output: map = native/define_function(context, string_concat("kernel_", name), body)
  return output
end

verb native_kernel/types(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let root: list = [:Record, "MemoryRoot"]
  let worker: list = native_memory/record_pointer("MemoryWorker")
  let bytes: list = native_memory/pointer(:U8)
  let state: map = context[:state]
  let constants: list = [
    ["kernel_ok", :U64, native_value/hex(0)], ["kernel_unknown", :U64, native_value/hex(1)],
    ["kernel_arity", :U64, native_value/hex(2)], ["kernel_nonpersistent", :U64, native_value/hex(3)],
    ["kernel_key", :U64, native_value/hex(4)], ["kernel_conflict", :U64, native_value/hex(5)],
    ["kernel_name", :U64, native_value/hex(6)], ["kernel_schema", :U64, native_value/hex(7)],
    ["kernel_oom", :U64, native_value/hex(8)], ["kernel_closed", :U64, native_value/hex(9)],
    ["kernel_policy_set", :U64, native_value/hex(0)], ["kernel_policy_functional", :U64, native_value/hex(1)],
    ["kernel_policy_event", :U64, native_value/hex(2)], ["kernel_64", :U64, native_value/hex(64)]]
  let layout: int = 100
  for spec in native_kernel/schemas()
    state = native/record_type(state, string_concat("Kernel", spec[0]), spec[1])[1]
    constants = [@constants, [string_concat("kernel_layout_", spec[0]), :U64, native_value/hex(layout)]]
    layout = layout + 1
  end
  for spec in [
    ["Kernel", [["heap", native_memory/record_pointer("MemoryHeap")], ["mutex", bytes], ["current", root]]],
    ["KernelTransaction", [["kernel", native_memory/record_pointer("Kernel")], ["worker", worker], ["root", root]]],
    ["KernelNodeResult", [["ok", :Bool], ["node", native_kernel/pointer("Node")]]],
    ["KernelScan", [["pattern", word], ["after", word], ["order", :U64], ["mask", :U64], ["prefix", :U64],
      ["output", native_memory/pointer(word)], ["capacity", :U64], ["count", :U64], ["visited", :U64], ["more", :Bool]]],
    ["KernelScanResult", [["status", :U64], ["count", :U64], ["visited", :U64], ["more", :Bool]]]]
    state = native/record_type(state, spec[0], spec[1])[1]
  end
  let [bindings, declared] = native/constants(state, constants)
  context[:state] = declared
  let merged: map = context[:constants]
  for name, id in bindings
    merged[name] = id
  end
  context[:constants] = merged
  for spec in native_kernel/schemas()
    let fields: list = []
    for field in spec[1]
      let mode: symbol = :Value
      if native/is_pointer(field[1]) || field[1] == word
        mode = :Gc
      end
      fields = [@fields, [field[0], field[1], mode]]
    end
    context = native_memory/record_constructor(context, string_concat("kernel_new_", spec[0]),
      [string_concat("Kernel", spec[0]), fields], string_concat("kernel_layout_", spec[0]), "null_bytes")
  end
  return context
end

verb native_kernel/tracing(input: map) -> map
  let context: map = input
  let collection: list = native_memory/record_pointer("MemoryCollection")
  let object: list = native_memory/record_pointer("MemoryObject")
  let bytes: list = native_memory/pointer(:U8)
  context = native_kernel/declare(context, "trace", :Void, [["collection", collection, :Borrow], ["object", object, :Gc]])
  let cases: list = []
  for spec in native_kernel/schemas()
    let body: list = [native/let_statement("header", native_kernel/pointer(spec[0]), native/unary_expression(:PointerCast, "payload"))]
    for field in spec[1]
      if native/is_pointer(field[1])
        body = [@body, @native_value/trace_external("header", field[0], field[1])]
      elseif field[1] == native_value/word()
        body = [@body, @native_value/trace_word_field("header", field[0])]
      end
    end
    cases = [@cases, native/case_arm(string_concat("kernel_layout_", spec[0]),
      [@native/rename_bindings(body, native_value/trace_bindings(body, spec[0])), native/return_void()])]
  end
  context = native_kernel/define(context, "trace", [
    native/let_statement("layout", :U64, native_memory/field(:U64, "object", "layout")),
    native/let_call("payload", bytes, "memory_payload", ["object"]),
    native/switch_statement(:U64, "layout", cases, [native_memory/call("value_trace", ["collection", "object"]), native/return_void()])])
  return context
end

verb native_kernel/program() -> map
  let context: map = native_value/definitions()
  context = native_kernel/types(context)
  context = native_kernel/tracing(context)
  context = native_kernel/indexes(context)
  context = native_kernel/relations(context)
  context = native_kernel/transactions(context)
  context = native_kernel/lifecycle(context)
  let state: map = context[:state]
  return state
end
