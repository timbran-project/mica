verb native_kernel/transaction_root() -> list
  let result: list = native/typed_expression(native_memory/record_pointer("MemoryRoot"), native/field_pointer_expression("transaction", "root"))
  return result
end

verb native_kernel/require_transaction(failure: list) -> list
  return [native/let_call("work", native_kernel/pointer("Work"), "kernel_work", ["transaction"]),
    native/when_statement(native_kernel/is_null("Work", "work"), failure),
    native/when_statement(native_kernel/read("Work", "work", "done"), failure)]
end

// A functional key must have the same occupancy and complete tuple as the
// base snapshot. Set assertions instead detect a concurrent removal.
verb native_kernel/validate_key_state(builder: map, base: map, current: map, conflict) -> map
  let base_absent = native_kernel/absent(base)
  let current_absent = native_kernel/absent(current)
  let ready = native_gen/unless(builder, native_gen/equal(base_absent, current_absent), conflict)
  let same_row = native_gen/equal(native_kernel/compare_rows(ready,
    native_kernel/load_field(ready, base, "row"), native_kernel/load_field(ready, current, "row"),
    native_kernel/tuple_order(native_gen/ref(ready, "zero"))), native_gen/ref(ready, "int_zero"))
  let result: map = native_gen/unless(ready, base_absent, fn(arm) => native_gen/unless(arm, same_row, conflict))
  return result
end

verb native_kernel/validate_set_assertion(builder: map, writes: map, base: map, current: map, conflict) -> map
  let result: map = native_gen/when(builder, native_kernel/load_field(builder, writes, "present"),
    fn(arm) => native_gen/unless(arm, native_kernel/absent(base),
      fn(present) => native_gen/when(present, native_kernel/absent(current), conflict)))
  return result
end

// Removing a row absent from the base must not remove a concurrent assertion.
verb native_kernel/effective_write(builder: map, before: map, row: map, asserted: map) -> list
  let [effective, ready] = native_gen/bind(builder, "effective", asserted)
  ready = native_gen/unless(ready, asserted, fn(arm) => native_kernel/check_retraction(arm, before, row, effective))
  return [effective, ready]
end

verb native_kernel/check_retraction(builder: map, before: map, row: map, effective: map) -> map
  let [was, ready] = native_gen/bind(builder, "was", native_kernel/find_row(builder, before, row,
    native_kernel/tuple_order(native_gen/ref(builder, "zero"))))
  let result: map = native_gen/assign(ready, effective, native_gen/negate(native_kernel/absent(was)))
  return result
end

verb native_kernel/record_delta(builder: map, work: map, before: map, updated: map, row: map, asserted: map) -> map
  let result: map = native_gen/unless(builder, native_gen/equal(before, updated),
    fn(arm) => native_kernel/append_delta(arm, work, updated, row, asserted))
  return result
end

verb native_kernel/append_delta(builder: map, work: map, updated: map, row: map, asserted: map) -> map
  let [delta, ready] = native_gen/bind(builder, "delta", native_kernel/allocate_record(builder, native_gen/ref(builder, "worker"), "Delta",
    {"next" -> native_kernel/load_field(builder, work, "deltas"),
      "relation" -> native_kernel/load_field(builder, updated, "id"), "row" -> row, "asserted" -> asserted}))
  ready = native_gen/when(ready, native_kernel/absent(delta),
    fn(arm) => native_rules/error(arm, "oom"))
  let result: map = native_kernel/store_field(ready, work, "deltas", delta)
  return result
end

// Retractions precede assertions so replacement preserves functional keys.
// These are generation-time phases, not callbacks in the generated module.
verb native_kernel/write_phases() -> list
  return [[:Retract, "false"], [:Assert, "true"]]
end

verb native_kernel/apply_write_phases(builder: map, worker: map, work: map, entry: map, writes: map, before: map) -> map
  let ready: map = builder
  for phase in native_kernel/write_phases()
    let [updated: map, applied: map] = native_rules/checked_call(ready, "apply_writes", [worker, work, writes, before, entry, native_gen/ref(ready, phase[1]), native_roots/ref(ready, "budget")], "relation")
    ready = native_roots/store(applied, entry, updated)
  end
  return ready
end

verb native_kernel/open_transaction(builder: map, failure) -> list
  let [work, ready] = native_gen/bind(builder, "work", native_gen/call(builder, "kernel_work", [native_gen/ref(builder, "transaction")]))
  ready = native_gen/when(ready, native_kernel/absent(work), failure)
  ready = native_gen/when(ready, native_kernel/load_field(ready, work, "done"), failure)
  return [work, ready]
end

verb native_kernel/status(builder: map, status: string) -> map
  if map_contains_key(builder, :scope_parent)
    let result: map = native_roots/return_value(builder, native_gen/ref(builder, status))
    return result
  end
  let result: map = native_gen/return_value(builder, native_gen/ref(builder, status))
  return result
end

verb native_kernel/add_index(builder: map, worker: map, head: map, mask: map) -> map
  let ready = native_gen/assign(builder, head, native_kernel/allocate_record(builder, worker, "Index",
    {"next" -> head, "mask" -> mask, "tree" -> native_gen/zero(native_kernel/pointer("Node"))}))
  let result: map = native_gen/when(ready, native_kernel/absent(head), fn(arm) => native_kernel/status(arm, "kernel_oom"))
  return result
end

verb native_kernel/add_secondary_index(builder: map, worker: map, head: map, indexes: map, keys: map, bit: map) -> map
  let result: map = native_gen/when(builder, native_kernel/column_is_bound(indexes, bit),
    fn(arm) => native_gen/unless(arm, native_gen/equal(bit, keys), fn(distinct) => native_kernel/add_index(distinct, worker, head, bit)))
  return result
end

verb native_kernel/check_declaration_name(builder: map, cursor: map, name: map) -> map
  let ready = native_gen/when(builder, native_kernel/absent(cursor), fn(arm) => native_gen/break_loop(arm))
  let updated = native_kernel/load_field(ready, cursor, "after")
  ready = native_gen/when(ready, native_gen/equal(native_kernel/load_field(ready, updated, "name"), name),
    fn(arm) => native_kernel/status(arm, "kernel_name"))
  let result: map = native_gen/assign(ready, cursor, native_kernel/load_field(ready, cursor, "next"))
  return result
end

verb native_kernel/check_declaration_mask(builder: map, arity: map, keys: map, indexes: map) -> map
  let result: map = native_kernel/check_column_mask(builder, arity, native_gen/bit_or(keys, indexes),
    fn(failed) => native_kernel/status(failed, "kernel_schema"))
  return result
end

verb native_kernel/declare_body(module: map) -> map
  let builder = native_gen/context(module, "kernel_declare")
  let transaction = native_gen/ref(builder, "transaction")
  let id = native_gen/ref(builder, "id")
  let name = native_gen/ref(builder, "name")
  let arity = native_gen/ref(builder, "arity")
  let policy = native_gen/ref(builder, "policy")
  let keys = native_gen/ref(builder, "keys")
  let indexes = native_gen/ref(builder, "indexes")
  let [work, opened] = native_kernel/open_transaction(builder, fn(arm) => native_kernel/status(arm, "kernel_closed"))
  let bounded: map = native_execution/local_budget(opened, native_kernel/load_field(opened, work, "rule_limit"))
  let [worker, ready] = native_gen/bind(bounded, "worker", native_kernel/load_field(bounded, transaction, "worker"))
  builder = native_gen/when(ready, native_kernel/absent(id), fn(arm) => native_kernel/status(arm, "kernel_schema"))
  builder = native_gen/when(builder, native_gen/less(native_gen/ref(builder, "kernel_64"), arity), fn(arm) => native_kernel/status(arm, "kernel_schema"))
  builder = native_gen/when(builder, native_gen/less(native_gen/ref(builder, "kernel_policy_event"), policy), fn(arm) => native_kernel/status(arm, "kernel_schema"))
  builder = native_kernel/check_declaration_mask(builder, arity, keys, indexes)
  builder = native_gen/unless(builder, native_gen/equal(policy, native_gen/ref(builder, "kernel_policy_functional")),
    fn(arm) => native_gen/unless(arm, native_kernel/absent(keys), fn(failed) => native_kernel/status(failed, "kernel_schema")))
  builder = native_gen/unless(builder, native_kernel/absent(native_gen/call(builder, "kernel_view", [transaction, id])),
    fn(arm) => native_kernel/status(arm, "kernel_schema"))
  let [base, with_base] = native_gen/bind(builder, "base", native_kernel/load_field(builder, work, "base"))
  builder = native_gen/unless(with_base, native_kernel/absent(native_gen/call(with_base, "kernel_named",
    [native_kernel/load_field(with_base, base, "relations"), name])), fn(arm) => native_kernel/status(arm, "kernel_name"))
  let [cursor, with_cursor] = native_gen/bind(builder, "cursor", native_kernel/load_field(builder, work, "changes"))
  builder = native_gen/while_loop(with_cursor, native_gen/ref(with_cursor, "true"),
    fn(iteration) => native_kernel/check_declaration_name(iteration, cursor, name))
  let [head, with_head] = native_gen/bind(builder, "head", native_kernel/allocate_record(builder, worker, "Index",
    {"next" -> native_gen/zero(native_kernel/pointer("Index")), "mask" -> native_gen/ref(builder, "zero"), "tree" -> native_gen/zero(native_kernel/pointer("Node"))}))
  builder = native_gen/when(with_head, native_kernel/absent(head), fn(arm) => native_kernel/status(arm, "kernel_oom"))
  builder = native_gen/when(builder, native_gen/equal(policy, native_gen/ref(builder, "kernel_policy_functional")),
    fn(arm) => native_gen/unless(arm, native_kernel/absent(keys), fn(keyed) => native_kernel/add_index(keyed, worker, head, keys)))
  builder = native_kernel/columns(builder, arity, fn(iteration, position, bit) => native_kernel/add_secondary_index(iteration, worker, head, indexes, keys, bit))
  let [relation, with_relation] = native_gen/bind(builder, "relation", native_kernel/allocate_record(builder, worker, "Relation",
    {"next" -> native_gen/zero(native_kernel/pointer("Relation")), "id" -> id, "name" -> name, "arity" -> arity,
      "policy" -> policy, "keys" -> keys, "schema_revision" -> native_gen/ref(builder, "zero"), "indexes" -> head}))
  builder = native_gen/when(with_relation, native_kernel/absent(relation), fn(arm) => native_kernel/status(arm, "kernel_oom"))
  let [created, with_created] = native_gen/bind(builder, "created", native_kernel/allocate_record(builder, worker, "Change",
    {"next" -> native_kernel/load_field(builder, work, "changes"), "before" -> native_gen/zero(native_kernel/pointer("Relation")),
      "after" -> relation, "writes" -> native_gen/zero(native_kernel/pointer("Node"))}))
  builder = native_gen/when(with_created, native_kernel/absent(created), fn(arm) => native_kernel/status(arm, "kernel_oom"))
  builder = native_kernel/store_field(builder, work, "changes", created)
  builder = native_kernel/store_field(builder, work, "dirty", native_gen/ref(builder, "true"))
  builder = native_kernel/status(builder, "kernel_ok")
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/check_functional_key(builder: map, relation: map, row: map) -> map
  let [keys, ready] = native_gen/bind(builder, "keys", native_kernel/load_field(builder, relation, "keys"))
  let [found, with_found] = native_gen/bind(ready, "found", native_kernel/find_row(ready, relation, row, native_kernel/tuple_projection(keys)))
  let identical = native_gen/equal(native_kernel/compare_rows(with_found, row, native_kernel/load_field(with_found, found, "row"),
    native_kernel/tuple_order(native_gen/ref(with_found, "zero"))), native_gen/ref(with_found, "int_zero"))
  let result: map = native_gen/unless(with_found, native_kernel/absent(found),
    fn(arm) => native_gen/unless(arm, identical, fn(failed) => native_kernel/status(failed, "kernel_key")))
  return result
end

verb native_kernel/create_change(builder: map, worker: map, change: map, work: map, relation: map) -> map
  let ready = native_gen/assign(builder, change, native_kernel/allocate_record(builder, worker, "Change",
    {"next" -> native_kernel/load_field(builder, work, "changes"), "before" -> relation, "after" -> relation,
      "writes" -> native_gen/zero(native_kernel/pointer("Node"))}))
  ready = native_gen/when(ready, native_kernel/absent(change), fn(arm) => native_kernel/status(arm, "kernel_oom"))
  let result: map = native_kernel/store_field(ready, work, "changes", change)
  return result
end

verb native_kernel/write_body(module: map) -> map
  let builder = native_gen/context(module, "kernel_write")
  let transaction = native_gen/ref(builder, "transaction")
  let row = native_gen/ref(builder, "row")
  let asserted = native_gen/ref(builder, "asserted")
  let [work, opened] = native_kernel/open_transaction(builder, fn(arm) => native_kernel/status(arm, "kernel_closed"))
  let bounded: map = native_execution/local_budget(opened, native_kernel/load_field(opened, work, "rule_limit"))
  let [worker, ready] = native_gen/bind(bounded, "worker", native_kernel/load_field(bounded, transaction, "worker"))
  let [relation, with_relation] = native_gen/bind(ready, "relation", native_gen/call(ready, "kernel_view", [transaction, native_gen/ref(ready, "id")]))
  builder = native_gen/when(with_relation, native_kernel/absent(relation), fn(arm) => native_kernel/status(arm, "kernel_unknown"))
  builder = native_kernel/check_tuple(builder, row, relation, fn(arm) => native_kernel/status(arm, "kernel_arity"))
  builder = native_gen/unless(builder, native_gen/call(builder, "value_is_persistable", [row]), fn(arm) => native_kernel/status(arm, "kernel_nonpersistent"))
  builder = native_gen/when(builder, asserted, fn(arm) => native_gen/when(arm,
    native_gen/equal(native_kernel/load_field(arm, relation, "policy"), native_gen/ref(arm, "kernel_policy_functional")),
    fn(functional) => native_kernel/check_functional_key(functional, relation, row)))
  let [change, with_change] = native_gen/bind(builder, "change", native_gen/call(builder, "kernel_change", [work, native_gen/ref(builder, "id")]))
  builder = native_gen/when(with_change, native_kernel/absent(change), fn(arm) => native_kernel/create_change(arm, worker, change, work, relation))
  let [updated, with_after] = native_gen/bind(builder, "after", native_gen/call(builder, "kernel_apply", [worker, relation, row, asserted]))
  builder = native_gen/when(with_after, native_kernel/absent(updated), fn(arm) => native_kernel/status(arm, "kernel_oom"))
  let [written, with_written] = native_gen/checked_bind(builder, "written", native_gen/call(builder, "kernel_set",
    [worker, native_kernel/load_field(builder, change, "writes"), row, native_gen/ref(builder, "zero"), native_gen/ref(builder, "false"), asserted]),
    "ok", fn(arm) => native_kernel/status(arm, "kernel_oom"))
  builder = with_written
  builder = native_kernel/store_field(builder, change, "after", updated)
  builder = native_kernel/store_field(builder, change, "writes", native_gen/field(builder, written, "node"))
  builder = native_kernel/store_field(builder, work, "dirty", native_gen/ref(builder, "true"))
  builder = native_kernel/status(builder, "kernel_ok")
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/row_conflict(builder: map, work: map, before: map, row: map) -> map
  let ready = native_kernel/store_field(builder, work, "status", native_gen/ref(builder, "kernel_conflict"))
  ready = native_kernel/store_field(ready, work, "conflict_relation", native_kernel/load_field(ready, before, "id"))
  ready = native_kernel/store_field(ready, work, "conflict_tuple", row)
  let result: map = native_kernel/status(ready, "kernel_conflict")
  return result
end

verb native_kernel/validate_body(module: map) -> map
  let builder = native_rules/context(module, "validate")
  let work = native_roots/ref(builder, "work")
  let writes = native_roots/ref(builder, "writes")
  let before = native_roots/ref(builder, "before")
  let current = native_roots/ref(builder, "current")
  builder = native_gen/when(builder, native_kernel/absent(writes), fn(arm) => native_kernel/status(arm, "kernel_ok"))
  builder = native_gen/when(builder, native_kernel/absent(before), fn(arm) => native_kernel/status(arm, "kernel_ok"))
  builder = native_gen/when(builder, native_gen/equal(before, current), fn(arm) => native_kernel/status(arm, "kernel_ok"))
  builder = native_rules/tick(builder)
  let [row, with_row] = native_gen/bind(builder, "row", native_kernel/load_field(builder, writes, "row"))
  builder = native_gen/when(with_row, native_kernel/absent(current), fn(arm) => native_kernel/row_conflict(arm, work, before, row))
  let [policy, with_policy] = native_gen/bind(builder, "policy", native_kernel/load_field(builder, before, "policy"))
  builder = native_gen/when(with_policy, native_gen/equal(policy, native_gen/ref(with_policy, "kernel_policy_event")),
    fn(arm) => native_kernel/status(arm, "kernel_ok"))
  let [keys, with_keys] = native_gen/bind(builder, "keys", native_gen/ref(builder, "zero"))
  let [prefix, ready] = native_gen/bind(with_keys, "prefix", native_gen/ref(with_keys, "false"))
  builder = native_gen/when(ready, native_gen/equal(policy, native_gen/ref(ready, "kernel_policy_functional")),
    fn(arm) => native_kernel/functional_validation(arm, before, keys, prefix))
  let [base_row, with_base] = native_gen/bind(builder, "base_row", native_gen/call(builder, "kernel_find",
    [native_gen/call(builder, "kernel_index", [before, keys]), row, keys, prefix]))
  let [now_row, with_now] = native_gen/bind(with_base, "now_row", native_gen/call(with_base, "kernel_find",
    [native_gen/call(with_base, "kernel_index", [current, keys]), row, keys, prefix]))
  builder = native_gen/branch(with_now, prefix,
    fn(arm) => native_kernel/validate_key_state(arm, base_row, now_row, fn(failed) => native_kernel/row_conflict(failed, work, before, row)),
    fn(arm) => native_kernel/validate_set_assertion(arm, writes, base_row, now_row, fn(failed) => native_kernel/row_conflict(failed, work, before, row)))
  for side in ["left", "right"]
    builder = native_rules/status_call(builder, "validate", [native_roots/worker(builder), work, native_kernel/load_field(builder, writes, side), before, current, native_roots/ref(builder, "budget")])
  end
  builder = native_kernel/status(builder, "kernel_ok")
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_kernel/functional_validation(builder: map, before: map, keys: map, prefix: map) -> map
  let ready = native_gen/assign(builder, keys, native_kernel/load_field(builder, before, "keys"))
  let result: map = native_gen/assign(ready, prefix, native_gen/ref(ready, "true"))
  return result
end

verb native_kernel/apply_effective_write(builder: map, work: map, before: map, result: map, row: map, asserted: map) -> map
  let [effective, ready] = native_kernel/effective_write(builder, before, row, asserted)
  let completed: map = native_gen/when(ready, effective, fn(arm) => native_kernel/apply_delta(arm, work, result, row, asserted))
  return completed
end

verb native_kernel/apply_delta(builder: map, work: map, result: map, row: map, asserted: map) -> map
  let [updated, ready] = native_gen/bind(builder, "updated", native_gen/call(builder, "kernel_apply",
    [native_roots/worker(builder), result, row, asserted]))
  ready = native_rules/check(ready, native_gen/negate(native_kernel/absent(updated)), "oom")
  ready = native_kernel/record_delta(ready, work, result, updated, row, asserted)
  let completed: map = native_roots/store(ready, result, updated)
  return completed
end

// The write tree is balanced. Root each recursive frame so validation and
// replay can poll between rows without retaining pointers into a moved tree.
verb native_kernel/apply_writes_body(module: map) -> map
  let builder = native_rules/context(module, "apply_writes")
  let worker = native_roots/worker(builder)
  let work = native_roots/ref(builder, "work")
  let writes = native_roots/ref(builder, "writes")
  let before = native_roots/ref(builder, "before")
  let current = native_roots/ref(builder, "current")
  let asserted = native_roots/ref(builder, "asserted")
  builder = native_gen/when(builder, native_kernel/absent(writes), fn(arm) => native_rules/result(arm, native_gen/ref(arm, "kernel_ok"), {"relation" -> current}))
  builder = native_rules/tick(builder)
  let [left: map, with_left: map] = native_rules/checked_call(builder, "apply_writes",
    [worker, work, native_kernel/load_field(builder, writes, "left"), before, current, asserted, native_roots/ref(builder, "budget")], "relation")
  let [result: map, with_result: map] = native_roots/retain(with_left, "result", left)
  let row: map = native_kernel/load_field(with_result, writes, "row")
  builder = native_gen/when(with_result, native_gen/equal(native_kernel/load_field(with_result, writes, "present"), asserted),
    fn(arm) => native_kernel/apply_effective_write(arm, work, before, result, row, asserted))
  builder = native_roots/return_value(builder, native_gen/call(builder, "kernel_apply_writes",
    [worker, work, native_kernel/load_field(builder, writes, "right"), before, result, asserted, native_roots/ref(builder, "budget")]))
  let completed: map = native_gen/finish(module, builder)
  return completed
end

verb native_kernel/transactions(input: map) -> map
  let context: map = input
  let transaction: list = native_kernel/pointer("Transaction")
  let work: list = native_kernel/pointer("Work")
  let change: list = native_kernel/pointer("Change")
  let relation: list = native_kernel/pointer("Relation")
  let node: list = native_kernel/pointer("Node")
  let index: list = native_kernel/pointer("Index")
  let snapshot: list = native_kernel/pointer("Snapshot")
  let delta: list = native_kernel/pointer("Delta")
  let word: list = native_value/word()
  let worker: list = ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]
  let tx: list = ["transaction", transaction, :Borrow]
  for spec in [
    ["work", work, [tx]],
    ["change", change, [["work", work, :Gc], ["id", :U64, :Value]]],
    ["view", relation, [tx, ["id", :U64, :Value]]],
    ["declare", :U64, [tx, ["id", :U64, :Value], ["name", :U64, :Value], ["arity", :U64, :Value], ["policy", :U64, :Value], ["keys", :U64, :Value], ["indexes", :U64, :Value]]],
    ["write", :U64, [tx, ["id", :U64, :Value], ["row", word, :Gc], ["asserted", :Bool, :Value]]],
    ["scan", [:Record, "KernelScanResult"], [tx, ["id", :U64, :Value], ["pattern", word, :Gc], ["mask", :U64, :Value], ["after", word, :Gc], ["output", native_memory/pointer(word), :Borrow], ["capacity", :U64, :Value]]],
    ["validate", :U64, [worker, ["work", work, :Gc], ["writes", node, :Gc], ["before", relation, :Gc], ["current", relation, :Gc], ["budget", native_kernel/pointer("Budget"), :Borrow]]],
    ["apply_writes", [:Record, "KernelRelationResult"], [worker, ["work", work, :Gc], ["writes", node, :Gc], ["before", relation, :Gc], ["current", relation, :Gc], ["asserted", :Bool, :Value], ["budget", native_kernel/pointer("Budget"), :Borrow]]],
    ["version", :U64, [tx]], ["deltas", delta, [tx]]]
    context = native_kernel/declare(context, spec[0], spec[1], spec[2], native/contains(["scan", "validate", "apply_writes"], spec[0]))
  end
  context = native_kernel/define(context, "work", [
    native/let_statement("pointer", native_memory/pointer(:U8), native_memory/root(native_memory/pointer(:U8), native_kernel/transaction_root(), "pointer")),
    native/return_value(native/unary_expression(:PointerCast, "pointer"))])
  context = native_kernel/define(context, "change", [
    @native_kernel/walk("Change", "cursor", native_kernel/read("Work", "work", "changes"), [
      native/when_statement(native_kernel/binary(:Equal, native_kernel/read("Relation", native_kernel/read("Change", "cursor", "after"), "id"), "id"), [native/return_value("cursor")])],
      [native/return_value("cursor")]), native/return_value(native_kernel/null("Change"))])
  let load_work: list = [native/let_call("work", work, "kernel_work", ["transaction"])]
  context = native_kernel/define(context, "view", [@load_work,
    native/when_statement(native_kernel/is_null("Work", "work"), [native/return_value(native_kernel/null("Relation"))]),
    native/let_call("change", change, "kernel_change", ["work", "id"]),
    native/unless_statement(native_kernel/is_null("Change", "change"), [native/return_value(native_kernel/read("Change", "change", "after"))]),
    native/return_value(native/call_expression("kernel_relation", [native_kernel/read("Snapshot", native_kernel/read("Work", "work", "base"), "relations"), "id"]))])
  context = native_kernel/declare_body(context)
  context = native_kernel/write_body(context)
  context = native_kernel/define(context, "version", [@load_work,
    native/when_statement(native_kernel/is_null("Work", "work"), [native/return_value("zero")]),
    native/let_statement("snapshot", snapshot, native_kernel/read("Work", "work", "candidate")),
    native/when_statement(native_kernel/is_null("Snapshot", "snapshot"), [native/set_statement("snapshot", native_kernel/read("Work", "work", "base"))]),
    native/return_value(native_kernel/read("Snapshot", "snapshot", "version"))])
  context = native_kernel/define(context, "deltas", [@load_work,
    native/when_statement(native_kernel/is_null("Work", "work"), [native/return_value(native_kernel/null("Delta"))]),
    native/unless_statement(native_kernel/read("Work", "work", "done"), [native/return_value(native_kernel/null("Delta"))]),
    native/return_value(native_kernel/read("Work", "work", "deltas"))])
  context = native_kernel/validate_body(context)
  context = native_kernel/apply_writes_body(context)
  return context
end
