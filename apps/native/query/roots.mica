verb native_query/context(module: map, name: string) -> map
  let rooted: map = native_query/begin_roots(native_gen/context(module, name))
  let result: map = native_query/charge(rooted, native_roots/ref(rooted, "zero"), native_roots/ref(rooted, "zero"))
  return result
end
verb native_query/begin_roots(builder: map) -> map
  let result: map = native_roots/open_scope(builder, fn(failed, reason) => native_query/error(failed, reason))
  return result
end
verb native_query/poll_interval(builder: map, progress: map) -> map
  let charged: map = native_query/charge(builder, native_roots/ref(builder, "one"), native_roots/ref(builder, "zero"))
  let boundary: map = native_kernel/absent(native_gen/bit_and(progress, native_roots/ref(builder, "query_poll_mask")))
  let result: map = native_gen/when(charged, boundary, fn(poll) => native_roots/poll(poll))
  return result
end
