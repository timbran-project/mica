// Query builders specialize row operations into native functions. They own
// iteration, allocation checks, and canonical set construction; operators
// describe which rows and columns to keep.
// Helpers with a budget parameter participate in the caller's operation.
verb native_query/call(builder: map, name: string, input: list) -> map
  let arguments: list = input
  let params: map = builder[:module][:bindings][name]
  if map_contains_key(params, "budget")
    arguments = [@arguments, native_roots/ref(builder, "budget")]
  end
  let result: map = native_gen/call(builder, name, arguments)
  return result
end
verb native_query/charge(builder: map, steps: map, rows: map) -> map
  let result: map = native_execution/charge(builder, steps, rows, native_roots/ref(builder, "zero"), fn(failed, status) => native_query/fail(failed, status))
  return result
end
verb native_query/width(builder: map, row: map) -> map
  let generated_result: map = native_query/call(builder, "kernel_width", [row])
  return generated_result
end
verb native_query/cell(builder: map, row: map, position: map) -> map
  let generated_result: map = native_query/call(builder, "kernel_cell", [row, position])
  return generated_result
end
verb native_query/fail(builder: map, status: map) -> map
  if builder[:result] == [:Record, "ValueResult"]
    let result: map = native_roots/return_value(builder, native_gen/zero(builder[:result]))
    return result
  end
  let result: map = native_execution/fail(builder, status)
  return result
end

verb native_query/error(input: map, name: string) -> map
  let builder: map = input
  if name == "oom" && native_execution/has(builder, "budget")
    let status: map = native_kernel/load_field(builder, native_roots/ref(builder, "budget"), "status")
    builder = native_gen/unless(builder, native_kernel/absent(status), fn(failed) => native_query/fail(failed, status))
  end
  let generated_result: map = native_query/fail(builder, native_roots/ref(builder, string_concat("kernel_", name)))
  return generated_result
end
verb native_query/check(builder: map, condition: map, error: string) -> map
  let generated_result: map = native_gen/unless(builder, condition, fn(failed) => native_query/error(failed, error))
  return generated_result
end
verb native_query/value(builder: map, name: string, arguments: list) -> list
  let [result: map, ready: map] = native_gen/checked_bind(builder, "value", native_query/call(builder, name, arguments), "ok",
    fn(failed) => native_query/error(failed, "oom"))
  return [native_gen/field(ready, result, "value"), ready]
end
verb native_query/status_call(builder: map, name: string, arguments: list) -> map
  let [status: map, ready: map] = native_gen/bind(builder, "status", native_query/call(builder, name, arguments))
  let generated_result: map = native_gen/unless(ready, native_kernel/absent(status), fn(failed) => native_query/fail(failed, status))
  return generated_result
end
verb native_query/each_row(builder: map, rows: map, body) -> map
  let generated_result: map = native_gen/for_range(builder, "row_index", native_gen/zero(:U64), native_query/width(builder, rows), fn(iteration, index)
    let polled: map = native_query/poll_interval(iteration, index)
    let [row: map, ready: map] = native_gen/bind(polled, "row", native_query/cell(polled, rows, index))
    return body(ready, row)
  end)
  return generated_result
end

// Allocate the complete row once. No operation here is a safepoint; its
// descriptor sees the initialized row only after this helper returns.
verb native_query/build_row(builder: map, width: map, cell) -> list
  let charged: map = native_query/charge(builder, width, native_roots/ref(builder, "one"))
  let [header: map, ready: map] = native_gen/bind(charged, "row_storage", native_query/call(charged, "list_allocate",
    [native_roots/ref(builder, "worker"), width, width]))
  ready = native_query/check(ready, native_gen/negate(native_kernel/absent(header)), "oom")
  let [data: map, with_data: map] = native_gen/bind(ready, "cells", native_kernel/load_field(ready, header, "data"))
  ready = native_gen/for_range(with_data, "column", native_gen/zero(:U64), width, fn(iteration, position)
    let generated_result: map = native_gen/store(iteration, native_gen/offset(data, position), cell(iteration, position))
    return generated_result
  end)
  let [row: map, completed: map] = native_gen/bind(ready, "row", native_gen/expression(native_value/word(), :PackPointer,
    [header, native_roots/ref(ready, "tag_list")]))
  return [row, completed]
end
verb native_query/project_row(builder: map, row: map, positions: map) -> list
  let generated_result: list = native_query/build_row(builder, native_query/width(builder, positions), fn(iteration, index)
    let position: map = native_gen/expression(:U64, :Payload, [native_query/cell(iteration, positions, index)])
    return native_query/cell(iteration, row, position)
  end)
  return generated_result
end
verb native_query/check_positions(builder: map, positions: map, arity: map) -> map
  let ready: map = native_query/check(builder,
    native_gen/equal(native_gen/expression(:U8, :Tag, [positions]), native_roots/ref(builder, "tag_list")), "schema")
  let generated_result: map = native_query/each_row(ready, positions, fn(iteration, value)
    let [position: map, checked: map] = native_gen/checked_bind(iteration, "position", native_query/call(iteration, "value_as_int", [value]), "ok",
      fn(failed) => native_query/error(failed, "schema"))
    let number: map = native_gen/field(checked, position, "number")
    checked = native_query/check(checked, native_gen/negate(native_gen/less(number, native_roots/ref(checked, "int_zero"))), "schema")
    return native_query/check(checked, native_gen/less(native_gen/expression(:U64, :Convert, [number]), arity), "schema")
  end)
  return generated_result
end
verb native_query/row_set(builder: map) -> list
  let generated_result: list = native_roots/retain(builder, "rows", native_gen/zero(native_kernel/pointer("Node")))
  return generated_result
end
verb native_query/offer(builder: map, tree: map, row: map) -> map
  let [updated: map, ready: map] = native_gen/bind(builder, "inserted", native_query/call(builder, "kernel_query_insert",
    [native_roots/ref(builder, "worker"), tree, row]))
  ready = native_query/check(ready, native_gen/negate(native_kernel/absent(updated)), "oom")
  let result: map = native_roots/store(ready, tree, updated)
  return result
end
verb native_query/finish_rows(builder: map, tree: map, arity: map) -> map
  let generated_result: map = native_roots/return_value(builder, native_query/call(builder, "kernel_query_finish",
    [native_roots/ref(builder, "worker"), tree, arity]))
  return generated_result
end
verb native_query/checked_query(builder: map, name: string, arguments: list) -> list
  let [result: map, ready: map] = native_gen/bind(builder, "query_result", native_query/call(builder, name, arguments))
  ready = native_gen/unless(ready, native_kernel/absent(native_gen/field(ready, result, "status")),
    fn(failed) => native_roots/return_value(failed, result))
  let [arity: map, with_arity: map] = native_gen/bind(ready, "arity", native_gen/field(ready, result, "arity"))
  let [rows: map, rooted: map] = native_roots/retain(with_arity, "rows", native_gen/field(with_arity, result, "rows"))
  return [native_gen/record(rooted, [:Record, "KernelQueryResult"],
    {"status" -> native_gen/zero(:U64), "arity" -> arity, "rows" -> rows}), rooted]
end

// Index entries store [projected key, original row]. Ordered key lists
// preserve arbitrary column order and repeated positions.
verb native_query/index_entry(builder: map, key: map, row: map) -> list
  let [entry: map, ready: map] = native_query/build_row(builder, native_roots/ref(builder, "two"), fn(body, position) => native_gen/zero(native_value/word()))
  let header: map = native_gen/expression(native_memory/record_pointer("HeapList"), :UnpackPointer, [entry])
  let data: map = native_kernel/load_field(ready, header, "data")
  ready = native_gen/store(ready, data, key)
  ready = native_gen/store(ready, native_gen/offset(data, native_roots/ref(ready, "one")), row)
  return [entry, ready]
end

verb native_query/concat_rows(builder: map, left: map, right: map) -> list
  let width: map = native_gen/add(native_query/width(builder, left), native_query/width(builder, right))
  let [row: map, ready: map] = native_query/build_row(builder, width, fn(body, index) => native_gen/zero(native_value/word()))
  let header: map = native_gen/expression(native_memory/record_pointer("HeapList"), :UnpackPointer, [row])
  let data: map = native_kernel/load_field(ready, header, "data")
  let offset: map = native_gen/zero(:U64)
  for input in [left, right]
    ready = native_gen/for_range(ready, "column", native_gen/zero(:U64), native_query/width(ready, input), fn(body, index)
      let generated_result: map = native_gen/store(body, native_gen/offset(data, native_gen/add(offset, index)), native_query/cell(body, input, index))
      return generated_result
    end)
    offset = native_query/width(ready, left)
  end
  return [row, ready]
end

verb native_query/gather_body(module: map) -> map
  let builder: map = native_query/context(module, "kernel_query_gather")
  let node: map = native_roots/ref(builder, "node")
  let worker: map = native_roots/ref(builder, "worker")
  let rows: map = native_roots/ref(builder, "rows")
  builder = native_gen/when(builder, native_kernel/absent(node), fn(empty)
    let generated_result: map = native_roots/return_value(empty, native_gen/record(empty, [:Record, "ValueResult"],
      {"ok" -> native_roots/ref(empty, "true"), "value" -> rows}))
    return generated_result
  end)
  let [before: map, with_before: map] = native_query/value(builder, "kernel_query_gather",
    [worker, native_kernel/load_field(builder, node, "left"), rows])
  let [through: map, with_through: map] = native_query/value(with_before, "kernel_query_append",
    [worker, before, native_kernel/load_field(with_before, node, "row")])
  builder = native_roots/store(with_through, rows, through)
  builder = native_query/poll_interval(builder, native_query/width(builder, rows))
  builder = native_roots/return_value(builder, native_query/call(builder, "kernel_query_gather",
    [worker, native_kernel/load_field(builder, node, "right"), rows]))
  let generated_result: map = native_gen/finish(module, builder)
  return generated_result
end

verb native_query/finish_body(module: map) -> map
  let builder: map = native_query/context(module, "kernel_query_finish")
  let [empty: map, with_empty: map] = native_query/build_row(builder, native_gen/zero(:U64), fn(body, position) => native_gen/zero(native_value/word()))
  let [rows: map, ready: map] = native_query/value(with_empty, "kernel_query_gather",
    [native_roots/ref(with_empty, "worker"), native_roots/ref(with_empty, "tree"), empty])
  builder = native_roots/return_value(ready, native_gen/record(ready, [:Record, "KernelQueryResult"],
    {"status" -> native_roots/ref(ready, "kernel_ok"), "arity" -> native_roots/ref(ready, "arity"), "rows" -> rows}))
  let generated_result: map = native_gen/finish(module, builder)
  return generated_result
end

// This buffer belongs to one query until finish_rows publishes its result.
// Mutate its sole list header and backing storage, including after collection;
// no persistent list view or relation index can alias this private buffer.
verb native_query/append_body(module: map) -> map
  let builder: map = native_gen/context(module, "kernel_query_append")
  builder = native_query/charge(builder, native_roots/ref(builder, "one"), native_roots/ref(builder, "one"))
  let word: list = native_value/word()
  let pointer: list = native_memory/record_pointer("HeapList")
  let [header: map, ready: map] = native_gen/bind(builder, "buffer", native_gen/expression(pointer, :UnpackPointer, [native_gen/ref(builder, "rows")]))
  let [length: map, with_length: map] = native_gen/bind(ready, "length", native_kernel/load_field(ready, header, "length"))
  ready = with_length
  let storage: map = native_kernel/load_field(ready, header, "storage")
  ready = native_gen/when(ready, native_gen/equal(length, native_kernel/load_field(ready, storage, "capacity")), fn(growth)
    let grow: map = native_query/charge(growth, length, native_roots/ref(growth, "zero"))
    let capacity: map = native_gen/add(native_gen/add(length, length), native_gen/ref(grow, "one"))
    let [larger: map, allocated: map] = native_gen/bind(grow, "larger", native_query/call(grow, "list_allocate", [native_gen/ref(grow, "worker"), length, capacity]))
    allocated = native_gen/when(allocated, native_kernel/absent(larger), fn(failed) => native_gen/return_value(failed, native_gen/zero([:Record, "ValueResult"])))
    let source: map = native_kernel/load_field(allocated, header, "data")
    let target: map = native_kernel/load_field(allocated, larger, "data")
    allocated = native_gen/for_range(allocated, "copy", native_gen/zero(:U64), length, fn(copy, index)
      return native_gen/store(copy, native_gen/offset(target, index), native_gen/load(native_gen/offset(source, index)))
    end)
    return native_gen/assign(allocated, header, larger)
  end)
  ready = native_gen/store(ready, native_gen/offset(native_kernel/load_field(ready, header, "data"), length), native_gen/ref(ready, "element"))
  let total: map = native_gen/add(length, native_gen/ref(ready, "one"))
  ready = native_kernel/store_field(ready, header, "length", total)
  ready = native_kernel/store_field(ready, native_kernel/load_field(ready, header, "storage"), "used", total)
  ready = native_gen/return_value(ready, native_gen/record(ready, [:Record, "ValueResult"],
    {"ok" -> native_gen/ref(ready, "true"), "value" -> native_gen/expression(word, :PackPointer, [header, native_gen/ref(ready, "tag_list")])}))
  let result: map = native_gen/finish(module, ready)
  return result
end
