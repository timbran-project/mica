verb native_tasks/drop_prepared(builder: map) -> map
  let ready: map = builder
  for name in ["committed_view", "prepared"]
    let root: map = native_tasks/control_slot(ready, name)
    ready = native_gen/unless(ready, native_kernel/absent(native_kernel/load_field(ready, root, "registration")), fn(present)
      let [released: map, cleared: map] = native_gen/bind(present, "released", native_gen/call(present, "memory_unpublish", [native_gen/ref(present, "worker"), root]))
      return cleared
    end)
  end
  return ready
end

verb native_tasks/prepare_body(module: map) -> map
  let builder: map = native_gen/context(module, "task_prepare")
  let kind: map = native_tasks/attempt_field(builder, "boundary")
  builder = native_gen/when(builder, native_gen/less(kind, native_gen/ref(builder, "task_boundary_complete")), fn(invalid) => native_tasks/attempt_status(invalid, "schema"))
  builder = native_gen/when(builder, native_gen/less(native_gen/ref(builder, "task_boundary_continue"), kind), fn(invalid) => native_tasks/attempt_status(invalid, "schema"))
  builder = native_tasks/lock(builder)
  builder = native_gen/unless(builder, native_gen/equal(native_tasks/control_field(builder, "state"), native_gen/ref(builder, "task_state_running")), fn(invalid) => native_tasks/locked_status(invalid, "closed"))
  builder = native_gen/when(builder, native_tasks/control_field(builder, "cancel_requested"), fn(cancelled) => native_tasks/locked_status(cancelled, "cancelled"))
  builder = native_gen/when(builder, native_gen/equal(kind, native_gen/ref(builder, "task_boundary_wait")), fn(waiting)
    return native_gen/when(waiting, native_gen/equal(native_tasks/control_field(waiting, "generation"), native_gen/ref(waiting, "kernel_unlimited")),
      fn(exhausted) => native_tasks/locked_status(exhausted, "limit"))
  end)
  let [generation: map, with_generation: map] = native_gen/bind(builder, "generation", native_tasks/control_field(builder, "generation"))
  builder = native_gen/when(with_generation, native_gen/equal(kind, native_gen/ref(with_generation, "task_boundary_wait")),
    fn(waiting) => native_gen/assign(waiting, generation, native_gen/add(generation, native_gen/ref(waiting, "one"))))
  builder = native_tasks/drop_prepared(builder)
  builder = native_tasks/unlock(builder)
  // The running worker owns preparation. A partial failure must unregister
  // both roots before returning; cancellation only changes the control flags.
  builder = native_gen/on_return(builder, fn(leaving, status)
    return native_gen/unless(leaving, native_kernel/absent(status), fn(failed) => native_tasks/drop_prepared(failed))
  end)
  // Ordering and publication can traverse large graphs. The kernel's memory
  // control checks cancellation and resource limits inside those operations.
  let work: map = native_gen/call(builder, "kernel_work", [native_tasks/slot(builder, "transaction")])
  let limits: map = {"signal" -> native_kernel/load_field(builder, native_tasks/slot(builder, "transaction"), "signal"),
    "status" -> native_gen/ref(builder, "kernel_ok"), "steps" -> native_kernel/load_field(builder, work, "rule_limit")}
  for field in ["rows", "rounds", "bytes"]
    limits[field] = native_kernel/load_field(builder, work, string_concat(field, "_limit"))
  end
  builder = native_execution/budget_scope(builder, native_gen/ref(builder, "worker"), limits)
  builder = native_roots/open_scope(builder, fn(failed, reason) => native_roots/return_value(failed, native_gen/ref(failed, string_concat("kernel_", reason))))
  let [ordered: map, with_ordered: map] = native_roots/retain(builder, "ordered", native_gen/zero(native_tasks/pointer("Effect")))
  let [status: map, prepared: map] = native_gen/bind(with_ordered, "status", native_gen/call(with_ordered, "task_order_effects",
    [native_gen/ref(with_ordered, "worker"), native_tasks/slot(with_ordered, "effects"), ordered[:scope_root]]))
  builder = native_gen/unless(prepared, native_kernel/absent(status), fn(failed) => native_roots/return_value(failed, status))
  let [boundary: map, allocated: map] = native_roots/retain(builder, "boundary", native_gen/call(builder, "task_new_Boundary",
    [native_gen/ref(builder, "worker"), native_tasks/saved(builder, "current", native_tasks/pointer("Image")), ordered, kind, generation,
      native_tasks/saved(builder, "request", native_tasks/pointer("WaitRequest"))]))
  builder = native_tasks/check(allocated, native_gen/negate(native_kernel/absent(boundary)), "oom")
  // Reserve a published root before commit. Success stores the already frozen
  // candidate here without allocating, even when commit history has advanced.
  let [view: map, with_view: map] = native_roots/retain(builder, "committed_view", native_gen/zero(native_kernel/pointer("Snapshot")))
  builder = native_tasks/check(with_view, native_gen/call(with_view, "memory_publish", [native_gen/ref(with_view, "worker"), view[:scope_root], native_tasks/control_slot(with_view, "committed_view")]), "oom")
  builder = native_tasks/check(builder, native_gen/call(builder, "memory_publish", [native_gen/ref(builder, "worker"), boundary[:scope_root], native_tasks/control_slot(builder, "prepared")]), "oom")
  builder = native_roots/return_value(builder, native_gen/ref(builder, "kernel_ok"))
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_tasks/commit_boundary_body(module: map) -> map
  let builder: map = native_gen/context(module, "task_commit")
  for name in ["prepared", "committed_view"]
    let shared: map = native_tasks/control_slot(builder, name)
    builder = native_gen/when(builder, native_kernel/absent(native_kernel/load_field(builder, shared, "registration")), fn(unprepared) => native_tasks/attempt_status(unprepared, "closed"))
  end
  let tx: map = native_tasks/slot(builder, "transaction")
  let [status: map, committed: map] = native_gen/bind(builder, "status", native_gen/call(builder, "kernel_commit", [tx]))
  builder = native_tasks/lock(committed)
  for field in ["remaining", "retries"]
    builder = native_tasks/control_store(builder, field, native_tasks/attempt_field(builder, field))
  end
  // The publication outcome is recorded before delivery can start. An error
  // from a delivery service must never authorize replay of this transaction.
  builder = native_gen/when(builder, native_kernel/load_field(builder, native_gen/call(builder, "kernel_work", [tx]), "done"), fn(success)
    let view: map = native_roots/root_value(success, native_tasks/control_slot(success, "committed_view"), native_kernel/pointer("Snapshot"))
    let captured: map = native_roots/store(success, view, native_kernel/load_field(success, native_gen/call(success, "kernel_work", [tx]), "candidate"))
    let ready: map = native_tasks/control_store(captured, "committed", native_gen/ref(captured, "true"))
    ready = native_tasks/control_store(ready, "status", status)
    ready = native_tasks/state(ready, "delivering")
    let boundary: map = native_roots/root_value(ready, native_tasks/control_slot(ready, "prepared"), native_tasks/pointer("Boundary"))
    ready = native_gen/when(ready, native_gen/equal(native_kernel/load_field(ready, boundary, "kind"), native_gen/ref(ready, "task_boundary_wait")), fn(waiting)
      return native_tasks/control_store(waiting, "generation", native_kernel/load_field(waiting, boundary, "generation"))
    end)
    return native_gen/return_value(native_tasks/unlock(ready), status)
  end)
  builder = native_tasks/control_store(builder, "status", status)
  builder = native_tasks/drop_prepared(builder)
  builder = native_gen/unless(builder, native_gen/equal(status, native_gen/ref(builder, "kernel_conflict")), fn(terminal)
    return native_gen/branch(terminal, native_gen/equal(status, native_gen/ref(terminal, "kernel_cancelled")),
      fn(cancelled) => native_tasks/state(cancelled, "cancelled"), fn(failed) => native_tasks/state(failed, "failed"))
  end)
  builder = native_gen/return_value(native_tasks/unlock(builder), status)
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_tasks/acknowledge_body(module: map) -> map
  let builder: map = native_tasks/lock(native_gen/context(module, "task_acknowledge"))
  builder = native_gen/unless(builder, native_gen/equal(native_tasks/control_field(builder, "state"), native_gen/ref(builder, "task_state_delivering")), fn(wrong) => native_tasks/locked_status(wrong, "closed"))
  builder = native_gen/unless(builder, native_tasks/control_field(builder, "committed"), fn(wrong) => native_tasks/locked_status(wrong, "closed"))
  builder = native_gen/unless(builder, native_tasks/control_field(builder, "delivery_claimed"), fn(unclaimed) => native_tasks/locked_status(unclaimed, "closed"))
  builder = native_gen/unless(builder, native_kernel/absent(native_tasks/control_field(builder, "active")), fn(busy) => native_tasks/locked_status(busy, "closed"))
  let boundary: map = native_roots/root_value(builder, native_tasks/control_slot(builder, "prepared"), native_tasks/pointer("Boundary"))
  let [kind: map, ready: map] = native_gen/bind(builder, "kind", native_kernel/load_field(builder, boundary, "kind"))
  builder = native_roots/store(ready, native_roots/root_value(ready, native_tasks/control_slot(ready, "image"), native_tasks/pointer("Image")), native_kernel/load_field(ready, boundary, "image"))
  builder = native_tasks/control_store(builder, "status", native_gen/ref(builder, "status"))
  builder = native_tasks/state(builder, "failed")
  builder = native_gen/when(builder, native_kernel/absent(native_gen/ref(builder, "status")), fn(success)
    let cases: list = []
    for spec in [["complete", "completed"], ["wait", "waiting"], ["continue", "runnable"]]
      cases = [@cases, [native_gen/ref(success, string_concat("task_boundary_", spec[0])), fn(arm) => native_tasks/state(arm, spec[1])]]
    end
    return native_gen/switch(success, kind, cases, fn(invalid) => native_tasks/state(invalid, "failed"))
  end)
  let event: map = native_tasks/control_slot(builder, "event")
  builder = native_gen/unless(builder, native_kernel/absent(native_kernel/load_field(builder, event, "registration")), fn(delivered)
    let ready: map = native_gen/when(delivered, native_gen/equal(native_tasks/control_field(delivered, "state"), native_gen/ref(delivered, "task_state_waiting")), fn(waiting)
      let resumed: map = native_roots/store(waiting, native_roots/root_value(waiting, native_tasks/control_slot(waiting, "image"), native_tasks/pointer("Image")),
        native_roots/root_value(waiting, event, native_tasks/pointer("Image")))
      return native_tasks/state(resumed, "runnable")
    end)
    let [released: map, cleared: map] = native_gen/bind(ready, "released", native_gen/call(ready, "memory_unpublish", [native_gen/ref(ready, "worker"), event]))
    return cleared
  end)
  builder = native_gen/when(builder, native_tasks/control_field(builder, "cancel_requested"), fn(cancelled) => native_tasks/state(cancelled, "cancelled"))
  builder = native_tasks/drop_prepared(builder)
  builder = native_tasks/locked_status(builder, "ok")
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_tasks/delivery_body(module: map) -> map
  let builder: map = native_tasks/lock(native_gen/context(module, "task_delivery"))
  builder = native_gen/unless(builder, native_gen/equal(native_tasks/control_field(builder, "state"), native_gen/ref(builder, "task_state_delivering")), fn(unavailable) => native_tasks/locked_status(unavailable, "closed"))
  builder = native_gen/unless(builder, native_kernel/absent(native_tasks/control_field(builder, "active")), fn(running) => native_tasks/locked_status(running, "closed"))
  builder = native_gen/when(builder, native_tasks/control_field(builder, "delivery_claimed"), fn(claimed) => native_tasks/locked_status(claimed, "closed"))
  builder = native_gen/unless(builder, native_gen/call(builder, "memory_acquire", [native_gen/ref(builder, "worker"), native_tasks/control_slot(builder, "prepared"), native_gen/ref(builder, "delivery")]), fn(failed) => native_tasks/locked_status(failed, "closed"))
  builder = native_tasks/control_store(builder, "delivery_claimed", native_gen/ref(builder, "true"))
  builder = native_tasks/locked_status(builder, "ok")
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_tasks/wake_body(module: map) -> map
  let builder: map = native_tasks/context(module, "wake")
  builder = native_tasks/lock(builder)
  builder = native_gen/on_return(builder, fn(leaving, result) => native_tasks/unlock(leaving))
  let [waiting: map, ready: map] = native_gen/bind(builder, "waiting", native_gen/equal(native_tasks/control_field(builder, "state"), native_gen/ref(builder, "task_state_waiting")))
  builder = native_gen/unless(ready, waiting, fn(early)
    let checked: map = native_tasks/check(early, native_gen/equal(native_tasks/control_field(early, "state"), native_gen/ref(early, "task_state_delivering")), "closed")
    checked = native_tasks/check(checked, native_tasks/control_field(checked, "committed"), "closed")
    let boundary: map = native_roots/root_value(checked, native_tasks/control_slot(checked, "prepared"), native_tasks/pointer("Boundary"))
    return native_tasks/check(checked, native_gen/equal(native_kernel/load_field(checked, boundary, "kind"), native_gen/ref(checked, "task_boundary_wait")), "closed")
  end)
  builder = native_tasks/check(builder, native_gen/negate(native_tasks/control_field(builder, "cancel_requested")), "closed")
  builder = native_tasks/check(builder, native_gen/equal(native_tasks/control_field(builder, "generation"), native_gen/ref(builder, "generation")), "closed")
  let event: map = native_tasks/control_slot(builder, "event")
  builder = native_tasks/check(builder, native_kernel/absent(native_kernel/load_field(builder, event, "registration")), "closed")
  let [image: map, with_image: map] = native_roots/retain(builder, "image", native_gen/zero(native_tasks/pointer("Image")))
  builder = native_gen/branch(with_image, waiting,
    fn(registered) => native_roots/store(registered, image, native_roots/root_value(registered, native_tasks/control_slot(registered, "image"), native_tasks/pointer("Image"))),
    fn(early)
      let boundary: map = native_roots/root_value(early, native_tasks/control_slot(early, "prepared"), native_tasks/pointer("Boundary"))
      return native_roots/store(early, image, native_kernel/load_field(early, boundary, "image"))
    end)
  let [status: map, delivered: map] = native_gen/bind(builder, "status", native_gen/call(builder, "task_deliver_image",
    [native_gen/ref(builder, "worker"), image[:scope_root], native_roots/ref(builder, "input")]))
  builder = native_gen/unless(delivered, native_kernel/absent(status), fn(failed) => native_roots/return_value(failed, status))
  builder = native_tasks/check(builder, native_gen/call(builder, "memory_publish", [native_gen/ref(builder, "worker"), image[:scope_root], event]), "oom")
  builder = native_gen/when(builder, waiting, fn(registered)
    let ready: map = native_roots/store(registered, native_roots/root_value(registered, native_tasks/control_slot(registered, "image"), native_tasks/pointer("Image")), image)
    let [released: map, cleared: map] = native_gen/bind(ready, "released", native_gen/call(ready, "memory_unpublish", [native_gen/ref(ready, "worker"), event]))
    return native_tasks/state(cleared, "runnable")
  end)
  builder = native_tasks/attempt_status(builder, "ok")
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_tasks/boundaries(input: map) -> map
  let module: map = input
  let task: list = ["task", native_tasks/pointer("Control"), :Borrow]
  let worker: list = ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]
  let attempt: list = ["attempt", native_tasks/pointer("Attempt"), :Borrow]
  for name in ["prepare", "commit"]
    module = native_tasks/declare(module, name, :U64, [task, worker, attempt])
  end
  module = native_tasks/declare(module, "acknowledge", :U64, [task, worker, ["status", :U64, :Value]])
  module = native_tasks/declare(module, "delivery", :U64, [task, worker, ["delivery", native_memory/record_pointer("MemoryRoot"), :Borrow]])
  module = native_tasks/declare(module, "wake", :U64, [task, worker, ["generation", :U64, :Value], ["input", native_value/word(), :Gc]])
  module = native_tasks/prepare_body(module)
  module = native_tasks/commit_boundary_body(module)
  module = native_tasks/acknowledge_body(module)
  module = native_tasks/delivery_body(module)
  module = native_tasks/wake_body(module)
  return module
end
