// MethodProgram links method identities to compiled artifact identities. Neither
// selector identity nor method identity is a compiled-program catalogue key.
verb native_calls/program_for(builder: map, identity: map) -> list
  let [view: map, read: map] = native_dispatch/checked_result(builder, "kernel_read", [
    native_tasks/slot(builder, "transaction"), native_gen/ref(builder, "programs")], "relation")
  let [catalogue: map, retained: map] = native_roots/retain(read, "program_bindings", view)
  let ready: map = native_query/check(retained, native_gen/equal(native_kernel/load_field(retained, catalogue, "arity"), native_gen/ref(retained, "two")), "arity")
  let [pattern: map, built: map] = native_query/tuple(ready, [identity, native_gen/zero(native_value/word())])
  let [key: map, rooted: map] = native_roots/retain(built, "method_key", pattern)
  let [artifact: map, allocated: map] = native_roots/retain(rooted, "artifact", native_gen/zero(native_value/word()))
  let [found: map, with_flag: map] = native_gen/bind(allocated, "found", native_gen/ref(allocated, "false"))
  let [ticks: map, scanning: map] = native_gen/bind(with_flag, "bindings", native_gen/ref(with_flag, "zero"))
  ready = native_query/scan_rows(scanning, catalogue, key, native_gen/ref(scanning, "one"), native_gen/address(ticks), fn(step, row)
    let unique: map = native_query/check(step, native_gen/negate(found), "schema")
    unique = native_roots/store(unique, artifact, native_query/cell(unique, row, native_gen/ref(unique, "one")))
    return native_gen/assign(unique, found, native_gen/ref(unique, "true"))
  end)
  ready = native_query/check(ready, found, "unknown")
  let [decoded: map, checked: map] = native_gen/checked_bind(ready, "program_id", native_gen/call(ready, "value_as_identity", [artifact]), "ok",
    fn(invalid) => native_query/error(invalid, "schema"))
  let [program: map, selected: map] = native_dispatch/checked_result(checked, "kernel_program_get", [
    native_tasks/slot(checked, "transaction"), native_gen/field(checked, decoded, "number")], "program")
  let [retained_program: map, with_program: map] = native_roots/retain(selected, "program", program)
  ready = native_query/check(with_program, native_gen/negate(native_kernel/absent(retained_program)), "unknown")
  let raw: map = native_kernel/load_field(ready, retained_program, "body")
  let object: map = native_gen/call(ready, "memory_object", [raw])
  ready = native_query/check(ready, native_gen/equal(native_kernel/load_field(ready, object, "layout"), native_gen/ref(ready, "task_layout_CompiledProgram")), "schema")
  let [body: map, with_body: map] = native_roots/retain(ready, "body", native_gen/cast(native_tasks/pointer("CompiledProgram"), raw))
  ready = native_query/check(with_body, native_gen/negate(native_kernel/absent(native_kernel/load_field(with_body, body, "entry"))), "schema")
  let code: map = native_kernel/load_field(ready, body, "code")
  ready = native_gen/unless(ready, native_kernel/absent(code), fn(loaded)
    let owner: map = native_kernel/load_field(loaded, code, "owner")
    let checked: map = native_query/check(loaded, native_gen/negate(native_kernel/absent(owner)), "schema")
    return native_query/check(checked, native_kernel/load_field(checked, owner, "sealed"), "closed")
  end)
  let result: list = [body, ready]
  return result
end

// A normal call supplies an immutable continuation at the caller's depth.
// A null continuation is a tail call: preserve the enclosing return target.
verb native_calls/continuation(builder: map) -> list
  let current: map = native_handlers/current(builder)
  let continuation: map = native_roots/ref(builder, "continuation")
  let [caller: map, rooted: map] = native_roots/retain(builder, "caller", native_kernel/load_field(builder, current, "caller"))
  let [depth: map, with_depth: map] = native_gen/bind(rooted, "call_depth", native_kernel/load_field(rooted, current, "depth"))
  let ready: map = native_gen/unless(with_depth, native_kernel/absent(continuation), fn(call)
    let checked: map = native_query/check(call, native_gen/negate(native_kernel/absent(native_kernel/load_field(call, continuation, "entry"))), "schema")
    checked = native_query/check(checked, native_gen/equal(native_kernel/load_field(checked, continuation, "depth"), depth), "schema")
    for field in ["handlers", "caller", "unwind"]
      checked = native_query/check(checked, native_gen/equal(native_kernel/load_field(checked, continuation, field), native_kernel/load_field(checked, current, field)), "schema")
    end
    let [same: map, compared: map] = native_dispatch/equal(checked, native_kernel/load_field(checked, continuation, "tenant"), native_kernel/load_field(checked, current, "tenant"))
    checked = native_query/check(compared, same, "permission")
    checked = native_query/check(checked, native_gen/less(depth, native_tasks/attempt_field(checked, "depth_limit")), "limit")
    checked = native_roots/store(checked, caller, continuation)
    return native_gen/assign(checked, depth, native_gen/add(depth, native_gen/ref(checked, "one")))
  end)
  return [caller, depth, ready]
end

verb native_calls/invoke_body(module: map) -> map
  let builder: map = native_invocation/rights(native_tasks/operation_context(module, "invoke"))
  builder = native_execution/control_scope(builder, native_roots/worker(builder), native_roots/ref(builder, "budget"))
  let [selection: map, selected: map] = native_gen/bind(builder, "selected", native_query/call(builder, "task_dispatch_resolve", [
    native_tasks/slot(builder, "transaction"), native_gen/ref(builder, "vocabulary"), native_gen/ref(builder, "selectors"),
    native_gen/ref(builder, "parameters"), native_gen/ref(builder, "delegates"), native_roots/ref(builder, "prototypes"),
    native_roots/ref(builder, "selector"), native_roots/ref(builder, "supplied")]))
  builder = native_gen/unless(selected, native_kernel/absent(native_gen/field(selected, selection, "status")), fn(failed) => native_roots/return_value(failed, selection))
  builder = native_gen/unless(builder, native_gen/equal(native_gen/field(builder, selection, "count"), native_gen/ref(builder, "one")), fn(unselected) => native_roots/return_value(unselected, selection))
  let [identity: map, with_identity: map] = native_roots/retain(builder, "selected_method", native_gen/field(builder, selection, "method"))
  let [arguments: map, with_arguments: map] = native_roots/retain(with_identity, "arguments", native_gen/field(with_identity, selection, "arguments"))
  let [body: map, with_body: map] = native_calls/program_for(with_arguments, identity)
  let [caller: map, depth: map, ready: map] = native_calls/continuation(with_body)
  let [callee: map, constructed: map] = native_gen/bind(ready, "callee", native_handlers/copy_image(ready, native_handlers/current(ready), {
    "entry" -> native_kernel/load_field(ready, body, "entry"), "code" -> native_kernel/load_field(ready, body, "code"),
    "pending" -> native_gen/zero(native_tasks/pointer("Invocation")), "environment" -> arguments, "input" -> native_gen/zero(native_value/word()), "caller" -> caller, "depth" -> depth}))
  builder = native_query/check(constructed, native_gen/negate(native_kernel/absent(callee)), "oom")
  // Everything above is fallible. Publish the new current image only after the
  // complete selection, binding, and continuation checks have succeeded.
  builder = native_roots/store(builder, native_handlers/current(builder), callee)
  let result: map = native_gen/finish(module, native_roots/return_value(builder, native_gen/record(builder, [:Record, "TaskDispatchSelection"], {
    "status" -> native_gen/ref(builder, "kernel_ok"), "count" -> native_gen/ref(builder, "one"), "method" -> identity, "arguments" -> arguments})))
  return result
end

verb native_calls/return_body(module: map) -> map
  let builder: map = native_handlers/context(module, "return")
  let current: map = native_handlers/current(builder)
  let [target: map, rooted: map] = native_roots/retain(builder, "return_to", native_kernel/load_field(builder, current, "caller"))
  builder = native_gen/when(rooted, native_kernel/absent(target), fn(root)
    let [completed: map, allocated: map] = native_gen/bind(root, "complete", native_handlers/copy_image(root, current, {
      "entry" -> native_gen/expression([:FunctionPointer, "TaskEntry"], :FunctionAddress, ["task_return_complete"]),
      "code" -> native_gen/zero(native_tasks/pointer("CodeRef")), "environment" -> native_gen/zero(native_value/word()),
      "handlers" -> native_gen/zero(native_tasks/pointer("Handler")), "unwind" -> native_gen/zero(native_tasks/pointer("Unwind")),
      "depth" -> native_gen/ref(root, "zero")}))
    let checked: map = native_tasks/check(allocated, native_gen/negate(native_kernel/absent(completed)), "oom")
    return native_roots/store(checked, target, completed)
  end)
  let result: map = native_gen/finish(module, native_roots/return_value(builder, native_gen/call(builder, "task_leave", [
    native_tasks/attempt(builder), native_gen/ref(builder, "worker"), target, native_roots/ref(builder, "value")])))
  return result
end

// Dispatch and generated instructions consume one segment budget. Keep only
// scalar selection results across the accounting poll; the callee image owns
// selected arguments after a successful invocation.
verb native_calls/invoke_accounted(builder: map, arguments: list, continuation: map) -> map
  let [status: map, called: map] = native_gen/bind(builder, "invocation_status", native_gen/call(builder, "task_invoke_accounted", [@arguments, continuation]))
  let result: map = native_gen/unless(called, native_kernel/absent(status), fn(failed) => native_roots/return_value(failed, status))
  return result
end

verb native_calls/accounted_body(module: map) -> map
  let builder: map = native_tasks/context(module, "invoke_accounted")
  let arguments: list = [native_roots/worker(builder), native_tasks/attempt(builder)]
  for name in ["vocabulary", "selectors", "parameters", "delegates", "programs", "prototypes", "selector", "supplied"]
    arguments = [@arguments, native_roots/ref(builder, name)]
  end
  let continuation: map = native_roots/ref(builder, "continuation")
  let [allowance: map, bounded: map] = native_gen/bind(builder, "allowance", native_tasks/attempt_field(builder, "remaining"))
  let [budget: map, budgeted: map] = native_gen/bind(bounded, "budget", native_gen/record(bounded, [:Record, "KernelBudget"], {
    "steps" -> allowance, "rows" -> native_gen/ref(bounded, "kernel_unlimited"),
    "rounds" -> native_gen/ref(bounded, "kernel_unlimited"), "bytes" -> native_gen/ref(bounded, "kernel_unlimited"),
    "status" -> native_gen/ref(bounded, "zero"), "signal" -> native_kernel/load_field(bounded, native_tasks/slot(bounded, "transaction"), "signal")}))
  let [selected: map, called: map] = native_gen/bind(budgeted, "selected", native_gen/call(budgeted, "task_invoke", [
    @arguments, continuation, native_gen/address(budget)]))
  // Keep only scalar results across the poll; selected arguments are already
  // rooted by the callee image when invocation succeeds.
  let [status: map, with_status: map] = native_gen/bind(called, "status", native_gen/field(called, selected, "status"))
  let [count: map, with_count: map] = native_gen/bind(with_status, "count", native_gen/field(with_status, selected, "count"))
  // Selection work consumes the same segment budget as generated instructions.
  let [charged: map, accounted: map] = native_gen/bind(with_count, "charged", native_gen/call(with_count, "task_poll", [
    native_tasks/attempt(with_count), native_gen/subtract(allowance, native_gen/field(with_count, budget, "steps"))]))
  builder = native_gen/unless(accounted, native_kernel/absent(status), fn(failed) => native_roots/return_value(failed, status))
  builder = native_gen/unless(builder, native_kernel/absent(charged), fn(exhausted) => native_roots/return_value(exhausted, charged))
  builder = native_gen/when(builder, native_kernel/absent(count), fn(missing) => native_roots/return_value(missing, native_gen/ref(missing, "task_no_method")))
  builder = native_gen/unless(builder, native_gen/equal(count, native_gen/ref(builder, "one")), fn(ambiguous) => native_roots/return_value(ambiguous, native_gen/ref(ambiguous, "task_ambiguous_dispatch")))
  let result: map = native_gen/finish(module, native_roots/return_value(builder, native_gen/ref(builder, "kernel_ok")))
  return result
end

verb native_calls/program(input: map) -> map
  let module: map = input
  let worker: list = ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]
  let attempt: list = ["attempt", native_tasks/pointer("Attempt"), :Borrow]
  let word: list = native_value/word()
  let parameters: list = [worker, attempt,
    ["vocabulary", native_tasks/pointer("DispatchVocabulary"), :Borrow], ["selectors", :U64, :Value], ["parameters", :U64, :Value],
    ["delegates", :U64, :Value], ["programs", :U64, :Value], ["prototypes", word, :Gc], ["selector", word, :Gc], ["supplied", word, :Gc],
    ["continuation", native_tasks/pointer("Image"), :Gc]]
  module = native_tasks/declare(module, "invoke", [:Record, "TaskDispatchSelection"], [@parameters, ["budget", native_kernel/pointer("Budget"), :Borrow]], :Gc)
  module = native_tasks/declare(module, "invoke_accounted", :U64, parameters)
  module = native_tasks/declare(module, "return", :U64, [worker, attempt, ["value", word, :Gc]])
  module = native/declare_function(module, "task_return_complete", :U64, [attempt], [], native_tasks/effects(), :Value, "")
  module = native/execution_function(module, "task_return_complete", :Tail)
  let builder: map = native_tasks/entry_context(module, "task_return_complete")
  builder = native_gen/return_value(builder, native_gen/call(builder, "task_request", [native_tasks/attempt(builder), native_gen/ref(builder, "task_boundary_complete")]))
  module = native_gen/finish(module, builder)
  module = native_calls/invoke_body(module)
  module = native_calls/accounted_body(module)
  let result: map = native_calls/return_body(module)
  return result
end
