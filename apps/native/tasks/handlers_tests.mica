verb native_handler_tests/number(builder: map, number: int) -> map
  let result: map = native_gen/ref(builder, string_concat("handler_number_", to_literal(number)))
  return result
end
verb native_handler_tests/value(builder: map, number: int) -> map
  let result: map = native_gen/field(builder, native_gen/call(builder, "value_int", [native_handler_tests/number(builder, number)]), "value")
  return result
end
verb native_handler_tests/scenario(builder: map, number: int) -> map
  let value: map = native_kernel/load_field(builder, native_handlers/current(builder), "environment")
  let result: map = native_gen/equal(native_gen/field(builder, native_gen/call(builder, "value_as_int", [value]), "number"), native_handler_tests/number(builder, number))
  return result
end
verb native_handler_tests/checked(builder: map, name: string, arguments: list) -> map
  let [status: map, ready: map] = native_gen/bind(builder, "status", native_gen/call(builder, name, arguments))
  let result: map = native_gen/unless(ready, native_kernel/absent(status), fn(failed) => native_roots/return_value(failed, status))
  return result
end
verb native_handler_tests/entry(name: string) -> map
  let result: map = native_gen/expression([:FunctionPointer, "TaskEntry"], :FunctionAddress, [string_concat("task_test_handler_", name)])
  return result
end
verb native_handler_tests/capture(builder: map, name: string) -> list
  let [image: map, ready: map] = native_roots/retain(builder, name, native_handlers/copy_image(builder, native_handlers/current(builder), {"entry" -> native_handler_tests/entry(name)}))
  ready = native_tasks/check(ready, native_gen/negate(native_kernel/absent(image)), "oom")
  return [image, ready]
end
verb native_handler_tests/push(builder: map, name: string, kind: string) -> map
  let result: map = native_roots/temporary(builder, fn(scoped)
    let [image: map, ready: map] = native_handler_tests/capture(scoped, name)
    return native_handler_tests/checked(ready, "task_handler_push", [native_tasks/attempt(ready), native_gen/ref(ready, "worker"), image,
      native_gen/ref(ready, string_concat("task_handler_", kind))])
  end)
  return result
end
verb native_handler_tests/emit(builder: map, number: int) -> map
  let result: map = native_handler_tests/checked(builder, "task_stage", [native_gen/ref(builder, "worker"), native_tasks/slot(builder, "effects"),
    native_gen/ref(builder, "task_effect_emit"), native_kernel/load_field(builder, native_handlers/current(builder), "tenant"), native_handler_tests/value(builder, number)])
  return result
end
verb native_handler_tests/signal_error(builder: map, replacement: bool) -> map
  let code: string = "handler_original_error"
  if replacement
    code = "handler_replacement_error"
  end
  let [error: map, ready: map] = native_gen/bind(builder, "error", native_gen/call(builder, "value_error", [
    native_gen/ref(builder, "worker"), native_gen/ref(builder, code), native_gen/ref(builder, "false"), native_gen/zero(native_value/word()),
    native_gen/ref(builder, "true"), native_kernel/load_field(builder, native_handlers/current(builder), "environment")]))
  ready = native_tasks/check(ready, native_gen/field(ready, error, "ok"), "oom")
  let result: map = native_handler_tests/checked(ready, "task_raise", [native_tasks/attempt(ready), native_gen/ref(ready, "worker"), native_gen/field(ready, error, "value")])
  return result
end
verb native_handler_tests/done(builder: map) -> map
  let result: map = native_handler_tests/checked(builder, "task_cleanup_done", [native_tasks/attempt(builder), native_gen/ref(builder, "worker")])
  return result
end
verb native_handler_tests/error_is(builder: map, code: string) -> map
  let [decoded: map, ready: map] = native_gen/bind(builder, "error", native_gen/call(builder, "value_as_error", [native_kernel/load_field(builder, native_handlers/current(builder), "input")]))
  ready = native_tasks/check(ready, native_gen/field(ready, decoded, "ok"), "schema")
  let result: map = native_tasks/check(ready, native_gen/equal(native_kernel/load_field(ready, native_gen/field(ready, decoded, "header"), "code"), native_gen/ref(ready, code)), "schema")
  return result
end

verb native_handler_tests/program(input: map) -> map
  let module: map = input
  let constants: list = [["handler_original_error", :U32, native_value/hex(17)], ["handler_replacement_error", :U32, native_value/hex(18)]]
  for number in [0, 1, 2, 3, 4, 5, 6, 7, 77]
    constants = [@constants, [string_concat("handler_number_", to_literal(number)), :I64, native_value/hex(number)]]
  end
  let [bindings: map, state: map] = native/constants(module[:state], constants)
  module[:state] = state
  let merged: map = module[:constants]
  for key, value in bindings
    merged[key] = value
  end
  module[:constants] = merged
  let entries: list = ["start", "inner", "resume", "outer", "catch", "nested", "return"]
  let attempt: list = ["attempt", native_tasks/pointer("Attempt"), :Borrow]
  for name in entries
    let entry: string = string_concat("task_test_handler_", name)
    module = native/declare_function(module, entry, :U64, [attempt], [], native_tasks/effects(), :Value, "")
    module = native/execution_function(module, entry, :Tail)
    module = native_tasks/declare(module, string_concat("test_handler_body_", name), :U64,
      [attempt, ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]])
  end

  let builder: map = native_tasks/context(module, "test_handler_body_start")
  let [target: map, captured: map] = native_handler_tests/capture(builder, "return")
  builder = native_gen/unless(captured, native_handler_tests/scenario(captured, 2), fn(caught) => native_handler_tests/push(caught, "catch", "catch"))
  builder = native_handler_tests/push(builder, "outer", "cleanup")
  builder = native_handler_tests/push(builder, "inner", "cleanup")
  builder = native_gen/branch(builder, native_handler_tests/scenario(builder, 0),
    fn(normal) => native_handler_tests/checked(normal, "task_leave", [native_tasks/attempt(normal), native_gen/ref(normal, "worker"), target, native_handler_tests/value(normal, 77)]),
    fn(raised) => native_handler_tests/signal_error(raised, false))
  module = native_gen/finish(module, native_tasks/attempt_status(builder, "ok"))

  builder = native_tasks/context(module, "test_handler_body_inner")
  builder = native_handler_tests/emit(builder, 1)
  builder = native_handlers/replace_current(builder, native_handlers/current(builder), {"entry" -> native_handler_tests/entry("resume")})
  builder = native_roots/return_value(builder, native_gen/call(builder, "task_request", [native_tasks/attempt(builder), native_gen/ref(builder, "task_boundary_wait")]))
  module = native_gen/finish(module, builder)

  builder = native_tasks/context(module, "test_handler_body_resume")
  builder = native_handler_tests/checked(builder, "task_poll", [native_tasks/attempt(builder), native_gen/ref(builder, "one")])
  builder = native_handler_tests/emit(builder, 2)
  builder = native_gen/branch(builder, native_handler_tests/scenario(builder, 4),
    fn(nested) => native_handler_tests/signal_error(native_handler_tests/push(nested, "nested", "catch"), true),
    fn(resumed) => native_handler_tests/done(resumed))
  module = native_gen/finish(module, native_tasks/attempt_status(builder, "ok"))

  builder = native_tasks/context(module, "test_handler_body_outer")
  builder = native_handler_tests/emit(builder, 3)
  builder = native_gen/branch(builder, native_handler_tests/scenario(builder, 3),
    fn(replaced) => native_handler_tests/signal_error(replaced, true), fn(resumed) => native_handler_tests/done(resumed))
  module = native_gen/finish(module, native_tasks/attempt_status(builder, "ok"))

  builder = native_tasks/context(module, "test_handler_body_catch")
  builder = native_gen/branch(builder, native_handler_tests/scenario(builder, 3),
    fn(replaced) => native_handler_tests/error_is(replaced, "handler_replacement_error"),
    fn(original) => native_handler_tests/error_is(original, "handler_original_error"))
  builder = native_handler_tests/emit(builder, 4)
  builder = native_roots/return_value(builder, native_gen/call(builder, "task_request", [native_tasks/attempt(builder), native_gen/ref(builder, "task_boundary_complete")]))
  module = native_gen/finish(module, builder)

  builder = native_tasks/context(module, "test_handler_body_nested")
  builder = native_handler_tests/error_is(builder, "handler_replacement_error")
  builder = native_handler_tests/emit(builder, 5)
  module = native_gen/finish(module, native_tasks/attempt_status(native_handler_tests/done(builder), "ok"))

  builder = native_tasks/context(module, "test_handler_body_return")
  builder = native_tasks/check(builder, native_gen/equal(native_kernel/load_field(builder, native_handlers/current(builder), "input"), native_handler_tests/value(builder, 77)), "schema")
  builder = native_handler_tests/emit(builder, 4)
  builder = native_roots/return_value(builder, native_gen/call(builder, "task_request", [native_tasks/attempt(builder), native_gen/ref(builder, "task_boundary_complete")]))
  module = native_gen/finish(module, builder)

  for name in entries
    builder = native_tasks/entry_context(module, string_concat("task_test_handler_", name))
    builder = native_handler_tests/checked(builder, string_concat("task_test_handler_body_", name), [native_tasks/attempt(builder), native_tasks/attempt_field(builder, "worker")])
    if native/contains(["inner", "catch", "return"], name)
      builder = native_gen/return_value(builder, native_gen/ref(builder, "kernel_ok"))
    else
      builder = native_handlers/transfer(builder)
    end
    module = native_gen/finish(module, builder)
  end
  return module
end
