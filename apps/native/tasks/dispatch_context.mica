// Stable runtime configuration, shared by calls and child admission. It owns
// one published prototype root and must outlive every runtime borrowing it.
verb native_dispatch/context_types(input: map) -> map
  let module: map = input
  let fields: list = [["heap", native_memory/record_pointer("MemoryHeap")], ["vocabulary", [:Record, "TaskDispatchVocabulary"]], ["prototypes", [:Record, "MemoryRoot"]]]
  for name in ["selectors", "parameters", "delegates", "programs"]
    fields = [@fields, [name, :U64]]
  end
  module[:state] = native/record_type(module[:state], "TaskDispatchContext", fields)[1]
  return module
end
verb native_dispatch/prototypes(builder: map, configuration: map) -> map
  let root: map = native_gen/field(builder, configuration, "prototypes")[:pointer]
  let result: map = native_roots/root_value(builder, root, native_value/word())
  return result
end
verb native_dispatch/context_program(input: map) -> map
  let module: map = input
  let worker: list = ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]
  let configuration: list = ["configuration", native_tasks/pointer("DispatchContext"), :Borrow]
  let parameters: list = [configuration, worker, ["vocabulary", native_tasks/pointer("DispatchVocabulary"), :Borrow]]
  for name in ["selectors", "parameters", "delegates", "programs"]
    parameters = [@parameters, [name, :U64, :Value]]
  end
  module = native_tasks/declare(module, "dispatch_context_init", :U64, [@parameters, ["prototypes", native_value/word(), :Gc]])
  module = native_tasks/declare(module, "dispatch_context_release", :U64, [configuration, worker])
  let builder: map = native_roots/context(module, "task_dispatch_context_init", fn(failed, reason) => native_query/error(failed, reason))
  let target: map = native_gen/ref(builder, "configuration")
  let vocabulary: map = native_gen/ref(builder, "vocabulary")
  for pointer in [target, vocabulary]
    builder = native_query/check(builder, native_gen/negate(native_kernel/absent(pointer)), "schema")
  end
  let root: map = native_gen/field(builder, target, "prototypes")[:pointer]
  builder = native_query/check(builder, native_kernel/absent(native_kernel/load_field(builder, root, "registration")), "closed")
  builder = native_query/check(builder, native_kernel/load_field(builder, vocabulary, "ready"), "schema")
  let [prototypes: map, rooted: map] = native_roots/retain(builder, "prototypes", native_roots/ref(builder, "prototypes"))
  builder = native_query/check(rooted, native_gen/call(rooted, "memory_publish", [native_roots/worker(rooted), prototypes[:scope_root], root]), "oom")
  builder = native_mailboxes/native_store(builder, target, "heap", native_kernel/load_field(builder, native_roots/worker(builder), "heap"))
  builder = native_kernel/store_field(builder, target, "vocabulary", native_gen/load(vocabulary))
  for name in ["selectors", "parameters", "delegates", "programs"]
    builder = native_kernel/store_field(builder, target, name, native_gen/ref(builder, name))
  end
  module = native_gen/finish(module, native_tasks/attempt_status(builder, "ok"))
  builder = native_roots/context(module, "task_dispatch_context_release", fn(failed, reason) => native_query/error(failed, reason))
  target = native_gen/ref(builder, "configuration")
  builder = native_query/check(builder, native_gen/negate(native_kernel/absent(target)), "schema")
  root = native_gen/field(builder, target, "prototypes")[:pointer]
  builder = native_query/check(builder, native_gen/equal(native_kernel/load_field(builder, target, "heap"), native_kernel/load_field(builder, native_roots/worker(builder), "heap")), "closed")
  builder = native_query/check(builder, native_gen/call(builder, "memory_unpublish", [native_roots/worker(builder), root]), "closed")
  builder = native_gen/store(builder, target, native_gen/zero([:Record, "TaskDispatchContext"]))
  let result: map = native_gen/finish(module, native_tasks/attempt_status(builder, "ok"))
  return result
end
