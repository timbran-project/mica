// Handler images capture the lexical environment and outer unwind state.
// Frames and pending transfers are immutable: a retry can reuse the checkpoint
// after a speculative handler or finalizer has advanced the current image.
verb native_handlers/current(builder: map) -> map
  let result: map = native_tasks/saved(builder, "current", native_tasks/pointer("Image"))
  return result
end
verb native_handlers/copy_image(builder: map, source: map, fields: map) -> map
  let arguments: list = [native_gen/ref(builder, "worker")]
  for [name, kind] in native_tasks/schemas()[0][1]
    let value: map = native_kernel/load_field(builder, source, name)
    if map_contains_key(fields, name)
      value = fields[name]
    end
    arguments = [@arguments, value]
  end
  let result: map = native_gen/call(builder, "task_new_Image", arguments)
  return result
end
verb native_handlers/replace_current(builder: map, source: map, fields: map) -> map
  let [image: map, allocated: map] = native_gen/bind(builder, "image", native_handlers/copy_image(builder, source, fields))
  let ready: map = native_tasks/check(allocated, native_gen/negate(native_kernel/absent(image)), "oom")
  let result: map = native_roots/store(ready, native_handlers/current(ready), image)
  return result
end
verb native_handlers/poll(builder: map) -> map
  let [status: map, ready: map] = native_gen/bind(builder, "polled", native_gen/call(builder, "task_poll", [native_tasks/attempt(builder), native_gen/ref(builder, "zero")]))
  let result: map = native_gen/unless(ready, native_kernel/absent(status), fn(failed) => native_roots/return_value(failed, status))
  return result
end
verb native_handlers/context(module: map, name: string) -> map
  let builder: map = native_tasks/context(module, name)
  builder = native_tasks/check(builder, native_gen/equal(native_gen/ref(builder, "worker"), native_tasks/attempt_field(builder, "worker")), "closed")
  builder = native_tasks/check(builder, native_kernel/absent(native_tasks/attempt_field(builder, "boundary")), "closed")
  let result: map = native_handlers/poll(builder)
  return result
end

// A normal transfer may leave only a suffix of the active handler chain.
// Validate it before running any finalizer; an invalid target has no effects.
verb native_handlers/check_target(builder: map, handlers: map, target: map) -> map
  let result: map = native_gen/unless(builder, native_kernel/absent(target), fn(jumping)
    let ready: map = native_tasks/check(jumping, native_gen/negate(native_kernel/absent(native_kernel/load_field(jumping, target, "entry"))), "schema")
    return native_roots/temporary(ready, fn(scoped)
      let [cursor: map, retained: map] = native_roots/retain(scoped, "ancestor", handlers)
      return native_gen/while_loop(retained, native_gen/negate(native_gen/equal(cursor, native_kernel/load_field(retained, target, "handlers"))), fn(search)
        let present: map = native_tasks/check(search, native_gen/negate(native_kernel/absent(cursor)), "schema")
        present = native_roots/store(present, cursor, native_kernel/load_field(present, cursor, "next"))
        return native_handlers/poll(present)
      end)
    end)
  end)
  return result
end

verb native_handlers/unwind_body(module: map) -> map
  let builder: map = native_handlers/context(module, "unwind")
  let cursor: map = native_roots/ref(builder, "handlers")
  let target: map = native_roots/ref(builder, "target")
  let value: map = native_roots/ref(builder, "value")
  builder = native_handlers/check_target(builder, cursor, target)
  builder = native_gen/while_loop(builder, native_gen/ref(builder, "true"), fn(step)
    let ready: map = native_handlers/poll(step)
    ready = native_gen/unless(ready, native_kernel/absent(target), fn(jumping)
      return native_gen/when(jumping, native_gen/equal(cursor, native_kernel/load_field(jumping, target, "handlers")), fn(arrived)
        return native_tasks/attempt_status(native_handlers/replace_current(arrived, target, {"input" -> value}), "ok")
      end)
    end)
    ready = native_gen/when(ready, native_kernel/absent(cursor), fn(unhandled)
      let failed: map = native_roots/store(unhandled, native_tasks/saved(unhandled, "error", native_value/word()), value)
      return native_roots/return_value(failed, native_gen/ref(failed, "task_language_error"))
    end)
    let kind: map = native_kernel/load_field(ready, cursor, "kind")
    let image: map = native_kernel/load_field(ready, cursor, "image")
    let next: map = native_kernel/load_field(ready, cursor, "next")
    ready = native_gen/when(ready, native_gen/equal(kind, native_gen/ref(ready, "task_handler_cleanup")), fn(cleanup)
      let [pending: map, retained: map] = native_roots/retain(cleanup, "pending", native_gen/call(cleanup, "task_new_Unwind", [
        native_gen/ref(cleanup, "worker"), next, target, value]))
      let checked: map = native_tasks/check(retained, native_gen/negate(native_kernel/absent(pending)), "oom")
      let entered: map = native_handlers/replace_current(checked, image, {"input" -> value, "handlers" -> next, "unwind" -> pending})
      return native_tasks/attempt_status(entered, "ok")
    end)
    ready = native_tasks/check(ready, native_gen/equal(kind, native_gen/ref(ready, "task_handler_catch")), "schema")
    ready = native_gen/when(ready, native_kernel/absent(target), fn(caught)
      return native_tasks/attempt_status(native_handlers/replace_current(caught, image, {"input" -> value, "handlers" -> next}), "ok")
    end)
    return native_roots/store(ready, cursor, next)
  end)
  let result: map = native_gen/finish(module, native_tasks/attempt_status(builder, "schema"))
  return result
end

verb native_handlers/push_body(module: map) -> map
  let builder: map = native_handlers/context(module, "handler_push")
  let image: map = native_roots/ref(builder, "image")
  let kind: map = native_gen/ref(builder, "kind")
  builder = native_tasks/check(builder, native_gen/negate(native_kernel/absent(image)), "schema")
  builder = native_tasks/check(builder, native_gen/negate(native_kernel/absent(native_kernel/load_field(builder, image, "entry"))), "schema")
  builder = native_tasks/check(builder, native_gen/negate(native_gen/less(kind, native_gen/ref(builder, "task_handler_catch"))), "schema")
  builder = native_tasks/check(builder, native_gen/negate(native_gen/less(native_gen/ref(builder, "task_handler_cleanup"), kind)), "schema")
  let current: map = native_handlers/current(builder)
  builder = native_tasks/check(builder, native_gen/equal(native_kernel/load_field(builder, image, "handlers"), native_kernel/load_field(builder, current, "handlers")), "schema")
  let [frame: map, retained: map] = native_roots/retain(builder, "frame", native_gen/call(builder, "task_new_Handler", [
    native_gen/ref(builder, "worker"), native_kernel/load_field(builder, current, "handlers"), image, kind]))
  builder = native_tasks/check(retained, native_gen/negate(native_kernel/absent(frame)), "oom")
  builder = native_handlers/replace_current(builder, current, {"handlers" -> frame})
  let result: map = native_gen/finish(module, native_tasks/attempt_status(builder, "ok"))
  return result
end

verb native_handlers/program(input: map) -> map
  let module: map = input
  let attempt: list = ["attempt", native_tasks/pointer("Attempt"), :Borrow]
  let worker: list = ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]
  let target: list = ["target", native_tasks/pointer("Image"), :Gc]
  let value: list = ["value", native_value/word(), :Gc]
  module = native_tasks/declare(module, "handler_push", :U64, [attempt, worker, ["image", native_tasks/pointer("Image"), :Gc], ["kind", :U64, :Value]])
  module = native_tasks/declare(module, "unwind", :U64, [attempt, worker, ["handlers", native_tasks/pointer("Handler"), :Gc], target, value])
  module = native_tasks/declare(module, "raise", :U64, [attempt, worker, value])
  module = native_tasks/declare(module, "leave", :U64, [attempt, worker, target, value])
  module = native_tasks/declare(module, "cleanup_done", :U64, [attempt, worker])
  module = native_handlers/push_body(module)
  module = native_handlers/unwind_body(module)

  let builder: map = native_handlers/context(module, "raise")
  builder = native_tasks/check(builder, native_gen/field(builder, native_gen/call(builder, "value_as_error", [native_roots/ref(builder, "value")]), "ok"), "schema")
  builder = native_roots/return_value(builder, native_gen/call(builder, "task_unwind", [native_tasks/attempt(builder), native_gen/ref(builder, "worker"),
    native_kernel/load_field(builder, native_handlers/current(builder), "handlers"), native_gen/zero(native_tasks/pointer("Image")), native_roots/ref(builder, "value")]))
  module = native_gen/finish(module, builder)

  builder = native_handlers/context(module, "leave")
  builder = native_tasks/check(builder, native_gen/negate(native_kernel/absent(native_roots/ref(builder, "target"))), "schema")
  builder = native_roots/return_value(builder, native_gen/call(builder, "task_unwind", [native_tasks/attempt(builder), native_gen/ref(builder, "worker"),
    native_kernel/load_field(builder, native_handlers/current(builder), "handlers"), native_roots/ref(builder, "target"), native_roots/ref(builder, "value")]))
  module = native_gen/finish(module, builder)

  builder = native_handlers/context(module, "cleanup_done")
  let pending: map = native_kernel/load_field(builder, native_handlers/current(builder), "unwind")
  builder = native_tasks/check(builder, native_gen/negate(native_kernel/absent(pending)), "closed")
  // Cleanup must first leave any handlers it installed. Its pending transfer
  // resumes only after that region has restored the saved outer handler chain.
  builder = native_tasks/check(builder, native_gen/equal(native_kernel/load_field(builder, native_handlers/current(builder), "handlers"), native_kernel/load_field(builder, pending, "handlers")), "schema")
  builder = native_roots/return_value(builder, native_gen/call(builder, "task_unwind", [native_tasks/attempt(builder), native_gen/ref(builder, "worker"),
    native_kernel/load_field(builder, pending, "handlers"), native_kernel/load_field(builder, pending, "target"), native_kernel/load_field(builder, pending, "value")]))
  let result: map = native_gen/finish(module, builder)
  return result
end

// Generated regions transfer after a successful handler operation. The target
// owns no worker stack state; the task attempt remains the only native borrow.
verb native_handlers/transfer(builder: map) -> map
  let [entry: map, ready: map] = native_gen/bind(builder, "entry", native_kernel/load_field(builder, native_handlers/current(builder), "entry"))
  let result: map = native_gen/tail_call(ready, native_gen/syntax(ready, entry), [native_tasks/attempt(ready)])
  return result
end
