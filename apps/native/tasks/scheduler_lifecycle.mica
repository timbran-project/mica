verb native_scheduler/release_body(module: map) -> map
  let builder: map = native_gen/context(module, "task_scheduler_release")
  builder = native_scheduler/check(builder, native_scheduler/field(builder, "closed"), "closed")
  builder = native_scheduler/check(builder, native_kernel/absent(native_scheduler/field(builder, "workers")), "closed")
  builder = native_scheduler/check(builder, native_gen/negate(native_scheduler/field(builder, "events")), "closed")
  builder = native_scheduler/check(builder, native_kernel/load_field(builder, native_gen/ref(builder, "worker"), "active"), "closed")
  builder = native_scheduler/check(builder, native_gen/equal(native_scheduler/field(builder, "heap"), native_kernel/load_field(builder, native_gen/ref(builder, "worker"), "heap")), "closed")
  builder = native_gen/for_range(builder, "slot_index", native_gen/ref(builder, "zero"), native_scheduler/field(builder, "capacity"), fn(retire, id)
    let slot: map = native_scheduler/slot(retire, id)
    return native_gen/unless(retire, native_kernel/absent(native_kernel/load_field(retire, slot, "task")), fn(occupied) => native_scheduler/remove_slot(occupied, slot))
  end)
  builder = native_gen/when(builder, native_scheduler/field(builder, "attached"), fn(attached)
    let [status: map, detached: map] = native_gen/bind(attached, "detached", native_gen/call(attached, "task_mailbox_set_event", [
      native_scheduler/field(attached, "hub"), native_gen/ref(attached, "worker"), native_scheduler/field(attached, "event"), native_gen/zero(native_memory/pointer(:U8))]))
    let ready: map = native_gen/unless(detached, native_kernel/absent(status), fn(failed) => native_execution/fail(failed, status))
    return native_scheduler/store(ready, "attached", native_gen/ref(ready, "false"))
  end)
  builder = native_gen/unless(builder, native_kernel/absent(native_kernel/load_field(builder, native_scheduler/queue(builder), "mutex")), fn(queued)
    let ready: map = native_gen/do_call(queued, "task_queue_close", [native_scheduler/queue(queued)])
    ready = native_gen/while_loop(ready, native_gen/ref(ready, "true"), fn(drain)
      let [next: map, taken: map] = native_gen/bind(drain, "next", native_gen/call(drain, "task_queue_take", [native_scheduler/queue(drain), native_gen/ref(drain, "worker"), native_gen/ref(drain, "false")]))
      let status: map = native_gen/field(taken, next, "status")
      let step: map = native_gen/when(taken, native_gen/equal(status, native_gen/ref(taken, "kernel_closed")), fn(done) => native_gen/break_loop(done))
      return native_gen/unless(step, native_kernel/absent(status), fn(failed) => native_execution/fail(failed, status))
    end)
    return native_scheduler/check(ready, native_gen/call(ready, "task_queue_release", [native_scheduler/queue(ready)]), "closed")
  end)
  builder = native_gen/when(builder, native_scheduler/field(builder, "registered"), fn(registered)
    let ready: map = native_scheduler/check(registered, native_gen/call(registered, "task_resource_user", [native_gen/ref(registered, "worker"), native_gen/ref(registered, "false")]), "closed")
    return native_scheduler/store(ready, "registered", native_gen/ref(ready, "false"))
  end)
  builder = native_gen/unless(builder, native_kernel/absent(native_scheduler/field(builder, "buckets")), fn(allocated) => native_mailboxes/free(allocated, native_scheduler/field(allocated, "buckets")))
  builder = native_gen/unless(builder, native_kernel/absent(native_scheduler/field(builder, "slots")), fn(allocated) => native_mailboxes/free(allocated, native_scheduler/field(allocated, "slots")))
  builder = native_gen/unless(builder, native_kernel/absent(native_scheduler/field(builder, "event")), fn(allocated) => native_gen/do_call(allocated, "task_event_destroy", [native_scheduler/field(allocated, "event")]))
  builder = native_gen/unless(builder, native_kernel/absent(native_scheduler/field(builder, "mutex")), fn(allocated) => native_gen/do_call(allocated, "memory_sync_destroy", [native_scheduler/field(allocated, "mutex")]))
  builder = native_gen/store(builder, native_gen/ref(builder, "scheduler"), native_gen/zero([:Record, "TaskScheduler"]))
  let result: map = native_gen/finish(module, native_scheduler/status(builder, "ok"))
  return result
end

verb native_scheduler/init_body(module: map) -> map
  let builder: map = native_gen/context(module, "task_scheduler_init")
  let capacity: map = native_gen/ref(builder, "capacity")
  let worker: map = native_gen/ref(builder, "worker")
  let scheduler: map = native_gen/ref(builder, "scheduler")
  builder = native_scheduler/check(builder, native_kernel/absent(native_scheduler/field(builder, "mutex")), "closed")
  builder = native_scheduler/check(builder, native_kernel/absent(native_scheduler/field(builder, "slots")), "closed")
  builder = native_scheduler/check(builder, native_kernel/load_field(builder, worker, "active"), "closed")
  builder = native_scheduler/check(builder, native_gen/negate(native_kernel/absent(capacity)), "schema")
  let maximum: map = native_gen/divide(native_gen/divide(native_gen/ref(builder, "kernel_unlimited"), native_gen/sizeof([:Record, "TaskSlot"])), native_gen/multiply(native_gen/ref(builder, "two"), native_gen/ref(builder, "two")))
  builder = native_scheduler/check(builder, native_gen/negate(native_gen/less(maximum, capacity)), "limit")
  builder = native_scheduler/check(builder, native_gen/equal(native_kernel/load_field(builder, worker, "heap"), native_kernel/load_field(builder, native_gen/ref(builder, "hub"), "heap")), "closed")
  builder = native_gen/store(builder, scheduler, native_gen/zero([:Record, "TaskScheduler"]))
  builder = native_mailboxes/native_store(builder, scheduler, "heap", native_kernel/load_field(builder, worker, "heap"))
  builder = native_scheduler/store(builder, "closed", native_gen/ref(builder, "true"))
  builder = native_gen/on_return(builder, fn(leaving, result)
    return native_gen/unless(leaving, native_kernel/absent(result), fn(failed)
      let [released: map, cleaned: map] = native_gen/bind(failed, "released", native_gen/call(failed, "task_scheduler_release", [scheduler, worker]))
      return cleaned
    end)
  end)
  builder = native_mailboxes/native_store(builder, scheduler, "hub", native_gen/ref(builder, "hub"))
  for [name, function] in [["mutex", "memory_sync_create"], ["event", "task_event_create"]]
    let [pointer: map, allocated: map] = native_gen/bind(builder, name, native_gen/call(builder, function, []))
    builder = native_scheduler/check(allocated, native_gen/negate(native_kernel/absent(pointer)), "oom")
    builder = native_mailboxes/native_store(builder, scheduler, name, pointer)
  end
  let [storage: map, allocated: map] = native_gen/bind(builder, "slots", native_gen/call(builder, "memory_platform_allocate", [native_gen/multiply(capacity, native_gen/sizeof([:Record, "TaskSlot"]))]))
  builder = native_scheduler/check(allocated, native_gen/negate(native_kernel/absent(storage)), "oom")
  builder = native_mailboxes/native_store(builder, scheduler, "slots", native_gen/cast(native_tasks/pointer("Slot"), storage))
  builder = native_gen/for_range(builder, "slot_index", native_gen/ref(builder, "zero"), capacity, fn(initialize, id)
    let slot: map = native_scheduler/slot(initialize, id)
    let ready: map = native_gen/store(initialize, slot, native_gen/zero([:Record, "TaskSlot"]))
    ready = native_kernel/store_field(ready, slot, "index", id)
    let next: map = native_gen/add(id, native_gen/ref(ready, "one"))
    ready = native_gen/when(ready, native_gen/less(next, capacity), fn(link) => native_mailboxes/native_store(link, slot, "next", native_scheduler/slot(link, next)))
    ready = native_scheduler/store(ready, "capacity", next)
    return native_scheduler/check(ready, native_gen/call(ready, "memory_safepoint", [worker, native_gen/ref(ready, "false")]), "oom")
  end)
  builder = native_mailboxes/native_store(builder, scheduler, "free", native_scheduler/field(builder, "slots"))
  let [buckets: map, with_buckets: map] = native_gen/bind(builder, "bucket_count", native_gen/ref(builder, "one"))
  builder = native_gen/while_loop(with_buckets, native_gen/less(buckets, capacity), fn(grow) => native_gen/assign(grow, buckets, native_gen/multiply(buckets, native_gen/ref(grow, "two"))))
  builder = native_gen/assign(builder, buckets, native_gen/multiply(buckets, native_gen/ref(builder, "two")))
  let [table: map, with_table: map] = native_gen/bind(builder, "table", native_gen/call(builder, "memory_platform_allocate", [native_gen/multiply(buckets, native_gen/sizeof(native_tasks/pointer("Slot")))]))
  builder = native_scheduler/check(with_table, native_gen/negate(native_kernel/absent(table)), "oom")
  builder = native_mailboxes/native_store(builder, scheduler, "buckets", native_gen/cast(native_memory/pointer(native_tasks/pointer("Slot")), table))
  builder = native_scheduler/store(builder, "mask", native_gen/subtract(buckets, native_gen/ref(builder, "one")))
  builder = native_gen/for_range(builder, "bucket_index", native_gen/ref(builder, "zero"), buckets, fn(clear, index)
    let ready: map = native_gen/store(clear, native_gen/offset(native_scheduler/field(clear, "buckets"), index), native_gen/zero(native_tasks/pointer("Slot")))
    return native_scheduler/check(ready, native_gen/call(ready, "memory_safepoint", [worker, native_gen/ref(ready, "false")]), "oom")
  end)
  let [status: map, with_queue: map] = native_gen/bind(builder, "queue_status", native_gen/call(builder, "task_queue_init", [native_scheduler/queue(builder), capacity]))
  builder = native_gen/unless(with_queue, native_kernel/absent(status), fn(failed) => native_execution/fail(failed, status))
  builder = native_gen/assign(builder, status, native_gen/call(builder, "task_mailbox_set_event", [native_gen/ref(builder, "hub"), worker,
    native_gen/zero(native_memory/pointer(:U8)), native_scheduler/field(builder, "event")]))
  builder = native_gen/unless(builder, native_kernel/absent(status), fn(failed) => native_execution/fail(failed, status))
  builder = native_scheduler/store(builder, "attached", native_gen/ref(builder, "true"))
  builder = native_scheduler/check(builder, native_gen/call(builder, "task_resource_user", [worker, native_gen/ref(builder, "true")]), "closed")
  builder = native_scheduler/store(builder, "registered", native_gen/ref(builder, "true"))
  builder = native_scheduler/store(builder, "closed", native_gen/ref(builder, "false"))
  let result: map = native_gen/finish(module, native_scheduler/status(builder, "ok"))
  return result
end

verb native_scheduler/stop_body(module: map) -> map
  let builder: map = native_gen/context(module, "task_scheduler_stop")
  builder = native_gen/when(builder, native_kernel/absent(native_scheduler/field(builder, "mutex")), fn(closed) => native_gen/return_void(closed))
  builder = native_gen/do_call(builder, "memory_lock", [native_scheduler/field(builder, "mutex")])
  builder = native_scheduler/store(builder, "closed", native_gen/ref(builder, "true"))
  builder = native_gen/for_range(builder, "task_index", native_gen/ref(builder, "zero"), native_scheduler/field(builder, "capacity"), fn(cancel, id)
    return native_gen/unless(cancel, native_kernel/absent(native_scheduler/task(cancel, id)), fn(occupied)
      let [accepted: map, ready: map] = native_gen/bind(occupied, "cancelled", native_gen/call(occupied, "task_cancel", [native_scheduler/task(occupied, id)]))
      return ready
    end)
  end)
  builder = native_gen/do_call(builder, "task_queue_close", [native_scheduler/queue(builder)])
  builder = native_scheduler/notify(builder)
  builder = native_gen/do_call(builder, "memory_unlock", [native_scheduler/field(builder, "mutex")])
  let result: map = native_gen/finish(module, native_gen/return_void(builder))
  return result
end
