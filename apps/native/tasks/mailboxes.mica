verb native_mailboxes/field(builder: map, name: string) -> map
  let result: map = native_kernel/load_field(builder, native_gen/ref(builder, "hub"), name)
  return result
end
verb native_mailboxes/store(builder: map, name: string, value: map) -> map
  let result: map = native_kernel/store_field(builder, native_gen/ref(builder, "hub"), name, value)
  return result
end
verb native_mailboxes/status(builder: map, name: string) -> map
  let result: map = native_execution/fail(builder, native_gen/ref(builder, string_concat("kernel_", name)))
  return result
end
verb native_mailboxes/check(builder: map, condition: map, status: string) -> map
  let result: map = native_gen/unless(builder, condition, fn(failed) => native_mailboxes/status(failed, status))
  return result
end
verb native_mailboxes/root(builder: map, mailbox: map, name: string) -> map
  let result: map = native_roots/root_value(builder, native_gen/field(builder, mailbox, name)[:pointer], native_tasks/pointer("Message"))
  return result
end
verb native_mailboxes/locked(module: map, name: string, ?require_open: bool = true) -> map
  let builder: map = native_roots/context(module, string_concat("task_mailbox_", name),
    fn(failed, reason) => native_mailboxes/status(failed, reason))
  let worker: map = native_gen/ref(builder, "worker")
  builder = native_mailboxes/check(builder, native_gen/negate(native_kernel/absent(native_mailboxes/field(builder, "mutex"))), "closed")
  builder = native_mailboxes/check(builder, native_gen/equal(native_kernel/load_field(builder, worker, "heap"), native_mailboxes/field(builder, "heap")), "closed")
  builder = native_mailboxes/check(builder, native_gen/call(builder, "memory_leave", [worker]), "closed")
  builder = native_gen/do_call(builder, "memory_lock", [native_mailboxes/field(builder, "mutex")])
  builder = native_gen/unless(builder, native_gen/call(builder, "memory_enter", [worker]), fn(failed)
    return native_mailboxes/status(native_gen/do_call(failed, "memory_unlock", [native_mailboxes/field(failed, "mutex")]), "closed")
  end)
  builder = native_gen/on_return(builder, fn(leaving, result) => native_gen/do_call(leaving, "memory_unlock", [native_mailboxes/field(leaving, "mutex")]))
  if require_open
    builder = native_mailboxes/check(builder, native_gen/negate(native_mailboxes/field(builder, "closed")), "closed")
  end
  return builder
end
verb native_mailboxes/bucket(builder: map, id: map) -> map
  let hash: map = native_gen/call(builder, "value_hash_mix", [native_gen/ref(builder, "zero"), id])
  let index: map = native_gen/bit_and(hash, native_mailboxes/field(builder, "mask"))
  let result: map = native_gen/offset(native_mailboxes/field(builder, "buckets"), index)
  return result
end

// Lookup validates the capability kind before following the native hash chain.
// Its caller holds the hub lock, which also protects mailbox retirement.
verb native_mailboxes/find(builder: map, capability: map, sender: bool) -> list
  let [decoded: map, ready: map] = native_gen/bind(builder, "capability", native_gen/call(builder, "value_as_capability", [capability]))
  ready = native_mailboxes/check(ready, native_gen/field(ready, decoded, "ok"), "permission")
  let raw: map = native_gen/field(ready, decoded, "number")
  let side: map = native_gen/ref(ready, "zero")
  if sender
    side = native_gen/ref(ready, "one")
  end
  ready = native_mailboxes/check(ready, native_gen/equal(native_gen/bit_and(raw, native_gen/ref(ready, "one")), side), "permission")
  let [id: map, with_id: map] = native_gen/bind(ready, "mailbox_id", native_gen/shift_right(raw, native_gen/ref(ready, "one")))
  let [mailbox: map, found: map] = native_gen/bind(with_id, "mailbox", native_gen/load(native_mailboxes/bucket(with_id, id)))
  ready = native_gen/while_loop(found, native_gen/negate(native_kernel/absent(mailbox)), fn(scan)
    let matched: map = native_gen/when(scan, native_gen/equal(native_kernel/load_field(scan, mailbox, "id"), id), fn(done) => native_gen/break_loop(done))
    return native_gen/assign(matched, mailbox, native_kernel/load_field(matched, mailbox, "next"))
  end)
  ready = native_mailboxes/check(ready, native_gen/negate(native_kernel/absent(mailbox)), "permission")
  return [mailbox, ready]
end
verb native_mailboxes/notify(builder: map) -> map
  let ready: map = native_gen/when(builder, native_gen/less(native_mailboxes/field(builder, "revision"), native_gen/ref(builder, "kernel_unlimited")), fn(next)
    return native_mailboxes/store(next, "revision", native_gen/add(native_mailboxes/field(next, "revision"), native_gen/ref(next, "one")))
  end)
  let result: map = native_gen/do_call(ready, "memory_wake", [native_mailboxes/field(ready, "mutex")])
  let notified: map = native_gen/unless(result, native_kernel/absent(native_mailboxes/field(result, "event")), fn(listening)
    return native_gen/do_call(listening, "task_event_notify", [native_mailboxes/field(listening, "event")])
  end)
  return notified
end
verb native_mailboxes/types(input: map) -> map
  let module: map = input
  let mailbox: list = native_tasks/pointer("Mailbox")
  let root: list = [:Record, "MemoryRoot"]
  module[:state] = native/record_type(module[:state], "TaskMailboxStream", [
    ["next", native_tasks/pointer("MailboxStream")], ["id", :U64], ["count", :U64], ["capacity", :U64], ["stopped", :Bool]])[1]
  module[:state] = native/record_type(module[:state], "TaskMailbox", [
    ["next", mailbox], ["id", :U64], ["head", root], ["tail", root], ["count", :U64], ["capacity", :U64],
    ["streams", native_tasks/pointer("MailboxStream")], ["empty_streams", :U64], ["read_epoch", :U64], ["selected_epoch", :U64]])[1]
  module[:state] = native/record_type(module[:state], "TaskMailboxHub", [
    ["heap", native_memory/record_pointer("MemoryHeap")], ["mutex", native_memory/pointer(:U8)], ["event", native_memory/pointer(:U8)],
    ["buckets", native_memory/pointer(mailbox)], ["mask", :U64], ["count", :U64], ["limit", :U64], ["revision", :U64], ["read_epoch", :U64], ["closed", :Bool]])[1]
  module[:state] = native/record_type(module[:state], "TaskMailboxCaps", [["status", :U64], ["receiver", native_value/word()], ["sender", native_value/word()]])[1]
  module[:state] = native/record_type(module[:state], "TaskMailboxRead", [["status", :U64], ["count", :U64], ["revision", :U64]])[1]
  module[:state] = native/record_type(module[:state], "TaskMailboxChange", [["status", :U64], ["revision", :U64]])[1]
  return module
end

verb native_mailboxes/declarations(input: map) -> map
  let module: map = input
  let hub: list = ["hub", native_tasks/pointer("MailboxHub"), :Borrow]
  let worker: list = ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]
  let sender: list = ["sender", native_value/word(), :Gc]
  let receiver: list = ["receiver", native_value/word(), :Gc]
  module = native_tasks/declare(module, "mailbox_hub_init", :U64, [hub, worker, ["limit", :U64, :Value]])
  module = native_tasks/declare(module, "mailbox_hub_shutdown", :U64, [hub, worker])
  module = native_tasks/declare(module, "mailbox_set_event", :U64, [hub, worker,
    ["expected", native_memory/pointer(:U8), :Borrow], ["replacement", native_memory/pointer(:U8), :Borrow]])
  module = native_tasks/declare(module, "mailbox_hub_release", :Bool, [hub, worker])
  module = native_tasks/declare(module, "mailbox_create", [:Record, "TaskMailboxCaps"], [hub, worker, ["capacity", :U64, :Value]], :Gc)
  module = native_tasks/declare(module, "mailbox_close", :U64, [hub, worker, receiver])
  module = native_tasks/declare(module, "mailbox_send", :U64, [hub, worker, sender, ["payload", native_value/word(), :Gc]])
  module = native_tasks/declare(module, "mailbox_validate_sender", :U64, [hub, worker, sender])
  module = native_tasks/declare(module, "mailbox_receive", [:Record, "TaskMailboxRead"], [hub, worker, ["receivers", native_value/word(), :Gc],
    ["task", native_tasks/pointer("Control"), :Borrow], ["generation", :U64, :Value]])
  module = native_tasks/declare(module, "mailbox_changed", [:Record, "TaskMailboxChange"], [hub, worker, ["revision", :U64, :Value]])
  module = native_tasks/declare(module, "mailbox_service", :U64, native_tasks/service_parameters())
  return module
end
