verb native_dispatch/symbol(builder: map, name: string) -> map
  let id: map = native_kernel/load_field(builder, native_gen/ref(builder, "vocabulary"), name)
  let result: map = native_gen/field(builder, native_gen/call(builder, "value_symbol", [id]), "value")
  let generated_result: map = result
  return generated_result
end

// Intern catalogue markers once, outside managed execution. The resulting
// scalar IDs belong to the runtime symbol table, not a task's authority.
verb native_dispatch/vocabulary(input: map) -> map
  let module: map = input
  let words: list = [["required", "required"], ["optional", "optional"], ["rest", "rest"],
    ["unrestricted", "dispatch/unrestricted"], ["frob_only", "dispatch/frob_only"]]
  let fields: list = [["ready", :Bool]]
  let literals: map = {}
  for word in words
    fields = [@fields, [word[0], :U32]]
    let [literal: map, ready: map] = native_literal/prepare(module, string_concat("dispatch_word_", word[0]), {:kind -> :Symbol, :value -> word[1]})
    literals[word[0]] = literal
    module = ready
  end
  module[:state] = native/record_type(module[:state], "TaskDispatchVocabulary", fields)[1]
  module = native_memory/declare(module, "task_dispatch_vocabulary_init", :U64,
    [["symbols", native_memory/record_pointer("SymbolTable"), :Borrow],
      ["vocabulary", native_tasks/pointer("DispatchVocabulary"), :Borrow]],
    [:ReadMemory, :WriteMemory, :Allocate, :Release, :Block], :Value, "")
  let builder: map = native_gen/context(module, "task_dispatch_vocabulary_init")
  builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(native_gen/ref(builder, "symbols"))), "closed")
  builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(native_gen/ref(builder, "vocabulary"))), "schema")
  builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(native_kernel/load_field(builder, native_gen/ref(builder, "symbols"), "mutex"))), "closed")
  let values: map = {"ready" -> native_gen/ref(builder, "true")}
  for word in words
    let [value: map, interned: map] = native_literal/emit(builder, literals[word[0]], native_gen/ref(builder, "symbols"), fn(failed) => native_rules/error(failed, "oom"))
    let [id: map, decoded: map] = native_gen/bind(interned, "symbol_id", native_gen/call(interned, "value_as_symbol", [value]))
    builder = decoded
    values[word[0]] = native_gen/convert(:U32, native_gen/field(builder, id, "number"))
  end
  builder = native_gen/store(builder, native_gen/ref(builder, "vocabulary"), native_gen/record(builder, [:Record, "TaskDispatchVocabulary"], values))
  let result: map = native_gen/finish(module, native_execution/fail(builder, native_gen/ref(builder, "kernel_ok")))
  let generated_result: map = result
  return generated_result
end

verb native_dispatch/binding_result(builder: map, applicable: map, arguments: map) -> map
  let result: map = native_roots/return_value(builder, native_gen/record(builder, [:Record, "TaskDispatchBinding"], {
    "status" -> native_gen/ref(builder, "kernel_ok"), "applicable" -> applicable, "arguments" -> arguments}))
  let generated_result: map = result
  return generated_result
end

// Signatures have validated declaration order and modes. Restrictions are
// checked by selection against the bound values, including default/rest values.
verb native_dispatch/bind_named_body(module: map) -> map
  let builder: map = native_query/context(module, "task_dispatch_bind_named")
  builder = native_execution/control_scope(builder, native_roots/worker(builder), native_roots/ref(builder, "budget"))
  builder = native_dispatch/vocabulary_check(builder)
  let signature: map = native_roots/ref(builder, "signature")
  builder = native_query/check(builder, native_gen/negate(native_kernel/absent(signature)), "schema")
  let parameters: map = native_kernel/load_field(builder, signature, "parameters")
  let roles: map = native_roots/ref(builder, "roles")
  builder = native_query/check(builder, native_gen/equal(native_gen/expression(:U8, :Tag, [roles]), native_gen/ref(builder, "tag_map")), "schema")
  let [empty: map, with_empty: map] = native_query/tuple(builder, [])
  let [arguments: map, rooted: map] = native_roots/retain(with_empty, "arguments", empty)
  let no_match = fn(missing) => native_dispatch/binding_result(missing, native_gen/ref(missing, "false"), native_gen/zero(native_value/word()))
  builder = native_query/each_row(rooted, parameters, fn(parameter, row)
    let role: map = native_dispatch/parameter(parameter, row, "role")
    let [mode: map, with_mode: map] = native_gen/bind(parameter, "mode", native_dispatch/parameter(parameter, row, "mode"))
    let [supplied: map, with_supplied: map] = native_gen/bind(with_mode, "supplied", native_gen/call(with_mode, "value_map_get", [roles, role]))
    let [argument: map, with_argument: map] = native_gen/bind(with_supplied, "argument", native_gen/field(with_supplied, supplied, "value"))
    let ready: map = native_gen/branch(with_argument, native_gen/equal(mode, native_dispatch/symbol(with_argument, "required")),
      fn(required) => native_gen/unless(required, native_gen/field(required, supplied, "ok"), no_match), fn(not_required)
        return native_gen/branch(not_required, native_gen/equal(mode, native_dispatch/symbol(not_required, "optional")), fn(defaulted)
          return native_gen/unless(defaulted, native_gen/field(defaulted, supplied, "ok"), fn(absent)
            return native_gen/assign(absent, argument, native_dispatch/parameter(absent, row, "default"))
          end)
        end, fn(rest)
          let checked: map = native_gen/unless(rest, native_gen/field(rest, supplied, "ok"), fn(absent)
            let [empty: map, created: map] = native_query/tuple(absent, [])
            return native_gen/assign(created, argument, empty)
          end)
          return native_gen/unless(checked, native_gen/equal(native_gen/expression(:U8, :Tag, [argument]), native_gen/ref(checked, "tag_list")), no_match)
        end)
      end)
    let [appended: map, with_appended: map] = native_query/value(ready, "kernel_query_append", [native_roots/worker(ready), arguments, argument])
    return native_roots/store(with_appended, arguments, appended)
  end)
  let generated_result: map = native_gen/finish(module, native_dispatch/binding_result(builder, native_gen/ref(builder, "true"), arguments))
  return generated_result
end

verb native_dispatch/bindings(input: map) -> map
  let module: map = native_dispatch/vocabulary(input)
  module[:state] = native/record_type(module[:state], "TaskDispatchBinding", [["status", :U64], ["applicable", :Bool], ["arguments", native_value/word()]])[1]
  module = native_tasks/declare(module, "dispatch_bind_named", [:Record, "TaskDispatchBinding"], [
    ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow],
    ["vocabulary", native_tasks/pointer("DispatchVocabulary"), :Borrow],
    ["signature", native_tasks/pointer("DispatchSignature"), :Gc], ["roles", native_value/word(), :Gc],
    ["budget", native_kernel/pointer("Budget"), :Borrow]], :Gc)
  let result: map = native_dispatch/bind_named_body(module)
  let generated_result: map = result
  return generated_result
end
