verb native_subscriptions/words() -> list
  return ["kind", "subscription", "cursor", "subject", "assertions", "retractions", "entries",
    "changes", "snapshot", "facts", "relation", "catalogue", "resynchronize", "revoked",
    "name", "rule", "relation_created", "relation_removed", "rule_installed", "rule_disabled", "rule_removed"]
end
verb native_subscriptions/symbol(builder: map, name: string) -> map
  let id: map = native_kernel/load_field(builder, native_gen/ref(builder, "vocabulary"), name)
  let result: map = native_gen/field(builder, native_gen/call(builder, "value_symbol", [id]), "value")
  return result
end
verb native_subscriptions/message_result(builder: map, fields: list) -> map
  let [value: map, ready: map] = native_literal/map(builder, fields, fn(failed) => native_rules/error(failed, "oom"))
  let result: map = native_roots/return_value(ready, native_gen/record(ready, [:Record, "TaskSubscriptionMessage"], {
    "status" -> native_gen/ref(ready, "kernel_ok"), "value" -> value}))
  return result
end
verb native_subscriptions/message_fields(builder: map, kind: map) -> list
  let cursor: map = native_gen/field(builder, native_gen/call(builder, "value_int", [native_gen/bitcast(:I64, native_gen/ref(builder, "cursor"))]), "value")
  return [[native_subscriptions/symbol(builder, "kind"), kind],
    [native_subscriptions/symbol(builder, "subscription"), native_roots/ref(builder, "capability")],
    [native_subscriptions/symbol(builder, "cursor"), cursor]]
end
verb native_subscriptions/message_context(module: map, name: string) -> map
  let builder: map = native_subscriptions/context(module, name)
  builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(native_gen/ref(builder, "vocabulary"))), "schema")
  let result: map = native_rules/check(builder, native_gen/negate(native_gen/less(native_gen/convert(:U64, native_gen/ref(builder, "int_max")), native_gen/ref(builder, "cursor"))), "limit")
  return result
end
verb native_subscriptions/vocabulary(input: map) -> map
  let module: map = input
  let fields: list = []
  let literals: map = {}
  for word in native_subscriptions/words()
    fields = [@fields, [word, :U32]]
    let [literal: map, ready: map] = native_literal/prepare(module, string_concat("subscription_word_", word), {:kind -> :Symbol, :value -> word})
    literals[word] = literal
    module = ready
  end
  module[:state] = native/record_type(module[:state], "TaskSubscriptionVocabulary", fields)[1]
  // Call during runtime initialization, before entering managed execution.
  // The resulting IDs are scalars, valid for the runtime symbol table's lifetime.
  module = native_memory/declare(module, "task_subscription_vocabulary_init", :U64,
    [["symbols", native_memory/record_pointer("SymbolTable"), :Borrow],
      ["vocabulary", native_tasks/pointer("SubscriptionVocabulary"), :Borrow]],
    [:ReadMemory, :WriteMemory, :Allocate, :Release, :Block], :Value, "")
  let builder: map = native_gen/context(module, "task_subscription_vocabulary_init")
  builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(native_gen/ref(builder, "symbols"))), "closed")
  builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(native_gen/ref(builder, "vocabulary"))), "schema")
  builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(native_kernel/load_field(builder, native_gen/ref(builder, "symbols"), "mutex"))), "closed")
  let values: map = {}
  for word in native_subscriptions/words()
    let [value: map, interned: map] = native_literal/emit(builder, literals[word], native_gen/ref(builder, "symbols"), fn(failed) => native_rules/error(failed, "oom"))
    let [id: map, decoded: map] = native_gen/bind(interned, "symbol_id", native_gen/call(interned, "value_as_symbol", [value]))
    builder = decoded
    values[word] = native_gen/convert(:U32, native_gen/field(builder, id, "number"))
  end
  builder = native_gen/store(builder, native_gen/ref(builder, "vocabulary"), native_gen/record(builder, [:Record, "TaskSubscriptionVocabulary"], values))
  let result: map = native_gen/finish(module, native_execution/fail(builder, native_gen/ref(builder, "kernel_ok")))
  return result
end
verb native_subscriptions/messages(input: map) -> map
  let module: map = native_subscriptions/vocabulary(input)
  let result_type: list = [:Record, "TaskSubscriptionMessage"]
  module[:state] = native/record_type(module[:state], "TaskSubscriptionMessage", [["status", :U64], ["value", native_value/word()]])[1]
  let common: list = [["worker", native_memory/record_pointer("MemoryWorker"), :Borrow],
    ["vocabulary", native_tasks/pointer("SubscriptionVocabulary"), :Borrow],
    ["capability", native_value/word(), :Gc], ["cursor", :U64, :Value]]
  module = native_tasks/declare(module, "subscription_marker", result_type, [@common, ["revoked", :Bool, :Value]], :Gc)
  module = native_tasks/declare(module, "subscription_rows_message", result_type, [@common,
    ["subject", :U64, :Value], ["initial", :Bool, :Value],
    ["assertions", native_value/word(), :Gc], ["retractions", native_value/word(), :Gc]], :Gc)
  module = native_tasks/declare(module, "subscription_catalogue_message", result_type, [@common,
    ["initial", :Bool, :Value], ["entries", native_value/word(), :Gc]], :Gc)

  let builder: map = native_subscriptions/message_context(module, "marker")
  let [kind: map, with_kind: map] = native_gen/bind(builder, "kind", native_subscriptions/symbol(builder, "resynchronize"))
  builder = native_gen/when(with_kind, native_gen/ref(with_kind, "revoked"), fn(revoked)
    return native_gen/assign(revoked, kind, native_subscriptions/symbol(revoked, "revoked"))
  end)
  module = native_gen/finish(module, native_subscriptions/message_result(builder, native_subscriptions/message_fields(builder, kind)))

  builder = native_subscriptions/message_context(module, "rows_message")
  let [subject: map, selected: map] = native_gen/bind(builder, "subject_word", native_subscriptions/symbol(builder, "facts"))
  builder = native_gen/switch(selected, native_gen/ref(selected, "subject"), [
    [native_gen/ref(selected, "task_subscription_facts"), fn(facts) => facts],
    [native_gen/ref(selected, "task_subscription_relation"), fn(relation) => native_gen/assign(relation, subject, native_subscriptions/symbol(relation, "relation"))]],
    fn(invalid) => native_rules/error(invalid, "schema"))
  builder = native_gen/when(builder, native_gen/ref(builder, "initial"), fn(initial)
    return native_gen/assign(initial, subject, native_subscriptions/symbol(initial, "snapshot"))
  end)
  let fields: list = [@native_subscriptions/message_fields(builder, native_subscriptions/symbol(builder, "changes")),
    [native_subscriptions/symbol(builder, "subject"), subject]]
  for name in ["assertions", "retractions"]
    let [rows: map, checked: map] = native_gen/bind(builder, "rows", native_gen/call(builder, "value_as_list", [native_roots/ref(builder, name)]))
    builder = native_rules/check(checked, native_gen/field(checked, rows, "ok"), "schema")
    fields = [@fields, [native_subscriptions/symbol(builder, name), native_roots/ref(builder, name)]]
  end
  module = native_gen/finish(module, native_subscriptions/message_result(builder, fields))

  builder = native_subscriptions/message_context(module, "catalogue_message")
  let [entries: map, checked: map] = native_gen/bind(builder, "entries_list", native_gen/call(builder, "value_as_list", [native_roots/ref(builder, "entries")]))
  builder = native_rules/check(checked, native_gen/field(checked, entries, "ok"), "schema")
  let [catalogue_kind: map, with_catalogue: map] = native_gen/bind(builder, "kind", native_subscriptions/symbol(builder, "changes"))
  builder = native_gen/when(with_catalogue, native_gen/ref(with_catalogue, "initial"), fn(initial)
    return native_gen/assign(initial, catalogue_kind, native_subscriptions/symbol(initial, "snapshot"))
  end)
  fields = [@native_subscriptions/message_fields(builder, catalogue_kind),
    [native_subscriptions/symbol(builder, "subject"), native_subscriptions/symbol(builder, "catalogue")],
    [native_subscriptions/symbol(builder, "entries"), native_roots/ref(builder, "entries")]]
  let result: map = native_gen/finish(module, native_subscriptions/message_result(builder, fields))
  return result
end
