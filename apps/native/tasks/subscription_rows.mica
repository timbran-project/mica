// These selectors operate on already authorized snapshots. They do not obtain
// authority from a historical view; the delivery pump supplies fresh permission.
verb native_subscriptions/tree_body(module: map) -> map
  let builder: map = native_gen/context(module, "task_subscription_tree")
  let snapshot: map = native_gen/ref(builder, "snapshot")
  let request: map = native_gen/ref(builder, "request")
  let empty = fn(absent) => native_execution/fail(absent, native_gen/ref(absent, "kernel_ok"))
  builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(request)), "schema")
  builder = native_gen/when(builder, native_kernel/absent(snapshot), empty)
  let [schema: map, found: map] = native_gen/bind(builder, "schema", native_gen/call(builder, "kernel_rule_schema_index_lookup", [
    native_kernel/load_field(builder, snapshot, "schemas"), native_kernel/load_field(builder, request, "relation")]))
  builder = native_gen/when(found, native_kernel/absent(schema), empty)
  let [pattern: map, decoded: map] = native_gen/bind(builder, "pattern", native_gen/call(builder, "value_as_list", [native_kernel/load_field(builder, request, "pattern")]))
  builder = native_rules/check(decoded, native_gen/field(decoded, pattern, "ok"), "schema")
  let arity: map = native_kernel/load_field(builder, schema, "arity")
  builder = native_rules/check(builder, native_gen/equal(native_kernel/load_field(builder, native_gen/field(builder, pattern, "header"), "length"), arity), "schema")
  builder = native_kernel/check_column_mask(builder, arity, native_kernel/load_field(builder, request, "mask"), fn(failed) => native_rules/error(failed, "schema"))
  let evaluation: map = native_kernel/load_field(builder, snapshot, "evaluation")
  builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(evaluation)), "schema")
  let [rows: map, indexed: map] = native_gen/bind(builder, "rows", native_rules/rows_lookup(builder, evaluation, native_kernel/load_field(builder, request, "relation")))
  builder = native_rules/check(indexed, native_gen/negate(native_kernel/absent(rows)), "schema")
  let [tree: map, selected: map] = native_gen/bind(builder, "tree", native_kernel/load_field(builder, rows, "stored"))
  builder = native_gen/switch(selected, native_kernel/load_field(selected, request, "subject"), [
    [native_gen/ref(selected, "task_subscription_facts"), fn(facts) => facts],
    [native_gen/ref(selected, "task_subscription_relation"), fn(complete) => native_gen/assign(complete, tree, native_kernel/load_field(complete, rows, "all"))]],
    fn(invalid) => native_rules/error(invalid, "schema"))
  builder = native_roots/return_value(builder, native_gen/record(builder, [:Record, "TaskSubscriptionTree"], {
    "status" -> native_gen/ref(builder, "kernel_ok"), "tree" -> tree}))
  let result: map = native_gen/finish(module, builder)
  return result
end

// Find a source subtree's root in the other snapshot. Pointer equality proves
// that the entire subtree is shared, even when AVL rotations moved its parent.
// Only changed paths require further traversal. Initial scans pass a null other.
verb native_subscriptions/diff_tree_body(module: map) -> map
  let builder: map = native_query/context(module, "task_subscription_diff_tree")
  let node: map = native_roots/ref(builder, "node")
  let other: map = native_roots/ref(builder, "other")
  let done = fn(empty) => native_execution/fail(empty, native_gen/ref(empty, "kernel_ok"))
  builder = native_gen/when(builder, native_kernel/absent(node), done)
  builder = native_gen/when(builder, native_gen/equal(node, other), done)
  let ticks: map = native_gen/ref(builder, "ticks")
  builder = native_query/poll_interval(builder, native_gen/load(ticks))
  builder = native_gen/store(builder, ticks, native_gen/add(native_gen/load(ticks), native_gen/ref(builder, "one")))
  let row: map = native_kernel/load_field(builder, node, "row")
  let [matching: map, probed: map] = native_gen/bind(builder, "matching", native_gen/call(builder, "kernel_find", [other, row,
    native_gen/ref(builder, "zero"), native_gen/ref(builder, "false")]))
  builder = native_gen/when(probed, native_gen/equal(node, matching), done)
  let [absent: map, with_absent: map] = native_gen/bind(builder, "absent", native_kernel/absent(matching))
  let [order: map, compared: map] = native_gen/bind(with_absent, "prefix_order", native_kernel/compare_rows(with_absent, row,
    native_roots/ref(with_absent, "pattern"), native_kernel/tuple_projection(native_gen/ref(with_absent, "prefix"))))
  builder = compared
  for side in ["left", "right"]
    let descend: map = native_gen/negate(native_gen/less(order, native_gen/ref(builder, "int_zero")))
    if side == "right"
      descend = native_gen/negate(native_gen/less(native_gen/ref(builder, "int_zero"), order))
    end
    builder = native_gen/when(builder, descend, fn(branch) => native_subscriptions/call(branch, "task_subscription_diff_tree", [
      native_roots/worker(branch), native_kernel/load_field(branch, node, side), other,
      native_roots/ref(branch, "pattern"), native_gen/ref(branch, "mask"), native_gen/ref(branch, "prefix"),
      native_gen/ref(branch, "output"), ticks, native_roots/ref(branch, "budget")]))
    if side == "left"
      builder = native_gen/when(builder, absent, fn(missing)
        let matches: map = native_kernel/absent(native_kernel/compare_rows(missing, native_kernel/load_field(missing, node, "row"),
          native_roots/ref(missing, "pattern"), native_kernel/tuple_projection(native_gen/ref(missing, "mask"))))
        return native_gen/when(missing, matches, fn(selected) => native_query/offer(selected,
          native_roots/root_value(selected, native_gen/ref(selected, "output"), native_kernel/pointer("Node")),
          native_kernel/load_field(selected, node, "row")))
      end)
    end
  end
  let result: map = native_gen/finish(module, done(builder))
  return result
end

verb native_subscriptions/rows_body(module: map) -> map
  let builder: map = native_query/context(module, "task_subscription_rows")
  builder = native_execution/control_scope(builder, native_roots/worker(builder), native_roots/ref(builder, "budget"))
  let request: map = native_roots/ref(builder, "request")
  builder = native_rules/check(builder, native_gen/negate(native_kernel/absent(request)), "schema")
  let [pattern: map, decoded: map] = native_gen/bind(builder, "pattern_list", native_gen/call(builder, "value_as_list", [native_kernel/load_field(builder, request, "pattern")]))
  builder = native_rules/check(decoded, native_gen/field(decoded, pattern, "ok"), "schema")
  let pattern_width: map = native_kernel/load_field(builder, native_gen/field(builder, pattern, "header"), "length")
  builder = native_rules/check(builder, native_gen/negate(native_gen/less(native_gen/ref(builder, "kernel_64"), pattern_width)), "schema")
  builder = native_kernel/check_column_mask(builder, pattern_width, native_kernel/load_field(builder, request, "mask"), fn(failed) => native_rules/error(failed, "schema"))
  builder = native_gen/switch(builder, native_kernel/load_field(builder, request, "subject"), [
    [native_gen/ref(builder, "task_subscription_facts"), fn(facts) => facts],
    [native_gen/ref(builder, "task_subscription_relation"), fn(complete) => complete]], fn(invalid) => native_rules/error(invalid, "schema"))
  let trees: map = {}
  for name in ["before", "after"]
    let [result: map, selected: map] = native_gen/bind(builder, "selection", native_gen/call(builder, "task_subscription_tree", [native_roots/ref(builder, name), request]))
    builder = native_gen/unless(selected, native_kernel/absent(native_gen/field(selected, result, "status")),
      fn(failed) => native_execution/fail(failed, native_gen/field(failed, result, "status")))
    let [tree: map, rooted: map] = native_roots/retain(builder, name, native_gen/field(builder, result, "tree"))
    trees[name] = tree
    builder = rooted
  end
  let [prefix: map, with_prefix: map] = native_gen/bind(builder, "prefix", native_gen/ref(builder, "zero"))
  let width: map = native_gen/call(with_prefix, "kernel_width", [native_kernel/load_field(with_prefix, request, "pattern")])
  builder = native_kernel/columns(with_prefix, width, fn(column, position, bit)
    return native_kernel/extend_prefix(column, prefix, native_kernel/load_field(column, request, "mask"), bit)
  end)
  let [ticks: map, with_ticks: map] = native_gen/bind(builder, "visited", native_gen/ref(builder, "zero"))
  builder = with_ticks
  let result_fields: map = {"status" -> native_gen/ref(builder, "kernel_ok"), "visited" -> ticks}
  for selection in [["assertions", "after", "before"], ["retractions", "before", "after"]]
    let [output: map, with_output: map] = native_query/row_set(builder)
    builder = native_subscriptions/call(with_output, "task_subscription_diff_tree", [native_roots/worker(with_output), trees[selection[1]], trees[selection[2]],
      native_kernel/load_field(with_output, request, "pattern"), native_kernel/load_field(with_output, request, "mask"), prefix,
      output[:scope_root], native_gen/address(ticks), native_roots/ref(with_output, "budget")])
    let [gathered: map, finished: map] = native_gen/bind(builder, "gathered", native_gen/call(builder, "kernel_query_finish", [
      native_roots/worker(builder), output, width, native_roots/ref(builder, "budget")]))
    builder = native_gen/unless(finished, native_kernel/absent(native_gen/field(finished, gathered, "status")),
      fn(failed) => native_execution/fail(failed, native_gen/field(failed, gathered, "status")))
    let [rows: map, retained: map] = native_roots/retain(builder, selection[0], native_gen/field(builder, gathered, "rows"))
    result_fields[selection[0]] = rows
    builder = retained
  end
  builder = native_roots/return_value(builder, native_gen/record(builder, [:Record, "TaskSubscriptionRows"], result_fields))
  let result: map = native_gen/finish(module, builder)
  return result
end
verb native_subscriptions/row_selection(input: map) -> map
  let module: map = input
  module[:state] = native/record_type(module[:state], "TaskSubscriptionTree", [["status", :U64], ["tree", native_kernel/pointer("Node")]])[1]
  module[:state] = native/record_type(module[:state], "TaskSubscriptionRows", [["status", :U64],
    ["assertions", native_value/word()], ["retractions", native_value/word()], ["visited", :U64]])[1]
  let request: list = ["request", native_tasks/pointer("SubscriptionRequest"), :Gc]
  let worker: list = ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]
  let budget: list = ["budget", native_kernel/pointer("Budget"), :Borrow]
  module = native_memory/declare(module, "task_subscription_tree", [:Record, "TaskSubscriptionTree"],
    [["snapshot", native_kernel/pointer("Snapshot"), :Gc], request], [:ReadMemory], :Gc, "")
  module = native_tasks/declare(module, "subscription_diff_tree", :U64, [worker,
    ["node", native_kernel/pointer("Node"), :Gc], ["other", native_kernel/pointer("Node"), :Gc],
    ["pattern", native_value/word(), :Gc], ["mask", :U64, :Value], ["prefix", :U64, :Value],
    ["output", native_memory/record_pointer("MemoryRoot"), :Borrow], ["ticks", native_memory/pointer(:U64), :Borrow], budget])
  module = native_tasks/declare(module, "subscription_rows", [:Record, "TaskSubscriptionRows"], [worker,
    ["before", native_kernel/pointer("Snapshot"), :Gc], ["after", native_kernel/pointer("Snapshot"), :Gc], request, budget], :Gc)
  module = native_subscriptions/tree_body(module)
  module = native_subscriptions/diff_tree_body(module)
  module = native_subscriptions/rows_body(module)
  return module
end
