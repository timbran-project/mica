// A closure owns a code descriptor and an immutable capture list. Authority
// comes from the invoking attempt; it is never retained in the closure.
verb native_functions/body(builder: map, function: map) -> map
  let header: map = native_gen/expression(native_memory/record_pointer("HeapFunction"), :UnpackPointer, [function])
  let result: map = native_gen/cast(native_tasks/pointer("FunctionCode"), native_kernel/load_field(builder, header, "target"))
  return result
end
verb native_functions/check_body(builder: map, body: map) -> map
  let ready: map = native_tasks/check(builder, native_gen/negate(native_kernel/absent(body)), "schema")
  let object: map = native_gen/call(ready, "memory_object", [native_gen/cast(native_memory/pointer(:U8), body)])
  ready = native_tasks/check(ready, native_gen/equal(native_kernel/load_field(ready, object, "layout"), native_gen/ref(ready, "task_layout_FunctionCode")), "schema")
  ready = native_tasks/check(ready, native_gen/negate(native_kernel/absent(native_kernel/load_field(ready, body, "entry"))), "schema")
  let code: map = native_kernel/load_field(ready, body, "code")
  ready = native_tasks/check(ready, native_gen/negate(native_kernel/absent(code)), "schema")
  let owner: map = native_kernel/load_field(ready, code, "owner")
  ready = native_tasks/check(ready, native_gen/negate(native_kernel/absent(owner)), "schema")
  let result: map = native_tasks/check(ready, native_kernel/load_field(ready, owner, "sealed"), "closed")
  return result
end

// Reserve identities in batches. The common creation path is worker-local;
// failed allocation and transaction retries never recycle an identity.
verb native_functions/identity(builder: map) -> list
  let batch: map = native_gen/ref(builder, "function_id_batch")
  let ready: map = native_gen/when(builder, native_gen/equal(native_tasks/attempt_field(builder, "function_next"), native_tasks/attempt_field(builder, "function_limit")), fn(empty)
    let [ids: map, reserved: map] = native_gen/checked_bind(empty, "identities", native_gen/call(empty, "task_resource_reserve", [native_roots/worker(empty), batch]), "ok",
      fn(exhausted) => native_tasks/attempt_status(exhausted, "limit"))
    let start: map = native_gen/field(reserved, ids, "number")
    let saved: map = native_kernel/store_field(reserved, native_tasks/attempt(reserved), "function_next", start)
    return native_kernel/store_field(saved, native_tasks/attempt(saved), "function_limit", native_gen/add(start, batch))
  end)
  let [id: map, with_id: map] = native_gen/bind(ready, "identity", native_tasks/attempt_field(ready, "function_next"))
  ready = native_kernel/store_field(with_id, native_tasks/attempt(with_id), "function_next", native_gen/add(id, native_gen/ref(with_id, "one")))
  return [id, ready]
end
verb native_functions/create_body(module: map) -> map
  let builder: map = native_handlers/context(module, "function_create")
  let body: map = native_roots/ref(builder, "body")
  builder = native_functions/check_body(builder, body)
  builder = native_tasks/check(builder, native_gen/equal(native_gen/call(builder, "value_kind", [native_roots/ref(builder, "captures")]), native_gen/ref(builder, "tag_list")), "schema")
  let [identity: map, reserved: map] = native_functions/identity(builder)
  let [value: map, made: map] = native_gen/checked_bind(reserved, "closure", native_gen/call(reserved, "value_function", [native_roots/worker(reserved), identity,
    native_gen/cast(native_memory/pointer(:U8), body), native_roots/ref(reserved, "captures")]), "ok", fn(failed) => native_tasks/attempt_status(failed, "oom"))
  let output: map = native_roots/root_value(made, native_gen/ref(made, "output"), native_value/word())
  builder = native_roots/store(made, output, native_gen/field(made, value, "value"))
  let result: map = native_gen/finish(module, native_tasks/attempt_status(builder, "ok"))
  return result
end
verb native_functions/call_body(module: map) -> map
  let builder: map = native_handlers/context(module, "function_call")
  let function: map = native_roots/ref(builder, "function")
  let arguments: map = native_roots/ref(builder, "arguments")
  for [value, kind] in [[function, "function"], [arguments, "list"]]
    builder = native_tasks/check(builder, native_gen/equal(native_gen/call(builder, "value_kind", [value]), native_gen/ref(builder, string_concat("tag_", kind))), "schema")
  end
  let body: map = native_functions/body(builder, function)
  builder = native_functions/check_body(builder, body)
  let count: map = native_query/width(builder, arguments)
  builder = native_tasks/check(builder, native_gen/negate(native_gen/less(count, native_kernel/load_field(builder, body, "minimum"))), "arity")
  builder = native_tasks/check(builder, native_gen/negate(native_gen/less(native_kernel/load_field(builder, body, "maximum"), count)), "arity")
  let [caller: map, depth: map, ready: map] = native_calls/continuation(builder)
  let header: map = native_gen/expression(native_memory/record_pointer("HeapFunction"), :UnpackPointer, [function])
  let [environment: map, rooted: map] = native_roots/retain(ready, "environment", native_kernel/load_field(ready, header, "captures"))
  builder = native_gen/when(rooted, native_kernel/load_field(rooted, body, "bind_self"), fn(recursive)
    let [appended: map, checked: map] = native_gen/checked_bind(recursive, "self", native_gen/call(recursive, "value_list_append", [native_roots/worker(recursive), environment, function]), "ok", fn(failed) => native_tasks/attempt_status(failed, "oom"))
    return native_roots/store(checked, environment, native_gen/field(checked, appended, "value"))
  end)
  let [appended: map, checked: map] = native_gen/checked_bind(builder, "actuals", native_gen/call(builder, "value_list_append", [native_roots/worker(builder), environment, arguments]), "ok", fn(failed) => native_tasks/attempt_status(failed, "oom"))
  builder = native_roots/store(checked, environment, native_gen/field(checked, appended, "value"))
  let [callee: map, created: map] = native_gen/bind(builder, "callee", native_handlers/copy_image(builder, native_handlers/current(builder), {
    "entry" -> native_kernel/load_field(builder, body, "entry"), "code" -> native_kernel/load_field(builder, body, "code"),
    "pending" -> native_gen/zero(native_tasks/pointer("Invocation")), "environment" -> environment,
    "input" -> native_gen/zero(native_value/word()), "caller" -> caller, "depth" -> depth}))
  builder = native_tasks/check(created, native_gen/negate(native_kernel/absent(callee)), "oom")
  builder = native_roots/store(builder, native_handlers/current(builder), callee)
  let result: map = native_gen/finish(module, native_tasks/attempt_status(builder, "ok"))
  return result
end
verb native_functions/program(input: map) -> map
  let module: map = input
  let worker: list = ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]
  let attempt: list = ["attempt", native_tasks/pointer("Attempt"), :Borrow]
  module = native_tasks/declare(module, "function_create", :U64, [worker, attempt,
    ["body", native_tasks/pointer("FunctionCode"), :Gc], ["captures", native_value/word(), :Gc],
    ["output", native_memory/record_pointer("MemoryRoot"), :Borrow]])
  module = native_tasks/declare(module, "function_call", :U64, [worker, attempt,
    ["function", native_value/word(), :Gc], ["arguments", native_value/word(), :Gc], ["continuation", native_tasks/pointer("Image"), :Gc]])
  module = native_functions/create_body(module)
  let result: map = native_functions/call_body(module)
  return result
end
