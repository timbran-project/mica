// A worker owns its roots and nursery while active. It must enter before
// accessing managed payloads, and leave before blocking outside the runtime.
// The heap mutex guards membership, collection, and mature allocation only.
verb native_memory/lifecycle(input: map) -> map
  let context: map = input
  let bytes: list = native_memory/pointer(:U8)
  let heap: list = native_memory/record_pointer("MemoryHeap")
  let worker: list = native_memory/record_pointer("MemoryWorker")
  let root: list = native_memory/record_pointer("MemoryRoot")
  let object: list = native_memory/record_pointer("MemoryObject")
  let trace: list = [:FunctionPointer, "MemoryTrace"]
  let effects: list = [:ReadMemory, :WriteMemory, :Allocate, :Release]
  for spec in [
    ["memory_sync_create", bytes, [], [:Allocate], :Owned],
    ["memory_sync_destroy", :Void, [["sync", bytes, :Borrow]], [:Release], :Value],
    ["memory_lock", :Void, [["sync", bytes, :Borrow]], [:ReadMemory, :WriteMemory], :Value],
    ["memory_unlock", :Void, [["sync", bytes, :Borrow]], [:ReadMemory, :WriteMemory], :Value],
    ["memory_wait", :Void, [["sync", bytes, :Borrow]], [:ReadMemory, :WriteMemory], :Value],
    ["memory_wake", :Void, [["sync", bytes, :Borrow]], [:ReadMemory, :WriteMemory], :Value]]
    context = native/declare_function(context, spec[0], spec[1], spec[2], [], spec[3], spec[4], "")
    context[:state] = native/foreign(context[:state], context[:functions][spec[0]])
  end
  for spec in [
    ["memory_heap_init", :Bool, [["heap", heap, :Borrow], ["trace", trace, :Value]], effects, :Value],
    ["memory_heap_release", :Bool, [["heap", heap, :Borrow]], effects, :Value],
    ["memory_worker_init", :Bool, [["worker", worker, :Borrow], ["heap", heap, :Borrow], ["capacity", :U64, :Value]], effects, :Value],
    ["memory_worker_release", :Bool, [["worker", worker, :Borrow]], effects, :Value],
    ["memory_enter", :Bool, [["worker", worker, :Borrow]], effects, :Value],
    ["memory_leave", :Bool, [["worker", worker, :Borrow]], effects, :Value],
    ["memory_safepoint", :Bool, [["worker", worker, :Borrow], ["collect", :Bool, :Value]], [@effects, :Relocate], :Value],
    ["memory_allocate", bytes, [["worker", worker, :Borrow], ["size", :U64, :Value], ["layout", :U64, :Value]], [:ReadMemory, :WriteMemory, :Allocate], :Gc],
    ["memory_root_push", :Bool, [["worker", worker, :Borrow], ["root", root, :Borrow]], [:ReadMemory, :WriteMemory], :Value],
    ["memory_root_pop", :Bool, [["worker", worker, :Borrow], ["root", root, :Borrow]], [:ReadMemory, :WriteMemory], :Value],
    ["memory_publish", :Bool, [["worker", worker, :Borrow], ["source", root, :Borrow], ["shared", root, :Borrow]], [@effects, :Relocate], :Value],
    ["memory_acquire", :Bool, [["worker", worker, :Borrow], ["shared", root, :Borrow], ["root", root, :Borrow]], [:ReadMemory, :WriteMemory], :Value],
    ["memory_unpublish", :Bool, [["worker", worker, :Borrow], ["shared", root, :Borrow]], [:ReadMemory, :WriteMemory], :Value]]
    context = native_memory/declare(context, spec[0], spec[1], spec[2], spec[3], spec[4], "")
  end
  let sync: list = [native/let_statement("sync", bytes, native_memory/field(bytes, "heap", "mutex")),
    native_memory/call("memory_lock", ["sync"])]
  let worker_heap: list = [native/let_statement("heap", heap, native_memory/field(heap, "worker", "heap"))]
  let unlock: list = [native_memory/call("memory_unlock", ["sync"])]
  let wait: list = [native/while_statement("memory_true", [
    native/let_statement("collecting", :Bool, native_memory/field(:Bool, "heap", "collecting")),
    native/unless_statement("collecting", [native/break_statement()]),
    native_memory/call("memory_wait", ["sync"])])]
  let failed: list = [@unlock, native/return_value("memory_false")]
  let success: list = [@unlock, native/return_value("memory_true")]
  context = native/define_function(context, "memory_heap_init", [
    native/unless_statement(native/binary_expression(:Equal, native_memory/field(bytes, "heap", "mutex"), "memory_null_bytes"), [native/return_value("memory_false")]),
    native/let_call("sync", bytes, "memory_sync_create", []),
    native/when_statement(native/binary_expression(:Equal, "sync", "memory_null_bytes"), [native/return_value("memory_false")]),
    native/store_statement("heap", native/typed_expression([:Record, "MemoryHeap"], [:Zero])),
    native/let_statement("slot", native_memory/pointer(bytes), native/field_pointer_expression("heap", "mutex")),
    native/let_statement("adopted", bytes, native/binary_expression(:Adopt, "slot", "sync")),
    native_memory/store(trace, "heap", "trace", "trace"),
    native_memory/store(:Bool, "heap", "collection_ok", "memory_true"),
    native/return_value("memory_true")])
  context = native/define_function(context, "memory_heap_release", [
    native/when_statement(native/binary_expression(:Equal, native_memory/field(bytes, "heap", "mutex"), "memory_null_bytes"), [native/return_value("memory_false")]),
    @sync,
    native/unless_statement(native/binary_expression(:Equal, native_memory/field(worker, "heap", "workers"), "memory_null_worker"), failed),
    native/unless_statement(native/binary_expression(:Equal, native_memory/field(root, "heap", "roots"), "memory_null_root"), failed),
    native_memory/call("memory_sweep", ["heap", "memory_true"]),
    @unlock, native_memory/call("memory_sync_destroy", ["sync"]),
    native/store_statement("heap", native/typed_expression([:Record, "MemoryHeap"], [:Zero])), native/return_value("memory_true")])
  context = native/define_function(context, "memory_worker_init", [
    native/unless_statement(native/binary_expression(:Equal, native_memory/field(heap, "worker", "heap"), "memory_null_heap"), [native/return_value("memory_false")]),
    native/when_statement(native/binary_expression(:Less, "memory_allocation_limit", "capacity"), [native/return_value("memory_false")]),
    native/let_statement("nursery", bytes, "memory_null_bytes"),
    native/unless_statement(native/binary_expression(:Equal, "capacity", "memory_n0"), [
      native/set_statement("nursery", native/call_expression("memory_platform_allocate", ["capacity"])),
      native/when_statement(native/binary_expression(:Equal, "nursery", "memory_null_bytes"), [native/return_value("memory_false")])]),
    @sync, @wait,
    native/store_statement("worker", native/typed_expression([:Record, "MemoryWorker"], [:Zero])),
    native/let_statement("slot", native_memory/pointer(bytes), native/field_pointer_expression("worker", "nursery")),
    native/unless_statement(native/binary_expression(:Equal, "nursery", "memory_null_bytes"), [
      native/let_statement("adopted", bytes, native/binary_expression(:Adopt, "slot", "nursery"))]),
    native_memory/store(:U64, "worker", "capacity", "capacity"),
    native_memory/store_root(heap, "worker", "heap", native/typed_expression(heap, native/manage_expression("heap"))),
    native_memory/store_root(worker, "worker", "next", native_memory/root(worker, "heap", "workers")),
    native_memory/store_root(worker, "heap", "workers", native/typed_expression(worker, native/manage_expression("worker"))),
    @success])
  context = native/define_function(context, "memory_worker_release", [
    @worker_heap,
    native/when_statement(native/binary_expression(:Equal, "heap", "memory_null_heap"), [native/return_value("memory_false")]),
    @sync,
    native/when_statement(native_memory/field(:Bool, "worker", "active"), failed),
    @wait,
    native/unless_statement(native/binary_expression(:Equal, native_memory/field(root, "worker", "roots"), "memory_null_root"), failed),
    native/let_statement("link", native_memory/pointer(worker), native/field_pointer_expression("heap", "workers")),
    native/while_statement("memory_true", [
      native/let_statement("candidate", worker, native/root_load_expression("link")),
      native/when_statement(native/binary_expression(:Equal, "candidate", "memory_null_worker"), failed),
      native/when_statement(native/binary_expression(:Equal, "candidate", "worker"), [native/break_statement()]),
      native/set_statement("link", native/field_pointer_expression("candidate", "next"))]),
    native/root_store_statement("link", native_memory/root(worker, "worker", "next")),
    native/let_statement("nursery", bytes, native_memory/root(bytes, "worker", "nursery")),
    native_memory/call("memory_platform_release", ["nursery"]),
    native/store_statement("worker", native/typed_expression([:Record, "MemoryWorker"], [:Zero])), @success])
  for operation in ["enter", "leave"]
    let body: list = [@worker_heap, @sync]
    if operation == "enter"
      body = [@body,
        native/when_statement(native_memory/field(:Bool, "worker", "active"), failed),
        @wait,
        native_memory/store(:Bool, "worker", "active", "memory_true")]
    else
      body = [@body,
        native/let_statement("active", :Bool, native_memory/field(:Bool, "worker", "active")),
        native/unless_statement("active", failed),
        native_memory/store(:Bool, "worker", "active", "memory_false"),
        native_memory/call("memory_wake", ["sync"])]
    end
    context = native/define_function(context, string_concat("memory_", operation), [@body, @success])
  end
  context = native/define_function(context, "memory_safepoint", [
    @worker_heap, @sync,
    native/let_statement("active", :Bool, native_memory/field(:Bool, "worker", "active")),
    native/unless_statement("active", failed),
    native_memory/store(:Bool, "worker", "active", "memory_false"),
    native_memory/call("memory_wake", ["sync"]),
    native/let_statement("requested", :Bool, native_memory/field(:Bool, "heap", "collecting")),
    native/if_statement("requested", wait, [
      native/let_statement("pressure", :Bool, native_memory/field(:Bool, "worker", "pressure")),
      native/let_statement("should_collect", :Bool, "collect"),
      native/when_statement("pressure", [native/set_statement("should_collect", "memory_true")]),
      native/when_statement("should_collect", [
        native_memory/store(:Bool, "heap", "collecting", "memory_true"),
        native/while_statement("memory_true", [
          native/let_statement("busy", :Bool, "memory_false"),
          native/let_statement("other", worker, native_memory/root(worker, "heap", "workers")),
          native/while_statement("memory_true", [
            native/when_statement(native/binary_expression(:Equal, "other", "memory_null_worker"), [native/break_statement()]),
            native/when_statement(native_memory/field(:Bool, "other", "active"), [native/set_statement("busy", "memory_true"), native/break_statement()]),
            native/set_statement("other", native_memory/root(worker, "other", "next"))]),
          native/unless_statement("busy", [native/break_statement()]),
          native_memory/call("memory_wait", ["sync"])]),
        native/let_call("ok", :Bool, "memory_collect_stopped", ["heap"]),
        native_memory/store(:Bool, "heap", "collection_ok", "ok"),
        native_memory/store(:Bool, "heap", "collecting", "memory_false"),
        native_memory/store(:U64, "heap", "epoch", native/typed_expression(:U64,
          native/binary_expression(:Add, native_memory/field(:U64, "heap", "epoch"), "memory_n1"))),
        native_memory/call("memory_wake", ["sync"])])]),
    native_memory/store(:Bool, "worker", "active", "memory_true"),
    native/let_statement("result", :Bool, native_memory/field(:Bool, "heap", "collection_ok")),
    @unlock, native/return_value("result")])
  context = native/define_function(context, "memory_allocate", [
    native/let_statement("active", :Bool, native_memory/field(:Bool, "worker", "active")),
    native/unless_statement("active", [native/return_value("memory_null_bytes")]),
    native/let_call("allocation", bytes, "memory_nursery_allocate", ["worker", "size", "layout"]),
    native/unless_statement(native/binary_expression(:Equal, "allocation", "memory_null_bytes"), [native/return_value("allocation")]),
    native_memory/store(:Bool, "worker", "pressure", "memory_true"),
    @worker_heap, @sync,
    native/let_call("object", object, "memory_mature_allocate", ["heap", "size", "layout"]),
    @unlock,
    native/when_statement(native/binary_expression(:Equal, "object", "memory_null_object"), [native/return_value("memory_null_bytes")]),
    // Overflow storage remains worker-private until a successful collection.
    // The active worker prevents the collector from observing this initialization.
    native_memory/store(:U64, "object", "state", "memory_object_private"),
    native/return_value(native/call_expression("memory_payload", ["object"]))])
  context = native/define_function(context, "memory_root_push", [
    native/let_statement("active", :Bool, native_memory/field(:Bool, "worker", "active")),
    native/unless_statement("active", [native/return_value("memory_false")]),
    native/unless_statement(native/binary_expression(:Equal, native_memory/field(:U64, "root", "registration"), "memory_n0"), [native/return_value("memory_false")]),
    native_memory/store_root(root, "root", "next", native_memory/root(root, "worker", "roots")),
    native_memory/store_root(root, "worker", "roots", native/typed_expression(root, native/manage_expression("root"))),
    native_memory/store(:U64, "root", "registration", "memory_n1"), native/return_value("memory_true")])
  context = native/define_function(context, "memory_root_pop", [
    native/let_statement("active", :Bool, native_memory/field(:Bool, "worker", "active")),
    native/unless_statement("active", [native/return_value("memory_false")]),
    native/unless_statement(native/binary_expression(:Equal, native_memory/root(root, "worker", "roots"), "root"), [native/return_value("memory_false")]),
    native_memory/store_root(root, "worker", "roots", native_memory/root(root, "root", "next")),
    native/store_statement("root", native/typed_expression([:Record, "MemoryRoot"], [:Zero])), native/return_value("memory_true")])
  context = native/define_function(context, "memory_publish", [
    native/let_statement("candidate", root, native_memory/field(root, "worker", "roots")),
    native/while_statement("memory_true", [
      native/when_statement(native/binary_expression(:Equal, "candidate", "memory_null_root"), [native/return_value("memory_false")]),
      native/when_statement(native/binary_expression(:Equal, "candidate", "source"), [native/break_statement()]),
      native/set_statement("candidate", native_memory/field(root, "candidate", "next"))]),
    native/unless_statement(native/call_expression("memory_safepoint", ["worker", "memory_true"]), [native/return_value("memory_false")]),
    @worker_heap, @sync,
    native/unless_statement(native/binary_expression(:Equal, native_memory/field(:U64, "shared", "registration"), "memory_n0"), failed),
    native_memory/store_root(bytes, "shared", "pointer", native_memory/root(bytes, "source", "pointer")),
    native_memory/store(:U64, "shared", "bits", native_memory/field(:U64, "source", "bits")),
    native_memory/store_root(root, "shared", "next", native_memory/root(root, "heap", "roots")),
    native_memory/store_root(root, "heap", "roots", native/typed_expression(root, native/manage_expression("shared"))),
    native_memory/store(:U64, "shared", "registration", "memory_n2"), @success])
  let find_shared: list = [
    native/let_statement("link", native_memory/pointer(root), native/field_pointer_expression("heap", "roots")),
    native/while_statement("memory_true", [
      native/let_statement("candidate", root, native/root_load_expression("link")),
      native/when_statement(native/binary_expression(:Equal, "candidate", "memory_null_root"), failed),
      native/when_statement(native/binary_expression(:Equal, "candidate", "shared"), [native/break_statement()]),
      native/set_statement("link", native/field_pointer_expression("candidate", "next"))])]
  let active: list = [native/let_statement("active", :Bool, native_memory/field(:Bool, "worker", "active")),
    native/unless_statement("active", [native/return_value("memory_false")])]
  context = native/define_function(context, "memory_acquire", [
    @active, @worker_heap, @sync, @find_shared,
    native/unless_statement(native/call_expression("memory_root_push", ["worker", "root"]), failed),
    native_memory/store_root(bytes, "root", "pointer", native_memory/root(bytes, "shared", "pointer")),
    native_memory/store(:U64, "root", "bits", native_memory/field(:U64, "shared", "bits")),
    @success])
  context = native/define_function(context, "memory_unpublish", [
    @active, @worker_heap, @sync, @find_shared,
    native/root_store_statement("link", native_memory/root(root, "shared", "next")),
    native/store_statement("shared", native/typed_expression([:Record, "MemoryRoot"], [:Zero])), @success])
  return context
end
