verb native_memory/free_slot(heap, bucket) -> list
  let object: list = native_memory/record_pointer("MemoryObject")
  let array: list = [:Array, object, 10]
  let result: list = native/typed_expression(native_memory/pointer(object), native/binary_expression(:ElementPointer,
    native/typed_expression(native_memory/pointer(array), native/field_pointer_expression(heap, "free")), bucket))
  return result
end

verb native_memory/allocation(input: map) -> map
  let context: map = input
  let bytes: list = native_memory/pointer(:U8)
  let object: list = native_memory/record_pointer("MemoryObject")
  let page: list = native_memory/record_pointer("MemoryPage")
  let header: list = [:Record, "MemoryObject"]
  // The caller holds the heap mutex. Count reserved nursery storage and whole
  // managed pages, including free cells, without overflowing either sum.
  let check: map = native_gen/context(context, "memory_has_capacity")
  let heap: map = native_gen/ref(check, "heap")
  let [remaining: map, ready: map] = native_gen/bind(check, "remaining", native_gen/read(native_gen/field(check, heap, "capacity_limit")))
  check = ready
  for field in ["nursery_bytes", "allocated"]
    let used: map = native_gen/read(native_gen/field(check, heap, field))
    check = native_gen/when(check, native_gen/less(remaining, used), fn(full) => native_gen/return_value(full, native_gen/ref(full, "memory_false")))
    check = native_gen/assign(check, remaining, native_gen/subtract(remaining, used))
  end
  check = native_gen/return_value(check, native_gen/negate(native_gen/less(remaining, native_gen/ref(check, "size"))))
  context = native_gen/finish(context, check)
  context = native/define_function(context, "memory_object", [
    native/let_statement("header", object, native/unary_expression(:PointerCast, "pointer")),
    native/return_value(native/offset_expression("header", "memory_previous"))])
  context = native/define_function(context, "memory_payload", [
    native/let_offset("end", object, "object", "memory_n1"),
    native/return_value(native/unary_expression(:PointerCast, "end"))])
  context = native/define_function(context, "memory_original", [
    native/let_statement("state", :U64, native_memory/field(:U64, "object", "state")),
    native/unless_statement(native/binary_expression(:Equal, "state", "memory_object_nursery"), [
      native/let_statement("source", object, native_memory/field(object, "object", "forward")),
      native/unless_statement(native/binary_expression(:Equal, "source", "memory_null_object"), [
        native/return_value(native/call_expression("memory_payload", ["source"]))])]),
    native/return_value(native/call_expression("memory_payload", ["object"]))])
  context = native/define_function(context, "memory_nursery_allocate", [
    native/when_statement(native/binary_expression(:Equal, "size", "memory_n0"), [native/return_value("memory_null_bytes")]),
    native/when_statement(native/binary_expression(:Less, "memory_allocation_limit", "size"), [native/return_value("memory_null_bytes")]),
    native/let_statement("used", :U64, native_memory/field(:U64, "worker", "used")),
    native/let_statement("capacity", :U64, native_memory/field(:U64, "worker", "capacity")),
    native/let_statement("header_size", :U64, native/unary_expression(:SizeOf, header)),
    @native_memory/object_extent("size", "header_size", "total"),
    native/when_statement(native/binary_expression(:Less, "capacity", "used"), [native/return_value("memory_null_bytes")]),
    native/let_statement("remaining", :U64, native/binary_expression(:Subtract, "capacity", "used")),
    native/when_statement(native/binary_expression(:Less, "remaining", "total"), [native/return_value("memory_null_bytes")]),
    native/let_statement("nursery", bytes, native_memory/field(bytes, "worker", "nursery")),
    native/let_offset("allocation", bytes, "nursery", "used"),
    native/let_statement("managed", bytes, native/manage_expression("allocation")),
    native/let_statement("object", object, native/unary_expression(:PointerCast, "managed")),
    native/let_statement("owner", native_memory/record_pointer("MemoryHeap"), native_memory/root(native_memory/record_pointer("MemoryHeap"), "worker", "heap")),
    native/store_statement("object", native/initialize_record(native_memory/object_schema(),
      {"next" -> "memory_null_object", "work" -> "memory_null_object", "forward" -> "memory_null_object",
        "page" -> "memory_null_page", "heap" -> "owner", "size" -> "size", "layout" -> "layout",
        "mark" -> "memory_n0", "state" -> "memory_object_nursery"})),
    native_memory/store(:U64, "worker", "used", native/typed_expression(:U64, native/binary_expression(:Add, "used", "total"))),
    native/return_value(native/call_expression("memory_payload", ["object"]))])

  // Ten size classes cover 128-byte through 64-KiB cells. Larger objects own
  // one page. Collection returns unused cells to the class free lists.
  context = native/define_function(context, "memory_mature_allocate", [
    native/when_statement(native/binary_expression(:Equal, "size", "memory_n0"), [native/return_zero()]),
    native/when_statement(native/binary_expression(:Less, "memory_allocation_limit", "size"), [native/return_zero()]),
    native/let_statement("header_size", :U64, native/unary_expression(:SizeOf, header)),
    @native_memory/object_extent("size", "header_size", "total"),
    native/let_statement("stride", :U64, "memory_cell_size"),
    native/let_statement("bucket", :U64, "memory_n0"),
    native/while_statement(native/binary_expression(:Less, "stride", "total"), [
      native/when_statement(native/binary_expression(:Equal, "bucket", "memory_n9"), [native/break_statement()]),
      native/set_statement("stride", native/binary_expression(:Multiply, "stride", "memory_n2")),
      native/set_statement("bucket", native/binary_expression(:Add, "bucket", "memory_n1"))]),
    native/let_statement("candidate", object, "memory_null_object"),
    native/unless_statement(native/binary_expression(:Less, "stride", "total"), [
      native/set_statement("candidate", native/root_load_expression(native_memory/free_slot("heap", "bucket")))]),
    native/when_statement(native/binary_expression(:Equal, "candidate", "memory_null_object"), [
      native/let_statement("count", :U64, native/binary_expression(:Divide, "memory_page_size", "stride")),
      native/when_statement(native/binary_expression(:Less, "stride", "total"), [
        native/set_statement("stride", "total"), native/set_statement("count", "memory_n1"), native/set_statement("bucket", "memory_n10")]),
      native/let_statement("page_size", :U64, native/unary_expression(:SizeOf, [:Record, "MemoryPage"])),
      native/let_statement("payload_size", :U64, native/binary_expression(:Multiply, "count", "stride")),
      native/let_statement("allocation_size", :U64, native/binary_expression(:Add, "page_size", "payload_size")),
      native/unless_statement(native/call_expression("memory_has_capacity", ["heap", "allocation_size"]), [
        native_memory/store(:Bool, "heap", "pressure", "memory_true"),
        native/return_value([:Record, "memory_null_object", "memory_true"])]),
      native/let_call("allocation", bytes, "memory_platform_allocate", ["allocation_size"]),
      native/when_statement(native/binary_expression(:Equal, "allocation", "memory_null_bytes"), [native/return_zero()]),
      native/let_statement("owned_page", page, native/unary_expression(:PointerCast, "allocation")),
      native/let_statement("previous", page, native_memory/field(page, "heap", "pages")),
      native/let_statement("page_slot", native_memory/pointer(page), native/field_pointer_expression("heap", "pages")),
      native/let_statement("page", page, native/binary_expression(:Adopt, "page_slot", "owned_page")),
      native/store_statement("page", native/initialize_record(native_memory/page_schema(),
        {"next" -> "previous", "stride" -> "stride", "capacity" -> "count", "live" -> "memory_n0", "bucket" -> "bucket"})),
      native/let_statement("managed_page", page, native/manage_expression("page")),
      native/let_statement("managed_heap", native_memory/record_pointer("MemoryHeap"), native/manage_expression("heap")),
      native/let_statement("page_bytes", bytes, native/unary_expression(:PointerCast, "managed_page")),
      native/let_offset("cells", bytes, "page_bytes", "page_size"),
      native/let_statement("index", :U64, "memory_n0"),
      native/while_statement(native/binary_expression(:Less, "index", "count"), [
        native/let_statement("offset", :U64, native/binary_expression(:Multiply, "index", "stride")),
        native/let_offset("cell", bytes, "cells", "offset"),
        native/let_statement("item", object, native/unary_expression(:PointerCast, "cell")),
        native/store_statement("item", native/initialize_record(native_memory/object_schema(),
          {"next" -> "candidate", "work" -> "memory_null_object", "forward" -> "memory_null_object",
            "page" -> "managed_page", "heap" -> "managed_heap", "size" -> "memory_n0", "layout" -> "memory_n0",
            "mark" -> "memory_n0", "state" -> "memory_object_free"})),
        native/set_statement("candidate", "item"),
        native/set_statement("index", native/binary_expression(:Add, "index", "memory_n1"))]),
      native_memory/store(:U64, "heap", "allocated", native/typed_expression(:U64,
        native/binary_expression(:Add, native_memory/field(:U64, "heap", "allocated"), "allocation_size")))]),
    native/when_statement(native/binary_expression(:Less, "bucket", "memory_n10"), [
      native/root_store_statement(native_memory/free_slot("heap", "bucket"), native_memory/field(object, "candidate", "next"))]),
    native_memory/store(:U64, "candidate", "size", "size"),
    native_memory/store(:U64, "candidate", "layout", "layout"),
    native_memory/store(:U64, "candidate", "mark", "memory_n0"),
    native_memory/store(:U64, "candidate", "state", "memory_object_mature"),
    native_memory/store(object, "candidate", "next", "memory_null_object"),
    native_memory/store(object, "candidate", "work", "memory_null_object"),
    native_memory/store(object, "candidate", "forward", "memory_null_object"),
    native/let_statement("owner", page, native_memory/field(page, "candidate", "page")),
    native_memory/store(:U64, "owner", "live", native/typed_expression(:U64,
      native/binary_expression(:Add, native_memory/field(:U64, "owner", "live"), "memory_n1"))),
    native/return_value([:Record, "candidate", "memory_false"])])
  return context
end
