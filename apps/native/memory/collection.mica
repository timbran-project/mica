// The callback is inlined into the cell loop while retaining typed bindings
// for the page, stride, and managed cell pointer.
verb native_memory/visit_page_cells(builder: map, page: map, visit) -> list
  let bytes: list = native_memory/pointer(:U8)
  let object: list = native_memory/record_pointer("MemoryObject")
  let [page_bytes: map, with_page: map] = native_gen/bind(builder, "page_bytes", native_gen/cast(bytes, page))
  let [managed: map, with_managed: map] = native_gen/bind(with_page, "managed_bytes", native_gen/manage(page_bytes))
  let [cells: map, with_cells: map] = native_gen/bind(with_managed, "cells",
    native_gen/offset(managed, native_gen/sizeof([:Record, "MemoryPage"])))
  let [count: map, with_count: map] = native_gen/bind(with_cells, "count", native_gen/read(native_gen/field(with_cells, page, "capacity")))
  let [stride: map, with_stride: map] = native_gen/bind(with_count, "stride", native_gen/read(native_gen/field(with_count, page, "stride")))
  let [index: map, ready: map] = native_gen/bind(with_stride, "index", native_gen/ref(with_stride, "memory_n0"))
  let result: map = native_gen/while_loop(ready, native_gen/less(index, count), fn(initial_body)
    let body: map = initial_body
    let [offset: map, with_offset: map] = native_gen/bind(body, "offset", native_gen/multiply(index, stride))
    let [cell: map, with_cell: map] = native_gen/bind(with_offset, "cell", native_gen/offset(cells, offset))
    let [item: map, with_item: map] = native_gen/bind(with_cell, "item", native_gen/cast(object, cell))
    body = visit(with_item, item)
    return native_gen/assign(body, index, native_gen/add(index, native_gen/ref(body, "memory_n1")))
  end)
  return [{:managed_bytes -> managed, :count -> count, :stride -> stride}, result]
end

// Shared roots precede worker-private roots in both collection phases.
verb native_memory/visit_registered_roots(builder: map, heap: map, collection: map) -> map
  let [shared: map, ready: map] = native_gen/bind(builder, "shared_root", native_gen/read(native_gen/field(builder, heap, "roots")))
  ready = native_gen/while_loop(ready, native_gen/ref(ready, "memory_true"), fn(initial_body)
    let body: map = native_gen/when(initial_body,
      native_gen/equal(shared, native_gen/ref(initial_body, "memory_null_root")),
      fn(done) => native_gen/break_loop(done))
    let slot: map = native_gen/field(body, shared, "pointer")
    let [pointer: map, with_pointer: map] = native_gen/bind(body, "shared_pointer", native_gen/root_read(slot))
    let [moved: map, with_moved: map] = native_gen/bind(with_pointer, "shared_relocated",
      native_gen/call(with_pointer, "memory_visit", [collection, pointer]))
    body = native_gen/root_write(with_moved, slot, moved)
    return native_gen/assign(body, shared, native_gen/read(native_gen/field(body, shared, "next")))
  end)
  let [worker: map, with_worker: map] = native_gen/bind(ready, "worker", native_gen/read(native_gen/field(ready, heap, "workers")))
  ready = native_gen/while_loop(with_worker, native_gen/ref(with_worker, "memory_true"), fn(initial_worker)
    let body: map = native_gen/when(initial_worker,
      native_gen/equal(worker, native_gen/ref(initial_worker, "memory_null_worker")),
      fn(done) => native_gen/break_loop(done))
    let [root: map, with_root: map] = native_gen/bind(body, "root", native_gen/read(native_gen/field(body, worker, "roots")))
    body = native_gen/while_loop(with_root, native_gen/ref(with_root, "memory_true"), fn(initial_root)
      let root_body: map = native_gen/when(initial_root,
        native_gen/equal(root, native_gen/ref(initial_root, "memory_null_root")),
        fn(done) => native_gen/break_loop(done))
      let slot: map = native_gen/field(root_body, root, "pointer")
      let [pointer: map, with_pointer: map] = native_gen/bind(root_body, "pointer", native_gen/root_read(slot))
      let [moved: map, with_moved: map] = native_gen/bind(with_pointer, "relocated",
        native_gen/call(with_pointer, "memory_visit", [collection, pointer]))
      root_body = native_gen/root_write(with_moved, slot, moved)
      return native_gen/assign(root_body, root, native_gen/read(native_gen/field(root_body, root, "next")))
    end)
    return native_gen/assign(body, worker, native_gen/read(native_gen/field(body, worker, "next")))
  end)
  return ready
end

verb native_memory/trace_pending(builder: map, collection: map, trace: map) -> map
  let result: map = native_gen/while_loop(builder, native_gen/ref(builder, "memory_true"), fn(initial_body)
    let body: map = native_gen/when(initial_body,
      native_gen/read(native_gen/field(initial_body, collection, "failed")),
      fn(done) => native_gen/break_loop(done))
    let [item: map, with_item: map] = native_gen/bind(body, "item",
      native_gen/root_read(native_gen/field(body, collection, "work")))
    body = native_gen/when(with_item,
      native_gen/equal(item, native_gen/ref(with_item, "memory_null_object")),
      fn(done) => native_gen/break_loop(done))
    body = native_gen/root_write(body, native_gen/field(body, collection, "work"),
      native_gen/read(native_gen/field(body, item, "work")))
    return native_gen/branch(body, native_gen/equal(trace, native_gen/ref(body, "memory_null_trace")),
      fn(untraced) => native_gen/unless(untraced,
        native_gen/equal(native_gen/read(native_gen/field(untraced, item, "layout")), native_gen/ref(untraced, "memory_n0")),
        fn(failed) => native_gen/write(failed, native_gen/field(failed, collection, "failed"), native_gen/ref(failed, "memory_true"))),
      fn(traced) => native_gen/do_indirect_call(traced, trace, [collection, item]))
  end)
  return result
end

verb native_memory/rollback_workers(builder: map, heap: map) -> map
  let [worker: map, ready: map] = native_gen/bind(builder, "worker", native_gen/read(native_gen/field(builder, heap, "workers")))
  let result: map = native_gen/while_loop(ready, native_gen/ref(ready, "memory_true"), fn(initial_body)
    let body: map = native_gen/when(initial_body,
      native_gen/equal(worker, native_gen/ref(initial_body, "memory_null_worker")),
      fn(done) => native_gen/break_loop(done))
    body = native_gen/do_call(body, "memory_rollback_nursery", [worker])
    let [next: map, with_next: map] = native_gen/bind(body, "next_worker",
      native_gen/read(native_gen/field(body, worker, "next")))
    return native_gen/assign(with_next, worker, next)
  end)
  return result
end

verb native_memory/rewrite_page(builder: map, page: map, collection: map, trace: map) -> map
  let [span: map, result: map] = native_memory/visit_page_cells(builder, page, fn(initial_body, item)
    return native_gen/when(initial_body,
      native_gen/equal(native_gen/read(native_gen/field(initial_body, item, "mark")), native_gen/ref(initial_body, "memory_n1")),
      fn(marked)
        let body: map = native_gen/unless(marked, native_gen/equal(trace, native_gen/ref(marked, "memory_null_trace")),
          fn(traced) => native_gen/do_indirect_call(traced, trace, [collection, item]))
        // Promotion reservations have already succeeded before this store.
        return native_gen/unless(body,
          native_gen/equal(native_gen/read(native_gen/field(body, item, "state")), native_gen/ref(body, "memory_object_frozen")),
          fn(mutable) => native_gen/write(mutable, native_gen/field(mutable, item, "state"), native_gen/ref(mutable, "memory_object_mature")))
      end)
  end)
  return result
end

verb native_memory/rewrite_pages(builder: map, heap: map, collection: map, trace: map) -> map
  let [page: map, ready: map] = native_gen/bind(builder, "page", native_gen/read(native_gen/field(builder, heap, "pages")))
  let result: map = native_gen/while_loop(ready, native_gen/ref(ready, "memory_true"), fn(initial_body)
    let body: map = native_gen/when(initial_body,
      native_gen/equal(page, native_gen/ref(initial_body, "memory_null_page")),
      fn(done) => native_gen/break_loop(done))
    body = native_memory/rewrite_page(body, page, collection, trace)
    let [next: map, with_next: map] = native_gen/bind(body, "next_page",
      native_gen/read(native_gen/field(body, page, "next")))
    return native_gen/assign(with_next, page, next)
  end)
  return result
end

verb native_memory/reset_workers(builder: map, heap: map) -> map
  let [worker: map, ready: map] = native_gen/bind(builder, "worker", native_gen/read(native_gen/field(builder, heap, "workers")))
  let result: map = native_gen/while_loop(ready, native_gen/ref(ready, "memory_true"), fn(initial_body)
    let body: map = native_gen/when(initial_body,
      native_gen/equal(worker, native_gen/ref(initial_body, "memory_null_worker")),
      fn(done) => native_gen/break_loop(done))
    body = native_gen/write(body, native_gen/field(body, worker, "used"), native_gen/ref(body, "memory_n0"))
    let [next: map, with_next: map] = native_gen/bind(body, "next_worker",
      native_gen/read(native_gen/field(body, worker, "next")))
    return native_gen/assign(with_next, worker, next)
  end)
  return result
end

verb native_memory/trace_state(builder: map, heap: map, phase: string) -> map
  let result: map = native_gen/record(builder, [:Record, "MemoryCollection"],
    {"heap" -> heap, "work" -> native_gen/ref(builder, "memory_null_object"),
      "copies" -> native_gen/ref(builder, "memory_null_object"),
      "phase" -> native_gen/ref(builder, phase), "failed" -> native_gen/ref(builder, "memory_false"),
      "copied" -> native_gen/ref(builder, "memory_n0"), "control" -> native_gen/zero(native_memory/record_pointer("MemoryControl"))})
  return result
end

// Allow page storage to double between collections, with a minimum allowance
// for small heaps. Saturate the allowance before multiplication can overflow.
verb native_memory/update_collection_limit(input: map, heap: map) -> map
  let builder: map = input
  let [allocated: map, with_allocated: map] = native_gen/bind(builder, "allocated", native_gen/read(native_gen/field(builder, heap, "allocated")))
  let [limit: map, with_limit: map] = native_gen/bind(with_allocated, "limit", native_gen/ref(with_allocated, "memory_allocation_limit"))
  builder = native_gen/when(with_limit, native_gen/less(allocated,
    native_gen/divide(limit, native_gen/ref(with_limit, "memory_n2"))),
    fn(bounded) => native_gen/assign(bounded, limit, native_gen/multiply(allocated, native_gen/ref(bounded, "memory_n2"))))
  builder = native_gen/when(builder, native_gen/less(limit, native_gen/ref(builder, "memory_collection_floor")),
    fn(small) => native_gen/assign(small, limit, native_gen/ref(small, "memory_collection_floor")))
  builder = native_gen/write(builder, native_gen/field(builder, heap, "collection_limit"), limit)
  return builder
end

verb native_memory/collect_stopped_body(module: map) -> map
  let builder: map = native_gen/context(module, "memory_collect_stopped")
  let heap: map = native_gen/ref(builder, "heap")
  let [state: map, with_state: map] = native_gen/bind(builder, "state", native_memory/trace_state(builder, heap, "memory_trace_prepare"))
  let [collection: map, with_collection: map] = native_gen/bind(with_state, "collection", native_gen/address(state))
  let [trace: map, with_trace: map] = native_gen/bind(with_collection, "trace",
    native_gen/read(native_gen/field(with_collection, heap, "trace")))
  builder = native_memory/visit_registered_roots(with_trace, heap, collection)
  builder = native_memory/trace_pending(builder, collection, trace)
  builder = native_gen/when(builder, native_gen/read(native_gen/field(builder, collection, "failed")), fn(initial_failure)
    let failure: map = native_memory/rollback_workers(initial_failure, heap)
    failure = native_gen/do_call(failure, "memory_sweep", [heap, native_gen/ref(failure, "memory_false")])
    return native_gen/return_value(failure, native_gen/ref(failure, "memory_false"))
  end)
  builder = native_gen/write(builder, native_gen/field(builder, collection, "phase"), native_gen/ref(builder, "memory_trace_rewrite"))
  builder = native_memory/visit_registered_roots(builder, heap, collection)
  builder = native_memory/rewrite_pages(builder, heap, collection, trace)
  builder = native_gen/do_call(builder, "memory_sweep", [heap, native_gen/ref(builder, "memory_true")])
  builder = native_memory/reset_workers(builder, heap)
  builder = native_memory/update_collection_limit(builder, heap)
  builder = native_gen/write(builder, native_gen/field(builder, heap, "copied"),
    native_gen/add(native_gen/read(native_gen/field(builder, heap, "copied")),
      native_gen/read(native_gen/field(builder, collection, "copied"))))
  builder = native_gen/write(builder, native_gen/field(builder, heap, "collections"),
    native_gen/add(native_gen/read(native_gen/field(builder, heap, "collections")), native_gen/ref(builder, "memory_n1")))
  builder = native_gen/return_value(builder, native_gen/ref(builder, "memory_true"))
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_memory/free_slot_at(builder: map, heap: map, bucket: map) -> map
  let object: list = native_memory/record_pointer("MemoryObject")
  let free: map = native_gen/field(builder, heap, "free")
  let pointer: map = native_gen/expression(native_memory/pointer(object), :ElementPointer, [free[:pointer], bucket])
  let slot: map = native_gen/location(pointer)
  return slot
end

verb native_memory/sweep_live_cell(builder: map, item: map, reclaim: map, live: map, retained_bytes: map) -> map
  let body: map = native_gen/when(builder, reclaim, fn(reclaiming)
    return native_gen/when(reclaiming,
      native_gen/equal(native_gen/read(native_gen/field(reclaiming, item, "mark")), native_gen/ref(reclaiming, "memory_n0")),
      fn(freeing) => native_gen/write(freeing, native_gen/field(freeing, item, "state"), native_gen/ref(freeing, "memory_object_free")))
  end)
  body = native_gen/write(body, native_gen/field(body, item, "mark"), native_gen/ref(body, "memory_n0"))
  body = native_gen/write(body, native_gen/field(body, item, "work"), native_gen/ref(body, "memory_null_object"))
  body = native_gen/write(body, native_gen/field(body, item, "forward"), native_gen/ref(body, "memory_null_object"))
  let result: map = native_gen/unless(body,
    native_gen/equal(native_gen/read(native_gen/field(body, item, "state")), native_gen/ref(body, "memory_object_free")),
    fn(retained)
      let current: map = native_gen/assign(retained, live, native_gen/add(live, native_gen/ref(retained, "memory_n1")))
      return native_gen/assign(current, retained_bytes,
        native_gen/add(retained_bytes, native_gen/read(native_gen/field(current, item, "size"))))
    end)
  return result
end

verb native_memory/sweep_free_cell(builder: map, item: map, free_head: map) -> map
  let result: map = native_gen/when(builder,
    native_gen/equal(native_gen/read(native_gen/field(builder, item, "state")), native_gen/ref(builder, "memory_object_free")),
    fn(freeing)
      let current: map = native_gen/write(freeing, native_gen/field(freeing, item, "next"), free_head)
      return native_gen/assign(current, free_head, item)
    end)
  return result
end

verb native_memory/sweep_body(module: map) -> map
  let builder: map = native_gen/context(module, "memory_sweep")
  let heap: map = native_gen/ref(builder, "heap")
  let reclaim: map = native_gen/ref(builder, "reclaim")
  let [bucket: map, with_bucket: map] = native_gen/bind(builder, "bucket", native_gen/ref(builder, "memory_n0"))
  builder = native_gen/while_loop(with_bucket,
    native_gen/less(bucket, native_gen/ref(with_bucket, "memory_n10")), fn(initial_body)
      let body: map = native_gen/root_write(initial_body, native_memory/free_slot_at(initial_body, heap, bucket),
        native_gen/ref(initial_body, "memory_null_object"))
      return native_gen/assign(body, bucket, native_gen/add(bucket, native_gen/ref(body, "memory_n1")))
    end)
  let [retained_bytes: map, with_retained: map] = native_gen/bind(builder, "retained_bytes", native_gen/ref(builder, "memory_n0"))
  let [link: map, with_link: map] = native_gen/bind(with_retained, "link", native_gen/field(with_retained, heap, "pages")[:pointer])
  builder = native_gen/while_loop(with_link, native_gen/ref(with_link, "memory_true"), fn(initial_body)
    let [page: map, with_page: map] = native_gen/bind(initial_body, "page", native_gen/load(link))
    let body: map = native_gen/when(with_page,
      native_gen/equal(page, native_gen/ref(with_page, "memory_null_page")),
      fn(done) => native_gen/break_loop(done))
    let [next: map, with_next: map] = native_gen/bind(body, "next", native_gen/read(native_gen/field(body, page, "next")))
    body = native_gen/assign(with_next, bucket, native_gen/read(native_gen/field(with_next, page, "bucket")))
    let pooled = native_gen/less(bucket, native_gen/ref(body, "memory_n10"))
    let [free_head: map, with_head: map] = native_gen/bind(body, "free_head", native_gen/ref(body, "memory_null_object"))
    body = native_gen/when(with_head, pooled, fn(small) => native_gen/assign(small, free_head,
      native_gen/root_read(native_memory/free_slot_at(small, heap, bucket))))
    let [live: map, with_live: map] = native_gen/bind(body, "live", native_gen/ref(body, "memory_n0"))
    // Build the free chain locally in the same pass. Publish it only if the
    // page survives, so no free-list link can retain a released page.
    let [span: map, with_cells: map] = native_memory/visit_page_cells(with_live, page, fn(cell_body, item)
      let swept = native_memory/sweep_live_cell(cell_body, item, reclaim, live, retained_bytes)
      return native_memory/sweep_free_cell(swept, item, free_head)
    end)
    return native_gen/branch(with_cells, native_gen/equal(live, native_gen/ref(with_cells, "memory_n0")),
      fn(empty)
        let released: map = native_gen/store(empty, link, next)
        let [page_size: map, with_size: map] = native_gen/bind(released, "page_size", native_gen/sizeof([:Record, "MemoryPage"]))
        let [allocation_size: map, with_allocation: map] = native_gen/bind(with_size, "allocation_size",
          native_gen/add(page_size, native_gen/multiply(span[:stride], span[:count])))
        let current: map = native_gen/write(with_allocation, native_gen/field(with_allocation, heap, "allocated"),
          native_gen/subtract(native_gen/read(native_gen/field(with_allocation, heap, "allocated")), allocation_size))
        return native_gen/do_call(current, "memory_platform_release", [span[:managed_bytes]])
      end,
      fn(retained)
        let published = native_gen/when(retained, pooled, fn(small) => native_gen/root_write(small,
          native_memory/free_slot_at(small, heap, bucket), free_head))
        let current: map = native_gen/write(published, native_gen/field(published, page, "live"), live)
        return native_gen/assign(current, link, native_gen/field(current, page, "next")[:pointer])
      end)
  end)
  builder = native_gen/write(builder, native_gen/field(builder, heap, "retained"), retained_bytes)
  builder = native_gen/return_void(builder)
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_memory/collection(input: map) -> map
  let context: map = input
  let bytes: list = native_memory/pointer(:U8)
  let object: list = native_memory/record_pointer("MemoryObject")
  let page: list = native_memory/record_pointer("MemoryPage")
  let heap: list = native_memory/record_pointer("MemoryHeap")
  let worker: list = native_memory/record_pointer("MemoryWorker")
  let root: list = native_memory/record_pointer("MemoryRoot")
  let collection: list = [:Record, "MemoryCollection"]
  let trace: list = [:FunctionPointer, "MemoryTrace"]

  // Preparation reserves and fills destinations without changing payload edges
  // or roots. Failure can release the destinations and preserve the nursery.
  context = native/define_function(context, "memory_visit", [
    native/when_statement(native/binary_expression(:Equal, "pointer", "memory_null_bytes"), [native/return_value("pointer")]),
    native/when_statement(native/binary_expression(:Equal,
      native_memory/field(:U64, "collection", "phase"), "memory_share_prepare"),
      [native/return_value(native/call_expression("memory_share_visit", ["collection", "pointer"]))]),
    native/let_call("object", object, "memory_object", ["pointer"]),
    native/let_statement("heap", heap, native_memory/field(heap, "collection", "heap")),
    native/let_statement("owner", heap, native_memory/field(heap, "object", "heap")),
    native/unless_statement(native/binary_expression(:Equal, "heap", "owner"), [
      native_memory/store(:Bool, "collection", "failed", "memory_true"), native/return_value("pointer")]),
    native/let_statement("state", :U64, native_memory/field(:U64, "object", "state")),
    native/let_statement("phase", :U64, native_memory/field(:U64, "collection", "phase")),
    native/when_statement(native/binary_expression(:Equal, "phase", "memory_share_rewrite"), [
      native/when_statement(native/binary_expression(:Equal, "state", "memory_object_frozen"), [native/return_value("pointer")]),
      native/let_statement("copy", object, native_memory/field(object, "object", "next")),
      native/return_value(native/call_expression("memory_payload", ["copy"]))]),
    native/when_statement(native/binary_expression(:Equal, "phase", "memory_trace_rewrite"), [
      native/when_statement(native/binary_expression(:Equal, "state", "memory_object_nursery"), [
        native/let_statement("forward", object, native_memory/field(object, "object", "forward")),
        native/return_value(native/call_expression("memory_payload", ["forward"]))]),
      native/return_value("pointer")]),
    native/when_statement(native/binary_expression(:Equal, native_memory/field(:U64, "object", "mark"), "memory_n1"), [native/return_value("pointer")]),
    native/when_statement(native/binary_expression(:Equal, "state", "memory_object_free"), [
      native_memory/store(:Bool, "collection", "failed", "memory_true"), native/return_value("pointer")]),
    native_memory/store(:U64, "object", "mark", "memory_n1"),
    native_memory/store(object, "object", "work", native_memory/root(object, "collection", "work")),
    native_memory/store_root(object, "collection", "work", "object"),
    native/when_statement(native/binary_expression(:Equal, "state", "memory_object_nursery"), [
      native/let_statement("size", :U64, native_memory/field(:U64, "object", "size")),
      native/let_statement("layout", :U64, native_memory/field(:U64, "object", "layout")),
      native/let_call("target", object, "memory_mature_allocate", ["heap", "size", "layout"]),
      native/when_statement(native/binary_expression(:Equal, "target", "memory_null_object"), [
        native_memory/store(:Bool, "collection", "failed", "memory_true"), native/return_value("pointer")]),
      native/let_call("destination", bytes, "memory_payload", ["target"]),
      native/copy_bytes_statement("destination", "pointer", "size"),
      native_memory/store(:U64, "target", "mark", "memory_n1"),
      native_memory/store(object, "target", "forward", "object"),
      native_memory/store(object, "object", "forward", "target"),
      native_memory/store(:U64, "collection", "copied", native/typed_expression(:U64,
        native/binary_expression(:Add, native_memory/field(:U64, "collection", "copied"), "size")))]),
    native/return_value("pointer")])

  context = native/define_function(context, "memory_rollback_nursery", [
    native/let_statement("nursery", bytes, native_memory/field(bytes, "worker", "nursery")),
    native/let_statement("used", :U64, native_memory/field(:U64, "worker", "used")),
    native/let_statement("position", :U64, "memory_n0"),
    native/let_statement("header_size", :U64, native/unary_expression(:SizeOf, [:Record, "MemoryObject"])),
    native/while_statement(native/binary_expression(:Less, "position", "used"), [
      native/let_offset("raw", bytes, "nursery", "position"),
      native/let_statement("managed", bytes, native/manage_expression("raw")),
      native/let_statement("item", object, native/unary_expression(:PointerCast, "managed")),
      native/let_statement("forward", object, native_memory/field(object, "item", "forward")),
      native/unless_statement(native/binary_expression(:Equal, "forward", "memory_null_object"), [
        native_memory/store(:U64, "forward", "state", "memory_object_free"),
        native_memory/store(object, "item", "forward", "memory_null_object")]),
      native_memory/store(:U64, "item", "mark", "memory_n0"),
      native_memory/store(object, "item", "work", "memory_null_object"),
      native/let_statement("size", :U64, native_memory/field(:U64, "item", "size")),
      @native_memory/object_extent("size", "header_size", "total"),
      native/set_statement("position", native/binary_expression(:Add, "position", "total"))]),
    native/return_void()])

  context = native_memory/sweep_body(context)

  context = native_memory/collect_stopped_body(context)
  return context
end

// Sources enter the tracing queue. Copies retain their sources and form a
// separate list so both successful completion and rollback can clear every link.
verb native_memory/register_copy(input: map, collection: map, object: map, target: map, size: map) -> map
  let builder: map = input
  builder = native_gen/write(builder, native_gen/field(builder, object, "next"), target)
  builder = native_gen/write(builder, native_gen/field(builder, target, "forward"), object)
  builder = native_gen/write(builder, native_gen/field(builder, target, "state"), native_gen/ref(builder, "memory_object_frozen"))
  builder = native_gen/write(builder, native_gen/field(builder, object, "work"), native_gen/root_read(native_gen/field(builder, collection, "work")))
  builder = native_gen/root_write(builder, native_gen/field(builder, collection, "work"), object)
  builder = native_gen/write(builder, native_gen/field(builder, target, "next"), native_gen/root_read(native_gen/field(builder, collection, "copies")))
  builder = native_gen/root_write(builder, native_gen/field(builder, collection, "copies"), target)
  builder = native_gen/write(builder, native_gen/field(builder, collection, "copied"),
    native_gen/add(native_gen/read(native_gen/field(builder, collection, "copied")), size))
  return builder
end

// A private graph is copied without moving its source objects. Already frozen
// subgraphs are immutable and can be shared without tracing their descendants.
// The heap mutex protects forwarding metadata and allocation; workers keep
// running, and an active caller prevents major collection during this copy.
verb native_memory/check_copy(builder: map, collection: map, bytes: map, steps: map) -> map
  let allowed: map = native_gen/call(builder, "memory_control_check", [native_gen/read(native_gen/field(builder, collection, "control")), bytes, steps])
  let result: map = native_gen/unless(builder, allowed, fn(failed) => native_gen/write(failed, native_gen/field(failed, collection, "failed"), native_gen/ref(failed, "memory_true")))
  return result
end

// Trace variable-size payloads in bounded batches, including immediate values
// that have no pointer visitor. Ordinary collection carries no control.
verb native_memory/trace_checkpoint(builder: map, collection: map, index: map) -> map
  let result: map = native_gen/when(builder, native_gen/equal(native_gen/bit_and(index, native_gen/ref(builder, "memory_trace_mask")), native_gen/ref(builder, "memory_n0")), fn(batch)
    let checked: map = native_memory/check_copy(batch, collection, native_gen/ref(batch, "memory_n0"), native_gen/ref(batch, "memory_n1"))
    return native_gen/when(checked, native_gen/read(native_gen/field(checked, collection, "failed")), fn(failed) => native_gen/return_void(failed))
  end)
  return result
end

verb native_memory/copy_payload(builder: map, collection: map, target: map, source: map, size: map) -> map
  let [offset: map, ready: map] = native_gen/bind(builder, "copied_bytes", native_gen/ref(builder, "memory_n0"))
  let result: map = native_gen/while_loop(ready, native_gen/less(offset, size), fn(chunk)
    let checked: map = native_memory/check_copy(chunk, collection, native_gen/ref(chunk, "memory_n0"), native_gen/ref(chunk, "memory_n1"))
    checked = native_gen/when(checked, native_gen/read(native_gen/field(checked, collection, "failed")), fn(failed) => native_gen/break_loop(failed))
    let [length: map, bounded: map] = native_gen/bind(checked, "chunk_bytes", native_gen/subtract(size, offset))
    bounded = native_gen/when(bounded, native_gen/less(native_gen/ref(bounded, "memory_copy_chunk"), length), fn(large) => native_gen/assign(large, length, native_gen/ref(large, "memory_copy_chunk")))
    let copied: map = native_gen/copy_bytes(bounded, native_gen/offset(target, offset), native_gen/offset(source, offset), length)
    return native_gen/assign(copied, offset, native_gen/add(offset, length))
  end)
  return result
end

verb native_memory/share_visit_body(module: map) -> map
  let builder: map = native_gen/context(module, "memory_share_visit")
  let collection: map = native_gen/ref(builder, "collection")
  let pointer: map = native_gen/ref(builder, "pointer")
  builder = native_gen/when(builder, native_gen/read(native_gen/field(builder, collection, "failed")), fn(failed) => native_gen/return_value(failed, pointer))
  builder = native_memory/check_copy(builder, collection, native_gen/ref(builder, "memory_n0"), native_gen/ref(builder, "memory_n1"))
  builder = native_gen/when(builder, native_gen/read(native_gen/field(builder, collection, "failed")), fn(failed) => native_gen/return_value(failed, pointer))
  let [object: map, ready: map] = native_gen/bind(builder, "source", native_gen/call(builder, "memory_object", [pointer]))
  let [heap: map, with_heap: map] = native_gen/bind(ready, "heap", native_gen/read(native_gen/field(ready, collection, "heap")))
  builder = native_gen/unless(with_heap, native_gen/equal(heap, native_gen/read(native_gen/field(with_heap, object, "heap"))),
    fn(failure) => native_memory/share_failure(failure, collection))
  let [state: map, with_state: map] = native_gen/bind(builder, "state", native_gen/read(native_gen/field(builder, object, "state")))
  builder = native_gen/when(with_state, native_gen/equal(state, native_gen/ref(with_state, "memory_object_free")),
    fn(failure) => native_memory/share_failure(failure, collection))
  builder = native_gen/when(builder, native_gen/equal(state, native_gen/ref(builder, "memory_object_frozen")),
    fn(frozen) => native_gen/return_value(frozen, pointer))
  let [forward: map, with_forward: map] = native_gen/bind(builder, "forward", native_gen/read(native_gen/field(builder, object, "next")))
  builder = native_gen/unless(with_forward, native_gen/equal(forward, native_gen/ref(with_forward, "memory_null_object")),
    fn(copied) => native_gen/return_value(copied, pointer))
  let [size: map, with_size: map] = native_gen/bind(builder, "size", native_gen/read(native_gen/field(builder, object, "size")))
  builder = native_memory/check_copy(with_size, collection, size, native_gen/ref(with_size, "memory_n0"))
  builder = native_gen/when(builder, native_gen/read(native_gen/field(builder, collection, "failed")), fn(failed) => native_gen/return_value(failed, pointer))
  let [target: map, with_target: map] = native_gen/bind(builder, "target", native_gen/call(builder, "memory_mature_allocate",
    [heap, size, native_gen/read(native_gen/field(builder, object, "layout"))]))
  builder = native_gen/when(with_target, native_gen/equal(target, native_gen/ref(with_target, "memory_null_object")),
    fn(failure) => native_memory/share_failure(failure, collection))
  let [payload: map, with_payload: map] = native_gen/bind(builder, "payload", native_gen/call(builder, "memory_payload", [target]))
  // Register first so interrupted copies are included in rollback.
  builder = native_memory/register_copy(with_payload, collection, object, target, size)
  builder = native_memory/copy_payload(builder, collection, payload, pointer, size)
  builder = native_gen/return_value(builder, pointer)
  let result: map = native_gen/finish(module, builder)
  return result
end

verb native_memory/share_failure(builder: map, collection: map) -> map
  let failed: map = native_gen/write(builder, native_gen/field(builder, collection, "failed"), native_gen/ref(builder, "memory_true"))
  let result: map = native_gen/return_value(failed, native_gen/ref(failed, "pointer"))
  return result
end

// Return an unpublished copy directly to its size class. Oversized allocations
// own their page and can be released without scanning any object payloads.
verb native_memory/discard_body(module: map) -> map
  let builder: map = native_gen/context(module, "memory_discard")
  let heap: map = native_gen/ref(builder, "heap")
  let object: map = native_gen/ref(builder, "object")
  let [page: map, with_page: map] = native_gen/bind(builder, "page", native_gen/read(native_gen/field(builder, object, "page")))
  let [bucket: map, with_bucket: map] = native_gen/bind(with_page, "bucket", native_gen/read(native_gen/field(with_page, page, "bucket")))
  builder = native_gen/when(with_bucket, native_gen/less(bucket, native_gen/ref(with_bucket, "memory_n10")), fn(pooled)
    let slot: map = native_memory/free_slot_at(pooled, heap, bucket)
    let body: map = native_gen/write(pooled, native_gen/field(pooled, object, "state"), native_gen/ref(pooled, "memory_object_free"))
    body = native_gen/write(body, native_gen/field(body, object, "next"), native_gen/root_read(slot))
    body = native_gen/root_write(body, slot, object)
    body = native_gen/write(body, native_gen/field(body, page, "live"),
      native_gen/subtract(native_gen/read(native_gen/field(body, page, "live")), native_gen/ref(body, "memory_n1")))
    return native_gen/return_void(body)
  end)
  let [link: map, with_link: map] = native_gen/bind(builder, "link", native_gen/field(builder, heap, "pages")[:pointer])
  builder = native_gen/while_loop(with_link, native_gen/not_equal(native_gen/load(link), page), fn(body)
    return native_gen/assign(body, link, native_gen/field(body, native_gen/load(link), "next")[:pointer])
  end)
  builder = native_gen/root_write(builder, native_gen/location(link), native_gen/read(native_gen/field(builder, page, "next")))
  let size: map = native_gen/add(native_gen/sizeof([:Record, "MemoryPage"]), native_gen/read(native_gen/field(builder, page, "stride")))
  builder = native_gen/write(builder, native_gen/field(builder, heap, "allocated"),
    native_gen/subtract(native_gen/read(native_gen/field(builder, heap, "allocated")), size))
  builder = native_gen/do_call(builder, "memory_platform_release", [native_gen/cast(native_memory/pointer(:U8), page)])
  builder = native_gen/return_void(builder)
  let result: map = native_gen/finish(module, builder)
  return result
end

// Reservation has succeeded. Repair only destination payloads, then clear
// forwarding metadata in a separate pass so aliases can still find their copies.
verb native_memory/rewrite_copies(builder: map, collection: map, trace: map, pointer: map, result: map) -> map
  let ready: map = native_gen/write(builder, native_gen/field(builder, collection, "phase"), native_gen/ref(builder, "memory_share_rewrite"))
  ready = native_gen/assign(ready, result, native_gen/call(ready, "memory_visit", [collection, pointer]))
  let [copy: map, with_copy: map] = native_gen/bind(ready, "copy", native_gen/root_read(native_gen/field(ready, collection, "copies")))
  let rewritten: map = native_gen/while_loop(with_copy, native_gen/not_equal(copy, native_gen/ref(with_copy, "memory_null_object")), fn(body)
    let checked: map = native_memory/check_copy(body, collection, native_gen/ref(body, "memory_n0"), native_gen/ref(body, "memory_n1"))
    checked = native_gen/when(checked, native_gen/read(native_gen/field(checked, collection, "failed")), fn(failed) => native_gen/break_loop(failed))
    let traced: map = native_gen/unless(checked, native_gen/equal(trace, native_gen/ref(checked, "memory_null_trace")),
      fn(known) => native_gen/do_indirect_call(known, trace, [collection, copy]))
    return native_gen/assign(traced, copy, native_gen/read(native_gen/field(traced, copy, "next")))
  end)
  return rewritten
end

verb native_memory/finish_copies(builder: map, heap: map, collection: map, failed: map) -> map
  let [copy: map, with_copy: map] = native_gen/bind(builder, "copy", native_gen/root_read(native_gen/field(builder, collection, "copies")))
  let finished: map = native_gen/while_loop(with_copy, native_gen/not_equal(copy, native_gen/ref(with_copy, "memory_null_object")), fn(body)
    let [next: map, with_next: map] = native_gen/bind(body, "next", native_gen/read(native_gen/field(body, copy, "next")))
    let [source: map, with_source: map] = native_gen/bind(with_next, "source", native_gen/read(native_gen/field(with_next, copy, "forward")))
    let ready: map = native_gen/write(with_source, native_gen/field(with_source, source, "next"), native_gen/ref(with_source, "memory_null_object"))
    ready = native_gen/write(ready, native_gen/field(ready, source, "work"), native_gen/ref(ready, "memory_null_object"))
    for field in ["forward", "work", "next"]
      ready = native_gen/write(ready, native_gen/field(ready, copy, field), native_gen/ref(ready, "memory_null_object"))
    end
    ready = native_gen/when(ready, failed, fn(discard) => native_gen/do_call(discard, "memory_discard", [heap, copy]))
    return native_gen/assign(ready, copy, next)
  end)
  return finished
end

verb native_memory/share_body(module: map) -> map
  let builder: map = native_gen/context(module, "memory_share")
  let worker: map = native_gen/ref(builder, "worker")
  let pointer: map = native_gen/ref(builder, "pointer")
  builder = native_gen/unless(builder, native_gen/read(native_gen/field(builder, worker, "active")),
    fn(inactive) => native_gen/return_value(inactive, native_gen/ref(inactive, "memory_null_bytes")))
  let [heap: map, with_heap: map] = native_gen/bind(builder, "heap", native_gen/read(native_gen/field(builder, worker, "heap")))
  let [mutex: map, with_mutex: map] = native_gen/bind(with_heap, "mutex", native_gen/read(native_gen/field(with_heap, heap, "mutex")))
  builder = native_gen/do_call(with_mutex, "memory_lock", [mutex])
  let [state: map, with_state: map] = native_gen/bind(builder, "state", native_memory/trace_state(builder, heap, "memory_share_prepare"))
  let [collection: map, with_collection: map] = native_gen/bind(with_state, "collection", native_gen/address(state))
  builder = native_gen/write(with_collection, native_gen/field(with_collection, collection, "control"), native_gen/read(native_gen/field(with_collection, worker, "control")))
  let [result: map, with_result: map] = native_gen/bind(builder, "result", native_gen/call(builder, "memory_visit", [collection, pointer]))
  let [trace: map, with_trace: map] = native_gen/bind(with_result, "trace", native_gen/read(native_gen/field(with_result, heap, "trace")))
  builder = native_memory/trace_pending(with_trace, collection, trace)
  let [failed: map, with_failed: map] = native_gen/bind(builder, "failed", native_gen/read(native_gen/field(builder, collection, "failed")))
  builder = native_gen/unless(with_failed, failed,
    fn(rewrite) => native_memory/rewrite_copies(rewrite, collection, trace, pointer, result))
  builder = native_gen/assign(builder, failed, native_gen/read(native_gen/field(builder, collection, "failed")))
  builder = native_memory/finish_copies(builder, heap, collection, failed)
  builder = native_gen/branch(builder, failed,
    fn(failure) => native_gen/assign(failure, result, native_gen/ref(failure, "memory_null_bytes")),
    fn(success) => native_gen/write(success, native_gen/field(success, heap, "copied"),
      native_gen/add(native_gen/read(native_gen/field(success, heap, "copied")), native_gen/read(native_gen/field(success, collection, "copied")))))
  builder = native_gen/do_call(builder, "memory_unlock", [mutex])
  builder = native_gen/return_value(builder, result)
  let output: map = native_gen/finish(module, builder)
  return output
end

verb native_memory/sharing(module: map) -> map
  let context: map = native_memory/share_visit_body(module)
  context = native_memory/discard_body(context)
  let result: map = native_memory/share_body(context)
  return result
end
