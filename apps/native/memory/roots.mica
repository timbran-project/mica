// Rooted expressions reload their value each time they are used. Operators
// retain inputs and accumulators once, then poll without naming stale pointers.
verb native_roots/worker(builder: map) -> map
  if map_contains_key(builder, :scope_worker)
    let worker: map = builder[:scope_worker]
    return worker
  end
  let worker: map = native_gen/ref(builder, "worker")
  return worker
end
verb native_roots/ref(builder: map, name: string) -> map
  if name == "worker" && map_contains_key(builder, :scope_worker)
    let worker: map = builder[:scope_worker]
    return worker
  end
  if map_contains_key(builder, :scope_bindings) && map_contains_key(builder[:scope_bindings], name)
    let value: map = builder[:scope_bindings][name]
    return value
  end
  let value: map = native_gen/ref(builder, name)
  return value
end
verb native_roots/root_value(builder: map, root: map, kind) -> map
  let value: map = {}
  if kind == native_value/word()
    value = native_gen/call(builder, "value_root_get", [root])
  else
    value = native_gen/cast(kind, native_gen/root_read(native_gen/field(builder, root, "pointer")))
  end
  value[:scope_root] = root
  return value
end
verb native_roots/store(builder: map, rooted: map, value: map) -> map
  native/ensure(map_contains_key(rooted, :scope_root), "managed assignment requires a root")
  let root: map = rooted[:scope_root]
  if native_gen/type(value) == native_value/word()
    let result: map = native_gen/do_call(builder, "value_root_set", [root, value])
    return result
  end
  let result: map = native_gen/root_write(builder, native_gen/field(builder, root, "pointer"),
    native_gen/cast(native_memory/pointer(:U8), value))
  return result
end
verb native_roots/retain(builder: map, label: string, value: map) -> list
  let [slot: map, with_slot: map] = native_gen/bind(builder, string_concat(label, "_root"), native_gen/zero([:Record, "MemoryRoot"]))
  let root: map = native_gen/address(slot)
  let rooted: map = native_roots/root_value(with_slot, root, native_gen/type(value))
  let ready: map = native_roots/store(with_slot, rooted, value)
  let [pushed: map, with_push: map] = native_gen/bind(ready, "root_registered", native_gen/call(ready, "memory_root_push", [native_roots/worker(ready), root]))
  with_push[:scope_roots] = [@with_push[:scope_roots], root]
  ready = native_gen/unless(with_push, pushed, fn(failed) => native_roots/fail(failed, "closed"))
  return [rooted, ready]
end

// Zeroed slots hold immediate zero until assigned. Register the array with a
// target loop, keeping initialization code independent of the number of roots.
verb native_roots/slots(builder: map, label: string, count: int) -> list
  native/ensure(count >= 0, "root slot count must be nonnegative")
  let root: list = [:Record, "MemoryRoot"]
  if count == 0
    return [native_gen/zero([:Pointer, root, :Mutable]), builder]
  end
  let array: list = [:Array, root, count]
  let [storage: map, allocated: map] = native_gen/bind(builder, label, native_gen/zero(array))
  let [data: map, addressed: map] = native_gen/bind(allocated, string_concat(label, "_data"),
    native_gen/element(native_gen/address(storage), native_gen/zero(:U64)))
  let length: map = native_gen/divide(native_gen/sizeof(array), native_gen/sizeof(root))
  let ready: map = addressed
  // The scope owns the entire array. Even a partial registration must unlink
  // its roots before returning through the scope's failure handler.
  ready[:scope_roots] = [@ready[:scope_roots], data]
  ready = native_gen/for_range(ready, "root", native_gen/zero(:U64), length, fn(body, index)
    let [pushed: map, registered: map] = native_gen/bind(body, "root_registered",
      native_gen/call(body, "memory_root_push", [native_roots/worker(body), native_gen/offset(data, index)]))
    return native_gen/unless(registered, pushed, fn(failed) => native_roots/fail(failed, "closed"))
  end, native_gen/ref(ready, "memory_n1"))
  return [data, ready]
end

// Cache managed parameter names by function. Declaration edits invalidate
// the index; defining another body reuses the same immutable metadata.
verb native_roots/parameters(input: map) -> list
  let builder: map = input
  let state: map = builder[:module][:state]
  let layout: map = builder[:module][:generation_layout]
  if !map_contains_key(layout, :root_parameter_rows) || layout[:root_parameter_rows] != state[:parameters] || layout[:root_contract_rows] != state[:parameter_contracts]
    let managed: map = {}
    for row in state[:parameter_contracts]
      if row[1] == :Gc
        managed[row[0]] = true
      end
    end
    let parameters: map = {}
    for row in state[:parameters]
      if map_contains_key(managed, row[0])
        parameters[row[1]] = [@index_or(parameters, row[1], []), row[3]]
      end
    end
    layout[:root_parameters] = parameters
    layout[:root_parameter_rows] = state[:parameters]
    layout[:root_contract_rows] = state[:parameter_contracts]
    builder[:module][:generation_layout] = layout
  end
  return [index_or(layout[:root_parameters], builder[:function], []), builder]
end

verb native_roots/open_scope(input: map, failure) -> map
  let builder: map = input
  builder[:scope_failure] = failure
  let module: map = builder[:module]
  let name: string = builder[:name]
  builder[:scope_roots] = []
  builder[:scope_bindings] = {}
  let worker: map = native_gen/zero(native_memory/record_pointer("MemoryWorker"))
  if map_contains_key(module[:bindings][name], "worker")
    worker = native_gen/ref(builder, "worker")
  else
    worker = native_gen/read(native_gen/field(builder, native_gen/ref(builder, "transaction"), "worker"))
  end
  let [bound_worker: map, ready: map] = native_gen/bind(builder, "worker", worker)
  ready[:scope_worker] = bound_worker
  // Root records live in native frames. The chain head is a stable borrowed
  // address, unlike the managed payload pointers held inside those records.
  let [parent: map, with_parent: map] = native_gen/bind(ready, "parent_roots", native_gen/read(native_gen/field(ready, bound_worker, "roots")))
  ready = with_parent
  ready[:scope_parent] = parent
  let bindings: map = {}
  let [parameters: list, indexed: map] = native_roots/parameters(ready)
  ready = indexed
  for spelling in parameters
    let [rooted: map, with_root: map] = native_roots/retain(ready, spelling, native_gen/ref(ready, spelling))
    ready = with_root
    bindings[spelling] = rooted
  end
  ready[:scope_bindings] = bindings
  return ready
end
verb native_roots/return_value(builder: map, value: map) -> map
  let [result: map, ready: map] = native_gen/bind(builder, "result", value)
  // Every nested scope restores its own scope before returning. Unlink this
  // complete frame directly; its root records are stack storage about to expire.
  if map_contains_key(ready, :scope_roots) && len(ready[:scope_roots]) > 0
    let previous: map = native_gen/manage(ready[:scope_parent])
    ready = native_gen/root_write(ready, native_gen/field(ready, native_roots/worker(ready), "roots"), previous)
  end
  let completed: map = native_gen/return_value(ready, result)
  return completed
end
verb native_roots/poll(builder: map) -> map
  let [polled: map, ready: map] = native_gen/bind(builder, "polled", native_gen/call(builder, "memory_safepoint", [native_roots/worker(builder), native_gen/ref(builder, "false")]))
  let result: map = native_gen/unless(ready, polled, fn(failed) => native_roots/fail(failed, "oom"))
  return result
end

// Temporary scans can register cursors inside a generated branch or loop.
// Unlink those roots before their native storage leaves scope. Error returns
// still unwind the complete function through its original scope_parent.
verb native_roots/temporary(builder: map, body) -> map
  let roots: list = builder[:scope_roots]
  let worker: map = native_roots/worker(builder)
  let [parent: map, ready: map] = native_gen/bind(builder, "temporary_parent", native_gen/read(native_gen/field(builder, worker, "roots")))
  let completed: map = body(ready)
  completed = native_gen/root_write(completed, native_gen/field(completed, worker, "roots"), native_gen/manage(parent))
  completed[:scope_roots] = roots
  return completed
end
verb native_roots/context(module: map, name: string, failure) -> map
  let result: map = native_roots/open_scope(native_gen/context(module, name), failure)
  return result
end

verb native_roots/fail(builder: map, reason: string) -> map
  let failure = builder[:scope_failure]
  let result: map = failure(builder, reason)
  return result
end
