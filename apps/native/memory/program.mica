verb native_memory/pointer(type_id) -> list
  return [:Pointer, type_id, :Mutable]
end

verb native_memory/record_pointer(name: string) -> list
  let result: list = native_memory/pointer([:Record, name])
  return result
end

// Live-object next is normally null. Publication preparation temporarily uses
// it for source-to-copy forwarding and links the copies through their next fields.
// A copy retains its source in forward until interior pointers are repaired.
verb native_memory/object_schema() -> list
  let object: list = native_memory/record_pointer("MemoryObject")
  let page: list = native_memory/record_pointer("MemoryPage")
  let heap: list = native_memory/record_pointer("MemoryHeap")
  return ["MemoryObject", [
    ["next", object], ["work", object], ["forward", object], ["page", page], ["heap", heap],
    ["size", :U64], ["layout", :U64], ["mark", :U64], ["state", :U64]]]
end

verb native_memory/page_schema() -> list
  let page: list = native_memory/record_pointer("MemoryPage")
  return ["MemoryPage", [
    ["next", page], ["stride", :U64], ["capacity", :U64], ["live", :U64], ["bucket", :U64]]]
end

verb native_memory/collection_schema() -> list
  let heap: list = native_memory/record_pointer("MemoryHeap")
  let object: list = native_memory/record_pointer("MemoryObject")
  return ["MemoryCollection", [
    ["heap", heap], ["work", object], ["copies", object], ["phase", :U64], ["failed", :Bool], ["limited", :Bool], ["copied", :U64], ["control", native_memory/record_pointer("MemoryControl")]]]
end

verb native_memory/field(type_id, pointer, name: string) -> list
  let result: list = native/typed_load(type_id,
    native/typed_expression(native_memory/pointer(type_id), native/field_pointer_expression(pointer, name)))
  return result
end

verb native_memory/store(type_id, pointer, name: string, value) -> list
  let result: list = native/store_statement(
    native/typed_expression(native_memory/pointer(type_id), native/field_pointer_expression(pointer, name)), value)
  return result
end

verb native_memory/root(type_id, pointer, name: string) -> list
  let result: list = native/typed_expression(type_id, native/root_load_expression(
    native/typed_expression(native_memory/pointer(type_id), native/field_pointer_expression(pointer, name))))
  return result
end

verb native_memory/store_root(type_id, pointer, name: string, value) -> list
  let result: list = native/root_store_statement(
    native/typed_expression(native_memory/pointer(type_id), native/field_pointer_expression(pointer, name)), value)
  return result
end

verb native_memory/number(value: int) -> string
  return string_concat("memory_n", to_literal(value))
end

verb native_memory/call(name: string, arguments: list) -> list
  let result: list = native/do_statement(native/call_expression(name, arguments))
  return result
end

// Allocation and nursery walking must agree on the aligned object stride.
verb native_memory/object_extent(payload: string, header_size: string, total: string) -> list
  let result: list = [
    native/let_statement(total, :U64, native/binary_expression(:Add, payload, header_size)),
    native/set_statement(total, native/binary_expression(:Add, total, "memory_n7")),
    native/set_statement(total, native/binary_expression(:BitAnd, total, "memory_alignment_mask"))]
  return result
end

verb native_memory/declare(context: map, name: string, result, parameters: list, effects: list, mode: symbol, owner: string) -> map
  let declared: map = native/declare_function(context, name, result, parameters, [], effects, mode, owner)
  let with_contract: map = native/execution_function(declared, name, :Collector)
  return with_contract
end

// These builders allocate without collecting. Failure must leave the operation
// before a caller initializes or publishes the returned storage.
verb native_memory/allocate(name: string, size, layout: string, failure: list, ?worker: string = "worker", ?null: string = "null_bytes") -> list
  return [
    native/let_call(name, native_memory/pointer(:U8), "memory_allocate", [worker, size, layout]),
    native/when_statement(native/binary_expression(:Equal, name, null), failure)]
end

verb native_memory/allocate_record(name: string, record: list, layout: string, failure: list, ?raw: string = "raw", ?size: string = "size") -> list
  return [
    native/let_statement(size, :U64, native/unary_expression(:SizeOf, record)),
    @native_memory/allocate(raw, size, layout, failure),
    native/let_statement(name, native_memory/pointer(record), native/unary_expression(:PointerCast, raw))]
end

// Divide before multiplying, so the element count cannot overflow the byte size.
// An empty array may have a null address and must not be dereferenced.
verb native_memory/allocate_array(name: string, element, count: string, layout: string, failure: list) -> list
  let size: string = string_concat(name, "_size")
  let raw: string = string_concat(name, "_raw")
  return [
    native/let_statement(size, :U64, native/unary_expression(:SizeOf, element)),
    native/when_statement(native/binary_expression(:Less,
      native/typed_expression(:U64, native/binary_expression(:Divide, "allocation_limit", size)), count), failure),
    native/let_call(raw, native_memory/pointer(:U8), "memory_allocate", ["worker",
      native/typed_expression(:U64, native/binary_expression(:Multiply, size, count)), layout]),
    native/when_statement(native/binary_expression(:Less, "zero", count),
      [native/when_statement(native/binary_expression(:Equal, raw, "null_bytes"), failure)]),
    native/let_statement(name, native_memory/pointer(element), native/unary_expression(:PointerCast, raw))]
end

// Allocate an object prefix followed by count fixed-width elements. The caller
// establishes prefix <= allocation_limit and a nonzero element width first.
// All extent operands are bindings, so checking cannot repeat an expression.
verb native_memory/allocate_with_tail(raw: string, prefix: string, width: string, count: string, layout: string, failure: list,
    ?limit: string = "limit", ?bytes: string = "bytes", ?total: string = "total") -> list
  return [
    native/let_statement(limit, :U64, native/binary_expression(:Subtract, "allocation_limit", prefix)),
    native/set_statement(limit, native/binary_expression(:Divide, limit, width)),
    native/when_statement(native/binary_expression(:Less, limit, count), failure),
    native/let_statement(bytes, :U64, native/binary_expression(:Multiply, count, width)),
    native/let_statement(total, :U64, native/binary_expression(:Add, prefix, bytes)),
    @native_memory/allocate(raw, total, layout, failure)]
end

// Typed allocation builders preserve the no-safepoint allocation contract.
// Extents are bound before checking, then reused for pointer partitioning.
verb native_memory/extent(builder: map, prefix: map, element, count: map, failure) -> list
  let [base: map, current: map] = native_gen/bind(builder, "prefix_size", prefix)
  let [width: map, with_width: map] = native_gen/bind(current, "element_size", native_gen/sizeof(element))
  current = with_width
  let [length: map, with_length: map] = native_gen/bind(current, "element_count", count)
  current = with_length
  let limit: map = native_gen/ref(current, "allocation_limit")
  current = native_gen/when(current, native_gen/less(limit, base), failure)
  let available: map = native_gen/divide(native_gen/subtract(limit, base), width)
  current = native_gen/when(current, native_gen/less(available, length), failure)
  let [bytes: map, with_bytes: map] = native_gen/bind(current, "allocation_size", native_gen/add(base, native_gen/multiply(width, length)))
  current = with_bytes
  return [base, bytes, current]
end

verb native_memory/reserve(builder: map, worker: map, size: map, layout: string, failure) -> list
  let [raw: map, current: map] = native_gen/bind(builder, "allocation", native_gen/call(builder, "memory_allocate", [worker, size, native_gen/ref(builder, layout)]))
  current = native_gen/when(current, native_gen/equal(raw, native_gen/ref(current, "null_bytes")), failure)
  return [raw, current]
end

verb native_memory/tail_storage(builder: map, worker: map, header, element, count: map, layout: string, failure) -> list
  let [prefix: map, size: map, current: map] = native_memory/extent(builder, native_gen/sizeof(header), element, count, failure)
  let [raw: map, with_raw: map] = native_memory/reserve(current, worker, size, layout, failure)
  current = with_raw
  let [object: map, with_object: map] = native_gen/bind(current, "object", native_gen/cast(native_memory/pointer(header), raw))
  current = with_object
  let [data: map, with_data: map] = native_gen/bind(current, "data", native_gen/cast(native_memory/pointer(element), native_gen/offset(raw, prefix)))
  current = with_data
  return [object, data, current]
end

// Empty arrays are represented by a null pointer without reserving storage.
verb native_memory/array_storage(builder: map, worker: map, element, count: map, layout: string, failure) -> list
  let [prefix: map, size: map, current: map] = native_memory/extent(builder, native_gen/zero(:U64), element, count, failure)
  let pointer: list = native_memory/pointer(element)
  let [data: map, initialized: map] = native_gen/bind(current, "data", native_gen/zero(pointer))
  current = native_gen/unless(initialized, native_gen/equal(size, native_gen/zero(:U64)), fn(nonempty)
    let [raw: map, allocated: map] = native_memory/reserve(nonempty, worker, size, layout, failure)
    return native_gen/assign(allocated, data, native_gen/cast(pointer, raw))
  end)
  return [data, current]
end

// Fields include their ownership mode. Construction initializes the complete
// record before returning it; allocation does not introduce a safepoint.
verb native_memory/record_constructor(input: map, name: string, schema: list, layout: string, allocation_null: string) -> map
  let context: map = input
  let pointer: list = native_memory/record_pointer(schema[0])
  let fields: map = {}
  for field in schema[1]
    native/ensure(len(field) == 3, "managed record fields require ownership modes")
    fields[field[0]] = field[0]
  end
  context = native_memory/declare(context, name, pointer,
    [["worker", native_memory/record_pointer("MemoryWorker"), :Borrow], @schema[1]],
    [:ReadMemory, :WriteMemory, :Allocate, :Release], :Gc, "")
  context = native/define_function(context, name, [
    @native_memory/allocate("raw",
      native/typed_expression(:U64, native/unary_expression(:SizeOf, [:Record, schema[0]])), layout,
      [native/return_value(native/typed_zero(pointer))], "worker", allocation_null),
    native/let_statement("object", pointer, native/unary_expression(:PointerCast, "raw")),
    native/store_statement("object", native/initialize_record(schema, fields)),
    native/return_value("object")])
  return context
end

// Allocation never relocates. Only explicit safepoints can rewrite roots.
// Worker and heap controls remain outside the nursery. Published payloads are immutable.
verb native_memory/context(input: map) -> map
  let context: map = input
  let bytes: list = native_memory/pointer(:U8)
  let object: list = native_memory/record_pointer("MemoryObject")
  let page: list = native_memory/record_pointer("MemoryPage")
  let heap: list = native_memory/record_pointer("MemoryHeap")
  let worker: list = native_memory/record_pointer("MemoryWorker")
  let root: list = native_memory/record_pointer("MemoryRoot")
  let collection: list = native_memory/record_pointer("MemoryCollection")
  let effects: list = [:ReadMemory, :WriteMemory, :Allocate, :Release]
  let [trace, initial] = native/function_pointer_type(context[:state], "MemoryTrace", :Void,
    [["collection", collection, :Borrow], ["object", object, :Gc]], effects, :Value, "")
  let [check, with_check] = native/function_pointer_type(initial, "MemoryCheck", :Bool,
    [["context", bytes, :Borrow], ["bytes", :U64, :Value], ["steps", :U64, :Value]], [:ReadMemory, :WriteMemory], :Value, "")
  let state: map = with_check
  state = native/record_type(state, "MemoryControl", [["parent", native_memory/record_pointer("MemoryControl")], ["context", bytes], ["check", check], ["denied", :Bool]])[1]
  state = native/record_type(state, "MemoryAllocationResult", [["object", object], ["limited", :Bool]])[1]
  let object_schema: list = native_memory/object_schema()
  let page_schema: list = native_memory/page_schema()
  state = native/record_type(state, object_schema[0], object_schema[1])[1]
  state = native/record_type(state, page_schema[0], page_schema[1])[1]
  state = native/record_type(state, "MemoryRoot", [
    ["next", root], ["pointer", bytes], ["bits", :U64], ["registration", :U64]])[1]
  state = native/record_type(state, "MemoryWorker", [
    ["next", worker], ["heap", heap], ["roots", root], ["nursery", bytes],
    ["capacity", :U64], ["used", :U64], ["active", :Bool], ["control", native_memory/record_pointer("MemoryControl")]])[1]
  state = native/record_type(state, "MemoryHeap", [
    ["pages", page], ["free", [:Array, object, 10]], ["workers", worker], ["roots", root], ["trace", trace],
    ["mutex", bytes], ["collecting", :Bool], ["collection_ok", :Bool], ["collection_limited", :Bool], ["pressure", :Bool], ["epoch", :U64],
    ["allocated", :U64], ["nursery_bytes", :U64], ["capacity_limit", :U64], ["collection_limit", :U64], ["retained", :U64], ["copied", :U64], ["collections", :U64]])[1]
  let collection_schema: list = native_memory/collection_schema()
  state = native/record_type(state, collection_schema[0], collection_schema[1])[1]
  let declarations: list = [
    ["memory_object_free", :U64, "0000000000000000"],
    ["memory_object_nursery", :U64, "0000000000000001"],
    ["memory_object_mature", :U64, "0000000000000002"],
    ["memory_object_private", :U64, "0000000000000003"],
    ["memory_object_frozen", :U64, "0000000000000004"],
    ["memory_trace_prepare", :U64, "0000000000000000"],
    ["memory_trace_rewrite", :U64, "0000000000000001"],
    ["memory_share_prepare", :U64, "0000000000000002"],
    ["memory_share_rewrite", :U64, "0000000000000003"],
    ["memory_null_bytes", bytes, "null"], ["memory_null_object", object, "null"],
    ["memory_null_page", page, "null"], ["memory_null_worker", worker, "null"],
    ["memory_null_root", root, "null"], ["memory_null_trace", trace, "null"],
    ["memory_null_heap", heap, "null"], ["memory_true", :Bool, "true"], ["memory_false", :Bool, "false"],
    ["memory_previous", :I64, "-0000000000000001"],
    ["memory_copy_chunk", :U64, "0000000000001000"],
    ["memory_trace_mask", :U64, "000000000000003f"],
    ["memory_cell_size", :U64, "0000000000000080"],
    ["memory_page_size", :U64, "0000000000010000"],
    ["memory_default_capacity", :U64, "0000000040000000"],
    ["memory_collection_floor", :U64, "0000000000100000"],
    ["memory_alignment_mask", :U64, "fffffffffffffff8"],
    ["memory_allocation_limit", :U64, "7fffffffffff0000"]]
  let n: int = 0
  while n <= 16
    declarations = [@declarations, [native_memory/number(n), :U64, native_value/hex(n)]]
    n = n + 1
  end
  let [constants, declared] = native/constants(state, declarations)
  context[:state] = declared
  let bindings: map = context[:constants]
  for name, id in constants
    bindings[name] = id
  end
  context[:constants] = bindings
  for spec in [
    ["memory_platform_allocate", bytes, [["size", :U64, :Value]], [:Allocate], :Owned],
    ["memory_platform_release", :Void, [["pointer", bytes, :Gc]], [:Release], :Value]]
    context = native/declare_function(context, spec[0], spec[1], spec[2], [], spec[3], spec[4], "")
    context[:state] = native/foreign(context[:state], context[:functions][spec[0]])
  end
  context = native_memory/declare(context, "memory_control_check", :Bool,
    [["control", native_memory/record_pointer("MemoryControl"), :Borrow], ["bytes", :U64, :Value], ["steps", :U64, :Value]], [:ReadMemory, :WriteMemory], :Value, "")
  context = native_memory/declare(context, "memory_object", object, [["pointer", bytes, :Gc]], [], :Gc, "")
  context = native_memory/declare(context, "memory_payload", bytes, [["object", object, :Gc]], [], :Gc, "")
  context = native_memory/declare(context, "memory_original", bytes, [["object", object, :Gc]], [:ReadMemory], :Gc, "")
  context = native_memory/declare(context, "memory_nursery_allocate", bytes,
    [["worker", worker, :Borrow], ["size", :U64, :Value], ["layout", :U64, :Value]],
    [:ReadMemory, :WriteMemory], :Gc, "")
  context = native_memory/declare(context, "memory_has_capacity", :Bool,
    [["heap", heap, :Borrow], ["size", :U64, :Value]], [:ReadMemory], :Value, "")
  context = native_memory/declare(context, "memory_control_deny", :Void,
    [["control", native_memory/record_pointer("MemoryControl"), :Borrow]], [:WriteMemory], :Value, "")
  context = native_memory/declare(context, "memory_mature_allocate", [:Record, "MemoryAllocationResult"],
    [["heap", heap, :Borrow], ["size", :U64, :Value], ["layout", :U64, :Value]],
    [:ReadMemory, :WriteMemory, :Allocate], :Gc, "")
  context = native_memory/declare(context, "memory_visit", bytes,
    [["collection", collection, :Borrow], ["pointer", bytes, :Gc]], effects, :Gc, "")
  context = native_memory/declare(context, "memory_share_visit", bytes,
    [["collection", collection, :Borrow], ["pointer", bytes, :Gc]], effects, :Gc, "")
  context = native_memory/declare(context, "memory_share", bytes,
    [["worker", worker, :Borrow], ["pointer", bytes, :Gc]], effects, :Gc, "")
  context = native_memory/declare(context, "memory_discard", :Void,
    [["heap", heap, :Borrow], ["object", object, :Gc]], effects, :Value, "")
  context = native_memory/declare(context, "memory_sweep", :Void,
    [["heap", heap, :Borrow], ["reclaim", :Bool, :Value]], [:ReadMemory, :WriteMemory, :Release], :Value, "")
  context = native_memory/declare(context, "memory_rollback_nursery", :Void,
    [["worker", worker, :Borrow]], [:ReadMemory, :WriteMemory], :Value, "")
  context = native_memory/declare(context, "memory_collect_stopped", :Bool,
    [["heap", heap, :Borrow]], [@effects, :Relocate], :Value, "")
  return context
end

verb native_memory/program() -> map
  let context: map = native_memory/context(native/module_context(native/program(), {}))
  context = native_memory/allocation(context)
  context = native_memory/collection(context)
  context = native_memory/lifecycle(context)
  let result: map = context[:state]
  return result
end
