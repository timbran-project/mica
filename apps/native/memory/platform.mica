// These bindings supply allocation and pthread primitives. Worker membership,
// safepoints, roots, allocation policy, and collection are generated native IR.
verb native_memory/platform() -> string
  return string_join([
    "#include <stdlib.h>", "#include <pthread.h>",
    "#include <stdatomic.h>",
    "uint8_t *mica_foreign_memory_atomic_create(uint64_t value) {",
    "    _Atomic uint64_t *cell = malloc(sizeof(*cell));",
    "    if (cell) atomic_init(cell, value);",
    "    return (uint8_t *)cell;",
    "}",
    "void mica_foreign_memory_atomic_destroy(uint8_t *cell) { free(cell); }",
    "uint64_t mica_foreign_memory_atomic_load(uint8_t *cell) { return atomic_load((_Atomic uint64_t *)cell); }",
    "bool mica_foreign_memory_atomic_compare_exchange(uint8_t *cell, uint64_t expected, uint64_t desired) {",
    "    return atomic_compare_exchange_strong((_Atomic uint64_t *)cell, &expected, desired);",
    "}",
    "#ifndef MICA_MEMORY_TEST_ALLOCATOR",
    "uint8_t *mica_foreign_memory_platform_allocate(uint64_t size) { return malloc(size); }",
    "void mica_foreign_memory_platform_release(uint8_t *pointer) { free(pointer); }",
    "#endif",
    "struct mica_memory_sync { pthread_mutex_t mutex; pthread_cond_t condition; };",
    "uint8_t *mica_foreign_memory_sync_create(void) {",
    "    struct mica_memory_sync *sync = malloc(sizeof(*sync));",
    "    if (!sync) return NULL;",
    "    if (pthread_mutex_init(&sync->mutex, NULL)) { free(sync); return NULL; }",
    "    if (pthread_cond_init(&sync->condition, NULL)) {",
    "        pthread_mutex_destroy(&sync->mutex); free(sync); return NULL;",
    "    }",
    "    return (uint8_t *)sync;",
    "}",
    "void mica_foreign_memory_sync_destroy(uint8_t *pointer) {",
    "    struct mica_memory_sync *sync = (void *)pointer;",
    "    if (pthread_cond_destroy(&sync->condition) || pthread_mutex_destroy(&sync->mutex)) abort();",
    "    free(sync);",
    "}",
    "void mica_foreign_memory_lock(uint8_t *pointer) {",
    "    struct mica_memory_sync *sync = (void *)pointer;",
    "    if (pthread_mutex_lock(&sync->mutex)) abort();",
    "}",
    "void mica_foreign_memory_unlock(uint8_t *pointer) {",
    "    struct mica_memory_sync *sync = (void *)pointer;",
    "    if (pthread_mutex_unlock(&sync->mutex)) abort();",
    "}",
    "void mica_foreign_memory_wait(uint8_t *pointer) {",
    "    struct mica_memory_sync *sync = (void *)pointer;",
    "    if (pthread_cond_wait(&sync->condition, &sync->mutex)) abort();",
    "}",
    "void mica_foreign_memory_wake(uint8_t *pointer) {",
    "    struct mica_memory_sync *sync = (void *)pointer;",
    "    if (pthread_cond_broadcast(&sync->condition)) abort();",
    "}", ""], "\n")
end
