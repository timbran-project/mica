// Runtime operations used by source instructions. These builders own checks,
// error propagation, and effect staging; instruction dispatch only supplies values.
verb native_source/raise_error(builder: map, code, message: map, value: map) -> map
  let encoded: map = native_source/literal(builder, code)
  let number: map = native_gen/convert(:U32, native_gen/expression(:U64, :Payload, [encoded]))
  let [error: map, ready: map] = native_source/result(builder, "value_error", [native_roots/worker(builder), number,
    native_gen/ref(builder, "true"), message, native_gen/ref(builder, "true"), value], "oom")
  let [retained: map, rooted: map] = native_roots/retain(ready, "error", error)
  let result: map = native_source/throw(rooted, retained)
  return result
end
verb native_source/value_error(builder: map, code, message: string, value: map) -> map
  let result: map = native_source/raise_error(builder, code, native_source/literal(builder, message), value)
  return result
end
verb native_source/kind_prefix(kind: symbol, site: symbol, subject: symbol) -> string
  let boundaries: map = {:Binding -> "binding", :Parameter -> "parameter", :Builtin -> "builtin result"}
  native/ensure(map_contains_key(boundaries, site), "unknown source kind-check site")
  let result: string = string_concat(boundaries[site], " `", native_source/symbol_text(subject), "` requires ", native_source/symbol_text(kind), ", got ")
  return result
end

// Share kind-name selection across every annotation. Only a failing check
// allocates its diagnostic; successful checks compare one tag.
verb native_source/kind_message_body(input: map) -> map
  let name: string = string_concat(input[:source_prefix], "_kind_message")
  let word: list = native_value/word()
  let module: map = native_memory/declare(input, name, [:Record, "ValueResult"], [
    ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow],
    ["code", native_tasks/pointer("CodeRef"), :Gc], ["prefix", word, :Gc], ["value", word, :Gc]],
    [:ReadMemory, :WriteMemory, :Allocate], :Gc, "")
  let builder: map = native_gen/context(module, name)
  builder[:source_prefix] = module[:source_prefix]
  builder[:source_literal_index] = module[:source_literal_index]
  builder[:source_code] = native_gen/ref(builder, "code")
  let [message: map, ready: map] = native_gen/bind(builder, "kind", native_gen/zero(word))
  let cases: list = []
  for spec in native_value/kinds()
    cases = [@cases, [native_gen/ref(ready, string_concat("tag_", spec[0])),
      fn(branch) => native_gen/assign(branch, message, native_source/literal(branch, spec[0]))]]
  end
  ready = native_gen/switch(ready, native_gen/call(ready, "value_kind", [native_gen/ref(ready, "value")]), cases,
    fn(invalid) => native_gen/return_value(invalid, native_gen/zero([:Record, "ValueResult"])))
  ready = native_gen/return_value(ready, native_gen/call(ready, "value_string_concat", [
    native_gen/ref(ready, "worker"), native_gen/ref(ready, "prefix"), message]))
  let result: map = native_gen/finish(module, ready)
  return result
end
verb native_source/check_kind(builder: map, value: map, kind: symbol, site: symbol, subject: symbol) -> map
  let spelling: string = native_source/symbol_text(kind)
  let condition: map = native_gen/equal(native_gen/call(builder, "value_kind", [value]), native_gen/ref(builder, string_concat("tag_", spelling)))
  let result: map = native_gen/unless(builder, condition, fn(wrong)
    let code: map = native_kernel/load_field(wrong, native_handlers/current(wrong), "code")
    let prefix: map = native_source/literal(wrong, native_source/kind_prefix(kind, site, subject))
    let [message: map, ready: map] = native_source/result(wrong, string_concat(wrong[:source_prefix], "_kind_message"),
      [native_roots/worker(wrong), code, prefix, value], "oom")
    return native_source/raise_error(ready, E_TYPE, message, value)
  end)
  return result
end
verb native_source/emit(builder: map, target: map, value: map) -> map
  let result: map = native_source/checked(builder, "task_emit", [native_roots/worker(builder), native_tasks/attempt(builder), target, value])
  return result
end

// Mailbox sends join the attempt's staged effects. Resource creation and close
// use the native mailbox service directly, as required by its current API.
verb native_source/mailbox(builder: map, hub: map) -> list
  let [caps: map, created: map] = native_gen/bind(builder, "mailbox", native_gen/call(builder, "task_mailbox_create", [
    hub, native_roots/worker(builder), native_source/service(builder, "mailbox_capacity")]))
  let ready: map = native_gen/unless(created, native_kernel/absent(native_gen/field(created, caps, "status")),
    fn(failed) => native_roots/return_value(failed, native_gen/field(failed, caps, "status")))
  let result: list = native_source/list(ready, [native_gen/field(ready, caps, "receiver"), native_gen/field(ready, caps, "sender")])
  return result
end
verb native_source/send(builder: map, hub: map, sender: map, value: map) -> map
  let ready: map = native_source/checked(builder, "task_mailbox_validate_sender", [hub, native_roots/worker(builder), sender])
  let result: map = native_source/checked(ready, "task_stage", [native_roots/worker(ready), native_tasks/slot(ready, "effects"),
    native_gen/ref(ready, "task_effect_send"), sender, value])
  return result
end
verb native_source/close_mailbox(builder: map, hub: map, receiver: map) -> map
  let result: map = native_source/checked(builder, "task_mailbox_close", [hub, native_roots/worker(builder), receiver])
  return result
end
verb native_source/mailbox_builtin(builder: map, name: symbol, args: list) -> list
  let hub: map = native_source/service(builder, "mailboxes")
  let ready: map = native_tasks/check(builder, native_gen/negate(native_kernel/absent(hub)), "closed")
  if name == :mailbox
    native/ensure(len(args) == 0, "native mailbox expects no arguments")
    let result: list = native_source/mailbox(ready, hub)
    return result
  end
  if name == :mailbox_send
    native/ensure(len(args) == 2, "native mailbox_send expects sender and value")
    return [args[1], native_source/send(ready, hub, args[0], args[1])]
  end
  native/ensure(name == :mailbox_close && len(args) == 1, string_concat("unsupported native source builtin: ", to_literal(name)))
  ready = native_source/close_mailbox(ready, hub, args[0])
  return [native_source/literal(ready, [] {[]}), ready]
end

verb native_source/builtin_items(builder: map, name: symbol, items: list) -> list
  if name == :subscribe_changes
    let result: list = native_source_subscriptions/items(builder, items)
    return result
  end
  if name == :error
    let result: list = native_source/error_items(builder, items)
    return result
  end
  if name == :string_concat
    let result: list = native_text/concatenate(builder, items)
    return result
  end
  if name == :project
    let [arguments: map, expanded: map] = native_source/list_items(builder, items, false)
    let [retained: map, ready: map] = native_roots/retain(expanded, "arguments", arguments)
    let result: list = native_algebra/call(ready, "project", [retained])
    return result
  end
  let arities: map = native_builtins/arities()
  native/ensure(map_contains_key(arities, name), string_concat("unsupported native source builtin: ", to_literal(name)))
  if !native_source/spliced(items)
    if len(items) != arities[name]
      // Keep an ordinary unreachable continuation in the generated CFG.
      let checked: map = native_gen/unless(builder, native_gen/ref(builder, "false"),
        fn(invalid) => native_builtins/arity_failure(invalid, name))
      return [native_gen/zero(native_value/word()), checked]
    end
    let result: list = native_builtins/call(builder, name, native_source/operands(builder, items))
    return result
  end
  let [values: map, expanded: map] = native_source/list_items(builder, items, false)
  let [arguments: map, rooted: map] = native_roots/retain(expanded, "arguments", values)
  let ready: map = native_gen/unless(rooted, native_gen/equal(native_query/width(rooted, arguments), native_source/number(rooted, arities[name])),
    fn(invalid) => native_builtins/arity_failure(invalid, name))
  let args: list = []
  let position: int = 0
  while position < arities[name]
    args = [@args, native_query/cell(ready, arguments, native_source/number(ready, position))]
    position = position + 1
  end
  let result: list = native_builtins/call(ready, name, args)
  return result
end
