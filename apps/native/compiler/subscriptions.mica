// Decode source options under a bounded read operation. Staging runs after that
// operation returns, so its task_poll charge cannot debit the same allowance twice.
verb native_source_subscriptions/name(module: map, suffix: string) -> string
  return string_concat(module[:source_prefix], "_subscription_", suffix)
end
verb native_source_subscriptions/errors() -> list
  return ["subscribe_changes expects five to seven arguments",
    "subscription subject must be :catalogue, :facts, or :relation",
    "subscription relation must be an option", "subscription bindings must be a list of options",
    "catalogue subscriptions require no relation or bindings",
    "relation subscriptions require some(identity or relation name)",
    "unknown subscription relation name", "subscription bindings exceed 64 columns",
    "subscription initial mode must be :changes or :snapshot",
    "subscription cursor must be an option containing a nonnegative integer",
    "snapshot subscriptions cannot resume a cursor", "subscription queue budget must be a positive integer",
    "subscription bindings do not match relation arity", "fact subscriptions require a stored relation"]
end
verb native_source_subscriptions/literals() -> list
  return [E_INVARG, :value, :catalogue, :facts, :relation, :changes, :snapshot, none,
    @native_source_subscriptions/errors()]
end
verb native_source_subscriptions/result(builder: map, fields: map) -> map
  let values: map = {}
  for field in native/record_fields({:records -> builder[:records]}, builder[:result])
    values[field[2]] = native_gen/zero(field[3])
  end
  for key, value in fields
    values[key] = value
  end
  let result: map = native_roots/return_value(builder, native_gen/record(builder, builder[:result], values))
  return result
end
verb native_source_subscriptions/check(builder: map, condition: map, shape: int) -> map
  let result: map = native_gen/unless(builder, condition, fn(invalid)
    return native_source_subscriptions/result(invalid, {"shape" -> native_source/number(invalid, shape)})
  end)
  return result
end

// Standard options have exactly the heading [:value] and zero or one row.
// The returned payload is borrowed; retain it before any allocating operation.
verb native_source_subscriptions/option(builder: map, value: map, shape: int) -> list
  let ready: map = native_source_subscriptions/check(builder, native_access/kind(builder, value, "relation"), shape)
  let arity: map = native_gen/field(ready, native_gen/call(ready, "value_relation_arity", [value]), "number")
  ready = native_source_subscriptions/check(ready, native_gen/equal(arity, native_gen/ref(ready, "one")), shape)
  let column: map = native_gen/field(ready, native_gen/call(ready, "value_relation_column_at", [value, native_gen/ref(ready, "zero")]), "number")
  ready = native_source_subscriptions/check(ready, native_gen/equal(column,
    native_gen/expression(:U64, :Payload, [native_source/literal(ready, :value)])), shape)
  let length: map = native_gen/field(ready, native_gen/call(ready, "value_relation_length", [value]), "number")
  ready = native_source_subscriptions/check(ready, native_gen/less(length, native_gen/ref(ready, "two")), shape)
  let [present: map, counted: map] = native_gen/bind(ready, "present", native_gen/not_equal(length, native_gen/ref(ready, "zero")))
  let [payload: map, allocated: map] = native_gen/bind(counted, "payload", native_gen/zero(native_value/word()))
  ready = native_gen/when(allocated, present, fn(some)
    let tuple: map = native_gen/field(some, native_gen/call(some, "value_relation_row", [value, native_gen/ref(some, "zero")]), "tuple")
    return native_gen/assign(some, payload, native_gen/field(some, native_gen/call(some, "value_tuple_get", [tuple, native_gen/ref(some, "zero")]), "value"))
  end)
  return [present, payload, ready]
end
verb native_source_subscriptions/natural(builder: map, value: map, shape: int, positive: bool) -> list
  let ready: map = native_source_subscriptions/check(builder, native_access/kind(builder, value, "int"), shape)
  let [decoded: map, converted: map] = native_gen/bind(ready, "integer", native_gen/call(ready, "value_as_int", [value]))
  let number: map = native_gen/field(converted, decoded, "number")
  let valid: map = native_gen/negate(native_gen/less(number, native_gen/ref(converted, "int_zero")))
  if positive
    valid = native_gen/less(native_gen/ref(converted, "int_zero"), number)
  end
  ready = native_source_subscriptions/check(converted, valid, shape)
  return [native_gen/bitcast(:U64, number), ready]
end

// The catalogue is indexed by identity. Name lookup visits its balanced tree
// under the caller's budget, after kernel_catalogue has checked authority and
// observed the draft catalogue for conflict detection.
verb native_source_subscriptions/find_body(module: map) -> map
  let name: string = native_source_subscriptions/name(module, "find")
  let builder: map = native_query/context(module, name)
  let node: map = native_roots/ref(builder, "node")
  let output: map = native_gen/ref(builder, "output")
  builder = native_gen/when(builder, native_kernel/absent(node),
    fn(empty) => native_roots/return_value(empty, native_gen/ref(empty, "kernel_ok")))
  builder = native_query/charge(builder, native_gen/ref(builder, "one"), native_gen/ref(builder, "zero"))
  builder = native_roots/poll(builder)
  let entry: map = native_kernel/load_field(builder, node, "entry")
  builder = native_gen/when(builder, native_gen/equal(native_kernel/load_field(builder, entry, "name"), native_gen/ref(builder, "name")), fn(found)
    let stored: map = native_gen/store(found, output, native_kernel/load_field(found, entry, "id"))
    return native_roots/return_value(stored, native_gen/ref(stored, "kernel_ok"))
  end)
  builder = native_query/status_call(builder, name, [native_roots/worker(builder), native_kernel/load_field(builder, node, "left"), native_gen/ref(builder, "name"), output])
  builder = native_gen/unless(builder, native_kernel/absent(native_gen/load(output)),
    fn(found) => native_roots/return_value(found, native_gen/ref(found, "kernel_ok")))
  let result: map = native_gen/finish(module, native_roots/return_value(builder, native_query/call(builder, name,
    [native_roots/worker(builder), native_kernel/load_field(builder, node, "right"), native_gen/ref(builder, "name"), output])))
  return result
end
verb native_source_subscriptions/relation(builder: map, subject: map, option: map, bindings: map) -> list
  let [present: map, borrowed: map, decoded: map] = native_source_subscriptions/option(builder, option, 3)
  let [payload: map, rooted: map] = native_roots/retain(decoded, "relation_name", borrowed)
  let [id: map, ready: map] = native_gen/bind(rooted, "relation_id", native_gen/ref(rooted, "zero"))
  ready = native_gen/branch(ready, native_gen/equal(subject, native_gen/ref(ready, "task_subscription_catalogue")), fn(catalogue)
    let checked: map = native_source_subscriptions/check(catalogue, native_gen/negate(present), 5)
    return native_source_subscriptions/check(checked, native_kernel/absent(native_query/width(checked, bindings)), 5)
  end, fn(relation)
    let checked: map = native_source_subscriptions/check(relation, present, 6)
    return native_gen/branch(checked, native_access/kind(checked, payload, "identity"), fn(identity)
      return native_gen/assign(identity, id, native_gen/expression(:U64, :Payload, [payload]))
    end, fn(symbol)
      let typed: map = native_source_subscriptions/check(symbol, native_access/kind(symbol, payload, "symbol"), 6)
      let [catalogue: map, called: map] = native_gen/bind(typed, "catalogue", native_query/call(typed, "kernel_catalogue", [native_gen/ref(typed, "transaction")]))
      let status: map = native_gen/field(called, catalogue, "status")
      let authorized: map = native_gen/unless(called, native_kernel/absent(status), fn(failed) => native_query/fail(failed, status))
      authorized = native_query/status_call(authorized, native_source_subscriptions/name(authorized, "find"), [
        native_roots/worker(authorized), native_gen/field(authorized, catalogue, "schemas"),
        native_gen/expression(:U64, :Payload, [payload]), native_gen/address(id)])
      return native_source_subscriptions/check(authorized, native_gen/negate(native_kernel/absent(id)), 7)
    end)
  end)
  return [id, ready]
end
verb native_source_subscriptions/decode_body(module: map) -> map
  let builder: map = native_queries/borrow_budget(native_gen/context(module, native_source_subscriptions/name(module, "decode_value")))
  builder[:source_prefix] = module[:source_prefix]
  builder[:source_literal_index] = module[:source_literal_index]
  builder[:source_code] = native_roots/ref(builder, "code")
  let arguments: map = native_roots/ref(builder, "arguments")
  let count: map = native_query/width(builder, arguments)
  builder = native_source_subscriptions/check(builder, native_gen/negate(native_gen/less(count, native_source/number(builder, 5))), 1)
  builder = native_source_subscriptions/check(builder, native_gen/less(count, native_source/number(builder, 8)), 1)
  let subject_value: map = native_query/cell(builder, arguments, native_source/number(builder, 1))
  let [subject: map, subject_builder: map] = native_gen/bind(builder, "subject", native_gen/ref(builder, "zero"))
  builder = subject_builder
  for [tag, constant] in [[:catalogue, "task_subscription_catalogue"], [:facts, "task_subscription_facts"], [:relation, "task_subscription_relation"]]
    builder = native_gen/when(builder, native_gen/equal(subject_value, native_source/literal(builder, tag)),
      fn(selected) => native_gen/assign(selected, subject, native_gen/ref(selected, constant)))
  end
  builder = native_source_subscriptions/check(builder, native_gen/negate(native_kernel/absent(subject)), 2)
  let bindings: map = native_query/cell(builder, arguments, native_source/number(builder, 3))
  builder = native_source_subscriptions/check(builder, native_access/kind(builder, bindings, "list"), 4)
  let width: map = native_query/width(builder, bindings)
  builder = native_source_subscriptions/check(builder, native_gen/negate(native_gen/less(native_source/number(builder, 64), width)), 8)
  let [relation: map, resolved: map] = native_source_subscriptions/relation(builder, subject,
    native_query/cell(builder, arguments, native_source/number(builder, 2)), bindings)
  let initial_value: map = native_query/cell(resolved, arguments, native_source/number(resolved, 4))
  let [initial: map, with_initial: map] = native_gen/bind(resolved, "initial", native_gen/equal(initial_value, native_source/literal(resolved, :snapshot)))
  builder = native_gen/unless(with_initial, initial, fn(changes)
    return native_source_subscriptions/check(changes, native_gen/equal(initial_value, native_source/literal(changes, :changes)), 9)
  end)
  let [resume: map, with_resume: map] = native_gen/bind(builder, "resume", native_gen/ref(builder, "false"))
  let [cursor: map, with_cursor: map] = native_gen/bind(with_resume, "cursor", native_gen/ref(with_resume, "zero"))
  builder = native_gen/when(with_cursor, native_gen/less(native_source/number(with_cursor, 5), count), fn(supplied)
    let [present: map, value: map, decoded: map] = native_source_subscriptions/option(supplied,
      native_query/cell(supplied, arguments, native_source/number(supplied, 5)), 10)
    let assigned: map = native_gen/assign(decoded, resume, present)
    return native_gen/when(assigned, present, fn(nonempty)
      let checked: map = native_source_subscriptions/check(nonempty, native_gen/negate(initial), 11)
      let [number: map, ready: map] = native_source_subscriptions/natural(checked, value, 10, false)
      return native_gen/assign(ready, cursor, number)
    end)
  end)
  let [capacity: map, with_capacity: map] = native_gen/bind(builder, "capacity", native_source/number(builder, 64))
  builder = native_gen/when(with_capacity, native_gen/equal(count, native_source/number(with_capacity, 7)), fn(supplied)
    let [number: map, ready: map] = native_source_subscriptions/natural(supplied,
      native_query/cell(supplied, arguments, native_source/number(supplied, 6)), 12, true)
    return native_gen/assign(ready, capacity, number)
  end)
  let [blank: map, allocated: map] = native_rules/empty_binding(builder, width)
  let [pattern: map, retained: map] = native_roots/retain(allocated, "pattern", blank)
  let [mask: map, with_mask: map] = native_gen/bind(retained, "mask", native_gen/ref(retained, "zero"))
  builder = native_gen/for_range(with_mask, "column", native_gen/ref(with_mask, "zero"), width, fn(step, index)
    let polled: map = native_query/poll_interval(step, index)
    let [present: map, value: map, decoded: map] = native_source_subscriptions/option(polled, native_query/cell(polled, bindings, index), 4)
    return native_gen/when(decoded, present, fn(bound)
      let stored: map = native_rules/row_store(bound, pattern, index, value)
      return native_gen/assign(stored, mask, native_gen/bit_or(mask, native_gen/shift_left(native_gen/ref(stored, "one"), index)))
    end)
  end)
  let result: map = native_gen/finish(module, native_source_subscriptions/result(builder, {
    "subject" -> subject, "relation" -> relation, "pattern" -> pattern, "mask" -> mask,
    "initial" -> initial, "resume" -> resume, "cursor" -> cursor, "capacity" -> capacity}))
  return result
end
verb native_source_subscriptions/definitions(input: map) -> map
  let needed: bool = false
  for program in input[:source_programs]
    let pc: int = 0
    for instruction in program[:analysis][:description][:code]
      if map_contains_key(program[:analysis][:reachable], pc) && instruction[0] == :BuiltinCall && instruction[2] == :subscribe_changes
        needed = true
      end
      pc = pc + 1
    end
  end
  if !needed
    return input
  end
  let module: map = input
  let result_type: list = [:Record, string_concat(input[:source_prefix], "_SubscriptionArgs")]
  module[:state] = native/record_type(module[:state], result_type[1], [
    ["status", :U64], ["shape", :U64], ["subject", :U64], ["relation", :U64], ["pattern", native_value/word()],
    ["mask", :U64], ["initial", :Bool], ["resume", :Bool], ["cursor", :U64], ["capacity", :U64]])[1]
  module = native_memory/declare(module, native_source_subscriptions/name(module, "find"), :U64, [
    ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow], ["node", native_kernel/pointer("RelationSchemaIndex"), :Gc],
    ["name", :U64, :Value], ["output", native_memory/pointer(:U64), :Borrow], ["budget", native_kernel/pointer("Budget"), :Borrow]], native_tasks/effects(), :Value, "")
  module = native_source_subscriptions/find_body(module)
  module = native_queries/operation(module, native_source_subscriptions/name(module, "decode"), result_type,
    [["code", native_tasks/pointer("CodeRef"), :Gc], ["arguments", native_value/word(), :Gc]])
  let result: map = native_source_subscriptions/decode_body(module)
  return result
end
verb native_source_subscriptions/items(builder: map, items: list) -> list
  let [values: map, expanded: map] = native_source/list_items(builder, items, true)
  let [arguments: map, rooted: map] = native_roots/retain(expanded, "subscription_arguments", values)
  let code: map = native_kernel/load_field(rooted, native_handlers/current(rooted), "code")
  let [decoded: map, called: map] = native_gen/bind(rooted, "subscription", native_gen/call(rooted,
    native_source_subscriptions/name(rooted, "decode"), [native_roots/worker(rooted), native_tasks/attempt(rooted), native_tasks/slot(rooted, "transaction"), code, arguments]))
  let status: map = native_gen/field(called, decoded, "status")
  let ready: map = native_gen/unless(called, native_kernel/absent(status), fn(failed) => native_roots/return_value(failed, status))
  let shape: map = native_gen/field(ready, decoded, "shape")
  let cases: list = []
  let ordinal: int = 1
  for message in native_source_subscriptions/errors()
    cases = [@cases, [native_source/number(ready, ordinal), fn(invalid) => native_builtins/error(invalid, message)]]
    ordinal = ordinal + 1
  end
  ready = native_gen/unless(ready, native_kernel/absent(shape), fn(invalid)
    return native_gen/switch(invalid, shape, cases, fn(unknown) => native_tasks/attempt_status(unknown, "schema"))
  end)
  let hub: map = native_source/service(ready, "mailboxes")
  ready = native_tasks/check(ready, native_gen/negate(native_kernel/absent(hub)), "closed")
  let parameters: list = [native_roots/worker(ready), native_tasks/attempt(ready), hub, native_query/cell(ready, arguments, native_gen/ref(ready, "zero"))]
  for field in ["subject", "relation", "pattern", "mask", "initial", "resume", "cursor", "capacity"]
    parameters = [@parameters, native_gen/field(ready, decoded, field)]
  end
  let [registered: map, staged: map] = native_gen/bind(ready, "subscription", native_gen/call(ready, "task_subscription_request", parameters))
  let outcome: map = native_gen/field(staged, registered, "status")
  ready = native_gen/when(staged, native_gen/equal(outcome, native_gen/ref(staged, "kernel_arity")),
    fn(invalid) => native_builtins/error(invalid, native_source_subscriptions/errors()[12]))
  ready = native_gen/when(ready, native_gen/equal(outcome, native_gen/ref(ready, "kernel_schema")),
    fn(invalid) => native_builtins/error(invalid, native_source_subscriptions/errors()[13]))
  ready = native_gen/unless(ready, native_kernel/absent(outcome), fn(failed) => native_roots/return_value(failed, outcome))
  return [native_gen/field(ready, registered, "capability"), ready]
end
verb native_source_subscriptions/cancel(builder: map, capability: map) -> list
  let ready: map = native_source/checked(builder, "task_subscription_cancel", [native_roots/worker(builder), native_tasks/attempt(builder), capability])
  return [native_source/literal(ready, [] {[]}), ready]
end
