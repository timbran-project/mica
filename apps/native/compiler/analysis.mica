// Analyse the Mica compiler's register descriptions before native lowering.
// Registers are compile-time names; the generated process does not interpret
// these instructions. Continuations capture only values live across a boundary.
verb native_source/operand_reads(operand) -> list
  native/ensure(is_kind(operand, :list) && len(operand) == 2, "source operand requires a tag and value")
  if operand[0] == :Splice
    let reads: list = native_source/operand_reads(operand[1])
    return reads
  end
  if operand[0] == :Constant
    return []
  end
  if operand[0] == :Register
    return [operand[1]]
  end
  native/ensure(false, "unsupported native source operand")
  return []
end

verb native_source/items_reads(items: list) -> list
  let reads: list = []
  for operand in items
    reads = [@reads, @native_source/operand_reads(operand)]
  end
  return reads
end

verb native_source/relation_reads(items: list, query: bool, holes: bool) -> list
  let reads: list = []
  for item in items
    native/ensure(is_kind(item, :list) && len(item) > 0, "invalid source relation argument")
    if item[0] == :Query
      native/ensure(query && len(item) == 2 && is_kind(item[1], :symbol), "invalid source query variable")
    elseif item[0] == :Hole
      native/ensure(holes && len(item) == 1, "invalid source relation hole")
    else
      reads = [@reads, @native_source/operand_reads(item)]
    end
  end
  return reads
end

verb native_source/relation_heading(heading) -> bool
  native/ensure(is_kind(heading, :list) && len(heading) <= 65535, "invalid source relation heading")
  let seen: map = {}
  for column in heading
    native/ensure(is_kind(column, :symbol), "source relation columns must be symbols")
    native/ensure(!map_contains_key(seen, column), "source relation heading has duplicate columns")
    seen[column] = true
  end
  return true
end
verb native_source/relation_cardinality(rows) -> bool
  native/ensure(is_kind(rows, :int) && rows >= 0 && rows <= 65535, "invalid source relation cardinality")
  return true
end

verb native_source/instruction(code: list, pc: int) -> map
  let instruction = code[pc]
  native/ensure(is_kind(instruction, :list) && len(instruction) > 0, "source instruction must be a nonempty list")
  let op = instruction[0]
  let widths: map = {:Load -> 3, :Move -> 3, :Unary -> 4, :Binary -> 5,
    :BuildList -> 3, :BuildMap -> 3, :BuildRelation -> 5, :RelationPattern -> 6, :RelationCell -> 4, :CollectionFieldAt -> 6, :BuildRange -> 4, :CollectionLen -> 3,
    :CollectionKeyAt -> 4, :CollectionValueAt -> 4, :SetIndex -> 5, :Abort -> 2, :Index -> 4, :CheckKind -> 5,
    :LoadFunction -> 7, :CallValue -> 4, :BuiltinCall -> 4, :Dispatch -> 4, :DynamicDispatch -> 4, :PositionalDispatch -> 4,
    :SpawnDispatch -> 5, :SpawnDispatchDynamic -> 5, :SpawnPositionalDispatch -> 5, :MailboxRecv -> 4,
    :ScanDynamic -> 4, :AssertDynamic -> 3, :RetractDynamic -> 3, :Return -> 2,
    :Branch -> 4, :Jump -> 2, :NormalizeError -> 5, :ErrorField -> 4, :Throw -> 2, :CommitValue -> 2, :SuspendValue -> 3, :Emit -> 3}
  native/ensure(map_contains_key(widths, op), string_concat("unsupported native source instruction ", to_literal(op)))
  native/ensure(len(instruction) == widths[op], "source instruction has the wrong operand count")
  let reads: list = []
  let writes: list = []
  let successors: list = [pc + 1]
  let boundary: bool = false
  if native/contains([:LoadFunction, :CallValue, :Load, :Move, :Unary, :Binary, :BuildList, :BuildMap, :BuildRelation, :ScanDynamic, :RelationPattern, :RelationCell, :CollectionFieldAt, :BuildRange, :CollectionLen,
      :CollectionKeyAt, :CollectionValueAt, :SetIndex, :Index, :NormalizeError, :ErrorField, :BuiltinCall,
      :Dispatch, :DynamicDispatch, :PositionalDispatch, :SpawnDispatch, :SpawnDispatchDynamic, :SpawnPositionalDispatch, :MailboxRecv, :CommitValue, :SuspendValue], op)
    writes = [instruction[1]]
  end
  if op == :Move || op == :CheckKind
    let source: int = instruction[1]
    if op == :Move
      source = instruction[2]
    end
    reads = [source]
  elseif op == :LoadFunction
    native/ensure(is_kind(instruction[2], :map) && map_contains_key(instruction[2], :code) && map_contains_key(instruction[2], :registers), "invalid source function description")
    native/ensure(is_kind(instruction[4], :int) && is_kind(instruction[5], :int) && instruction[4] >= 0 && instruction[4] <= instruction[5] && instruction[5] <= 65535, "invalid source function arity")
    native/ensure(is_kind(instruction[6], :bool), "invalid source function self binding")
    reads = native_source/items_reads(instruction[3])
    for capture in instruction[3]
      native/ensure(capture[0] != :Splice, "source function captures cannot be spliced")
    end
  elseif op == :CallValue
    reads = native_source/items_reads([instruction[2], @instruction[3]])
    boundary = true
  elseif op == :BuildRelation
    native_source/relation_heading(instruction[2])
    native_source/relation_cardinality(instruction[4])
    native/ensure(is_kind(instruction[3], :list), "source relation cells must be a list")
    native/ensure(len(instruction[3]) == len(instruction[2]) * instruction[4], "source relation cell count does not match its heading and cardinality")
    reads = native_source/items_reads(instruction[3])
    for cell in instruction[3]
      native/ensure(cell[0] != :Splice, "source relation cells cannot be spliced")
    end
  elseif op == :RelationPattern
    native_source/relation_heading(instruction[3])
    native_source/relation_cardinality(instruction[4])
    native/ensure(is_kind(instruction[5], :list), "source relation equalities must be a list")
    for equality in instruction[5]
      native/ensure(is_kind(equality, :list) && len(equality) == 2, "source relation equality requires a column and value")
      native/ensure(native/contains(instruction[3], equality[0]), "source relation equality names an unknown column")
    end
    reads = [instruction[2]]
  elseif op == :RelationCell
    native/ensure(is_kind(instruction[3], :symbol), "source relation column must be a symbol")
    reads = [instruction[2]]
  elseif op == :CollectionFieldAt
    native_source/relation_heading(instruction[4])
    native/ensure(native/contains(instruction[4], instruction[5]), "source iteration names an unknown column")
    reads = [instruction[2], instruction[3]]
  elseif op == :ErrorField
    reads = [instruction[2]]
  elseif op == :NormalizeError
    reads = native_source/operand_reads(instruction[2])
    for operand in [instruction[3], instruction[4]]
      if operand != none
        reads = [@reads, @native_source/operand_reads(operand)]
      end
    end
  elseif op == :CollectionLen
    reads = [instruction[2]]
  elseif op == :Unary
    reads = [instruction[3]]
  elseif op == :Binary
    reads = [instruction[3], instruction[4]]
  elseif op == :Index
    reads = [instruction[2], @native_source/operand_reads(instruction[3])]
  elseif op == :SetIndex
    reads = [instruction[2], @native_source/items_reads([instruction[3], instruction[4]])]
  elseif op == :CollectionKeyAt || op == :CollectionValueAt
    reads = [instruction[2], instruction[3]]
  elseif op == :BuildRange
    reads = native_source/operand_reads(instruction[2])
    if instruction[3] != none
      reads = [@reads, @native_source/operand_reads(instruction[3])]
    end
  elseif op == :BuildList
    reads = native_source/items_reads(instruction[2])
  elseif op == :BuildMap
    for pair in instruction[2]
      native/ensure(is_kind(pair, :list) && len(pair) == 2, "source map requires key/value pairs")
      if pair[0] == :Splice
        reads = [@reads, @native_source/operand_reads(pair[1])]
      else
        reads = [@reads, @native_source/items_reads(pair)]
      end
    end
  elseif op == :BuiltinCall
    reads = native_source/items_reads(instruction[3])
  elseif op == :ScanDynamic
    reads = native_source/relation_reads(instruction[3], true, true)
  elseif op == :AssertDynamic || op == :RetractDynamic
    reads = native_source/relation_reads(instruction[2], false, false)
  elseif op == :Dispatch || op == :SpawnDispatch
    reads = native_source/operand_reads(instruction[2])
    for pair in instruction[3]
      native/ensure(is_kind(pair, :list) && len(pair) == 2 && is_kind(pair[0], :symbol), "source dispatch requires named roles")
      reads = [@reads, @native_source/operand_reads(pair[1])]
    end
    boundary = true
  elseif op == :PositionalDispatch || op == :SpawnPositionalDispatch
    reads = native_source/items_reads([instruction[2], @instruction[3]])
    boundary = true
  elseif op == :DynamicDispatch || op == :SpawnDispatchDynamic
    reads = native_source/items_reads([instruction[2], instruction[3]])
    boundary = true
  elseif op == :MailboxRecv
    reads = native_source/operand_reads(instruction[2])
    if instruction[3] != none
      reads = [@reads, @native_source/operand_reads(instruction[3])]
    end
    boundary = true
  elseif op == :SuspendValue
    if instruction[2] != none
      reads = native_source/operand_reads(instruction[2])
    end
    boundary = true
  elseif op == :CommitValue
    boundary = true
  elseif op == :Return || op == :Abort || op == :Throw
    reads = native_source/operand_reads(instruction[1])
    successors = []
  elseif op == :Emit
    reads = native_source/items_reads([instruction[1], instruction[2]])
  elseif op == :Branch
    reads = [instruction[1]]
    successors = [instruction[2], instruction[3]]
  elseif op == :Jump
    successors = [instruction[1]]
  end
  if (op == :SpawnDispatch || op == :SpawnDispatchDynamic || op == :SpawnPositionalDispatch) && instruction[4] != none
    reads = [@reads, @native_source/operand_reads(instruction[4])]
  end
  return {:reads -> reads, :writes -> writes, :successors -> successors, :boundary -> boundary}
end

verb native_source/set(items: list) -> map
  let result: map = {}
  for item in items
    result[item] = true
  end
  return result
end

verb native_source/intersection(left: map, right: map) -> map
  let result: map = {}
  for item, present in left
    if map_contains_key(right, item)
      result[item] = true
    end
  end
  return result
end

verb native_source/analyse(description: map, parameters: int) -> map
  let code: list = description[:code]
  let registers: int = description[:registers]
  native/ensure(len(code) > 0 && parameters >= 0 && registers >= parameters, "invalid source register frame")
  let universe: map = {}
  let arguments: map = {}
  let reg: int = 0
  while reg < registers
    universe[reg] = true
    if reg < parameters
      arguments[reg] = true
    end
    reg = reg + 1
  end
  let exceptions: map = index_or(description, :exceptions, {})
  let instructions: map = {}
  let predecessors: map = {}
  for pc in 0..(len(code) - 1)
    let info: map = native_source/instruction(code, pc)
    for reg in [@info[:reads], @info[:writes]]
      native/ensure(is_kind(reg, :int) && reg >= 0 && reg < registers, "source register is outside its frame")
    end
    instructions[pc] = info
    predecessors[pc] = []
  end
  // Only reachable instructions contribute edges or require a fallthrough.
  // The frontend may append a default return after an explicit return.
  let reachable: map = {}
  let queue: map = {0 -> 0}
  let cursor: int = 0
  let count: int = 1
  while cursor < count
    let pc: int = queue[cursor]
    cursor = cursor + 1
    if map_contains_key(reachable, pc)
      continue
    end
    reachable[pc] = true
    let targets: list = [[target, false] for target in instructions[pc][:successors]]
    if map_contains_key(exceptions, pc)
      targets = [@targets, [exceptions[pc][0], true]]
    end
    for [target, exceptional] in targets
      native/ensure(is_kind(target, :int) && target >= 0 && target < len(code), "source branch or fallthrough leaves its program")
      predecessors[target] = [@predecessors[target], [pc, exceptional]]
      queue[count] = target
      count = count + 1
    end
  end
  let available: map = {}
  let before: map = {}
  let live: map = {}
  for pc in 0..(len(code) - 1)
    available[pc] = universe
    before[pc] = universe
    live[pc] = {}
  end
  let changed: bool = true
  while changed
    changed = false
    for pc in 0..(len(code) - 1)
      if !map_contains_key(reachable, pc)
        continue
      end
      let incoming: map = universe
      if pc == 0
        incoming = arguments
      end
      for [predecessor, exceptional] in predecessors[pc]
        let supplied: map = available[predecessor]
        if exceptional
          supplied = before[predecessor]
          supplied[exceptions[predecessor][1]] = true
        end
        incoming = native_source/intersection(incoming, supplied)
      end
      if incoming != before[pc]
        before[pc] = incoming
        changed = true
      end
      for reg in instructions[pc][:writes]
        incoming[reg] = true
      end
      if incoming != available[pc]
        available[pc] = incoming
        changed = true
      end
    end
  end
  for pc in 0..(len(code) - 1)
    if !map_contains_key(reachable, pc)
      continue
    end
    let incoming: map = before[pc]
    for reg in instructions[pc][:reads]
      native/ensure(map_contains_key(incoming, reg), string_concat("source register read before assignment at instruction ", to_literal(pc)))
    end
  end
  changed = true
  while changed
    changed = false
    let pc: int = len(code) - 1
    while pc >= 0
      if map_contains_key(reachable, pc)
        let info: map = instructions[pc]
        let needed: map = native_source/set(info[:reads])
        let defined: map = native_source/set(info[:writes])
        for successor in info[:successors]
          for reg, present in live[successor]
            if !map_contains_key(defined, reg)
              needed[reg] = true
            end
          end
        end
        if map_contains_key(exceptions, pc)
          let edge: list = exceptions[pc]
          for reg, present in live[edge[0]]
            if reg != edge[1]
              needed[reg] = true
            end
          end
        end
        if needed != live[pc]
          live[pc] = needed
          changed = true
        end
      end
      pc = pc - 1
    end
  end
  let captures: map = {}
  for pc in 0..(len(code) - 1)
    if map_contains_key(reachable, pc) && instructions[pc][:boundary]
      let saved: map = {}
      let defined: map = native_source/set(instructions[pc][:writes])
      for successor in instructions[pc][:successors]
        for reg, present in live[successor]
          if !map_contains_key(defined, reg)
            saved[reg] = true
          end
        end
      end
      captures[pc] = sort([reg for reg, present in saved])
    end
  end
  let handlers: map = {}
  for pc, edge in exceptions
    if map_contains_key(reachable, pc)
      handlers[edge[0]] = sort([reg for reg, present in live[edge[0]] if reg != edge[1]])
    end
  end
  return {:description -> description, :instructions -> instructions, :reachable -> reachable,
    :live -> live, :captures -> captures, :parameters -> parameters, :handlers -> handlers, :exceptions -> exceptions}
end
