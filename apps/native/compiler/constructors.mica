// Only the standard empty option omits a message. An empty relation with a
// different heading is still a type error.
verb native_source/optional_message(builder: map, supplied: map) -> list
  let absent: map = native_gen/field(builder, native_gen/call(builder, "value_equal", [supplied, native_source/literal(builder, none)]), "value")
  let [present: map, ready: map] = native_gen/bind(builder, "has_message", native_gen/negate(absent))
  ready = native_gen/when(ready, present, fn(message) => native_builtins/kind_check(message, supplied, "string"))
  return [present, ready]
end
verb native_source/construct_error(builder: map, args: list) -> list
  let ready: map = native_builtins/kind_check(builder, args[0], "error_code")
  let code: map = native_gen/convert(:U32, native_gen/expression(:U64, :Payload, [args[0]]))
  let present: map = native_gen/ref(ready, "false")
  let message: map = native_gen/zero(native_value/word())
  let payload: map = native_gen/zero(native_value/word())
  let has_payload: map = native_gen/ref(ready, "false")
  if len(args) >= 2
    let [has_message: map, checked: map] = native_source/optional_message(ready, args[1])
    ready = checked
    present = has_message
    message = args[1]
  end
  if len(args) == 3
    has_payload = native_gen/ref(ready, "true")
    payload = args[2]
  end
  let result: list = native_source/result(ready, "value_error", [native_roots/worker(ready), code, present, message, has_payload, payload], "oom")
  return result
end
verb native_source/error_items(builder: map, items: list) -> list
  if !native_source/spliced(items)
    if len(items) < 1 || len(items) > 3
      let failed: map = native_gen/unless(builder, native_gen/ref(builder, "false"),
        fn(invalid) => native_builtins/arity_failure(invalid, :error))
      return [native_gen/zero(native_value/word()), failed]
    end
    let result: list = native_source/construct_error(builder, native_source/operands(builder, items))
    return result
  end
  let [expanded: map, built: map] = native_source/list_items(builder, items, false)
  let [arguments: map, rooted: map] = native_roots/retain(built, "error_arguments", expanded)
  let count: map = native_query/width(rooted, arguments)
  let ready: map = native_tasks/check(rooted, native_gen/less(native_gen/ref(rooted, "zero"), count), "schema")
  ready = native_tasks/check(ready, native_gen/less(count, native_source/number(ready, 4)), "schema")
  let [output: map, retained: map] = native_roots/retain(ready, "constructed_error", native_gen/zero(native_value/word()))
  ready = retained
  for arity in [1, 2, 3]
    ready = native_gen/when(ready, native_gen/equal(count, native_source/number(ready, arity)), fn(selected)
      let args: list = [native_query/cell(selected, arguments, native_source/number(selected, index)) for index in 0..(arity - 1)]
      let [error: map, constructed: map] = native_source/construct_error(selected, args)
      return native_roots/store(constructed, output, error)
    end)
  end
  return [output, ready]
end
verb native_builtins/frob(builder: map, name: symbol, args: list) -> list
  let value: map = args[0]
  if name == :is_frob
    return [native_gen/call(builder, "value_bool", [native_access/kind(builder, value, "frob")]), builder]
  end
  if name == :frob
    let ready: map = native_builtins/kind_check(builder, value, "identity")
    let result: list = native_source/result(ready, "value_frob", [native_roots/worker(ready), native_gen/expression(:U64, :Payload, [value]), args[1]], "oom")
    return result
  end
  let ready: map = builder
  if name == :frob_delegate
    ready = native_gen/unless(ready, native_access/kind(ready, value, "frob"),
      fn(invalid) => native_source/value_error(invalid, E_TYPE, "frob_delegate expected a frob", value))
  else
    ready = native_builtins/kind_check(ready, value, "frob")
  end
  let header: map = native_gen/expression(native_memory/record_pointer("HeapFrob"), :UnpackPointer, [value])
  if name == :frob_value
    return [native_kernel/load_field(ready, header, "value"), ready]
  end
  let result: list = native_source/result(ready, "value_identity", [native_kernel/load_field(ready, header, "delegate")], "schema")
  return result
end

verb native_builtins/symbol_name(module: map) -> string
  return string_concat(module[:source_prefix], "_to_symbol")
end
verb native_builtins/symbol_definition(input: map) -> map
  let module: map = native_memory/declare(input, native_builtins/symbol_name(input), :U64, [
    ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow], ["attempt", native_tasks/pointer("Attempt"), :Borrow],
    ["transaction", native_kernel/pointer("Transaction"), :Borrow], ["symbols", native_memory/record_pointer("SymbolTable"), :Borrow],
    ["input", native_value/word(), :Gc], ["output", native_memory/record_pointer("MemoryRoot"), :Borrow]], native_tasks/effects(), :Value, "")
  let builder: map = native_queries/budget_scope(native_gen/context(module, native_builtins/symbol_name(module)))
  let value: map = native_roots/ref(builder, "input")
  let output: map = native_gen/ref(builder, "output")
  builder = native_gen/when(builder, native_access/kind(builder, value, "symbol"), fn(symbol)
    let stored: map = native_gen/do_call(symbol, "value_root_set", [output, value])
    return native_roots/return_value(stored, native_gen/ref(stored, "kernel_ok"))
  end)
  builder = native_query/check(builder, native_access/kind(builder, value, "string"), "schema")
  let symbols: map = native_gen/ref(builder, "symbols")
  builder = native_query/check(builder, native_gen/negate(native_kernel/absent(symbols)), "closed")
  let [mutex: map, with_mutex: map] = native_gen/bind(builder, "mutex", native_kernel/load_field(builder, symbols, "mutex"))
  builder = native_query/check(with_mutex, native_gen/negate(native_kernel/absent(mutex)), "closed")
  // Waiting tasks reach safepoints with the text rooted. Once locked, the
  // interner's controls check limits and cancellation without relocation.
  builder = native_gen/while_loop(builder, native_gen/negate(native_gen/call(builder, "mutex_try_lock", [mutex])), fn(waiting)
    let charged: map = native_query/charge(waiting, native_gen/ref(waiting, "one"), native_gen/ref(waiting, "zero"))
    return native_roots/poll(charged)
  end)
  let control: map = native_kernel/load_field(builder, native_roots/worker(builder), "control")
  let [interned: map, called: map] = native_gen/bind(builder, "interned", native_gen/call(builder, "symbol_intern_locked", [symbols,
    native_gen/freeze(native_value/string_field(builder, value, "data")), native_value/string_field(builder, value, "length"), control]))
  builder = native_gen/do_call(called, "mutex_unlock", [mutex])
  let ready: map = native_query/check(builder, native_gen/field(builder, interned, "ok"), "oom")
  let [symbol: map, encoded: map] = native_query/value(ready, "value_symbol", [native_gen/convert(:U32, native_gen/field(ready, interned, "number"))])
  builder = native_gen/do_call(encoded, "value_root_set", [output, symbol])
  let result: map = native_gen/finish(module, native_roots/return_value(builder, native_gen/ref(builder, "kernel_ok")))
  return result
end
verb native_builtins/symbol(builder: map, value: map) -> list
  let [symbols: map, with_symbols: map] = native_gen/bind(builder, "symbols", native_gen/zero(native_memory/record_pointer("SymbolTable")))
  let ready: map = native_gen/when(with_symbols, native_gen/negate(native_kernel/absent(native_tasks/attempt_field(with_symbols, "runtime"))),
    fn(attached) => native_gen/assign(attached, symbols, native_source/service(attached, "symbols")))
  let [output: map, rooted: map] = native_roots/retain(ready, "symbol", native_gen/zero(native_value/word()))
  ready = native_source/checked(rooted, native_builtins/symbol_name(rooted), [native_roots/worker(rooted), native_tasks/attempt(rooted),
    native_tasks/slot(rooted, "transaction"), symbols, value, output[:scope_root]])
  return [output, ready]
end
