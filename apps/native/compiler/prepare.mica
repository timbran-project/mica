// Map keys use exact structural ordering, including distinct numeric kinds.
// Keep first-use order separately: lookup order must not change constant slots.
verb native_source/literal_pool(initial: list) -> map
  let pool: map = {:values -> [], :index -> {}}
  for value in initial
    pool = native_source/pool(pool, value)
  end
  return pool
end
verb native_source/pool(input: map, value) -> map
  if map_contains_key(input[:index], value)
    return input
  end
  let pool: map = input
  pool[:index][value] = len(pool[:values])
  pool[:values] = [@pool[:values], value]
  return pool
end
verb native_source/pool_operands(values: map, operands: list) -> map
  let pool: map = values
  for operand in operands
    if operand[0] == :Hole
      continue
    end
    if operand[0] == :Splice
      pool = native_source/pool_operands(pool, [operand[1]])
    elseif operand[0] == :Constant
      pool = native_source/pool(pool, operand[1])
    end
  end
  return pool
end
verb native_source/dead_load(analysis: map, pc: int) -> bool
  let instruction: list = analysis[:description][:code][pc]
  if instruction[0] != :Load && instruction[0] != :Move
    return false
  end
  for successor in analysis[:instructions][pc][:successors]
    if map_contains_key(analysis[:live][successor], instruction[1])
      return false
    end
  end
  return true
end

verb native_source/program_literals(analysis: map, initial: map) -> map
  let pool: map = initial
  let code: list = analysis[:description][:code]
  let pc: int = 0
  while pc < len(code)
    if !map_contains_key(analysis[:reachable], pc) || native_source/dead_load(analysis, pc)
      pc = pc + 1
      continue
    end
    let instruction: list = code[pc]
    let op: symbol = instruction[0]
    if op == :Load
      pool = native_source/pool(pool, instruction[2])
    elseif op == :CheckKind
      pool = native_source/pool(pool, native_source/kind_prefix(instruction[2], instruction[3], instruction[4]))
    elseif op == :BuildRelation
      for column in instruction[2]
        pool = native_source/pool(pool, column)
      end
      pool = native_source/pool_operands(pool, instruction[3])
    elseif op == :RelationPattern
      for column in instruction[3]
        pool = native_source/pool(pool, column)
      end
      for [column, value] in instruction[5]
        pool = native_source/pool(pool, column)
        pool = native_source/pool(pool, value)
      end
    elseif op == :RelationCell || op == :CollectionFieldAt
      pool = native_source/pool(pool, E_MATCH)
      if op == :RelationCell
        pool = native_source/pool(pool, instruction[3])
        pool = native_source/pool(pool, "relation cell load requires a matched row")
      else
        for column in [@instruction[4], instruction[5]]
          pool = native_source/pool(pool, column)
        end
        for value in [E_INDEX, "collection index is missing or invalid", "collection row does not match the loop pattern"]
          pool = native_source/pool(pool, value)
        end
      end
    elseif op == :Unary && instruction[2] == :Neg
      pool = native_source/pool(pool, E_ARITH)
      pool = native_source/pool(pool, "invalid unary arithmetic")
    elseif op == :Binary && map_contains_key(native_source/arithmetic_operations(), instruction[2])
      let spec: list = native_source/arithmetic_operations()[instruction[2]]
      pool = native_source/pool(pool, E_ARITH)
      pool = native_source/pool(pool, spec[1])
      if instruction[2] == :Div || instruction[2] == :Rem
        pool = native_source/pool(pool, E_DIV)
        pool = native_source/pool(pool, spec[2])
      end
    elseif op == :ScanDynamic
      pool = native_source/pool_operands(pool, instruction[3])
      let heading: list = []
      for item in instruction[3]
        if item[0] == :Query && !native/contains(heading, item[1])
          heading = [@heading, item[1]]
        end
      end
      pool = native_source/pool(pool, heading)
    elseif op == :BuildList || op == :AssertDynamic || op == :RetractDynamic || op == :ReplaceFunctional
      pool = native_source/pool_operands(pool, instruction[2])
      if op == :BuildList
        pool = native_source/pool(pool, "list splice requires a list")
      end
    elseif op == :LoadFunction
      pool = native_source/pool_operands(pool, instruction[3])
    elseif op == :CallValue
      pool = native_source/pool_operands(pool, [instruction[2], @instruction[3]])
    elseif op == :BuiltinCall
      pool = native_source/pool_operands(pool, instruction[3])
      pool = native_source/pool(pool, "list splice requires a list")
      if instruction[2] == :subscribe_changes
        for value in native_source_subscriptions/literals()
          pool = native_source/pool(pool, value)
        end
      elseif instruction[2] == :cancel_subscription
        for value in [E_INVARG, "cancel_subscription expects one capability"]
          pool = native_source/pool(pool, value)
        end
      end
      if instruction[2] == :words || instruction[2] == :parse_ordinal
        for value in native_command_text/literals(instruction[2])
          pool = native_source/pool(pool, value)
        end
      end
      if instruction[2] == :to_literal
        for value in [E_INVARG, "to_literal expects one value", "this value does not have a source literal"]
          pool = native_source/pool(pool, value)
        end
      end
      if instruction[2] == :from_literal
        for value in native_read/literals()
          pool = native_source/pool(pool, value)
        end
      end
      if instruction[2] == :error
        pool = native_source/pool(pool, none)
      elseif instruction[2] == :frob_delegate
        pool = native_source/pool(native_source/pool(pool, E_TYPE), "frob_delegate expected a frob")
      end
      if instruction[2] == :index_or || instruction[2] == :map_pairs
        pool = native_source/pool(pool, E_INDEX)
        pool = native_source/pool(pool, "collection index is missing or invalid")
      elseif instruction[2] == :relation_from_rows
        for value in [E_INVARG, "relation_from_rows expects a heading and a list of rows"]
          pool = native_source/pool(pool, value)
        end
        for [code, message] in native_builtins/relation_errors()
          pool = native_source/pool(native_source/pool(pool, code), message)
        end
      elseif instruction[2] == :is_builtin
        for value in [E_INVARG, E_TYPE, "is_builtin expects one symbol", "is_builtin expects a symbol", @native_builtins/names()]
          pool = native_source/pool(pool, value)
        end
      elseif instruction[2] == :is_kind
        for value in [E_INVARG, "is_kind expects a value and kind symbol", "expected a symbol", "unknown value kind"]
          pool = native_source/pool(pool, value)
        end
        for spec in native_value/kinds()
          pool = native_source/pool(pool, to_symbol(spec[0]))
        end
      end
    elseif native/contains([:Index, :SetIndex, :CollectionKeyAt, :CollectionValueAt], op)
      pool = native_source/pool(pool, E_INDEX)
      pool = native_source/pool(pool, "collection index is missing or invalid")
      if op == :Index || op == :SetIndex
        pool = native_source/pool_operands(pool, [instruction[3]])
      end
      if op == :SetIndex
        pool = native_source/pool_operands(pool, [instruction[4]])
      end
    elseif op == :ErrorField
      for literal in [none, :value, "error field access requires an error or error code"]
        pool = native_source/pool(pool, literal)
      end
    elseif op == :NormalizeError
      if instruction[3] != none
        pool = native_source/pool(pool, none)
      end
      for operand in [instruction[2], instruction[3], instruction[4]]
        if operand != none
          pool = native_source/pool_operands(pool, [operand])
        end
      end
    elseif op == :BuildRange
      pool = native_source/pool_operands(pool, [instruction[2]])
      if instruction[3] != none
        pool = native_source/pool_operands(pool, [instruction[3]])
      end
    elseif op == :BuildMap
      for pair in instruction[2]
        if pair[0] == :Splice
          pool = native_source/pool_operands(pool, [pair[1]])
        else
          pool = native_source/pool_operands(pool, pair)
        end
      end
    elseif op == :PositionalDispatch || op == :SpawnPositionalDispatch
      pool = native_source/pool_operands(pool, [instruction[2], @instruction[3]])
    elseif op == :DynamicDispatch || op == :SpawnDispatchDynamic
      pool = native_source/pool_operands(pool, [instruction[2], instruction[3]])
    elseif op == :Dispatch || op == :SpawnDispatch
      pool = native_source/pool_operands(pool, [instruction[2]])
      for role in instruction[3]
        pool = native_source/pool(pool, role[0])
        pool = native_source/pool_operands(pool, [role[1]])
      end
    elseif op == :MailboxRecv
      pool = native_source/pool_operands(pool, [instruction[2]])
      if instruction[3] != none
        pool = native_source/pool_operands(pool, [instruction[3]])
      end
    elseif op == :Emit
      pool = native_source/pool_operands(pool, [instruction[1], instruction[2]])
    elseif op == :Return || op == :Abort || op == :Throw
      pool = native_source/pool_operands(pool, [instruction[1]])
    end
    if op == :BuiltinCall && native/contains([:to_int, :to_float, :parse_int, :parse_float], instruction[2])
      for error in native_numeric/errors(instruction[2])
        pool = native_source/pool(native_source/pool(pool, error[0]), error[1])
      end
    end
    if op == :BuiltinCall && native/contains([:string_span, :string_find_any], instruction[2])
      pool = native_source/pool(native_source/pool(pool, E_INDEX), string_concat(native_source/symbol_text(instruction[2]), " start is out of range"))
    end
    if op == :BuiltinCall && native/contains([:string_concat, :string_join, :string_from_chars, :string_slice], instruction[2])
      pool = native_source/pool(pool, "")
      if instruction[2] == :string_slice
        pool = native_source/pool(native_source/pool(pool, E_INDEX), "string_slice bounds are out of range")
      end
    end
    if native/contains([:SuspendValue, :MailboxRecv, :SpawnDispatch, :SpawnDispatchDynamic, :SpawnPositionalDispatch], op)
      pool = native_source/pool(native_source/pool(pool, E_INVARG), "invalid suspend duration")
      let duration = instruction[2]
      if op == :MailboxRecv
        duration = instruction[3]
      elseif op != :SuspendValue
        duration = instruction[4]
      end
      if duration != none
        pool = native_source/pool_operands(pool, [duration])
      end
    end
    pc = pc + 1
  end
  return pool
end
verb native_source/literal_description(value, identities: map) -> map
  if is_kind(value, :identity)
    native/ensure(map_contains_key(identities, value), string_concat("unlinked native identity: ", to_literal(value)))
    let target = identities[value]
    native/ensure(is_kind(target, :int) && target >= 0, "native identity binding must be a nonnegative integer")
    return {:kind -> :Identity, :value -> target}
  end
  if value == [] {[]}
    return {:kind -> :Unit}
  end
  if value == none
    return {:kind -> :Relation, :arity -> 1, :length -> 0,
      :children -> [native_source/literal_description(:value, identities)]}
  end
  if value == [] {}
    return {:kind -> :Relation, :arity -> 0, :length -> 0, :children -> []}
  end
  if is_kind(value, :list)
    return {:kind -> :List, :children -> [native_source/literal_description(item, identities) for item in value]}
  end
  if is_kind(value, :map)
    let children: list = []
    for key, item in value
      children = [@children, native_source/literal_description(key, identities), native_source/literal_description(item, identities)]
    end
    return {:kind -> :Map, :children -> children}
  end
  if is_kind(value, :relation) && len(value) > 0
    let heading: list = [key for key, item in value[0]]
    let children: list = [native_source/literal_description(key, identities) for key in heading]
    for row in value
      for key in heading
        children = [@children, native_source/literal_description(row[key], identities)]
      end
    end
    return {:kind -> :Relation, :arity -> len(heading), :length -> len(value), :children -> children}
  end
  let kinds: list = [[:bool, :Bool], [:int, :Integer], [:float, :Float], [:string, :String], [:bytes, :Bytes]]
  for [source, target] in kinds
    if is_kind(value, source)
      return {:kind -> target, :value -> value}
    end
  end
  if is_kind(value, :symbol)
    return {:kind -> :Symbol, :value -> native_source/symbol_text(value)}
  end
  if is_kind(value, :error_code)
    return {:kind -> :ErrorCode, :value -> to_literal(value)}
  end
  native/ensure(false, string_concat("unsupported native source constant: ", to_literal(value)))
  return {}
end

// Resolve bootstrap relation identities by name, then replace them with explicit
// native catalogue IDs. A bootstrap identity is never a generated literal.
verb native_source/link_relations(description: map, relations: map) -> map
  let names: map = {}
  for row in RelationName(?relation, ?name)
    names[row[:relation]] = row[:name]
  end
  let code: list = []
  for instruction in description[:code]
    if native/contains([:ScanDynamic, :AssertDynamic, :RetractDynamic, :ReplaceFunctional], instruction[0])
      let position: int = 1
      if instruction[0] == :ScanDynamic
        position = 2
      end
      native/ensure(map_contains_key(names, instruction[position]), "source relation identity has no catalogue name")
      let name: symbol = names[instruction[position]]
      native/ensure(map_contains_key(relations, name), string_concat("unlinked native relation: ", to_literal(name)))
      instruction[position] = relations[name]
    end
    code = [@code, instruction]
  end
  let result: map = description
  result[:code] = code
  return result
end

// The literal spelling preserves arbitrary symbol names, including escapes.
verb native_source/symbol_text(value: symbol) -> string
  let spelling: string = to_literal(value)
  let name: string = string_slice(spelling, 1, len(spelling))
  if string_starts_with(name, "\"")
    let parsed: relation = from_literal(name)
    native/ensure(parsed[0][:case] == :ok && is_kind(parsed[0][:value], :string), "invalid quoted symbol spelling")
    let result: string = parsed[0][:value]
    return result
  end
  return name
end

// Resolve the frontend output, collect literals, and plan continuation regions.
verb native_source/prepare_module(input: map, prefix: string, emitted: map, relations: map, identities: map, method_ids: list) -> map
  native/ensure(len(method_ids) == len(emitted[:methods]), "native module requires identities for every definition")
  let descriptions: list = [[emitted[:entry], 0, string_concat(prefix, "_entry")]]
  let pool: map = native_source/literal_pool([E_TYPE, E_RANGE, [] {[]}, :dispatch/unrestricted, :required, @[spec[0] for spec in native_value/kinds()]])
  let numbers: list = []
  let index: int = 0
  for definition in emitted[:methods]
    let position: int = 0
    pool = native_source/pool(pool, definition[:selector])
    for parameter in definition[:parameters]
      native/ensure(parameter[:restriction] == :dispatch/unrestricted || is_kind(parameter[:restriction], :identity),
        "native source parameter restriction must be a prototype identity")
      pool = native_source/pool(pool, parameter[:restriction])
      pool = native_source/pool(pool, parameter[:mode])
      pool = native_source/pool(pool, parameter[:default])
      pool = native_source/pool(pool, parameter[:role])
      pool = native_source/pool(pool, position)
      position = position + 1
    end
    native/ensure(len(method_ids[index]) == 2, "native definition requires definition and program identities")
    numbers = [@numbers, @method_ids[index]]
    descriptions = [@descriptions, [definition[:program], len(definition[:parameters]), string_concat(prefix, "_method_", to_literal(index))]]
    index = index + 1
  end
  let programs: list = []
  let maximum: int = 64
  let functions: list = []
  index = 0
  while index < len(descriptions)
    let [description: map, parameters: int, name: string] = descriptions[index]
    let lifted: list = []
    for instruction in description[:code]
      if instruction[0] == :LoadFunction
        let function_index: int = len(functions)
        let function_name: string = string_concat(prefix, "_function_", to_literal(function_index))
        let child: map = instruction[2]
        child[:native_index] = function_index
        instruction[2] = child
        let parameter_count: int = len(instruction[3]) + 1
        if instruction[6]
          parameter_count = parameter_count + 1
        end
        descriptions = [@descriptions, [child, parameter_count, function_name]]
        functions = [@functions, [function_name, instruction[4], instruction[5], instruction[6]]]
        numbers = [@numbers, instruction[4], instruction[5]]
      end
      lifted = [@lifted, instruction]
    end
    description[:code] = lifted
    index = index + 1
    let linked: map = native_exceptions/lower(native_source/link_relations(description, relations))
    for instruction in linked[:code]
      if instruction[0] == :BuildRelation || instruction[0] == :RelationPattern
        numbers = [@numbers, instruction[4]]
      end
    end
    let analysis: map = native_source/analyse(linked, parameters)
    programs = [@programs, {:analysis -> analysis, :regions -> native_source/regions(analysis), :name -> name}]
    pool = native_source/program_literals(analysis, pool)
    if len(linked[:code]) > maximum
      maximum = len(linked[:code])
    end
    if linked[:registers] > maximum
      maximum = linked[:registers]
    end
  end
  if len(functions) > maximum
    maximum = len(functions)
  end
  if len(pool[:values]) > maximum
    maximum = len(pool[:values])
  end
  for name, id in relations
    numbers = [@numbers, id]
  end
  for number in 0..maximum
    numbers = [@numbers, number]
  end
  let module: map = input
  module[:source_prefix] = prefix
  module[:source_literals] = pool[:values]
  module[:source_literal_index] = pool[:index]
  module[:source_functions] = functions
  module[:source_programs] = programs
  module[:source_method_ids] = method_ids
  for number in numbers
    native/ensure(is_kind(number, :int) && number >= 0, "native catalogue and index constants must be nonnegative integers")
    let [name: string, ready: map] = native_rules/source_number(module, number)
    module = ready
  end
  let prepared: list = []
  index = 0
  for value in pool[:values]
    let [literal: map, ready: map] = native_literal/prepare(module, string_concat(prefix, "_literal_", to_literal(index)), native_source/literal_description(value, identities))
    prepared = [@prepared, literal]
    module = ready
    index = index + 1
  end
  module[:source_prepared] = prepared
  return module
end
