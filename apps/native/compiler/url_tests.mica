let encoded = []
for text in ["", "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.~",
    " /?#[]@!$&'()*+,;=:%", "é世界🙂", "\0\t\r\n", string_slice("xé+y", 1, 3)]
  let escaped = url_encode_component(text)
  encoded = [@encoded, [escaped, url_decode_component(escaped)]]
end
let decoded = []
for text in ["", "a+b%2bc%2Bd", "%00%01%7f", "%c3%a9%E4%B8%96%F0%9F%99%82", "é%20世界", "%25FF",
    "%F4%8F%BF%BF", "%ED%9F%BF", "%EE%80%80", "%C2%80", "%E0%A0%80", "%F0%90%80%80"]
  decoded = [@decoded, url_decode_component(text)]
end
return [encoded, decoded, url_encode_component(@["a+b"]), url_decode_component(@["a+b"])]
