// Region frames root source registers and restore the committed continuation.
// Entry wrappers perform tail transfers only after the rooted body has returned.
verb native_source/region_registers(program: map, region: map) -> map
  let needed: map = {}
  for pc in region[:pcs]
    if map_contains_key(program[:captures], pc)
      for reg in program[:captures][pc]
        needed[reg] = true
      end
    end
    if map_contains_key(program[:exceptions], pc)
      for reg in program[:handlers][program[:exceptions][pc][0]]
        needed[reg] = true
      end
    end
    if !native_source/dead_load(program, pc)
      for reg in [@program[:instructions][pc][:reads], @program[:instructions][pc][:writes]]
        needed[reg] = true
      end
    end
  end
  return needed
end

verb native_source/restore_frame(input: map, program: map, region: map) -> map
  let builder: map = input
  if region[:pop_handler]
    let current: map = native_handlers/current(builder)
    let handler: map = native_kernel/load_field(builder, current, "handlers")
    builder = native_handlers/replace_current(builder, current, {"handlers" -> native_kernel/load_field(builder, handler, "next")})
  end
  let registers: map = {}
  let needed: map = native_source/region_registers(program, region)
  for reg in sort([reg for reg, present in needed])
    let [root: map, ready: map] = native_roots/retain(builder, string_concat("r", to_literal(reg)), native_gen/zero(native_value/word()))
    registers[reg] = root
    builder = ready
  end
  builder[:source_registers] = registers
  let position: int = 0
  for reg in region[:restore]
    if map_contains_key(needed, reg)
      let environment: map = native_kernel/load_field(builder, native_handlers/current(builder), "environment")
      builder = native_source/assign(builder, reg, native_query/cell(builder, environment, native_source/number(builder, position)))
    end
    position = position + 1
  end
  if region[:input] >= 0 && map_contains_key(needed, region[:input])
    builder = native_source/assign(builder, region[:input], native_kernel/load_field(builder, native_handlers/current(builder), "input"))
  end
  return builder
end

verb native_source/capture_image(builder: map, entry: string, registers: list) -> list
  let values: list = [native_source/register(builder, register) for register in registers]
  let [retained: map, rooted: map] = native_source/rooted_list(builder, "environment", values)
  let [image: map, allocated: map] = native_roots/retain(rooted, "continuation", native_handlers/copy_image(rooted, native_handlers/current(rooted), {
    "entry" -> native_source/entry(entry), "environment" -> retained, "input" -> native_gen/zero(native_value/word())}))
  let checked: map = native_tasks/check(allocated, native_gen/negate(native_kernel/absent(image)), "oom")
  return [image, checked]
end
verb native_source/capture(builder: map, entry: string, registers: list) -> map
  let [image: map, captured: map] = native_source/capture_image(builder, entry, registers)
  let result: map = native_roots/store(captured, native_handlers/current(captured), image)
  return result
end

verb native_source/invoke(builder: map, selector: map, supplied: map, continuation: string, captures: list) -> map
  let ready: map = native_tasks/check(builder, native_gen/negate(native_kernel/absent(native_tasks/attempt_field(builder, "runtime"))), "closed")
  let configuration: map = native_source/service(ready, "dispatch")
  ready = native_tasks/check(ready, native_gen/negate(native_kernel/absent(configuration)), "closed")
  ready = native_tasks/check(ready, native_gen/equal(native_kernel/load_field(ready, configuration, "heap"), native_kernel/load_field(ready, native_roots/worker(ready), "heap")), "schema")
  let root: map = native_gen/field(ready, configuration, "prototypes")[:pointer]
  ready = native_tasks/check(ready, native_gen/negate(native_kernel/absent(native_kernel/load_field(ready, root, "registration"))), "closed")
  ready = native_source/arm_handler(ready)
  let [image: map, captured: map] = native_source/capture_image(ready, continuation, captures)
  let arguments: list = [native_roots/worker(captured), native_tasks/attempt(captured), native_gen/field(captured, configuration, "vocabulary")[:pointer]]
  for name in ["selectors", "parameters", "delegates", "programs"]
    arguments = [@arguments, native_kernel/load_field(captured, configuration, name)]
  end
  ready = native_calls/invoke_accounted(captured, [@arguments, native_dispatch/prototypes(captured, configuration), selector, supplied], image)
  let result: map = native_tasks/attempt_status(ready, "ok")
  return result
end
verb native_source/call_arguments(builder: map, instruction: list) -> list
  if instruction[0] == :DynamicDispatch || instruction[0] == :SpawnDispatchDynamic
    let value: map = native_source/operand(builder, instruction[3])
    let checked: map = native_tasks/check(builder, native_gen/equal(native_gen/expression(:U8, :Tag, [value]), native_gen/ref(builder, "tag_map")), "schema")
    return [value, checked]
  end
  if instruction[0] == :PositionalDispatch || instruction[0] == :SpawnPositionalDispatch
    let [value: map, ready: map] = native_source/list_items(builder, instruction[3], false)
    let result: list = native_roots/retain(ready, "arguments", value)
    return result
  end
  let fields: list = [[native_source/literal(builder, role[0]), native_source/operand(builder, role[1])] for role in instruction[3]]
  let [roles: map, built: map] = native_literal/map(builder, fields, fn(failed) => native_tasks/attempt_status(failed, "oom"))
  let result: list = native_roots/retain(built, "arguments", roles)
  return result
end

verb native_source/declare_entries(input: map) -> map
  let module: map = input
  let attempt: list = ["attempt", native_tasks/pointer("Attempt"), :Borrow]
  let worker: list = ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow]
  for program in module[:source_programs]
    let index: int = 0
    for region in program[:regions]
      let name: string = string_concat(program[:name], "_", to_literal(index))
      module = native/declare_function(module, name, :U64, [attempt], [], native_tasks/effects(), :Value, "")
      module = native/execution_function(module, name, :Tail)
      module = native_memory/declare(module, string_concat(name, "_body"), :U64, [attempt, worker], native_tasks/effects(), :Value, "")
      module = native_source/describe_region(module, program[:analysis], region, name)
      index = index + 1
    end
  end
  return module
end

verb native_source/entry_body(input: map, name: string) -> map
  let module: map = input
  let builder: map = native_tasks/entry_context(module, name)
  let [status: map, called: map] = native_gen/bind(builder, "status", native_gen/call(builder, string_concat(name, "_body"), [native_tasks/attempt(builder), native_tasks/attempt_field(builder, "worker")]))
  builder = native_gen/unless(called, native_kernel/absent(status), fn(failed) => native_gen/return_value(failed, status))
  // Every path either sets a task boundary or selects another image. Transfer
  // only after the region body has unlinked its native roots.
  builder = native_gen/when(builder, native_kernel/absent(native_tasks/attempt_field(builder, "boundary")), fn(caller) => native_handlers/transfer(caller))
  module = native_gen/finish(module, native_gen/return_value(builder, native_gen/ref(builder, "kernel_ok")))
  return module
end

verb native_source/complete(builder: map, value: map) -> map
  let result: map = native_source/return_call(builder, "task_return", [native_roots/worker(builder), native_tasks/attempt(builder), value])
  return result
end
verb native_source/spawn_task(builder: map, selector: map, supplied: map, delay: map, continuation: string, captures: list) -> map
  let [retained: map, rooted: map] = native_roots/retain(builder, "arguments", supplied)
  let ready: map = native_source/capture(rooted, continuation, captures)
  let result: map = native_source/return_call(ready, "task_spawn_request", [native_roots/worker(ready), native_tasks/attempt(ready),
    selector, retained, delay])
  return result
end
verb native_source/receive(builder: map, receivers: map, timeout: map, continuation: string, captures: list) -> map
  // Source operands reload their frame roots after replacing the current image.
  let ready: map = native_source/capture(builder, continuation, captures)
  let result: map = native_source/return_call(ready, "task_mailbox_request", [native_source/service(ready, "mailboxes"),
    native_roots/worker(ready), native_tasks/attempt(ready), receivers, timeout])
  return result
end

verb native_source/suspend_task(builder: map, timeout: map, continuation: string, captures: list) -> map
  let ready: map = native_source/capture(builder, continuation, captures)
  let result: map = native_source/return_call(ready, "task_suspend_request", [native_roots/worker(ready), native_tasks/attempt(ready), timeout])
  return result
end
verb native_source/commit_task(builder: map, continuation: string, captures: list) -> map
  let ready: map = native_source/capture(builder, continuation, captures)
  ready = native_handlers/replace_current(ready, native_handlers/current(ready), {"input" -> native_source/literal(ready, [] {[]})})
  let result: map = native_source/return_call(ready, "task_request", [native_tasks/attempt(ready), native_gen/ref(ready, "task_boundary_continue")])
  return result
end

verb native_source/describe_region(input: map, program: map, region: map, name: string) -> map
  let module: map = input
  let origin: string = string_concat("Mica basic blocks ", to_literal([block[:pcs] for block in region[:blocks]]))
  let purpose: string = "Initial entry"
  if region[:input] >= 0
    purpose = string_concat("Resume with delivered result in r", to_literal(region[:input]))
  end
  purpose = string_concat(purpose, "; restore registers ", to_literal(region[:restore]))
  let captures: list = [[pc, program[:captures][pc]] for pc in region[:pcs] if map_contains_key(program[:captures], pc)]
  purpose = string_concat(purpose, "; suspension captures ", to_literal(captures))
  module[:state] = native/annotate(module[:state], module[:functions][name], :Purpose, purpose)
  module[:state] = native/annotate(module[:state], module[:functions][string_concat(name, "_body")], :Source, origin)
  return module
end
