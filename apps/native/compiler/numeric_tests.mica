let conversions = []
for value in [0, 42, -42, 16777217, 36028797018963967, -36028797018963968,
    0.0, -0.0, 42.0, -42.0, 1.5, 36028797018963968.0, -36028797018963968.0,
    3.4028235e38, -3.4028235e38, true, "42", [], {}, none]
  try
    conversions = [@conversions, [:int, to_int(value)]]
  catch error
    conversions = [@conversions, [error.code, error.message, error.value]]
  end
  try
    conversions = [@conversions, [:float, to_float(value)]]
  catch error
    conversions = [@conversions, [error.code, error.message, error.value]]
  end
end
let parsed = []
for text in ["0", "-0", "000042", "-00042", "36028797018963967", "-36028797018963968",
    "36028797018963968", "-36028797018963969", "99999999999999999999999999999999999999",
    "99999999999999999999999999999999999999x", "", "-", "+1", " 1", "1 ", "1.0", "1e3",
    "1\0", "١", "é", "--1", "1-1", 42, false, none, string_slice("x-123y", 1, 5)]
  try
    parsed = [@parsed, parse_int(text)]
  catch error
    parsed = [@parsed, [error.code, error.message, error.value]]
  end
end
let floats = []
for text in ["0", "-0", "+0", "1", "+1.25", "1.", ".5", "-.5", "1e0", "1E+2", "1e-2",
    "1.000000059604644775390625", "1.000000178813934326171875", "16777217", "16777219",
    "3.40282346638528859811704183484516925440e38", "3.40282356779733661637539395458142568448e38",
    "1.40129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125e-45",
    "7.00649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015625e-46",
    "1e-999999999999999999999", "0e999999999999999999999", "1e999999999999999999999",
    "", "+", "-", ".", "1e", "1e+", "1e-", "1e+-2", "1e2e3", "1..2", "1+2", " 1", "1 ", "1_0",
    "1x", "NaN", "inf", "0x1p0", "١", "1\0", 42, false, [], none, string_slice("x1.25y", 1, 5)]
  try
    floats = [@floats, parse_float(text)]
  catch error
    floats = [@floats, [error.code, error.message, error.value]]
  end
end
return [floats, parse_float(@["-1.25"]), conversions, parsed, to_int(@[2.0]), to_float(@[2]), parse_int(@["-99"])]
