// Translate frontend instructions into semantic runtime builders. Register
// storage, native call conventions, and continuation images live behind helpers.
verb native_source/value_instruction(builder: map, instruction: list) -> list
  let op: symbol = instruction[0]
  if op == :Load
    return [native_source/literal(builder, instruction[2]), builder]
  end
  if op == :Move
    return [native_source/register(builder, instruction[2]), builder]
  end
  if op == :Unary
    let result: list = native_source/unary(builder, instruction[2], native_source/register(builder, instruction[3]))
    return result
  end
  if op == :Binary
    let result: list = native_source/binary(builder, instruction[2], native_source/register(builder, instruction[3]), native_source/register(builder, instruction[4]))
    return result
  end
  if op == :BuildList
    let result: list = native_source/list_items(builder, instruction[2], true)
    return result
  end
  if op == :BuildMap
    let result: list = native_source/map_items(builder, instruction[2])
    return result
  end
  if op == :CollectionLen
    let value: map = native_gen/call(builder, string_concat(builder[:source_prefix], "_collection_length"), [native_source/register(builder, instruction[2])])
    return [value, builder]
  end
  if op == :NormalizeError
    let result: list = native_source/normalize_error(builder, instruction)
    return result
  end
  if op == :ErrorField
    let result: list = native_source/error_field(builder, native_source/register(builder, instruction[2]), instruction[3])
    return result
  end
  if op == :BuildRange
    let finish: map = native_gen/zero(native_value/word())
    let present: string = "false"
    if instruction[3] != none
      finish = native_source/operand(builder, instruction[3])
      present = "true"
    end
    let result: list = native_source/result(builder, "value_range", [native_roots/worker(builder), native_source/operand(builder, instruction[2]), native_gen/ref(builder, present), finish], "oom")
    return result
  end
  if op == :CollectionKeyAt || op == :CollectionValueAt
    let operation: string = "key_at"
    if op == :CollectionValueAt
      operation = "value_at"
    end
    let result: list = native_source/access(builder, operation, [native_source/register(builder, instruction[2]), native_source/register(builder, instruction[3])])
    return result
  end
  if op == :Index
    let result: list = native_source/access(builder, "read", [native_source/register(builder, instruction[2]), native_source/operand(builder, instruction[3])])
    return result
  end
  if op == :SetIndex
    let result: list = native_source/access(builder, "write", [native_source/register(builder, instruction[2]), native_source/operand(builder, instruction[3]), native_source/operand(builder, instruction[4])])
    return result
  end
  if op == :BuiltinCall
    let result: list = native_source/builtin_items(builder, instruction[2], instruction[3])
    return result
  end
  native/ensure(false, string_concat("unsupported native source lowering: ", to_literal(op)))
  return []
end
verb native_source/emit_instruction(builder: map, instruction: list) -> map
  let op: symbol = instruction[0]
  if op == :CheckKind
    let result: map = native_source/check_kind(builder, native_source/register(builder, instruction[1]), instruction[2])
    return result
  end
  if op == :AssertDynamic || op == :RetractDynamic
    let present: string = "true"
    if op == :RetractDynamic
      present = "false"
    end
    let result: map = native_source/write_fact(builder, native_tasks/slot(builder, "transaction"),
      native_source/number(builder, instruction[1]), native_source/operands(builder, instruction[2]), native_gen/ref(builder, present))
    return result
  end
  let [value: map, ready: map] = native_source/value_instruction(builder, instruction)
  let result: map = native_source/assign(ready, instruction[1], value)
  return result
end
verb native_source/emit_boundary(builder: map, instruction: list, continuation: string, captures: list) -> map
  let op: symbol = instruction[0]
  if op == :Abort
    let failed: map = native_roots/store(builder, native_tasks/saved(builder, "error", native_value/word()), native_source/operand(builder, instruction[1]))
    let result: map = native_roots/return_value(failed, native_gen/ref(failed, "task_language_error"))
    return result
  end
  if op == :Throw
    let result: map = native_source/throw(builder, native_source/operand(builder, instruction[1]))
    return result
  end
  if op == :Return
    let result: map = native_source/complete(builder, native_source/operand(builder, instruction[1]))
    return result
  end
  if native/contains([:Dispatch, :PositionalDispatch, :DynamicDispatch], op)
    let [arguments: map, prepared: map] = native_source/call_arguments(builder, instruction)
    let result: map = native_source/invoke(prepared, native_source/operand(prepared, instruction[2]), arguments, continuation, captures)
    return result
  end
  if native/contains([:SpawnDispatch, :SpawnDispatchDynamic, :SpawnPositionalDispatch], op)
    native/ensure(instruction[4] == none, "native source delayed spawn lowering is not implemented")
    let [arguments: map, ready: map] = native_source/call_arguments(builder, instruction)
    let result: map = native_source/spawn_task(ready, native_source/operand(ready, instruction[2]), arguments, continuation, captures)
    return result
  end
  native/ensure(op == :MailboxRecv && instruction[3] == none, "unsupported native source suspension")
  let result: map = native_source/receive(builder, native_source/operand(builder, instruction[2]), continuation, captures)
  return result
end

// A block owns temporary roots only while its instructions execute. Source
// registers remain rooted in the region prologue and carry values across edges.
verb native_source/block_body(builder: map, program: map, block: map, continuations: map) -> map
  let ready: map = native_source/checked(builder, "task_poll", [native_tasks/attempt(builder), native_source/number(builder, len(block[:pcs]))])
  let code: list = program[:description][:code]
  let last: int = block[:last]
  let terminal: bool = program[:instructions][last][:boundary] || native/contains([:Return, :Abort, :Throw, :Branch, :Jump], code[last][0])
  ready = native_roots/temporary(ready, fn(body)
    let current: map = body
    for pc in block[:pcs]
      if !(pc == last && terminal) && !native_source/dead_load(program, pc)
        current = native_source/at_instruction(current, program, pc, continuations)
        current = native_source/emit_instruction(current, code[pc])
      end
    end
    return current
  end)
  if !terminal
    let result: map = native_gen/jump_to(ready, native_source/block_label(last + 1))
    return result
  end
  ready = native_source/at_instruction(ready, program, last, continuations)
  let instruction: list = code[last]
  if instruction[0] == :Jump
    let result: map = native_gen/jump_to(ready, native_source/block_label(instruction[1]))
    return result
  end
  if instruction[0] == :Branch
    let condition: map = native_source/truthy(ready, native_source/register(ready, instruction[1]))
    let result: map = native_gen/branch_to(ready, condition, native_source/block_label(instruction[2]), native_source/block_label(instruction[3]))
    return result
  end
  let continuation: string = index_or(continuations, last, "")
  let captures: list = index_or(program[:captures], last, [])
  let result: map = native_source/emit_boundary(ready, instruction, continuation, captures)
  return result
end
verb native_source/region_body(module: map, program: map, region: map, name: string, continuations: map) -> map
  let builder: map = native_source/context(module, string_concat(name, "_body"))
  builder[:source_registers] = {}
  builder = native_tasks/check(builder, native_gen/negate(native_kernel/absent(native_tasks/attempt_field(builder, "runtime"))), "closed")
  builder = native_source/restore_frame(builder, program, region)
  let blocks: list = [[native_source/block_label(block[:start]), fn(body) => native_source/block_body(body, program, block, continuations)] for block in region[:blocks]]
  builder = native_gen/graph(builder, native_source/block_label(region[:start]), blocks)
  let result: map = native_gen/finish(module, builder)
  return result
end
