// Dynamic relation construction and sorting preserve their input values.
let rows = [["é", 2], ["🦀", 1], ["é", 2]]
let saved = rows
let relation = relation_from_rows([:z, :a], rows)
rows[0] = ["changed", 9]
let dynamic = [:z, :a] {[saved[0][0], saved[0][1]], [saved[1][0], saved[1][1]]}
let mixed = [1.0, -3, 1, 0.0, -0.0, 1]
let ordered = sort(@[mixed])
let text = sort(["🦀", "é", "a", "é"])
let keyed = [pair[1] for pair in [[0, 3], [1, 1], [0, 2]] sort pair[0]]
let filtered = [n * 2 for n in [4, 1, 3, 2] if n > 1 sort]
let events = []
let evaluated = [(events = [@events, n * 10])[len(events) - 1] for n in [3, 1, 2] if n > 1 sort (events = [@events, n])[len(events) - 1]]
let errors = []
for arguments in [[], [0, []], [[0], []], [[:x], 0], [[:x], [0]], [[:x, :x], [[1, 2]]], [[:x], [[1, 2]]], [[:x], [[]]]]
  try
    relation_from_rows(@arguments)
    errors = [@errors, false]
  catch code
    errors = [@errors, code.code]
  end
end
return [relation, dynamic, saved, rows, ordered, mixed, text, keyed, filtered, evaluated, events, errors,
  sort([]), sort([1]), sort([1, 1, 2]), relation_from_rows([:x], []), relation_from_rows([], [[]]),
  relation_from_rows([], []), [n for n in [3, 1, 2] sort]]
