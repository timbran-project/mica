// Fixed signatures share argument expansion; ordinary calls retain direct
// operands rather than constructing an argument list at runtime.
verb native_builtins/arities() -> map
  return {:union -> 2, :difference -> 2, :natural_join -> 2, :edit_distance -> 2, :is_builtin -> 1, :to_symbol -> 1, :error_code -> 1, :frob -> 2, :frob_delegate -> 1, :frob_value -> 1, :is_frob -> 1,
    :url_encode_component -> 1, :url_decode_component -> 1, :to_int -> 1, :to_float -> 1, :parse_int -> 1, :parse_float -> 1, :emit -> 2, :mailbox -> 0, :mailbox_send -> 2, :mailbox_close -> 1,
    :len -> 1, :string_len -> 1, :string_append -> 2, :string_contains -> 2, :string_starts_with -> 2,
    :string_span -> 3, :string_find_any -> 3, :string_slice -> 3, :string_chars -> 1, :string_from_chars -> 1, :string_join -> 2,
    :sort -> 1, :relation_from_rows -> 2, :map_contains_key -> 2, :map_pairs -> 1, :index_or -> 3, :is_kind -> 2}
end
// The generated runtime exposes these fixed-arity calls and three variadic
// calls. Compiler forms such as commit and suspend are not registry entries.
verb native_builtins/names() -> list
  return sort([@[name for name, arity in native_builtins/arities()], :error, :string_concat, :project])
end
verb native_builtins/lookup_name(module: map) -> string
  return string_concat(module[:source_prefix], "_is_builtin")
end
verb native_builtins/lookup_definition(input: map) -> map
  let module: map = native/declare_function(input, native_builtins/lookup_name(input), :Bool,
    [["code", native_tasks/pointer("CodeRef"), :Gc], ["name", native_value/word(), :Gc]],
    [], [:ReadMemory], :Value, "")
  let builder: map = native_gen/context(module, native_builtins/lookup_name(module))
  builder[:source_literals] = module[:source_literals]
  builder[:source_prefix] = module[:source_prefix]
  builder[:source_code] = native_gen/ref(builder, "code")
  let name: map = native_gen/ref(builder, "name")
  for registered in native_builtins/names()
    builder = native_gen/when(builder, native_gen/equal(name, native_source/literal(builder, registered)),
      fn(found) => native_gen/return_value(found, native_gen/ref(found, "true")))
  end
  let result: map = native_gen/finish(module, native_gen/return_value(builder, native_gen/ref(builder, "false")))
  return result
end
verb native_builtins/lookup(builder: map, value: map) -> list
  let ready: map = native_gen/unless(builder, native_access/kind(builder, value, "symbol"),
    fn(invalid) => native_builtins/error(invalid, "is_builtin expects a symbol", E_TYPE))
  let code: map = native_kernel/load_field(ready, native_handlers/current(ready), "code")
  let found: map = native_gen/call(ready, native_builtins/lookup_name(ready), [code, value])
  return [native_gen/call(ready, "value_bool", [found]), ready]
end
verb native_builtins/kind_check(builder: map, value: map, kind: string) -> map
  let result: map = native_tasks/check(builder, native_access/kind(builder, value, kind), "schema")
  return result
end
verb native_builtins/has_kind(builder: map, value: map, kinds: list) -> list
  let [found: map, ready: map] = native_gen/bind(builder, "supported", native_gen/ref(builder, "false"))
  for kind in kinds
    ready = native_gen/when(ready, native_access/kind(ready, value, kind),
      fn(matched) => native_gen/assign(matched, found, native_gen/ref(matched, "true")))
  end
  return [found, ready]
end
verb native_builtins/error(builder: map, message: string, ?error_code = E_INVARG) -> map
  let code: map = native_source/literal(builder, error_code)
  let [error: map, ready: map] = native_source/result(builder, "value_error", [native_roots/worker(builder),
    native_gen/convert(:U32, native_gen/expression(:U64, :Payload, [code])),
    native_gen/ref(builder, "true"), native_source/literal(builder, message),
    native_gen/ref(builder, "false"), native_gen/zero(native_value/word())], "oom")
  let result: map = native_source/throw(ready, error)
  return result
end
verb native_builtins/arity_failure(builder: map, name: symbol) -> map
  if name == :is_builtin
    let result: map = native_builtins/error(builder, "is_builtin expects one symbol")
    return result
  end
  if name == :relation_from_rows
    let result: map = native_builtins/error(builder, "relation_from_rows expects a heading and a list of rows")
    return result
  end
  if name == :is_kind
    let result: map = native_builtins/error(builder, "is_kind expects a value and kind symbol")
    return result
  end
  let result: map = native_tasks/attempt_status(builder, "schema")
  return result
end
verb native_builtins/length(builder: map, value: map, only_string: bool) -> list
  let kinds: list = ["string", "bytes", "list", "map", "relation"]
  if only_string
    kinds = ["string"]
  end
  let [length: map, ready: map] = native_gen/bind(builder, "length", native_gen/ref(builder, "zero"))
  let [accepted: map, checked_kinds: map] = native_builtins/has_kind(ready, value, kinds)
  ready = checked_kinds
  for kind in kinds
    let matches: map = native_access/kind(ready, value, kind)
    ready = native_gen/when(ready, matches, fn(collection)
      let count: map = native_gen/zero(:U64)
      if kind == "bytes"
        let header: map = native_gen/expression(native_memory/record_pointer("HeapBytes"), :UnpackPointer, [value])
        count = native_kernel/load_field(collection, header, "length")
      else
        count = native_access/length(collection, value, kind)
      end
      return native_gen/assign(collection, length, count)
    end)
  end
  ready = native_tasks/check(ready, accepted, "schema")
  ready = native_tasks/check(ready, native_gen/negate(native_gen/less(native_gen/bitcast(:U64, native_gen/ref(ready, "int_max")), length)), "schema")
  let [encoded: map, checked: map] = native_gen/checked_bind(ready, "length", native_gen/call(ready, "value_int", [native_gen/bitcast(:I64, length)]), "ok",
    fn(failed) => native_tasks/attempt_status(failed, "schema"))
  return [native_gen/field(checked, encoded, "value"), checked]
end
verb native_builtins/index_or(builder: map, value: map, key: map, fallback: map) -> list
  let [output: map, ready: map] = native_roots/retain(builder, "indexed", fallback)
  ready = native_gen/branch(ready, native_access/kind(ready, value, "map"), fn(map)
    let [found: map, searched: map] = native_gen/bind(map, "found", native_gen/call(map, "value_map_get", [value, key]))
    return native_gen/when(searched, native_gen/field(searched, found, "ok"),
      fn(present) => native_roots/store(present, output, native_gen/field(present, found, "value")))
  end, fn(sequence)
    let [ordinal: map, decoded: map] = native_gen/checked_bind(sequence, "index", native_gen/call(sequence, "value_as_int", [key]), "ok",
      fn(invalid) => native_tasks/attempt_status(invalid, "schema"))
    let position: map = native_gen/field(decoded, ordinal, "number")
    let checked: map = native_tasks/check(decoded, native_gen/negate(native_gen/less(position, native_gen/ref(decoded, "int_zero"))), "schema")
    let [supported: map, with_kind: map] = native_builtins/has_kind(checked, value, ["string", "list", "relation"])
    checked = native_tasks/check(with_kind, supported, "schema")
    let length: map = native_gen/call(checked, string_concat(checked[:source_prefix], "_collection_length"), [value])
    let count: map = native_gen/field(checked, native_gen/call(checked, "value_as_int", [length]), "number")
    return native_gen/when(checked, native_gen/less(position, count), fn(present)
      let [found: map, read: map] = native_source/access(present, "read", [value, key])
      return native_roots/store(read, output, found)
    end)
  end)
  return [output, ready]
end

// Poll while constructing the result. Both the original map and completed
// prefix stay rooted, so collection can move them between iterations.
verb native_builtins/pairs(builder: map, value: map) -> list
  let ready: map = native_builtins/kind_check(builder, value, "map")
  let [result: map, rooted: map] = native_source/rooted_list(ready, "pairs", [])
  let length: map = native_access/length(rooted, value, "map")
  ready = native_gen/for_range(rooted, "pair", native_gen/ref(rooted, "zero"), length, fn(step, index)
    let polled: map = native_source/checked(step, "task_poll", [native_tasks/attempt(step), native_gen/ref(step, "one")])
    let key: map = native_access/integer(polled, native_gen/bitcast(:I64, index))
    let [left: map, with_left: map] = native_source/access(polled, "key_at", [value, key])
    let [right: map, with_right: map] = native_source/access(with_left, "value_at", [value, key])
    let [pair: map, built: map] = native_source/list(with_right, [left, right])
    let [appended: map, copied: map] = native_source/result(built, "value_list_append", [native_roots/worker(built), result, pair], "oom")
    return native_roots/store(copied, result, appended)
  end)
  return [result, ready]
end
verb native_builtins/is_kind(builder: map, value: map, kind: map) -> list
  let ready: map = native_gen/unless(builder, native_access/kind(builder, kind, "symbol"),
    fn(invalid) => native_builtins/error(invalid, "expected a symbol"))
  let [known: map, with_known: map] = native_gen/bind(ready, "known_kind", native_gen/ref(ready, "false"))
  let [matched: map, with_match: map] = native_gen/bind(with_known, "matches_kind", native_gen/ref(with_known, "false"))
  ready = with_match
  for spec in native_value/kinds()
    let name: symbol = to_symbol(spec[0])
    ready = native_gen/when(ready, native_gen/equal(kind, native_source/literal(ready, name)), fn(selected)
      let found: map = native_gen/assign(selected, known, native_gen/ref(selected, "true"))
      return native_gen/assign(found, matched, native_access/kind(found, value, spec[0]))
    end)
  end
  ready = native_gen/unless(ready, known, fn(invalid) => native_builtins/error(invalid, "unknown value kind"))
  return [native_gen/call(ready, "value_bool", [matched]), ready]
end
verb native_builtins/call(builder: map, name: symbol, args: list) -> list
  if name == :is_builtin
    let result: list = native_builtins/lookup(builder, args[0])
    return result
  end
  if name == :to_symbol
    let result: list = native_builtins/symbol(builder, args[0])
    return result
  end
  if name == :error_code
    let ready: map = native_builtins/kind_check(builder, args[0], "symbol")
    let result: list = native_source/result(ready, "value_error_code", [native_gen/convert(:U32, native_gen/expression(:U64, :Payload, [args[0]]))], "schema")
    return result
  end
  if native/contains([:frob, :frob_delegate, :frob_value, :is_frob], name)
    let result: list = native_builtins/frob(builder, name, args)
    return result
  end
  if name == :url_encode_component || name == :url_decode_component
    let operation: string = "url_encode"
    if name == :url_decode_component
      operation = "url_decode"
    end
    let result: list = native_text/construct(builder, operation, args)
    return result
  end
  if name == :to_int || name == :to_float
    let result: list = native_numeric/convert(builder, name, args[0])
    return result
  end
  if name == :parse_int || name == :parse_float
    let result: list = native_numeric/parse(builder, name, args[0])
    return result
  end
  if name == :emit
    return [args[1], native_source/emit(builder, args[0], args[1])]
  end
  if native/contains([:union, :difference, :natural_join], name)
    let result: list = native_algebra/call(builder, native_source/symbol_text(name), args)
    return result
  end
  if name == :edit_distance
    let result: list = native_text/construct(builder, "edit_distance", args)
    return result
  end
  if name == :string_contains
    let result: list = native_text/construct(builder, "contains", args)
    return result
  end
  if name == :string_starts_with
    let result: list = native_text/construct(builder, "starts_with", args)
    return result
  end
  if name == :string_span || name == :string_find_any
    let result: list = native_text/scan(builder, name, args)
    return result
  end
  if name == :string_slice
    let result: list = native_text/slice(builder, args)
    return result
  end
  if name == :string_chars
    let result: list = native_text/construct(builder, "characters", args)
    return result
  end
  if name == :string_join || name == :string_from_chars
    let separator: map = native_source/literal(builder, "")
    let characters: map = native_gen/ref(builder, "true")
    if name == :string_join
      separator = args[1]
      characters = native_gen/ref(builder, "false")
    end
    let result: list = native_text/construct(builder, "assemble", [args[0], separator, characters])
    return result
  end
  if name == :sort
    let result: list = native_ordering/sort(builder, args[0])
    return result
  end
  if name == :relation_from_rows
    let result: list = native_builtins/relation(builder, args[0], args[1])
    return result
  end
  if name == :len || name == :string_len
    let result: list = native_builtins/length(builder, args[0], name == :string_len)
    return result
  end
  if name == :is_kind
    let result: list = native_builtins/is_kind(builder, args[0], args[1])
    return result
  end
  if name == :index_or
    let result: list = native_builtins/index_or(builder, args[0], args[1], args[2])
    return result
  end
  if name == :map_pairs
    let result: list = native_builtins/pairs(builder, args[0])
    return result
  end
  if name == :map_contains_key
    let checked: map = native_builtins/kind_check(builder, args[0], "map")
    let [found: map, ready: map] = native_gen/bind(checked, "found", native_gen/call(checked, "value_map_get", args))
    return [native_gen/call(ready, "value_bool", [native_gen/field(ready, found, "ok")]), ready]
  end
  if name == :string_append
    let checked: map = native_builtins/kind_check(native_builtins/kind_check(builder, args[0], "string"), args[1], "string")
    let result: list = native_source/result(checked, "value_string_concat", [native_roots/worker(checked), @args], "oom")
    return result
  end
  let result: list = native_source/mailbox_builtin(builder, name, args)
  return result
end

// Shape failures are language errors; allocation, limit, and cancellation
// failures retain their kernel status. One helper validates every call site.
verb native_builtins/relation_errors() -> list
  return [[E_TYPE, "relation_from_rows heading must be a list"],
    [E_TYPE, "relation_from_rows heading must contain symbols"],
    [E_TYPE, "relation_from_rows rows must be a list"],
    [E_TYPE, "relation_from_rows rows must be lists"],
    [E_INVARG, "relation_from_rows heading exceeds 65535 columns"],
    [E_INVARG, "relation_from_rows heading contains duplicate columns"],
    [E_INVARG, "relation_from_rows row arity does not match heading"]]
end
verb native_builtins/relation_name(module: map) -> string
  return string_concat(module[:source_prefix], "_relation_from_rows")
end
verb native_builtins/relation_result(builder: map, shape: int, value: map) -> map
  let result: map = native_roots/return_value(builder, native_gen/record(builder, builder[:result], {
    "status" -> native_gen/ref(builder, "kernel_ok"), "shape" -> native_gen/ref(builder, string_concat(builder[:module][:source_prefix], "_number_", to_literal(shape))), "value" -> value}))
  return result
end
verb native_builtins/relation_check(builder: map, condition: map, shape: int) -> map
  let result: map = native_gen/unless(builder, condition,
    fn(invalid) => native_builtins/relation_result(invalid, shape, native_gen/zero(native_value/word())))
  return result
end
verb native_builtins/relation_body(module: map) -> map
  let builder: map = native_queries/budget_scope(native_gen/context(module, native_builtins/relation_name(module)))
  let heading: map = native_roots/ref(builder, "heading")
  let rows: map = native_roots/ref(builder, "rows")
  let ready: map = native_builtins/relation_check(builder, native_access/kind(builder, heading, "list"), 1)
  ready = native_gen/for_range(ready, "column", native_gen/ref(ready, "zero"), native_query/width(ready, heading), fn(step, index)
    let polled: map = native_query/poll_interval(step, index)
    return native_builtins/relation_check(polled, native_access/kind(polled, native_query/cell(polled, heading, index), "symbol"), 2)
  end)
  ready = native_builtins/relation_check(ready, native_access/kind(ready, rows, "list"), 3)
  ready = native_gen/for_range(ready, "row", native_gen/ref(ready, "zero"), native_query/width(ready, rows), fn(step, index)
    let polled: map = native_query/poll_interval(step, index)
    return native_builtins/relation_check(polled, native_access/kind(polled, native_query/cell(polled, rows, index), "list"), 4)
  end)
  let width: map = native_query/width(ready, heading)
  ready = native_builtins/relation_check(ready, native_gen/negate(native_gen/less(native_gen/ref(ready, "relation_max_arity"), width)), 5)
  let [positions: map, already_ordered: map, ordered: map] = native_ordering/positions(ready, heading)
  ready = native_gen/for_range(ordered, "column", native_gen/ref(ordered, "one"), width, fn(step, index)
    let polled: map = native_query/poll_interval(step, index)
    let left: map = native_query/cell(polled, heading, native_gen/load(native_gen/offset(positions, native_gen/subtract(index, native_gen/ref(polled, "one")))))
    let right: map = native_query/cell(polled, heading, native_gen/load(native_gen/offset(positions, index)))
    return native_builtins/relation_check(polled, native_gen/not_equal(left, right), 6)
  end)
  ready = native_gen/for_range(ready, "row", native_gen/ref(ready, "zero"), native_query/width(ready, rows), fn(step, index)
    let polled: map = native_query/poll_interval(step, index)
    let row: map = native_query/cell(polled, rows, index)
    return native_builtins/relation_check(polled, native_gen/equal(native_query/width(polled, row), width), 7)
  end)
  let controls: map = {:checkpoint -> fn(step, index) => native_query/charge(step, native_gen/ref(step, "one"), native_gen/ref(step, "zero"))}
  let [value: map, constructed: map] = native_queries/relation_value(ready, heading, rows, controls)
  let result: map = native_gen/finish(module, native_builtins/relation_result(constructed, 0, value))
  return result
end
verb native_builtins/relation(builder: map, heading: map, rows: map) -> list
  let [value: map, called: map] = native_gen/bind(builder, "relation", native_gen/call(builder, native_builtins/relation_name(builder), [
    native_roots/worker(builder), native_tasks/attempt(builder), native_tasks/slot(builder, "transaction"), heading, rows]))
  let status: map = native_gen/field(called, value, "status")
  let ready: map = native_gen/unless(called, native_kernel/absent(status), fn(failed) => native_roots/return_value(failed, status))
  let shape: map = native_gen/field(ready, value, "shape")
  ready = native_gen/unless(ready, native_kernel/absent(shape), fn(invalid)
    let [code: map, coded: map] = native_gen/bind(invalid, "error_code", native_gen/zero(native_value/word()))
    let [message: map, with_message: map] = native_gen/bind(coded, "error_message", native_gen/zero(native_value/word()))
    let cases: list = []
    let ordinal: int = 1
    for [error_code, text] in native_builtins/relation_errors()
      cases = [@cases, [native_source/number(with_message, ordinal), fn(selected)
        let assigned: map = native_gen/assign(selected, code, native_source/literal(selected, error_code))
        return native_gen/assign(assigned, message, native_source/literal(assigned, text))
      end]]
      ordinal = ordinal + 1
    end
    let selected: map = native_gen/switch(with_message, shape, cases, fn(unknown) => native_tasks/attempt_status(unknown, "schema"))
    let [error: map, allocated: map] = native_source/result(selected, "value_error", [native_roots/worker(selected),
      native_gen/convert(:U32, native_gen/expression(:U64, :Payload, [code])), native_gen/ref(selected, "true"), message,
      native_gen/ref(selected, "false"), native_gen/zero(native_value/word())], "oom")
    return native_source/throw(allocated, error)
  end)
  return [native_gen/field(ready, value, "value"), ready]
end

verb native_builtins/definitions(input: map) -> map
  let sorting: bool = false
  let relations: bool = false
  let symbols: bool = false
  let lookup: bool = false
  for program in input[:source_programs]
    let pc: int = 0
    for instruction in program[:analysis][:description][:code]
      if map_contains_key(program[:analysis][:reachable], pc) && instruction[0] == :BuiltinCall
        lookup = lookup || instruction[2] == :is_builtin
        symbols = symbols || instruction[2] == :to_symbol
        sorting = sorting || instruction[2] == :sort
        relations = relations || instruction[2] == :relation_from_rows
      end
      pc = pc + 1
    end
  end
  let module: map = input
  if lookup
    module = native_builtins/lookup_definition(module)
  end
  if symbols
    module = native_builtins/symbol_definition(module)
  end
  if sorting || relations
    module = native_ordering/definitions(module)
  end
  if !relations
    return module
  end
  let result_type: list = [:Record, string_concat(module[:source_prefix], "_RelationResult")]
  module[:state] = native/record_type(module[:state], result_type[1], [["status", :U64], ["shape", :U64], ["value", native_value/word()]])[1]
  module = native_memory/declare(module, native_builtins/relation_name(module), result_type, [
    ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow], ["attempt", native_tasks/pointer("Attempt"), :Borrow],
    ["transaction", native_kernel/pointer("Transaction"), :Borrow], ["heading", native_value/word(), :Gc], ["rows", native_value/word(), :Gc]], native_tasks/effects(), :Gc, "")
  let result: map = native_builtins/relation_body(module)
  return result
end
