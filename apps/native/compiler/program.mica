// The caller assigns catalogue identities. Installation stages publication;
// compilation only constructs code, constants, and native entry points.
verb native_source/define_entries(input: map) -> map
  let module: map = input
  for program in module[:source_programs]
    let continuations: map = native_source/continuations(program)
    let index: int = 0
    for region in program[:regions]
      let name: string = string_concat(program[:name], "_", to_literal(index))
      module = native_source/region_body(module, program[:analysis], region, name, continuations)
      module = native_source/entry_body(module, name)
      index = index + 1
    end
  end
  return module
end

verb native_source/compile(input: map, prefix: string, source: string, relations: map, method_ids: list) -> map
  let parsed: map = parse_rows(source)
  native/ensure(parsed[:errors] == [], to_literal(parsed[:errors]))
  let emitted: map = emit_program(parsed[:rows], parsed[:root])
  native/ensure(emitted[:errors] == [], to_literal(emitted[:errors]))
  let module: map = native_source/prepare_module(input, prefix, emitted, relations, method_ids)
  module = native_source/truthy_body(module)
  module = native_source/length_body(module)
  module = native_source/kind_message_body(module)
  module = native_access/definitions(module)
  module = native_queries/definitions(module)
  module = native_updates/definitions(module)
  module = native_builtins/definitions(module)
  module = native_algebra/definitions(module)
  module = native_source_subscriptions/definitions(module)
  module = native_time/definitions(module)
  module = native_text/definitions(module)
  module = native_quoting/definitions(module)
  module = native_format/definitions(module)
  module = native_numeric/definitions(module)
  module = native_read/definitions(module)
  module = native_write/definitions(module)
  module = native_source/declare_entries(module)
  module = native_source/constants_body(module)
  module = native_source/install_body(module, emitted[:methods])
  let result: map = native_source/define_entries(module)
  return result
end
