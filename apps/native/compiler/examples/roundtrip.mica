verb native_roundtrip_child(reply: capability, key: int, value: int)
  let round = 0
  while round < 3
    assert NativeResult(key, value)
    round = round + 1
  end
  mailbox_send(reply, value)
  return value
end

verb native_roundtrip_receive(receivers)
  return mailbox_recv(receivers)
end

let saved = ["parent continuation", 42]
let caps = mailbox()
let child = 0
let messages = []
let count = 0
while count < 2
  child = spawn :native_roundtrip_child(reply: caps[1], key: 7 + count, value: saved[1] + count)
  messages = native_roundtrip_receive([caps[0]])
  count = count + 1
end
mailbox_close(caps[0])
return [child, saved, messages, count]
