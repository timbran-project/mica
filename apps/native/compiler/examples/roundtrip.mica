verb native_roundtrip_child(reply: capability, key: int, value: int)
  let round = 0
  while round < 3
    assert NativeResult(key, value)
    round = round + 1
  end
  let result = fn() => value
  mailbox_send(@[reply, result])
  return value
end

verb native_roundtrip_receive(receivers)
  try
    let messages = mailbox_recv(receivers)
    // Invoke the child-created closure after publication and task resumption.
    messages[0][1][0] = messages[0][1][0]()
    return messages
  finally
    // Record completion after resumption, in the resumed transaction.
    assert NativeResult(9, 1)
  end
end

let saved = from_literal(to_literal(["parent continuation", 42]))[0][:value]
let caps = mailbox()
let child = 0
let messages = []
let count = 0
while count < 2
  child = spawn :native_roundtrip_child(@[caps[1]], 7 + count, @[saved[1] + count])
  messages = native_roundtrip_receive([caps[0]])
  count = count + 1
end
mailbox_close(caps[0])
return [child, saved, messages, count]
