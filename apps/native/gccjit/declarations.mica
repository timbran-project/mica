// Shells make recursive pointer types available before aggregate layout is
// complete. By-value members require completed types; pointer targets and
// callable signatures require only handles.
verb native_jit/type_shells() -> list
  let h: list = native_jit/handle()
  let primitives: list = []
  let names: list = ["void", "u8", "u16", "u32", "u64", "i64", "f32", "bool"]
  let i: int = 0
  for name in names
    primitives = [@primitives, native_jit/publish(:Type, native_jit/n(i), native_jit/j(string_concat("type_", name), ["ctx"])), native_jit/publish_metadata(:TypeComplete, native_jit/n(i), "n1")]
    i = i + 1
  end
  return [@primitives,
    @native_jit/scan(native_jit/section(:Type), [
      native/let_statement("id", :U64, native_jit/row_field(:Type, "row", :Id)), native_jit/publish_metadata(:TypeRow, "id", "cursor"),
      native/let_statement("kind", :U64, native_jit/row_field(:Type, "row", :Kind)),
      native/when_statement(native/binary_expression(:Less, "n8", "kind"), [
        native/when_statement(native/binary_expression(:Less, "kind", "n11"), [
          native/let_statement("structure", h, native_jit/j("struct", ["ctx", native_jit/text(native_jit/row_field(:Type, "row", :Name))])),
          native_jit/publish(:Structure, "id", "structure"), native_jit/publish(:Type, "id", native_jit/j("struct_type", ["structure"]))])])])]
end

verb native_jit/complete_pointer() -> list
  return [native/unless_statement(native/binary_expression(:Equal, "type", "null"), [
    native/when_statement(native/binary_expression(:Equal, native_jit/row_field(:Type, "row", :Detail), "n1"), [native/set_statement("type", native_jit/j("const_type", ["type"]))]),
    native/set_statement("result", native_jit/j("pointer", ["type"]))])]
end

verb native_jit/complete_array() -> list
  let h: list = native_jit/handle()
  return [native/when_statement(native/binary_expression(:Equal, native_jit/metadata(:TypeComplete, "element"), "n1"), [
    native/let_statement("array", h, native_jit/j("array", ["ctx", "type", native_jit/row_field(:Type, "row", :Detail)])),
    native_jit/publish(:ArrayRepresentation, "id", "array"),
    native/let_statement("array_field", h, native_jit/j("field", ["ctx", "array", native_jit/text(native_jit/row_tail(:Type, "row", 1))])),
    native_jit/publish(:Field, native_jit/row_tail(:Type, "row", 0), "array_field"),
    @native_jit/consume_arguments(["array_field"], "fields", [native_jit/cache(:Structure, "id")], [:Do]),
    native/set_statement("result", native_jit/cache(:Type, "id"))])]
end

verb native_jit/complete_record() -> list
  let h: list = native_jit/handle()
  let preparation: list = [
    native/let_statement("member", :U64, native_jit/n(native_jit/tail_start(:Type))), native/let_statement("count", :U64, "n0"),
    native/while_statement(native/binary_expression(:Less, "member", native_jit/word("row", 0)), [
      native/let_statement("field_type", h, native_jit/cache(:Type, native_jit/at("row", "member", :U64))),
      native/let_statement("field", h, native_jit/j("field", ["ctx", "field_type", native_jit/text(native_jit/at("row", native_jit/binary(:Add, "member", "n1"), :U64))])),
      native_jit/publish(:Arguments, "count", "field"), native_jit/publish(:Field, native_jit/at("row", native_jit/binary(:Add, "member", "n2"), :U64), "field"),
      native/set_statement("member", native_jit/binary(:Add, "member", "n3")), native/set_statement("count", native_jit/binary(:Add, "count", "n1"))])]
  return [
    native/let_statement("ready", :Bool, "true"), native/let_statement("dependency", :U64, native_jit/n(native_jit/tail_start(:Type))),
    native/while_statement(native/binary_expression(:Less, "dependency", native_jit/word("row", 0)), [
      native/when_statement(native/binary_expression(:Equal, native_jit/metadata(:TypeComplete, native_jit/at("row", "dependency", :U64)), "n0"), [native/set_statement("ready", "false")]),
      native/set_statement("dependency", native_jit/binary(:Add, "dependency", "n3"))]),
    native/when_statement("ready", [
      @native_jit/consume_prepared_arguments(preparation, "fields", [native_jit/cache(:Structure, "id")], "count", [:Do]),
      native/set_statement("result", native_jit/cache(:Type, "id"))])]
end

verb native_jit/complete_function_pointer() -> list
  let h: list = native_jit/handle()
  let preparation: list = [native/let_statement("argument", :U64, native_jit/n(native_jit/tail_start(:Type))),
    native/while_statement(native/binary_expression(:Less, "argument", native_jit/word("row", 0)), [
      native_jit/publish(:Arguments, native_jit/binary(:Subtract, "argument", native_jit/n(native_jit/tail_start(:Type))), native_jit/cache(:Type, native_jit/at("row", "argument", :U64))),
      native/set_statement("argument", native_jit/binary(:Add, "argument", "n1"))])]
  return [
    native/let_statement("call_ready", :Bool, native/binary_expression(:Equal, "type", "null")),
    native/set_statement("call_ready", native/binary_expression(:Equal, "call_ready", "false")),
    native/let_statement("call_dependency", :U64, native_jit/n(native_jit/tail_start(:Type))),
    native/while_statement(native/binary_expression(:Less, "call_dependency", native_jit/word("row", 0)), [
      native/let_statement("argument_type", h, native_jit/cache(:Type, native_jit/at("row", "call_dependency", :U64))),
      native/when_statement(native/binary_expression(:Equal, "argument_type", "null"), [native/set_statement("call_ready", "false")]),
      native/set_statement("call_dependency", native_jit/binary(:Add, "call_dependency", "n1"))]),
    native/when_statement("call_ready", native_jit/consume_prepared_arguments(preparation, "function_type", ["ctx", "type"], native_jit/binary(:Subtract, native_jit/word("row", 0), native_jit/n(native_jit/tail_start(:Type))), [:Set, "result"]))]
end

verb native_jit/type_attempts() -> list
  let completions: list = [
    [:Pointer, native_jit/complete_pointer()],
    [:Scalar, [native/set_statement("result", "type")]],
    [:Tagged, [native/set_statement("result", native_jit/cache(:Type, "n4"))]],
    [:Array, native_jit/complete_array()],
    [:Record, native_jit/complete_record()],
    [:FunctionPointer, native_jit/complete_function_pointer()]]
  let body: list = [
    native/let_statement("kind", :U64, native_jit/row_field(:Type, "row", :Kind)),
    native/let_statement("element", :U64, native_jit/row_field(:Type, "row", :Element)),
    native/let_statement("type", native_jit/handle(), native_jit/cache(:Type, "element")),
    native/let_statement("result", native_jit/handle(), "null")]
  for completion in completions
    body = [@body, native/when_statement(native/binary_expression(:Equal, "kind", native_jit/n(native_jit/position(native_jit/type_kinds(), completion[0]))), completion[1])]
  end
  return [native/let_statement("id", :U64, native_jit/row_field(:Type, "row", :Id)),
    native/when_statement(native/binary_expression(:Equal, native_jit/metadata(:TypeComplete, "id"), "n0"), [@body,
      native/unless_statement(native/binary_expression(:Equal, "result", "null"), [
        native_jit/publish(:Type, "id", "result"), native_jit/publish_metadata(:TypeComplete, "id", "n1"), native/set_statement("progress", "true")])])]
end

verb native_jit/define_types(input: map) -> map
  let context: map = native_jit/define(input, "types", [@native_jit/type_shells(),
    native/let_statement("progress", :Bool, "true"),
    native/while_statement("progress", [native/set_statement("progress", "false"), @native_jit/renamed_scan(native_jit/section(:Type), native_jit/type_attempts(), "resolve")]),
    native/let_statement("check", :U64, "n0"),
    native/while_statement(native/binary_expression(:Less, "check", native_jit/word("data", 3)), [
      native/when_statement(native/binary_expression(:Equal, native_jit/metadata(:TypeComplete, "check"), "n0"), [native/return_value("false")]),
      native/set_statement("check", native_jit/binary(:Add, "check", "n1"))]), native/return_value("true")])
  return context
end

// Builder names are function-wide. Rename the second scan's local bindings
// while preserving field/type metadata and already-declared outer bindings.
verb native_jit/rename(tree, names: map)
  if is_kind(tree, :string) && map_contains_key(names, tree)
    return names[tree]
  end
  if is_kind(tree, :list)
    return [native_jit/rename(item, names) for item in tree]
  end
  return tree
end
verb native_jit/renamed_scan(section: int, body: list, prefix: string) -> list
  let names: map = {}
  for name in ["cursor", "row", "id", "kind", "structure"]
    names[name] = string_concat(prefix, "_", name)
  end
  let statements: list = native_jit/rename(native_jit/scan(section, body), names)
  return statements
end

verb native_jit/define_declarations(input: map) -> map
  let context: map = input
  let h: list = native_jit/handle()
  let parameters: list = [
    native/let_statement("position", :U64, native_jit/n(native_jit/tail_start(:Function))), native/let_statement("count", :U64, "n0"),
    native/while_statement(native/binary_expression(:Less, "position", native_jit/word("row", 0)), [
      native/let_statement("parameter_id", :U64, native_jit/at("row", "position", :U64)),
      native/let_statement("parameter_type", :U64, native_jit/at("row", native_jit/binary(:Add, "position", "n1"), :U64)),
      native/let_statement("parameter", h, native_jit/j("parameter", ["ctx", native_jit/cache(:Type, "parameter_type"), native_jit/text(native_jit/at("row", native_jit/binary(:Add, "position", "n2"), :U64))])),
      native_jit/publish(:Arguments, "count", "parameter"), native_jit/publish(:Rvalue, "parameter_id", native_jit/j("parameter_value", ["parameter"])), native_jit/publish_metadata(:NodeType, "parameter_id", "parameter_type"),
      native/set_statement("position", native_jit/binary(:Add, "position", "n3")), native/set_statement("count", native_jit/binary(:Add, "count", "n1"))])]
  context = native_jit/define(context, "functions", [
    @native_jit/scan(native_jit/section(:Function), native_jit/consume_prepared_arguments(parameters, "function", [
      "ctx", native_jit/cache(:Type, native_jit/row_field(:Function, "row", :Result)), native_jit/text(native_jit/row_field(:Function, "row", :Name)),
      native/typed_expression(:Bool, native/binary_expression(:Equal, native_jit/row_field(:Function, "row", :Foreign), "n1"))],
      "count", [:Publish, :Declaration, native_jit/row_field(:Function, "row", :Id)])), native/return_void()])
  context = native_jit/define(context, "locals", [@native_jit/scan(native_jit/section(:Local), [
    native/let_statement("id", :U64, native_jit/row_field(:Local, "row", :Id)), native/let_statement("type_id", :U64, native_jit/row_field(:Local, "row", :Type)),
    native/let_statement("local", h, native_jit/j("local", [native_jit/cache(:Declaration, native_jit/row_field(:Local, "row", :Function)), native_jit/cache(:Type, "type_id"), native_jit/text(native_jit/row_field(:Local, "row", :Name))])),
    native_jit/publish(:Lvalue, "id", "local"), native_jit/publish(:Rvalue, "id", native_jit/j("value", ["local"])), native_jit/publish_metadata(:NodeType, "id", "type_id")]), native/return_void()])
  // GCC chooses the first block as entry. The input table need not be ordered.
  let block_body: list = [
    native/when_statement(native/binary_expression(:Equal, native_jit/row_field(:Block, "row", :Entry), "entry"), [
      native_jit/publish(:Declaration, native_jit/row_field(:Block, "row", :Id), native_jit/j("block", [native_jit/cache(:Declaration, native_jit/row_field(:Block, "row", :Function)), native_jit/text(native_jit/row_field(:Block, "row", :Name))])),
      native_jit/publish(:BlockTail, native_jit/row_field(:Block, "row", :Id), native_jit/cache(:Declaration, native_jit/row_field(:Block, "row", :Id))),
      native_jit/publish_metadata(:BlockOwner, native_jit/row_field(:Block, "row", :Id), native_jit/row_field(:Block, "row", :Function))])]
  context = native_jit/define(context, "blocks", [native/let_statement("entry", :U64, "n1"), @native_jit/scan(native_jit/section(:Block), block_body), native/set_statement("entry", "n0"), @native_jit/renamed_scan(native_jit/section(:Block), block_body, "remaining"), native/return_void()])
  context = native_jit/define(context, "constants", [@native_jit/scan(native_jit/section(:Constant), [
    native/let_statement("id", :U64, native_jit/row_field(:Constant, "row", :Id)), native/let_statement("type_id", :U64, native_jit/row_field(:Constant, "row", :Type)),
    native/let_statement("type_row", native_jit/words(), native/offset_expression("data", native_jit/metadata(:TypeRow, "type_id"))),
    native/let_statement("kind", :U64, native_jit/row_field(:Type, "type_row", :Kind)),
    native/let_statement("type", h, native_jit/cache(:Type, "type_id")),
    native/let_statement("value", h, "null"),
    native/if_statement(native/binary_expression(:Less, "kind", "n8"), [
      native/let_statement("bits", :U64, native_jit/binary(:BitOr, native_jit/row_field(:Constant, "row", :Low), native_jit/binary(:ShiftLeft, native_jit/row_field(:Constant, "row", :High), "n32"))),
      native/when_statement(native/binary_expression(:Equal, native_jit/row_field(:Constant, "row", :Negative), "n1"), [native/set_statement("bits", native_jit/binary(:Subtract, "n0", "bits"))]),
      native/let_statement("signed", :I64, native/unary_expression(:Bitcast, "bits")),
      native/if_statement(native/binary_expression(:Equal, "kind", "n6"), [native/set_statement("value", native_jit/j("bitcast", ["ctx", native_jit/j("integer", ["ctx", native_jit/cache(:Type, "n3"), "signed"]), "type"]))], [native/set_statement("value", native_jit/j("integer", ["ctx", "type", "signed"]))])
    ], [native/set_statement("value", native_jit/j("null", ["ctx", "type"]))]),
    native_jit/publish(:Rvalue, "id", "value"), native_jit/publish_metadata(:NodeType, "id", "type_id")]), native/return_void()])
  context = native_jit/define(context, "zero", [
    native/let_statement("type_row", native_jit/words(), native/offset_expression("data", native_jit/metadata(:TypeRow, "type_id"))),
    native/let_statement("kind", :U64, native_jit/row_field(:Type, "type_row", :Kind)), native/let_statement("type", h, native_jit/cache(:Type, "type_id")),
    native/when_statement(native/binary_expression(:Equal, "kind", "n8"), [native/return_value(native_jit/j("null", ["ctx", "type"]))]),
    native/when_statement(native/binary_expression(:Equal, "kind", "n13"), [native/return_value(native_jit/j("null", ["ctx", "type"]))]),
    native/when_statement(native/binary_expression(:Equal, "kind", "n9"), native_jit/consume_arguments([], "record", ["ctx", "type"], [:Return])),
    native/when_statement(native/binary_expression(:Equal, "kind", "n10"), native_jit/consume_arguments([], "record", ["ctx", "type"], [:Return])),
    native/return_value(native_jit/j("zero", ["ctx", "type"]))])
  context = native_jit/define(context, "globals", [@native_jit/scan(native_jit/section(:Global), [
    native/let_statement("id", :U64, native_jit/row_field(:Global, "row", :Id)), native/let_statement("type_id", :U64, native_jit/row_field(:Global, "row", :Type)),
    native/let_statement("type", h, native_jit/cache(:Type, "type_id")), native/let_statement("declared_type", h, "type"),
    native/when_statement(native/binary_expression(:Equal, native_jit/row_field(:Global, "row", :Storage), "n1"), [native/set_statement("declared_type", native_jit/j("const_type", ["type"]))]),
    native/let_statement("global", h, native_jit/j("global", ["ctx", "declared_type", native_jit/text(native_jit/row_field(:Global, "row", :Name))])),
    native/when_statement(native/binary_expression(:Equal, native_jit/row_field(:Global, "row", :Storage), "n2"), [native/do_statement(native/call_expression("j_tls", ["global"]))]),
    native/let_statement("value", h, native_jit/invoke("zero", ["type_id"], h)),
    native/when_statement(native/binary_expression(:Equal, native_jit/row_field(:Global, "row", :Initializer), "n1"), [native/set_statement("value", native_jit/cache(:Rvalue, native_jit/row_tail(:Global, "row", 0)))]),
    native/when_statement(native/binary_expression(:Equal, native_jit/row_field(:Global, "row", :Initializer), "n2"), [
      @native_jit/consume_prepared_arguments([
        native/let_statement("position", :U64, native_jit/n(native_jit/tail_start(:Global))),
        native/while_statement(native/binary_expression(:Less, "position", native_jit/word("row", 0)), [
          native_jit/publish(:Arguments, native_jit/binary(:Subtract, "position", native_jit/n(native_jit/tail_start(:Global))), native_jit/integer(native_jit/at("row", "position", :U64), native_jit/cache(:Type, "n1"))),
          native/set_statement("position", native_jit/binary(:Add, "position", "n1"))])],
        "array_value", ["ctx", native_jit/cache(:ArrayRepresentation, "type_id")], native_jit/binary(:Subtract, "position", native_jit/n(native_jit/tail_start(:Global))), [:Let, "bytes"]),
      @native_jit/consume_arguments(["bytes"], "record", ["ctx", "type"], [:Set, "value"]) ]),
    native/let_statement("initialized", h, native_jit/j("global_init", ["global", "value"])),
    native_jit/publish(:Lvalue, "id", "initialized"), native_jit/publish(:Rvalue, "id", native_jit/j("value", ["initialized"])), native_jit/publish_metadata(:NodeType, "id", "type_id")]), native/return_void()])
  return context
end
