verb native_jit/define_helpers(input: map) -> map
  let context: map = input
  let h: list = native_jit/handle()
  let scratch = native/typed_expression([:Pointer, h, :Mutable], native/offset_expression("cache", native_jit/slot(6, "n0")))
  context = native_jit/define(context, "guard", [
    native_jit/bind("function", h, native_jit/cached(0, native_jit/meta(3, "block_id"))),
    native_jit/bind("success", h, native_jit/j("block", ["function", native_jit/literal("s_ok")])),
    native_jit/bind("failure", h, native_jit/j("block", ["function", native_jit/literal("s_fail")])),
    native/do_statement(native/call_expression("j_branch", [native_jit/cached(7, "block_id"), "valid", "success", "failure"])),
    native_jit/bind("abort", h, native_jit/j("builtin", ["ctx", native_jit/literal("s_abort")])),
    native/do_statement(native/call_expression("j_eval", ["failure", native_jit/j("call", ["ctx", "abort", "n0", scratch])])),
    native/do_statement(native/call_expression("j_jump", ["failure", "success"])),
    native_jit/save(7, "block_id", "success"), native_jit/ret("success")])
  // For the native IR's ordinary C types, sizeof({U8 pad; T item;}) -
  // sizeof(T) is alignof(T). This uses GCC layout, including aggregate padding.
  // GCC 14 has new_sizeof but does not expose new_alignof.
  context = native_jit/define(context, "align", [
    native_jit/bind("cached", h, native_jit/cached(8, "type_id")),
    native_jit/unless(native/binary_expression(:Equal, "cached", "null"), [native_jit/ret("cached")]),
    native_jit/bind("type", h, native_jit/cached(3, "type_id")),
    native_jit/bind("probe", h, native_jit/j("struct", ["ctx", native_jit/literal("s_align")])),
    native_jit/save(6, "n0", native_jit/j("field", ["ctx", native_jit/cached(3, "n1"), native_jit/literal("s_pad")])),
    native_jit/save(6, "n1", native_jit/j("field", ["ctx", "type", native_jit/literal("s_item")])),
    native/do_statement(native/call_expression("j_fields", ["probe", "n2", scratch])),
    native_jit/bind("size", h, native_jit/j("cast", ["ctx", native_jit/j("sizeof", ["ctx", native_jit/j("struct_type", ["probe"])]), native_jit/cached(3, "n4")])),
    native_jit/bind("item_size", h, native_jit/j("cast", ["ctx", native_jit/j("sizeof", ["ctx", "type"]), native_jit/cached(3, "n4")])),
    native_jit/bind("alignment", h, native_jit/j("sub", ["ctx", native_jit/cached(3, "n4"), "size", "item_size"])),
    native_jit/save(8, "type_id", "alignment"), native_jit/ret("alignment")])
  context = native_jit/define(context, "heap_test", [
    native_jit/bind("row", native_jit/words(), native/offset_expression("data", native_jit/meta(1, "type_id"))),
    native_jit/bind("position", :U64, "n6"), native_jit/bind("test", h, native_jit/j("zero", ["ctx", native_jit/cached(3, "n7")])),
    native_jit/bind("wide", h, native_jit/j("cast", ["ctx", "tag", native_jit/cached(3, "n4")])),
    native/while_statement(native/binary_expression(:Less, "position", native_jit/word("row", 0)), [
      native_jit/bind("expected", h, native_jit/integer(native_jit/at("row", "position", :U64), native_jit/cached(3, "n4"))),
      native_jit/set("test", native_jit/j("logical_or", ["ctx", native_jit/cached(3, "n7"), "test", native_jit/j("eq", ["ctx", "wide", "expected"])])),
      native_jit/set("position", native_jit/binary(:Add, "position", "n1"))]), native_jit/ret("test")])
  return context
end
