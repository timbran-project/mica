verb native_jit/handle() -> list
  return [:Pointer, :U8, :Mutable]
end
verb native_jit/words() -> list
  return [:Pointer, :U64, :Const]
end
verb native_jit/common() -> list
  let h: list = native_jit/handle()
  return [["ctx", h, :Borrow], ["data", native_jit/words(), :Borrow],
    ["cache", [:Pointer, h, :Mutable], [:Borrow, "ctx"]], ["meta", [:Pointer, :U64, :Mutable], :Borrow]]
end
verb native_jit/n(number: int) -> string
  return string_concat("n", to_literal(number))
end
verb native_jit/at(base, index, type_id) -> list
  let result: list = native/typed_load(type_id, native/typed_expression([:Pointer, type_id, :Const], native/offset_expression(base, index)))
  return result
end
verb native_jit/word(base, offset: int) -> list
  let result: list = native_jit/at(base, native_jit/n(offset), :U64)
  return result
end
verb native_jit/number(offset) -> list
  let result: list = native_jit/at("data", offset, :U64)
  return result
end
verb native_jit/binary(op: symbol, left, right) -> list
  let result: list = native/typed_expression(:U64, native/binary_expression(op, left, right))
  return result
end
// The ID domain and handle category are separate: declarations and blocks
// share a plane because checked IR IDs are globally unique. Scratch has ordinal
// indices, while types and fields use their own serialized identity domains.
verb native_jit/cache_planes() -> list
  return [:Declaration, :Rvalue, :Lvalue, :Type, :Structure, :Field,
    :Arguments, :BlockTail, :Alignment, :ArrayRepresentation]
end

verb native_jit/metadata_planes() -> list
  return [:NodeType, :TypeRow, :TypeComplete, :BlockOwner]
end

verb native_jit/slot(planes: list, kind: symbol, id) -> list
  let table: int = native_jit/position(planes, kind)
  let result: list = native_jit/binary(:Add, native_jit/binary(:Multiply, "capacity", native_jit/n(table)), id)
  return result
end

verb native_jit/cache(kind: symbol, id) -> list
  let h: list = native_jit/handle()
  let result: list = native/typed_load(h, native/typed_expression([:Pointer, h, :Mutable], native/offset_expression("cache", native_jit/slot(native_jit/cache_planes(), kind, id))))
  return result
end

verb native_jit/publish(kind: symbol, id, value) -> list
  let h: list = native_jit/handle()
  let result: list = native/store_statement(native/typed_expression([:Pointer, h, :Mutable], native/offset_expression("cache", native_jit/slot(native_jit/cache_planes(), kind, id))), value)
  return result
end

verb native_jit/metadata(kind: symbol, id) -> list
  let result: list = native/typed_load(:U64, native/typed_expression([:Pointer, :U64, :Mutable], native/offset_expression("meta", native_jit/slot(native_jit/metadata_planes(), kind, id))))
  return result
end

verb native_jit/publish_metadata(kind: symbol, id, value) -> list
  let result: list = native/store_statement(native/typed_expression([:Pointer, :U64, :Mutable], native/offset_expression("meta", native_jit/slot(native_jit/metadata_planes(), kind, id))), value)
  return result
end
verb native_jit/j(name: string, args: list) -> list
  let result: list = native/typed_call(native_jit/handle(), string_concat("j_", name), args)
  return result
end
verb native_jit/invoke(name: string, args: list, type_id) -> list
  if type_id == :Void
    let result: list = native/call_expression(string_concat("jit_", name), ["ctx", "data", "cache", "meta", @args])
    return result
  end
  let typed_result: list = native/typed_call(type_id, string_concat("jit_", name), ["ctx", "data", "cache", "meta", @args])
  return typed_result
end
verb native_jit/text(offset) -> list
  let bytes = [:Pointer, :U8, :Const]
  let base = native/typed_expression(bytes, native/unary_expression(:PointerCast, "data"))
  let result: list = native/typed_expression(bytes, native/offset_expression(base, native_jit/binary(:Add, native_jit/binary(:Multiply, native_jit/word("data", 1), "n8"), offset)))
  return result
end
verb native_jit/prologue() -> list
  return [native/let_statement("capacity", :U64, native_jit/word("data", 5))]
end
verb native_jit/scan(section: int, body: list) -> list
  return [native/let_statement("cursor", :U64, native_jit/word("data", 6 + section * 2)),
    native/while_statement(native/binary_expression(:Less, "cursor", native_jit/word("data", 7 + section * 2)), [
      native/let_offset("row", native_jit/words(), "data", "cursor"), @body,
      native/set_statement("cursor", native_jit/binary(:Add, "cursor", native_jit/word("row", 0)))])]
end
verb native_jit/declare(input: map, name: string, result, parameters: list) -> map
  let mode: symbol = :Value
  let owner: string = ""
  if native/is_pointer(result)
    mode = :Borrow
    owner = "ctx"
  end
  let context: map = native/declare_function(input, string_concat("jit_", name), result,
    [@native_jit/common(), @parameters], [], [:ReadMemory, :WriteMemory, :Allocate], mode, owner)
  return context
end
verb native_jit/define(input: map, name: string, statements: list) -> map
  let context: map = native/define_function(input, string_concat("jit_", name), [@native_jit/prologue(), @statements])
  return context
end

// Argument storage is shared within a compilation. Complete a call before
// preparing another argument list; the libgccjit call consumes the handles.
verb native_jit/argument_buffer() -> list
  let result: list = native/typed_expression([:Pointer, native_jit/handle(), :Mutable],
    native/offset_expression("cache", native_jit/slot(native_jit/cache_planes(), :Arguments, "n0")))
  return result
end

verb native_jit/arguments(values: list) -> list
  let body: list = []
  let index: int = 0
  for value in values
    body = [@body, native_jit/publish(:Arguments, native_jit/n(index), value)]
    index = index + 1
  end
  return body
end

// Serialized operands are node IDs. Resolve each ID to its rvalue handle and
// bind argument_count for the call or aggregate constructor that follows.
verb native_jit/row_arguments(first: int) -> list
  return [native/let_statement("argument", :U64, native_jit/n(first)),
    native/let_statement("argument_count", :U64, "n0"),
    native/while_statement(native/binary_expression(:Less, "argument", native_jit/word("row", 0)), [
      native_jit/publish(:Arguments, "argument_count", native_jit/cache(:Rvalue, native_jit/at("row", "argument", :U64))),
      native/set_statement("argument", native_jit/binary(:Add, "argument", "n1")),
      native/set_statement("argument_count", native_jit/binary(:Add, "argument_count", "n1"))])]
end

// A consumer identifies how a completed GCC call enters the target program.
// Preparing scratch and consuming it are one operation. Prefix expressions
// cannot contain another scratch-backed constructor.
verb native_jit/argument_buffer_use(tree, buffer: list, calls_only: bool) -> bool
  if !calls_only && tree == buffer
    return true
  end
  if !is_kind(tree, :list) || len(tree) == 0
    return false
  end
  if calls_only && tree[0] == :Call
    let uses_buffer: bool = native_jit/argument_buffer_use(tree, buffer, false)
    return uses_buffer
  end
  for child in tree
    if native_jit/argument_buffer_use(child, buffer, calls_only)
      return true
    end
  end
  return false
end

verb native_jit/uses_argument_buffer(tree) -> bool
  let result: bool = native_jit/argument_buffer_use(tree, native_jit/argument_buffer(), false)
  return result
end

// Preparing slot zero takes the buffer's address too. Only a call that reads
// the shared array can consume another preparation's unfinished arguments.
verb native_jit/nested_argument_call(tree) -> bool
  let result: bool = native_jit/argument_buffer_use(tree, native_jit/argument_buffer(), true)
  return result
end

verb native_jit/argument_call(api: string, prefix: list, count) -> list
  native/ensure(!native_jit/uses_argument_buffer(prefix), "nested JIT argument scratch consumer")
  let name: string = string_concat("j_", api)
  let declarations: list = [declaration for declaration in native_jit/api() if declaration[0] == name]
  native/ensure(len(declarations) == 1, "unknown JIT argument consumer")
  let declaration: list = declarations[0]
  let parameters: list = declaration[2]
  native/ensure(len(parameters) == len(prefix) + 2 && parameters[len(prefix)][1] == :U64 && parameters[len(prefix) + 1][1] == [:Pointer, native_jit/handle(), :Mutable], "JIT argument consumer signature mismatch")
  let arguments: list = [@prefix, count, native_jit/argument_buffer()]
  if declaration[1] == :Void
    let result: list = native/call_expression(name, arguments)
    return result
  end
  let result: list = native/typed_call(declaration[1], name, arguments)
  return result
end

verb native_jit/finish_call(call, consumer: list) -> list
  if consumer[0] == :Do
    return [native/do_statement(call)]
  end
  if consumer[0] == :Let
    return [native/let_statement(consumer[1], native_jit/handle(), call)]
  end
  if consumer[0] == :Return
    return [native/return_value(call)]
  end
  if consumer[0] == :Publish
    return [native_jit/publish(consumer[1], consumer[2], call)]
  end
  if consumer[0] == :Set
    return [native/set_statement(consumer[1], call)]
  end
  if consumer[0] == :Assign
    return [native/do_statement(native/call_expression("j_assign", [consumer[1], consumer[2], call]))]
  end
  if consumer[0] == :Eval
    return [native/do_statement(native/call_expression("j_eval", [consumer[1], call]))]
  end
  native/ensure(consumer[0] == :Tail, "unknown JIT call consumer")
  return [native/let_statement("call", native_jit/handle(), call),
    native/do_statement(native/call_expression("j_require_tail", ["call"])),
    native/do_statement(native/call_expression("j_return", [consumer[1], "call"]))]
end

verb native_jit/consume_prepared_arguments(preparation: list, api: string, prefix: list, count, consumer: list) -> list
  native/ensure(!native_jit/nested_argument_call(preparation), "nested JIT argument scratch preparation")
  native/ensure(!native_jit/uses_argument_buffer(count) && !native_jit/uses_argument_buffer(consumer), "nested JIT argument scratch consumer")
  return [@preparation, @native_jit/finish_call(native_jit/argument_call(api, prefix, count), consumer)]
end

verb native_jit/consume_arguments(values: list, api: string, prefix: list, consumer: list) -> list
  native/ensure(!native_jit/uses_argument_buffer(values), "nested JIT argument scratch preparation")
  let result: list = native_jit/consume_prepared_arguments(native_jit/arguments(values), api, prefix, native_jit/n(len(values)), consumer)
  return result
end

verb native_jit/consume_operands(first: int, api: string, prefix: list, consumer: list) -> list
  let result: list = native_jit/consume_prepared_arguments(native_jit/row_arguments(first), api, prefix, "argument_count", consumer)
  return result
end

verb native_jit/builtin_call(destination: string, literal: string, arguments: list) -> list
  let body: list = native_jit/consume_arguments(arguments, "call",
    ["ctx", native_jit/j("builtin", ["ctx", native_jit/literal(literal)])], [:Set, destination])
  return body
end

verb native_jit/evaluate_builtin(block, literal: string, arguments: list) -> list
  let body: list = native_jit/consume_arguments(arguments, "call",
    ["ctx", native_jit/j("builtin", ["ctx", native_jit/literal(literal)])], [:Eval, block])
  return body
end

verb native_jit/indirect_call(callee: string, first: int, ?tail: bool = false) -> list
  let consumer: list = [:Set, "value"]
  if tail
    consumer = [:Tail, "block"]
  end
  return [native_jit/trap_unless(native_jit/j("ne", ["ctx", callee,
      native_jit/j("null", ["ctx", native_jit/j("value_type", [callee])])])),
    @native_jit/consume_operands(first, "call_indirect", ["ctx", callee], consumer)]
end

// Cache planes: 0 declarations/blocks, 1 rvalues, 2 lvalues, 3 types,
// 4 struct handles, 5 fields, 6 argument scratch, 7 current block tails,
// 8 alignment expressions, 9 underlying array types. Metadata planes hold
// 0 node type IDs, 1 type row offsets, 2 completed types, 3 block owners.
verb native_jit/program() -> map
  let declarations: list = [["true", :Bool, "true"], ["false", :Bool, "false"], ["null", native_jit/handle(), "null"]]
  let i: int = 0
  while i <= 128
    declarations = [@declarations, [native_jit/n(i), :U64, native_value/hex(i)]]
    i = i + 1
  end
  declarations = [@declarations, ["mask56", :U64, "00ffffffffffffff"], ["float_exponent", :U64, "000000007f800000"],
    ["signed_max", :I64, "7fffffffffffffff"], ["signed_min", :I64, "-8000000000000000"], ["signed_minus_one", :I64, "-0000000000000001"], ["signed_zero", :I64, "0000000000000000"]]
  let [constants, initial_state] = native/constants(native/program(), declarations)
  let state: map = initial_state
  for literal in native_jit/literals()
    let bytes: list = [@native_jit/ascii(literal[1]), 0]
    let [id, next] = native/add_global(state, literal[0], [:Array, :U8, len(bytes)], :Constant, bytes)
    state = next
    constants[literal[0]] = id
  end
  let context: map = native_jit/bindings(native/module_context(state, constants))
  context = native_jit/declare(context, "types", :Bool, [])
  context = native_jit/declare(context, "functions", :Void, [])
  context = native_jit/declare(context, "locals", :Void, [])
  context = native_jit/declare(context, "blocks", :Void, [])
  context = native_jit/declare(context, "constants", :Void, [])
  context = native_jit/declare(context, "globals", :Void, [])
  context = native_jit/declare(context, "zero", native_jit/handle(), [["type_id", :U64, :Value]])
  context = native_jit/declare(context, "instruction", :U64, [["row", native_jit/words(), :Borrow]])
  context = native_jit/declare(context, "instructions", :U64, [])
  context = native_jit/declare(context, "terminators", :Void, [])
  context = native_jit/declare(context, "build", :U64, [])
  context = native_jit/declare(context, "guard", native_jit/handle(), [["block_id", :U64, :Value], ["valid", native_jit/handle(), [:Borrow, "ctx"]]])
  context = native_jit/declare(context, "align", native_jit/handle(), [["type_id", :U64, :Value]])
  context = native_jit/declare(context, "heap_test", native_jit/handle(), [["type_id", :U64, :Value], ["tag", native_jit/handle(), [:Borrow, "ctx"]]])
  context = native_jit/define_helpers(context)
  context = native_jit/define_types(context)
  context = native_jit/define_declarations(context)
  context = native_jit/define_instructions(context)
  context = native_jit/define(context, "build", [
    native/unless_statement(native_jit/invoke("types", [], :Bool), [native/return_value("n128")]),
    native/do_statement(native_jit/invoke("functions", [], :Void)),
    native/do_statement(native_jit/invoke("locals", [], :Void)),
    native/do_statement(native_jit/invoke("blocks", [], :Void)),
    native/do_statement(native_jit/invoke("constants", [], :Void)),
    native/do_statement(native_jit/invoke("globals", [], :Void)),
    native/let_statement("status", :U64, native_jit/invoke("instructions", [], :U64)),
    native/unless_statement(native/binary_expression(:Equal, "status", "n0"), [native/return_value("status")]),
    native/do_statement(native_jit/invoke("terminators", [], :Void)), native/return_value("n0")])
  let program: map = context[:state]
  return program
end

verb native_jit/literals() -> list
  return [["s_abort", "__builtin_abort"], ["s_memmove", "__builtin_memmove"], ["s_trunc", "__builtin_truncf"], ["s_fmod", "__builtin_fmodf"],
    ["s_align", "alignment_probe"], ["s_pad", "pad"], ["s_item", "item"], ["s_ok", "guard_ok"], ["s_fail", "guard_fail"], ["s_join", "checked_join"]]
end
verb native_jit/ascii(name: string) -> list
  let letters: list = string_chars("abcdefghijklmnopqrstuvwxyz")
  let result: list = []
  for ch in string_chars(name)
    let byte: int = 95
    if ch != "_"
      byte = 97 + native_jit/position(letters, ch)
    end
    result = [@result, byte]
  end
  return result
end
verb native_jit/literal(name: string) -> list
  let spelling: string = [row[1] for row in native_jit/literals() if row[0] == name][0]
  let array: list = [:Array, :U8, string_len(spelling) + 1]
  let result: list = native/typed_expression([:Pointer, :U8, :Const], native/unary_expression(:PointerCast,
    native/typed_expression([:Pointer, array, :Const], native/unary_expression(:GlobalAddress, name))))
  return result
end
verb native_jit/integer(number, type_id) -> list
  let result: list = native_jit/j("integer", ["ctx", type_id, native/typed_expression(:I64, native/unary_expression(:Bitcast, number))])
  return result
end
verb native_jit/trap_unless(valid) -> list
  let result: list = native/set_statement("block", native_jit/invoke("guard", ["block_id", valid], native_jit/handle()))
  return result
end
