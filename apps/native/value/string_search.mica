// Search valid UTF-8 by bytes, then return a scalar position. A complete match
// starts at a scalar boundary because a valid needle cannot start with a
// continuation byte. Longer needles use a stack-resident Horspool skip table.
verb native_value/string_search(input: map) -> map
  let context: map = input
  let name: string = "value_string_find"
  let word: list = native_value/word()
  let header: list = [:Record, "HeapString"]
  let result: list = [:Record, "IdResult"]
  let table: list = [:Array, :U64, 256]
  let [constant, state] = native/add_constant(context[:state], :U64, "0000000000000100")
  context[:state] = state
  let constants: map = context[:constants]
  constants["byte_domain"] = constant
  context[:constants] = constants
  context = native_value/function(context, name, result, [["value", word, :Borrow], ["needle", word, :Borrow], ["start", :U64, :Value]],
    [], [:ReadMemory, :WriteMemory], :Value, "")
  context = native_value/body(context, name, [
    [:Let, "offset_result", result, [:Call, "value_string_byte_offset", "value", "start"]],
    [:Let, "condition", :Bool, [:Field, "offset_result", "ok"]],
    [:Let, "candidate", :U64, [:Field, "offset_result", "number"]],
    [:If, "condition", [], [[:Return, [:Zero]]]],
    [:Let, "checked", [:Record, "HeapStringResult"], [:Call, "value_as_string", "needle"]],
    [:If, [:Field, "checked", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "needle_pointer", [:Pointer, header, :Const], [:Field, "checked", "header"]],
    [:Let, "pattern", header, [:Load, "needle_pointer"]],
    [:Let, "hay_pointer", [:Pointer, header, :Const], [:UnpackPointer, "value"]],
    [:Let, "hay", header, [:Load, "hay_pointer"]],
    [:Let, "hay_data", [:Pointer, :U8, :Mutable], [:Field, "hay", "data"]],
    [:Let, "hay_length", :U64, [:Field, "hay", "length"]],
    [:Let, "needle_data", [:Pointer, :U8, :Mutable], [:Field, "pattern", "data"]],
    [:Let, "needle_length", :U64, [:Field, "pattern", "length"]],
    [:If, [:Equal, "needle_length", "zero"], [[:Let, "result", result, [:Record, "true", "start"]], [:Return, "result"]], []],
    [:Let, "remaining", :U64, [:Subtract, "hay_length", "candidate"]],
    [:If, [:Less, "remaining", "needle_length"], [[:Return, [:Zero]]], []],
    [:Let, "limit", :U64, [:Subtract, "hay_length", "needle_length"]],
    [:Let, "last", :U64, [:Subtract, "needle_length", "one"]],
    [:Set, "condition", [:Less, "needle_length", "utf64_4"]],
    [:Let, "skip", :Bool, "false"],
    [:Let, "table", table, [:Zero]],
    [:Let, "table_address", [:Pointer, table, :Mutable], [:Address, "table"]],
    [:If, "condition", [], [
      [:Set, "skip", "true"],
      [:Let, "index", :U64, "zero"],
      [:While, [:Less, "index", "byte_domain"], [
        [:Let, "table_slot", [:Pointer, :U64, :Mutable], [:ElementPointer, "table_address", "index"]],
        [:Do, [:Store, "table_slot", "needle_length"]],
        [:Set, "index", [:Add, "index", "one"]]
      ]],
      [:Set, "index", "zero"],
      [:While, [:Less, "index", "last"], [
        [:Let, "needle_slot", [:Pointer, :U8, :Mutable], [:Offset, "needle_data", "index"]],
        [:Let, "needle_byte", :U8, [:Load, "needle_slot"]],
        [:Let, "byte", :U64, [:Convert, "needle_byte"]],
        [:Set, "table_slot", [:ElementPointer, "table_address", "byte"]],
        [:Let, "step", :U64, [:Subtract, "last", "index"]],
        [:Do, [:Store, "table_slot", "step"]],
        [:Set, "index", [:Add, "index", "one"]]
      ]]
    ]],
    [:Note, :Invariant, "A valid UTF-8 needle can match only at a scalar boundary."],
    [:While, "true", [
      [:Set, "index", "zero"],
      [:While, [:Less, "index", "needle_length"], [
        [:Set, "byte", [:Add, "candidate", "index"]],
        [:Let, "hay_slot", [:Pointer, :U8, :Mutable], [:Offset, "hay_data", "byte"]],
        [:Let, "hay_byte", :U8, [:Load, "hay_slot"]],
        [:Set, "needle_slot", [:Offset, "needle_data", "index"]],
        [:Set, "needle_byte", [:Load, "needle_slot"]],
        [:If, [:Equal, "hay_byte", "needle_byte"], [], [[:Break]]],
        [:Set, "index", [:Add, "index", "one"]]
      ]],
      [:If, [:Equal, "index", "needle_length"], [
        [:If, [:Field, "hay", "ascii"], [[:Set, "result", [:Record, "true", "candidate"]], [:Return, "result"]], []],
        [:Let, "text", [:Pointer, :U8, :Const], [:Freeze, "hay_data"]],
        [:Let, "scan", [:Record, "Utf8Scan"], [:Call, "utf8_scan", "text", "candidate"]],
        [:If, [:Field, "scan", "ok"], [], [[:Return, [:Zero]]]],
        [:Set, "candidate", [:Field, "scan", "scalars"]],
        [:Set, "result", [:Record, "true", "candidate"]],
        [:Return, "result"]
      ], []],
      [:If, "skip", [
        [:Set, "byte", [:Add, "candidate", "last"]],
        [:Set, "hay_slot", [:Offset, "hay_data", "byte"]],
        [:Set, "hay_byte", [:Load, "hay_slot"]],
        [:Set, "byte", [:Convert, "hay_byte"]],
        [:Set, "table_slot", [:ElementPointer, "table_address", "byte"]],
        [:Set, "step", [:Load, "table_slot"]]
      ], [[:Set, "step", "one"]]],
      [:Set, "remaining", [:Subtract, "limit", "candidate"]],
      [:If, [:Less, "remaining", "step"], [[:Return, [:Zero]]], []],
      [:Set, "candidate", [:Add, "candidate", "step"]]
    ]],
    [:Return, [:Zero]]
  ])
  return context
end
