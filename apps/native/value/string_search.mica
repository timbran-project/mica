verb native_value/string_field(builder: map, value: map, field: string) -> map
  let header: map = native_gen/expression(native_memory/record_pointer("HeapString"), :UnpackPointer, [value])
  let result: map = native_gen/read(native_gen/field(builder, header, field))
  return result
end
verb native_value/string_byte(builder: map, value: map, position: map) -> map
  let result: map = native_gen/load(native_gen/offset(native_value/string_field(builder, value, "data"), position))
  return result
end

// Callers establish the extents. Read bytes after each checkpoint so rooted
// strings can move; no borrowed data pointer survives the callback.
verb native_value/bytes_equal(builder: map, text: map, pattern: map, offset: map, length: map, checkpoint) -> list
  let [equal: map, ready: map] = native_gen/bind(builder, "equal", native_gen/ref(builder, "true"))
  ready = native_gen/for_range(ready, "byte", native_gen/ref(ready, "zero"), length, fn(step, index)
    let checked: map = checkpoint(step)
    let left: map = native_value/string_byte(checked, text, native_gen/add(offset, index))
    let right: map = native_value/string_byte(checked, pattern, index)
    return native_gen/unless(checked, native_gen/equal(left, right), fn(different)
      return native_gen/break_loop(native_gen/assign(different, equal, native_gen/ref(different, "false")))
    end)
  end)
  return [equal, ready]
end

// Shared Horspool search. A valid UTF-8 needle can match only at a scalar
// boundary. Callbacks supply execution controls and the caller's result shape.
verb native_value/find_bytes(builder: map, text: map, pattern: map, start: map, checkpoint, found, missing) -> map
  let [candidate: map, ready: map] = native_gen/bind(builder, "candidate", start)
  let [length: map, with_length: map] = native_gen/bind(ready, "needle_length", native_value/string_field(ready, pattern, "length"))
  ready = native_gen/when(with_length, native_gen/equal(length, native_gen/ref(with_length, "zero")), fn(empty) => found(empty, candidate))
  let available: map = native_gen/subtract(native_value/string_field(ready, text, "length"), candidate)
  ready = native_gen/when(ready, native_gen/less(available, length), missing)
  let [limit: map, bounded: map] = native_gen/bind(ready, "limit", native_gen/subtract(native_value/string_field(ready, text, "length"), length))
  let [last: map, with_last: map] = native_gen/bind(bounded, "last", native_gen/subtract(length, native_gen/ref(bounded, "one")))
  let [table: map, with_table: map] = native_gen/bind(with_last, "skip", native_gen/zero([:Array, :U64, 256]))
  let skip: map = native_gen/negate(native_gen/less(length, native_gen/ref(with_table, "utf64_4")))
  ready = native_gen/when(with_table, skip, fn(prepare)
    let initialized: map = native_gen/for_range(prepare, "byte", native_gen/ref(prepare, "zero"), native_gen/ref(prepare, "byte_domain"), fn(step, index)
      return native_gen/store(step, native_gen/element(native_gen/address(table), index), length)
    end)
    return native_gen/for_range(initialized, "byte", native_gen/ref(initialized, "zero"), last, fn(step, index)
      let checked: map = checkpoint(step)
      let byte: map = native_gen/convert(:U64, native_value/string_byte(checked, pattern, index))
      return native_gen/store(checked, native_gen/element(native_gen/address(table), byte), native_gen/subtract(last, index))
    end)
  end)
  ready = native_gen/while_loop(ready, native_gen/ref(ready, "true"), fn(search)
    let polled: map = checkpoint(search)
    let [equal: map, compared: map] = native_value/bytes_equal(polled, text, pattern, candidate, length, checkpoint)
    let checked: map = native_gen/when(compared, equal, fn(matched) => found(matched, candidate))
    let [stride: map, with_stride: map] = native_gen/bind(checked, "stride", native_gen/ref(checked, "one"))
    checked = native_gen/when(with_stride, skip, fn(skipped)
      let byte: map = native_gen/convert(:U64, native_value/string_byte(skipped, text, native_gen/add(candidate, last)))
      return native_gen/assign(skipped, stride, native_gen/load(native_gen/element(native_gen/address(table), byte)))
    end)
    checked = native_gen/when(checked, native_gen/less(native_gen/subtract(limit, candidate), stride), missing)
    return native_gen/assign(checked, candidate, native_gen/add(candidate, stride))
  end)
  let result: map = missing(ready)
  return result
end

verb native_value/string_search(input: map) -> map
  let context: map = input
  let [constant, state] = native/add_constant(context[:state], :U64, "0000000000000100")
  context[:state] = state
  let constants: map = context[:constants]
  constants["byte_domain"] = constant
  context[:constants] = constants
  context = native/declare_function(context, "value_string_find", [:Record, "IdResult"], [
    ["value", native_value/word(), :Gc], ["needle", native_value/word(), :Gc], ["start", :U64, :Value]],
    [], [:ReadMemory, :WriteMemory], :Value, "")
  let builder: map = native_gen/context(context, "value_string_find")
  let text: map = native_gen/ref(builder, "value")
  let pattern: map = native_gen/ref(builder, "needle")
  let start: map = native_gen/ref(builder, "start")
  let missing = fn(failed) => native_gen/return_zero(failed)
  let [offset: map, checked: map] = native_gen/checked_bind(builder, "offset", native_gen/call(builder, "value_string_byte_offset", [text, start]), "ok", missing)
  let [needle: map, ready: map] = native_gen/checked_bind(checked, "needle", native_gen/call(checked, "value_as_string", [pattern]), "ok", missing)
  let success = fn(body, position) => native_gen/return_value(body, native_gen/record(body, [:Record, "IdResult"], {
    "ok" -> native_gen/ref(body, "true"), "number" -> position}))
  let found = fn(body, candidate)
    let ascii: map = native_gen/when(body, native_value/string_field(body, text, "ascii"), fn(done) => success(done, candidate))
    let [byte: map, with_byte: map] = native_gen/bind(ascii, "byte", native_gen/field(ascii, offset, "number"))
    let [position: map, with_position: map] = native_gen/bind(with_byte, "position", start)
    let counted: map = native_gen/while_loop(with_position, native_gen/less(byte, candidate), fn(step)
      return native_value/advance_utf8(step, native_value/string_field(step, text, "data"), byte, position)
    end)
    return success(counted, position)
  end
  builder = native_value/find_bytes(ready, text, pattern, native_gen/field(ready, offset, "number"), fn(step) => step, found, missing)
  let result: map = native_gen/finish(context, builder)
  return result
end
