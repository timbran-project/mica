// A copy owns every reachable heap allocation in the destination worker.
// Symbol, identity, capability, and function IDs stay in their original namespace.
verb native_value/copying(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let result: list = [:Record, "ValueResult"]
  let worker: list = ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow]
  context = native/declare_function(context, "value_copy", result, [worker, ["value", word, :Gc]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/declare_function(context, "value_tuple_copy", [:Record, "TupleResult"], [worker, ["tuple", [:Record, "ValueTuple"], :Gc]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native_value/copy_tuple(context)
  context = native_value/copy_relation(context)
  let rows: list = [
    native/let_statement("tag", :U8, native/unary_expression(:Tag, "value")),
    native/when_statement(
      native/binary_expression(:Equal, "tag", "zero_tag"),
      [native/return_record(["true", native/typed_call(word, "value_empty_relation", [])])]
    )
  ]
  for kind in native_value/kinds()
    if !kind[2]
      rows = [
        @rows,
        native/when_statement(
          native/binary_expression(:Equal, "tag", string_concat("tag_", kind[0])),
          [
            native/return_record(
              [
                "true",
                native/typed_expression(
                  word,
                  native/binary_expression(
                    :PackImmediate,
                    native/typed_expression(:U64, native/unary_expression(:Payload, "value")),
                    string_concat("tag_", kind[0])
                  )
                )
              ]
            )
          ]
        )
      ]
    end
  end
  for spec in [["string", "HeapString"], ["bytes", "HeapBytes"]]
    let prefix: string = spec[0]
    let pointer: string = string_concat(prefix, "_pointer")
    let header: string = string_concat(prefix, "_header")
    let data: string = string_concat(prefix, "_data")
    let length: string = string_concat(prefix, "_length")
    rows = [
      @rows,
      native/when_statement(native/binary_expression(:Equal, "tag", string_concat("tag_", prefix)), [
        native/let_statement(
          pointer,
          [:Pointer, [:Record, spec[1]], :Const],
          native/unary_expression(:UnpackPointer, "value")
        ),
        native/let_load(header, [:Record, spec[1]], pointer),
        native/let_field(data, [:Pointer, :U8, :Mutable], header, "data"),
        native/let_field(length, :U64, header, "length"),
        native/return_value(
          native/call_expression(
            string_concat("value_", prefix),
            ["worker", native/typed_expression([:Pointer, :U8, :Const], native/unary_expression(:Freeze, data)), length]
          )
        )
      ])
    ]
  end
  for spec in [["list", "HeapList", word], ["map", "HeapMap", [:Record, "ValueMapEntry"]]]
    let prefix: string = spec[0]
    let header_type: list = [:Record, spec[1]]
    let pointer: string = string_concat(prefix, "_pointer")
    let header: string = string_concat(prefix, "_header")
    let source: string = string_concat(prefix, "_source")
    let length: string = string_concat(prefix, "_length")
    let target: string = string_concat(prefix, "_target")
    let destination: string = string_concat(prefix, "_destination")
    let elements: list = [:Pointer, spec[2], :Mutable]
    let body: list = [
      native/let_statement(pointer, [:Pointer, header_type, :Const], native/unary_expression(:UnpackPointer, "value")),
      native/let_load(header, header_type, pointer),
      native/let_field(source, elements, header, "data"),
      native/let_field(length, :U64, header, "length")
    ]
    if prefix == "list"
      body = [
        @body,
        native/let_call(target, [:Pointer, header_type, :Mutable], "list_allocate", ["worker", length, length]),
        native/when_statement(native/binary_expression(:Equal, target, "null_list_header"), [native/return_zero()]),
        native/let_load("list_output_header", header_type, target),
        native/let_field(destination, elements, "list_output_header", "data")
      ]
    else
      body = [
        @body,
        native/let_statement("map_header_size", :U64, native/unary_expression(:SizeOf, header_type)),
        native/let_statement("map_entry_size", :U64, native/unary_expression(:SizeOf, spec[2])),
        @native_memory/allocate_with_tail("map_raw", "map_header_size", "map_entry_size", length,
          "layout_map", [native/return_zero()], "map_limit", "map_bytes", "map_total"),
        native/let_statement(
          target,
          [:Pointer, header_type, :Mutable],
          native/unary_expression(:PointerCast, "map_raw")
        ),
        native/let_offset("map_raw_data", [:Pointer, :U8, :Mutable], "map_raw", "map_header_size"),
        native/let_statement(destination, elements, native/unary_expression(:PointerCast, "map_raw_data"))
      ]
    end
    let index: string = string_concat(prefix, "_i")
    let slot: string = string_concat(prefix, "_slot")
    let output_slot: string = string_concat(prefix, "_output_slot")
    let element: string = string_concat(prefix, "_element")
    let children: list = []
    let output: string = string_concat(prefix, "_output")
    if prefix == "list"
      children = native_value/copy_child(element, output)
    else
      for field in ["key", "value"]
        let child: string = string_concat(prefix, "_", field)
        let copied: string = string_concat(child, "_copy")
        children = [
          @children,
          native/let_field(child, word, element, field),
          @native_value/copy_child(child, copied)
        ]
      end
      children = [
        @children,
        native/let_statement(output, spec[2], native/record_expression(["map_key_copy", "map_value_copy"]))
      ]
    end
    body = [
      @body,
      @native/for_range(index, "zero", length, [
        native/let_offset(slot, elements, source, index),
        native/let_load(element, spec[2], slot),
        @children,
        native/let_offset(output_slot, elements, destination, index),
        native/store_statement(output_slot, output)])
    ]
    if prefix == "map"
      body = [
        @body,
        native/store_statement(target, native/typed_record(header_type, [destination, length]))
      ]
    end
    body = [
      @body,
      native/return_record(
        [
          "true",
          native/typed_expression(word, native/binary_expression(:PackPointer, target, string_concat("tag_", prefix)))
        ]
      )
    ]
    rows = [
      @rows,
      native/when_statement(native/binary_expression(:Equal, "tag", string_concat("tag_", prefix)), body)
    ]
  end
  for spec in [["range", "HeapRange", [["start", word, ""], ["has_end", :Bool, ""], ["end", word, "has_end"]]],
    ["error", "HeapError", [["code", :U32, ""], ["has_message", :Bool, ""], ["message", word, "has_message"], ["has_value", :Bool, ""], ["value", word, "has_value"]]],
    ["frob", "HeapFrob", [["delegate", :U64, ""], ["value", word, ""]]]]
    let pointer: string = string_concat(spec[0], "_pointer")
    let header: string = string_concat(spec[0], "_header")
    let body: list = [
      native/let_statement(
        pointer,
        [:Pointer, [:Record, spec[1]], :Const],
        native/unary_expression(:UnpackPointer, "value")
      ),
      native/let_load(header, [:Record, spec[1]], pointer)
    ]
    let arguments: list = ["worker"]
    for field in spec[2]
      let local: string = string_concat(spec[0], "_", field[0])
      body = [
        @body,
        native/let_field(local, field[1], header, field[0])
      ]
      if field[1] == word
        let copied: string = string_concat(local, "_copy")
        if field[2] == ""
          body = [@body, @native_value/copy_child(local, copied)]
        else
          body = [
            @body,
            native/let_statement(copied, word, native/zero_expression()),
            native/when_statement(string_concat(spec[0], "_", field[2]), [
              @native/try_call(string_concat(copied, "_checked"), result, "value_copy", ["worker", local], [native/return_zero()]),
              native/set_statement(copied, native/field_expression(string_concat(copied, "_checked"), "value"))
            ])
          ]
        end
        arguments = [@arguments, copied]
      else
        arguments = [@arguments, local]
      end
    end
    rows = [
      @rows,
      native/when_statement(native/binary_expression(:Equal, "tag", string_concat("tag_", spec[0])), [
        @body,
        native/return_value(native/call_expression(string_concat("value_", spec[0]), [@arguments]))
      ])
    ]
  end
  rows = [
    @rows,
    native/when_statement(
      native/binary_expression(:Equal, "tag", "tag_relation"),
      [native/return_value(native/call_expression("value_relation_copy", ["worker", "value"]))]
    ),
    native/return_zero()
  ]
  context = native/define_function(context, "value_copy", rows)
  return context
end

verb native_value/copy_child(source: string, destination: string) -> list
  let checked: string = string_concat(destination, "_checked")
  return [
    @native/try_call(checked, [:Record, "ValueResult"], "value_copy", ["worker", source], [native/return_zero()]),
    native/let_field(destination, native_value/word(), checked, "value")
  ]
end

verb native_value/copy_tuple(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let values: list = [:Pointer, word, :Mutable]
  let tuple: list = [:Record, "ValueTuple"]
  context = native/define_function(context, "value_tuple_copy", [
    native/let_field("arity", :U64, "tuple", "arity"),
    native/when_statement(
      native/binary_expression(:Equal, "arity", "zero"),
      [native/return_record(["true", native/typed_zero(tuple)])]
    ),
    native/let_field("source", values, "tuple", "data"),
    native/let_statement("size", :U64, native/unary_expression(:SizeOf, word)),
    native/let_statement("limit", :U64, native/binary_expression(:Divide, "allocation_limit", "size")),
    native/when_statement(native/binary_expression(:Less, "limit", "arity"), [native/return_zero()]),
    native/let_statement("bytes", :U64, native/binary_expression(:Multiply, "arity", "size")),
    @native_memory/allocate("raw", "bytes", "layout_values", [native/return_zero()]),
    native/let_statement("data", values, native/unary_expression(:PointerCast, "raw")),
    @native/for_range("i", "zero", "arity", [
      native/let_offset("input_slot", values, "source", "i"),
      native/let_load("child", word, "input_slot"),
      @native_value/copy_child("child", "copied"),
      native/let_offset("output_slot", values, "data", "i"),
      native/store_statement("output_slot", "copied")]),
    native/return_record(["true", native/typed_record(tuple, ["data", "arity"])])
  ])
  return context
end

verb native_value/copy_relation(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let relation: list = [:Record, "HeapRelation"]
  let tuple: list = [:Record, "ValueTuple"]
  let tuples: list = [:Pointer, tuple, :Mutable]
  let bytes: list = [:Pointer, :U8, :Mutable]
  context = native/declare_function(context, "value_relation_copy", [:Record, "ValueResult"], [
    ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow], ["value", word, :Gc]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, "value_relation_copy", [
    @native/try_call("checked", [:Record, "RelationResult"], "value_relation_view", ["value"], [native/return_zero()]),
    native/let_field("original", relation, "checked", "relation"),
    native/let_field("arity", :U64, "original", "arity"),
    native/let_field("length", :U64, "original", "length"),
    native/when_statement(
      native/binary_expression(:Equal, "arity", "zero"),
      [
        native/when_statement(
          native/binary_expression(:Equal, "length", "zero"),
          [ native/return_record(["true", native/typed_call(word, "value_empty_relation", [])])]
        )
      ]
    ),
    native/let_statement("header_size", :U64, native/unary_expression(:SizeOf, relation)),
    native/let_statement("symbol_size", :U64, native/unary_expression(:SizeOf, :U32)),
    native/let_statement("heading_size", :U64, native/binary_expression(:Multiply, "arity", "symbol_size")),
    native/set_statement("heading_size", native/binary_expression(:Add, "heading_size", "alignment_slack")),
    native/set_statement("heading_size", native/binary_expression(:BitAnd, "heading_size", "alignment_mask")),
    native/let_statement("prefix", :U64, native/binary_expression(:Add, "header_size", "heading_size")),
    native/let_statement("tuple_size", :U64, native/unary_expression(:SizeOf, tuple)),
    @native_memory/allocate_with_tail("raw", "prefix", "tuple_size", "length",
      "layout_relation_copy", [native/return_zero()], "limit", "rows_size", "total"),
    native/let_statement("target", [:Pointer, relation, :Mutable], native/unary_expression(:PointerCast, "raw")),
    native/let_offset("raw_heading", bytes, "raw", "header_size"),
    native/let_statement("heading", [:Pointer, :U32, :Mutable], native/unary_expression(:PointerCast, "raw_heading")),
    native/let_field("source_heading", [:Pointer, :U32, :Mutable], "original", "heading"),
    @native/copy_elements(:U32, "heading", "source_heading", "arity", :Mutable, "i", "source_column", "target_column"),
    native/let_offset("raw_rows", bytes, "raw", "prefix"),
    native/let_statement("rows", tuples, native/unary_expression(:PointerCast, "raw_rows")),
    native/let_field("source_rows", tuples, "original", "rows"),
    native/set_statement("i", "zero"),
    native/while_statement(native/binary_expression(:Less, "i", "length"), [
      native/let_offset("source_row", tuples, "source_rows", "i"),
      @native/try_call("copied", [:Record, "TupleResult"], "value_tuple_copy", ["worker", native/typed_load(tuple, "source_row")], [native/return_zero()]),
      native/let_offset("target_row", tuples, "rows", "i"),
      native/store_statement("target_row", native/typed_field(tuple, "copied", "tuple")),
      native/set_statement("i", native/binary_expression(:Add, "i", "one"))
    ]),
    native/note_statement(
      :Invariant,
      "Copy canonical rows without sorting. No destination pointer borrows the source worker."
    ),
    native/store_statement("target", native/typed_record(relation, ["heading", "arity", "rows", "length"])),
    native/return_record(
      ["true", native/typed_expression(word, native/binary_expression(:PackPointer, "target", "tag_relation"))]
    )
  ])
  return context
end
