// A copy owns every reachable heap allocation in the destination arena.
// Symbol, identity, capability, and function IDs stay in their original namespace.
verb native_value/copying(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let result: list = [:Record, "ValueResult"]
  let arena: list = ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow]
  context = native/declare_function(context, "value_copy", result, [arena, ["value", word, :Borrow]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native/declare_function(context, "value_tuple_copy", [:Record, "TupleResult"], [arena, ["tuple", [:Record, "ValueTuple"], :Borrow]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native_value/copy_tuple(context)
  context = native_value/copy_relation(context)
  let rows: list = [[:Let, "tag", :U8, [:Tag, "value"]],
    [:If, [:Equal, "tag", "zero_tag"], [[:Return, [:Record, "true", [:Expr, word, [:Call, "value_empty_relation"]]]]], []]]
  for kind in native_value/kinds()
    if !kind[2]
      rows = [@rows, [:If, [:Equal, "tag", string_concat("tag_", kind[0])], [
        [:Return, [:Record, "true", [:Expr, word, [:PackImmediate, [:Expr, :U64, [:Payload, "value"]], string_concat("tag_", kind[0])]]]]], []]]
    end
  end
  for spec in [["string", "HeapString"], ["bytes", "HeapBytes"]]
    let prefix: string = spec[0]
    let pointer: string = string_concat(prefix, "_pointer")
    let header: string = string_concat(prefix, "_header")
    let data: string = string_concat(prefix, "_data")
    let length: string = string_concat(prefix, "_length")
    rows = [@rows, [:If, [:Equal, "tag", string_concat("tag_", prefix)], [
      [:Let, pointer, [:Pointer, [:Record, spec[1]], :Const], [:UnpackPointer, "value"]],
      [:Let, header, [:Record, spec[1]], [:Load, pointer]],
      [:Let, data, [:Pointer, :U8, :Mutable], [:Field, header, "data"]],
      [:Let, length, :U64, [:Field, header, "length"]],
      [:Return, [:Call, string_concat("value_", prefix), "arena", [:Expr, [:Pointer, :U8, :Const], [:Freeze, data]], length]]
    ], []]]
  end
  for spec in [["list", "HeapList", word], ["map", "HeapMap", [:Record, "ValueMapEntry"]]]
    let prefix: string = spec[0]
    let header_type: list = [:Record, spec[1]]
    let pointer: string = string_concat(prefix, "_pointer")
    let header: string = string_concat(prefix, "_header")
    let source: string = string_concat(prefix, "_source")
    let length: string = string_concat(prefix, "_length")
    let target: string = string_concat(prefix, "_target")
    let destination: string = string_concat(prefix, "_destination")
    let elements: list = [:Pointer, spec[2], :Mutable]
    let body: list = [
      [:Let, pointer, [:Pointer, header_type, :Const], [:UnpackPointer, "value"]],
      [:Let, header, header_type, [:Load, pointer]],
      [:Let, source, elements, [:Field, header, "data"]],
      [:Let, length, :U64, [:Field, header, "length"]]]
    if prefix == "list"
      body = [@body,
        [:Let, target, [:Pointer, header_type, :Mutable], [:Call, "list_allocate", "arena", length, length]],
        [:If, [:Equal, target, "null_list_header"], [[:Return, [:Zero]]], []],
        [:Let, "list_output_header", header_type, [:Load, target]],
        [:Let, destination, elements, [:Field, "list_output_header", "data"]]]
    else
      body = [@body,
        [:Let, "map_header_size", :U64, [:SizeOf, header_type]],
        [:Let, "map_entry_size", :U64, [:SizeOf, spec[2]]],
        [:Let, "map_limit", :U64, [:Subtract, "allocation_limit", "map_header_size"]],
        [:Set, "map_limit", [:Divide, "map_limit", "map_entry_size"]],
        [:If, [:Less, "map_limit", length], [[:Return, [:Zero]]], []],
        [:Let, "map_bytes", :U64, [:Multiply, length, "map_entry_size"]],
        [:Let, "map_total", :U64, [:Add, "map_header_size", "map_bytes"]],
        [:Let, "map_raw", [:Pointer, :U8, :Mutable], [:Call, "value_arena_allocate", "arena", "map_total"]],
        [:If, [:Equal, "map_raw", "null_bytes"], [[:Return, [:Zero]]], []],
        [:Let, target, [:Pointer, header_type, :Mutable], [:PointerCast, "map_raw"]],
        [:Let, "map_raw_data", [:Pointer, :U8, :Mutable], [:Offset, "map_raw", "map_header_size"]],
        [:Let, destination, elements, [:PointerCast, "map_raw_data"]]]
    end
    let index: string = string_concat(prefix, "_i")
    let slot: string = string_concat(prefix, "_slot")
    let output_slot: string = string_concat(prefix, "_output_slot")
    let element: string = string_concat(prefix, "_element")
    let children: list = []
    let output: string = string_concat(prefix, "_output")
    if prefix == "list"
      children = native_value/copy_child(element, output)
    else
      for field in ["key", "value"]
        let child: string = string_concat(prefix, "_", field)
        let copied: string = string_concat(child, "_copy")
        children = [@children, [:Let, child, word, [:Field, element, field]], @native_value/copy_child(child, copied)]
      end
      children = [@children, [:Let, output, spec[2], [:Record, "map_key_copy", "map_value_copy"]]]
    end
    body = [@body, [:Let, index, :U64, "zero"], [:While, [:Less, index, length], [
      [:Let, slot, elements, [:Offset, source, index]], [:Let, element, spec[2], [:Load, slot]],
      @children, [:Let, output_slot, elements, [:Offset, destination, index]],
      [:Do, [:Store, output_slot, output]], [:Set, index, [:Add, index, "one"]]]]]
    if prefix == "map"
      body = [@body, [:Do, [:Store, target, [:Expr, header_type, [:Record, destination, length]]]]]
    end
    body = [@body, [:Return, [:Record, "true", [:Expr, word, [:PackPointer, target, string_concat("tag_", prefix)]]]]]
    rows = [@rows, [:If, [:Equal, "tag", string_concat("tag_", prefix)], body, []]]
  end
  for spec in [["range", "HeapRange", [["start", word, ""], ["has_end", :Bool, ""], ["end", word, "has_end"]]],
    ["error", "HeapError", [["code", :U32, ""], ["has_message", :Bool, ""], ["message", word, "has_message"], ["has_value", :Bool, ""], ["value", word, "has_value"]]],
    ["frob", "HeapFrob", [["delegate", :U64, ""], ["value", word, ""]]]]
    let pointer: string = string_concat(spec[0], "_pointer")
    let header: string = string_concat(spec[0], "_header")
    let body: list = [[:Let, pointer, [:Pointer, [:Record, spec[1]], :Const], [:UnpackPointer, "value"]],
      [:Let, header, [:Record, spec[1]], [:Load, pointer]]]
    let arguments: list = ["arena"]
    for field in spec[2]
      let local: string = string_concat(spec[0], "_", field[0])
      body = [@body, [:Let, local, field[1], [:Field, header, field[0]]]]
      if field[1] == word
        let copied: string = string_concat(local, "_copy")
        if field[2] == ""
          body = [@body, @native_value/copy_child(local, copied)]
        else
          body = [@body, [:Let, copied, word, [:Zero]],
            [:If, string_concat(spec[0], "_", field[2]), [
              [:Let, string_concat(copied, "_checked"), result, [:Call, "value_copy", "arena", local]],
              [:If, [:Field, string_concat(copied, "_checked"), "ok"], [], [[:Return, [:Zero]]]],
              [:Set, copied, [:Field, string_concat(copied, "_checked"), "value"]]], []]]
        end
        arguments = [@arguments, copied]
      else
        arguments = [@arguments, local]
      end
    end
    rows = [@rows, [:If, [:Equal, "tag", string_concat("tag_", spec[0])],
      [@body, [:Return, [:Call, string_concat("value_", spec[0]), @arguments]]], []]]
  end
  rows = [@rows, [:If, [:Equal, "tag", "tag_relation"], [[:Return, [:Call, "value_relation_copy", "arena", "value"]]], []], [:Return, [:Zero]]]
  context = native/define_function(context, "value_copy", rows)
  return context
end

verb native_value/copy_child(source: string, destination: string) -> list
  let checked: string = string_concat(destination, "_checked")
  return [[:Let, checked, [:Record, "ValueResult"], [:Call, "value_copy", "arena", source]],
    [:If, [:Field, checked, "ok"], [], [[:Return, [:Zero]]]],
    [:Let, destination, native_value/word(), [:Field, checked, "value"]]]
end

verb native_value/copy_tuple(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let values: list = [:Pointer, word, :Mutable]
  let tuple: list = [:Record, "ValueTuple"]
  context = native/define_function(context, "value_tuple_copy", [
    [:Let, "arity", :U64, [:Field, "tuple", "arity"]],
    [:If, [:Equal, "arity", "zero"], [[:Return, [:Record, "true", [:Expr, tuple, [:Zero]]]]], []],
    [:Let, "source", values, [:Field, "tuple", "data"]],
    [:Let, "size", :U64, [:SizeOf, word]],
    [:Let, "limit", :U64, [:Divide, "allocation_limit", "size"]],
    [:If, [:Less, "limit", "arity"], [[:Return, [:Zero]]], []],
    [:Let, "bytes", :U64, [:Multiply, "arity", "size"]],
    [:Let, "raw", [:Pointer, :U8, :Mutable], [:Call, "value_arena_allocate", "arena", "bytes"]],
    [:If, [:Equal, "raw", "null_bytes"], [[:Return, [:Zero]]], []],
    [:Let, "data", values, [:PointerCast, "raw"]],
    [:Let, "i", :U64, "zero"],
    [:While, [:Less, "i", "arity"], [
      [:Let, "input_slot", values, [:Offset, "source", "i"]],
      [:Let, "child", word, [:Load, "input_slot"]], @native_value/copy_child("child", "copied"),
      [:Let, "output_slot", values, [:Offset, "data", "i"]], [:Do, [:Store, "output_slot", "copied"]],
      [:Set, "i", [:Add, "i", "one"]]]],
    [:Return, [:Record, "true", [:Expr, tuple, [:Record, "data", "arity"]]]]])
  return context
end

verb native_value/copy_relation(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let relation: list = [:Record, "HeapRelation"]
  let tuple: list = [:Record, "ValueTuple"]
  let tuples: list = [:Pointer, tuple, :Mutable]
  let bytes: list = [:Pointer, :U8, :Mutable]
  context = native/declare_function(context, "value_relation_copy", [:Record, "ValueResult"], [
    ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow], ["value", word, :Borrow]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native/define_function(context, "value_relation_copy", [
    [:Let, "checked", [:Record, "RelationResult"], [:Call, "value_relation_view", "value"]],
    [:If, [:Field, "checked", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "original", relation, [:Field, "checked", "relation"]],
    [:Let, "arity", :U64, [:Field, "original", "arity"]],
    [:Let, "length", :U64, [:Field, "original", "length"]],
    [:If, [:Equal, "arity", "zero"], [[:If, [:Equal, "length", "zero"], [
      [:Return, [:Record, "true", [:Expr, word, [:Call, "value_empty_relation"]]]]], []]], []],
    [:Let, "header_size", :U64, [:SizeOf, relation]],
    [:Let, "symbol_size", :U64, [:SizeOf, :U32]],
    [:Let, "heading_size", :U64, [:Multiply, "arity", "symbol_size"]],
    [:Set, "heading_size", [:Add, "heading_size", "alignment_slack"]],
    [:Set, "heading_size", [:BitAnd, "heading_size", "alignment_mask"]],
    [:Let, "prefix", :U64, [:Add, "header_size", "heading_size"]],
    [:Let, "tuple_size", :U64, [:SizeOf, tuple]],
    [:Let, "limit", :U64, [:Subtract, "allocation_limit", "prefix"]],
    [:Set, "limit", [:Divide, "limit", "tuple_size"]],
    [:If, [:Less, "limit", "length"], [[:Return, [:Zero]]], []],
    [:Let, "rows_size", :U64, [:Multiply, "length", "tuple_size"]],
    [:Let, "total", :U64, [:Add, "prefix", "rows_size"]],
    [:Let, "raw", bytes, [:Call, "value_arena_allocate", "arena", "total"]],
    [:If, [:Equal, "raw", "null_bytes"], [[:Return, [:Zero]]], []],
    [:Let, "target", [:Pointer, relation, :Mutable], [:PointerCast, "raw"]],
    [:Let, "raw_heading", bytes, [:Offset, "raw", "header_size"]],
    [:Let, "heading", [:Pointer, :U32, :Mutable], [:PointerCast, "raw_heading"]],
    [:Let, "source_heading", [:Pointer, :U32, :Mutable], [:Field, "original", "heading"]],
    [:Let, "i", :U64, "zero"],
    [:While, [:Less, "i", "arity"], [
      [:Let, "source_column", [:Pointer, :U32, :Mutable], [:Offset, "source_heading", "i"]],
      [:Let, "target_column", [:Pointer, :U32, :Mutable], [:Offset, "heading", "i"]],
      [:Do, [:Store, "target_column", [:Expr, :U32, [:Load, "source_column"]]]],
      [:Set, "i", [:Add, "i", "one"]]]],
    [:Let, "raw_rows", bytes, [:Offset, "raw", "prefix"]],
    [:Let, "rows", tuples, [:PointerCast, "raw_rows"]],
    [:Let, "source_rows", tuples, [:Field, "original", "rows"]],
    [:Set, "i", "zero"],
    [:While, [:Less, "i", "length"], [
      [:Let, "source_row", tuples, [:Offset, "source_rows", "i"]],
      [:Let, "copied", [:Record, "TupleResult"], [:Call, "value_tuple_copy", "arena", [:Expr, tuple, [:Load, "source_row"]]]],
      [:If, [:Field, "copied", "ok"], [], [[:Return, [:Zero]]]],
      [:Let, "target_row", tuples, [:Offset, "rows", "i"]],
      [:Do, [:Store, "target_row", [:Expr, tuple, [:Field, "copied", "tuple"]]]],
      [:Set, "i", [:Add, "i", "one"]]]],
    [:Note, :Invariant, "Copy canonical rows without sorting. No destination pointer borrows the source arena."],
    [:Do, [:Store, "target", [:Expr, relation, [:Record, "heading", "arity", "rows", "length"]]]],
    [:Return, [:Record, "true", [:Expr, word, [:PackPointer, "target", "tag_relation"]]]]])
  return context
end
