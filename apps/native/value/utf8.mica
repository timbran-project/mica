// Unicode scalars exclude surrogates. A decoder failure consumes no input;
// callers can distinguish malformed or incomplete input from U+FFFD itself.
verb native_value/utf8(input: map) -> map
  let context: map = input
  let rune: list = [:Scalar, "Rune", :U32]
  let bytes: list = [:Array, :U8, 4]
  let state: map = context[:state]
  for spec in [["RuneResult", [["ok", :Bool], ["rune", rune]]],
               ["Utf8Decode", [["ok", :Bool], ["rune", rune], ["width", :U64]]],
               ["Utf8Encode", [["ok", :Bool], ["bytes", bytes], ["width", :U64]]],
               ["Utf8Scan", [["ok", :Bool], ["scalars", :U64], ["ascii", :Bool]]]]
    state = native/record_type(state, spec[0], spec[1])[1]
  end
  let constants: list = []
  for number in [0, 1, 2, 3, 4, 6, 7, 15, 31, 63, 128, 192, 194, 224, 240, 245, 2048, 55296, 57344, 65536, 1114112]
    constants = [@constants, [string_concat("utf32_", to_literal(number)), :U32, native_value/hex(number)]]
  end
  for number in [2, 3, 4, 8]
    constants = [@constants, [string_concat("utf64_", to_literal(number)), :U64, native_value/hex(number)]]
  end
  constants = [@constants, ["utf8_high_bits", :U64, "8080808080808080"]]
  constants = [@constants, ["utf8_null", [:Pointer, :U8, :Const], "null"]]
  let [ids, next] = native/constants(state, constants)
  let all: map = context[:constants]
  for name, id in ids
    all[name] = id
  end
  context[:constants] = all
  context[:state] = next
  let name: string = "unicode_scalar"
  context = native_value/function(context, name, [:Record, "RuneResult"], [["number", :U32, :Value]],
    [], [], :Value, "")
  context[:state] = native/annotate(context[:state], context[:functions][name], :Source, "apps/native/value/utf8.mica: native_value/utf8")
  context[:state] = native/annotate(context[:state], context[:functions][name], :Invariant, "A successful Rune is at most U+10FFFF and excludes U+D800 through U+DFFF.")
  let failure: list = [[:Return, [:Zero]]]
  context = native_value/body(context, name, [
    [:If, [:Less, "number", "utf32_1114112"], [], failure],
    [:If, [:Less, "number", "utf32_55296"], [], [[:If, [:Less, "number", "utf32_57344"], failure, []]]],
    [:Return, [:Record, "true", [:Expr, rune, [:Wrap, "number"]]]]
  ])
  context = native_value/utf8_decode(context)
  context = native_value/utf8_encode(context)
  context = native_value/utf8_scan(context)
  return context
end

verb native_value/utf8_decode(input: map) -> map
  let context: map = input
  let name: string = "utf8_decode"
  let pointer: list = [:Pointer, :U8, :Const]
  let result: list = [:Record, "Utf8Decode"]
  context = native_value/function(context, name, result, [["source", pointer, :Borrow], ["length", :U64, :Value]],
    [], [:ReadMemory], :Value, "")
  context = native_value/body(context, name, [
    [:Note, :Invariant, "Reject overlong encodings, surrogate scalars, and incomplete sequences without consuming input."],
    [:If, [:Equal, "length", "zero"], [[:Return, [:Zero]]], []],
    [:If, [:Equal, "source", "utf8_null"], [[:Return, [:Zero]]], []],
    [:Let, "byte", :U8, [:Load, "source"]],
    [:Let, "first", :U32, [:Convert, "byte"]],
    [:If, [:Less, "first", "utf32_128"], [[:Let, "number", :U32, "first"], [:Let, "width", :U64, "one"]], [
      [:If, [:Less, "first", "utf32_194"], [[:Return, [:Zero]]], []],
      [:If, [:Less, "first", "utf32_224"], [
        [:Set, "width", "utf64_2"],
        [:Set, "number", [:BitAnd, "first", "utf32_31"]],
        [:Let, "minimum", :U32, "utf32_128"]
      ], [
        [:If, [:Less, "first", "utf32_240"], [[:Set, "width", "utf64_3"], [:Set, "number", [:BitAnd, "first", "utf32_15"]], [:Set, "minimum", "utf32_2048"]], [
          [:If, [:Less, "first", "utf32_245"], [
            [:Set, "width", "utf64_4"],
            [:Set, "number", [:BitAnd, "first", "utf32_7"]],
            [:Set, "minimum", "utf32_65536"]
          ], [[:Return, [:Zero]]]]
        ]]
      ]],
      [:Let, "condition", :Bool, [:Less, "length", "width"]],
      [:Let, "index", :U64, "one"],
      [:If, "condition", [[:Return, [:Zero]]], []],
      [:While, [:Less, "index", "width"], [
        [:Let, "slot", pointer, [:Offset, "source", "index"]],
        [:Set, "byte", [:Load, "slot"]],
        [:Let, "part", :U32, [:Convert, "byte"]],
        [:Set, "first", [:BitAnd, "part", "utf32_192"]],
        [:If, [:Equal, "first", "utf32_128"], [], [[:Return, [:Zero]]]],
        [:Set, "part", [:BitAnd, "part", "utf32_63"]],
        [:Set, "number", [:ShiftLeft, "number", "utf32_6"]],
        [:Set, "number", [:BitOr, "number", "part"]],
        [:Set, "index", [:Add, "index", "one"]]
      ]],
      [:If, [:Less, "number", "minimum"], [[:Return, [:Zero]]], []]
    ]],
    [:Let, "scalar", [:Record, "RuneResult"], [:Call, "unicode_scalar", "number"]],
    [:If, [:Field, "scalar", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "rune", [:Scalar, "Rune", :U32], [:Field, "scalar", "rune"]],
    [:Let, "result", result, [:Record, "true", "rune", "width"]],
    [:Return, "result"]
  ])
  return context
end

verb native_value/utf8_encode(input: map) -> map
  let context: map = input
  let name: string = "utf8_encode"
  let bytes: list = [:Array, :U8, 4]
  let result: list = [:Record, "Utf8Encode"]
  context = native_value/function(context, name, result, [["rune", [:Scalar, "Rune", :U32], :Value]],
    [], [:WriteMemory], :Value, "")
  context = native_value/body(context, name, [
    [:Let, "number", :U32, [:Unwrap, "rune"]],
    [:Let, "scalar", [:Record, "RuneResult"], [:Call, "unicode_scalar", "number"]],
    [:If, [:Field, "scalar", "ok"], [], [[:Return, [:Zero]]]],
    [:If, [:Less, "number", "utf32_128"], [[:Let, "width", :U64, "one"], [:Let, "prefix", :U32, "utf32_0"]], [
      [:If, [:Less, "number", "utf32_2048"], [[:Set, "width", "utf64_2"], [:Set, "prefix", "utf32_192"]], [
        [:If, [:Less, "number", "utf32_65536"], [[:Set, "width", "utf64_3"], [:Set, "prefix", "utf32_224"]], [[:Set, "width", "utf64_4"], [:Set, "prefix", "utf32_240"]]]
      ]]
    ]],
    [:Let, "bytes", bytes, [:Zero]],
    [:Let, "address", [:Pointer, bytes, :Mutable], [:Address, "bytes"]],
    [:Let, "index", :U64, [:Subtract, "width", "one"]],
    [:While, [:Less, "zero", "index"], [
      [:Let, "part", :U32, [:BitAnd, "number", "utf32_63"]],
      [:Set, "part", [:BitOr, "part", "utf32_128"]],
      [:Let, "byte", :U8, [:Convert, "part"]],
      [:Let, "slot", [:Pointer, :U8, :Mutable], [:ElementPointer, "address", "index"]],
      [:Do, [:Store, "slot", "byte"]],
      [:Set, "number", [:ShiftRight, "number", "utf32_6"]],
      [:Set, "index", [:Subtract, "index", "one"]]
    ]],
    [:Set, "part", [:BitOr, "number", "prefix"]],
    [:Set, "byte", [:Convert, "part"]],
    [:Set, "slot", [:ElementPointer, "address", "zero"]],
    [:Do, [:Store, "slot", "byte"]],
    [:Let, "result", result, [:Record, "true", "bytes", "width"]],
    [:Return, "result"]
  ])
  return context
end

verb native_value/utf8_scan(input: map) -> map
  let context: map = input
  let name: string = "utf8_scan"
  let pointer: list = [:Pointer, :U8, :Const]
  let result: list = [:Record, "Utf8Scan"]
  context = native_value/function(context, name, result, [["source", pointer, :Borrow], ["length", :U64, :Value]],
    [], [:ReadMemory, :WriteMemory], :Value, "")
  context[:state] = native/annotate(context[:state], context[:functions][name], :Source, "apps/native/value/utf8.mica: native_value/utf8_scan")
  context[:state] = native/annotate(context[:state], context[:functions][name], :Purpose, "Validate UTF-8 and count Unicode scalars, with an eight-byte ASCII fast path.")
  let failure: list = [[:Return, [:Zero]]]
  context = native_value/body(context, name, [
    [:If, [:Equal, "length", "zero"], [[:Return, [:Record, "true", "zero", "true"]]], []],
    [:If, [:Equal, "source", "utf8_null"], failure, []],
    [:Let, "offset", :U64, "zero"],
    [:Let, "scalars", :U64, "zero"],
    [:Let, "ascii", :Bool, "true"],
    [:Let, "chunk", :U64, [:Zero]],
    [:Let, "chunk_address", [:Pointer, :U64, :Mutable], [:Address, "chunk"]],
    [:Let, "chunk_bytes", [:Pointer, :U8, :Mutable], [:PointerCast, "chunk_address"]],
    [:While, [:Less, "offset", "length"], [
      [:Note, :Invariant, "offset is a scalar boundary within the supplied byte extent."],
      [:Let, "remaining", :U64, [:Subtract, "length", "offset"]],
      [:Let, "slot", pointer, [:Offset, "source", "offset"]],
      [:If, [:Less, "remaining", "utf64_8"], [], [
        [:Note, :Purpose, "Copy eight readable bytes to an aligned local; the high-bit mask is endian neutral."],
        [:Do, [:CopyBytes, "chunk_bytes", "slot", "utf64_8"]],
        [:Set, "chunk", [:Load, "chunk_address"]],
        [:Let, "high", :U64, [:BitAnd, "chunk", "utf8_high_bits"]],
        [:If, [:Equal, "high", "zero"], [[:Set, "offset", [:Add, "offset", "utf64_8"]], [:Set, "scalars", [:Add, "scalars", "utf64_8"]], [:Continue]], []]
      ]],
      [:Let, "byte", :U8, [:Load, "slot"]],
      [:Let, "first", :U32, [:Convert, "byte"]],
      [:If, [:Less, "first", "utf32_128"], [[:Set, "offset", [:Add, "offset", "one"]], [:Set, "scalars", [:Add, "scalars", "one"]], [:Continue]], []],
      [:Let, "decoded", [:Record, "Utf8Decode"], [:Call, "utf8_decode", "slot", "remaining"]],
      [:If, [:Field, "decoded", "ok"], [], failure],
      [:Let, "width", :U64, [:Field, "decoded", "width"]],
      [:Set, "ascii", "false"],
      [:Set, "offset", [:Add, "offset", "width"]],
      [:Set, "scalars", [:Add, "scalars", "one"]]
    ]],
    [:Return, [:Record, "true", "scalars", "ascii"]]
  ])
  return context
end
