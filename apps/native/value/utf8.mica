// Unicode scalars exclude surrogates. A decoder failure consumes no input;
// callers can distinguish malformed or incomplete input from U+FFFD itself.
verb native_value/utf8(input: map) -> map
  let context: map = input
  let rune: list = [:Scalar, "Rune", :U32]
  let bytes: list = [:Array, :U8, 4]
  let state: map = context[:state]
  for spec in [["RuneResult", [["ok", :Bool], ["rune", rune]]],
               ["Utf8Decode", [["ok", :Bool], ["rune", rune], ["width", :U64]]],
               ["Utf8Encode", [["ok", :Bool], ["bytes", bytes], ["width", :U64]]],
               ["Utf8Scan", [["ok", :Bool], ["scalars", :U64], ["ascii", :Bool]]]]
    state = native/record_type(state, spec[0], spec[1])[1]
  end
  let constants: list = []
  for number in [0, 1, 2, 3, 4, 6, 7, 15, 31, 63, 128, 192, 194, 224, 240, 245, 2048, 55296, 57344, 65536, 1114112]
    constants = [@constants, [string_concat("utf32_", to_literal(number)), :U32, native_value/hex(number)]]
  end
  for number in [2, 3, 4, 8]
    constants = [@constants, [string_concat("utf64_", to_literal(number)), :U64, native_value/hex(number)]]
  end
  constants = [@constants, ["utf8_high_bits", :U64, "8080808080808080"]]
  constants = [@constants, ["utf8_null", [:Pointer, :U8, :Const], "null"]]
  let [ids, next] = native/constants(state, constants)
  let all: map = context[:constants]
  for name, id in ids
    all[name] = id
  end
  context[:constants] = all
  context[:state] = next
  let name: string = "unicode_scalar"
  context = native/declare_function(context, name, [:Record, "RuneResult"], [["number", :U32, :Value]],
    [], [], :Value, "")
  context[:state] = native/annotate(
    context[:state],
    context[:functions][name],
    :Source,
    "apps/native/value/utf8.mica: native_value/utf8"
  )
  context[:state] = native/annotate(context[:state], context[:functions][name], :Invariant, "A successful Rune is at most U+10FFFF and excludes U+D800 through U+DFFF.")
  let failure: list = [native/return_zero()]
  context = native/define_function(context, name, [
    native/unless_statement(native/binary_expression(:Less, "number", "utf32_1114112"), failure),
    native/unless_statement(
      native/binary_expression(:Less, "number", "utf32_55296"),
      [native/when_statement(native/binary_expression(:Less, "number", "utf32_57344"), failure)]
    ),
    native/return_record(["true", native/typed_expression(rune, native/unary_expression(:Wrap, "number"))])
  ])
  context = native_value/utf8_decode(context)
  context = native_value/utf8_encode(context)
  context = native_value/utf8_scan(context)
  return context
end

verb native_value/utf8_decode(input: map) -> map
  let context: map = input
  let name: string = "utf8_decode"
  let pointer: list = [:Pointer, :U8, :Const]
  let result: list = [:Record, "Utf8Decode"]
  context = native/declare_function(context, name, result, [["source", pointer, :Borrow], ["length", :U64, :Value]],
    [], [:ReadMemory], :Value, "")
  context = native/define_function(context, name, [
    native/note_statement(
      :Invariant,
      "Reject overlong encodings, surrogate scalars, and incomplete sequences without consuming input."
    ),
    native/when_statement(native/binary_expression(:Equal, "length", "zero"), [native/return_zero()]),
    native/when_statement(native/binary_expression(:Equal, "source", "utf8_null"), [native/return_zero()]),
    native/let_load("byte", :U8, "source"),
    native/let_statement("first", :U32, native/unary_expression(:Convert, "byte")),
    native/if_statement(native/binary_expression(:Less, "first", "utf32_128"), [
      native/let_statement("number", :U32, "first"),
      native/let_statement("width", :U64, "one")
    ], [
      native/when_statement(native/binary_expression(:Less, "first", "utf32_194"), [native/return_zero()]),
      native/if_statement(native/binary_expression(:Less, "first", "utf32_224"), [
        native/set_statement("width", "utf64_2"),
        native/set_statement("number", native/binary_expression(:BitAnd, "first", "utf32_31")),
        native/let_statement("minimum", :U32, "utf32_128")
      ], [
        native/if_statement(native/binary_expression(:Less, "first", "utf32_240"), [
          native/set_statement("width", "utf64_3"),
          native/set_statement("number", native/binary_expression(:BitAnd, "first", "utf32_15")),
          native/set_statement("minimum", "utf32_2048")
        ], [
          native/if_statement(native/binary_expression(:Less, "first", "utf32_245"), [
            native/set_statement("width", "utf64_4"),
            native/set_statement("number", native/binary_expression(:BitAnd, "first", "utf32_7")),
            native/set_statement("minimum", "utf32_65536")
          ], [native/return_zero()])
        ])
      ]),
      native/let_statement("condition", :Bool, native/binary_expression(:Less, "length", "width")),
      native/let_statement("index", :U64, "one"),
      native/when_statement("condition", [native/return_zero()]),
      native/while_statement(native/binary_expression(:Less, "index", "width"), [
        native/let_offset("slot", pointer, "source", "index"),
        native/set_statement("byte", native/load_expression("slot")),
        native/let_statement("part", :U32, native/unary_expression(:Convert, "byte")),
        native/set_statement("first", native/binary_expression(:BitAnd, "part", "utf32_192")),
        native/unless_statement(native/binary_expression(:Equal, "first", "utf32_128"), [native/return_zero()]),
        native/set_statement("part", native/binary_expression(:BitAnd, "part", "utf32_63")),
        native/set_statement("number", native/binary_expression(:ShiftLeft, "number", "utf32_6")),
        native/set_statement("number", native/binary_expression(:BitOr, "number", "part")),
        native/set_statement("index", native/binary_expression(:Add, "index", "one"))
      ]),
      native/when_statement(native/binary_expression(:Less, "number", "minimum"), [native/return_zero()])
    ]),
    native/let_call("scalar", [:Record, "RuneResult"], "unicode_scalar", ["number"]),
    native/unless_statement(native/field_expression("scalar", "ok"), [native/return_zero()]),
    native/let_field("rune", [:Scalar, "Rune", :U32], "scalar", "rune"),
    native/let_statement("result", result, native/record_expression(["true", "rune", "width"])),
    native/return_value("result")
  ])
  return context
end

verb native_value/utf8_encode(input: map) -> map
  let context: map = input
  let name: string = "utf8_encode"
  let bytes: list = [:Array, :U8, 4]
  let result: list = [:Record, "Utf8Encode"]
  context = native/declare_function(context, name, result, [["rune", [:Scalar, "Rune", :U32], :Value]],
    [], [:WriteMemory], :Value, "")
  context = native/define_function(context, name, [
    native/let_statement("number", :U32, native/unary_expression(:Unwrap, "rune")),
    native/let_call("scalar", [:Record, "RuneResult"], "unicode_scalar", ["number"]),
    native/unless_statement(native/field_expression("scalar", "ok"), [native/return_zero()]),
    native/if_statement(native/binary_expression(:Less, "number", "utf32_128"), [
      native/let_statement("width", :U64, "one"),
      native/let_statement("prefix", :U32, "utf32_0")
    ], [
      native/if_statement(native/binary_expression(:Less, "number", "utf32_2048"), [
        native/set_statement("width", "utf64_2"),
        native/set_statement("prefix", "utf32_192")
      ], [
        native/if_statement(native/binary_expression(:Less, "number", "utf32_65536"), [
          native/set_statement("width", "utf64_3"),
          native/set_statement("prefix", "utf32_224")
        ], [
          native/set_statement("width", "utf64_4"),
          native/set_statement("prefix", "utf32_240")
        ])
      ])
    ]),
    native/let_statement("bytes", bytes, native/zero_expression()),
    native/let_statement("address", [:Pointer, bytes, :Mutable], native/unary_expression(:Address, "bytes")),
    native/let_statement("index", :U64, native/binary_expression(:Subtract, "width", "one")),
    native/while_statement(native/binary_expression(:Less, "zero", "index"), [
      native/let_statement("part", :U32, native/binary_expression(:BitAnd, "number", "utf32_63")),
      native/set_statement("part", native/binary_expression(:BitOr, "part", "utf32_128")),
      native/let_statement("byte", :U8, native/unary_expression(:Convert, "part")),
      native/let_statement(
        "slot",
        [:Pointer, :U8, :Mutable],
        native/binary_expression(:ElementPointer, "address", "index")
      ),
      native/store_statement("slot", "byte"),
      native/set_statement("number", native/binary_expression(:ShiftRight, "number", "utf32_6")),
      native/set_statement("index", native/binary_expression(:Subtract, "index", "one"))
    ]),
    native/set_statement("part", native/binary_expression(:BitOr, "number", "prefix")),
    native/set_statement("byte", native/unary_expression(:Convert, "part")),
    native/set_statement("slot", native/binary_expression(:ElementPointer, "address", "zero")),
    native/store_statement("slot", "byte"),
    native/let_statement("result", result, native/record_expression(["true", "bytes", "width"])),
    native/return_value("result")
  ])
  return context
end

verb native_value/utf8_scan(input: map) -> map
  let context: map = input
  let name: string = "utf8_scan"
  let pointer: list = [:Pointer, :U8, :Const]
  let result: list = [:Record, "Utf8Scan"]
  context = native/declare_function(context, name, result, [["source", pointer, :Borrow], ["length", :U64, :Value]],
    [], [:ReadMemory, :WriteMemory], :Value, "")
  context[:state] = native/annotate(
    context[:state],
    context[:functions][name],
    :Source,
    "apps/native/value/utf8.mica: native_value/utf8_scan"
  )
  context[:state] = native/annotate(context[:state], context[:functions][name], :Purpose, "Validate UTF-8 and count Unicode scalars, with an eight-byte ASCII fast path.")
  let failure: list = [native/return_zero()]
  context = native/define_function(context, name, [
    native/when_statement(
      native/binary_expression(:Equal, "length", "zero"),
      [native/return_record(["true", "zero", "true"])]
    ),
    native/when_statement(native/binary_expression(:Equal, "source", "utf8_null"), failure),
    native/let_statement("offset", :U64, "zero"),
    native/let_statement("scalars", :U64, "zero"),
    native/let_statement("ascii", :Bool, "true"),
    native/let_statement("chunk", :U64, native/zero_expression()),
    native/let_statement("chunk_address", [:Pointer, :U64, :Mutable], native/unary_expression(:Address, "chunk")),
    native/let_statement(
      "chunk_bytes",
      [:Pointer, :U8, :Mutable],
      native/unary_expression(:PointerCast, "chunk_address")
    ),
    native/while_statement(native/binary_expression(:Less, "offset", "length"), [
      native/note_statement(:Invariant, "offset is a scalar boundary within the supplied byte extent."),
      native/let_statement("remaining", :U64, native/binary_expression(:Subtract, "length", "offset")),
      native/let_offset("slot", pointer, "source", "offset"),
      native/unless_statement(native/binary_expression(:Less, "remaining", "utf64_8"), [
        native/note_statement(
          :Purpose,
          "Copy eight readable bytes to an aligned local; the high-bit mask is endian neutral."
        ),
        native/copy_bytes_statement("chunk_bytes", "slot", "utf64_8"),
        native/set_statement("chunk", native/load_expression("chunk_address")),
        native/let_statement("high", :U64, native/binary_expression(:BitAnd, "chunk", "utf8_high_bits")),
        native/when_statement(native/binary_expression(:Equal, "high", "zero"), [
          native/set_statement("offset", native/binary_expression(:Add, "offset", "utf64_8")),
          native/set_statement("scalars", native/binary_expression(:Add, "scalars", "utf64_8")),
          native/continue_statement()
        ])
      ]),
      native/let_load("byte", :U8, "slot"),
      native/let_statement("first", :U32, native/unary_expression(:Convert, "byte")),
      native/when_statement(native/binary_expression(:Less, "first", "utf32_128"), [
        native/set_statement("offset", native/binary_expression(:Add, "offset", "one")),
        native/set_statement("scalars", native/binary_expression(:Add, "scalars", "one")),
        native/continue_statement()
      ]),
      native/let_call("decoded", [:Record, "Utf8Decode"], "utf8_decode", ["slot", "remaining"]),
      native/unless_statement(native/field_expression("decoded", "ok"), failure),
      native/let_field("width", :U64, "decoded", "width"),
      native/set_statement("ascii", "false"),
      native/set_statement("offset", native/binary_expression(:Add, "offset", "width")),
      native/set_statement("scalars", native/binary_expression(:Add, "scalars", "one"))
    ]),
    native/return_record(["true", "scalars", "ascii"])
  ])
  return context
end
