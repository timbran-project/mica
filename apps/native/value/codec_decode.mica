verb native_value/codec_decoder(input: map) -> map
  let context: map = input
  let bytes: list = [:Pointer, :U8, :Const]
  let reader: list = [:Record, "ValueReader"]
  let pointer: list = [:Pointer, reader, :Mutable]
  let span: list = [:Record, "CodecSpan"]
  let word: list = native_value/word()
  let result: list = [:Record, "ValueResult"]
  let decoded: list = [:Record, "ValueDecodeResult"]
  let arena: list = ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow]
  let table: list = ["table", [:Pointer, [:Record, "SymbolTable"], :Mutable], :Borrow]
  let options: list = ["options", [:Record, "ValueCodecOptions"], :Value]
  context[:state] = native/record_type(context[:state], "ValueReader", [["data", bytes], ["length", :U64], ["position", :U64]])[1]
  context[:state] = native/record_type(context[:state], "CodecSpan", [["ok", :Bool], ["data", bytes]])[1]
  context[:state] = native/record_type(context[:state], "ValueDecodeResult", [["ok", :Bool], ["value", word], ["consumed", :U64]])[1]
  context = native/declare_function(context, "codec_span", span, [["reader", pointer, :Borrow], ["count", :U64, :Value]], [], [:ReadMemory, :WriteMemory], :Borrow, "reader")
  context = native/define_function(context, "codec_span", [
    [:Let, "header", reader, [:Load, "reader"]], [:Let, "position", :U64, [:Field, "header", "position"]],
    [:Let, "length", :U64, [:Field, "header", "length"]],
    [:If, [:Less, [:Expr, :U64, [:Subtract, "length", "position"]], "count"], [[:Return, [:Zero]]], []],
    [:Let, "data", bytes, [:Field, "header", "data"]],
    [:If, [:Equal, "count", "zero"], [[:Return, [:Record, "true", "data"]]], []],
    [:Let, "start", bytes, [:Offset, "data", "position"]],
    [:Do, [:Store, [:Expr, [:Pointer, :U64, :Mutable], [:FieldPointer, "reader", "position"]], [:Expr, :U64, [:Add, "position", "count"]]]],
    [:Return, [:Record, "true", "start"]]])
  context = native/declare_function(context, "codec_word", [:Record, "IdResult"], [["reader", pointer, :Borrow]], [], [:ReadMemory, :WriteMemory], :Value, "")
  context = native/define_function(context, "codec_word", [
    [:Let, "span", span, [:Call, "codec_span", "reader", "word_bytes"]],
    [:If, [:Field, "span", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "data", bytes, [:Field, "span", "data"]], [:Let, "number", :U64, "zero"], [:Let, "i", :U64, "zero"],
    [:While, [:Less, "i", "word_bytes"], [
      [:Let, "byte", :U8, [:Load, [:Expr, bytes, [:Offset, "data", "i"]]]],
      [:Let, "shift", :U64, [:Multiply, "i", "word_bytes"]],
      [:Let, "part", :U64, [:ShiftLeft, [:Expr, :U64, [:Convert, "byte"]], "shift"]],
      [:Set, "number", [:BitOr, "number", "part"]], [:Set, "i", [:Add, "i", "one"]]]],
    [:Return, [:Record, "true", "number"]]])
  context = native/declare_function(context, "codec_count", :Bool, [["reader", pointer, :Borrow], ["count", :U64, :Value], ["width", :U64, :Value]], [], [:ReadMemory], :Value, "")
  context = native/define_function(context, "codec_count", [
    [:Let, "header", reader, [:Load, "reader"]],
    [:Let, "remaining", :U64, [:Subtract, [:Expr, :U64, [:Field, "header", "length"]], [:Expr, :U64, [:Field, "header", "position"]]]],
    [:If, [:Less, [:Expr, :U64, [:Divide, "remaining", "width"]], "count"], [[:Return, "false"]], []], [:Return, "true"]])
  context = native/declare_function(context, "codec_decode", result, [arena, table, ["reader", pointer, :Borrow], options], [],
    [:Allocate, :ReadMemory, :WriteMemory, :Block], :Borrow, "arena")
  context = native_value/decode_relation(context)
  context = native_value/decode_value(context)
  let parameters: list = [arena, table, ["data", bytes, :Borrow], ["length", :U64, :Value], options]
  context = native/declare_function(context, "value_decode", decoded, parameters, [], [:Allocate, :ReadMemory, :WriteMemory, :Block], :Borrow, "arena")
  context = native/define_function(context, "value_decode", [
    [:If, [:Equal, "data", [:Expr, bytes, [:Zero]]], [[:If, [:Less, "zero", "length"], [[:Return, [:Zero]]], []]], []],
    [:Let, "cursor", reader, [:Record, "data", "length", "zero"]],
    [:Let, "reader", pointer, [:Address, "cursor"]],
    [:Let, "result", result, [:Call, "codec_decode", "arena", "table", "reader", "options"]],
    [:If, [:Field, "result", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "position", :U64, [:Load, [:Expr, [:Pointer, :U64, :Mutable], [:FieldPointer, "reader", "position"]]]],
    [:Return, [:Record, "true", [:Expr, word, [:Field, "result", "value"]], "position"]]])
  context = native/declare_function(context, "value_decode_exact", result, parameters, [], [:Allocate, :ReadMemory, :WriteMemory, :Block], :Borrow, "arena")
  context = native/define_function(context, "value_decode_exact", [
    [:Let, "result", decoded, [:Call, "value_decode", "arena", "table", "data", "length", "options"]],
    [:If, [:Field, "result", "ok"], [], [[:Return, [:Zero]]]],
    [:If, [:Equal, [:Expr, :U64, [:Field, "result", "consumed"]], "length"], [], [[:Return, [:Zero]]]],
    [:Return, [:Record, "true", [:Expr, word, [:Field, "result", "value"]]]]])
  return context
end

verb native_value/decode_child(name: string) -> list
  let checked: string = string_concat(name, "_checked")
  return [[:Let, checked, [:Record, "ValueResult"], [:Call, "codec_decode", "arena", "table", "reader", "options"]],
    [:If, [:Field, checked, "ok"], [], [[:Return, [:Zero]]]],
    [:Let, name, native_value/word(), [:Field, checked, "value"]]]
end

verb native_value/decode_allocation(name: string, element, count: string) -> list
  let size: string = string_concat(name, "_size")
  let raw: string = string_concat(name, "_raw")
  return [[:Let, size, :U64, [:SizeOf, element]],
    [:If, [:Less, [:Expr, :U64, [:Divide, "allocation_limit", size]], count], [[:Return, [:Zero]]], []],
    [:Let, raw, [:Pointer, :U8, :Mutable], [:Call, "value_arena_allocate", "arena", [:Expr, :U64, [:Multiply, size, count]]]],
    [:If, [:Less, "zero", count], [[:If, [:Equal, raw, "null_bytes"], [[:Return, [:Zero]]], []]], []],
    [:Let, name, [:Pointer, element, :Mutable], [:PointerCast, raw]]]
end

verb native_value/decode_value(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let bytes: list = [:Pointer, :U8, :Const]
  let rows: list = [
    [:Let, "checked_word", [:Record, "IdResult"], [:Call, "codec_word", "reader"]],
    [:If, [:Field, "checked_word", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "number", :U64, [:Field, "checked_word", "number"]],
    [:Let, "tag", :U8, [:Convert, [:Expr, :U64, [:ShiftRight, "number", "codec_tag_shift"]]]],
    [:Let, "payload", :U64, [:BitAnd, "number", "payload_mask"]],
    [:If, [:Equal, "tag", "zero_tag"], [
      [:If, [:Equal, "payload", "zero"], [[:Return, [:Record, "true", [:Expr, word, [:Zero]]]]], [[:Return, [:Zero]]]]], []],
    [:If, [:Equal, "tag", "tag_bool"], [
      [:If, [:Less, "one", "payload"], [[:Return, [:Zero]]], []],
      [:Return, [:Record, "true", [:Expr, word, [:PackImmediate, "payload", "tag_bool"]]]]], []],
    [:If, [:Equal, "tag", "tag_int"], [[:Return, [:Record, "true", [:Expr, word, [:PackImmediate, "payload", "tag_int"]]]]], []],
    [:If, [:Equal, "tag", "tag_float"], [
      [:If, [:Less, "codec_u32_max", "payload"], [[:Return, [:Zero]]], []],
      [:Return, [:Call, "value_float_from_bits", [:Expr, :U32, [:Convert, "payload"]]]]], []],
    [:If, [:Equal, "tag", "tag_identity"], [[:Return, [:Call, "value_identity", "payload"]]], []],
    [:If, [:Equal, "tag", "tag_capability"], [
      [:If, [:Field, "options", "allow_capabilities"], [[:Return, [:Call, "value_capability", "payload"]]], [[:Return, [:Zero]]]]], []]]
  for name in ["symbol", "error_code"]
    rows = [@rows, [:If, [:Equal, "tag", string_concat("tag_", name)], [
      [:If, [:Field, "options", "symbol_ids"], [], [[:Return, [:Zero]]]],
      [:If, [:Less, "codec_u32_max", "payload"], [[:Return, [:Zero]]], []],
      [:Return, [:Call, string_concat("value_", name), [:Expr, :U32, [:Convert, "payload"]]]]], []]]
  end
  rows = [@rows,
    [:If, [:Equal, [:Expr, :U64, [:Convert, "tag"]], "codec_byte_mask"], [], [[:Return, [:Zero]]]],
    [:Let, "kind", :U8, [:Convert, [:Expr, :U64, [:ShiftRight, "number", "codec_kind_shift"]]]],
    [:Let, "aux", :U64, [:BitAnd, "number", "codec_aux_mask"]]]
  for name in ["string", "bytes", "symbol", "error_code"]
    let span: string = string_concat(name, "_span")
    let body: list = []
    if name == "symbol" || name == "error_code"
      body = [[:If, [:Field, "options", "symbol_ids"], [[:Return, [:Zero]]], []],
        [:If, [:Equal, "table", [:Expr, [:Pointer, [:Record, "SymbolTable"], :Mutable], [:Zero]]], [[:Return, [:Zero]]], []]]
    end
    body = [@body, [:Let, span, [:Record, "CodecSpan"], [:Call, "codec_span", "reader", "aux"]],
      [:If, [:Field, span, "ok"], [], [[:Return, [:Zero]]]]]
    if name == "symbol" || name == "error_code"
      let id: string = string_concat(name, "_id")
      body = [@body, [:Let, id, [:Record, "IdResult"], [:Call, "value_symbol_intern", "table", [:Expr, bytes, [:Field, span, "data"]], "aux"]],
        [:If, [:Field, id, "ok"], [], [[:Return, [:Zero]]]],
        [:Return, [:Call, string_concat("value_", name), [:Expr, :U32, [:Convert, [:Expr, :U64, [:Field, id, "number"]]]]]]]
    else
      body = [@body, [:Return, [:Call, string_concat("value_", name), "arena", [:Expr, bytes, [:Field, span, "data"]], "aux"]]]
    end
    rows = [@rows, [:If, [:Equal, "kind", string_concat("tag_", name)], body, []]]
  end
  for spec in [["list", word], ["map", [:Record, "ValueMapEntry"]]]
    let name: string = spec[0]
    let data: string = string_concat(name, "_data")
    let index: string = string_concat(name, "_i")
    let element: string = string_concat(name, "_element")
    let children: list = native_value/decode_child(element)
    let width: string = "word_bytes"
    if name == "map"
      children = [@native_value/decode_child("map_key"), @native_value/decode_child("map_value"),
        [:Let, element, spec[1], [:Record, "map_key", "map_value"]]]
    end
    rows = [@rows, [:If, [:Equal, "kind", string_concat("tag_", name)], [
      [:If, [:Call, "codec_count", "reader", "aux", width], [], [[:Return, [:Zero]]]],
      @native_value/decode_allocation(data, spec[1], "aux"),
      [:Let, index, :U64, "zero"], [:While, [:Less, index, "aux"], [
        @children, [:Do, [:Store, [:Expr, [:Pointer, spec[1], :Mutable], [:Offset, data, index]], element]],
        [:Set, index, [:Add, index, "one"]]]],
      [:Return, [:Call, string_concat("value_", name), "arena", [:Expr, [:Pointer, spec[1], :Const], [:Freeze, data]], "aux"]]], []]]
  end
  rows = [@rows, [:If, [:Equal, "kind", "tag_range"], [
    [:If, [:Less, "one", "aux"], [[:Return, [:Zero]]], []], @native_value/decode_child("range_start"),
    [:Let, "has_end", :Bool, [:Equal, "aux", "one"]], [:Let, "range_end", word, [:Zero]],
    [:If, "has_end", [@native_value/decode_child("end_value"), [:Set, "range_end", "end_value"]], []],
    [:Return, [:Call, "value_range", "arena", "range_start", "has_end", "range_end"]]], []],
    [:If, [:Equal, "kind", "tag_error"], [
      [:If, [:Less, "codec_error_flags", "aux"], [[:Return, [:Zero]]], []], @native_value/decode_child("error_code"),
      [:If, [:Equal, [:Expr, :U8, [:Tag, "error_code"]], "tag_error_code"], [], [[:Return, [:Zero]]]],
      [:Let, "has_message", :Bool, [:Equal, [:Expr, :U64, [:BitAnd, "aux", "one"]], "one"]],
      [:Let, "has_value", :Bool, [:Equal, [:Expr, :U64, [:BitAnd, "aux", "two"]], "two"]],
      [:Let, "message", word, [:Zero]], [:Let, "error_value", word, [:Zero]],
      [:If, "has_message", [
        [:Let, "message_length", [:Record, "IdResult"], [:Call, "codec_word", "reader"]],
        [:If, [:Field, "message_length", "ok"], [], [[:Return, [:Zero]]]],
        [:Let, "length", :U64, [:Field, "message_length", "number"]],
        [:Let, "message_span", [:Record, "CodecSpan"], [:Call, "codec_span", "reader", "length"]],
        [:If, [:Field, "message_span", "ok"], [], [[:Return, [:Zero]]]],
        [:Let, "checked_message", [:Record, "ValueResult"], [:Call, "value_string", "arena", [:Expr, bytes, [:Field, "message_span", "data"]], "length"]],
        [:If, [:Field, "checked_message", "ok"], [], [[:Return, [:Zero]]]], [:Set, "message", [:Field, "checked_message", "value"]]], []],
      [:If, "has_value", [@native_value/decode_child("error_payload"), [:Set, "error_value", "error_payload"]], []],
      [:Return, [:Call, "value_error", "arena", [:Expr, :U32, [:Convert, [:Expr, :U64, [:Payload, "error_code"]]]], "has_message", "message", "has_value", "error_value"]]], []],
    [:If, [:Equal, "kind", "tag_frob"], [
      [:If, [:Equal, "aux", "zero"], [], [[:Return, [:Zero]]]], @native_value/decode_child("delegate"),
      [:If, [:Equal, [:Expr, :U8, [:Tag, "delegate"]], "tag_identity"], [], [[:Return, [:Zero]]]],
      @native_value/decode_child("frob_value"),
      [:Return, [:Call, "value_frob", "arena", [:Expr, :U64, [:Payload, "delegate"]], "frob_value"]]], []],
    [:If, [:Equal, "kind", "tag_relation"], [[:Return, [:Call, "codec_relation", "arena", "table", "reader", "options", "aux"]]], []],
    [:Return, [:Zero]]]
  context = native/define_function(context, "codec_decode", rows)
  return context
end

verb native_value/decode_relation(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let tuple: list = [:Record, "ValueTuple"]
  context = native/declare_function(context, "codec_relation", [:Record, "ValueResult"], [
    ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow],
    ["table", [:Pointer, [:Record, "SymbolTable"], :Mutable], :Borrow],
    ["reader", [:Pointer, [:Record, "ValueReader"], :Mutable], :Borrow],
    ["options", [:Record, "ValueCodecOptions"], :Value], ["arity", :U64, :Value]], [],
    [:Allocate, :ReadMemory, :WriteMemory, :Block], :Borrow, "arena")
  context = native/define_function(context, "codec_relation", [
    [:If, [:Less, "relation_max_arity", "arity"], [[:Return, [:Zero]]], []],
    [:If, [:Call, "codec_count", "reader", "arity", "word_bytes"], [], [[:Return, [:Zero]]]],
    @native_value/decode_allocation("heading", :U32, "arity"),
    [:Let, "column", :U64, "zero"], [:While, [:Less, "column", "arity"], [
      @native_value/decode_child("heading_value"),
      [:If, [:Equal, [:Expr, :U8, [:Tag, "heading_value"]], "tag_symbol"], [], [[:Return, [:Zero]]]],
      [:Do, [:Store, [:Expr, [:Pointer, :U32, :Mutable], [:Offset, "heading", "column"]], [:Expr, :U32, [:Convert, [:Expr, :U64, [:Payload, "heading_value"]]]]]],
      [:Set, "column", [:Add, "column", "one"]]]],
    [:Let, "checked_length", [:Record, "IdResult"], [:Call, "codec_word", "reader"]],
    [:If, [:Field, "checked_length", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "length", :U64, [:Field, "checked_length", "number"]],
    [:If, [:Equal, "arity", "zero"], [[:If, [:Less, "one", "length"], [[:Return, [:Zero]]], []]], [
      [:Let, "row_bytes", :U64, [:Multiply, "arity", "word_bytes"]],
      [:If, [:Call, "codec_count", "reader", "length", "row_bytes"], [], [[:Return, [:Zero]]]]]],
    @native_value/decode_allocation("rows", tuple, "length"),
    [:Let, "row", :U64, "zero"], [:While, [:Less, "row", "length"], [
      @native_value/decode_allocation("cells", word, "arity"),
      [:Set, "column", "zero"], [:While, [:Less, "column", "arity"], [
        @native_value/decode_child("cell"),
        [:Do, [:Store, [:Expr, [:Pointer, word, :Mutable], [:Offset, "cells", "column"]], "cell"]],
        [:Set, "column", [:Add, "column", "one"]]]],
      [:Do, [:Store, [:Expr, [:Pointer, tuple, :Mutable], [:Offset, "rows", "row"]], [:Expr, tuple, [:Record, "cells", "arity"]]]],
      [:Set, "row", [:Add, "row", "one"]]]],
    [:Return, [:Call, "value_relation", "arena", [:Expr, [:Pointer, :U32, :Const], [:Freeze, "heading"]], "arity", [:Expr, [:Pointer, tuple, :Const], [:Freeze, "rows"]], "length"]]])
  return context
end
