verb native_value/codec_decoder(input: map) -> map
  let context: map = input
  let bytes: list = [:Pointer, :U8, :Const]
  let reader: list = [:Record, "ValueReader"]
  let pointer: list = [:Pointer, reader, :Mutable]
  let span: list = [:Record, "CodecSpan"]
  let word: list = native_value/word()
  let result: list = [:Record, "ValueResult"]
  let decoded: list = [:Record, "ValueDecodeResult"]
  let worker: list = ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow]
  let table: list = ["table", [:Pointer, [:Record, "SymbolTable"], :Mutable], :Borrow]
  let options: list = ["options", [:Record, "ValueCodecOptions"], :Value]
  context[:state] = native/record_type(context[:state], "ValueReader", [["data", bytes], ["length", :U64], ["position", :U64]])[1]
  context[:state] = native/record_type(context[:state], "CodecSpan", [["ok", :Bool], ["data", bytes]])[1]
  context[:state] = native/record_type(context[:state], "ValueDecodeResult", [["ok", :Bool], ["value", word], ["consumed", :U64]])[1]
  context = native/declare_function(context, "codec_span", span, [["reader", pointer, :Borrow], ["count", :U64, :Value]], [], [:ReadMemory, :WriteMemory], :Borrow, "reader")
  context = native/define_function(context, "codec_span", [
    native/let_load("header", reader, "reader"),
    native/let_field("position", :U64, "header", "position"),
    native/let_field("length", :U64, "header", "length"),
    native/when_statement(
      native/binary_expression(
        :Less,
        native/typed_expression(:U64, native/binary_expression(:Subtract, "length", "position")),
        "count"
      ),
      [native/return_zero()]
    ),
    native/let_field("data", bytes, "header", "data"),
    native/when_statement(native/binary_expression(:Equal, "count", "zero"), [native/return_record(["true", "data"])]),
    native/let_offset("start", bytes, "data", "position"),
    native/store_statement(
      native/typed_expression([:Pointer, :U64, :Mutable], native/field_pointer_expression("reader", "position")),
      native/typed_expression(:U64, native/binary_expression(:Add, "position", "count"))
    ),
    native/return_record(["true", "start"])
  ])
  context = native/declare_function(context, "codec_word", [:Record, "IdResult"], [["reader", pointer, :Borrow]], [], [:ReadMemory, :WriteMemory], :Value, "")
  context = native/define_function(context, "codec_word", [
    @native/try_call("span", span, "codec_span", ["reader", "word_bytes"], [native/return_zero()]),
    native/let_field("data", bytes, "span", "data"),
    native/let_statement("number", :U64, "zero"),
    @native/for_range("i", "zero", "word_bytes", [
      native/let_load("byte", :U8, native/typed_expression(bytes, native/offset_expression("data", "i"))),
      native/let_statement("shift", :U64, native/binary_expression(:Multiply, "i", "word_bytes")),
      native/let_statement(
        "part",
        :U64,
        native/binary_expression(
          :ShiftLeft,
          native/typed_expression(:U64, native/unary_expression(:Convert, "byte")),
          "shift"
        )
      ),
      native/set_statement("number", native/binary_expression(:BitOr, "number", "part"))]),
    native/return_record(["true", "number"])
  ])
  context = native/declare_function(context, "codec_count", :Bool, [["reader", pointer, :Borrow], ["count", :U64, :Value], ["width", :U64, :Value]], [], [:ReadMemory], :Value, "")
  context = native/define_function(context, "codec_count", [
    native/let_load("header", reader, "reader"),
    native/let_statement(
      "remaining",
      :U64,
      native/binary_expression(
        :Subtract,
        native/typed_field(:U64, "header", "length"),
        native/typed_field(:U64, "header", "position")
      )
    ),
    native/when_statement(
      native/binary_expression(
        :Less,
        native/typed_expression(:U64, native/binary_expression(:Divide, "remaining", "width")),
        "count"
      ),
      [native/return_value("false")]
    ),
    native/return_value("true")
  ])
  context = native/declare_function(context, "codec_decode", result, [worker, table, ["reader", pointer, :Borrow], options], [],
    [:Allocate, :ReadMemory, :WriteMemory, :Block], :Gc, "")
  context = native_value/decode_relation(context)
  context = native_value/decode_value(context)
  let parameters: list = [worker, table, ["data", bytes, :Borrow], ["length", :U64, :Value], options]
  context = native/declare_function(context, "value_decode", decoded, parameters, [], [:Allocate, :ReadMemory, :WriteMemory, :Block], :Gc, "")
  context = native/define_function(context, "value_decode", [
    native/when_statement(
      native/binary_expression(:Equal, "data", native/typed_zero(bytes)),
      [native/when_statement(native/binary_expression(:Less, "zero", "length"), [native/return_zero()])]
    ),
    native/let_statement("cursor", reader, native/record_expression(["data", "length", "zero"])),
    native/let_statement("reader", pointer, native/unary_expression(:Address, "cursor")),
    @native/try_call("result", result, "codec_decode", ["worker", "table", "reader", "options"], [native/return_zero()]),
    native/let_load(
      "position",
      :U64,
      native/typed_expression([:Pointer, :U64, :Mutable], native/field_pointer_expression("reader", "position"))
    ),
    native/return_record(["true", native/typed_field(word, "result", "value"), "position"])
  ])
  context = native/declare_function(context, "value_decode_exact", result, parameters, [], [:Allocate, :ReadMemory, :WriteMemory, :Block], :Gc, "")
  context = native/define_function(context, "value_decode_exact", [
    @native/try_call("result", decoded, "value_decode", ["worker", "table", "data", "length", "options"], [native/return_zero()]),
    native/unless_statement(
      native/binary_expression(:Equal, native/typed_field(:U64, "result", "consumed"), "length"),
      [native/return_zero()]
    ),
    native/return_record(["true", native/typed_field(word, "result", "value")])
  ])
  return context
end

verb native_value/decode_child(name: string) -> list
  let checked: string = string_concat(name, "_checked")
  return [
    @native/try_call(checked, [:Record, "ValueResult"], "codec_decode", ["worker", "table", "reader", "options"], [native/return_zero()]),
    native/let_field(name, native_value/word(), checked, "value")
  ]
end

verb native_value/decode_value(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let bytes: list = [:Pointer, :U8, :Const]
  let rows: list = [
    @native/try_call("checked_word", [:Record, "IdResult"], "codec_word", ["reader"], [native/return_zero()]),
    native/let_field("number", :U64, "checked_word", "number"),
    native/let_statement(
      "tag",
      :U8,
      native/unary_expression(
        :Convert,
        native/typed_expression(:U64, native/binary_expression(:ShiftRight, "number", "codec_tag_shift"))
      )
    ),
    native/let_statement("payload", :U64, native/binary_expression(:BitAnd, "number", "payload_mask")),
    native/when_statement(
      native/binary_expression(:Equal, "tag", "zero_tag"),
      [
        native/if_statement(
          native/binary_expression(:Equal, "payload", "zero"),
          [native/return_record(["true", native/typed_zero(word)])],
          [native/return_zero()]
        )
      ]
    ),
    native/when_statement(native/binary_expression(:Equal, "tag", "tag_bool"), [
      native/when_statement(native/binary_expression(:Less, "one", "payload"), [native/return_zero()]),
      native/return_record(
        ["true", native/typed_expression(word, native/binary_expression(:PackImmediate, "payload", "tag_bool"))]
      )
    ]),
    native/when_statement(
      native/binary_expression(:Equal, "tag", "tag_int"),
      [
        native/return_record(
          ["true", native/typed_expression(word, native/binary_expression(:PackImmediate, "payload", "tag_int"))]
        )
      ]
    ),
    native/when_statement(native/binary_expression(:Equal, "tag", "tag_float"), [
      native/when_statement(native/binary_expression(:Less, "codec_u32_max", "payload"), [native/return_zero()]),
      native/return_value(
        native/call_expression(
          "value_float_from_bits",
          [native/typed_expression(:U32, native/unary_expression(:Convert, "payload"))]
        )
      )
    ]),
    native/when_statement(
      native/binary_expression(:Equal, "tag", "tag_identity"),
      [native/return_value(native/call_expression("value_identity", ["payload"]))]
    ),
    native/when_statement(
      native/binary_expression(:Equal, "tag", "tag_capability"),
      [
        native/if_statement(
          native/field_expression("options", "allow_capabilities"),
          [native/return_value(native/call_expression("value_capability", ["payload"]))],
          [native/return_zero()]
        )
      ]
    )
  ]
  for name in ["symbol", "error_code"]
    rows = [
      @rows,
      native/when_statement(native/binary_expression(:Equal, "tag", string_concat("tag_", name)), [
        native/unless_statement(native/field_expression("options", "symbol_ids"), [native/return_zero()]),
        native/when_statement(native/binary_expression(:Less, "codec_u32_max", "payload"), [native/return_zero()]),
        native/return_value(
          native/call_expression(
            string_concat("value_", name),
            [native/typed_expression(:U32, native/unary_expression(:Convert, "payload"))]
          )
        )
      ])
    ]
  end
  rows = [
    @rows,
    native/unless_statement(
      native/binary_expression(
        :Equal,
        native/typed_expression(:U64, native/unary_expression(:Convert, "tag")),
        "codec_byte_mask"
      ),
      [native/return_zero()]
    ),
    native/let_statement(
      "kind",
      :U8,
      native/unary_expression(
        :Convert,
        native/typed_expression(:U64, native/binary_expression(:ShiftRight, "number", "codec_kind_shift"))
      )
    ),
    native/let_statement("aux", :U64, native/binary_expression(:BitAnd, "number", "codec_aux_mask"))
  ]
  for name in ["string", "bytes", "symbol", "error_code"]
    let span: string = string_concat(name, "_span")
    let body: list = []
    if name == "symbol" || name == "error_code"
      body = [
        native/when_statement(native/field_expression("options", "symbol_ids"), [native/return_zero()]),
        native/when_statement(
          native/binary_expression(:Equal, "table", native/typed_zero([:Pointer, [:Record, "SymbolTable"], :Mutable])),
          [native/return_zero()]
        )
      ]
    end
    body = [
      @body,
      @native/try_call(span, [:Record, "CodecSpan"], "codec_span", ["reader", "aux"], [native/return_zero()])
    ]
    if name == "symbol" || name == "error_code"
      let id: string = string_concat(name, "_id")
      body = [
        @body,
        @native/try_call(id, [:Record, "IdResult"], "value_symbol_intern", ["table", native/typed_field(bytes, span, "data"), "aux"], [native/return_zero()]),
        native/return_value(
          native/call_expression(
            string_concat("value_", name),
            [native/typed_expression(:U32, native/unary_expression(:Convert, native/typed_field(:U64, id, "number")))]
          )
        )
      ]
    else
      body = [
        @body,
        native/return_value(
          native/call_expression(
            string_concat("value_", name),
            ["worker", native/typed_field(bytes, span, "data"), "aux"]
          )
        )
      ]
    end
    rows = [
      @rows,
      native/when_statement(native/binary_expression(:Equal, "kind", string_concat("tag_", name)), body)
    ]
  end
  for spec in [["list", word], ["map", [:Record, "ValueMapEntry"]]]
    let name: string = spec[0]
    let data: string = string_concat(name, "_data")
    let index: string = string_concat(name, "_i")
    let element: string = string_concat(name, "_element")
    let children: list = native_value/decode_child(element)
    let width: string = "word_bytes"
    if name == "map"
      children = [
        @native_value/decode_child("map_key"),
        @native_value/decode_child("map_value"),
        native/let_statement(element, spec[1], native/record_expression(["map_key", "map_value"]))
      ]
    end
    rows = [
      @rows,
      native/when_statement(
        native/binary_expression(:Equal, "kind", string_concat("tag_", name)),
        [
          native/unless_statement(
            native/call_expression("codec_count", ["reader", "aux", width]),
            [native/return_zero()]
          ),
          @native_memory/allocate_array(data, spec[1], "aux", "layout_opaque", [native/return_zero()]),
          @native/for_range(index, "zero", "aux", [
            @children,
            native/store_statement(
              native/typed_expression([:Pointer, spec[1], :Mutable], native/offset_expression(data, index)),
              element
            )]),
          native/return_value(
            native/call_expression(
              string_concat("value_", name),
              [
                "worker",
                native/typed_expression([:Pointer, spec[1], :Const], native/unary_expression(:Freeze, data)),
                "aux"
              ]
            )
          )
        ]
      )
    ]
  end
  rows = [
    @rows,
    native/when_statement(native/binary_expression(:Equal, "kind", "tag_range"), [
      native/when_statement(native/binary_expression(:Less, "one", "aux"), [native/return_zero()]),
      @native_value/decode_child("range_start"),
      native/let_statement("has_end", :Bool, native/binary_expression(:Equal, "aux", "one")),
      native/let_statement("range_end", word, native/zero_expression()),
      native/when_statement("has_end", [
        @native_value/decode_child("end_value"),
        native/set_statement("range_end", "end_value")
      ]),
      native/return_value(native/call_expression("value_range", ["worker", "range_start", "has_end", "range_end"]))
    ]),
    native/when_statement(native/binary_expression(:Equal, "kind", "tag_error"), [
      native/when_statement(native/binary_expression(:Less, "codec_error_flags", "aux"), [native/return_zero()]),
      @native_value/decode_child("error_code"),
      native_value/require_kind("error_code", "error_code", [native/return_zero()]),
      native/let_statement(
        "has_message",
        :Bool,
        native/binary_expression(
          :Equal,
          native/typed_expression(:U64, native/binary_expression(:BitAnd, "aux", "one")),
          "one"
        )
      ),
      native/let_statement(
        "has_value",
        :Bool,
        native/binary_expression(
          :Equal,
          native/typed_expression(:U64, native/binary_expression(:BitAnd, "aux", "two")),
          "two"
        )
      ),
      native/let_statement("message", word, native/zero_expression()),
      native/let_statement("error_value", word, native/zero_expression()),
      native/when_statement("has_message", [
        @native/try_call("message_length", [:Record, "IdResult"], "codec_word", ["reader"], [native/return_zero()]),
        native/let_field("length", :U64, "message_length", "number"),
        @native/try_call("message_span", [:Record, "CodecSpan"], "codec_span", ["reader", "length"], [native/return_zero()]),
        @native/try_call("checked_message", [:Record, "ValueResult"], "value_string", ["worker", native/typed_field(bytes, "message_span", "data"), "length"], [native/return_zero()]),
        native/set_statement("message", native/field_expression("checked_message", "value"))
      ]),
      native/when_statement("has_value", [
        @native_value/decode_child("error_payload"),
        native/set_statement("error_value", "error_payload")
      ]),
      native/return_value(
        native/call_expression(
          "value_error",
          [
            "worker",
            native/typed_expression(
              :U32,
              native/unary_expression(
                :Convert,
                native/typed_expression(:U64, native/unary_expression(:Payload, "error_code"))
              )
            ),
            "has_message",
            "message",
            "has_value",
            "error_value"
          ]
        )
      )
    ]),
    native/when_statement(native/binary_expression(:Equal, "kind", "tag_frob"), [
      native/unless_statement(native/binary_expression(:Equal, "aux", "zero"), [native/return_zero()]),
      @native_value/decode_child("delegate"),
      native_value/require_kind("delegate", "identity", [native/return_zero()]),
      @native_value/decode_child("frob_value"),
      native/return_value(
        native/call_expression(
          "value_frob",
          ["worker", native/typed_expression(:U64, native/unary_expression(:Payload, "delegate")), "frob_value"]
        )
      )
    ]),
    native/when_statement(
      native/binary_expression(:Equal, "kind", "tag_relation"),
      [native/return_value(native/call_expression("codec_relation", ["worker", "table", "reader", "options", "aux"]))]
    ),
    native/return_zero()
  ]
  context = native/define_function(context, "codec_decode", rows)
  return context
end

verb native_value/decode_relation(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let tuple: list = [:Record, "ValueTuple"]
  context = native/declare_function(context, "codec_relation", [:Record, "ValueResult"], [
    ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow],
    ["table", [:Pointer, [:Record, "SymbolTable"], :Mutable], :Borrow],
    ["reader", [:Pointer, [:Record, "ValueReader"], :Mutable], :Borrow],
    ["options", [:Record, "ValueCodecOptions"], :Value], ["arity", :U64, :Value]], [],
    [:Allocate, :ReadMemory, :WriteMemory, :Block], :Gc, "")
  context = native/define_function(context, "codec_relation", [
    native/when_statement(native/binary_expression(:Less, "relation_max_arity", "arity"), [native/return_zero()]),
    native/unless_statement(
      native/call_expression("codec_count", ["reader", "arity", "word_bytes"]),
      [native/return_zero()]
    ),
    @native_memory/allocate_array("heading", :U32, "arity", "layout_opaque", [native/return_zero()]),
    @native/for_range("column", "zero", "arity", [
      @native_value/decode_child("heading_value"),
      native_value/require_kind("heading_value", "symbol", [native/return_zero()]),
      native/store_statement(
        native/typed_expression([:Pointer, :U32, :Mutable], native/offset_expression("heading", "column")),
        native/typed_expression(
          :U32,
          native/unary_expression(
            :Convert,
            native/typed_expression(:U64, native/unary_expression(:Payload, "heading_value"))
          )
        )
      )]),
    @native/try_call("checked_length", [:Record, "IdResult"], "codec_word", ["reader"], [native/return_zero()]),
    native/let_field("length", :U64, "checked_length", "number"),
    native/if_statement(native/binary_expression(:Equal, "arity", "zero"), [
      native/when_statement(native/binary_expression(:Less, "one", "length"), [native/return_zero()])
    ], [
      native/let_statement("row_bytes", :U64, native/binary_expression(:Multiply, "arity", "word_bytes")),
      native/unless_statement(
        native/call_expression("codec_count", ["reader", "length", "row_bytes"]),
        [native/return_zero()]
      )
    ]),
    @native_memory/allocate_array("rows", tuple, "length", "layout_opaque", [native/return_zero()]),
    @native/for_range("row", "zero", "length", [
      @native_memory/allocate_array("cells", word, "arity", "layout_opaque", [native/return_zero()]),
      native/set_statement("column", "zero"),
      native/while_statement(native/binary_expression(:Less, "column", "arity"), [
        @native_value/decode_child("cell"),
        native/store_statement(
          native/typed_expression([:Pointer, word, :Mutable], native/offset_expression("cells", "column")),
          "cell"
        ),
        native/set_statement("column", native/binary_expression(:Add, "column", "one"))
      ]),
      native/store_statement(
        native/typed_expression([:Pointer, tuple, :Mutable], native/offset_expression("rows", "row")),
        native/typed_record(tuple, ["cells", "arity"])
      )]),
    native/return_value(
      native/call_expression(
        "value_relation",
        [
          "worker",
          native/typed_expression([:Pointer, :U32, :Const], native/unary_expression(:Freeze, "heading")),
          "arity",
          native/typed_expression([:Pointer, tuple, :Const], native/unary_expression(:Freeze, "rows")),
          "length"
        ]
      )
    )
  ])
  return context
end
