// Appending through the current tail can claim spare capacity. Earlier views
// retain their lengths and offsets; a competing append from an earlier tail
// receives another backing allocation. Arena mutation requires serialization.
verb native_value/string_append(input: map) -> map
  let context: map = input
  let name: string = "value_string_append"
  let word: list = native_value/word()
  let header: list = [:Record, "HeapString"]
  let storage: list = [:Record, "StringStorage"]
  let bytes: list = [:Pointer, :U8, :Mutable]
  let result: list = [:Record, "ValueResult"]
  context = native/declare_function(context, name, result, [
      ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow],
      ["value", word, [:Borrow, "arena"]],
      ["suffix", [:Pointer, :U8, :Const], :Borrow],
      ["suffix_length", :U64, :Value]
    ],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native/define_function(context, name, [
    [:Let, "checked", [:Record, "HeapStringResult"], [:Call, "value_as_string", "value"]],
    [:If, [:Field, "checked", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "original", [:Pointer, header, :Const], [:Field, "checked", "header"]],
    [:Let, "header", header, [:Load, "original"]],
    [:Let, "length", :U64, [:Field, "header", "length"]],
    [:Let, "limit", :U64, [:Subtract, "allocation_limit", "length"]],
    [:If, [:Less, "limit", "suffix_length"], [[:Return, [:Zero]]], []],
    [:If, [:Equal, "suffix_length", "zero"], [[:Let, "result", result, [:Record, "true", "value"]], [:Return, "result"]], []],
    [:Let, "scan", [:Record, "Utf8Scan"], [:Call, "utf8_scan", "suffix", "suffix_length"]],
    [:If, [:Field, "scan", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "scalars", :U64, [:Field, "header", "scalars"]],
    [:Let, "suffix_scalars", :U64, [:Field, "scan", "scalars"]],
    [:Let, "suffix_ascii", :Bool, [:Field, "scan", "ascii"]],
    [:Let, "total_length", :U64, [:Add, "length", "suffix_length"]],
    [:Let, "total_scalars", :U64, [:Add, "scalars", "suffix_scalars"]],
    [:Let, "ascii", :Bool, [:Equal, "total_length", "total_scalars"]],
    [:Let, "data", bytes, [:Field, "header", "data"]],
    [:Let, "backing", [:Pointer, storage, :Mutable], [:Field, "header", "storage"]],
    [:Let, "storage", storage, [:Load, "backing"]],
    [:Let, "base", bytes, [:Field, "storage", "data"]],
    [:Let, "capacity", :U64, [:Field, "storage", "capacity"]],
    [:Let, "used", :U64, [:Field, "storage", "used"]],
    [:Let, "byte_start", :U64, [:Field, "header", "byte_start"]],
    [:Let, "scalar_start", :U64, [:Field, "header", "scalar_start"]],
    [:Let, "old_end", :U64, [:Add, "byte_start", "length"]],
    [:Let, "scalar_end", :U64, [:Add, "scalar_start", "scalars"]],
    [:Let, "reuse_tail", :Bool, "false"],
    [:If, [:Equal, "used", "old_end"], [
      [:Set, "limit", [:Subtract, "capacity", "used"]],
      [:If, [:Less, "limit", "suffix_length"], [], [[:Set, "reuse_tail", "true"]]]
    ], []],
    [:Note, :Invariant, "Only the current tail may claim spare capacity; existing views retain their extents."],
    [:If, "reuse_tail", [
      [:Let, "header_size", :U64, [:SizeOf, header]],
      [:Let, "raw", bytes, [:Call, "value_arena_allocate", "arena", "header_size"]],
      [:If, [:Equal, "raw", "null_bytes"], [[:Return, [:Zero]]], []],
      [:Let, "target", [:Pointer, header, :Mutable], [:PointerCast, "raw"]],
      [:Let, "destination", bytes, [:Offset, "base", "old_end"]],
      [:Do, [:CopyBytes, "destination", "suffix", "suffix_length"]],
      [:Let, "new_end", :U64, [:Add, "old_end", "suffix_length"]],
      [:If, [:Call, "value_string_index", "backing", "old_end", "scalar_end", "new_end", "suffix_ascii"], [], [[:Return, [:Zero]]]],
      [:Let, "used_slot", [:Pointer, :U64, :Mutable], [:FieldPointer, "backing", "used"]],
      [:Do, [:Store, "used_slot", "new_end"]]
    ], [
      [:Set, "capacity", [:Add, "length", "length"]],
      [:If, [:Less, "capacity", "total_length"], [[:Set, "capacity", "total_length"]], []],
      [:Let, "allocation", [:Record, "StringAllocation"], [:Call, "value_string_allocate", "arena", "total_length", "capacity", "total_scalars", "ascii"]],
      [:If, [:Field, "allocation", "ok"], [], [
        [:Set, "allocation", [:Call, "value_string_allocate", "arena", "total_length", "total_length", "total_scalars", "ascii"]],
        [:If, [:Field, "allocation", "ok"], [], [[:Return, [:Zero]]]]
      ]],
      [:Set, "target", [:Field, "allocation", "header"]],
      [:Let, "updated", header, [:Load, "target"]],
      [:Set, "base", [:Field, "updated", "data"]],
      [:Set, "backing", [:Field, "updated", "storage"]],
      [:Let, "source", [:Pointer, :U8, :Const], [:Freeze, "data"]],
      [:Do, [:CopyBytes, "base", "source", "length"]],
      [:Set, "destination", [:Offset, "base", "length"]],
      [:Do, [:CopyBytes, "destination", "suffix", "suffix_length"]],
      [:Set, "data", "base"],
      [:Set, "byte_start", "zero"],
      [:Set, "scalar_start", "zero"],
      [:If, [:Call, "value_string_index", "backing", "zero", "zero", "total_length", "ascii"], [], [[:Return, [:Zero]]]]
    ]],
    [:Set, "updated", [:Record, "data", "total_length", "total_scalars", "ascii", "backing", "byte_start", "scalar_start"]],
    [:Do, [:Store, "target", "updated"]],
    [:Let, "packed", word, [:PackPointer, "target", "tag_string"]],
    [:Set, "result", [:Record, "true", "packed"]],
    [:Return, "result"]
  ])
  name = "value_string_concat"
  context = native/declare_function(context, name, result, [
      ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow],
      ["left", word, [:Borrow, "arena"]],
      ["right", word, :Borrow]
    ],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native/define_function(context, name, [
    [:Let, "checked", [:Record, "HeapStringResult"], [:Call, "value_as_string", "right"]],
    [:If, [:Field, "checked", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "pointer", [:Pointer, header, :Const], [:Field, "checked", "header"]],
    [:Let, "header", header, [:Load, "pointer"]],
    [:Let, "data", bytes, [:Field, "header", "data"]],
    [:Let, "length", :U64, [:Field, "header", "length"]],
    [:Let, "source", [:Pointer, :U8, :Const], [:Freeze, "data"]],
    [:Let, "result", result, [:Call, "value_string_append", "arena", "left", "source", "length"]],
    [:Return, "result"]
  ])
  return context
end
