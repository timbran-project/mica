// Appending through the current tail can claim spare capacity. Earlier views
// retain their lengths and offsets; a competing append from an earlier tail
// receives another backing allocation. Promoted storage is immutable.
verb native_value/string_append(input: map) -> map
  let context: map = input
  let name: string = "value_string_append_validated"
  let word: list = native_value/word()
  let header: list = [:Record, "HeapString"]
  let storage: list = [:Record, "StringStorage"]
  let bytes: list = [:Pointer, :U8, :Mutable]
  let result: list = [:Record, "ValueResult"]
  context = native/declare_function(context, name, result, [
      ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow],
      ["value", word, :Gc],
      ["suffix", [:Pointer, :U8, :Const], :Borrow],
      ["suffix_length", :U64, :Value],
      ["suffix_scalars", :U64, :Value],
      ["suffix_ascii", :Bool, :Value]
    ],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, name, [
    native/note_statement(:Invariant, "The original string and suffix are validated UTF-8; suffix metadata describes exactly suffix_length bytes."),
    native/let_call("checked", [:Record, "HeapStringResult"], "value_as_string", ["value"]),
    native/unless_statement(native/field_expression("checked", "ok"), [native/return_zero()]),
    native/let_field("original", [:Pointer, header, :Const], "checked", "header"),
    native/let_load("header", header, "original"),
    native/let_field("length", :U64, "header", "length"),
    native/let_statement("limit", :U64, native/binary_expression(:Subtract, "allocation_limit", "length")),
    native/when_statement(native/binary_expression(:Less, "limit", "suffix_length"), [native/return_zero()]),
    native/when_statement(native/binary_expression(:Equal, "suffix_length", "zero"), [
      native/return_record(["true", "value"])
    ]),
    native/let_field("scalars", :U64, "header", "scalars"),
    native/let_statement("total_length", :U64, native/binary_expression(:Add, "length", "suffix_length")),
    native/let_statement("total_scalars", :U64, native/binary_expression(:Add, "scalars", "suffix_scalars")),
    native/let_statement("ascii", :Bool, native/binary_expression(:Equal, "total_length", "total_scalars")),
    native/let_field("data", bytes, "header", "data"),
    native/let_field("backing", [:Pointer, storage, :Mutable], "header", "storage"),
    native/let_load("storage", storage, "backing"),
    native/let_field("base", bytes, "storage", "data"),
    native/let_field("capacity", :U64, "storage", "capacity"),
    native/let_field("used", :U64, "storage", "used"),
    native/let_field("byte_start", :U64, "header", "byte_start"),
    native/let_field("scalar_start", :U64, "header", "scalar_start"),
    native/let_statement("old_end", :U64, native/binary_expression(:Add, "byte_start", "length")),
    native/let_statement("scalar_end", :U64, native/binary_expression(:Add, "scalar_start", "scalars")),
    native/let_statement("reuse_tail", :Bool, "false"),
    native/when_statement(native/binary_expression(:Equal, "used", "old_end"), [
      native/set_statement("limit", native/binary_expression(:Subtract, "capacity", "used")),
      native/unless_statement(
        native/binary_expression(:Less, "limit", "suffix_length"),
        [native/set_statement("reuse_tail", "true")]
      )
    ]),
    native/note_statement(
      :Invariant,
      "Only the current tail may claim spare capacity; existing views retain their extents."
    ),
    native/unless_statement(native/call_expression("value_storage_private", [
      native/typed_expression(bytes, native/unary_expression(:PointerCast, "backing")),
      native/typed_expression(:U64, native/unary_expression(:SizeOf, header))]), [native/set_statement("reuse_tail", "false")]),
    native/if_statement("reuse_tail", [
      native/let_statement("header_size", :U64, native/unary_expression(:SizeOf, header)),
      native/let_call("raw", bytes, "memory_allocate", ["worker", "header_size", "layout_string_view"]),
      native/when_statement(native/binary_expression(:Equal, "raw", "null_bytes"), [native/return_zero()]),
      native/let_statement("target", [:Pointer, header, :Mutable], native/unary_expression(:PointerCast, "raw")),
      native/let_offset("destination", bytes, "base", "old_end"),
      native/copy_bytes_statement("destination", "suffix", "suffix_length"),
      native/let_statement("new_end", :U64, native/binary_expression(:Add, "old_end", "suffix_length")),
      native/unless_statement(
        native/call_expression("value_string_index", ["backing", "old_end", "scalar_end", "new_end", "suffix_ascii"]),
        [native/return_zero()]
      ),
      native/let_statement("used_slot", [:Pointer, :U64, :Mutable], native/field_pointer_expression("backing", "used")),
      native/store_statement("used_slot", "new_end")
    ], [
      native/set_statement("capacity", native/binary_expression(:Add, "length", "length")),
      native/when_statement(
        native/binary_expression(:Less, "capacity", "total_length"),
        [native/set_statement("capacity", "total_length")]
      ),
      native/let_call(
        "allocation",
        [:Record, "StringAllocation"],
        "value_string_allocate",
        ["worker", "total_length", "capacity", "total_scalars", "ascii"]
      ),
      native/unless_statement(native/field_expression("allocation", "ok"), [
        native/set_statement(
          "allocation",
          native/call_expression(
            "value_string_allocate",
            ["worker", "total_length", "total_length", "total_scalars", "ascii"]
          )
        ),
        native/unless_statement(native/field_expression("allocation", "ok"), [native/return_zero()])
      ]),
      native/set_statement("target", native/field_expression("allocation", "header")),
      native/let_load("updated", header, "target"),
      native/set_statement("base", native/field_expression("updated", "data")),
      native/set_statement("backing", native/field_expression("updated", "storage")),
      native/let_statement("source", [:Pointer, :U8, :Const], native/unary_expression(:Freeze, "data")),
      native/copy_bytes_statement("base", "source", "length"),
      native/set_statement("destination", native/offset_expression("base", "length")),
      native/copy_bytes_statement("destination", "suffix", "suffix_length"),
      native/set_statement("data", "base"),
      native/set_statement("byte_start", "zero"),
      native/set_statement("scalar_start", "zero"),
      native/unless_statement(
        native/call_expression("value_string_index", ["backing", "zero", "zero", "total_length", "ascii"]),
        [native/return_zero()]
      )
    ]),
    native/set_statement(
      "updated",
      native/record_expression(
        ["data", "total_length", "total_scalars", "ascii", "backing", "byte_start", "scalar_start"]
      )
    ),
    native/store_statement("target", "updated"),
    native/let_statement("packed", word, native/binary_expression(:PackPointer, "target", "tag_string")),
    native/let_statement("result", result, native/record_expression(["true", "packed"])),
    native/return_value("result")
  ])
  name = "value_string_append"
  context = native/declare_function(context, name, result, [
      ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow],
      ["value", word, :Gc],
      ["suffix", [:Pointer, :U8, :Const], :Borrow],
      ["suffix_length", :U64, :Value]
    ], [], [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, name, [
    native/let_call("checked", [:Record, "HeapStringResult"], "value_as_string", ["value"]),
    native/unless_statement(native/field_expression("checked", "ok"), [native/return_zero()]),
    native/let_field("original", [:Pointer, header, :Const], "checked", "header"),
    native/let_load("header", header, "original"),
    native/let_field("length", :U64, "header", "length"),
    native/let_statement("limit", :U64, native/binary_expression(:Subtract, "allocation_limit", "length")),
    native/when_statement(native/binary_expression(:Less, "limit", "suffix_length"), [native/return_zero()]),
    native/when_statement(native/binary_expression(:Equal, "suffix_length", "zero"), [native/return_record(["true", "value"])]),
    native/let_call("scan", [:Record, "Utf8Scan"], "utf8_scan", ["suffix", "suffix_length"]),
    native/unless_statement(native/field_expression("scan", "ok"), [native/return_zero()]),
    native/let_field("scalars", :U64, "scan", "scalars"),
    native/let_field("ascii", :Bool, "scan", "ascii"),
    native/return_value(native/call_expression("value_string_append_validated", ["worker", "value", "suffix", "suffix_length", "scalars", "ascii"]))
  ])
  name = "value_string_concat"
  context = native/declare_function(context, name, result, [
      ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow],
      ["left", word, :Gc],
      ["right", word, :Gc]
    ],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, name, [
    native/let_call("checked", [:Record, "HeapStringResult"], "value_as_string", ["right"]),
    native/unless_statement(native/field_expression("checked", "ok"), [native/return_zero()]),
    native/let_field("pointer", [:Pointer, header, :Const], "checked", "header"),
    native/let_load("header", header, "pointer"),
    native/let_field("data", bytes, "header", "data"),
    native/let_field("length", :U64, "header", "length"),
    native/let_field("scalars", :U64, "header", "scalars"),
    native/let_field("ascii", :Bool, "header", "ascii"),
    native/let_statement("source", [:Pointer, :U8, :Const], native/unary_expression(:Freeze, "data")),
    native/let_call("result", result, "value_string_append_validated", ["worker", "left", "source", "length", "scalars", "ascii"]),
    native/return_value("result")
  ])
  return context
end
