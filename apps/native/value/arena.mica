// Eight-byte aligned bump allocation in linked chunks. Addresses remain
// stable when the arena grows. The C host supplies only malloc/free wrappers.
verb native_value/arena(input: map) -> map
  let context: map = input
  let bytes = [:Pointer, :U8, :Mutable]
  let block = [:Record, "ValueArenaBlock"]
  let block_ptr = [:Pointer, block, :Mutable]
  let arena = [:Record, "ValueArena"]
  let arena_ptr = [:Pointer, arena, :Mutable]
  let state = context[:state]
  state = native/record_type(state, "ValueArenaBlock", [["next", block_ptr], ["used", :U64], ["capacity", :U64]])[1]
  state = native/record_type(state, "ValueArena", [["head", block_ptr]])[1]
  let [constants, next] = native/constants(state, [["null_bytes", bytes, "null"], ["null_block", block_ptr, "null"],
    ["chunk_size", :U64, "0000000000010000"], ["alignment_mask", :U64, "fffffffffffffff8"],
    ["alignment_slack", :U64, "0000000000000007"], ["allocation_limit", :U64, "7fffffffffffffc0"]])
  let all_constants: map = context[:constants]
  for key, id in constants
    all_constants[key] = id
  end
  context[:constants] = all_constants
  context[:state] = next
  context = native/declare_function(context, "allocate", bytes, [["size", :U64, :Value]], [], [:Allocate], :Owned, "")
  context[:state] = native/foreign(context[:state], context[:functions]["allocate"])
  context = native/declare_function(context, "release", :Void, [["allocation", bytes, :Consume]], [], [:Release], :Value, "")
  context[:state] = native/foreign(context[:state], context[:functions]["release"])
  context = native/declare_function(context, "value_arena_allocate", bytes, [["arena", arena_ptr, :Borrow], ["size", :U64, :Value]],
    [["adopted", block_ptr]], [:ReadMemory, :WriteMemory, :Allocate], :Borrow, "arena")
  let failure: list = [native/return_value("null_bytes")]
  context = native/define_function(
    context,
    "value_arena_allocate",
    [
      native/note_statement(:Invariant, "Arena allocations remain stable and are aligned to eight bytes."),
      native/when_statement(native/binary_expression(:Equal, "size", "zero"), failure),
      native/when_statement(native/binary_expression(:Less, "allocation_limit", "size"), failure),
      native/let_statement("header_size", :U64, native/unary_expression(:SizeOf, block)),
      native/let_statement(
        "head_slot",
        [:Pointer, block_ptr, :Mutable],
        native/field_pointer_expression("arena", "head")
      ),
      native/let_load("head", block_ptr, "head_slot"),
      native/let_statement("aligned", :U64, "zero"),
      native/let_statement("fits", :Bool, "false"),
      native/unless_statement(native/binary_expression(:Equal, "head", "null_block"), [
        native/let_load("existing", block, "head"),
        native/let_field("used", :U64, "existing", "used"),
        native/let_field("available", :U64, "existing", "capacity"),
        native/set_statement("aligned", native/binary_expression(:Add, "used", "alignment_slack")),
        native/set_statement("aligned", native/binary_expression(:BitAnd, "aligned", "alignment_mask")),
        native/unless_statement(native/binary_expression(:Less, "available", "aligned"), [
          native/let_statement("remaining", :U64, native/binary_expression(:Subtract, "available", "aligned")),
          native/unless_statement(
            native/binary_expression(:Less, "remaining", "size"),
            [native/set_statement("fits", "true")]
          )
        ])
      ]),
      native/if_statement("fits", [native/set_statement("adopted", "head")], [
        native/let_statement("capacity", :U64, "size"),
        native/when_statement(
          native/binary_expression(:Less, "size", "chunk_size"),
          [native/set_statement("capacity", "chunk_size")]
        ),
        native/let_statement("total", :U64, native/binary_expression(:Add, "capacity", "header_size")),
        native/let_call("owned_bytes", bytes, "allocate", ["total"]),
        native/when_statement(native/binary_expression(:Equal, "owned_bytes", "null_bytes"), failure),
        native/let_statement("owned_block", block_ptr, native/unary_expression(:PointerCast, "owned_bytes")),
        native/set_statement("adopted", native/binary_expression(:Adopt, "head_slot", "owned_block")),
        native/let_statement("header", block, native/record_expression(["head", "zero", "capacity"])),
        native/store_statement("adopted", "header"),
        native/set_statement("aligned", "zero")
      ]),
      native/let_statement("base", bytes, native/unary_expression(:PointerCast, "adopted")),
      native/let_offset("data", bytes, "base", "header_size"),
      native/let_statement("next_used", :U64, native/binary_expression(:Add, "aligned", "size")),
      native/let_statement("used_slot", [:Pointer, :U64, :Mutable], native/field_pointer_expression("adopted", "used")),
      native/store_statement("used_slot", "next_used"),
      native/return_value(native/offset_expression("data", "aligned"))
    ]
  )
  context = native/declare_function(context, "value_arena_release", :Void, [["arena", arena_ptr, :Consume]], [], [:ReadMemory, :WriteMemory, :Release], :Value, "")
  context = native/define_function(
    context,
    "value_arena_release",
    [
      native/let_statement(
        "head_slot",
        [:Pointer, block_ptr, :Mutable],
        native/field_pointer_expression("arena", "head")
      ),
      native/let_load("head", block_ptr, "head_slot"),
      native/while_statement("true", [
        native/when_statement(native/binary_expression(:Equal, "head", "null_block"), [native/break_statement()]),
        native/note_statement(:Invariant, "Read the next block before releasing the current block."),
        native/let_load("header", block, "head"),
        native/let_field("next", block_ptr, "header", "next"),
        native/let_statement("bytes", bytes, native/unary_expression(:PointerCast, "head")),
        native/do_statement(native/call_expression("release", ["bytes"])),
        native/set_statement("head", "next")
      ]),
      native/let_statement("empty", arena, native/zero_expression()),
      native/store_statement("arena", "empty"),
      native/return_void()
    ]
  )
  return context
end
