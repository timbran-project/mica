// Eight-byte aligned bump allocation in linked chunks. Addresses remain
// stable when the arena grows. The C host supplies only malloc/free wrappers.
verb native_value/arena(input: map) -> map
  let context: map = input
  let bytes = [:Pointer, :U8, :Mutable]
  let block = [:Record, "ValueArenaBlock"]
  let block_ptr = [:Pointer, block, :Mutable]
  let arena = [:Record, "ValueArena"]
  let arena_ptr = [:Pointer, arena, :Mutable]
  let state = context[:state]
  state = native/record_type(state, "ValueArenaBlock", [["next", block_ptr], ["used", :U64], ["capacity", :U64]])[1]
  state = native/record_type(state, "ValueArena", [["head", block_ptr]])[1]
  let [constants, next] = native/constants(state, [["null_bytes", bytes, "null"], ["null_block", block_ptr, "null"],
    ["chunk_size", :U64, "0000000000010000"], ["alignment_mask", :U64, "fffffffffffffff8"],
    ["alignment_slack", :U64, "0000000000000007"], ["allocation_limit", :U64, "7fffffffffffffc0"]])
  let all_constants: map = context[:constants]
  for key, id in constants
    all_constants[key] = id
  end
  context[:constants] = all_constants
  context[:state] = next
  context = native_value/function(context, "allocate", bytes, [["size", :U64, :Value]], [], [], [:Allocate], :Owned, "")
  context[:state] = native/foreign(context[:state], context[:functions]["allocate"])
  context = native_value/function(context, "release", :Void, [["allocation", bytes, :Consume]], [], [], [:Release], :Value, "")
  context[:state] = native/foreign(context[:state], context[:functions]["release"])
  context = native_value/function(context, "value_arena_allocate", bytes, [["arena", arena_ptr, :Borrow], ["size", :U64, :Value]],
    [["adopted", block_ptr]], [], [:ReadMemory, :WriteMemory, :Allocate], :Borrow, "arena")
  let failure: list = [[:Return, "null_bytes"]]
  context = native_value/body(context, "value_arena_allocate", [
    [:Note, :Invariant, "Arena allocations remain stable and are aligned to eight bytes."],
    [:If, [:Equal, "size", "zero"], failure, []],
    [:If, [:Less, "allocation_limit", "size"], failure, []],
    [:Let, "header_size", :U64, [:SizeOf, block]],
    [:Let, "head_slot", [:Pointer, block_ptr, :Mutable], [:FieldPointer, "arena", "head"]],
    [:Let, "head", block_ptr, [:Load, "head_slot"]],
    [:Let, "aligned", :U64, "zero"], [:Let, "fits", :Bool, "false"],
    [:If, [:Equal, "head", "null_block"], [], [
      [:Let, "existing", block, [:Load, "head"]],
      [:Let, "used", :U64, [:Field, "existing", "used"]],
      [:Let, "available", :U64, [:Field, "existing", "capacity"]],
      [:Set, "aligned", [:Add, "used", "alignment_slack"]],
      [:Set, "aligned", [:BitAnd, "aligned", "alignment_mask"]],
      [:If, [:Less, "available", "aligned"], [], [
        [:Let, "remaining", :U64, [:Subtract, "available", "aligned"]],
        [:If, [:Less, "remaining", "size"], [], [[:Set, "fits", "true"]]]]]]],
    [:If, "fits", [[:Set, "adopted", "head"]], [
      [:Let, "capacity", :U64, "size"],
      [:If, [:Less, "size", "chunk_size"], [[:Set, "capacity", "chunk_size"]], []],
      [:Let, "total", :U64, [:Add, "capacity", "header_size"]],
      [:Let, "owned_bytes", bytes, [:Call, "allocate", "total"]],
      [:If, [:Equal, "owned_bytes", "null_bytes"], failure, []],
      [:Let, "owned_block", block_ptr, [:PointerCast, "owned_bytes"]],
      [:Set, "adopted", [:Adopt, "head_slot", "owned_block"]],
      [:Let, "header", block, [:Record, "head", "zero", "capacity"]],
      [:Do, [:Store, "adopted", "header"]], [:Set, "aligned", "zero"]]],
    [:Let, "base", bytes, [:PointerCast, "adopted"]],
    [:Let, "data", bytes, [:Offset, "base", "header_size"]],
    [:Let, "next_used", :U64, [:Add, "aligned", "size"]],
    [:Let, "used_slot", [:Pointer, :U64, :Mutable], [:FieldPointer, "adopted", "used"]],
    [:Do, [:Store, "used_slot", "next_used"]], [:Return, [:Offset, "data", "aligned"]]])
  context = native_value/function(context, "value_arena_release", :Void, [["arena", arena_ptr, :Consume]], [], [],
    [:ReadMemory, :WriteMemory, :Release], :Value, "")
  context = native_value/body(context, "value_arena_release", [
    [:Let, "head_slot", [:Pointer, block_ptr, :Mutable], [:FieldPointer, "arena", "head"]],
    [:Let, "head", block_ptr, [:Load, "head_slot"]],
    [:While, "true", [
      [:If, [:Equal, "head", "null_block"], [[:Break]], []],
      [:Note, :Invariant, "Read the next block before releasing the current block."],
      [:Let, "header", block, [:Load, "head"]], [:Let, "next", block_ptr, [:Field, "header", "next"]],
      [:Let, "bytes", bytes, [:PointerCast, "head"]], [:Do, [:Call, "release", "bytes"]], [:Set, "head", "next"]]],
    [:Let, "empty", arena, [:Zero]], [:Do, [:Store, "arena", "empty"]], [:Return]])
  return context
end
