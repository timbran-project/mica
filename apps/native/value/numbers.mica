verb native_value/numbers(input: map) -> map
  let context: map = input
  for spec in [["add", :CheckedAdd, :Add], ["sub", :CheckedSubtract, :Subtract],
               ["mul", :CheckedMultiply, :Multiply], ["div", :CheckedDivide, :Divide],
               ["rem", :CheckedRemainder, :Remainder]]
    context = native_value/binary_number(context, spec)
  end
  for name in ["value_checked_neg", "value_to_int", "value_to_float"]
    context = native_value/unary_number(context, name)
  end
  return context
end

verb native_value/binary_number(input: map, spec: list) -> map
  let context: map = input
  let name = string_concat("value_checked_", spec[0])
  let word = native_value/word()
  let result = [:Record, "ValueResult"]
  let ir = [:Record, "IntResult"]
  let fr = [:Record, "FloatResult"]
  let failure: list = [[:Return, [:Zero]]]
  context = native_value/function(context, name, result, [["left", word, :Borrow], ["right", word, :Borrow]], [], [], :Immediate, "")
  let integers: list = [[:Let, "li", ir, [:Call, "value_as_int", "left"]], [:Let, "ri", ir, [:Call, "value_as_int", "right"]],
    [:Let, "a", :I64, [:Field, "li", "number"]], [:Let, "b", :I64, [:Field, "ri", "number"]]]
  if spec[0] == "div"
    integers = [@integers, [:Note, :Invariant, "Integer division succeeds only for an exact quotient."],
      [:Let, "remainder", ir, [:CheckedRemainder, "a", "b"]], [:If, [:Field, "remainder", "ok"], [], failure],
      [:If, [:Equal, [:Expr, :I64, [:Field, "remainder", "number"]], "int_zero"], [], failure]]
  end
  integers = [@integers, [:Let, "checked", ir, [spec[1], "a", "b"]],
    [:If, [:Field, "checked", "ok"], [], failure], [:Return, [:Call, "value_int", [:Expr, :I64, [:Field, "checked", "number"]]]]]
  let floats: list = [[:Let, "lf", fr, [:Call, "value_as_float", "left"]], [:Let, "rf", fr, [:Call, "value_as_float", "right"]],
    [:Let, "x", :F32, [:Field, "lf", "number"]], [:Let, "y", :F32, [:Field, "rf", "number"]]]
  if spec[0] == "div" || spec[0] == "rem"
    floats = [@floats, [:If, [:Equal, "y", "float_zero"], failure, []]]
  end
  let expression = [spec[2], "x", "y"]
  floats = [@floats, [:Let, "number", :F32, expression], [:Return, [:Call, "value_float", "number"]]]
  context = native_value/body(context, name, [
    [:Let, "ltag", :U8, [:Tag, "left"]], [:Let, "rtag", :U8, [:Tag, "right"]],
    [:If, [:Equal, "ltag", "rtag"], [], failure], [:If, [:Equal, "ltag", "tag_int"], integers, []],
    [:If, [:Equal, "ltag", "tag_float"], floats, failure]])
  return context
end

verb native_value/unary_number(input: map, name: string) -> map
  let context: map = input
  let word = native_value/word()
  let result = [:Record, "ValueResult"]
  let ir = [:Record, "IntResult"]
  let fr = [:Record, "FloatResult"]
  let failure: list = [[:Return, [:Zero]]]
  context = native_value/function(context, name, result, [["value", word, :Borrow]], [], [], :Immediate, "")
  let integers: list = [[:Let, "ir", ir, [:Call, "value_as_int", "value"]], [:Let, "integer", :I64, [:Field, "ir", "number"]]]
  if name == "value_to_float"
    integers = [@integers, [:Return, [:Call, "value_float", [:Expr, :F32, [:Convert, "integer"]]]]]
  else
    if name == "value_checked_neg"
      integers = [@integers, [:Note, :Invariant, "Every valid integer fits 56 bits, so I64 negation cannot overflow."],
        [:Let, "negated", ir, [:CheckedNegate, "integer"]], [:Set, "integer", [:Field, "negated", "number"]]]
    end
    integers = [@integers, [:Return, [:Call, "value_int", "integer"]]]
  end
  let floats: list = [[:Let, "fr", fr, [:Call, "value_as_float", "value"]], [:Let, "number", :F32, [:Field, "fr", "number"]]]
  if name == "value_to_int"
    floats = [@floats, [:Let, "converted", :F32, [:Truncate, "number"]],
      [:If, [:Equal, "number", "converted"], [], failure],
      [:Let, "checked", ir, [:CheckedFloatToInt, "number"]], [:If, [:Field, "checked", "ok"], [], failure],
      [:Return, [:Call, "value_int", [:Expr, :I64, [:Field, "checked", "number"]]]]]
  else
    if name == "value_checked_neg"
      floats = [@floats, [:Set, "number", [:Negate, "number"]]]
    end
    floats = [@floats, [:Return, [:Call, "value_float", "number"]]]
  end
  context = native_value/body(context, name, [[:Let, "tag", :U8, [:Tag, "value"]],
    [:If, [:Equal, "tag", "tag_int"], integers, []], [:If, [:Equal, "tag", "tag_float"], floats, failure]])
  return context
end
