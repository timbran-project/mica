// Persistence excludes ephemeral authority and executable handles at any depth.
// A persistable symbol can still lack a name in the selected codec namespace.
verb native_value/persistence(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  context = native/declare_function(context, "value_is_persistable", :Bool, [["value", word, :Gc]], [], [:ReadMemory], :Value, "")
  let cases: list = [native/case_arm("zero_tag", [native/return_value("true")])]
  for name in ["bool", "int", "float", "identity", "symbol", "error_code", "string", "bytes"]
    cases = [
      @cases,
      native/case_arm(string_concat("tag_", name), [native/return_value("true")])
    ]
  end
  for spec in [["list", "HeapList", word], ["map", "HeapMap", [:Record, "ValueMapEntry"]]]
    let name: string = spec[0]
    let header: string = string_concat(name, "_header")
    let data: string = string_concat(name, "_data")
    let length: string = string_concat(name, "_length")
    let index: string = string_concat(name, "_i")
    let element: string = string_concat(name, "_element")
    let children: list = []
    if name == "list"
      children = [
        native/unless_statement(
          native/call_expression("value_is_persistable", [element]),
          [native/return_value("false")]
        )
      ]
    else
      for field in ["key", "value"]
        children = [
          @children,
          native/unless_statement(
            native/call_expression("value_is_persistable", [native/typed_field(word, element, field)]),
            [native/return_value("false")]
          )
        ]
      end
    end
    cases = [
      @cases,
      native/case_arm(string_concat("tag_", name), [
        native/let_load(
          header,
          [:Record, spec[1]],
          native/typed_expression(
            [:Pointer, [:Record, spec[1]], :Const],
            native/unary_expression(:UnpackPointer, "value")
          )
        ),
        native/let_field(data, [:Pointer, spec[2], :Mutable], header, "data"),
        native/let_field(length, :U64, header, "length"),
        @native/for_range(index, "zero", length, [
          native/let_load(
            element,
            spec[2],
            native/typed_expression([:Pointer, spec[2], :Mutable], native/offset_expression(data, index))
          ),
          @children]),
        native/return_value("true")
      ])
    ]
  end
  for spec in native_value/record_plan(:Persist)
    let header: string = string_concat(spec[0], "_header")
    let body: list = [
      native/let_load(
        header,
        [:Record, spec[1]],
        native/typed_expression(
          [:Pointer, [:Record, spec[1]], :Const],
          native/unary_expression(:UnpackPointer, "value")
        )
      )
    ]
    for field in spec[2]
      let step: list = [
        native/unless_statement(
          native/call_expression("value_is_persistable", [native/typed_field(word, header, field[0])]),
          [native/return_value("false")]
        )
      ]
      if field[1] != ""
        step = [native/when_statement(native/field_expression(header, field[1]), step)]
      end
      body = [@body, @step]
    end
    cases = [
      @cases,
      native/case_arm(string_concat("tag_", spec[0]), [
        @body,
        native/return_value("true")
      ])
    ]
  end
  cases = [
    @cases,
    native/case_arm("tag_relation", [
      native/let_load(
        "relation",
        [:Record, "HeapRelation"],
        native/typed_expression(
          [:Pointer, [:Record, "HeapRelation"], :Const],
          native/unary_expression(:UnpackPointer, "value")
        )
      ),
      native/let_field("arity", :U64, "relation", "arity"),
      native/let_field("length", :U64, "relation", "length"),
      native/let_field("tuples", [:Pointer, [:Record, "ValueTuple"], :Mutable], "relation", "rows"),
      @native/for_range("row", "zero", "length", [
        native/let_load(
          "tuple",
          [:Record, "ValueTuple"],
          native/typed_expression(
            [:Pointer, [:Record, "ValueTuple"], :Mutable],
            native/offset_expression("tuples", "row")
          )
        ),
        native/let_field("cells", [:Pointer, word, :Mutable], "tuple", "data"),
        @native/for_range("column", "zero", "arity", [
          native/let_load(
            "cell",
            word,
            native/typed_expression([:Pointer, word, :Mutable], native/offset_expression("cells", "column"))
          ),
          native/unless_statement(
            native/call_expression("value_is_persistable", ["cell"]),
            [native/return_value("false")]
          )])]),
      native/return_value("true")
    ])
  ]
  context = native/define_function(
    context,
    "value_is_persistable",
    [ native/switch_statement(:U8, native/unary_expression(:Tag, "value"), cases, [native/return_value("false")])]
  )
  return context
end
