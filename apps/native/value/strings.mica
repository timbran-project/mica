// A string view retains its backing allocation. Sampled offsets address the
// backing from its first scalar, so slices can reuse the same immutable index.
verb native_value/strings(input: map) -> map
  let context: map = input
  let bytes: list = [:Pointer, :U8, :Mutable]
  let offsets: list = [:Pointer, :U64, :Mutable]
  let storage: list = [:Record, "StringStorage"]
  let header: list = [:Record, "HeapString"]
  let state: map = context[:state]
  state = native/record_type(state, "StringStorage", [["data", bytes], ["capacity", :U64], ["used", :U64], ["index", offsets]])[1]
  state = native/record_type(state, "HeapString", [["data", bytes], ["length", :U64], ["scalars", :U64], ["ascii", :Bool],
    ["storage", [:Pointer, storage, :Mutable]], ["byte_start", :U64], ["scalar_start", :U64]])[1]
  state = native/record_type(state, "StringAllocation", [["ok", :Bool], ["header", [:Pointer, header, :Mutable]]])[1]
  let [ids, next] = native/constants(state, [["string_stride", :U64, "0000000000000020"], ["string_index_min", :U64, "0000000000000080"],
    ["string_null_index", offsets, "null"], ["string_index_width", :U64, "0000000000000008"]])
  let constants: map = context[:constants]
  for name, id in ids
    constants[name] = id
  end
  context[:constants] = constants
  context[:state] = next
  context = native_value/string_allocate(context)
  context = native_value/string_index(context)
  context = native_value/string_constructor(context)
  context = native_value/heap_accessor(context, "string", header)
  context = native_value/string_access(context)
  context = native_value/string_append(context)
  context = native_value/string_search(context)
  return context
end

// Allocate headers, index, and byte capacity together, without publishing a
// tagged value before its bytes and index are initialized.
verb native_value/string_allocate(input: map) -> map
  let context: map = input
  let name: string = "value_string_allocate"
  let header: list = [:Record, "HeapString"]
  let storage: list = [:Record, "StringStorage"]
  let bytes: list = [:Pointer, :U8, :Mutable]
  let result: list = [:Record, "StringAllocation"]
  context = native/declare_function(context, name, result, [
      ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow],
      ["length", :U64, :Value],
      ["capacity", :U64, :Value],
      ["scalars", :U64, :Value],
      ["ascii", :Bool, :Value]
    ],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, name, [
    native/when_statement(native/binary_expression(:Less, "capacity", "length"), [native/return_zero()]),
    native/when_statement(native/binary_expression(:Less, "length", "scalars"), [native/return_zero()]),
    native/let_statement("header_size", :U64, native/unary_expression(:SizeOf, header)),
    native/let_statement("storage_size", :U64, native/unary_expression(:SizeOf, storage)),
    native/let_statement("fixed_size", :U64, native/binary_expression(:Add, "header_size", "storage_size")),
    native/let_statement("limit", :U64, native/binary_expression(:Subtract, "allocation_limit", "fixed_size")),
    native/when_statement(native/binary_expression(:Less, "limit", "capacity"), [native/return_zero()]),
    native/if_statement(native/binary_expression(:Less, "capacity", "string_index_min"), [
      native/let_statement("sample_count", :U64, "zero")
    ], [
      native/set_statement("sample_count", native/binary_expression(:Divide, "capacity", "string_stride")),
      native/set_statement("sample_count", native/binary_expression(:Add, "sample_count", "one"))
    ]),
    native/set_statement("limit", native/binary_expression(:Subtract, "limit", "capacity")),
    native/set_statement("limit", native/binary_expression(:Divide, "limit", "string_index_width")),
    native/when_statement(native/binary_expression(:Less, "limit", "sample_count"), [native/return_zero()]),
    native/let_statement(
      "sample_bytes",
      :U64,
      native/binary_expression(:Multiply, "sample_count", "string_index_width")
    ),
    native/let_statement("total", :U64, native/binary_expression(:Add, "fixed_size", "sample_bytes")),
    native/set_statement("total", native/binary_expression(:Add, "total", "capacity")),
    @native_memory/allocate("allocation", "total", "layout_string", [native/return_zero()]),
    native/let_statement("pointer", [:Pointer, header, :Mutable], native/unary_expression(:PointerCast, "allocation")),
    native/let_offset("cursor", bytes, "allocation", "header_size"),
    native/let_statement("backing", [:Pointer, storage, :Mutable], native/unary_expression(:PointerCast, "cursor")),
    native/set_statement("cursor", native/offset_expression("allocation", "fixed_size")),
    native/let_offset("data", bytes, "cursor", "sample_bytes"),
    native/let_statement("index", [:Pointer, :U64, :Mutable], "string_null_index"),
    native/unless_statement(
      native/binary_expression(:Equal, "sample_count", "zero"),
      [native/set_statement("index", native/unary_expression(:PointerCast, "cursor"))]
    ),
    native/note_statement(
      :Invariant,
      "Publish only after initializing both the string header and its backing metadata."
    ),
    native/let_statement("storage", storage, native/record_expression(["data", "capacity", "length", "index"])),
    native/store_statement("backing", "storage"),
    native/let_statement(
      "header",
      header,
      native/record_expression(["data", "length", "scalars", "ascii", "backing", "zero", "zero"])
    ),
    native/store_statement("pointer", "header"),
    native/let_statement("result", result, native/record_expression(["true", "pointer"])),
    native/return_value("result")
  ])
  return context
end

// Fill samples from a known scalar boundary in validated UTF-8. Appends fill
// only their new suffix, leaving every previously published offset unchanged.
verb native_value/string_index(input: map) -> map
  let context: map = input
  let name: string = "value_string_index"
  let storage: list = [:Record, "StringStorage"]
  context = native/declare_function(context, name, :Bool, [
      ["storage", [:Pointer, storage, :Mutable], :Borrow],
      ["offset", :U64, :Value],
      ["scalar", :U64, :Value],
      ["length", :U64, :Value],
      ["ascii", :Bool, :Value]
    ],
    [], [:ReadMemory, :WriteMemory], :Value, "")
  let builder: map = native_gen/context(context, name)
  let [backing: map, with_backing: map] = native_gen/bind(builder, "backing", native_gen/load(native_gen/ref(builder, "storage")))
  builder = with_backing
  let data: map = native_gen/field(builder, backing, "data")
  let index: map = native_gen/field(builder, backing, "index")
  let offset: map = native_gen/ref(builder, "offset")
  let scalar: map = native_gen/ref(builder, "scalar")
  let length: map = native_gen/ref(builder, "length")
  let stride: map = native_gen/ref(builder, "string_stride")
  let one: map = native_gen/ref(builder, "one")
  let success = fn(done) => native_gen/return_value(done, native_gen/ref(done, "true"))
  let failure = fn(failed) => native_gen/return_zero(failed)
  builder = native_gen/when(builder, native_gen/equal(index, native_gen/ref(builder, "string_null_index")), success)
  builder = native_gen/when(builder, native_gen/less(length, offset), failure)
  builder = native_gen/when(builder, native_gen/ref(builder, "ascii"), fn(input_ascii)
    let ascii: map = input_ascii
    let first: map = native_gen/divide(native_gen/add(scalar, native_gen/subtract(stride, one)), stride)
    let last: map = native_gen/divide(native_gen/add(scalar, native_gen/subtract(length, offset)), stride)
    ascii = native_gen/for_range(ascii, "sample", first, native_gen/add(last, one), fn(sample, number)
      let position: map = native_gen/add(offset, native_gen/subtract(native_gen/multiply(number, stride), scalar))
      return native_gen/store(sample, native_gen/offset(index, number), position)
    end)
    return success(ascii)
  end)
  let [position: map, with_position: map] = native_gen/bind(builder, "position", offset)
  builder = with_position
  let [count: map, with_count: map] = native_gen/bind(builder, "scalar", scalar)
  builder = with_count
  builder = native_gen/while_loop(builder, native_gen/ref(builder, "true"), fn(input_scan)
    let scan: map = input_scan
    scan = native_gen/when(scan, native_gen/less(length, position), failure)
    scan = native_gen/when(scan, native_gen/equal(native_gen/remainder(count, stride), native_gen/zero(:U64)), fn(sample)
      return native_gen/store(sample, native_gen/offset(index, native_gen/divide(count, stride)), position)
    end)
    scan = native_gen/when(scan, native_gen/equal(position, length), success)
    return native_value/advance_utf8(scan, data, position, count)
  end)
  builder = native_gen/return_zero(builder)
  context = native_gen/finish(context, builder)
  return context
end

verb native_value/string_constructor(input: map) -> map
  let context: map = input
  let name: string = "value_string"
  let header: list = [:Record, "HeapString"]
  let result: list = [:Record, "ValueResult"]
  context = native/declare_function(context, name, result, [
      ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow],
      ["source", [:Pointer, :U8, :Const], :Borrow],
      ["length", :U64, :Value]
    ],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, name, [
    native/when_statement(native/binary_expression(:Less, "allocation_limit", "length"), [native/return_zero()]),
    @native/try_call("scan", [:Record, "Utf8Scan"], "utf8_scan", ["source", "length"], [native/return_zero()]),
    native/let_field("scalars", :U64, "scan", "scalars"),
    native/let_field("ascii", :Bool, "scan", "ascii"),
    @native/try_call("allocation", [:Record, "StringAllocation"], "value_string_allocate", ["worker", "length", "length", "scalars", "ascii"], [native/return_zero()]),
    native/let_field("pointer", [:Pointer, header, :Mutable], "allocation", "header"),
    native/let_load("header", header, "pointer"),
    native/let_field("data", [:Pointer, :U8, :Mutable], "header", "data"),
    native/let_field("storage", [:Pointer, [:Record, "StringStorage"], :Mutable], "header", "storage"),
    native/copy_bytes_statement("data", "source", "length"),
    native/unless_statement(
      native/call_expression("value_string_index", ["storage", "zero", "zero", "length", "ascii"]),
      [native/return_zero()]
    ),
    native/let_statement("value", native_value/word(), native/binary_expression(:PackPointer, "pointer", "tag_string")),
    native/let_statement("result", result, native/record_expression(["true", "value"])),
    native/return_value("result")
  ])
  return context
end

verb native_value/string_access(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let header: list = [:Record, "HeapString"]
  let header_pointer: list = [:Pointer, header, :Const]
  let result: list = [:Record, "IdResult"]
  let name: string = "value_string_length"
  context = native/declare_function(context, name, result, [["value", word, :Gc]],
    [], [:ReadMemory], :Value, "")
  context = native/define_function(context, name, [
    @native/try_call("checked", [:Record, "HeapStringResult"], "value_as_string", ["value"], [native/return_zero()]),
    native/let_field("pointer", header_pointer, "checked", "header"),
    native/let_load("header", header, "pointer"),
    native/let_field("count", :U64, "header", "scalars"),
    native/let_statement("result", result, native/record_expression(["true", "count"])),
    native/return_value("result")
  ])
  name = "value_string_byte_offset"
  context = native/declare_function(context, name, result, [["value", word, :Gc], ["position", :U64, :Value]],
    [], [:ReadMemory], :Value, "")
  context = native_value/string_offset(context)

  name = "value_string_scalar_at"
  context = native/declare_function(context, name, [:Record, "RuneResult"], [["value", word, :Gc], ["position", :U64, :Value]],
    [], [:ReadMemory], :Value, "")
  context = native/define_function(context, name, [
    @native/try_call("offset_result", result, "value_string_byte_offset", ["value", "position"], [native/return_zero()]),
    native/let_field("offset", :U64, "offset_result", "number"),
    native/let_statement("pointer", header_pointer, native/unary_expression(:UnpackPointer, "value")),
    native/let_load("header", header, "pointer"),
    native/let_field("length", :U64, "header", "length"),
    native/let_field("data", [:Pointer, :U8, :Mutable], "header", "data"),
    native/let_offset("source", [:Pointer, :U8, :Mutable], "data", "offset"),
    native/let_statement("text", [:Pointer, :U8, :Const], native/unary_expression(:Freeze, "source")),
    native/set_statement("length", native/binary_expression(:Subtract, "length", "offset")),
    @native/try_call("decoded", [:Record, "Utf8Decode"], "utf8_decode", ["text", "length"], [native/return_zero()]),
    native/let_field("rune", [:Scalar, "Rune", :U32], "decoded", "rune"),
    native/let_statement("result", [:Record, "RuneResult"], native/record_expression(["true", "rune"])),
    native/return_value("result")
  ])
  context = native_value/string_slice(context)
  return context
end

verb native_value/string_slice(input: map) -> map
  let context: map = input
  let name: string = "value_string_slice"
  let word: list = native_value/word()
  let header: list = [:Record, "HeapString"]
  let result: list = [:Record, "ValueResult"]
  context = native/declare_function(context, name, result, [
      ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow],
      ["value", word, :Gc],
      ["start", :U64, :Value],
      ["end", :U64, :Value]
    ],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, name, [
    native/when_statement(native/binary_expression(:Less, "end", "start"), [native/return_zero()]),
    native/let_call("offset", [:Record, "IdResult"], "value_string_byte_offset", ["value", "start"]),
    native/let_field("condition", :Bool, "offset", "ok"),
    native/let_field("first", :U64, "offset", "number"),
    native/unless_statement("condition", [native/return_zero()]),
    native/set_statement("offset", native/call_expression("value_string_byte_offset", ["value", "end"])),
    native/set_statement("condition", native/field_expression("offset", "ok")),
    native/let_field("last", :U64, "offset", "number"),
    native/unless_statement("condition", [native/return_zero()]),
    native/let_statement("size", :U64, native/unary_expression(:SizeOf, header)),
    @native_memory/allocate("allocation", "size", "layout_string_view", [native/return_zero()]),
    native/note_statement(
      :Invariant,
      "Slices retain their backing and sampled index; only the view header is allocated."
    ),
    native/let_statement("target", [:Pointer, header, :Mutable], native/unary_expression(:PointerCast, "allocation")),
    native/let_statement("pointer", [:Pointer, header, :Const], native/unary_expression(:UnpackPointer, "value")),
    native/let_load("header", header, "pointer"),
    native/let_field("data", [:Pointer, :U8, :Mutable], "header", "data"),
    native/set_statement("data", native/offset_expression("data", "first")),
    native/let_field("storage", [:Pointer, [:Record, "StringStorage"], :Mutable], "header", "storage"),
    native/let_field("byte_start", :U64, "header", "byte_start"),
    native/set_statement("byte_start", native/binary_expression(:Add, "byte_start", "first")),
    native/let_field("scalar_start", :U64, "header", "scalar_start"),
    native/set_statement("scalar_start", native/binary_expression(:Add, "scalar_start", "start")),
    native/let_statement("length", :U64, native/binary_expression(:Subtract, "last", "first")),
    native/let_statement("scalars", :U64, native/binary_expression(:Subtract, "end", "start")),
    native/let_statement("ascii", :Bool, native/binary_expression(:Equal, "length", "scalars")),
    native/let_statement(
      "slice",
      header,
      native/record_expression(["data", "length", "scalars", "ascii", "storage", "byte_start", "scalar_start"])
    ),
    native/store_statement("target", "slice"),
    native/let_statement("packed", word, native/binary_expression(:PackPointer, "target", "tag_string")),
    native/let_statement("result", result, native/record_expression(["true", "packed"])),
    native/return_value("result")
  ])
  return context
end

// Views store their origins in the backing's coordinate system. The index
// selects a backing sample; only the returned byte position is view-relative.
verb native_value/string_offset(input: map) -> map
  let context: map = input
  let builder: map = native_gen/context(context, "value_string_byte_offset")
  let failure = fn(failed) => native_gen/return_zero(failed)
  let [checked: map, with_checked: map] = native_value/checked_result(builder, "value_as_string", [native_gen/ref(builder, "value")], failure)
  builder = with_checked
  let [header: map, with_header: map] = native_gen/bind(builder, "header", native_gen/load(native_gen/field(builder, checked, "header")))
  builder = with_header
  let position: map = native_gen/ref(builder, "position")
  let length: map = native_gen/field(builder, header, "length")
  let scalars: map = native_gen/field(builder, header, "scalars")
  let result = fn(body, number) => native_gen/return_value(body, native_gen/record(body, [:Record, "IdResult"], {"ok" -> native_gen/ref(body, "true"), "number" -> number}))
  builder = native_gen/when(builder, native_gen/less(scalars, position), failure)
  builder = native_gen/when(builder, native_gen/equal(position, scalars), fn(done) => result(done, length))
  builder = native_gen/when(builder, native_gen/field(builder, header, "ascii"), fn(ascii) => result(ascii, position))
  let [storage: map, with_storage: map] = native_gen/bind(builder, "storage", native_gen/load(native_gen/field(builder, header, "storage")))
  builder = with_storage
  let data: map = native_gen/field(builder, storage, "data")
  let index: map = native_gen/field(builder, storage, "index")
  let origin: map = native_gen/field(builder, header, "byte_start")
  let scalar_origin: map = native_gen/field(builder, header, "scalar_start")
  let [target: map, with_target: map] = native_gen/bind(builder, "target", native_gen/add(scalar_origin, position))
  builder = with_target
  let [offset: map, with_offset: map] = native_gen/bind(builder, "offset", origin)
  builder = with_offset
  let [count: map, with_count: map] = native_gen/bind(builder, "scalar", scalar_origin)
  builder = with_count
  builder = native_gen/unless(builder, native_gen/equal(index, native_gen/ref(builder, "string_null_index")), fn(input_sample)
    let sample: map = input_sample
    let stride: map = native_gen/ref(sample, "string_stride")
    let [number: map, with_number: map] = native_gen/bind(sample, "sample", native_gen/divide(target, stride))
    sample = with_number
    sample = native_gen/assign(sample, offset, native_gen/load(native_gen/offset(index, number)))
    return native_gen/assign(sample, count, native_gen/multiply(number, stride))
  end)
  builder = native_gen/while_loop(builder, native_gen/less(count, target), fn(scan)
    return native_value/advance_utf8(scan, data, offset, count)
  end)
  builder = result(builder, native_gen/subtract(offset, origin))
  context = native_gen/finish(context, builder)
  return context
end
