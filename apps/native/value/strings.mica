// A string view retains its backing allocation. Sampled offsets address the
// backing from its first scalar, so slices can reuse the same immutable index.
verb native_value/strings(input: map) -> map
  let context: map = input
  let bytes: list = [:Pointer, :U8, :Mutable]
  let offsets: list = [:Pointer, :U64, :Mutable]
  let storage: list = [:Record, "StringStorage"]
  let header: list = [:Record, "HeapString"]
  let state: map = context[:state]
  state = native/record_type(state, "StringStorage", [["data", bytes], ["capacity", :U64], ["used", :U64], ["index", offsets]])[1]
  state = native/record_type(state, "HeapString", [["data", bytes], ["length", :U64], ["scalars", :U64], ["ascii", :Bool],
    ["storage", [:Pointer, storage, :Mutable]], ["byte_start", :U64], ["scalar_start", :U64]])[1]
  state = native/record_type(state, "StringAllocation", [["ok", :Bool], ["header", [:Pointer, header, :Mutable]]])[1]
  let [ids, next] = native/constants(state, [["string_stride", :U64, "0000000000000020"], ["string_index_min", :U64, "0000000000000080"],
    ["string_null_index", offsets, "null"], ["string_index_width", :U64, "0000000000000008"]])
  let constants: map = context[:constants]
  for name, id in ids
    constants[name] = id
  end
  context[:constants] = constants
  context[:state] = next
  context = native_value/string_allocate(context)
  context = native_value/string_index(context)
  context = native_value/string_constructor(context)
  context = native_value/heap_accessor(context, "string", header)
  context = native_value/string_access(context)
  context = native_value/string_append(context)
  context = native_value/string_search(context)
  return context
end

// Allocate headers, index, and byte capacity together, without publishing a
// tagged value before its bytes and index are initialized.
verb native_value/string_allocate(input: map) -> map
  let context: map = input
  let name: string = "value_string_allocate"
  let header: list = [:Record, "HeapString"]
  let storage: list = [:Record, "StringStorage"]
  let bytes: list = [:Pointer, :U8, :Mutable]
  let result: list = [:Record, "StringAllocation"]
  context = native_value/function(context, name, result, [
      ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow],
      ["length", :U64, :Value],
      ["capacity", :U64, :Value],
      ["scalars", :U64, :Value],
      ["ascii", :Bool, :Value]
    ],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native_value/body(context, name, [
    [:If, [:Less, "capacity", "length"], [[:Return, [:Zero]]], []],
    [:If, [:Less, "length", "scalars"], [[:Return, [:Zero]]], []],
    [:Let, "header_size", :U64, [:SizeOf, header]],
    [:Let, "storage_size", :U64, [:SizeOf, storage]],
    [:Let, "fixed_size", :U64, [:Add, "header_size", "storage_size"]],
    [:Let, "limit", :U64, [:Subtract, "allocation_limit", "fixed_size"]],
    [:If, [:Less, "limit", "capacity"], [[:Return, [:Zero]]], []],
    [:If, [:Less, "capacity", "string_index_min"], [[:Let, "sample_count", :U64, "zero"]], [
      [:Set, "sample_count", [:Divide, "capacity", "string_stride"]],
      [:Set, "sample_count", [:Add, "sample_count", "one"]]
    ]],
    [:Set, "limit", [:Subtract, "limit", "capacity"]],
    [:Set, "limit", [:Divide, "limit", "string_index_width"]],
    [:If, [:Less, "limit", "sample_count"], [[:Return, [:Zero]]], []],
    [:Let, "sample_bytes", :U64, [:Multiply, "sample_count", "string_index_width"]],
    [:Let, "total", :U64, [:Add, "fixed_size", "sample_bytes"]],
    [:Set, "total", [:Add, "total", "capacity"]],
    [:Let, "allocation", bytes, [:Call, "value_arena_allocate", "arena", "total"]],
    [:If, [:Equal, "allocation", "null_bytes"], [[:Return, [:Zero]]], []],
    [:Let, "pointer", [:Pointer, header, :Mutable], [:PointerCast, "allocation"]],
    [:Let, "cursor", bytes, [:Offset, "allocation", "header_size"]],
    [:Let, "backing", [:Pointer, storage, :Mutable], [:PointerCast, "cursor"]],
    [:Set, "cursor", [:Offset, "allocation", "fixed_size"]],
    [:Let, "data", bytes, [:Offset, "cursor", "sample_bytes"]],
    [:Let, "index", [:Pointer, :U64, :Mutable], "string_null_index"],
    [:If, [:Equal, "sample_count", "zero"], [], [[:Set, "index", [:PointerCast, "cursor"]]]],
    [:Note, :Invariant, "Publish only after initializing both the string header and its backing metadata."],
    [:Let, "storage", storage, [:Record, "data", "capacity", "length", "index"]],
    [:Do, [:Store, "backing", "storage"]],
    [:Let, "header", header, [:Record, "data", "length", "scalars", "ascii", "backing", "zero", "zero"]],
    [:Do, [:Store, "pointer", "header"]],
    [:Let, "result", result, [:Record, "true", "pointer"]],
    [:Return, "result"]
  ])
  return context
end

// Fill samples from a known scalar boundary. Appends can fill only their new
// suffix, leaving every previously published offset unchanged.
verb native_value/string_index(input: map) -> map
  let context: map = input
  let name: string = "value_string_index"
  let storage: list = [:Record, "StringStorage"]
  context = native_value/function(context, name, :Bool, [
      ["storage", [:Pointer, storage, :Mutable], :Borrow],
      ["offset", :U64, :Value],
      ["scalar", :U64, :Value],
      ["length", :U64, :Value],
      ["ascii", :Bool, :Value]
    ],
    [], [:ReadMemory, :WriteMemory], :Value, "")
  context = native_value/body(context, name, [
    [:Let, "backing", storage, [:Load, "storage"]],
    [:Let, "data", [:Pointer, :U8, :Mutable], [:Field, "backing", "data"]],
    [:Let, "index", [:Pointer, :U64, :Mutable], [:Field, "backing", "index"]],
    [:If, [:Equal, "index", "string_null_index"], [[:Return, "true"]], []],
    [:Let, "position", :U64, "offset"],
    [:Let, "count", :U64, "scalar"],
    [:While, "true", [
      [:If, [:Less, "length", "position"], [[:Return, "false"]], []],
      [:Let, "remainder", :U64, [:Remainder, "count", "string_stride"]],
      [:If, [:Equal, "remainder", "zero"], [
        [:Let, "sample_number", :U64, [:Divide, "count", "string_stride"]],
        [:Let, "sample", [:Pointer, :U64, :Mutable], [:Offset, "index", "sample_number"]],
        [:Do, [:Store, "sample", "position"]]
      ], []],
      [:If, [:Equal, "position", "length"], [[:Return, "true"]], []],
      [:If, "ascii", [
        [:Let, "remaining", :U64, [:Subtract, "length", "position"]],
        [:Let, "width", :U64, [:Subtract, "string_stride", "remainder"]],
        [:If, [:Less, "remaining", "width"], [[:Set, "width", "remaining"]], []],
        [:Set, "position", [:Add, "position", "width"]],
        [:Set, "count", [:Add, "count", "width"]]
      ], [
        [:Let, "source", [:Pointer, :U8, :Mutable], [:Offset, "data", "position"]],
        [:Let, "text", [:Pointer, :U8, :Const], [:Freeze, "source"]],
        [:Set, "remaining", [:Subtract, "length", "position"]],
        [:Let, "decoded", [:Record, "Utf8Decode"], [:Call, "utf8_decode", "text", "remaining"]],
        [:If, [:Field, "decoded", "ok"], [], [[:Return, "false"]]],
        [:Set, "width", [:Field, "decoded", "width"]],
        [:Set, "position", [:Add, "position", "width"]],
        [:Set, "count", [:Add, "count", "one"]]
      ]]
    ]],
    [:Return, "false"]
  ])
  return context
end

verb native_value/string_constructor(input: map) -> map
  let context: map = input
  let name: string = "value_string"
  let header: list = [:Record, "HeapString"]
  let result: list = [:Record, "ValueResult"]
  context = native_value/function(context, name, result, [
      ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow],
      ["source", [:Pointer, :U8, :Const], :Borrow],
      ["length", :U64, :Value]
    ],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native_value/body(context, name, [
    [:If, [:Less, "allocation_limit", "length"], [[:Return, [:Zero]]], []],
    [:Let, "scan", [:Record, "Utf8Scan"], [:Call, "utf8_scan", "source", "length"]],
    [:If, [:Field, "scan", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "scalars", :U64, [:Field, "scan", "scalars"]],
    [:Let, "ascii", :Bool, [:Field, "scan", "ascii"]],
    [:Let, "allocation", [:Record, "StringAllocation"], [:Call, "value_string_allocate", "arena", "length", "length", "scalars", "ascii"]],
    [:If, [:Field, "allocation", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "pointer", [:Pointer, header, :Mutable], [:Field, "allocation", "header"]],
    [:Let, "header", header, [:Load, "pointer"]],
    [:Let, "data", [:Pointer, :U8, :Mutable], [:Field, "header", "data"]],
    [:Let, "storage", [:Pointer, [:Record, "StringStorage"], :Mutable], [:Field, "header", "storage"]],
    [:Do, [:CopyBytes, "data", "source", "length"]],
    [:If, [:Call, "value_string_index", "storage", "zero", "zero", "length", "ascii"], [], [[:Return, [:Zero]]]],
    [:Let, "value", native_value/word(), [:PackPointer, "pointer", "tag_string"]],
    [:Let, "result", result, [:Record, "true", "value"]],
    [:Return, "result"]
  ])
  return context
end

verb native_value/string_access(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let header: list = [:Record, "HeapString"]
  let header_pointer: list = [:Pointer, header, :Const]
  let result: list = [:Record, "IdResult"]
  let name: string = "value_string_length"
  context = native_value/function(context, name, result, [["value", word, :Borrow]],
    [], [:ReadMemory], :Value, "")
  context = native_value/body(context, name, [
    [:Let, "checked", [:Record, "HeapStringResult"], [:Call, "value_as_string", "value"]],
    [:If, [:Field, "checked", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "pointer", header_pointer, [:Field, "checked", "header"]],
    [:Let, "header", header, [:Load, "pointer"]],
    [:Let, "count", :U64, [:Field, "header", "scalars"]],
    [:Let, "result", result, [:Record, "true", "count"]],
    [:Return, "result"]
  ])
  name = "value_string_byte_offset"
  context = native_value/function(context, name, result, [["value", word, :Borrow], ["position", :U64, :Value]],
    [], [:ReadMemory], :Value, "")
  context = native_value/body(context, name, [
    [:Let, "checked", [:Record, "HeapStringResult"], [:Call, "value_as_string", "value"]],
    [:If, [:Field, "checked", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "pointer", header_pointer, [:Field, "checked", "header"]],
    [:Let, "header", header, [:Load, "pointer"]],
    [:Let, "length", :U64, [:Field, "header", "length"]],
    [:Let, "scalars", :U64, [:Field, "header", "scalars"]],
    [:If, [:Less, "scalars", "position"], [[:Return, [:Zero]]], []],
    [:If, [:Equal, "position", "scalars"], [[:Let, "result", result, [:Record, "true", "length"]], [:Return, "result"]], []],
    [:If, [:Field, "header", "ascii"], [[:Set, "result", [:Record, "true", "position"]], [:Return, "result"]], []],
    [:Let, "backing", [:Pointer, [:Record, "StringStorage"], :Mutable], [:Field, "header", "storage"]],
    [:Let, "storage", [:Record, "StringStorage"], [:Load, "backing"]],
    [:Let, "data", [:Pointer, :U8, :Mutable], [:Field, "storage", "data"]],
    [:Let, "index", [:Pointer, :U64, :Mutable], [:Field, "storage", "index"]],
    [:Let, "byte_start", :U64, [:Field, "header", "byte_start"]],
    [:Let, "scalar_start", :U64, [:Field, "header", "scalar_start"]],
    [:Let, "end", :U64, [:Add, "byte_start", "length"]],
    [:Let, "target", :U64, [:Add, "scalar_start", "position"]],
    [:Let, "offset", :U64, "byte_start"],
    [:Let, "count", :U64, "scalar_start"],
    [:If, [:Equal, "index", "string_null_index"], [], [
      [:Let, "sample_number", :U64, [:Divide, "target", "string_stride"]],
      [:Let, "sample", [:Pointer, :U64, :Mutable], [:Offset, "index", "sample_number"]],
      [:Set, "offset", [:Load, "sample"]],
      [:Set, "count", [:Multiply, "sample_number", "string_stride"]]
    ]],
    [:Note, :Invariant, "Sample offsets are relative to the immutable backing, including for slices."],
    [:While, [:Less, "count", "target"], [
      [:Let, "source", [:Pointer, :U8, :Mutable], [:Offset, "data", "offset"]],
      [:Let, "text", [:Pointer, :U8, :Const], [:Freeze, "source"]],
      [:Let, "remaining", :U64, [:Subtract, "end", "offset"]],
      [:Let, "decoded", [:Record, "Utf8Decode"], [:Call, "utf8_decode", "text", "remaining"]],
      [:If, [:Field, "decoded", "ok"], [], [[:Return, [:Zero]]]],
      [:Let, "width", :U64, [:Field, "decoded", "width"]],
      [:Set, "offset", [:Add, "offset", "width"]],
      [:Set, "count", [:Add, "count", "one"]]
    ]],
    [:Set, "offset", [:Subtract, "offset", "byte_start"]],
    [:Set, "result", [:Record, "true", "offset"]],
    [:Return, "result"]
  ])
  name = "value_string_scalar_at"
  context = native_value/function(context, name, [:Record, "RuneResult"], [["value", word, :Borrow], ["position", :U64, :Value]],
    [], [:ReadMemory], :Value, "")
  context = native_value/body(context, name, [
    [:Let, "offset_result", result, [:Call, "value_string_byte_offset", "value", "position"]],
    [:If, [:Field, "offset_result", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "offset", :U64, [:Field, "offset_result", "number"]],
    [:Let, "pointer", header_pointer, [:UnpackPointer, "value"]],
    [:Let, "header", header, [:Load, "pointer"]],
    [:Let, "length", :U64, [:Field, "header", "length"]],
    [:Let, "data", [:Pointer, :U8, :Mutable], [:Field, "header", "data"]],
    [:Let, "source", [:Pointer, :U8, :Mutable], [:Offset, "data", "offset"]],
    [:Let, "text", [:Pointer, :U8, :Const], [:Freeze, "source"]],
    [:Set, "length", [:Subtract, "length", "offset"]],
    [:Let, "decoded", [:Record, "Utf8Decode"], [:Call, "utf8_decode", "text", "length"]],
    [:If, [:Field, "decoded", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "rune", [:Scalar, "Rune", :U32], [:Field, "decoded", "rune"]],
    [:Let, "result", [:Record, "RuneResult"], [:Record, "true", "rune"]],
    [:Return, "result"]
  ])
  context = native_value/string_slice(context)
  return context
end

verb native_value/string_slice(input: map) -> map
  let context: map = input
  let name: string = "value_string_slice"
  let word: list = native_value/word()
  let header: list = [:Record, "HeapString"]
  let result: list = [:Record, "ValueResult"]
  context = native_value/function(context, name, result, [
      ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow],
      ["value", word, [:Borrow, "arena"]],
      ["start", :U64, :Value],
      ["end", :U64, :Value]
    ],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native_value/body(context, name, [
    [:If, [:Less, "end", "start"], [[:Return, [:Zero]]], []],
    [:Let, "offset", [:Record, "IdResult"], [:Call, "value_string_byte_offset", "value", "start"]],
    [:Let, "condition", :Bool, [:Field, "offset", "ok"]],
    [:Let, "first", :U64, [:Field, "offset", "number"]],
    [:If, "condition", [], [[:Return, [:Zero]]]],
    [:Set, "offset", [:Call, "value_string_byte_offset", "value", "end"]],
    [:Set, "condition", [:Field, "offset", "ok"]],
    [:Let, "last", :U64, [:Field, "offset", "number"]],
    [:If, "condition", [], [[:Return, [:Zero]]]],
    [:Let, "size", :U64, [:SizeOf, header]],
    [:Let, "allocation", [:Pointer, :U8, :Mutable], [:Call, "value_arena_allocate", "arena", "size"]],
    [:If, [:Equal, "allocation", "null_bytes"], [[:Return, [:Zero]]], []],
    [:Note, :Invariant, "Slices retain their backing and sampled index; only the view header is allocated."],
    [:Let, "target", [:Pointer, header, :Mutable], [:PointerCast, "allocation"]],
    [:Let, "pointer", [:Pointer, header, :Const], [:UnpackPointer, "value"]],
    [:Let, "header", header, [:Load, "pointer"]],
    [:Let, "data", [:Pointer, :U8, :Mutable], [:Field, "header", "data"]],
    [:Set, "data", [:Offset, "data", "first"]],
    [:Let, "storage", [:Pointer, [:Record, "StringStorage"], :Mutable], [:Field, "header", "storage"]],
    [:Let, "byte_start", :U64, [:Field, "header", "byte_start"]],
    [:Set, "byte_start", [:Add, "byte_start", "first"]],
    [:Let, "scalar_start", :U64, [:Field, "header", "scalar_start"]],
    [:Set, "scalar_start", [:Add, "scalar_start", "start"]],
    [:Let, "length", :U64, [:Subtract, "last", "first"]],
    [:Let, "scalars", :U64, [:Subtract, "end", "start"]],
    [:Let, "ascii", :Bool, [:Equal, "length", "scalars"]],
    [:Let, "slice", header, [:Record, "data", "length", "scalars", "ascii", "storage", "byte_start", "scalar_start"]],
    [:Do, [:Store, "target", "slice"]],
    [:Let, "packed", word, [:PackPointer, "target", "tag_string"]],
    [:Let, "result", result, [:Record, "true", "packed"]],
    [:Return, "result"]
  ])
  return context
end
