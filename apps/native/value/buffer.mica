// Private, growing output storage. Publication happens only after a complete operation.
verb native_value/buffers(input: map) -> map
  let context: map = input
  let bytes: list = [:Pointer, :U8, :Mutable]
  let buffer: list = [:Record, "ValueBuffer"]
  let pointer: list = [:Pointer, buffer, :Mutable]
  context[:state] = native/record_type(context[:state], "ValueBuffer", [["data", bytes], ["length", :U64], ["capacity", :U64]])[1]
  let [constants, state] = native/constants(context[:state], [
    ["buffer_initial_capacity", :U64, "0000000000000040"], ["word_bytes", :U64, "0000000000000008"],
    ["null_buffer", pointer, "null"]])
  context[:state] = state
  let bindings: map = context[:constants]
  for name, id in constants
    bindings[name] = id
  end
  context[:constants] = bindings
  let worker: list = ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow]
  context = native/declare_function(context, "value_buffer", pointer, [worker], [], [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, "value_buffer", [
    native/let_call(
      "raw",
      bytes,
      "memory_allocate",
      ["worker", native/typed_expression(:U64, native/unary_expression(:SizeOf, buffer)), "layout_buffer"]
    ),
    native/when_statement(native/binary_expression(:Equal, "raw", "null_bytes"), [native/return_value("null_buffer")]),
    native/let_statement("buffer", pointer, native/unary_expression(:PointerCast, "raw")),
    native/store_statement("buffer", native/typed_zero(buffer)),
    native/return_value("buffer")
  ])
  context = native/declare_function(context, "buffer_append", :Bool, [worker, ["buffer", pointer, :Gc],
    ["source", [:Pointer, :U8, :Const], :Borrow], ["count", :U64, :Value]], [], [:Allocate, :ReadMemory, :WriteMemory], :Value, "")
  context = native/define_function(context, "buffer_append", [
    native/let_load("header", buffer, "buffer"),
    native/let_field("length", :U64, "header", "length"),
    native/when_statement(
      native/binary_expression(
        :Less,
        native/typed_expression(:U64, native/binary_expression(:Subtract, "allocation_limit", "length")),
        "count"
      ),
      [native/return_value("false")]
    ),
    native/let_statement("needed", :U64, native/binary_expression(:Add, "length", "count")),
    native/let_field("capacity", :U64, "header", "capacity"),
    native/let_field("data", bytes, "header", "data"),
    native/when_statement(native/binary_expression(:Less, "capacity", "needed"), [
      native/let_statement("grown", :U64, native/binary_expression(:Multiply, "capacity", "two")),
      native/when_statement(
        native/binary_expression(:Less, "grown", "buffer_initial_capacity"),
        [native/set_statement("grown", "buffer_initial_capacity")]
      ),
      native/when_statement(
        native/binary_expression(:Less, "allocation_limit", "grown"),
        [native/set_statement("grown", "allocation_limit")]
      ),
      native/when_statement(
        native/binary_expression(:Less, "grown", "needed"),
        [native/set_statement("grown", "needed")]
      ),
      native/let_call("allocation", bytes, "memory_allocate", ["worker", "grown", "layout_opaque"]),
      native/when_statement(
        native/binary_expression(:Equal, "allocation", "null_bytes"),
        [native/return_value("false")]
      ),
      native/copy_bytes_statement(
        "allocation",
        native/typed_expression([:Pointer, :U8, :Const], native/unary_expression(:Freeze, "data")),
        "length"
      ),
      native/set_statement("data", "allocation"),
      native/set_statement("capacity", "grown")
    ]),
    native/when_statement(native/binary_expression(:Less, "zero", "count"), [
      native/let_offset("tail", bytes, "data", "length"),
      native/copy_bytes_statement("tail", "source", "count")
    ]),
    native/store_statement("buffer", native/typed_record(buffer, ["data", "needed", "capacity"])),
    native/return_value("true")
  ])
  context = native/declare_function(context, "buffer_word", :Bool, [worker, ["buffer", pointer, :Gc],
    ["number", :U64, :Value]], [], [:Allocate, :ReadMemory, :WriteMemory], :Value, "")
  context = native/define_function(context, "buffer_word", [
    native/let_statement("storage", [:Array, :U8, 8], native/zero_expression()),
    native/let_statement("array", [:Pointer, [:Array, :U8, 8], :Mutable], native/unary_expression(:Address, "storage")),
    native/let_statement("remaining", :U64, "number"),
    native/let_statement("i", :U64, "zero"),
    native/while_statement(native/binary_expression(:Less, "i", "word_bytes"), [
      native/let_statement("slot", bytes, native/binary_expression(:ElementPointer, "array", "i")),
      native/store_statement("slot", native/typed_expression(:U8, native/unary_expression(:Convert, "remaining"))),
      native/set_statement("remaining", native/binary_expression(:ShiftRight, "remaining", "word_bytes")),
      native/set_statement("i", native/binary_expression(:Add, "i", "one"))
    ]),
    native/let_statement("first", bytes, native/binary_expression(:ElementPointer, "array", "zero")),
    native/return_value(
      native/call_expression(
        "buffer_append",
        [
          "worker",
          "buffer",
          native/typed_expression([:Pointer, :U8, :Const], native/unary_expression(:Freeze, "first")),
          "word_bytes"
        ]
      )
    )
  ])
  return context
end
