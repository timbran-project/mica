verb native_value/heap(input: map) -> map
  let context: map = input
  let word = native_value/word()
  let bytes = [:Pointer, :U8, :Mutable]
  let values = [:Pointer, word, :Mutable]
  let state = context[:state]
  state = native/record_type(state, "ValueMapEntry", [["key", word], ["value", word]])[1]
  state = native/record_type(state, "HeapMap", [["data", [:Pointer, [:Record, "ValueMapEntry"], :Mutable]], ["length", :U64]])[1]
  state = native/record_type(state, "ListStorage", [["data", values], ["used", :U64], ["capacity", :U64]])[1]
  for spec in [["HeapBytes", [["data", bytes], ["length", :U64]]],
               ["HeapList", [["data", values], ["length", :U64], ["storage", [:Pointer, [:Record, "ListStorage"], :Mutable]]]],
               ["HeapRange", [["start", word], ["has_end", :Bool], ["end", word]]],
               ["HeapFrob", [["delegate", :U64], ["value", word]]],
               ["HeapError", [["code", :U32], ["has_message", :Bool], ["message", word], ["has_value", :Bool], ["value", word]]]]
    state = native/record_type(state, spec[0], spec[1])[1]
  end
  context[:state] = state
  for spec in [["bytes", "HeapBytes", :U8], ["list", "HeapList", word]]
    if spec[0] == "bytes"
      context = native_value/bytes_constructor(context)
    end
    context = native_value/heap_accessor(context, spec[0], [:Record, spec[1]])
  end
  for spec in [["range", "HeapRange", [["start", word, [:Borrow, "arena"]], ["has_end", :Bool, :Value], ["end", word, [:Borrow, "arena"]]]],
               ["frob", "HeapFrob", [["delegate", :U64, :Value], ["value", word, [:Borrow, "arena"]]]],
               ["error", "HeapError", [["code", :U32, :Value], ["has_message", :Bool, :Value], ["message", word, [:Borrow, "arena"]], ["has_value", :Bool, :Value], ["value", word, [:Borrow, "arena"]]]]]
    context = native_value/record_constructor(context, spec)
    context = native_value/heap_accessor(context, spec[0], [:Record, spec[1]])
  end
  context = native_value/heap_accessor(context, "map", [:Record, "HeapMap"])
  return context
end

// The bytes header and copied bytes occupy one aligned arena allocation.
verb native_value/bytes_constructor(input: map) -> map
  let context: map = input
  let header: list = [:Record, "HeapBytes"]
  let bytes: list = [:Pointer, :U8, :Mutable]
  let source: list = [:Pointer, :U8, :Const]
  let [source_null: int, state: map] = native/add_constant(context[:state], source, "null")
  let constants: map = context[:constants]
  constants["value_bytes_null"] = source_null
  context[:constants] = constants
  context[:state] = state
  context = native/declare_function(context, "value_bytes", [:Record, "ValueResult"],
    [["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow], ["source", source, :Borrow], ["length", :U64, :Value]],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  let failure: list = [native/return_zero()]
  context = native/define_function(context, "value_bytes", [
    native/unless_statement(
      native/binary_expression(:Equal, "length", "zero"),
      [native/when_statement(native/binary_expression(:Equal, "source", "value_bytes_null"), failure)]
    ),
    native/let_statement("header_size", :U64, native/unary_expression(:SizeOf, header)),
    native/let_statement("limit", :U64, native/binary_expression(:Subtract, "allocation_limit", "header_size")),
    native/when_statement(native/binary_expression(:Less, "limit", "length"), failure),
    native/let_statement("total", :U64, native/binary_expression(:Add, "header_size", "length")),
    native/let_call("allocation", bytes, "value_arena_allocate", ["arena", "total"]),
    native/when_statement(native/binary_expression(:Equal, "allocation", "null_bytes"), failure),
    native/let_statement("pointer", [:Pointer, header, :Mutable], native/unary_expression(:PointerCast, "allocation")),
    native/let_offset("data", bytes, "allocation", "header_size"),
    native/copy_bytes_statement("data", "source", "length"),
    native/let_statement("header", header, native/record_expression(["data", "length"])),
    native/store_statement("pointer", "header"),
    native/return_record(
      [
        "true",
        native/typed_expression(native_value/word(), native/binary_expression(:PackPointer, "pointer", "tag_bytes"))
      ]
    )
  ])
  return context
end

verb native_value/record_constructor(input: map, spec: list) -> map
  let context: map = input
  let name: string = string_concat("value_", spec[0])
  let word: list = native_value/word()
  let header: list = [:Record, spec[1]]
  let result: list = [:Record, "ValueResult"]
  context = native/declare_function(context, name, result,
    [["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow], @spec[2]],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  let failure: list = [native/return_zero()]
  let statements: list = []
  if spec[0] == "frob"
    statements = [native/when_statement(native/binary_expression(:Less, "payload_mask", "delegate"), failure)]
  end
  if spec[0] == "error"
    statements = [
      native/when_statement(
        "has_message",
        [
          native/unless_statement(
            native/binary_expression(
              :Equal,
              native/typed_expression(:U8, native/unary_expression(:Tag, "message")),
              "tag_string"
            ),
            failure
          )
        ]
      )
    ]
  end
  context = native/define_function(context, name, [
    @statements,
    native/let_statement("size", :U64, native/unary_expression(:SizeOf, header)),
    native/let_call("allocation", [:Pointer, :U8, :Mutable], "value_arena_allocate", ["arena", "size"]),
    native/when_statement(native/binary_expression(:Equal, "allocation", "null_bytes"), failure),
    native/let_statement("pointer", [:Pointer, header, :Mutable], native/unary_expression(:PointerCast, "allocation")),
    native/let_statement("header", header, native/record_expression([@[field[0] for field in spec[2]]])),
    native/store_statement("pointer", "header"),
    native/return_record(
      [
        "true",
        native/typed_expression(word, native/binary_expression(:PackPointer, "pointer", string_concat("tag_", spec[0])))
      ]
    )
  ])
  return context
end

verb native_value/heap_accessor(input: map, kind: string, header: list) -> map
  let context: map = input
  let pointer: list = [:Pointer, header, :Const]
  let result_name: string = string_concat(header[1], "Result")
  let result: list = [:Record, result_name]
  context[:state] = native/record_type(context[:state], result_name, [["ok", :Bool], ["header", pointer]])[1]
  let name: string = string_concat("value_as_", kind)
  context = native/declare_function(context, name, result, [["value", native_value/word(), :Borrow]], [], [], :Borrow, "value")
  context = native/define_function(context, name, [
    native/unless_statement(
      native/binary_expression(
        :Equal,
        native/typed_expression(:U8, native/unary_expression(:Tag, "value")),
        string_concat("tag_", kind)
      ),
      [native/return_zero()]
    ),
    native/return_record(["true", native/typed_expression(pointer, native/unary_expression(:UnpackPointer, "value"))])
  ])
  return context
end
