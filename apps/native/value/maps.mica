verb native_value/map_order(builder: map, left: map, right: map) -> list
  let [comparison: map, current: map] = native_value/checked_result(builder, "value_compare", [
    native_gen/field(builder, left, "key"), native_gen/field(builder, right, "key")], fn(failed) => native_gen/return_zero(failed))
  return [native_gen/field(current, comparison, "number"), current]
end

verb native_value/maps(input: map) -> map
  let context: map = input
  let entry: list = [:Record, "ValueMapEntry"]
  let header: list = [:Record, "HeapMap"]
  let source_type: list = [:Pointer, entry, :Const]
  let [null, state] = native/add_constant(context[:state], source_type, "null")
  context[:state] = state
  let constants: map = context[:constants]
  constants["null_map_entries"] = null
  context[:constants] = constants
  context = native/declare_function(context, "value_map", [:Record, "ValueResult"], [
    ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow],
    ["source", source_type, :Gc], ["length", :U64, :Value]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  let builder: map = native_gen/context(context, "value_map")
  let worker: map = native_gen/ref(builder, "worker")
  let source: map = native_gen/ref(builder, "source")
  let length: map = native_gen/ref(builder, "length")
  let failure = fn(failed) => native_gen/return_zero(failed)
  builder = native_gen/unless(builder, native_gen/equal(length, native_gen/zero(:U64)), fn(nonempty)
    return native_gen/when(nonempty, native_gen/equal(source, native_gen/ref(nonempty, "null_map_entries")), failure)
  end)
  let [object: map, data: map, with_object: map] = native_memory/tail_storage(builder, worker, header, entry, length, "layout_map", failure)
  builder = with_object
  builder = native_sequence/copy(builder, native_sequence/span(data, length), native_sequence/span(source, length))
  let [sorted: map, with_sorted: map] = native_gen/bind(builder, "sorted", data)
  builder = with_sorted
  let [count: map, with_count: map] = native_gen/bind(builder, "count", length)
  builder = with_count
  builder = native_gen/when(builder, native_gen/less(native_gen/ref(builder, "one"), length), fn(input_sort)
    let sort: map = input_sort
    let [scratch: map, with_scratch: map] = native_memory/array_storage(sort, worker, entry, length, "layout_opaque", failure)
    sort = with_scratch
    let ordered = fn(body, left, right)
      let [order: map, compared: map] = native_value/map_order(body, left, right)
      return [native_gen/negate(native_gen/less(native_gen/zero(:I64), order)), compared]
    end
    let [result: map, with_result: map] = native_sequence/stable_merge(sort, native_sequence/span(data, length), scratch, ordered)
    sort = with_result
    sort = native_gen/assign(sort, sorted, result)
    // Stable sorting keeps duplicate keys in source order; replacing the
    // preceding entry makes the final input value win.
    let [written: map, with_written: map] = native_sequence/compact_sorted(sort, native_sequence/span(sorted, length),
      fn(body, left, right) => native_value/map_order(body, left, right),
      fn(replace, preceding, entry) => native_gen/write(replace, preceding, entry))
    sort = with_written
    return native_gen/assign(sort, count, written)
  end)
  builder = native_gen/store(builder, object, native_gen/record(builder, header, {"data" -> sorted, "length" -> count}))
  builder = native_gen/return_value(builder, native_value/packed_result(builder, object, "map"))
  context = native_gen/finish(context, builder)
  context = native_value/map_lookup(context)
  return context
end

verb native_value/map_key_search_order(builder: map, candidate: map, key: map) -> list
  let [comparison: map, current: map] = native_value/checked_result(builder, "value_compare",
    [native_gen/field(builder, candidate, "key"), key], fn(failed) => native_gen/return_zero(failed))
  let order: map = native_gen/field(current, comparison, "number")
  return [native_gen/equal(order, native_gen/ref(current, "int_zero")),
    native_gen/less(order, native_gen/ref(current, "int_zero")), current]
end

verb native_value/map_search(builder: map, header: map, key: map) -> list
  let span: map = native_sequence/span(native_gen/field(builder, header, "data"), native_gen/field(builder, header, "length"))
  let result: list = native_sequence/search(builder, span,
    fn(body, candidate) => native_value/map_key_search_order(body, candidate, key))
  return result
end

verb native_value/map_lookup(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let result: list = [:Record, "ValueResult"]
  let [two, state] = native/add_constant(context[:state], :U64, "0000000000000002")
  context[:state] = state
  let constants: map = context[:constants]
  constants["two"] = two
  context[:constants] = constants
  context = native/declare_function(context, "value_map_get", result, [["map", word, :Gc], ["key", word, :Gc]], [], [:ReadMemory], :Gc, "")
  let builder: map = native_gen/context(context, "value_map_get")
  let [header: map, with_header: map] = native_value/open_value(builder, native_gen/ref(builder, "map"), "map", "HeapMap", fn(failed) => native_gen/return_zero(failed))
  builder = with_header
  let data: map = native_gen/field(builder, header, "data")
  let length: map = native_gen/field(builder, header, "length")
  let key: map = native_gen/ref(builder, "key")
  builder = native_sequence/search_return(builder, native_sequence/span(data, length),
    fn(body, candidate) => native_value/map_key_search_order(body, candidate, key), fn(found, index, entry)
    return native_gen/return_value(found, native_gen/record(found, result,
      {"ok" -> native_gen/ref(found, "true"), "value" -> native_gen/field(found, entry, "value")}))
  end)
  builder = native_gen/return_zero(builder)
  context = native_gen/finish(context, builder)
  return context
end
