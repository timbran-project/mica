// Bottom-up stable merge sort followed by compaction. Equal keys retain the
// last input value. Both buffers belong to the worker; the input is never changed.
verb native_value/maps(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let entry: list = [:Record, "ValueMapEntry"]
  let entries: list = [:Pointer, entry, :Mutable]
  let header: list = [:Record, "HeapMap"]
  let result: list = [:Record, "ValueResult"]
  let name: string = "value_map"
  let [null, ns] = native/add_constant(context[:state], [:Pointer, entry, :Const], "null")
  context[:state] = ns
  let constants: map = context[:constants]
  constants["null_map_entries"] = null
  context[:constants] = constants
  context = native/declare_function(context, name, result, [
      ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow],
      ["source", [:Pointer, entry, :Const], :Gc],
      ["length", :U64, :Value]
    ],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, name, [
    native/unless_statement(
      native/binary_expression(:Equal, "length", "zero"),
      [native/when_statement(native/binary_expression(:Equal, "source", "null_map_entries"), [native/return_zero()])]
    ),
    native/let_statement("header_size", :U64, native/unary_expression(:SizeOf, header)),
    native/let_statement("size", :U64, native/unary_expression(:SizeOf, entry)),
    @native_memory/allocate_with_tail("allocation", "header_size", "size", "length", "layout_map", [native/return_zero()]),
    native/let_statement("pointer", [:Pointer, header, :Mutable], native/unary_expression(:PointerCast, "allocation")),
    native/let_offset("raw_data", [:Pointer, :U8, :Mutable], "allocation", "header_size"),
    native/let_statement("src", entries, native/unary_expression(:PointerCast, "raw_data")),
    native/let_statement("read", :U64, "zero"),
    native/let_statement("write", :U64, "length"),
    native/while_statement(native/binary_expression(:Less, "read", "length"), [
      native/let_offset("input_slot", [:Pointer, entry, :Const], "source", "read"),
      native/let_load("right_entry", entry, "input_slot"),
      native/let_offset("out_slot", entries, "src", "read"),
      native/store_statement("out_slot", "right_entry"),
      native/set_statement("read", native/binary_expression(:Add, "read", "one"))
    ]),
    native/when_statement(native/binary_expression(:Less, "one", "length"), [
      native/set_statement("size", native/unary_expression(:SizeOf, entry)),
      native/set_statement("bytes", native/binary_expression(:Multiply, "length", "size")),
      native/set_statement("allocation", native/call_expression("memory_allocate", ["worker", "bytes", "layout_opaque"])),
      native/when_statement(native/binary_expression(:Equal, "allocation", "null_bytes"), [native/return_zero()]),
      native/let_statement("dst", entries, native/unary_expression(:PointerCast, "allocation")),
      native/let_statement("width", :U64, "one"),
      native/note_statement(
        :Invariant,
        "Choose the left run on equality to preserve input order before keeping the last duplicate."
      ),
      native/while_statement(native/binary_expression(:Less, "width", "length"), [
        native/let_statement("base", :U64, "zero"),
        native/while_statement(native/binary_expression(:Less, "base", "length"), [
          native/let_statement("middle", :U64, native/binary_expression(:Add, "base", "width")),
          native/when_statement(
            native/binary_expression(:Less, "length", "middle"),
            [native/set_statement("middle", "length")]
          ),
          native/let_statement("end", :U64, native/binary_expression(:Add, "middle", "width")),
          native/when_statement(
            native/binary_expression(:Less, "length", "end"),
            [native/set_statement("end", "length")]
          ),
          native/let_statement("left", :U64, "base"),
          native/let_statement("right", :U64, "middle"),
          @native/for_range("out", "base", "end", [
            native/let_statement("take_left", :Bool, "true"),
            native/when_statement(
              native/binary_expression(:Less, "right", "end"),
              [
                native/if_statement(native/binary_expression(:Less, "left", "middle"), [
                  native/let_offset("left_slot", entries, "src", "left"),
                  native/let_load("left_entry", entry, "left_slot"),
                  native/let_offset("right_slot", entries, "src", "right"),
                  native/set_statement("right_entry", native/load_expression("right_slot")),
                  native/let_field("left_key", word, "left_entry", "key"),
                  native/let_field("right_key", word, "right_entry", "key"),
                  @native/try_call("comparison", [:Record, "IntResult"], "value_compare", ["left_key", "right_key"], [native/return_zero()]),
                  native/let_field("order", :I64, "comparison", "number"),
                  native/when_statement(
                    native/binary_expression(:Less, "int_zero", "order"),
                    [native/set_statement("take_left", "false")]
                  )
                ], [native/set_statement("take_left", "false")])
              ]
            ),
            native/if_statement("take_left", [
              native/set_statement("left_slot", native/offset_expression("src", "left")),
              native/set_statement("left_entry", native/load_expression("left_slot")),
              native/set_statement("out_slot", native/offset_expression("dst", "out")),
              native/store_statement("out_slot", "left_entry"),
              native/set_statement("left", native/binary_expression(:Add, "left", "one"))
            ], [
              native/set_statement("right_slot", native/offset_expression("src", "right")),
              native/set_statement("right_entry", native/load_expression("right_slot")),
              native/set_statement("out_slot", native/offset_expression("dst", "out")),
              native/store_statement("out_slot", "right_entry"),
              native/set_statement("right", native/binary_expression(:Add, "right", "one"))
            ])]),
          native/set_statement("base", "end")
        ]),
        native/let_statement("swap", entries, "src"),
        native/set_statement("src", "dst"),
        native/set_statement("dst", "swap"),
        native/set_statement("width", native/binary_expression(:Add, "width", "width"))
      ]),
      native/set_statement("read", "zero"),
      native/set_statement("write", "zero"),
      native/while_statement(native/binary_expression(:Less, "read", "length"), [
        native/set_statement("right_slot", native/offset_expression("src", "read")),
        native/set_statement("right_entry", native/load_expression("right_slot")),
        native/if_statement(native/binary_expression(:Equal, "write", "zero"), [
          native/set_statement("out_slot", native/offset_expression("src", "write")),
          native/store_statement("out_slot", "right_entry"),
          native/set_statement("write", native/binary_expression(:Add, "write", "one"))
        ], [
          native/let_statement("previous", :U64, native/binary_expression(:Subtract, "write", "one")),
          native/set_statement("left_slot", native/offset_expression("src", "previous")),
          native/set_statement("left_entry", native/load_expression("left_slot")),
          native/set_statement("left_key", native/field_expression("left_entry", "key")),
          native/set_statement("right_key", native/field_expression("right_entry", "key")),
          native/set_statement("comparison", native/call_expression("value_compare", ["left_key", "right_key"])),
          native/unless_statement(native/field_expression("comparison", "ok"), [native/return_zero()]),
          native/set_statement("order", native/field_expression("comparison", "number")),
          native/if_statement(native/binary_expression(:Equal, "order", "int_zero"), [
            native/store_statement("left_slot", "right_entry")
          ], [
            native/set_statement("out_slot", native/offset_expression("src", "write")),
            native/store_statement("out_slot", "right_entry"),
            native/set_statement("write", native/binary_expression(:Add, "write", "one"))
          ])
        ]),
        native/set_statement("read", native/binary_expression(:Add, "read", "one"))
      ])
    ]),
    native/let_statement("header", header, native/record_expression(["src", "write"])),
    native/store_statement("pointer", "header"),
    native/let_statement("value", word, native/binary_expression(:PackPointer, "pointer", "tag_map")),
    native/let_statement("result", result, native/record_expression(["true", "value"])),
    native/return_value("result")
  ])
  context = native_value/map_lookup(context)
  return context
end

verb native_value/map_lookup(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let entry: list = [:Record, "ValueMapEntry"]
  let result: list = [:Record, "ValueResult"]
  let name: string = "value_map_get"
  let [two, s] = native/add_constant(context[:state], :U64, "0000000000000002")
  context[:state] = s
  let constants: map = context[:constants]
  constants["two"] = two
  context[:constants] = constants
  context = native/declare_function(context, name, result, [["map", word, :Gc], ["key", word, :Gc]],
    [], [:ReadMemory], :Gc, "")
  context = native/define_function(context, name, [
    native/let_statement("tag", :U8, native/unary_expression(:Tag, "map")),
    native/unless_statement(native/binary_expression(:Equal, "tag", "tag_map"), [native/return_zero()]),
    native/let_statement(
      "pointer",
      [:Pointer, [:Record, "HeapMap"], :Const],
      native/unary_expression(:UnpackPointer, "map")
    ),
    native/let_load("header", [:Record, "HeapMap"], "pointer"),
    native/let_field("data", [:Pointer, entry, :Mutable], "header", "data"),
    native/let_field("high", :U64, "header", "length"),
    native/let_statement("low", :U64, "zero"),
    native/while_statement(native/binary_expression(:Less, "low", "high"), [
      native/let_statement("distance", :U64, native/binary_expression(:Subtract, "high", "low")),
      native/set_statement("distance", native/binary_expression(:Divide, "distance", "two")),
      native/let_statement("middle", :U64, native/binary_expression(:Add, "low", "distance")),
      native/let_offset("slot", [:Pointer, entry, :Mutable], "data", "middle"),
      native/let_load("entry", entry, "slot"),
      native/let_field("candidate", word, "entry", "key"),
      @native/try_call("comparison", [:Record, "IntResult"], "value_compare", ["candidate", "key"], [native/return_zero()]),
      native/let_field("order", :I64, "comparison", "number"),
      native/when_statement(native/binary_expression(:Equal, "order", "int_zero"), [
        native/let_field("value", word, "entry", "value"),
        native/let_statement("result", result, native/record_expression(["true", "value"])),
        native/return_value("result")
      ]),
      native/if_statement(
        native/binary_expression(:Less, "order", "int_zero"),
        [native/set_statement("low", native/binary_expression(:Add, "middle", "one"))],
        [native/set_statement("high", "middle")]
      )
    ]),
    native/return_zero()
  ])
  return context
end
