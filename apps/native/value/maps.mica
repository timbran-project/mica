// Bottom-up stable merge sort followed by compaction. Equal keys retain the
// last input value. Both buffers belong to the arena; the input is never changed.
verb native_value/maps(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let entry: list = [:Record, "ValueMapEntry"]
  let entries: list = [:Pointer, entry, :Mutable]
  let header: list = [:Record, "HeapMap"]
  let result: list = [:Record, "ValueResult"]
  let name: string = "value_map"
  let [null, ns] = native/add_constant(context[:state], [:Pointer, entry, :Const], "null")
  context[:state] = ns
  let constants: map = context[:constants]
  constants["null_map_entries"] = null
  context[:constants] = constants
  context = native/declare_function(context, name, result, [
      ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow],
      ["source", [:Pointer, entry, :Const], [:Borrow, "arena"]],
      ["length", :U64, :Value]
    ],
    [], [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native/define_function(context, name, [
    [:If, [:Equal, "length", "zero"], [], [[:If, [:Equal, "source", "null_map_entries"], [[:Return, [:Zero]]], []]]],
    [:Let, "header_size", :U64, [:SizeOf, header]],
    [:Let, "size", :U64, [:SizeOf, entry]],
    [:Let, "limit", :U64, [:Subtract, "allocation_limit", "header_size"]],
    [:Set, "limit", [:Divide, "limit", "size"]],
    [:If, [:Less, "limit", "length"], [[:Return, [:Zero]]], []],
    [:Let, "bytes", :U64, [:Multiply, "length", "size"]],
    [:Let, "total", :U64, [:Add, "header_size", "bytes"]],
    [:Let, "allocation", [:Pointer, :U8, :Mutable], [:Call, "value_arena_allocate", "arena", "total"]],
    [:If, [:Equal, "allocation", "null_bytes"], [[:Return, [:Zero]]], []],
    [:Let, "pointer", [:Pointer, header, :Mutable], [:PointerCast, "allocation"]],
    [:Let, "raw_data", [:Pointer, :U8, :Mutable], [:Offset, "allocation", "header_size"]],
    [:Let, "src", entries, [:PointerCast, "raw_data"]],
    [:Let, "read", :U64, "zero"],
    [:Let, "write", :U64, "length"],
    [:While, [:Less, "read", "length"], [
      [:Let, "input_slot", [:Pointer, entry, :Const], [:Offset, "source", "read"]],
      [:Let, "right_entry", entry, [:Load, "input_slot"]],
      [:Let, "out_slot", entries, [:Offset, "src", "read"]],
      [:Do, [:Store, "out_slot", "right_entry"]],
      [:Set, "read", [:Add, "read", "one"]]
    ]],
    [:If, [:Less, "one", "length"], [
      [:Set, "size", [:SizeOf, entry]],
      [:Set, "bytes", [:Multiply, "length", "size"]],
      [:Set, "allocation", [:Call, "value_arena_allocate", "arena", "bytes"]],
      [:If, [:Equal, "allocation", "null_bytes"], [[:Return, [:Zero]]], []],
      [:Let, "dst", entries, [:PointerCast, "allocation"]],
      [:Let, "width", :U64, "one"],
      [:Note, :Invariant, "Choose the left run on equality to preserve input order before keeping the last duplicate."],
      [:While, [:Less, "width", "length"], [
        [:Let, "base", :U64, "zero"],
        [:While, [:Less, "base", "length"], [
          [:Let, "middle", :U64, [:Add, "base", "width"]],
          [:If, [:Less, "length", "middle"], [[:Set, "middle", "length"]], []],
          [:Let, "end", :U64, [:Add, "middle", "width"]],
          [:If, [:Less, "length", "end"], [[:Set, "end", "length"]], []],
          [:Let, "left", :U64, "base"],
          [:Let, "right", :U64, "middle"],
          [:Let, "out", :U64, "base"],
          [:While, [:Less, "out", "end"], [
            [:Let, "take_left", :Bool, "true"],
            [:If, [:Less, "right", "end"], [
              [:If, [:Less, "left", "middle"], [
                [:Let, "left_slot", entries, [:Offset, "src", "left"]],
                [:Let, "left_entry", entry, [:Load, "left_slot"]],
                [:Let, "right_slot", entries, [:Offset, "src", "right"]],
                [:Set, "right_entry", [:Load, "right_slot"]],
                [:Let, "left_key", word, [:Field, "left_entry", "key"]],
                [:Let, "right_key", word, [:Field, "right_entry", "key"]],
                [:Let, "comparison", [:Record, "IntResult"], [:Call, "value_compare", "left_key", "right_key"]],
                [:If, [:Field, "comparison", "ok"], [], [[:Return, [:Zero]]]],
                [:Let, "order", :I64, [:Field, "comparison", "number"]],
                [:If, [:Less, "int_zero", "order"], [[:Set, "take_left", "false"]], []]
              ], [[:Set, "take_left", "false"]]]
            ], []],
            [:If, "take_left", [
              [:Set, "left_slot", [:Offset, "src", "left"]],
              [:Set, "left_entry", [:Load, "left_slot"]],
              [:Set, "out_slot", [:Offset, "dst", "out"]],
              [:Do, [:Store, "out_slot", "left_entry"]],
              [:Set, "left", [:Add, "left", "one"]]
            ], [
              [:Set, "right_slot", [:Offset, "src", "right"]],
              [:Set, "right_entry", [:Load, "right_slot"]],
              [:Set, "out_slot", [:Offset, "dst", "out"]],
              [:Do, [:Store, "out_slot", "right_entry"]],
              [:Set, "right", [:Add, "right", "one"]]
            ]],
            [:Set, "out", [:Add, "out", "one"]]
          ]],
          [:Set, "base", "end"]
        ]],
        [:Let, "swap", entries, "src"],
        [:Set, "src", "dst"],
        [:Set, "dst", "swap"],
        [:Set, "width", [:Add, "width", "width"]]
      ]],
      [:Set, "read", "zero"],
      [:Set, "write", "zero"],
      [:While, [:Less, "read", "length"], [
        [:Set, "right_slot", [:Offset, "src", "read"]],
        [:Set, "right_entry", [:Load, "right_slot"]],
        [:If, [:Equal, "write", "zero"], [
          [:Set, "out_slot", [:Offset, "src", "write"]],
          [:Do, [:Store, "out_slot", "right_entry"]],
          [:Set, "write", [:Add, "write", "one"]]
        ], [
          [:Let, "previous", :U64, [:Subtract, "write", "one"]],
          [:Set, "left_slot", [:Offset, "src", "previous"]],
          [:Set, "left_entry", [:Load, "left_slot"]],
          [:Set, "left_key", [:Field, "left_entry", "key"]],
          [:Set, "right_key", [:Field, "right_entry", "key"]],
          [:Set, "comparison", [:Call, "value_compare", "left_key", "right_key"]],
          [:If, [:Field, "comparison", "ok"], [], [[:Return, [:Zero]]]],
          [:Set, "order", [:Field, "comparison", "number"]],
          [:If, [:Equal, "order", "int_zero"], [[:Do, [:Store, "left_slot", "right_entry"]]], [
            [:Set, "out_slot", [:Offset, "src", "write"]],
            [:Do, [:Store, "out_slot", "right_entry"]],
            [:Set, "write", [:Add, "write", "one"]]
          ]]
        ]],
        [:Set, "read", [:Add, "read", "one"]]
      ]]
    ], []],
    [:Let, "header", header, [:Record, "src", "write"]],
    [:Do, [:Store, "pointer", "header"]],
    [:Let, "value", word, [:PackPointer, "pointer", "tag_map"]],
    [:Let, "result", result, [:Record, "true", "value"]],
    [:Return, "result"]
  ])
  context = native_value/map_lookup(context)
  return context
end

verb native_value/map_lookup(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let entry: list = [:Record, "ValueMapEntry"]
  let result: list = [:Record, "ValueResult"]
  let name: string = "value_map_get"
  let [two, s] = native/add_constant(context[:state], :U64, "0000000000000002")
  context[:state] = s
  let constants: map = context[:constants]
  constants["two"] = two
  context[:constants] = constants
  context = native/declare_function(context, name, result, [["map", word, :Borrow], ["key", word, :Borrow]],
    [], [:ReadMemory], :Borrow, "map")
  context = native/define_function(context, name, [
    [:Let, "tag", :U8, [:Tag, "map"]],
    [:If, [:Equal, "tag", "tag_map"], [], [[:Return, [:Zero]]]],
    [:Let, "pointer", [:Pointer, [:Record, "HeapMap"], :Const], [:UnpackPointer, "map"]],
    [:Let, "header", [:Record, "HeapMap"], [:Load, "pointer"]],
    [:Let, "data", [:Pointer, entry, :Mutable], [:Field, "header", "data"]],
    [:Let, "high", :U64, [:Field, "header", "length"]],
    [:Let, "low", :U64, "zero"],
    [:While, [:Less, "low", "high"], [
      [:Let, "distance", :U64, [:Subtract, "high", "low"]],
      [:Set, "distance", [:Divide, "distance", "two"]],
      [:Let, "middle", :U64, [:Add, "low", "distance"]],
      [:Let, "slot", [:Pointer, entry, :Mutable], [:Offset, "data", "middle"]],
      [:Let, "entry", entry, [:Load, "slot"]],
      [:Let, "candidate", word, [:Field, "entry", "key"]],
      [:Let, "comparison", [:Record, "IntResult"], [:Call, "value_compare", "candidate", "key"]],
      [:If, [:Field, "comparison", "ok"], [], [[:Return, [:Zero]]]],
      [:Let, "order", :I64, [:Field, "comparison", "number"]],
      [:If, [:Equal, "order", "int_zero"], [
        [:Let, "value", word, [:Field, "entry", "value"]],
        [:Let, "result", result, [:Record, "true", "value"]],
        [:Return, "result"]
      ], []],
      [:If, [:Less, "order", "int_zero"], [[:Set, "low", [:Add, "middle", "one"]]], [[:Set, "high", "middle"]]]
    ]],
    [:Return, [:Zero]]
  ])
  return context
end
