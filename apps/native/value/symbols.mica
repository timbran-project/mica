// Table-local IDs index entries; open-addressed buckets contain ID + 1.
// The storage owns names and geometric table allocations until table release.
verb native_value/symbols(input: map) -> map
  let context: map = input
  let entry: list = [:Record, "SymbolEntry"]
  let bytes: list = [:Pointer, :U8, :Const]
  let state: map = context[:state]
  state = native/record_type(state, "SymbolEntry", [["data", bytes], ["length", :U64],
    ["scalars", :U64], ["hash", :U64], ["ascii", :Bool]])[1]
  state = native/record_type(state, "SymbolTable", [["mutex", [:Pointer, :U8, :Mutable]], ["storage", [:Record, "SymbolStorage"]],
    ["entries", [:Pointer, entry, :Mutable]], ["buckets", [:Pointer, :U64, :Mutable]],
    ["count", :U64], ["capacity", :U64]])[1]
  state = native/record_type(state, "SymbolText", [["ok", :Bool], ["data", bytes],
    ["length", :U64], ["scalars", :U64], ["ascii", :Bool]])[1]
  let [constants: map, next: map] = native/constants(state, [
    ["symbol_initial_capacity", :U64, "0000000000000010"],
    ["symbol_id_limit", :U64, "0000000100000000"],
    ["symbol_two", :U64, "0000000000000002"],
    ["symbol_hash_basis", :U64, "cbf29ce484222325"],
    ["symbol_hash_prime", :U64, "00000100000001b3"]])
  let all: map = context[:constants]
  for name, id in constants
    all[name] = id
  end
  context[:constants] = all
  context[:state] = next
  context = native_value/symbol_synchronization(context)
  context = native_value/symbol_lookup(context)
  context = native_value/symbol_grow(context)
  context = native_value/symbol_intern(context)
  context = native_value/symbol_access(context)
  context = native_value/symbol_synchronized_access(context)
  return context
end

// Probe generation keeps collision advancement and wraparound identical for
// lookup and rehash. The empty arm must exit the generated loop.
verb native_value/probe_symbol_buckets(buckets: string, slot: string, mask: string,
    occupied: string, empty: list, present: list) -> list
  let bucket: list = native/typed_expression([:Pointer, :U64, :Mutable], native/offset_expression(buckets, slot))
  let result: list = native/while_statement("true", [
    native/let_load(occupied, :U64, bucket),
    native/when_statement(native/binary_expression(:Equal, occupied, "zero"), empty),
    @present,
    native/set_statement(slot, native/binary_expression(:BitAnd,
      native/typed_expression(:U64, native/binary_expression(:Add, slot, "one")), mask))])
  return result
end

verb native_value/symbol_lookup(input: map) -> map
  let context: map = input
  let bytes: list = [:Pointer, :U8, :Const]
  let table: list = [:Record, "SymbolTable"]
  let entry: list = [:Record, "SymbolEntry"]
  context = native/declare_function(context, "symbol_hash", :U64,
    [["source", bytes, :Borrow], ["length", :U64, :Value]], [], [:ReadMemory], :Value, "")
  context = native/define_function(context, "symbol_hash", [
    native/let_statement("hash", :U64, "symbol_hash_basis"),
    @native/for_range("position", "zero", "length", [
      native/let_load("byte", :U8, native/typed_expression(bytes, native/offset_expression("source", "position"))),
      native/set_statement(
        "hash",
        native/binary_expression(
          :BitXor,
          "hash",
          native/typed_expression(:U64, native/unary_expression(:Convert, "byte"))
        )
      ),
      native/set_statement("hash", native/binary_expression(:Multiply, "hash", "symbol_hash_prime"))]),
    native/return_value("hash")
  ])
  context = native/declare_function(context, "symbol_slot", :U64,
    [["table", [:Pointer, table, :Mutable], :Borrow], ["source", bytes, :Borrow],
     ["length", :U64, :Value], ["hash", :U64, :Value]], [], [:ReadMemory], :Value, "")
  context = native/define_function(context, "symbol_slot", [
    native/note_statement(:Invariant, "Capacity is nonzero; at least half the buckets are empty."),
    native/let_load("header", table, "table"),
    native/let_field("entries", [:Pointer, entry, :Mutable], "header", "entries"),
    native/let_field("buckets", [:Pointer, :U64, :Mutable], "header", "buckets"),
    native/let_statement(
      "mask",
      :U64,
      native/binary_expression(:Multiply, native/typed_field(:U64, "header", "capacity"), "symbol_two")
    ),
    native/set_statement("mask", native/binary_expression(:Subtract, "mask", "one")),
    native/let_statement("slot", :U64, native/binary_expression(:BitAnd, "hash", "mask")),
    native_value/probe_symbol_buckets("buckets", "slot", "mask", "id", [native/return_value("slot")], [
      native/let_load(
        "candidate",
        entry,
        native/typed_expression(
          [:Pointer, entry, :Mutable],
          native/offset_expression(
            "entries",
            native/typed_expression(:U64, native/binary_expression(:Subtract, "id", "one"))
          )
        )
      ),
      native/when_statement(
        native/binary_expression(:Equal, "hash", native/typed_field(:U64, "candidate", "hash")),
        [
          native/when_statement(native/binary_expression(
            :Equal,
            "length",
            native/typed_field(:U64, "candidate", "length")
          ), [
            native/let_field("data", bytes, "candidate", "data"),
            @native/for_range("position", "zero", "length", [
              native/let_load(
                "left_byte",
                :U8,
                native/typed_expression(bytes, native/offset_expression("source", "position"))
              ),
              native/let_load(
                "right_byte",
                :U8,
                native/typed_expression(bytes, native/offset_expression("data", "position"))
              ),
              native/unless_statement(
                native/binary_expression(:Equal, "left_byte", "right_byte"),
                [native/break_statement()]
              )]),
            native/when_statement(native/binary_expression(:Equal, "position", "length"), [native/return_value("slot")])
          ])
        ]
      )
    ]),
    native/return_value("zero")
  ])
  return context
end

verb native_value/symbol_grow(input: map) -> map
  let context: map = input
  let table: list = [:Record, "SymbolTable"]
  let entry: list = [:Record, "SymbolEntry"]
  let entries: list = [:Pointer, entry, :Mutable]
  let buckets: list = [:Pointer, :U64, :Mutable]
  let bytes: list = [:Pointer, :U8, :Mutable]
  context = native/declare_function(context, "symbol_grow", :Bool,
    [["table", [:Pointer, table, :Mutable], :Borrow]], [], [:ReadMemory, :WriteMemory, :Allocate], :Value, "")
  context = native/define_function(context, "symbol_grow", [
    native/let_load("header", table, "table"),
    native/let_field("capacity", :U64, "header", "capacity"),
    native/unless_statement(
      native/binary_expression(:Less, "capacity", "symbol_id_limit"),
      [native/return_value("false")]
    ),
    native/set_statement("capacity", native/binary_expression(:Multiply, "capacity", "symbol_two")),
    native/when_statement(
      native/binary_expression(:Equal, "capacity", "zero"),
      [native/set_statement("capacity", "symbol_initial_capacity")]
    ),
    native/let_field("count", :U64, "header", "count"),
    native/let_statement("entry_size", :U64, native/unary_expression(:SizeOf, entry)),
    native/let_statement("entry_bytes", :U64, native/binary_expression(:Multiply, "capacity", "entry_size")),
    native/let_statement("bucket_count", :U64, native/binary_expression(:Multiply, "capacity", "symbol_two")),
    native/let_statement(
      "bucket_bytes",
      :U64,
      native/binary_expression(
        :Multiply,
        "bucket_count",
        native/typed_expression(:U64, native/unary_expression(:SizeOf, :U64))
      )
    ),
    native/let_statement(
      "storage",
      [:Pointer, [:Record, "SymbolStorage"], :Mutable],
      native/field_pointer_expression("table", "storage")
    ),
    native/let_call(
      "allocation",
      bytes,
      "symbol_storage_allocate",
      ["storage", native/typed_expression(:U64, native/binary_expression(:Add, "entry_bytes", "bucket_bytes"))]
    ),
    native/when_statement(native/binary_expression(:Equal, "allocation", "null_bytes"), [native/return_value("false")]),
    native/let_statement("new_entries", entries, native/unary_expression(:PointerCast, "allocation")),
    native/let_statement(
      "new_buckets",
      buckets,
      native/unary_expression(
        :PointerCast,
        native/typed_expression(bytes, native/offset_expression("allocation", "entry_bytes"))
      )
    ),
    @native/for_range("position", "zero", "bucket_count", [
      native/store_statement(
        native/typed_expression(buckets, native/offset_expression("new_buckets", "position")),
        "zero"
      )]),
    native/unless_statement(native/binary_expression(:Equal, "count", "zero"), [
      native/let_field("previous", entries, "header", "entries"),
      native/copy_bytes_statement(
        "allocation",
        native/typed_expression(bytes, native/unary_expression(:PointerCast, "previous")),
        native/typed_expression(:U64, native/binary_expression(:Multiply, "count", "entry_size"))
      )
    ]),
    native/let_statement("mask", :U64, native/binary_expression(:Subtract, "bucket_count", "one")),
    native/set_statement("position", "zero"),
    native/while_statement(native/binary_expression(:Less, "position", "count"), [
      native/let_load(
        "item",
        entry,
        native/typed_expression(entries, native/offset_expression("new_entries", "position"))
      ),
      native/let_statement(
        "slot",
        :U64,
        native/binary_expression(:BitAnd, native/typed_field(:U64, "item", "hash"), "mask")
      ),
      native_value/probe_symbol_buckets("new_buckets", "slot", "mask", "occupied", [native/break_statement()], []),
      native/store_statement(
        native/typed_expression(buckets, native/offset_expression("new_buckets", "slot")),
        native/typed_expression(:U64, native/binary_expression(:Add, "position", "one"))
      ),
      native/set_statement("position", native/binary_expression(:Add, "position", "one"))
    ]),
    native/note_statement(:Purpose, "Publish rebuilt tables only after allocation and rehashing succeed."),
    native/store_statement(
      native/typed_expression([:Pointer, entries, :Mutable], native/field_pointer_expression("table", "entries")),
      "new_entries"
    ),
    native/store_statement(
      native/typed_expression([:Pointer, buckets, :Mutable], native/field_pointer_expression("table", "buckets")),
      "new_buckets"
    ),
    native/store_statement(
      native/typed_expression(buckets, native/field_pointer_expression("table", "capacity")),
      "capacity"
    ),
    native/return_value("true")
  ])
  return context
end

verb native_value/symbol_intern(input: map) -> map
  let context: map = input
  let table: list = [:Record, "SymbolTable"]
  let entry: list = [:Record, "SymbolEntry"]
  let bytes: list = [:Pointer, :U8, :Const]
  let mutable_bytes: list = [:Pointer, :U8, :Mutable]
  let buckets: list = [:Pointer, :U64, :Mutable]
  let result: list = [:Record, "IdResult"]
  context = native/declare_function(context, "symbol_intern_locked", result,
    [["table", [:Pointer, table, :Mutable], :Borrow], ["source", bytes, :Borrow],
     ["length", :U64, :Value]], [], [:ReadMemory, :WriteMemory, :Allocate], :Value, "")
  context = native/define_function(context, "symbol_intern_locked", [
    native/when_statement(native/binary_expression(:Less, "allocation_limit", "length"), [native/return_zero()]),
    native/unless_statement(
      native/binary_expression(:Equal, "length", "zero"),
      [
        native/when_statement(
          native/binary_expression(:Equal, "source", native/typed_zero(bytes)),
          [native/return_zero()]
        )
      ]
    ),
    native/let_call("hash", :U64, "symbol_hash", ["source", "length"]),
    native/let_load("header", table, "table"),
    native/let_field("capacity", :U64, "header", "capacity"),
    native/let_field("count", :U64, "header", "count"),
    native/let_statement("slot", :U64, "zero"),
    native/unless_statement(native/binary_expression(:Equal, "capacity", "zero"), [
      native/set_statement("slot", native/call_expression("symbol_slot", ["table", "source", "length", "hash"])),
      native/let_field("existing_buckets", buckets, "header", "buckets"),
      native/let_load(
        "existing",
        :U64,
        native/typed_expression(buckets, native/offset_expression("existing_buckets", "slot"))
      ),
      native/unless_statement(
        native/binary_expression(:Equal, "existing", "zero"),
        [
          native/return_record(
            ["true", native/typed_expression(:U64, native/binary_expression(:Subtract, "existing", "one"))]
          )
        ]
      )
    ]),
    native/unless_statement(native/binary_expression(:Less, "count", "symbol_id_limit"), [native/return_zero()]),
    @native/try_call("scan", [:Record, "Utf8Scan"], "utf8_scan", ["source", "length"], [native/return_zero()]),
    native/when_statement(native/binary_expression(:Equal, "count", "capacity"), [
      native/unless_statement(native/call_expression("symbol_grow", ["table"]), [native/return_zero()]),
      native/set_statement("header", native/load_expression("table")),
      native/set_statement("slot", native/call_expression("symbol_slot", ["table", "source", "length", "hash"]))
    ]),
    native/let_statement(
      "storage",
      [:Pointer, [:Record, "SymbolStorage"], :Mutable],
      native/field_pointer_expression("table", "storage")
    ),
    native/let_statement("size", :U64, "length"),
    native/when_statement(native/binary_expression(:Equal, "size", "zero"), [native/set_statement("size", "one")]),
    native/let_call("data", mutable_bytes, "symbol_storage_allocate", ["storage", "size"]),
    native/when_statement(native/binary_expression(:Equal, "data", "null_bytes"), [native/return_zero()]),
    native/unless_statement(
      native/binary_expression(:Equal, "length", "zero"),
      [native/copy_bytes_statement("data", "source", "length")]
    ),
    native/let_statement(
      "item",
      entry,
      native/record_expression(
        [
          native/typed_expression(bytes, native/unary_expression(:Freeze, "data")),
          "length",
          native/typed_field(:U64, "scan", "scalars"),
          "hash",
          native/typed_field(:Bool, "scan", "ascii")
        ]
      )
    ),
    native/let_field("entries", [:Pointer, entry, :Mutable], "header", "entries"),
    native/store_statement(
      native/typed_expression([:Pointer, entry, :Mutable], native/offset_expression("entries", "count")),
      "item"
    ),
    native/let_field("buckets", buckets, "header", "buckets"),
    native/let_statement("next_count", :U64, native/binary_expression(:Add, "count", "one")),
    native/store_statement(native/typed_expression(buckets, native/offset_expression("buckets", "slot")), "next_count"),
    native/store_statement(
      native/typed_expression(buckets, native/field_pointer_expression("table", "count")),
      "next_count"
    ),
    native/return_record(["true", "count"])
  ])
  return context
end

verb native_value/symbol_access(input: map) -> map
  let context: map = input
  let table: list = [:Record, "SymbolTable"]
  let entry: list = [:Record, "SymbolEntry"]
  let pointer: list = [:Pointer, table, :Mutable]
  context = native/declare_function(context, "symbol_text_locked", [:Record, "SymbolText"],
    [["table", pointer, :Borrow], ["id", :U32, :Value]], [], [:ReadMemory], :Borrow, "table")
  context = native/define_function(context, "symbol_text_locked", [
    native/let_load("header", table, "table"),
    native/let_statement("index", :U64, native/unary_expression(:Convert, "id")),
    native/unless_statement(
      native/binary_expression(:Less, "index", native/typed_field(:U64, "header", "count")),
      [native/return_zero()]
    ),
    native/let_field("entries", [:Pointer, entry, :Mutable], "header", "entries"),
    native/let_load(
      "item",
      entry,
      native/typed_expression([:Pointer, entry, :Mutable], native/offset_expression("entries", "index"))
    ),
    native/return_record(
      [
        "true",
        native/typed_field([:Pointer, :U8, :Const], "item", "data"),
        native/typed_field(:U64, "item", "length"),
        native/typed_field(:U64, "item", "scalars"),
        native/typed_field(:Bool, "item", "ascii")
      ]
    )
  ])
  context = native/declare_function(context, "value_symbol_table_release", :Void,
    [["table", pointer, :Consume]], [], [:ReadMemory, :WriteMemory, :Release], :Value, "")
  context = native/define_function(context, "value_symbol_table_release", [
    native/let_statement(
      "storage",
      [:Pointer, [:Record, "SymbolStorage"], :Mutable],
      native/field_pointer_expression("table", "storage")
    ),
    native/do_statement(native/call_expression("symbol_storage_release", ["storage"])),
    native/let_load(
      "mutex",
      [:Pointer, :U8, :Mutable],
      native/typed_expression(
        [:Pointer, [:Pointer, :U8, :Mutable], :Mutable],
        native/field_pointer_expression("table", "mutex")
      )
    ),
    native/unless_statement(
      native/binary_expression(:Equal, "mutex", "null_bytes"),
      [native/do_statement(native/call_expression("mutex_destroy", ["mutex"]))]
    ),
    native/store_statement("table", native/typed_zero(table)),
    native/return_void()
  ])
  return context
end

// Initialization and release require exclusive ownership. The mutex remains
// immutable throughout the table's shared lifetime.
verb native_value/symbol_synchronization(input: map) -> map
  let context: map = input
  let bytes: list = [:Pointer, :U8, :Mutable]
  let pointer: list = [:Pointer, [:Record, "SymbolTable"], :Mutable]
  context = native/declare_function(context, "mutex_create", bytes, [], [], [:Allocate, :Release, :WriteMemory], :Owned, "")
  context[:state] = native/foreign(context[:state], context[:functions]["mutex_create"])
  for spec in [["mutex_lock", :Borrow, [:ReadMemory, :WriteMemory, :Block]],
               ["mutex_unlock", :Borrow, [:ReadMemory, :WriteMemory]],
               ["mutex_destroy", :Consume, [:ReadMemory, :WriteMemory, :Release]]]
    context = native/declare_function(context, spec[0], :Void, [["mutex", bytes, spec[1]]], [], spec[2], :Value, "")
    context[:state] = native/foreign(context[:state], context[:functions][spec[0]])
  end
  context = native/declare_function(context, "value_symbol_table_init", :Bool,
    [["table", pointer, :Borrow]], [], [:ReadMemory, :WriteMemory, :Allocate, :Release], :Value, "")
  context = native/define_function(context, "value_symbol_table_init", [
    native/let_statement("slot", [:Pointer, bytes, :Mutable], native/field_pointer_expression("table", "mutex")),
    native/let_load("existing", bytes, "slot"),
    native/unless_statement(native/binary_expression(:Equal, "existing", "null_bytes"), [native/return_value("false")]),
    native/let_call("owned", bytes, "mutex_create", []),
    native/when_statement(native/binary_expression(:Equal, "owned", "null_bytes"), [native/return_value("false")]),
    native/let_statement("adopted", bytes, native/binary_expression(:Adopt, "slot", "owned")),
    native/return_value("true")
  ])
  return context
end

// Every exit from a locked helper returns through the matching unlock.
verb native_value/symbol_synchronized_access(input: map) -> map
  let context: map = input
  let bytes: list = [:Pointer, :U8, :Mutable]
  let pointer: list = [:Pointer, [:Record, "SymbolTable"], :Mutable]
  for spec in [
      ["value_symbol_intern", "symbol_intern_locked", [:Record, "IdResult"],
       [["source", [:Pointer, :U8, :Const], :Borrow], ["length", :U64, :Value]],
       ["source", "length"], [:ReadMemory, :WriteMemory, :Allocate, :Block], :Value, ""],
      ["value_symbol_text", "symbol_text_locked", [:Record, "SymbolText"],
       [["id", :U32, :Value]], ["id"], [:ReadMemory, :WriteMemory, :Block], :Borrow, "table"]]
    context = native/declare_function(context, spec[0], spec[2], [["table", pointer, :Borrow], @spec[3]], [], spec[5], spec[6], spec[7])
    context = native/define_function(context, spec[0], [
      native/let_load(
        "mutex",
        bytes,
        native/typed_expression([:Pointer, bytes, :Mutable], native/field_pointer_expression("table", "mutex"))
      ),
      native/when_statement(native/binary_expression(:Equal, "mutex", "null_bytes"), [native/return_zero()]),
      native/do_statement(native/call_expression("mutex_lock", ["mutex"])),
      native/let_call("result", spec[2], spec[1], ["table", @spec[4]]),
      native/do_statement(native/call_expression("mutex_unlock", ["mutex"])),
      native/return_value("result")
    ])
  end
  return context
end
