// Hashes follow Omica's canonical value hash. They identify hash buckets within
// one symbol namespace, not durable values or cryptographic content identities.
verb native_value/hashing(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let result: list = [:Record, "IdResult"]
  let [constants, state] = native/constants(context[:state], [
    ["value_hash_basis", :U64, "cbf29ce484222325"], ["value_hash_prime", :U64, "00000100000001b3"]])
  context[:state] = state
  let bindings: map = context[:constants]
  for name, id in constants
    bindings[name] = id
  end
  context[:constants] = bindings
  context = native/declare_function(context, "value_hash_mix", :U64, [["hash", :U64, :Value], ["number", :U64, :Value]], [], [], :Value, "")
  context = native/define_function(context, "value_hash_mix", [
    native/let_statement("mixed", :U64, native/binary_expression(:BitXor, "hash", "number")),
    native/return_value(native/binary_expression(:Multiply, "mixed", "value_hash_prime"))
  ])
  context = native/declare_function(context, "value_hash_bytes", :U64, [["hash", :U64, :Value],
    ["data", [:Pointer, :U8, :Const], :Borrow], ["length", :U64, :Value]], [], [:ReadMemory], :Value, "")
  context = native/define_function(context, "value_hash_bytes", [
    native/let_statement("result", :U64, "hash"),
    @native/for_range("i", "zero", "length", [
      native/let_offset("slot", [:Pointer, :U8, :Const], "data", "i"),
      native/let_load("byte", :U8, "slot"),
      native/set_statement(
        "result",
        native/call_expression(
          "value_hash_mix",
          ["result", native/typed_expression(:U64, native/unary_expression(:Convert, "byte"))]
        )
      )]),
    native/return_value("result")
  ])
  context = native/declare_function(context, "value_hash", result, [["value", word, :Gc]], [["child_hash", result]], [:ReadMemory], :Value, "")
  context = native/declare_function(context, "value_tuple_hash", result, [["tuple", [:Record, "ValueTuple"], :Gc]], [["child_hash", result]], [:ReadMemory], :Value, "")
  context = native/define_function(context, "value_tuple_hash", [
    native/let_field("arity", :U64, "tuple", "arity"),
    native/let_field("data", [:Pointer, word, :Mutable], "tuple", "data"),
    native/let_call("hash", :U64, "value_hash_mix", ["value_hash_basis", "arity"]),
    @native/for_range("i", "zero", "arity", [
      native/let_offset("slot", [:Pointer, word, :Mutable], "data", "i"),
      native/let_load("child", word, "slot"),
      @native_value/hash_child("child")]),
    native/return_record(["true", "hash"])
  ])
  let rows: list = [
    native/let_call("kind", :U8, "value_kind", ["value"]),
    native/let_call(
      "hash",
      :U64,
      "value_hash_mix",
      ["value_hash_basis", native/typed_expression(:U64, native/unary_expression(:Convert, "kind"))]
    )
  ]
  for kind in native_value/kinds()
    if !kind[2]
      rows = [
        @rows,
        native/when_statement(
          native/binary_expression(:Equal, "kind", string_concat("tag_", kind[0])),
          [
            native/return_record(
              [
                "true",
                native/typed_call(
                  :U64,
                  "value_hash_mix",
                  ["hash", native/typed_expression(:U64, native/unary_expression(:Payload, "value"))]
                )
              ]
            )
          ]
        )
      ]
    end
  end
  for spec in [["string", "HeapString", :U8], ["bytes", "HeapBytes", :U8],
               ["list", "HeapList", word], ["map", "HeapMap", [:Record, "ValueMapEntry"]]]
    let prefix: string = spec[0]
    let header: string = string_concat(prefix, "_header")
    let pointer: string = string_concat(prefix, "_pointer")
    let data: string = string_concat(prefix, "_data")
    let length: string = string_concat(prefix, "_length")
    let body: list = [
      native/let_statement(
        pointer,
        [:Pointer, [:Record, spec[1]], :Const],
        native/unary_expression(:UnpackPointer, "value")
      ),
      native/let_load(header, [:Record, spec[1]], pointer),
      native/let_field(data, [:Pointer, spec[2], :Mutable], header, "data"),
      native/let_field(length, :U64, header, "length")
    ]
    if spec[2] == :U8
      body = [
        @body,
        native/return_record(
          [
            "true",
            native/typed_call(
              :U64,
              "value_hash_bytes",
              ["hash", native/typed_expression([:Pointer, :U8, :Const], native/unary_expression(:Freeze, data)), length]
            )
          ]
        )
      ]
    else
      let index: string = string_concat(prefix, "_i")
      let slot: string = string_concat(prefix, "_slot")
      let element: string = string_concat(prefix, "_element")
      let children: list = []
      if prefix == "list"
        children = native_value/hash_child(element)
      else
        for field in ["key", "value"]
          let child: string = string_concat(prefix, "_", field)
          children = [
            @children,
            native/let_field(child, word, element, field),
            @native_value/hash_child(child)
          ]
        end
      end
      body = [
        @body,
        native/set_statement("hash", native/call_expression("value_hash_mix", ["hash", length])),
        @native/for_range(index, "zero", length, [
          native/let_offset(slot, [:Pointer, spec[2], :Mutable], data, index),
          native/let_load(element, spec[2], slot),
          @children]),
        native/return_record(["true", "hash"])
      ]
    end
    rows = [
      @rows,
      native/when_statement(native/binary_expression(:Equal, "kind", string_concat("tag_", prefix)), body)
    ]
  end
  for spec in native_value/record_plan(:Hash)
    let pointer: string = string_concat(spec[0], "_pointer")
    let header: string = string_concat(spec[0], "_header")
    let body: list = [
      native/let_statement(
        pointer,
        [:Pointer, [:Record, spec[1]], :Const],
        native/unary_expression(:UnpackPointer, "value")
      ),
      native/let_load(header, [:Record, spec[1]], pointer)
    ]
    for field in spec[2]
      let local: string = string_concat(spec[0], "_", field[0])
      body = [
        @body,
        native/let_field(local, field[1], header, field[0])
      ]
      let step: list = []
      if field[1] == word
        step = native_value/hash_child(local)
        if field[3] == :StringBytes
          step = [
            native/let_statement(
              "message_pointer",
              [:Pointer, [:Record, "HeapString"], :Const],
              native/unary_expression(:UnpackPointer, local)
            ),
            native/let_load("message_header", [:Record, "HeapString"], "message_pointer"),
            native/let_field("message_data", [:Pointer, :U8, :Mutable], "message_header", "data"),
            native/let_field("message_length", :U64, "message_header", "length"),
            native/set_statement(
              "hash",
              native/call_expression(
                "value_hash_bytes",
                [
                  "hash",
                  native/typed_expression([:Pointer, :U8, :Const], native/unary_expression(:Freeze, "message_data")),
                  "message_length"
                ]
              )
            )
          ]
        end
      elseif field[1] == :Bool
        step = [
          native/if_statement(
            local,
            [native/set_statement("hash", native/call_expression("value_hash_mix", ["hash", "one"]))],
            [native/set_statement("hash", native/call_expression("value_hash_mix", ["hash", "zero"]))]
          )
        ]
      elseif field[1] == :U64
        step = [native/set_statement("hash", native/call_expression("value_hash_mix", ["hash", local]))]
      else
        step = [
          native/set_statement(
            "hash",
            native/call_expression(
              "value_hash_mix",
              ["hash", native/typed_expression(:U64, native/unary_expression(:Convert, local))]
            )
          )
        ]
      end
      if field[2] != ""
        step = [native/when_statement(string_concat(spec[0], "_", field[2]), step)]
      end
      body = [@body, @step]
    end
    rows = [
      @rows,
      native/when_statement(native/binary_expression(:Equal, "kind", string_concat("tag_", spec[0])), [
        @body,
        native/return_record(["true", "hash"])
      ])
    ]
  end
  rows = [
    @rows,
    native/when_statement(native/binary_expression(:Equal, "kind", "tag_relation"), [
      @native/try_call("relation_checked", [:Record, "RelationResult"], "value_relation_view", ["value"], [native/return_zero()]),
      native/let_field("relation", [:Record, "HeapRelation"], "relation_checked", "relation"),
      native/let_field("heading", [:Pointer, :U32, :Mutable], "relation", "heading"),
      native/let_field("arity", :U64, "relation", "arity"),
      native/set_statement("hash", native/call_expression("value_hash_mix", ["hash", "arity"])),
      @native/for_range("column", "zero", "arity", [
        native/let_offset("column_slot", [:Pointer, :U32, :Mutable], "heading", "column"),
        native/let_load("symbol", :U32, "column_slot"),
        native/set_statement(
          "hash",
          native/call_expression(
            "value_hash_mix",
            ["hash", native/typed_expression(:U64, native/unary_expression(:Convert, "symbol"))]
          )
        )]),
      native/let_field("tuples", [:Pointer, [:Record, "ValueTuple"], :Mutable], "relation", "rows"),
      native/let_field("length", :U64, "relation", "length"),
      native/set_statement("hash", native/call_expression("value_hash_mix", ["hash", "length"])),
      @native/for_range("row", "zero", "length", [
        native/let_offset("row_slot", [:Pointer, [:Record, "ValueTuple"], :Mutable], "tuples", "row"),
        native/set_statement(
          "child_hash",
          native/call_expression("value_tuple_hash", [native/typed_load([:Record, "ValueTuple"], "row_slot")])
        ),
        native/unless_statement(native/field_expression("child_hash", "ok"), [native/return_zero()]),
        native/set_statement(
          "hash",
          native/call_expression("value_hash_mix", ["hash", native/typed_field(:U64, "child_hash", "number")])
        )]),
      native/return_record(["true", "hash"])
    ]),
    native/return_zero()
  ]
  context = native/define_function(context, "value_hash", rows)
  return context
end

verb native_value/hash_child(child: string) -> list
  return [
    native/set_statement("child_hash", native/call_expression("value_hash", [child])),
    native/unless_statement(native/field_expression("child_hash", "ok"), [native/return_zero()]),
    native/set_statement(
      "hash",
      native/call_expression("value_hash_mix", ["hash", native/typed_field(:U64, "child_hash", "number")])
    )
  ]
end
