// Declarations precede value_compare because tuples can contain relations.
verb native_value/relation_types(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let tuple: list = [:Record, "ValueTuple"]
  let relation: list = [:Record, "HeapRelation"]
  let state: map = context[:state]
  state = native/record_type(state, "ValueTuple", [["data", [:Pointer, word, :Mutable]], ["arity", :U64]])[1]
  state = native/record_type(state, "TupleResult", [["ok", :Bool], ["tuple", tuple]])[1]
  state = native/record_type(state, "RelationColumn", [["symbol", :U32], ["source", :U64]])[1]
  state = native/record_type(state, "HeapRelation", [["heading", [:Pointer, :U32, :Mutable]], ["arity", :U64],
    ["rows", [:Pointer, tuple, :Mutable]], ["length", :U64]])[1]
  state = native/record_type(state, "RelationResult", [["ok", :Bool], ["relation", relation]])[1]
  let [constants, next] = native/constants(state, [
    ["relation_max_arity", :U64, "000000000000ffff"],
    ["null_heading", [:Pointer, :U32, :Const], "null"],
    ["null_rows", [:Pointer, tuple, :Const], "null"]])
  context[:state] = next
  let bindings: map = context[:constants]
  for name, id in constants
    bindings[name] = id
  end
  context[:constants] = bindings
  context = native/declare_function(context, "value_tuple_compare", [:Record, "IntResult"],
    [["left", tuple, :Gc], ["right", tuple, :Gc]], [], [:ReadMemory], :Value, "")
  context = native/declare_function(context, "value_relation_compare", [:Record, "IntResult"],
    [["left", word, :Gc], ["right", word, :Gc]], [], [:ReadMemory], :Value, "")
  return context
end

verb native_value/relations(input: map) -> map
  let context: map = input
  context = native_value/tuple_operations(context)
  context = native_value/relation_accessors(context)
  context = native_value/relation_order(context)
  context = native_value/relation_sort(context, "columns", [:Record, "RelationColumn"])
  context = native_value/relation_sort(context, "rows", [:Record, "ValueTuple"])
  context = native_value/relation_constructor(context)
  return context
end

verb native_value/tuple_operations(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let values: list = [:Pointer, word, :Mutable]
  let tuple: list = [:Record, "ValueTuple"]
  context = native/declare_function(context, "value_tuple", [:Record, "TupleResult"], [
    ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow],
    ["source", [:Pointer, word, :Const], :Gc], ["arity", :U64, :Value]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, "value_tuple", [
    native/when_statement(
      native/binary_expression(:Equal, "arity", "zero"),
      [native/return_record(["true", native/typed_zero(tuple)])]
    ),
    native/when_statement(native/binary_expression(:Equal, "source", "null_values"), [native/return_zero()]),
    native/let_statement("size", :U64, native/unary_expression(:SizeOf, word)),
    native/let_statement("limit", :U64, native/binary_expression(:Divide, "allocation_limit", "size")),
    native/when_statement(native/binary_expression(:Less, "limit", "arity"), [native/return_zero()]),
    native/let_statement("bytes", :U64, native/binary_expression(:Multiply, "arity", "size")),
    @native_memory/allocate("raw", "bytes", "layout_values", [native/return_zero()]),
    native/let_statement("data", values, native/unary_expression(:PointerCast, "raw")),
    @native/copy_elements(word, "data", "source", "arity"),
    native/return_record(["true", native/typed_record(tuple, ["data", "arity"])])
  ])
  context = native/declare_function(context, "value_tuple_get", [:Record, "ValueResult"],
    [["tuple", tuple, :Gc], ["index", :U64, :Value]], [], [:ReadMemory], :Gc, "")
  context = native/define_function(context, "value_tuple_get", [
    native/let_field("arity", :U64, "tuple", "arity"),
    native/unless_statement(native/binary_expression(:Less, "index", "arity"), [native/return_zero()]),
    native/let_field("data", values, "tuple", "data"),
    native/let_offset("slot", values, "data", "index"),
    native/return_record(["true", native/typed_load(word, "slot")])
  ])
  context = native/define_function(context, "value_tuple_compare", [
    native/let_field("left_data", values, "left", "data"),
    native/let_field("right_data", values, "right", "data"),
    native/let_field("left_arity", :U64, "left", "arity"),
    native/let_field("right_arity", :U64, "right", "arity"),
    @native/for_range("i", "zero", "left_arity", [
      native/unless_statement(native/binary_expression(:Less, "i", "right_arity"), [native/break_statement()]),
      native/let_offset("left_slot", values, "left_data", "i"),
      native/let_offset("right_slot", values, "right_data", "i"),
      @native/try_call("comparison", [:Record, "IntResult"], "value_compare", [native/typed_load(word, "left_slot"), native/typed_load(word, "right_slot")], [native/return_value("comparison")]),
      native/unless_statement(
        native/binary_expression(:Equal, native/typed_field(:I64, "comparison", "number"), "int_zero"),
        [native/return_value("comparison")]
      )]),
    @native_value/scalar_order("left_arity", "right_arity")
  ])
  return context
end

// Returning a header by value gives the immediate empty relation a normal view
// without a fabricated heap pointer or a process-global mutable sentinel.
verb native_value/relation_accessors(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let relation: list = [:Record, "HeapRelation"]
  let tuple: list = [:Record, "ValueTuple"]
  let result: list = [:Record, "RelationResult"]
  context = native/declare_function(context, "value_relation_view", result, [["value", word, :Gc]], [], [:ReadMemory], :Gc, "")
  context = native/define_function(context, "value_relation_view", [
    native/let_statement("tag", :U8, native/unary_expression(:Tag, "value")),
    native/when_statement(
      native/binary_expression(:Equal, "tag", "zero_tag"),
      [native/return_record(["true", native/typed_zero(relation)])]
    ),
    native/unless_statement(native/binary_expression(:Equal, "tag", "tag_relation"), [native/return_zero()]),
    native/let_statement("pointer", [:Pointer, relation, :Const], native/unary_expression(:UnpackPointer, "value")),
    native/return_record(["true", native/typed_load(relation, "pointer")])
  ])
  let read: list = [
    @native/try_call("checked", result, "value_relation_view", ["value"], [native/return_zero()]),
    native/let_field("relation", relation, "checked", "relation")
  ]
  for field in ["arity", "length"]
    let name: string = string_concat("value_relation_", field)
    context = native/declare_function(context, name, [:Record, "IdResult"], [["value", word, :Gc]], [], [:ReadMemory], :Value, "")
    context = native/define_function(context, name, [
      @read,
      native/return_record(["true", native/typed_field(:U64, "relation", field)])
    ])
  end
  context = native/declare_function(context, "value_is_unit", :Bool, [["value", word, :Gc]], [], [:ReadMemory], :Value, "")
  context = native/define_function(context, "value_is_unit", [
    @read,
    native/unless_statement(
      native/binary_expression(:Equal, native/typed_field(:U64, "relation", "arity"), "zero"),
      [native/return_value("false")]
    ),
    native/return_value(native/binary_expression(:Equal, native/typed_field(:U64, "relation", "length"), "one"))
  ])
  context = native/declare_function(context, "value_relation_row", [:Record, "TupleResult"],
    [["value", word, :Gc], ["index", :U64, :Value]], [], [:ReadMemory], :Gc, "")
  context = native/define_function(context, "value_relation_row", [
    @read,
    native/unless_statement(
      native/binary_expression(:Less, "index", native/typed_field(:U64, "relation", "length")),
      [native/return_zero()]
    ),
    native/let_field("rows", [:Pointer, tuple, :Mutable], "relation", "rows"),
    native/let_offset("slot", [:Pointer, tuple, :Mutable], "rows", "index"),
    native/return_record(["true", native/typed_load(tuple, "slot")])
  ])
  context = native/declare_function(context, "value_relation_column_at", [:Record, "IdResult"],
    [["value", word, :Gc], ["index", :U64, :Value]], [], [:ReadMemory], :Value, "")
  context = native/define_function(context, "value_relation_column_at", [
    @read,
    native/unless_statement(
      native/binary_expression(:Less, "index", native/typed_field(:U64, "relation", "arity")),
      [native/return_zero()]
    ),
    native/let_field("heading", [:Pointer, :U32, :Mutable], "relation", "heading"),
    native/let_offset("slot", [:Pointer, :U32, :Mutable], "heading", "index"),
    native/let_load("symbol", :U32, "slot"),
    native/return_record(["true", native/typed_expression(:U64, native/unary_expression(:Convert, "symbol"))])
  ])
  context = native/declare_function(context, "value_relation_column", [:Record, "IdResult"],
    [["value", word, :Gc], ["symbol", :U32, :Value]], [], [:ReadMemory], :Value, "")
  let builder: map = native_gen/context(context, "value_relation_column")
  let [checked: map, with_checked: map] = native_value/checked_result(builder, "value_relation_view",
    [native_gen/ref(builder, "value")], fn(failed) => native_gen/return_zero(failed))
  let [view: map, with_view: map] = native_gen/bind(with_checked, "relation",
    native_gen/field(with_checked, checked, "relation"))
  let [heading: map, with_heading: map] = native_gen/bind(with_view, "heading", native_gen/field(with_view, view, "heading"))
  let [arity: map, with_arity: map] = native_gen/bind(with_heading, "arity", native_gen/field(with_heading, view, "arity"))
  let symbol: map = native_gen/ref(with_arity, "symbol")
  builder = native_sequence/search_return(with_arity, native_sequence/span(heading, arity), fn(body, candidate)
      return [native_gen/equal(candidate, symbol), native_gen/less(candidate, symbol), body]
    end, fn(found, index, candidate)
      return native_gen/return_value(found, native_gen/record(found, [:Record, "IdResult"],
        {"ok" -> native_gen/ref(found, "true"), "number" -> index}))
    end)
  builder = native_gen/return_zero(builder)
  context = native_gen/finish(context, builder)
  return context
end

verb native_value/relation_order(input: map) -> map
  let context: map = input
  let tuple: list = [:Record, "ValueTuple"]
  let relation: list = [:Record, "HeapRelation"]
  let rows: list = []
  for side in ["left", "right"]
    rows = [
      @rows,
      @native/try_call(string_concat(side, "_checked"), [:Record, "RelationResult"], "value_relation_view", [side], [native/return_zero()]),
      native/let_field(string_concat(side, "_view"), relation, string_concat(side, "_checked"), "relation")
    ]
  end
  // Rust orders headings lexicographically, then the canonical tuple sequence.
  for spec in [["heading", :U32, "arity"], ["rows", tuple, "length"]]
    for side in ["left", "right"]
      rows = [
        @rows,
        native/let_field(
          string_concat(side, "_", spec[0]),
          [:Pointer, spec[1], :Mutable],
          string_concat(side, "_view"),
          spec[0]
        ),
        native/let_field(string_concat(side, "_", spec[2]), :U64, string_concat(side, "_view"), spec[2])
      ]
    end
    let index: string = string_concat(spec[0], "_i")
    let elements: list = []
    for side in ["left", "right"]
      let slot: string = string_concat(side, "_", spec[0], "_slot")
      elements = [
        @elements,
        native/let_offset(slot, [:Pointer, spec[1], :Mutable], string_concat(side, "_", spec[0]), index),
        native/let_load(string_concat(side, "_", spec[0], "_element"), spec[1], slot)
      ]
    end
    let left: string = string_concat("left_", spec[0], "_element")
    let right: string = string_concat("right_", spec[0], "_element")
    if spec[0] == "heading"
      elements = [
        @elements,
        native/unless_statement(native/binary_expression(:Equal, left, right), native_value/scalar_order(left, right))
      ]
    else
      elements = [
        @elements,
        @native/try_call("comparison", [:Record, "IntResult"], "value_tuple_compare", [left, right], [native/return_value("comparison")]),
        native/unless_statement(
          native/binary_expression(:Equal, native/typed_field(:I64, "comparison", "number"), "int_zero"),
          [native/return_value("comparison")]
        )
      ]
    end
    let left_count: string = string_concat("left_", spec[2])
    let right_count: string = string_concat("right_", spec[2])
    rows = [
      @rows,
      @native/for_range(index, "zero", left_count, [
        native/unless_statement(native/binary_expression(:Less, index, right_count), [native/break_statement()]),
        @elements]),
      native/unless_statement(
        native/binary_expression(:Equal, left_count, right_count),
        native_value/scalar_order(left_count, right_count)
      )
    ]
  end
  context = native/define_function(context, "value_relation_compare", [
    @rows,
    native/return_record(["true", "int_zero"])
  ])
  return context
end

// Ordering policy is separate from the shared traversal and stable merge.
verb native_value/relation_ordered(builder: map, kind: string, left: map, right: map) -> list
  if kind == "columns"
    return [native_gen/negate(native_gen/less(native_gen/field(builder, right, "symbol"), native_gen/field(builder, left, "symbol"))), builder]
  end
  let [comparison: map, current: map] = native_value/checked_result(builder, "value_tuple_compare", [left, right], fn(failed) => native_gen/return_zero(failed))
  return [native_gen/negate(native_gen/less(native_gen/zero(:I64), native_gen/field(current, comparison, "number"))), current]
end

// Sort descriptors, not their cell arrays. Already ordered input allocates
// nothing; merging uses one scratch buffer and copies back only when needed.
verb native_value/relation_sort(input: map, kind: string, element: list) -> map
  let context: map = input
  let pointer: list = [:Pointer, element, :Mutable]
  let name: string = string_concat("relation_sort_", kind)
  context = native/declare_function(context, name, :Bool, [
    ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow],
    ["data", pointer, :Gc], ["length", :U64, :Value]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Value, "")
  let builder: map = native_gen/context(context, name)
  let length: map = native_gen/ref(builder, "length")
  let data: map = native_gen/ref(builder, "data")
  let span: map = native_sequence/span(data, length)
  let success = fn(done) => native_gen/return_value(done, native_gen/ref(done, "true"))
  let failure = fn(failed) => native_gen/return_zero(failed)
  builder = native_gen/unless(builder, native_gen/less(native_gen/ref(builder, "one"), length), success)
  let capacity: map = native_gen/divide(native_gen/ref(builder, "allocation_limit"), native_gen/sizeof(element))
  builder = native_gen/when(builder, native_gen/less(capacity, length), failure)
  let compare = fn(body, left, right) => native_value/relation_ordered(body, kind, left, right)
  let [ordered: map, with_ordered: map] = native_sequence/is_ordered(builder, span, compare)
  builder = with_ordered
  builder = native_gen/when(builder, ordered, success)
  let [scratch: map, with_scratch: map] = native_memory/array_storage(builder, native_gen/ref(builder, "worker"), element, length, "layout_opaque", failure)
  builder = with_scratch
  let [sorted: map, with_sorted: map] = native_sequence/stable_merge(builder, span, scratch, compare)
  builder = with_sorted
  builder = native_gen/unless(builder, native_gen/equal(sorted, data), fn(copy)
    return native_sequence/copy(copy, span, native_sequence/span(sorted, length))
  end)
  builder = success(builder)
  context = native_gen/finish(context, builder)
  return context
end

// Validate the complete source before allocating the canonical relation.
verb native_value/relation_validate_rows(builder: map, source: map, arity: map, length: map) -> map
  let result: map = native_gen/for_range(builder, "validate_row", native_gen/zero(:U64), length, fn(initial_body, index)
    let [row: map, with_row: map] = native_gen/bind(initial_body, "row", native_gen/load(native_gen/offset(source, index)))
    let body: map = native_gen/unless(with_row,
      native_gen/equal(native_gen/field(with_row, row, "arity"), arity),
      fn(failed) => native_gen/return_zero(failed))
    return native_gen/unless(body, native_gen/equal(arity, native_gen/zero(:U64)), fn(nonempty)
      let data: map = native_gen/field(nonempty, row, "data")
      let borrowed: map = native_gen/freeze(data)
      return native_gen/when(nonempty,
        native_gen/equal(borrowed, native_gen/ref(nonempty, "null_values")),
        fn(failed) => native_gen/return_zero(failed))
    end)
  end)
  return result
end

// The upper bound on arity makes these products safe before the allocation
// limit check. The returned sizes are bound once and used to partition storage.
verb native_value/relation_sizes(builder: map, arity: map, length: map) -> list
  let [header: map, with_header: map] = native_gen/bind(builder, "header_size", native_gen/sizeof([:Record, "HeapRelation"]))
  let [symbol: map, with_symbol: map] = native_gen/bind(with_header, "symbol_size", native_gen/sizeof(:U32))
  let [heading: map, with_heading: map] = native_gen/bind(with_symbol, "heading_size", native_gen/multiply(arity, symbol))
  let current: map = native_gen/assign(with_heading, heading,
    native_gen/add(heading, native_gen/ref(with_heading, "alignment_slack")))
  current = native_gen/assign(current, heading, native_gen/bit_and(heading, native_gen/ref(current, "alignment_mask")))
  let [prefix: map, with_prefix: map] = native_gen/bind(current, "prefix", native_gen/add(header, heading))
  let [tuple: map, with_tuple: map] = native_gen/bind(with_prefix, "tuple_size", native_gen/sizeof([:Record, "ValueTuple"]))
  let [word: map, with_word: map] = native_gen/bind(with_tuple, "word_size", native_gen/sizeof(native_value/word()))
  let [cell: map, with_cell: map] = native_gen/bind(with_word, "cell_size", native_gen/multiply(arity, word))
  let [row: map, with_row: map] = native_gen/bind(with_cell, "row_size", native_gen/add(tuple, cell))
  let [limit: map, with_limit: map] = native_gen/bind(with_row, "limit",
    native_gen/subtract(native_gen/ref(with_row, "allocation_limit"), prefix))
  current = native_gen/assign(with_limit, limit, native_gen/divide(limit, row))
  current = native_gen/when(current, native_gen/less(limit, length), fn(failed) => native_gen/return_zero(failed))
  return [{:header -> header, :prefix -> prefix, :tuple -> tuple, :row -> row}, current]
end

verb native_value/relation_count(builder: map, arity: map, length: map) -> list
  let [count: map, with_count: map] = native_gen/bind(builder, "count", length)
  let result: map = native_gen/when(with_count, native_gen/equal(arity, native_gen/zero(:U64)), fn(initial_unit)
    let unit: map = native_gen/when(initial_unit, native_gen/equal(length, native_gen/zero(:U64)), fn(empty)
      let value: map = native_gen/call(empty, "value_empty_relation", [])
      let result: map = native_gen/record(empty, [:Record, "ValueResult"],
        {"ok" -> native_gen/ref(empty, "true"), "value" -> value})
      return native_gen/return_value(empty, result)
    end)
    return native_gen/assign(unit, count, native_gen/ref(unit, "one"))
  end)
  return [count, result]
end

// Sort (symbol, source-position) descriptors before writing a canonical
// heading. The source position is retained for every projected row.
verb native_value/relation_columns(builder: map, worker: map, heading: map, arity: map) -> list
  let column: list = [:Record, "RelationColumn"]
  let columns: list = [:Pointer, column, :Mutable]
  let [order: map, with_order: map] = native_gen/bind(builder, "order", native_gen/zero(columns))
  let result: map = native_gen/unless(with_order, native_gen/equal(arity, native_gen/zero(:U64)), fn(initial_columns)
    let [column_size: map, with_size: map] = native_gen/bind(initial_columns, "column_size", native_gen/sizeof(column))
    let [order_bytes: map, with_bytes: map] = native_gen/bind(with_size, "order_bytes", native_gen/multiply(arity, column_size))
    let [raw: map, with_raw: map] = native_memory/reserve(with_bytes, worker, order_bytes, "layout_opaque",
      fn(failed) => native_gen/return_zero(failed))
    let current: map = native_gen/assign(with_raw, order, native_gen/cast(columns, raw))
    current = native_gen/for_range(current, "column", native_gen/zero(:U64), arity, fn(cell, index)
      let [symbol: map, with_symbol: map] = native_gen/bind(cell, "symbol", native_gen/load(native_gen/offset(heading, index)))
      let descriptor: map = native_gen/record(with_symbol, column, {"symbol" -> symbol, "source" -> index})
      return native_gen/store(with_symbol, native_gen/offset(order, index), descriptor)
    end)
    current = native_gen/unless(current,
      native_gen/call(current, "relation_sort_columns", [worker, order, arity]),
      fn(failed) => native_gen/return_zero(failed))
    return native_gen/for_range(current, "column", native_gen/ref(current, "one"), arity, fn(cell, index)
      let previous: map = native_gen/load(native_gen/offset(order, native_gen/subtract(index, native_gen/ref(cell, "one"))))
      let candidate: map = native_gen/load(native_gen/offset(order, index))
      return native_gen/when(cell,
        native_gen/equal(native_gen/field(cell, previous, "symbol"), native_gen/field(cell, candidate, "symbol")),
        fn(failed) => native_gen/return_zero(failed))
    end)
  end)
  return [order, result]
end

// One allocation holds the relation header, aligned heading, row headers, and
// value cells. The builder returns typed references to those component pointers.
verb native_value/relation_storage(builder: map, worker: map, count: map, sizes: map) -> list
  let [rows_size: map, with_rows: map] = native_gen/bind(builder, "rows_size", native_gen/multiply(count, sizes[:row]))
  let [total: map, with_total: map] = native_gen/bind(with_rows, "total", native_gen/add(sizes[:prefix], rows_size))
  let [raw: map, with_raw: map] = native_memory/reserve(with_total, worker, total, "layout_relation",
    fn(failed) => native_gen/return_zero(failed))
  let [target: map, with_target: map] = native_gen/bind(with_raw, "target",
    native_gen/cast([:Pointer, [:Record, "HeapRelation"], :Mutable], raw))
  let [raw_heading: map, with_heading: map] = native_gen/bind(with_target, "raw_heading", native_gen/offset(raw, sizes[:header]))
  let [canonical: map, with_canonical: map] = native_gen/bind(with_heading, "canonical_heading",
    native_gen/cast([:Pointer, :U32, :Mutable], raw_heading))
  let [raw_rows: map, with_raw_rows: map] = native_gen/bind(with_canonical, "raw_rows", native_gen/offset(raw, sizes[:prefix]))
  let [rows: map, with_rows_pointer: map] = native_gen/bind(with_raw_rows, "rows",
    native_gen/cast([:Pointer, [:Record, "ValueTuple"], :Mutable], raw_rows))
  let [tuple_bytes: map, with_tuple_bytes: map] = native_gen/bind(with_rows_pointer, "tuple_bytes",
    native_gen/multiply(count, sizes[:tuple]))
  let [raw_cells: map, with_raw_cells: map] = native_gen/bind(with_tuple_bytes, "raw_cells",
    native_gen/offset(raw_rows, tuple_bytes))
  let [cells: map, result: map] = native_gen/bind(with_raw_cells, "cells",
    native_gen/cast([:Pointer, native_value/word(), :Mutable], raw_cells))
  return [{:target -> target, :heading -> canonical, :rows -> rows, :cells -> cells}, result]
end

verb native_value/relation_write_heading(builder: map, order: map, arity: map, canonical: map) -> map
  let result: map = native_gen/for_range(builder, "heading", native_gen/zero(:U64), arity, fn(body, index)
    let descriptor: map = native_gen/load(native_gen/offset(order, index))
    return native_gen/store(body, native_gen/offset(canonical, index), native_gen/field(body, descriptor, "symbol"))
  end)
  return result
end

verb native_value/relation_project_rows(builder: map, source: map, order: map, arity: map, count: map, rows: map, cells: map) -> map
  let tuple: list = [:Record, "ValueTuple"]
  let result: map = native_gen/for_range(builder, "row", native_gen/zero(:U64), count, fn(initial_row, index)
    let [input: map, with_input: map] = native_gen/bind(initial_row, "row", native_gen/load(native_gen/offset(source, index)))
    let data: map = native_gen/field(with_input, input, "data")
    let body: map = native_gen/for_range(with_input, "cell", native_gen/zero(:U64), arity, fn(cell, position)
      let descriptor: map = native_gen/load(native_gen/offset(order, position))
      let source_index: map = native_gen/field(cell, descriptor, "source")
      return native_gen/store(cell, native_gen/offset(cells, position),
        native_gen/load(native_gen/offset(data, source_index)))
    end)
    body = native_gen/store(body, native_gen/offset(rows, index),
      native_gen/record(body, tuple, {"data" -> cells, "arity" -> arity}))
    return native_gen/assign(body, cells, native_gen/offset(cells, arity))
  end)
  return result
end

verb native_value/relation_compact_rows(builder: map, worker: map, rows: map, count: map) -> list
  let sorted: map = native_gen/unless(builder,
    native_gen/call(builder, "relation_sort_rows", [worker, rows, count]),
    fn(failed) => native_gen/return_zero(failed))
  let compacted: list = native_sequence/compact_sorted(sorted, native_sequence/span(rows, count),
    fn(body, left, right)
      let [comparison: map, current: map] = native_value/checked_result(body,
        "value_tuple_compare", [left, right], fn(failed) => native_gen/return_zero(failed))
      return [native_gen/field(current, comparison, "number"), current]
    end,
    fn(equal, preceding, entry) => equal)
  return compacted
end

verb native_value/relation_constructor(input: map) -> map
  let context: map = native/declare_function(input, "value_relation", [:Record, "ValueResult"], [
    ["worker", native_memory/record_pointer("MemoryWorker"), :Borrow],
    ["heading", [:Pointer, :U32, :Const], :Borrow], ["arity", :U64, :Value],
    ["source", [:Pointer, [:Record, "ValueTuple"], :Const], :Gc], ["length", :U64, :Value]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  let builder: map = native_gen/context(context, "value_relation")
  let worker: map = native_gen/ref(builder, "worker")
  let heading: map = native_gen/ref(builder, "heading")
  let arity: map = native_gen/ref(builder, "arity")
  let source: map = native_gen/ref(builder, "source")
  let length: map = native_gen/ref(builder, "length")
  builder = native_gen/when(builder, native_gen/less(native_gen/ref(builder, "relation_max_arity"), arity),
    fn(failed) => native_gen/return_zero(failed))
  builder = native_gen/unless(builder, native_gen/equal(arity, native_gen/zero(:U64)), fn(nonempty)
    return native_gen/when(nonempty, native_gen/equal(heading, native_gen/ref(nonempty, "null_heading")),
      fn(failed) => native_gen/return_zero(failed))
  end)
  builder = native_gen/unless(builder, native_gen/equal(length, native_gen/zero(:U64)), fn(nonempty)
    return native_gen/when(nonempty, native_gen/equal(source, native_gen/ref(nonempty, "null_rows")),
      fn(failed) => native_gen/return_zero(failed))
  end)
  let [sizes: map, with_sizes: map] = native_value/relation_sizes(builder, arity, length)
  builder = native_value/relation_validate_rows(with_sizes, source, arity, length)
  let [count: map, with_count: map] = native_value/relation_count(builder, arity, length)
  let [order: map, with_order: map] = native_value/relation_columns(with_count, worker, heading, arity)
  let [storage: map, with_storage: map] = native_value/relation_storage(with_order, worker, count, sizes)
  builder = native_value/relation_write_heading(with_storage, order, arity, storage[:heading])
  builder = native_value/relation_project_rows(builder, source, order, arity, count, storage[:rows], storage[:cells])
  let [written: map, with_written: map] = native_value/relation_compact_rows(builder, worker, storage[:rows], count)
  builder = native_gen/note(with_written, :Invariant,
    "Publish canonical headings and sorted unique rows. The collector traces child values.")
  builder = native_gen/store(builder, storage[:target], native_gen/record(builder, [:Record, "HeapRelation"],
    {"heading" -> storage[:heading], "arity" -> arity, "rows" -> storage[:rows], "length" -> written}))
  builder = native_gen/return_value(builder, native_value/packed_result(builder, storage[:target], "relation"))
  let result: map = native_gen/finish(context, builder)
  return result
end
