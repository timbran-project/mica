// List views share immutable prefixes. Mutating an worker, including claiming a
// list's unused tail, requires serialization just as string append does.
verb native_value/collections(input: map) -> map
  let context: map = input
  context = native_value/list_allocation(context)
  context = native_value/list_operations(context)
  context = native_value/map_update(context)
  return context
end

verb native_value/list_allocation(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let header: list = [:Record, "HeapList"]
  let storage: list = [:Record, "ListStorage"]
  let pointer: list = [:Pointer, header, :Mutable]
  let values: list = [:Pointer, word, :Mutable]
  let [constants, state] = native/constants(context[:state], [
    ["null_list_header", pointer, "null"],
    ["null_values", [:Pointer, word, :Const], "null"]])
  context[:state] = state
  let bindings: map = context[:constants]
  for name, id in constants
    bindings[name] = id
  end
  context[:constants] = bindings
  context = native/declare_function(context, "list_allocate", pointer, [
    ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow],
    ["length", :U64, :Value], ["capacity", :U64, :Value]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(
    context,
    "list_allocate",
    [
      native/when_statement(
        native/binary_expression(:Less, "capacity", "length"),
        [native/return_value("null_list_header")]
      ),
      native/let_statement("header_size", :U64, native/unary_expression(:SizeOf, header)),
      native/let_statement("storage_size", :U64, native/unary_expression(:SizeOf, storage)),
      native/let_statement("prefix", :U64, native/binary_expression(:Add, "header_size", "storage_size")),
      native/let_statement("element_size", :U64, native/unary_expression(:SizeOf, word)),
      @native_memory/allocate_with_tail("raw", "prefix", "element_size", "capacity",
        "layout_list", [native/return_value("null_list_header")]),
      native/let_statement("target", pointer, native/unary_expression(:PointerCast, "raw")),
      native/let_offset("storage_raw", [:Pointer, :U8, :Mutable], "raw", "header_size"),
      native/let_statement(
        "backing",
        [:Pointer, storage, :Mutable],
        native/unary_expression(:PointerCast, "storage_raw")
      ),
      native/let_offset("data_raw", [:Pointer, :U8, :Mutable], "raw", "prefix"),
      native/let_statement("data", values, native/unary_expression(:PointerCast, "data_raw")),
      native/store_statement("backing", native/typed_record(storage, ["data", "length", "capacity"])),
      native/store_statement("target", native/typed_record(header, ["data", "length", "backing"])),
      native/return_value("target")
    ]
  )
  context = native/declare_function(context, "value_list", [:Record, "ValueResult"], [
    ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow],
    ["source", [:Pointer, word, :Const], :Gc], ["length", :U64, :Value]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, "value_list", [
    native/unless_statement(
      native/binary_expression(:Equal, "length", "zero"),
      [ native/when_statement(native/binary_expression(:Equal, "source", "null_values"), [native/return_zero()])]
    ),
    native/let_call("target", pointer, "list_allocate", ["worker", "length", "length"]),
    native/when_statement(native/binary_expression(:Equal, "target", "null_list_header"), [native/return_zero()]),
    native/let_load("header", header, "target"),
    native/let_field("data", values, "header", "data"),
    @native/copy_elements(word, "data", "source", "length"),
    native/return_record(
      ["true", native/typed_expression(word, native/binary_expression(:PackPointer, "target", "tag_list"))]
    )
  ])
  return context
end

verb native_value/list_operations(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let header: list = [:Record, "HeapList"]
  let values: list = [:Pointer, word, :Mutable]
  let result: list = [:Record, "ValueResult"]
  let worker: list = ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow]
  for kind in ["list", "map"]
    let record: list = [:Record, "HeapList"]
    if kind == "map"
      record = [:Record, "HeapMap"]
    end
    let name: string = string_concat("value_", kind, "_length")
    context = native/declare_function(context, name, [:Record, "IdResult"], [["value", word, :Gc]], [], [:ReadMemory], :Value, "")
    context = native/define_function(context, name, [
      @native_value/open_heap("value", kind, record, "pointer", "header", [native/return_zero()]),
      native/return_record(["true", native/typed_field(:U64, "header", "length")])
    ])
  end
  let read: list = [
    @native_value/open_heap("value", "list", header, "pointer", "header", [native/return_zero()]),
    native/let_field("data", values, "header", "data"),
    native/let_field("length", :U64, "header", "length")
  ]
  context = native/declare_function(context, "value_list_get", result, [["value", word, :Gc], ["index", :U64, :Value]], [], [:ReadMemory], :Gc, "")
  context = native/define_function(context, "value_list_get", [
    @read,
    @native/checked_element("slot", word, "data", "length", "index", [native/return_zero()]),
    native/return_record(["true", native/typed_load(word, "slot")])
  ])
  context = native/declare_function(context, "value_list_slice", result, [worker, ["value", word, :Gc],
    ["start", :U64, :Value], ["end", :U64, :Value]], [], [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, "value_list_slice", [
    @read,
    native/when_statement(native/binary_expression(:Less, "end", "start"), [native/return_zero()]),
    native/when_statement(native/binary_expression(:Less, "length", "end"), [native/return_zero()]),
    @native_memory/allocate_record("target", header, "layout_list_view", [native/return_zero()]),
    native/set_statement("data", native/offset_expression("data", "start")),
    native/set_statement("length", native/binary_expression(:Subtract, "end", "start")),
    native/let_field("storage", [:Pointer, [:Record, "ListStorage"], :Mutable], "header", "storage"),
    native/store_statement("target", native/typed_record(header, ["data", "length", "storage"])),
    native/return_record(
      ["true", native/typed_expression(word, native/binary_expression(:PackPointer, "target", "tag_list"))]
    )
  ])
  context = native/declare_function(context, "value_list_set", result, [worker, ["value", word, :Gc],
    ["index", :U64, :Value], ["element", word, :Gc]], [], [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, "value_list_set", [
    @read,
    native/unless_statement(native/binary_expression(:Less, "index", "length"), [native/return_zero()]),
    native/let_statement("source", [:Pointer, word, :Const], native/unary_expression(:Freeze, "data")),
    @native/try_call("copied", result, "value_list", ["worker", "source", "length"], [native/return_zero()]),
    native/let_field("updated", word, "copied", "value"),
    native/let_statement("target", [:Pointer, header, :Mutable], native/unary_expression(:UnpackPointer, "updated")),
    native/set_statement("header", native/load_expression("target")),
    native/set_statement("data", native/field_expression("header", "data")),
    native/let_offset("slot", values, "data", "index"),
    native/store_statement("slot", "element"),
    native/return_value("copied")
  ])
  context = native/declare_function(context, "value_list_append", result, [worker, ["value", word, :Gc],
    ["element", word, :Gc]], [], [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, "value_list_append", [
    @read,
    native/let_field("storage", [:Pointer, [:Record, "ListStorage"], :Mutable], "header", "storage"),
    native/let_load("backing", [:Record, "ListStorage"], "storage"),
    native/let_field("base", values, "backing", "data"),
    native/let_field("used", :U64, "backing", "used"),
    native/let_field("capacity", :U64, "backing", "capacity"),
    native/let_offset("end", values, "data", "length"),
    native/let_offset("tail", values, "base", "used"),
    native/let_statement("reuse", :Bool, "false"),
    native/when_statement(
      native/binary_expression(:Equal, "end", "tail"),
      [native/set_statement("reuse", native/binary_expression(:Less, "used", "capacity"))]
    ),
    native/let_statement("total", :U64, native/binary_expression(:Add, "length", "one")),
    native/unless_statement(native/call_expression("value_storage_private", [
      native/typed_expression([:Pointer, :U8, :Mutable], native/unary_expression(:PointerCast, "storage")),
      native/typed_expression(:U64, native/unary_expression(:SizeOf, header))]), [native/set_statement("reuse", "false")]),
    native/if_statement("reuse", [
      @native_memory/allocate_record("target", header, "layout_list_view", [native/return_zero()]),
      native/store_statement("tail", "element"),
      native/let_statement("used_slot", [:Pointer, :U64, :Mutable], native/field_pointer_expression("storage", "used")),
      native/store_statement("used_slot", native/typed_expression(:U64, native/binary_expression(:Add, "used", "one")))
    ], [
      native/set_statement("capacity", native/binary_expression(:Add, "total", "total")),
      native/set_statement("target", native/call_expression("list_allocate", ["worker", "total", "capacity"])),
      native/when_statement(native/binary_expression(:Equal, "target", "null_list_header"), [
        native/set_statement("target", native/call_expression("list_allocate", ["worker", "total", "total"])),
        native/when_statement(native/binary_expression(:Equal, "target", "null_list_header"), [native/return_zero()])
      ]),
      native/let_load("new_header", header, "target"),
      native/let_field("destination", values, "new_header", "data"),
      @native/copy_elements(word, "destination", "data", "length", :Mutable),
      native/set_statement("tail", native/offset_expression("destination", "length")),
      native/store_statement("tail", "element"),
      native/set_statement("data", "destination"),
      native/set_statement("storage", native/field_expression("new_header", "storage"))
    ]),
    native/note_statement(
      :Invariant,
      "Tail writes are outside existing views and require worker-private storage."
    ),
    native/store_statement("target", native/typed_record(header, ["data", "total", "storage"])),
    native/return_record(
      ["true", native/typed_expression(word, native/binary_expression(:PackPointer, "target", "tag_list"))]
    )
  ])
  return context
end

verb native_value/map_update(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let header: list = [:Record, "HeapMap"]
  let entry: list = [:Record, "ValueMapEntry"]
  let entries: list = [:Pointer, entry, :Mutable]
  context = native/declare_function(context, "value_map_set", [:Record, "ValueResult"], [
    ["worker", [:Pointer, [:Record, "MemoryWorker"], :Mutable], :Borrow],
    ["value", word, :Gc], ["key", word, :Gc],
    ["element", word, :Gc]], [], [:Allocate, :ReadMemory, :WriteMemory], :Gc, "")
  context = native/define_function(context, "value_map_set", [
    @native_value/open_heap("value", "map", header, "pointer", "header", [native/return_zero()]),
    native/let_field("data", entries, "header", "data"),
    native/let_field("length", :U64, "header", "length"),
    native/let_statement("low", :U64, "zero"),
    native/let_statement("high", :U64, "length"),
    native/let_statement("replace", :Bool, "false"),
    native/while_statement(native/binary_expression(:Less, "low", "high"), [
      native/let_statement("distance", :U64, native/binary_expression(:Subtract, "high", "low")),
      native/set_statement("distance", native/binary_expression(:Divide, "distance", "two")),
      native/let_statement("middle", :U64, native/binary_expression(:Add, "low", "distance")),
      native/let_offset("slot", entries, "data", "middle"),
      native/let_load("candidate", entry, "slot"),
      @native/try_call("comparison", [:Record, "IntResult"], "value_compare", [native/typed_field(word, "candidate", "key"), "key"], [native/return_zero()]),
      native/let_field("order", :I64, "comparison", "number"),
      native/when_statement(native/binary_expression(:Equal, "order", "int_zero"), [
        native/set_statement("low", "middle"),
        native/set_statement("replace", "true"),
        native/break_statement()
      ]),
      native/if_statement(
        native/binary_expression(:Less, "order", "int_zero"),
        [native/set_statement("low", native/binary_expression(:Add, "middle", "one"))],
        [native/set_statement("high", "middle")]
      )
    ]),
    native/let_statement("count", :U64, "length"),
    native/unless_statement("replace", [native/set_statement("count", native/binary_expression(:Add, "count", "one"))]),
    native/let_statement("header_size", :U64, native/unary_expression(:SizeOf, header)),
    native/let_statement("entry_size", :U64, native/unary_expression(:SizeOf, entry)),
    @native_memory/allocate_with_tail("raw", "header_size", "entry_size", "count", "layout_map", [native/return_zero()]),
    native/let_statement("target", [:Pointer, header, :Mutable], native/unary_expression(:PointerCast, "raw")),
    native/let_offset("raw_data", [:Pointer, :U8, :Mutable], "raw", "header_size"),
    native/let_statement("destination", entries, native/unary_expression(:PointerCast, "raw_data")),
    native/let_statement("i", :U64, "zero"),
    native/let_statement("read", :U64, "zero"),
    native/while_statement(native/binary_expression(:Less, "i", "count"), [
      native/let_statement("output", entry, native/record_expression(["key", "element"])),
      native/if_statement(native/binary_expression(:Equal, "i", "low"), [
        native/when_statement("replace", [native/set_statement("read", native/binary_expression(:Add, "read", "one"))])
      ], [
        native/set_statement("slot", native/offset_expression("data", "read")),
        native/set_statement("output", native/load_expression("slot")),
        native/set_statement("read", native/binary_expression(:Add, "read", "one"))
      ]),
      native/let_offset("dst", entries, "destination", "i"),
      native/store_statement("dst", "output"),
      native/set_statement("i", native/binary_expression(:Add, "i", "one"))
    ]),
    native/store_statement("target", native/typed_record(header, ["destination", "count"])),
    native/return_record(
      ["true", native/typed_expression(word, native/binary_expression(:PackPointer, "target", "tag_map"))]
    )
  ])
  return context
end
