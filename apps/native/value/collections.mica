// List views share immutable prefixes. Mutating an arena, including claiming a
// list's unused tail, requires serialization just as string append does.
verb native_value/collections(input: map) -> map
  let context: map = input
  context = native_value/list_allocation(context)
  context = native_value/list_operations(context)
  context = native_value/map_update(context)
  return context
end

verb native_value/list_allocation(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let header: list = [:Record, "HeapList"]
  let storage: list = [:Record, "ListStorage"]
  let pointer: list = [:Pointer, header, :Mutable]
  let values: list = [:Pointer, word, :Mutable]
  let [constants, state] = native/constants(context[:state], [
    ["null_list_header", pointer, "null"],
    ["null_values", [:Pointer, word, :Const], "null"]])
  context[:state] = state
  let bindings: map = context[:constants]
  for name, id in constants
    bindings[name] = id
  end
  context[:constants] = bindings
  context = native/declare_function(context, "list_allocate", pointer, [
    ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow],
    ["length", :U64, :Value], ["capacity", :U64, :Value]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native/define_function(context, "list_allocate", [
    [:If, [:Less, "capacity", "length"], [[:Return, "null_list_header"]], []],
    [:Let, "header_size", :U64, [:SizeOf, header]],
    [:Let, "storage_size", :U64, [:SizeOf, storage]],
    [:Let, "prefix", :U64, [:Add, "header_size", "storage_size"]],
    [:Let, "element_size", :U64, [:SizeOf, word]],
    [:Let, "limit", :U64, [:Subtract, "allocation_limit", "prefix"]],
    [:Set, "limit", [:Divide, "limit", "element_size"]],
    [:If, [:Less, "limit", "capacity"], [[:Return, "null_list_header"]], []],
    [:Let, "bytes", :U64, [:Multiply, "capacity", "element_size"]],
    [:Let, "total", :U64, [:Add, "prefix", "bytes"]],
    [:Let, "raw", [:Pointer, :U8, :Mutable], [:Call, "value_arena_allocate", "arena", "total"]],
    [:If, [:Equal, "raw", "null_bytes"], [[:Return, "null_list_header"]], []],
    [:Let, "target", pointer, [:PointerCast, "raw"]],
    [:Let, "storage_raw", [:Pointer, :U8, :Mutable], [:Offset, "raw", "header_size"]],
    [:Let, "backing", [:Pointer, storage, :Mutable], [:PointerCast, "storage_raw"]],
    [:Let, "data_raw", [:Pointer, :U8, :Mutable], [:Offset, "raw", "prefix"]],
    [:Let, "data", values, [:PointerCast, "data_raw"]],
    [:Do, [:Store, "backing", [:Expr, storage, [:Record, "data", "length", "capacity"]]]],
    [:Do, [:Store, "target", [:Expr, header, [:Record, "data", "length", "backing"]]]],
    [:Return, "target"]])
  context = native/declare_function(context, "value_list", [:Record, "ValueResult"], [
    ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow],
    ["source", [:Pointer, word, :Const], [:Borrow, "arena"]], ["length", :U64, :Value]], [],
    [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native/define_function(context, "value_list", [
    [:If, [:Equal, "length", "zero"], [], [
      [:If, [:Equal, "source", "null_values"], [[:Return, [:Zero]]], []]]],
    [:Let, "target", pointer, [:Call, "list_allocate", "arena", "length", "length"]],
    [:If, [:Equal, "target", "null_list_header"], [[:Return, [:Zero]]], []],
    [:Let, "header", header, [:Load, "target"]],
    [:Let, "data", values, [:Field, "header", "data"]],
    [:Let, "i", :U64, "zero"],
    [:While, [:Less, "i", "length"], [
      [:Let, "src", [:Pointer, word, :Const], [:Offset, "source", "i"]],
      [:Let, "dst", values, [:Offset, "data", "i"]],
      [:Do, [:Store, "dst", [:Expr, word, [:Load, "src"]]]],
      [:Set, "i", [:Add, "i", "one"]]]],
    [:Return, [:Record, "true", [:Expr, word, [:PackPointer, "target", "tag_list"]]]]])
  return context
end

verb native_value/list_operations(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let header: list = [:Record, "HeapList"]
  let values: list = [:Pointer, word, :Mutable]
  let result: list = [:Record, "ValueResult"]
  let arena: list = ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow]
  for kind in ["list", "map"]
    let record: list = [:Record, "HeapList"]
    if kind == "map"
      record = [:Record, "HeapMap"]
    end
    let name: string = string_concat("value_", kind, "_length")
    context = native/declare_function(context, name, [:Record, "IdResult"], [["value", word, :Borrow]], [], [:ReadMemory], :Value, "")
    context = native/define_function(context, name, [
      [:If, [:Equal, [:Expr, :U8, [:Tag, "value"]], string_concat("tag_", kind)], [], [[:Return, [:Zero]]]],
      [:Let, "pointer", [:Pointer, record, :Const], [:UnpackPointer, "value"]],
      [:Let, "header", record, [:Load, "pointer"]],
      [:Return, [:Record, "true", [:Expr, :U64, [:Field, "header", "length"]]]]])
  end
  let read: list = [
    [:If, [:Equal, [:Expr, :U8, [:Tag, "value"]], "tag_list"], [], [[:Return, [:Zero]]]],
    [:Let, "pointer", [:Pointer, header, :Const], [:UnpackPointer, "value"]],
    [:Let, "header", header, [:Load, "pointer"]],
    [:Let, "data", values, [:Field, "header", "data"]],
    [:Let, "length", :U64, [:Field, "header", "length"]]]
  context = native/declare_function(context, "value_list_get", result, [["value", word, :Borrow], ["index", :U64, :Value]], [], [:ReadMemory], :Borrow, "value")
  context = native/define_function(context, "value_list_get", [@read,
    [:If, [:Less, "index", "length"], [], [[:Return, [:Zero]]]],
    [:Let, "slot", values, [:Offset, "data", "index"]],
    [:Return, [:Record, "true", [:Expr, word, [:Load, "slot"]]]]])
  context = native/declare_function(context, "value_list_slice", result, [arena, ["value", word, [:Borrow, "arena"]],
    ["start", :U64, :Value], ["end", :U64, :Value]], [], [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native/define_function(context, "value_list_slice", [@read,
    [:If, [:Less, "end", "start"], [[:Return, [:Zero]]], []],
    [:If, [:Less, "length", "end"], [[:Return, [:Zero]]], []],
    [:Let, "size", :U64, [:SizeOf, header]],
    [:Let, "raw", [:Pointer, :U8, :Mutable], [:Call, "value_arena_allocate", "arena", "size"]],
    [:If, [:Equal, "raw", "null_bytes"], [[:Return, [:Zero]]], []],
    [:Let, "target", [:Pointer, header, :Mutable], [:PointerCast, "raw"]],
    [:Set, "data", [:Offset, "data", "start"]],
    [:Set, "length", [:Subtract, "end", "start"]],
    [:Let, "storage", [:Pointer, [:Record, "ListStorage"], :Mutable], [:Field, "header", "storage"]],
    [:Do, [:Store, "target", [:Expr, header, [:Record, "data", "length", "storage"]]]],
    [:Return, [:Record, "true", [:Expr, word, [:PackPointer, "target", "tag_list"]]]]])
  context = native/declare_function(context, "value_list_set", result, [arena, ["value", word, [:Borrow, "arena"]],
    ["index", :U64, :Value], ["element", word, [:Borrow, "arena"]]], [], [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native/define_function(context, "value_list_set", [@read,
    [:If, [:Less, "index", "length"], [], [[:Return, [:Zero]]]],
    [:Let, "source", [:Pointer, word, :Const], [:Freeze, "data"]],
    [:Let, "copied", result, [:Call, "value_list", "arena", "source", "length"]],
    [:If, [:Field, "copied", "ok"], [], [[:Return, [:Zero]]]],
    [:Let, "updated", word, [:Field, "copied", "value"]],
    [:Let, "target", [:Pointer, header, :Mutable], [:UnpackPointer, "updated"]],
    [:Set, "header", [:Load, "target"]],
    [:Set, "data", [:Field, "header", "data"]],
    [:Let, "slot", values, [:Offset, "data", "index"]],
    [:Do, [:Store, "slot", "element"]], [:Return, "copied"]])
  context = native/declare_function(context, "value_list_append", result, [arena, ["value", word, [:Borrow, "arena"]],
    ["element", word, [:Borrow, "arena"]]], [], [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native/define_function(context, "value_list_append", [@read,
    [:Let, "storage", [:Pointer, [:Record, "ListStorage"], :Mutable], [:Field, "header", "storage"]],
    [:Let, "backing", [:Record, "ListStorage"], [:Load, "storage"]],
    [:Let, "base", values, [:Field, "backing", "data"]],
    [:Let, "used", :U64, [:Field, "backing", "used"]],
    [:Let, "capacity", :U64, [:Field, "backing", "capacity"]],
    [:Let, "end", values, [:Offset, "data", "length"]],
    [:Let, "tail", values, [:Offset, "base", "used"]],
    [:Let, "reuse", :Bool, "false"],
    [:If, [:Equal, "end", "tail"], [[:Set, "reuse", [:Less, "used", "capacity"]]], []],
    [:Let, "total", :U64, [:Add, "length", "one"]],
    [:If, "reuse", [
      [:Let, "size", :U64, [:SizeOf, header]],
      [:Let, "raw", [:Pointer, :U8, :Mutable], [:Call, "value_arena_allocate", "arena", "size"]],
      [:If, [:Equal, "raw", "null_bytes"], [[:Return, [:Zero]]], []],
      [:Let, "target", [:Pointer, header, :Mutable], [:PointerCast, "raw"]],
      [:Do, [:Store, "tail", "element"]],
      [:Let, "used_slot", [:Pointer, :U64, :Mutable], [:FieldPointer, "storage", "used"]],
      [:Do, [:Store, "used_slot", [:Expr, :U64, [:Add, "used", "one"]]]]
    ], [
      [:Set, "capacity", [:Add, "total", "total"]],
      [:Set, "target", [:Call, "list_allocate", "arena", "total", "capacity"]],
      [:If, [:Equal, "target", "null_list_header"], [
        [:Set, "target", [:Call, "list_allocate", "arena", "total", "total"]],
        [:If, [:Equal, "target", "null_list_header"], [[:Return, [:Zero]]], []]], []],
      [:Let, "new_header", header, [:Load, "target"]],
      [:Let, "destination", values, [:Field, "new_header", "data"]],
      [:Let, "i", :U64, "zero"],
      [:While, [:Less, "i", "length"], [
        [:Let, "src", values, [:Offset, "data", "i"]],
        [:Let, "dst", values, [:Offset, "destination", "i"]],
        [:Do, [:Store, "dst", [:Expr, word, [:Load, "src"]]]],
        [:Set, "i", [:Add, "i", "one"]]]],
      [:Set, "tail", [:Offset, "destination", "length"]],
      [:Do, [:Store, "tail", "element"]],
      [:Set, "data", "destination"],
      [:Set, "storage", [:Field, "new_header", "storage"]]
    ]],
    [:Note, :Invariant, "Tail writes are outside every published view. Nested values retain the arena lifetime."],
    [:Do, [:Store, "target", [:Expr, header, [:Record, "data", "total", "storage"]]]],
    [:Return, [:Record, "true", [:Expr, word, [:PackPointer, "target", "tag_list"]]]]])
  return context
end

verb native_value/map_update(input: map) -> map
  let context: map = input
  let word: list = native_value/word()
  let header: list = [:Record, "HeapMap"]
  let entry: list = [:Record, "ValueMapEntry"]
  let entries: list = [:Pointer, entry, :Mutable]
  context = native/declare_function(context, "value_map_set", [:Record, "ValueResult"], [
    ["arena", [:Pointer, [:Record, "ValueArena"], :Mutable], :Borrow],
    ["value", word, [:Borrow, "arena"]], ["key", word, [:Borrow, "arena"]],
    ["element", word, [:Borrow, "arena"]]], [], [:Allocate, :ReadMemory, :WriteMemory], :Borrow, "arena")
  context = native/define_function(context, "value_map_set", [
    [:If, [:Equal, [:Expr, :U8, [:Tag, "value"]], "tag_map"], [], [[:Return, [:Zero]]]],
    [:Let, "pointer", [:Pointer, header, :Const], [:UnpackPointer, "value"]],
    [:Let, "header", header, [:Load, "pointer"]],
    [:Let, "data", entries, [:Field, "header", "data"]],
    [:Let, "length", :U64, [:Field, "header", "length"]],
    [:Let, "low", :U64, "zero"], [:Let, "high", :U64, "length"],
    [:Let, "replace", :Bool, "false"],
    [:While, [:Less, "low", "high"], [
      [:Let, "distance", :U64, [:Subtract, "high", "low"]],
      [:Set, "distance", [:Divide, "distance", "two"]],
      [:Let, "middle", :U64, [:Add, "low", "distance"]],
      [:Let, "slot", entries, [:Offset, "data", "middle"]],
      [:Let, "candidate", entry, [:Load, "slot"]],
      [:Let, "comparison", [:Record, "IntResult"], [:Call, "value_compare", [:Expr, word, [:Field, "candidate", "key"]], "key"]],
      [:If, [:Field, "comparison", "ok"], [], [[:Return, [:Zero]]]],
      [:Let, "order", :I64, [:Field, "comparison", "number"]],
      [:If, [:Equal, "order", "int_zero"], [[:Set, "low", "middle"], [:Set, "replace", "true"], [:Break]], []],
      [:If, [:Less, "order", "int_zero"], [[:Set, "low", [:Add, "middle", "one"]]], [[:Set, "high", "middle"]]]
    ]],
    [:Let, "count", :U64, "length"],
    [:If, "replace", [], [[:Set, "count", [:Add, "count", "one"]]]],
    [:Let, "header_size", :U64, [:SizeOf, header]],
    [:Let, "entry_size", :U64, [:SizeOf, entry]],
    [:Let, "limit", :U64, [:Subtract, "allocation_limit", "header_size"]],
    [:Set, "limit", [:Divide, "limit", "entry_size"]],
    [:If, [:Less, "limit", "count"], [[:Return, [:Zero]]], []],
    [:Let, "bytes", :U64, [:Multiply, "count", "entry_size"]],
    [:Let, "total", :U64, [:Add, "header_size", "bytes"]],
    [:Let, "raw", [:Pointer, :U8, :Mutable], [:Call, "value_arena_allocate", "arena", "total"]],
    [:If, [:Equal, "raw", "null_bytes"], [[:Return, [:Zero]]], []],
    [:Let, "target", [:Pointer, header, :Mutable], [:PointerCast, "raw"]],
    [:Let, "raw_data", [:Pointer, :U8, :Mutable], [:Offset, "raw", "header_size"]],
    [:Let, "destination", entries, [:PointerCast, "raw_data"]],
    [:Let, "i", :U64, "zero"], [:Let, "read", :U64, "zero"],
    [:While, [:Less, "i", "count"], [
      [:Let, "output", entry, [:Record, "key", "element"]],
      [:If, [:Equal, "i", "low"], [
        [:If, "replace", [[:Set, "read", [:Add, "read", "one"]]], []]
      ], [
        [:Set, "slot", [:Offset, "data", "read"]],
        [:Set, "output", [:Load, "slot"]],
        [:Set, "read", [:Add, "read", "one"]]
      ]],
      [:Let, "dst", entries, [:Offset, "destination", "i"]],
      [:Do, [:Store, "dst", "output"]],
      [:Set, "i", [:Add, "i", "one"]]
    ]],
    [:Do, [:Store, "target", [:Expr, header, [:Record, "destination", "count"]]]],
    [:Return, [:Record, "true", [:Expr, word, [:PackPointer, "target", "tag_map"]]]]])
  return context
end
