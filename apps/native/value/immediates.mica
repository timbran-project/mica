verb native_value/immediates(input: map) -> map
  let context: map = input
  let word = native_value/word()
  let result = [:Record, "ValueResult"]
  let failure: list = [native/return_zero()]
  context = native/declare_function(context, "value_empty_relation", word, [], [], [], :Immediate, "")
  context = native/define_function(context, "value_empty_relation", [native/return_zero()])
  context = native/declare_function(context, "value_tag", :U8, [["value", word, :Borrow]], [], [], :Value, "")
  context = native/define_function(context, "value_tag", [native/return_value(native/unary_expression(:Tag, "value"))])
  context = native/declare_function(context, "value_kind", :U8, [["value", word, :Borrow]], [], [], :Value, "")
  context = native/define_function(context, "value_kind", [
    native/let_statement("tag", :U8, native/unary_expression(:Tag, "value")),
    native/when_statement(native/binary_expression(:Equal, "tag", "zero_tag"), [native/return_value("tag_relation")]),
    native/return_value("tag")
  ])
  context = native/declare_function(context, "value_bool", word, [["input", :Bool, :Value]], [], [], :Immediate, "")
  context = native/define_function(
    context,
    "value_bool",
    [
      native/if_statement(
        "input",
        [native/return_value(native/binary_expression(:PackImmediate, "one", "tag_bool"))],
        [native/return_value(native/binary_expression(:PackImmediate, "zero", "tag_bool"))]
      )
    ]
  )
  context = native/declare_function(context, "value_int", result, [["input", :I64, :Value]], [], [], :Immediate, "")
  context = native/define_function(context, "value_int", [
    native/note_statement(:Invariant, "Signed integer payloads fit 56 bits."),
    native/when_statement(native/binary_expression(:Less, "input", "int_min"), failure),
    native/when_statement(native/binary_expression(:Less, "int_max", "input"), failure),
    native/let_statement("bits", :U64, native/unary_expression(:Convert, "input")),
    native/let_statement("payload", :U64, native/binary_expression(:BitAnd, "bits", "payload_mask")),
    native/return_record(
      ["true", native/typed_expression(word, native/binary_expression(:PackImmediate, "payload", "tag_int"))]
    )
  ])
  context = native/declare_function(context, "value_float", result, [["input", :F32, :Value]], [["bits", :U32]], [], :Immediate, "")
  context = native/define_function(context, "value_float", [
    native/note_statement(:Invariant, "Float values are finite binary32; both zero signs encode positive zero."),
    native/unless_statement(native/unary_expression(:IsFinite, "input"), failure),
    native/if_statement(
      native/binary_expression(:Equal, "input", "float_zero"),
      [native/set_statement("bits", "u32_zero")],
      [native/set_statement("bits", native/unary_expression(:Bitcast, "input"))]
    ),
    native/let_statement("payload", :U64, native/unary_expression(:Convert, "bits")),
    native/return_record(
      ["true", native/typed_expression(word, native/binary_expression(:PackImmediate, "payload", "tag_float"))]
    )
  ])
  context = native/declare_function(context, "value_float_from_bits", result, [["bits", :U32, :Value]], [], [], :Immediate, "")
  context = native/define_function(
    context,
    "value_float_from_bits",
    [
      native/return_value(
        native/call_expression(
          "value_float",
          [native/typed_expression(:F32, native/unary_expression(:Bitcast, "bits"))]
        )
      )
    ]
  )
  for name in ["identity", "capability", "function", "symbol", "error_code"]
    context = native_value/id_constructor(context, name)
  end
  for spec in [["int", :I64, "IntResult"], ["float", :F32, "FloatResult"], ["bool", :Bool, "BoolResult"],
               ["identity", :U64, "IdResult"], ["capability", :U64, "IdResult"], ["function", :U64, "IdResult"],
               ["symbol", :U64, "IdResult"], ["error_code", :U64, "IdResult"]]
    context = native_value/immediate_accessor(context, spec)
  end
  return context
end

verb native_value/id_constructor(input: map, kind: string) -> map
  let context: map = input
  let name = string_concat("value_", kind)
  let source = :U64
  if kind == "symbol" || kind == "error_code"
    source = :U32
  end
  let word = native_value/word()
  let result = [:Record, "ValueResult"]
  context = native/declare_function(context, name, result, [["input", source, :Value]], [], [], :Immediate, "")
  let statements: list = [
    native/let_statement("payload", :U64, native/unary_expression(:Convert, "input")),
    native/when_statement(native/binary_expression(:Less, "payload_mask", "payload"), [native/return_zero()])
  ]
  if kind == "capability"
    statements = [
      @statements,
      native/when_statement(native/binary_expression(:Equal, "payload", "zero"), [native/return_zero()])
    ]
  end
  context = native/define_function(context, name, [
    @statements,
    native/return_record(
      [
        "true",
        native/typed_expression(word, native/binary_expression(:PackImmediate, "payload", string_concat("tag_", kind)))
      ]
    )
  ])
  return context
end

verb native_value/immediate_accessor(input: map, spec: list) -> map
  let context: map = input
  let name = string_concat("value_as_", spec[0])
  let result = [:Record, spec[2]]
  context = native/declare_function(context, name, result, [["value", native_value/word(), :Borrow]], [], [], :Value, "")
  let statements: list = [
    native/let_statement("tag", :U8, native/unary_expression(:Tag, "value")),
    native/unless_statement(
      native/binary_expression(:Equal, "tag", string_concat("tag_", spec[0])),
      [native/return_zero()]
    ),
    native/let_statement("payload", :U64, native/unary_expression(:Payload, "value"))
  ]
  if spec[0] == "bool"
    context = native/define_function(context, name, [
      @statements,
      native/if_statement(
        native/binary_expression(:Equal, "payload", "zero"),
        [native/return_record(["true", "false"])],
        [native/return_record(["true", "true"])]
      )
    ])
    return context
  end
  let expression = "payload"
  if spec[0] == "int"
    statements = [
      @statements,
      native/note_statement(:Purpose, "Unsigned xor/subtract sign-extends the payload without signed overflow."),
      native/let_statement("sign", :U64, native/binary_expression(:BitXor, "payload", "sign_bit")),
      native/let_statement("bits", :U64, native/binary_expression(:Subtract, "sign", "sign_bit"))
    ]
    expression = native/unary_expression(:Bitcast, "bits")
  end
  if spec[0] == "float"
    statements = [
      @statements,
      native/let_statement("bits", :U32, native/unary_expression(:Convert, "payload"))
    ]
    expression = native/unary_expression(:Bitcast, "bits")
  end
  context = native/define_function(context, name, [
    @statements,
    native/let_statement("number", spec[1], expression),
    native/return_record(["true", "number"])
  ])
  return context
end
