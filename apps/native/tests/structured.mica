verb native/structured_example(first_id)
  let state = native/program()
  state[:next] = first_id
  let [constants, with_constants] = native/constants(state, [
    ["zero", :U64, "0000000000000000"], ["one", :U64, "0000000000000001"],
    ["two", :U64, "0000000000000002"], ["three", :U64, "0000000000000003"],
    ["ten", :U64, "000000000000000a"]])
  let [sum, bindings, declared] = native/function_scope(with_constants, "structured_sum", :U64, [["limit", :U64, :Value]], [], [])
  for name, id in constants
    bindings[name] = id
  end
  state = native/annotate(declared, sum, :Source, "apps/native/tests/structured.mica: native/structured_example")
  state = native/annotate(state, sum, :Purpose, "Skip three and stop before ten.")
  state = native/function_body(state, sum, bindings, [
    [:Let, "sum", :U64, "zero"], [:Let, "i", :U64, "zero"],
    [:While, [:Less, "i", "limit"], [
      [:Set, "i", [:Add, "i", "one"]],
      [:If, [:Equal, "i", "three"], [[:Continue]], []],
      [:If, [:Equal, "i", "ten"], [[:Break]], []],
      [:Set, "sum", [:Add, "sum", "i"]]]],
    [:Return, "sum"]])
  let [nested, nested_names, nested_state] = native/function_scope(state, "structured_nested", :U64, [["limit", :U64, :Value]], [], [])
  for name, id in constants
    nested_names[name] = id
  end
  state = native/function_body(nested_state, nested, nested_names, [
    [:Let, "sum", :U64, "zero"], [:Let, "i", :U64, "zero"],
    [:While, [:Less, "i", "limit"], [
      [:Set, "i", [:Add, "i", "one"]], [:Let, "j", :U64, "zero"],
      [:While, [:Less, "j", "limit"], [
        [:Set, "j", [:Add, "j", "one"]],
        [:If, [:Equal, "j", "three"], [[:Break]], []],
        [:If, [:Equal, "j", "one"], [[:Continue]], []],
        [:Set, "sum", [:Add, "sum", "one"]]]]]], [:Return, "sum"]])
  let [both, choice_names, choice_state] = native/function_scope(state, "structured_choice", :U64, [["choice", :Bool, :Value]], [], [])
  for name, id in constants
    choice_names[name] = id
  end
  state = native/function_body(choice_state, both, choice_names, [[:If, "choice", [[:Return, "one"]], [[:Return, "two"]]]])
  let [tick, tick_state] = native/add_function(state, "structured_tick", :U64)
  state = native/contract(native/foreign(tick_state, tick), tick, [:WriteMemory], :Value, "")
  let [order, order_names, order_state] = native/function_scope(state, "structured_order", :U64, [], [], [])
  order_names["tick"] = tick
  state = native/contract(order_state, order, [:WriteMemory], :Value, "")
  state = native/function_body(state, order, order_names, [
    [:Note, :Invariant, "Nested calls execute left to right."],
    [:Return, [:Subtract, [:Expr, :U64, [:Call, "tick"]], [:Expr, :U64, [:Call, "tick"]]]]])
  let [zero, zero_names, zero_state] = native/function_scope(state, "structured_zero", :U64, [["choice", :Bool, :Value]], [], [])
  zero_names["tick"] = tick
  state = native/contract(zero_state, zero, [:WriteMemory], :Value, "")
  state = native/function_body(state, zero, zero_names, [
    [:If, "choice", [[:Let, "first_tick", :U64, [:Call, "tick"]], [:Return, [:Zero]]], []],
    [:Let, "second_tick", :U64, [:Call, "tick"]], [:Return, [:Zero]]])
  let [empty, empty_names, empty_state] = native/function_scope(state, "structured_void", :Void, [], [], [])
  state = native/function_body(empty_state, empty, empty_names, [[:Return]])
  // This text must remain a comment, even after C preprocessing.
  state = native/annotate(state, empty, :Purpose, "*/\n#error injected\n/* ??/\\\r\n\0")
  return native/control_examples(state, constants, tick)
end

verb native/control_examples(state: map, constants: map, tick: int) -> map
  let context: map = native/module_context(state, constants)
  let functions: map = context[:functions]
  functions["tick"] = tick
  context[:functions] = functions
  for name in ["dispatch", "loop_switch", "ladder"]
    context = native/declare_function(context, string_concat("structured_", name), :U64, [["limit", :U64, :Value]], [], [], :Value, "")
  end
  context = native/declare_function(context, "structured_tick_switch", :U64, [], [], [:WriteMemory], :Value, "")
  context = native/declare_function(context, "structured_shared_tail", :U64, [["limit", :U64, :Value]], [], [:WriteMemory], :Value, "")
  let cases: list = []
  for name in ["one", "two", "three"]
    cases = [@cases, native/case_arm(name, [native/set_statement("result", name)])]
  end
  context = native/define_function(context, "structured_dispatch", [
    native/let_statement("result", :U64, "zero"),
    native/switch_statement(:U64, "limit", cases, [native/set_statement("result", "ten")]),
    native/return_value("result")])
  context = native/define_function(context, "structured_ladder", [
    native/let_statement("result", :U64, "zero"),
    native/if_statement(native/binary_expression(:Less, "limit", "one"), [native/set_statement("result", "one")], [
      native/if_statement(native/binary_expression(:Less, "limit", "two"), [native/set_statement("result", "two")], [native/set_statement("result", "three")])]),
    native/set_statement("result", native/binary_expression(:Add, "result", "ten")), native/return_value("result")])
  context = native/define_function(context, "structured_shared_tail", [
    native/let_statement("result", :U64, "zero"),
    native/if_statement(native/binary_expression(:Less, "limit", "two"), [native/set_statement("result", "one")], [
      native/if_statement(native/binary_expression(:Less, "limit", "three"), [native/return_value("zero")], []),
      native/set_statement("result", "two")]),
    native/let_statement("observed", :U64, native/call_expression("tick", [])),
    native/set_statement("result", native/binary_expression(:Add, "result", "ten")), native/return_value("result")])
  context = native/define_function(context, "structured_tick_switch", [
    native/switch_statement(:U64, native/call_expression("tick", []), [
      native/case_arm("one", [native/return_value("ten")]),
      native/case_arm("two", [native/return_value("two")]),
      native/case_arm("three", [native/return_value("three")])], [native/return_value("zero")])])
  context = native/define_function(context, "structured_loop_switch", [
    native/let_statement("i", :U64, "zero"), native/let_statement("total", :U64, "zero"),
    native/while_statement(native/binary_expression(:Less, "i", "limit"), [
      native/set_statement("i", native/binary_expression(:Add, "i", "one")),
      native/switch_statement(:U64, "i", [
        native/case_arm("one", [[:Continue]]),
        native/case_arm("two", [native/set_statement("total", native/binary_expression(:Add, "total", "ten"))]),
        native/case_arm("three", [[:Break]])], [native/set_statement("total", native/binary_expression(:Add, "total", "one"))]),
      native/set_statement("total", native/binary_expression(:Add, "total", "one"))]), native/return_value("total")])
  context = native/declare_function(context, "structured_guards", :U64, [["limit", :U64, :Value]], [], [:WriteMemory], :Value, "")
  context = native/define_function(context, "structured_guards", [
    [:If, [:Less, "one", "limit"], [
      [:If, [:Less, "two", "limit"], [
        [:Let, "first", :U64, [:Call, "tick"]], [:Let, "second", :U64, [:Call, "tick"]],
        [:Return, [:Add, "first", "second"]]], [[:Return, "one"]]]], [[:Return, "zero"]]]])
  context = native/declare_function(context, "structured_guard_effects", :U64, [["choice", :Bool, :Value]], [], [:WriteMemory], :Value, "")
  context = native/define_function(context, "structured_guard_effects", [
    [:If, "choice", [
      [:Let, "first", :U64, [:Call, "tick"]], [:Let, "second", :U64, [:Call, "tick"]],
      [:Let, "third", :U64, [:Call, "tick"]], [:Return, [:Subtract, "third", [:Expr, :U64, [:Add, "first", "second"]]]]],
      [[:Return, [:Call, "tick"]]]]])
  for name in ["cycle_a", "cycle_b"]
    context = native/declare_function(context, name, :U64, [["n", :U64, :Value]], [], [], :Value, "")
  end
  for spec in [["cycle_a", "cycle_b", "one"], ["cycle_b", "cycle_a", "two"]]
    context = native/define_function(context, spec[0], [
      native/if_statement(native/binary_expression(:Equal, "n", "zero"), [native/return_value(spec[2])], []),
      native/return_value(native/call_expression(spec[1], [native/typed_expression(:U64, native/binary_expression(:Subtract, "n", "one"))]))])
  end
  // This two-entry cycle cannot become a natural loop without duplicating
  // code or adding a dispatch variable. Keep its explicit transfers.
  let [id, names, declared] = native/function_scope(context[:state], "irreducible", :U64,
    [["limit", :U64, :Value], ["choice", :Bool, :Value]], [["i", :U64], ["condition", :Bool]], ["entry", "left", "right", "done"])
  let result: map = native/block_body(declared, names["entry"], [[:Copy, names["i"], [constants["zero"]]]], :Branch, [names["choice"], names["left"], names["right"]])
  for spec in [["left", "right"], ["right", "left"]]
    result = native/block_body(result, names[spec[0]], [
      [:Add, names["i"], [names["i"], constants["one"]]],
      [:Less, names["condition"], [names["i"], names["limit"]]]], :Branch, [names["condition"], names[spec[1]], names["done"]])
  end
  result = native/terminate(result, names["done"], :Return, [names["i"]])
  result = native/scope_examples(result, constants, tick)
  result = native/semantic_examples(result, constants, tick)
  return result
end

verb native/semantic_examples(input: map, constants: map, tick: int) -> map
  let state: map = input
  let pair: list = ["BuilderPair", [["left", :U64], ["right", :U64]]]
  let node_pointer: list = [:Pointer, [:Record, "BuilderNode"], :Mutable]
  let node: list = ["BuilderNode", [["next", node_pointer], ["value", :U64]]]
  for schema in [pair, node]
    state = native/record_type(state, schema[0], schema[1])[1]
  end
  let [extra, declared] = native/constants(state, [["true", :Bool, "true"]])
  let bindings: map = constants
  bindings["true"] = extra["true"]
  let context: map = native/module_context(declared, bindings)
  context[:functions] = {"tick" -> tick}
  for name in ["semantic_range", "semantic_first"]
    context = native/declare_function(context, name, :U64, [["limit", :U64, :Value]], [], [], :Value, "")
  end
  context = native/define_function(context, "semantic_range", [
    native/let_statement("sum", :U64, "zero"),
    @native/for_range("i", "zero", "limit", [
      native/switch_statement(:U64, "i", [
        native/case_arm("one", [native/continue_statement()]),
        native/case_arm("three", [native/break_statement()])], []),
      @native/for_range("j", "zero", "two", [
        native/when_statement(native/binary_expression(:Equal, "j", "zero"), [native/continue_statement()]),
        native/set_statement("sum", native/binary_expression(:Add, "sum", "one"))]),
      native/set_statement("sum", native/binary_expression(:Add, "sum", "i"))]),
    native/return_value("sum")])
  context = native/define_function(context, "semantic_first", [
    @native/for_range("i", "zero", "limit", [native/return_value("i")]),
    native/return_value("ten")])
  context = native/declare_function(context, "semantic_walk", :U64, [["head", node_pointer, :Borrow]], [], [:ReadMemory], :Value, "")
  context = native/define_function(context, "semantic_walk", [
    native/let_statement("sum", :U64, "zero"),
    @native/walk_chain("node", node_pointer, "head", native/member(node, "node", "next"), [
      native/when_statement(native/binary_expression(:Equal, native/member(node, "node", "value"), "one"), [native/continue_statement()]),
      native/set_statement("sum", native/binary_expression(:Add, "sum", native/member(node, "node", "value")))], [native/break_statement()]),
    native/return_value("sum")])
  context = native/declare_function(context, "semantic_pair", [:Record, "BuilderPair"], [], [], [], :Value, "")
  context = native/define_function(context, "semantic_pair", [
    native/return_value(native/initialize_record(pair, {"right" -> "two", "left" -> "one"}))])
  context = native/declare_function(context, "semantic_copy", [:Record, "BuilderPair"],
    [["source", [:Pointer, [:Record, "BuilderPair"], :Mutable], :Borrow]], [], [:ReadMemory, :WriteMemory], :Value, "")
  context = native/define_function(context, "semantic_copy", [
    native/return_record(native/record_copy_arguments(pair, "source", {"right" -> native/typed_call(:U64, "tick", [])}))])
  context = native/declare_function(context, "semantic_elements", :U64,
    [["destination", [:Pointer, :U64, :Mutable], :Borrow], ["source", [:Pointer, :U64, :Const], :Borrow],
      ["length", :U64, :Value], ["index", :U64, :Value]], [], [:ReadMemory, :WriteMemory], :Value, "")
  context = native/define_function(context, "semantic_elements", [
    @native/copy_elements(:U64, "destination", "source", "length"),
    @native/checked_element("selected", :U64, "destination", "length", "index", [native/return_value("ten")]),
    native/return_value(native/typed_load(:U64, "selected"))])
  let result: map = context[:state]
  return result
end

verb native/scope_examples(state: map, constants: map, tick: int) -> map
  let context: map = native/module_context(state, constants)
  context[:functions] = {"tick" -> tick}
  context = native/declare_function(context, "scoped_branch", :U64, [["choice", :Bool, :Value]], [["result", :U64]], [], :Value, "")
  context = native/define_function(context, "scoped_branch", [
    [:If, "choice", [[:Let, "left_value", :U64, [:Add, "one", "two"]], [:Set, "result", "left_value"]],
      [[:Let, "right_value", :U64, [:Add, "two", "three"]], [:Set, "result", "right_value"]]],
    [:Set, "result", [:Add, "result", "ten"]], [:Return, "result"]])
  context = native/declare_function(context, "scoped_loop", :U64, [["limit", :U64, :Value]], [], [], :Value, "")
  context = native/define_function(context, "scoped_loop", [
    [:Let, "i", :U64, "zero"], [:Let, "total", :U64, "zero"],
    [:While, [:Less, "i", "limit"], [
      [:Let, "iteration_value", :U64, [:Add, "i", "one"]],
      [:Set, "total", [:Add, "total", "iteration_value"]], [:Set, "i", "iteration_value"]]],
    [:Return, "total"]])
  context = native/declare_function(context, "scoped_header", :U64, [], [], [:WriteMemory], :Value, "")
  context = native/define_function(context, "scoped_header", [
    [:Let, "total", :U64, "zero"],
    [:While, [:Less, [:Expr, :U64, [:Call, "tick"]], "three"], [[:Set, "total", [:Add, "total", "one"]]]],
    [:Return, "total"]])
  context = native/declare_function(context, "scoped_switch", :U64, [["limit", :U64, :Value]], [["result", :U64]], [], :Value, "")
  let cases: list = []
  for name in ["one", "two", "three"]
    let local_name: string = string_concat("case_", name)
    cases = [@cases, native/case_arm(name, [[:Let, local_name, :U64, [:Add, "limit", "ten"]], [:Set, "result", local_name]])]
  end
  context = native/define_function(context, "scoped_switch", [
    native/switch_statement(:U64, "limit", cases, [[:Set, "result", "zero"]]), [:Return, "result"]])
  // The chosen storage must survive leaving the branch where its address was
  // taken. Direct-use scoping alone would leave a dangling pointer here.
  context = native/declare_function(context, "scoped_address", :U64, [["choice", :Bool, :Value]],
    [["pointer", [:Pointer, :U64, :Const]]], [:ReadMemory], :Value, "")
  context = native/define_function(context, "scoped_address", [
    [:If, "choice", [[:Let, "left_storage", :U64, "one"], [:Set, "pointer", [:Address, "left_storage"]]],
      [[:Let, "right_storage", :U64, "two"], [:Set, "pointer", [:Address, "right_storage"]]]],
    [:Return, [:Load, "pointer"]]])
  let result: map = context[:state]
  return result
end
