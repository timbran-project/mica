// C syntax is data until rendering. Constructors own the map schema, so flow
// analysis does not assemble braces, indentation, or ad hoc syntax maps.
verb native/c_text(text: string, exits: bool) -> map
  return {:kind -> :Text, :text -> text, :exits -> exits}
end

// Keep operand identities until declarations have been placed. Comments and
// generated C spelling are never scanned to recover variable references.
verb native/c_references(input: map, references: list) -> map
  let node: map = input
  node[:references] = references
  return node
end

verb native/c_instruction(row: list) -> map
  let references: list = native/reads(row)
  if row[4] != :Discard
    references = [@references, row[4]]
  end
  let node: map = native/c_references({:kind -> :Instruction, :row -> row}, references)
  return node
end

verb native/c_if(condition: string, yes: list, no: list) -> map
  return {:kind -> :If, :condition -> condition, :yes -> yes, :no -> no}
end

verb native/c_loop(body: list) -> map
  return {:kind -> :Loop, :body -> body}
end

verb native/c_case(value: string, body: list) -> map
  return {:value -> value, :body -> body}
end

verb native/c_switch(value: string, cases: list, fallback: list) -> map
  return {:kind -> :Switch, :value -> value, :cases -> cases, :fallback -> fallback}
end

verb native/c_label(block: int) -> map
  return {:kind -> :Label, :block -> block}
end

verb native/c_goto(block: int) -> map
  return {:kind -> :Goto, :block -> block}
end

verb native/c_tree_exits(nodes: list) -> bool
  if len(nodes) == 0
    return false
  end
  let node: map = nodes[len(nodes) - 1]
  if node[:kind] == :Text
    let exits: bool = node[:exits]
    return exits
  end
  if node[:kind] == :Goto
    return true
  end
  if node[:kind] == :If
    let exits: bool = native/c_tree_exits(node[:yes]) && native/c_tree_exits(node[:no])
    return exits
  end
  if node[:kind] == :Switch
    if !native/c_tree_exits(node[:fallback])
      return false
    end
    for arm in node[:cases]
      if !native/c_tree_exits(arm[:body])
        return false
      end
    end
    return true
  end
  return false
end

verb native/c_tree_labels(nodes: list, input: map) -> map
  let labels: map = input
  for node in nodes
    if node[:kind] == :Goto
      labels[node[:block]] = true
    end
    if node[:kind] == :If
      labels = native/c_tree_labels(node[:yes], labels)
      labels = native/c_tree_labels(node[:no], labels)
    end
    if node[:kind] == :Loop
      labels = native/c_tree_labels(node[:body], labels)
    end
    if node[:kind] == :Switch
      for arm in node[:cases]
        labels = native/c_tree_labels(arm[:body], labels)
      end
      labels = native/c_tree_labels(node[:fallback], labels)
    end
  end
  return labels
end

// Count executable syntax, not source notes or label spelling. Normalized
// compound nodes cache their size so parents need not traverse them again.
verb native/c_tree_size(nodes: list) -> int
  let size: int = 0
  for node in nodes
    if node[:kind] == :Label || (node[:kind] == :Text && string_len(node[:text]) >= 2 && string_slice(node[:text], 0, 2) == "/*")
      continue
    end
    if map_contains_key(node, :size)
      size = size + node[:size]
    else
      size = size + 1
    end
  end
  return size
end

// Normalize before assigning lexical scopes. Rendering must not move nodes
// across braces after declaration placement.
verb native/c_normalize_tree(nodes: list, labels: map) -> list
  let result: list = []
  for input in nodes
    let node: map = input
    let kind: symbol = node[:kind]
    if kind == :Label && !map_contains_key(labels, node[:block])
      continue
    end
    if kind == :If
      let yes: list = native/c_normalize_tree(node[:yes], labels)
      let no: list = native/c_normalize_tree(node[:no], labels)
      let yes_exits: bool = native/c_tree_exits(yes)
      let no_exits: bool = native/c_tree_exits(no)
      let yes_size: int = native/c_tree_size(yes)
      let no_size: int = native/c_tree_size(no)
      // When both arms exit, prefer the smaller guard. Otherwise a complete
      // function body can remain nested above a one-line alternative return.
      if (no_exits && (!yes_exits || no_size < yes_size)) || (len(yes) == 0 && len(no) > 0)
        node[:condition] = string_concat("!(", node[:condition], ")")
        let saved: list = yes
        yes = no
        no = saved
        let saved_size: int = yes_size
        yes_size = no_size
        no_size = saved_size
      end
      node[:yes] = yes
      node[:no] = no
      node[:size] = 1 + yes_size + no_size
      // The continuing arm of a guard belongs to the enclosing C scope.
      if native/c_tree_exits(yes)
        node[:no] = []
        node[:size] = 1 + yes_size
        result = [@result, node, @no]
        continue
      end
    end
    if kind == :Loop
      let body: list = node[:body]
      let condition: string = "true"
      let prefix: list = []
      let executable: list = []
      for child in body
        if len(executable) == 0 && ((child[:kind] == :Label && !map_contains_key(labels, child[:block])) || (child[:kind] == :Text && string_len(child[:text]) >= 2 && string_slice(child[:text], 0, 2) == "/*"))
          prefix = [@prefix, child]
        else
          executable = [@executable, child]
        end
      end
      // Only a pure comparison can leave the loop body. Calls and other
      // header instructions must still execute on every iteration.
      if len(executable) == 1 && executable[0][:kind] == :If
        let branch: map = executable[0]
        if len(branch[:no]) == 1 && branch[:no][0] == native/c_text("break;", true)
          condition = branch[:condition]
          body = branch[:yes]
        else
          if len(branch[:yes]) == 1 && branch[:yes][0] == native/c_text("break;", true)
            condition = string_concat("!(", branch[:condition], ")")
            body = branch[:no]
          end
        end
        if condition != "true"
          node = native/c_references(node, branch[:references])
          result = [@result, @native/c_normalize_tree(prefix, labels)]
        end
      end
      if len(body) > 0 && body[len(body) - 1] == native/c_text("continue;", true)
        let trimmed: list = []
        let position: int = 0
        while position + 1 < len(body)
          trimmed = [@trimmed, body[position]]
          position = position + 1
        end
        body = trimmed
      end
      node[:condition] = condition
      node[:body] = native/c_normalize_tree(body, labels)
      node[:size] = 1 + native/c_tree_size(node[:body])
    end
    if kind == :Switch
      let cases: list = []
      let size: int = 1
      for arm in node[:cases]
        let body: list = native/c_normalize_tree(arm[:body], labels)
        size = size + native/c_tree_size(body)
        cases = [@cases, native/c_case(arm[:value], body)]
      end
      node[:cases] = cases
      node[:fallback] = native/c_normalize_tree(node[:fallback], labels)
      node[:size] = size + native/c_tree_size(node[:fallback])
    end
    result = [@result, node]
  end
  return result
end

verb native/c_render_tree(index: map, nodes: list, labels: map, indent: string) -> list
  let lines: list = []
  let inner: string = string_concat(indent, "  ")
  for node in nodes
    let kind: symbol = node[:kind]
    if kind == :Text
      lines = [@lines, string_concat(indent, node[:text])]
    end
    if kind == :Instruction
      let statement: string = native/c_statement(index, node[:row])
      if map_contains_key(node, :initialize)
        statement = string_concat(native/c_type(index[:variables][node[:row][4]][2]), " ", statement)
      end
      lines = [@lines, string_concat(indent, statement)]
    end
    if kind == :Label && map_contains_key(labels, node[:block])
      lines = [@lines, string_concat(indent, "b_", index[:blocks][node[:block]][2], ":;")]
    end
    if kind == :Goto
      lines = [@lines, string_concat(indent, "goto b_", index[:blocks][node[:block]][2], ";")]
    end
    if kind == :If
      let yes: list = node[:yes]
      let no: list = node[:no]
      lines = [@lines, string_concat(indent, "if (", node[:condition], ") {"), @native/c_render_tree(index, yes, labels, inner)]
      if len(no) == 0
        lines = [@lines, string_concat(indent, "}")]
      else
        // A sole conditional needs no separate else scope. Any declaration
        // or annotation in that scope prevents this cosmetic fold.
        if len(no) == 1 && no[0][:kind] == :If
          let tail: list = native/c_render_tree(index, no, labels, indent)
          tail[0] = string_concat(indent, "} else ", string_slice(tail[0], string_len(indent), string_len(tail[0])))
          lines = [@lines, @tail]
        else
          lines = [@lines, string_concat(indent, "} else {"), @native/c_render_tree(index, no, labels, inner), string_concat(indent, "}")]
        end
      end
    end
    if kind == :Loop
      lines = [@lines, string_concat(indent, "while (", node[:condition], ") {"), @native/c_render_tree(index, node[:body], labels, inner), string_concat(indent, "}")]
    end
    if kind == :Switch
      lines = [@lines, string_concat(indent, "switch (", node[:value], ") {")]
      let arms: list = [@node[:cases], native/c_case("", node[:fallback])]
      for arm in arms
        let label: string = "default:"
        if arm[:value] != ""
          label = string_concat("case ", arm[:value], ":")
        end
        lines = [@lines, string_concat(inner, label, " {"), @native/c_render_tree(index, arm[:body], labels, string_concat(inner, "  "))]
        if !native/c_tree_exits(arm[:body])
          lines = [@lines, string_concat(inner, "  break;")]
        end
        lines = [@lines, string_concat(inner, "}")]
      end
      lines = [@lines, string_concat(indent, "}")]
    end
  end
  return lines
end
