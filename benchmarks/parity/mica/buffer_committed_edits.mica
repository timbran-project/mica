make_functional_relation(:BenchBufferRevision, 2, [0])

verb setup()
  make_buffer(:benchmark_buffer, :durable)
  let text = ""
  let i = 0
  while i < 4096
    text = string_concat(text, "abé🦀\n")
    i = i + 1
  end
  buffer_insert(:benchmark_buffer, 0, text)
  return true
end

// Fixed text size, 128 publishing edits, and matching fact revisions.
verb bench()
  let start = buffer_revision(:benchmark_buffer)
  let i = 0
  while i < 64
    require buffer_insert(:benchmark_buffer, 10240, "λ🦀")
    retract BenchBufferRevision(:benchmark_buffer, _)
    assert BenchBufferRevision(:benchmark_buffer, start + i * 2 + 1)
    commit()
    require buffer_revision(:benchmark_buffer) == start + i * 2 + 1
    require BenchBufferRevision(:benchmark_buffer, buffer_revision(:benchmark_buffer))
    require buffer_slice(:benchmark_buffer, 10240, 10242) == "λ🦀"
    require buffer_delete(:benchmark_buffer, 10240, 2)
    retract BenchBufferRevision(:benchmark_buffer, _)
    assert BenchBufferRevision(:benchmark_buffer, start + i * 2 + 2)
    commit()
    require buffer_revision(:benchmark_buffer) == start + i * 2 + 2
    require BenchBufferRevision(:benchmark_buffer, buffer_revision(:benchmark_buffer))
    i = i + 1
  end
  require buffer_len(:benchmark_buffer) == 20480
  require buffer_line_count(:benchmark_buffer) == 4097
  require buffer_slice(:benchmark_buffer, 10240, 10245) == "abé🦀\n"
  return 128
end
