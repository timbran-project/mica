verb setup()
  editor/session_create(:benchmark_session, :benchmark_actor, :default)
  return true
end

// Timed application calls include JSON decoding, publication, finalization,
// result checks, and one bounded JSON snapshot after 32 tagged Unicode edits.
verb bench()
  let buffer = editor/window_buffer(:benchmark_session, 1)
  let revision = buffer_revision(buffer)
  let generation = editor/keymap_generation(:benchmark_session)
  let expected = ""
  let i = 0
  while i < 32
    let result = editor_input_json(:benchmark_endpoint, :benchmark_session,
      :benchmark_actor, 1, "{\"kind\":\"text\",\"text\":\"é🦀\"}", i + 1, generation)
    expected = string_concat(expected, "é🦀")
    require result[:status] == :ok
    require result[:revision] == revision + i + 1
    require result[:point_line] == 0
    require result[:point_column] == (i + 1) * 2
    require buffer_text(buffer) == expected
    i = i + 1
  end
  let snapshot = json_decode(editor/snapshot_json(:benchmark_session, :benchmark_actor, 10, 1000))
  require snapshot[:revision] == revision + 32
  require snapshot[:point] == 64
  require snapshot[:rows][0][:text] == expected
  return buffer_len(buffer)
end
