verb bench()
  let i = 0
  while i < 20
    let name = string_concat("installed_", to_literal(i))
    let installed = compiler/install(emit_source(string_concat("verb ", name, "()\n return 42\nend")), to_symbol(string_concat("module/", name)))
    require installed[:ok]
    require(invoke(to_symbol(name), {}) == 42)
    commit()
    i = i + 1
  end
  return i
end

