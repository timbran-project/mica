// Map lookup over a 256-entry map.
//
// Per-call workload: 256 lookups in a 256-entry map (plus the one-time
// literal construction each call). Small maps cannot show lookup
// complexity; this one exists so switching the lookup from a linear scan to a
// binary search is measurable.
make_identity(:bench)
make_relation(:CanInvoke, 2)
make_relation(:CanRead, 2)
make_relation(:CanWrite, 2)
grant #bench
  invoke:
    :bench
end

