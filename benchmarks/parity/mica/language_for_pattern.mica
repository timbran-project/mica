// For-loop destructuring patterns (#87).
//
// Per-call workload: destructures list pairs and relation rows by header
// patterns, plus a wildcard pass. Doubles as the differential-parser
// fixture for the pattern-header syntax: both parsers must agree on it.
// Shared benchmark grant preamble. The Rust host derives endpoint authority
// from grant facts, so the harness runs as #bench; the Odin host parses the
// same block. Grants cover the relations and verbs each bench uses.
make_identity(:bench)
make_relation(:CanInvoke, 2)
make_relation(:CanRead, 2)
make_relation(:CanWrite, 2)
grant #bench
  invoke:
    :bench
end

verb bench()
  let total = 0
  for [a, b] in [[1, 2], [3, 4]]
    total = total + a + b
  end
  let rows = [:x] { [10], [20] }
  for {x} in rows
    total = total + x
  end
  for _ in [1, 2, 3]
    total = total + 1
  end
  let evens = [n for n in [1, 2, 3, 4] if n == 2]
  let ordered = [n for n in [3, 1, 2] sort]
  let keyed = [pair[1] for pair in [[1, "b"], [0, "a"]] sort pair[0]]
  return total + len(evens) + ordered[0] + len(keyed)
end
