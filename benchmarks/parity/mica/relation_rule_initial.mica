// One invocation in a fresh world: load 16 disjoint 32-edge chains, publish,
// and read their initial transitive closure. Includes insertion and commit.
// Repeating this verb is an error, rather than a cached-scan measurement.
make_relation(:Edge, 2)
make_relation(:Reach, 2)
Reach(a, b) :- Edge(a, b)
Reach(a, c) :- Edge(a, b), Reach(b, c)

verb bench()
  require not Edge(_, _)
  let component = 0
  while component < 16
    let edge = 0
    while edge < 32
      assert Edge(component * 100 + edge, component * 100 + edge + 1)
      edge = edge + 1
    end
    component = component + 1
  end
  commit()
  require Reach(0, 32)
  require Reach(1500, 1532)
  require not Reach(0, 1532)
  return len(Reach(?start, ?target))
end
