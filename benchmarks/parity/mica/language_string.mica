// Shared benchmark grant preamble. The Rust host derives endpoint authority
// from grant facts, so the harness runs as #bench; the Odin host parses the
// same block. Grants cover the relations and verbs each bench uses.
make_identity(:bench)
make_relation(:CanInvoke, 2)
make_relation(:CanRead, 2)
make_relation(:CanWrite, 2)
grant #bench
  invoke:
    :bench
end
// String building over a loop.
//
// Per-call workload: 1000 concatenations of a one-character string. This is
// the O(n^2) shape (each concat rebuilds and copies the prefix); the
// amortized form is language_string_append.mica, which the Rust side does not
// implement yet, so this is the shared comparison point.
verb bench()
  let text = ""
  let index = 0
  while index < 1000
    text = string_concat(text, "x")
    index = index + 1
  end
  return string_len(text)
end
