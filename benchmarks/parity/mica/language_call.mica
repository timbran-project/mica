// Shared benchmark grant preamble. The Rust host derives endpoint authority
// from grant facts, so the harness runs as #bench; the Odin host parses the
// same block. Grants cover the relations and verbs each bench uses.
make_identity(:bench)
make_relation(:CanInvoke, 2)
make_relation(:CanRead, 2)
make_relation(:CanWrite, 2)
grant #bench
  invoke:
    :bench
    :add
end
// Verb call overhead.
//
// Per-call workload: 30k calls to a two-argument helper verb. Kept at 30k
// rather than 100k because the Rust kernel's positional-dispatch cache keys on
// argument *values* and clones the whole map per insert, so calls with a
// changing argument go quadratic; 30k is the largest count both
// implementations complete promptly.
verb add(a, b)
  return a + b
end

verb bench()
  let index = 0
  let total = 0
  while index < 30000
    total = add(total, 1)
    index = index + 1
  end
  return total
end
