// The prelude loads each pinned implementation's Mica lexer and parser.
// Each of 200 declarations has five tokens and one Binding AST node.
verb bench()
  let source = ""
  let index = 0
  while index < 200
    source = string_concat(source, "let value", to_literal(index), " = \"é🦀\"\n")
    index = index + 1
  end
  let [tokens, errors] = lex(source)
  require len(errors) == 0
  require len(tokens) == 1001
  require tokens[0][:kind] == :Let
  require tokens[3][:kind] == :String
  require tokens[3][:offset] == 13
  require tokens[1000][:kind] == :Eof
  let parsed = parse_rows(source)
  require len(parsed[:errors]) == 0
  let bindings = 0
  for row in parsed[:rows]
    if row[1] == :kind && row[2] == :Binding
      bindings = bindings + 1
    end
  end
  require bindings == 200
  return len(tokens) + bindings
end
