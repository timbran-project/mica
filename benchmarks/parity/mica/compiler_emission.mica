// Compile the same source through each pinned Mica compiler and assembler.
verb compiler_emission_source()
  let source = ""
  let index = 0
  while index < 100
    source = string_concat(source, "let value", to_literal(index), " = \"é🦀\"\n")
    index = index + 1
  end
  return string_concat(source, "return [n * 2 for n in [3, 1, 2] if n > 1 sort -n]\n")
end

verb bench()
  let source = compiler_emission_source()
  let compiled = emit_source(source)
  require compiled[:ok]
  // Rust returns separate entry/method artifacts; Odin returns one program.
  let artifact = index_or(compiled, :entry, index_or(compiled, :bytes, b""))
  require artifact != b""
  return len(source)
end
