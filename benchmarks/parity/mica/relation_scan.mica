// Shared benchmark grant preamble. The Rust host derives endpoint authority
// from grant facts, so the harness runs as #bench; the Odin host parses the
// same block. Grants cover the relations and verbs each bench uses.
make_identity(:bench)
make_relation(:CanInvoke, 2)
make_relation(:CanRead, 2)
make_relation(:CanWrite, 2)
grant #bench
  invoke:
    :bench
    :setup
  read:
    :Point
  write:
    :Point
end
// Sequential relation scan.
//
// Setup seeds 1000 rows; per-call workload scans them all and counts.
make_relation(:Point, 1)

verb setup()
  let index = 0
  while index < 1000
    assert Point(index)
    index = index + 1
  end
end

verb bench()
  let count = 0
  for row in Point(?x)
    count = count + 1
  end
  return count
end
