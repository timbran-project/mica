// Maintain 16 disjoint 32-edge chains. Each small update changes one edge
// and 32 closure rows. Setup materializes 8,448 closure rows before timing.
// Each invocation removes and restores the same edge eight times. Every
// update publishes, then checks a bound derived scan and an untouched chain.
make_relation(:Edge, 2)
make_relation(:Reach, 2)
Reach(a, b) :- Edge(a, b)
Reach(a, c) :- Edge(a, b), Reach(b, c)

verb setup()
  let component = 0
  while component < 16
    let edge = 0
    while edge < 32
      assert Edge(component * 100 + edge, component * 100 + edge + 1)
      edge = edge + 1
    end
    component = component + 1
  end
  commit()
  require len(Reach(?start, ?target)) == 8448
end

verb bench()
  let count = 0
  let cycle = 0
  while cycle < 8
    require Reach(0, 32)
    retract Edge(31, 32)
    commit()
    require not Reach(0, 32)
    require Reach(1500, 1532)
    let removed = len(Reach(0, ?target))
    require removed == 31
    count = count + removed
    assert Edge(31, 32)
    commit()
    require Reach(0, 32)
    require Reach(1500, 1532)
    let restored = len(Reach(0, ?target))
    require restored == 32
    count = count + restored
    cycle = cycle + 1
  end
  return count
end
