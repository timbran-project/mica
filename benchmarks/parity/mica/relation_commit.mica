// Shared benchmark grant preamble. The Rust host derives endpoint authority
// from grant facts, so the harness runs as #bench; the Odin host parses the
// same block. Grants cover the relations and verbs each bench uses.
make_identity(:bench)
make_relation(:CanInvoke, 2)
make_relation(:CanRead, 2)
make_relation(:CanWrite, 2)
grant #bench
  invoke:
    :bench
    :worker
  read:
    :BenchPoint
  write:
    :BenchPoint
end
// Sequential relation commit throughput.
//
// Per-call workload: one worker performs 256 retract+assert+commit
// transactions, then reports through a mailbox the caller waits on. Divide
// the reported per-call time by 256 for the per-commit cost. The explicit
// commit() inside the loop is what makes each iteration a real commit; using
// a worker (rather than one call per commit) keeps task-dispatch overhead out
// of the measured cost.
make_relation(:BenchPoint, 1)
assert BenchPoint(0)

verb worker(sender, count)
  let index = 0
  while index < count
    retract BenchPoint(index % 2)
    assert BenchPoint((index + 1) % 2)
    commit()
    index = index + 1
  end
  mailbox_send(sender, 1)
end

verb bench()
  let box = mailbox()
  let receiver = box[0]
  let sender = box[1]
  spawn :worker(sender: sender, count: 256)
  mailbox_recv([receiver])
  mailbox_close(receiver)
  return 256
end
